// Task UI
// Interface para visualização e interação com tasks

#include "menu.nvgt"
#include "../lang/i18n.nvgt"
#include "../game/task_manager.nvgt"

class TaskUI {
	private menu task_menu;
	
	TaskUI() {
		task_menu.wrap = true;
		task_menu.allow_escape = true;
	}
	
	// Mostra menu de tasks
	int show_task_menu() {
		if (@g_task_manager == null) {
			return -1;
		}
		
		TaskData@[] tasks = g_task_manager.get_all_player_tasks();
		if (tasks.length() == 0) {
			screen_reader_speak(tr("task_menu_title") + ": " + tr("task_status_pending"), true);
			return -1;
		}
		
		task_menu.reset();
		
		int completed = g_task_manager.count_completed_tasks();
		int total = g_task_manager.count_total_tasks();
		
		dictionary params;
		params.set("completed", "" + completed);
		params.set("total", "" + total);
		
		task_menu.intro_text = tr("task_menu_title") + "\n" + tr("task_progress", params);
		
		// Adiciona tasks
		for (uint i = 0; i < tasks.length(); i++) {
			string status = get_task_status_text(tasks[i].state);
			string item_text = tasks[i].name + " - " + status;
			
			if (@g_map != null) {
				string room_name = g_map.get_room_name(tasks[i].room_id);
				item_text += " (" + room_name + ")";
			}
			
			task_menu.add_item(item_text);
		}
		
		while (true) {
			wait(5);
			if (!task_menu.monitor()) {
				int selected = task_menu.focused_item;
				
				// Mostra detalhes da task
				if (selected >= 0 && selected < int(tasks.length())) {
					show_task_details(tasks[selected]);
				}
				
				return selected;
			}
			
			if (key_pressed(KEY_ESCAPE)) {
				return -1;
			}
		}
		
		return -1;
	}
	
	// Mostra detalhes de uma task
	void show_task_details(TaskData@ task) {
		if (@task == null) return;
		
		string details = task.name + "\n\n";
		details += task.description + "\n\n";
		
		if (@g_map != null) {
			string room_name = g_map.get_room_name(task.room_id);
			details += "Local: " + room_name + "\n";
		}
		
		details += "Status: " + get_task_status_text(task.state) + "\n";
		
		if (task.step_count > 1) {
			details += "Progresso: " + task.current_step + "/" + task.step_count + "\n";
		}
		
		screen_reader_speak(details, true);
		
		// Permite executar task se não está completa
		if (!task.is_completed()) {
			wait(500);
			if (question("Deseja executar esta task agora?", "Executar Task") == 1) {
				execute_task_interaction(task);
			}
		}
	}
	
	// Executa interação com a task
	void execute_task_interaction(TaskData@ task) {
		if (@g_task_manager == null || @task == null) {
			return;
		}
		
		// Executa o mini-game
		bool success = g_task_manager.execute_task_minigame(task.id);
		
		if (success && task.is_completed()) {
			// Notifica servidor
			if (@g_client != null && g_client.is_authenticated()) {
				g_client.send_task_complete(task.id);
			}
		}
	}
	
	// Mostra progresso rápido de tasks
	void show_quick_progress() {
		if (@g_task_manager == null) {
			return;
		}
		
		int completed = g_task_manager.count_completed_tasks();
		int total = g_task_manager.count_total_tasks();
		float percentage = g_task_manager.get_progress_percentage();
		
		string progress_text = "Tasks: " + completed + "/" + total + " (" + 
		                       formatFloat(percentage, 0) + "%)";
		
		screen_reader_speak(progress_text, true);
	}
	
	// Mostra tasks disponíveis na sala atual
	void show_tasks_in_current_room(int room_id) {
		if (@g_task_manager == null) {
			return;
		}
		
		TaskData@[] room_tasks = g_task_manager.get_tasks_in_room(room_id);
		
		if (room_tasks.length() == 0) {
			screen_reader_speak("Nenhuma task disponível nesta sala", true);
			return;
		}
		
		string tasks_text = "Tasks disponíveis:\n";
		for (uint i = 0; i < room_tasks.length(); i++) {
			tasks_text += (i + 1) + ". " + room_tasks[i].name + "\n";
		}
		
		screen_reader_speak(tasks_text, true);
	}
	
	// Obtém texto de status da task
	private string get_task_status_text(TaskState state) {
		switch (state) {
			case TASK_ASSIGNED:
				return tr("task_status_pending");
			case TASK_IN_PROGRESS:
				return tr("task_status_in_progress");
			case TASK_COMPLETED:
				return tr("task_status_completed");
		}
		return "";
	}
	
	// Função auxiliar
	private string formatFloat(float value, int decimals) {
		return "" + value;
	}
}

// Instância global
TaskUI@ g_task_ui = null;
