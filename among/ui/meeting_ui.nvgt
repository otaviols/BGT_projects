// meeting_ui.nvgt
// Reação do cliente a eventos de reunião/votação/sabotagem/corpo/fim de jogo: anúncios falados,
// sons de alarme e o menu de votação navegável por teclado (setas + Enter, ESC = pular votação).

#include "menu.nvgt"
#include "speech.nvgt"
#include "../network/protocol.nvgt"
#include "../network/packet.nvgt"
#include "../network/client.nvgt"
#include "../core/client_state.nvgt"
#include "../core/chat_log.nvgt"
#include "../audio/audio_manager.nvgt"
#include "../lang/i18n.nvgt"
#include "../config/game_constants.nvgt"

// menu.run() bloqueia localmente enquanto o jogador escolhe o voto, sem nunca chamar
// client.update() - sem isso a conexão para de ser "servida" (nada de keepalive/ack via ENet)
// durante o tempo em que o menu fica aberto, podendo deixar a rede "travada" pra esse peer depois
// que a votação termina (mesmo problema já visto e corrigido no navegador de lobbies, ver
// ui/lobby_screens.nvgt - nome diferente aqui só pra não colidir com aquele global).
game_client@ g_vote_pump_client;
void pump_client_during_vote_menu(menu@ m, string data) {
	if (@g_vote_pump_client != null) g_vote_pump_client.update();
}

class meeting_ui {
	game_client@ client;
	audio_manager@ audio;
	client_roster@ roster;
	chat_log@ events_log;
	bool is_impostor;
	bool voting_active = false;
	bool has_voted = false; // reseta a cada reunião nova (ver on_voting_started)

	meeting_ui(game_client@ client, audio_manager@ audio, client_roster@ roster, chat_log@ events_log, bool is_impostor) {
		@this.client = client;
		@this.audio = audio;
		@this.roster = roster;
		@this.events_log = events_log;
		this.is_impostor = is_impostor;
	}

	private string name_of(uint64 peer_id) const {
		roster_entry@ e = roster.find(peer_id);
		return @e != null ? e.name : "";
	}

	// Fala na hora (igual sempre foi) e também guarda no container de eventos, pra dar pra reler
	// depois com PageUp/PageDown + vírgula/ponto.
	private void announce(const string&in text) {
		speak(text);
		events_log.add("", text);
	}

	void on_body_reported(net_packet@ pkt) {
		audio.stop_body_beacon();
		audio.play_body_reported_sound();
		dictionary@ params = dictionary();
		params.set("reporter", name_of(pkt.get_uint64("reporter_peer")));
		params.set("victim", name_of(pkt.get_uint64("body_peer")));
		announce(tr("game.body_reported", params));
	}

	void on_meeting_started(net_packet@ pkt) {
		string reason = pkt.get_string("reason");
		if (reason == "button") {
			audio.play_meeting_alarm();
			dictionary@ params = dictionary();
			params.set("name", name_of(pkt.get_uint64("caller_peer")));
			announce(tr("game.emergency_meeting_called", params));
		} else {
			announce(tr("game.meeting_discussion"));
		}
	}

	void on_voting_started(net_packet@ pkt) {
		voting_active = true;
		has_voted = false;
		// Não abre o menu de votação sozinho - isso travava o jogador lá dentro sem conseguir usar
		// o chat pra discutir antes de votar. Agora é só um aviso; o jogador abre o menu quando
		// quiser com a tecla de votar (ver KEY_VOTE em game/game_loop.nvgt).
		announce(tr("game.meeting_voting"));
	}

	// Avisa que ALGUÉM votou (sem dizer em quem) - dá pra acompanhar quantos já votaram sem
	// estragar o suspense do resultado final.
	void on_vote_cast(net_packet@ pkt) {
		uint64 voter_peer = pkt.get_uint64("voter_peer");
		if (voter_peer == client.my_peer_id) has_voted = true;
		dictionary@ params = dictionary();
		params.set("voter", pkt.get_string("voter_name"));
		announce(tr("game.vote_cast_announcement", params));
	}

	void on_vote_result(net_packet@ pkt) {
		voting_active = false;

		json_array@ breakdown = pkt.get_array("vote_breakdown");
		if (@breakdown != null) {
			for (uint i = 0; i < breakdown.length(); i++) {
				json_object@ entry = breakdown.get_object(i);
				if (@entry == null) continue;
				dictionary@ params = dictionary();
				params.set("voter", string(entry["voter_name"]));
				if (bool(entry["skipped"])) {
					announce(tr("game.vote_cast_skip", params));
				} else {
					params.set("target", string(entry["target_name"]));
					announce(tr("game.vote_cast", params));
				}
			}
		}

		audio.play_meeting_result();
		// Pausa de suspense: o som toca sozinho primeiro, e só DEPOIS vem o anúncio de quem foi
		// expulso - tocar os dois juntos (como estava antes) atropelava a fala e tirava a graça do
		// suspense, igual no jogo original onde o resultado só aparece depois do som.
		wait(1500);

		uint64 ejected_peer = pkt.get_uint64("ejected_peer");
		if (ejected_peer == 0) {
			announce(tr(pkt.get_bool("tie") ? "game.vote_result_tie" : "game.no_one_ejected"));
			return;
		}
		roster.mark_dead(ejected_peer);
		audio.play_ejected(); // só toca quando alguém É expulso, depois do som geral de resultado
		dictionary@ params = dictionary();
		params.set("name", pkt.get_string("ejected_name"));
		announce(tr("game.vote_result_ejected", params));
	}

	// Chamado quando o jogador aperta a tecla de votar - só faz algo se a votação estiver mesmo
	// rolando no momento e ele ainda não tiver votado nesta reunião.
	void open_vote_menu_if_active() {
		if (!voting_active) return;
		if (has_voted) { speak(tr("game.already_voted")); return; }
		run_voting_menu();
	}

	void on_sabotage_started(net_packet@ pkt) {
		string sabotage_id = pkt.get_string("sabotage_id");
		announce(tr(sabotage_id == "lights" ? "sabotage.lights.name" : "sabotage.oxygen.name"));
		audio.start_sabotage_alarm();
		if (sabotage_id == "lights") audio.apply_lights_out(true, 40);
	}

	void on_sabotage_fixed(net_packet@ pkt) {
		// "expired" = a sabotagem acabou sozinha no tempo dela (luzes), ninguém consertou nada.
		announce(tr(pkt.get_bool("expired") ? "sabotage.expired" : "sabotage.fixed"));
		audio.stop_sabotage_alarm();
		audio.apply_lights_out(false, 40);
	}

	void on_player_killed(net_packet@ pkt) {
		uint64 peer_id = pkt.get_uint64("peer_id");
		roster.mark_dead(peer_id);
		float x = pkt.get_float("x");
		float y = pkt.get_float("y");
		int killer_color = pkt.get_int("killer_color");
		audio.play_death(killer_color, x, y);
		audio.play_kill_laugh(killer_color, x, y);
		audio.start_body_beacon(x, y);
	}

	void on_game_over(net_packet@ pkt) {
		bool crewmates_won = pkt.get_string("winner") == "crewmates";
		announce(tr(crewmates_won ? "game.crewmates_win" : "game.impostors_win"));
		// Antes tocava win/defeat baseado só em quem venceu, sem checar o papel de quem está ouvindo -
		// impostores ouviam "vitória" quando os tripulantes ganhavam, e vice-versa.
		bool i_won = crewmates_won != is_impostor;
		if (i_won) audio.play_win();
		else audio.play_defeat();
	}

	// Menu de votação: lista jogadores vivos + opção de pular. ESC/fechar sem escolher NÃO vota
	// (nem pula): o menu só fecha e dá pra abrir de novo com a tecla de votar enquanto a votação
	// estiver aberta. Antes ESC mandava "pular" - quem fechasse o menu sem querer perdia o voto
	// daquela reunião inteira sem nem saber.
	private void run_voting_menu() {
		sound_play(SND_DIALOG_OPEN);
		menu vote_menu;
		vote_menu.intro_text = tr("game.meeting_voting");
		vote_menu.click_sound = "menuclick.wav";
		vote_menu.select_sound = "menuconfirm.wav";
		vote_menu.sounds_prefix = "sounds/";
		@g_vote_pump_client = client;
		@vote_menu.background_callback = @pump_client_during_vote_menu;

		array<roster_entry@>@ alive = roster.alive_entries();
		for (uint i = 0; i < alive.length(); i++) {
			vote_menu.add_item(alive[i].name, "" + alive[i].peer_id);
		}
		vote_menu.add_item(tr("game.vote_skip"), "skip");

		vote_menu.run();
		string selected_id = vote_menu.selected_item_id;
		sound_play(SND_DIALOG_CLOSE);

		if (selected_id == "") {
			speak(tr("game.vote_cancelled"));
			return;
		}

		if (selected_id == "skip") client.send_cast_vote(-1);
		else client.send_cast_vote(parse_int(selected_id));

		has_voted = true; // não espera o S_VOTE_CAST voltar da rede pra já bloquear reabrir o menu
		audio.play_vote_confirm();
	}
}
