// onboarding_screens.nvgt
// Telas iniciais: conectar ao servidor e autenticar (login ou cadastro). Usa audio_form
// diretamente (via form.nvgt) para os campos de texto/senha, navegáveis por teclado (Tab entre
// campos, Enter confirma, Esc cancela) e totalmente falados pelo leitor de tela.

#include "form.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../database/models.nvgt"
#include "../lang/i18n.nvgt"
#include "../config/game_constants.nvgt"

// Pede endereço/porta do servidor e conecta. Retorna true se a conexão foi estabelecida.
bool run_connect_screen(game_client@ client) {
	audio_form f;
	f.create_window(tr("menu.connect"));
	int f_host = f.create_input_box(tr("menu.server_address"), "localhost");
	int f_port = f.create_input_box(tr("menu.server_port"), "" + DEFAULT_SERVER_PORT);
	int f_ok = f.create_button(tr("menu.connect"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);

	while (true) {
		wait(5);
		f.monitor();
		if (f.is_pressed(f_cancel)) return false;
		if (f.is_pressed(f_ok)) {
			string host = f.get_text(f_host);
			uint16 port = uint16(parse_int(f.get_text(f_port)));
			if (host.empty()) continue;
			if (!client.connect_to(host, port)) {
				speak(tr("menu.connect_failed"));
				continue;
			}

			// Espera a confirmação de conexão do ENet (evento event_connect) por alguns segundos.
			timer@ wait_clock = timer();
			while (float(wait_clock.elapsed) / 1000.0 < 5.0) {
				wait(20);
				client.update();
				if (client.connected) return true;
			}
			speak(tr("menu.connect_failed"));
		}
	}
	return false; // inalcançável - o laço só termina via return acima
}

// Tela combinada de login/cadastro. Envia C_LOGIN ou C_REGISTER e espera a resposta do servidor.
// Em caso de cadastro bem sucedido, tenta logar automaticamente com as mesmas credenciais.
// Reutiliza a classe login_result (database/models.nvgt): campo "ok" indica sucesso, "username" o
// nome final autenticado (o campo "message" não é usado aqui).
login_result run_login_screen(game_client@ client) {
	login_result result;

	audio_form f;
	f.create_window(tr("menu.login"));
	int f_user = f.create_input_box(tr("login.username"));
	int f_pass = f.create_input_box(tr("login.password"), "", "*");
	int f_login = f.create_button(tr("menu.login"), true);
	int f_register = f.create_button(tr("menu.register"));
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);

	while (true) {
		wait(5);
		client.update();
		f.monitor();
		if (f.is_pressed(f_cancel)) return result;

		bool wants_register = f.is_pressed(f_register);
		if (f.is_pressed(f_login) || wants_register) {
			string username = f.get_text(f_user);
			string password = f.get_text(f_pass);
			if (username.empty() || password.empty()) continue;

			if (wants_register) client.send_register(username, password);
			else client.send_login(username, password);

			if (!wait_for_auth_result(client, wants_register, username, password, result)) continue;
			return result;
		}
	}
	return result; // inalcançável - o laço só termina via return acima
}

// Aguarda S_REGISTER_RESULT ou S_LOGIN_RESULT do servidor. Se o cadastro deu certo, envia login
// automaticamente em seguida e espera o resultado desse login também.
bool wait_for_auth_result(game_client@ client, bool was_register, const string&in username,
		const string&in password, login_result@ result) {
	timer@ wait_clock = timer();
	bool logging_in_after_register = false;

	while (float(wait_clock.elapsed) / 1000.0 < 8.0) {
		wait(20);
		client.update();
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_REGISTER_RESULT && was_register && !logging_in_after_register) {
				if (!pkt.get_bool("ok")) {
					speak(pkt.get_string("message") == "username_taken" ? tr("login.username_taken") : pkt.get_string("message"));
					return false;
				}
				speak(tr("login.register_success"));
				client.send_login(username, password);
				logging_in_after_register = true;
				wait_clock.restart();
			} else if (pkt.type == S_LOGIN_RESULT) {
				if (!pkt.get_bool("ok")) {
					speak(tr("login.invalid_credentials"));
					return false;
				}
				speak(tr("login.success"));
				result.ok = true;
				result.username = pkt.get_string("username", username);
				return true;
			}
			@pkt = client.poll_message();
		}
	}
	speak(tr("menu.connect_failed"));
	return false;
}
