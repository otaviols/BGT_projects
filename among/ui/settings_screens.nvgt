// settings_screens.nvgt
// Configurações do jogador: volume por família de som, mapa de teclas e voz. Tudo é salvo na hora
// de sair de cada tela (ver config/game_settings.nvgt) e vale já na próxima partida.

#include "menu.nvgt"
#include "form.nvgt"
#include "speech.nvgt"
#include "../config/game_settings.nvgt"
#include "../audio/sound_catalog.nvgt"
#include "../lang/i18n.nvgt"

// Som de amostra de cada família, na ordem de SOUND_FAMILY_*. Tocar o som DA FAMÍLIA ao mexer no
// controle é o que torna o ajuste possível de ouvido: você ouve o que está ajustando, no volume em
// que ficou, sem ter que entrar numa partida pra descobrir.
const array<string> FAMILY_PREVIEW_SOUNDS = {
	SND_MENU_CONFIRM,       // geral
	SND_AMBIENT_CAFETERIA,  // ambiente
	"sounds/Tile1.wav",     // passos
	SND_VENT_BEACON,        // marcadores
	"sounds/" + SND_BEEP,   // tasks
	SND_BODY_REPORTED,      // eventos
	SND_MENU_CLICK          // interface
};

void run_settings_menu() {
	while (true) {
		menu m;
		m.intro_text = tr("menu.settings");
		m.click_sound = "menuclick.wav";
		m.select_sound = "menuconfirm.wav";
		m.sounds_prefix = "sounds/";
		m.add_item(tr("settings.volumes"), "volumes");
		m.add_item(tr("settings.keys"), "keys");
		m.add_item(tr("settings.voice"), "voice");
		m.add_item(tr("menu.back"), "back");
		m.run();

		string id = m.selected_item_id;
		if (id == "volumes") run_volume_screen();
		else if (id == "keys") run_keys_screen();
		else if (id == "voice") run_voice_screen();
		else return; // "back", ESC ou fechou sem escolher
	}
}

// --- Volumes ---
// Um controle deslizante por família. Mexer num controle toca a amostra daquela família no volume
// novo; o anterior é cortado, senão dois ou três sons se empilhariam enquanto a seta é segurada.
void run_volume_screen() {
	audio_form f;
	f.create_window(tr("settings.volumes"), false);

	array<int> sliders;
	array<int> last_values;
	for (uint i = 0; i < SOUND_FAMILY_COUNT; i++) {
		sliders.insert_last(f.create_slider(tr(SOUND_FAMILY_NAME_KEYS[i]), g_settings.volumes[i], 0, 100));
		last_values.insert_last(g_settings.volumes[i]);
	}
	int f_save = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);

	array<int> original = g_settings.volumes;
	sound@ preview = null;

	while (true) {
		wait(5);
		f.monitor();

		if (f.is_pressed(f_cancel)) {
			g_settings.volumes = original; // desfaz tudo, inclusive o que já estava sendo ouvido
			g_settings.apply_master();
			if (@preview != null) preview.stop();
			speak(tr("settings.cancelled"));
			return;
		}
		if (f.is_pressed(f_save)) {
			if (@preview != null) preview.stop();
			g_settings.save();
			speak(tr("settings.saved"));
			return;
		}

		for (uint i = 0; i < sliders.length(); i++) {
			int value = f.get_slider(sliders[i]);
			if (value == last_values[i]) continue;
			last_values[i] = value;
			g_settings.volumes[i] = value;
			// O volume geral vale na hora porque é a engine inteira que muda - inclusive a amostra
			// que vai tocar no próximo passo.
			if (int(i) == SOUND_FAMILY_MASTER) g_settings.apply_master();

			if (@preview != null) preview.stop();
			@preview = sound_play(FAMILY_PREVIEW_SOUNDS[i], vector(FLOAT_MAX, FLOAT_MAX, FLOAT_MAX),
				g_settings.volume_db(int(i)), 0.0);
		}
	}
}

// --- Teclas ---
// Lista de ações; Enter numa delas entra no modo "aperte a tecla nova". A tecla é lida com
// keys_pressed(), que devolve o que foi apertado neste quadro - assim qualquer tecla serve, sem
// precisar de uma lista fixa de teclas conhecidas.
void run_keys_screen() {
	while (true) {
		menu m;
		m.intro_text = tr("settings.keys_hint");
		m.click_sound = "menuclick.wav";
		m.select_sound = "menuconfirm.wav";
		m.sounds_prefix = "sounds/";

		for (uint i = 0; i < g_keys.bindings.length(); i++) {
			key_binding@ b = g_keys.bindings[i];
			dictionary@ p = dictionary();
			p.set("action", tr(b.name_key));
			p.set("key", get_key_name(b.key));
			m.add_item(tr("settings.key_item", p), "" + i);
		}
		m.add_item(tr("settings.restore_defaults"), "defaults");
		m.add_item(tr("menu.back"), "back");
		m.run();

		string id = m.selected_item_id;
		if (id == "" || id == "back") {
			g_settings.save();
			return;
		}
		if (id == "defaults") {
			g_keys.restore_defaults();
			g_settings.save();
			speak(tr("settings.defaults_restored"));
			continue;
		}
		capture_key_for(parse_int(id));
	}
}

// Espera o jogador apertar a tecla nova pra esta ação. ESC cancela sem trocar nada.
void capture_key_for(int action) {
	if (action < 0 || action >= int(g_keys.bindings.length())) return;
	key_binding@ binding = g_keys.bindings[action];

	dictionary@ p = dictionary();
	p.set("action", tr(binding.name_key));
	speak(tr("settings.press_new_key", p));
	wait(300); // solta o Enter que abriu isto aqui, senão ele mesmo vira a tecla nova

	while (true) {
		wait(5);
		array<int>@ pressed = keys_pressed();
		if (pressed.length() == 0) continue;

		int key = pressed[0];
		if (key == KEY_ESCAPE) {
			speak(tr("settings.cancelled"));
			return;
		}

		// Tecla já usada por outra ação: uma das duas nunca aconteceria, e descobrir isso no meio de
		// uma partida seria péssimo. Recusa e explica de quem é a tecla.
		int conflict = g_keys.action_using(key, action);
		if (conflict != -1) {
			dictionary@ cp = dictionary();
			cp.set("key", get_key_name(key));
			cp.set("action", tr(g_keys.bindings[conflict].name_key));
			speak(tr("settings.key_in_use", cp));
			return;
		}

		binding.key = key;
		g_settings.save();
		dictionary@ ok = dictionary();
		ok.set("action", tr(binding.name_key));
		ok.set("key", get_key_name(key));
		speak(tr("settings.key_changed", ok));
		return;
	}
}

// --- Voz ---
// O speech.nvgt já traz uma tela de configuração de voz pronta e acessível (escolher voz,
// velocidade, volume, e se deve usar o leitor de tela quando houver um). Reaproveitamos ela inteira
// e só cuidamos de guardar o resultado - é a tela que o jogador de audiogame já conhece de outros
// jogos NVGT, então não vale a pena inventar outra.
void run_voice_screen() {
	tts_config(tts, true);
	g_settings.save();
}
