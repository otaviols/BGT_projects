// Menu Manager
// Gerenciador centralizado de menus do jogo

#include "menu.nvgt"
#include "input_forms.nvgt"
#include "../lang/i18n.nvgt"

// Resultado de menu
enum MenuResult {
	MENU_NONE,
	MENU_PLAY,
	MENU_STATS,
	MENU_SETTINGS,
	MENU_QUIT,
	MENU_CREATE_LOBBY,
	MENU_JOIN_LOBBY,
	MENU_REFRESH,
	MENU_BACK,
	MENU_START_GAME,
	MENU_LEAVE_LOBBY,
	MENU_CONFIG
}

class MenuManager {
	private menu m;
	
	MenuManager() {
		m.wrap = true;
		m.allow_escape = true;
	}
	
	// Menu principal
	MenuResult show_main_menu() {
		m.reset();
		m.intro_text = tr("app_title");
		
		m.add_item(tr("menu_play"));
		m.add_item(tr("menu_stats"));
		m.add_item(tr("menu_settings"));
		m.add_item(tr("menu_quit"));
		
		while (true) {
			wait(5);
			if (!m.monitor()) {
				int selected = m.focused_item;
				
				if (selected == 0) return MENU_PLAY;
				if (selected == 1) return MENU_STATS;
				if (selected == 2) return MENU_SETTINGS;
				if (selected == 3) return MENU_QUIT;
				
				return MENU_NONE;
			}
			
			if (key_pressed(KEY_ESCAPE)) {
				return MENU_QUIT;
			}
		}
		
		return MENU_NONE;
	}
	
	// Menu de lobby (criar ou entrar)
	MenuResult show_lobby_menu() {
		m.reset();
		m.intro_text = tr("lobby_title");
		
		m.add_item(tr("lobby_create"));
		m.add_item(tr("lobby_refresh"));
		m.add_item(tr("menu_back"));
		
		while (true) {
			wait(5);
			if (!m.monitor()) {
				int selected = m.focused_item;
				
				if (selected == 0) return MENU_CREATE_LOBBY;
				if (selected == 1) return MENU_REFRESH;
				if (selected == 2) return MENU_BACK;
				
				return MENU_NONE;
			}
			
			if (key_pressed(KEY_ESCAPE)) {
				return MENU_BACK;
			}
		}
		
		return MENU_NONE;
	}
	
	// Menu de sala de espera
	MenuResult show_waiting_room_menu(string[] player_names, bool is_host, bool can_start) {
		m.reset();
		m.intro_text = tr("lobby_waiting_title") + "\n" + tr("lobby_waiting_players");
		
		// Adiciona nomes dos jogadores como itens
		for (uint i = 0; i < player_names.length(); i++) {
			m.add_item(player_names[i]);
		}
		
		// Adiciona opções
		if (is_host) {
			m.add_item("---");
			m.add_item(tr("lobby_waiting_config"));
			if (can_start) {
				m.add_item(tr("lobby_waiting_start"));
			}
		}
		m.add_item(tr("lobby_waiting_leave"));
		
		while (true) {
			wait(5);
			if (!m.monitor()) {
				int selected = m.focused_item;
				string item = m.get_item_text(selected);
				
				if (item == tr("lobby_waiting_config")) return MENU_CONFIG;
				if (item == tr("lobby_waiting_start")) return MENU_START_GAME;
				if (item == tr("lobby_waiting_leave")) return MENU_LEAVE_LOBBY;
				
				return MENU_NONE;
			}
			
			if (key_pressed(KEY_ESCAPE)) {
				return MENU_LEAVE_LOBBY;
			}
		}
		
		return MENU_NONE;
	}
	
	// Menu de votação
	int show_voting_menu(string[] player_names) {
		m.reset();
		m.intro_text = tr("meeting_voting_phase");
		
		// Adiciona opção de skip
		m.add_item(tr("meeting_vote_skip"));
		
		// Adiciona jogadores vivos
		for (uint i = 0; i < player_names.length(); i++) {
			m.add_item(player_names[i]);
		}
		
		while (true) {
			wait(5);
			if (!m.monitor()) {
				int selected = m.focused_item;
				return selected - 1; // -1 porque skip é índice 0
			}
		}
		
		return -1;
	}
	
	// Diálogo de confirmação
	bool show_confirm_dialog(string message) {
		int result = question(tr("app_title"), message);
		return result == 1;
	}
	
	// Formulário de login
	dictionary@ show_login_form() {
		input_form form(tr("login_title"));
		
		form.add_text_field("username", tr("login_username"), "", true);
		form.add_text_field("password", tr("login_password"), "", true);
		
		dictionary@ result = form.run();
		
		if (form.user_canceled) {
			return null;
		}
		
		return result;
	}
	
	// Formulário de registro
	dictionary@ show_register_form() {
		input_form form(tr("register_title"));
		
		form.add_text_field("username", tr("register_username"), "", true);
		form.add_text_field("password", tr("register_password"), "", true);
		form.add_text_field("confirm_password", tr("register_confirm_password"), "", true);
		form.add_text_field("email", tr("register_email"), "");
		
		dictionary@ result = form.run();
		
		if (form.user_canceled) {
			return null;
		}
		
		// Valida senhas
		string password = dgets(result, "password");
		string confirm = dgets(result, "confirm_password");
		
		if (password != confirm) {
			alert(tr("error_title"), tr("register_error_passwords_dont_match"));
			return null;
		}
		
		return result;
	}
	
	// Formulário de criar lobby
	dictionary@ show_create_lobby_form() {
		input_form form(tr("lobby_create_title"));
		
		form.add_text_field("name", tr("lobby_create_name"), "", true);
		form.add_number_field("max_players", tr("lobby_create_max_players"), MAX_PLAYERS_PER_LOBBY, true);
		
		dictionary@ result = form.run();
		
		if (form.user_canceled) {
			return null;
		}
		
		return result;
	}
	
	// Formulário de configurações de lobby
	LobbyConfig@ show_lobby_config_form(LobbyConfig@ current_config) {
		if (@current_config == null) {
			@current_config = LobbyConfig();
		}
		
		input_form form(tr("config_title"));
		
		// Preset
		string[] presets = {"normal", "quick", "long", "custom"};
		form.add_text_field("preset", tr("config_preset"), "normal", true);
		
		// Configurações
		form.add_number_field("impostors", tr("config_impostors"), current_config.impostors, true);
		form.add_number_field("kill_cooldown", tr("config_kill_cooldown"), current_config.kill_cooldown, true);
		form.add_number_field("discussion_time", tr("config_discussion_time"), current_config.discussion_time, true);
		form.add_number_field("voting_time", tr("config_voting_time"), current_config.voting_time, true);
		form.add_number_field("tasks_per_player", tr("config_tasks_per_player"), current_config.tasks_per_player, true);
		form.add_checkbox_field("visual_tasks", tr("config_visual_tasks"), current_config.visual_tasks);
		form.add_checkbox_field("confirm_ejects", tr("config_confirm_ejects"), current_config.confirm_ejects);
		form.add_number_field("emergency_meetings", tr("config_emergency_meetings"), current_config.emergency_meetings, true);
		
		dictionary@ result = form.run();
		
		if (form.user_canceled) {
			return null;
		}
		
		// Verifica se selecionou preset
		string preset = dgets(result, "preset");
		if (preset != "custom") {
			return get_preset(preset);
		}
		
		// Aplica configurações customizadas
		LobbyConfig@ config = LobbyConfig();
		config.impostors = dgetn(result, "impostors");
		config.kill_cooldown = dgetn(result, "kill_cooldown");
		config.discussion_time = dgetn(result, "discussion_time");
		config.voting_time = dgetn(result, "voting_time");
		config.tasks_per_player = dgetn(result, "tasks_per_player");
		config.visual_tasks = dgetb(result, "visual_tasks");
		config.confirm_ejects = dgetb(result, "confirm_ejects");
		config.emergency_meetings = dgetn(result, "emergency_meetings");
		config.validate();
		
		return config;
	}
	
	// Formulário de configurações do jogo
	dictionary@ show_settings_form() {
		input_form form(tr("settings_title"));
		
		string[] languages = {"pt_BR", "en_US"};
		form.add_choice_field("language", tr("settings_language"), languages);
		form.add_number_field("master_volume", tr("settings_volume_master"), 100);
		form.add_number_field("sfx_volume", tr("settings_volume_sfx"), 100);
		
		dictionary@ result = form.run();
		
		if (form.user_canceled) {
			return null;
		}
		
		return result;
	}
	
	// Mostra estatísticas
	void show_stats(User@ user) {
		if (@user == null) return;
		
		string stats_text = tr("stats_title") + "\n\n";
		stats_text += tr("stats_games_played") + ": " + user.games_played + "\n";
		stats_text += tr("stats_games_won") + ": " + user.games_won + "\n";
		stats_text += tr("stats_win_rate") + ": " + formatFloat(user.get_win_rate(), 1) + "%\n";
		stats_text += tr("stats_crewmate_wins") + ": " + user.crewmate_wins + "\n";
		stats_text += tr("stats_impostor_wins") + ": " + user.impostor_wins + "\n";
		stats_text += tr("stats_tasks_completed") + ": " + user.tasks_completed + "\n";
		stats_text += tr("stats_kills") + ": " + user.kills + "\n";
		
		alert(tr("stats_title"), stats_text);
	}
	
	// Função auxiliar
	private string formatFloat(float value, int decimals) {
		return "" + value; // Simplificado
	}
	
	// Função auxiliar para dictionary
	private string dgets(dictionary@ dict, string key) {
		string value;
		dict.get(key, value);
		return value;
	}
	
	private int dgetn(dictionary@ dict, string key) {
		int value;
		dict.get(key, value);
		return value;
	}
	
	private bool dgetb(dictionary@ dict, string key) {
		bool value;
		dict.get(key, value);
		return value;
	}
}

// Instância global
MenuManager@ g_menu_manager = null;
