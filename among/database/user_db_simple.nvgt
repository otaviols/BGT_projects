// User Database Management - Simple In-Memory Version
// Sistema simplificado sem SQLite para testes

#include "models.nvgt"

// Implementação simples em memória (com persistência em arquivo)
class UserDatabase {
	private dictionary users; // username -> User@
	private dictionary sessions; // token -> username
	private string db_file;
	
	UserDatabase() {
		db_file = "users.dat";
	}
	
	// Inicializa o banco de dados
	bool initialize() {
		// Tenta carregar dados salvos
		if (file_exists(db_file)) {
			if (load_from_file()) {
				return true;
			}
		}
		
		// Se não existe ou falhou, cria usuários de teste
		create_user("admin", "admin123", "admin@test.com");
		create_user("player1", "pass123", "player1@test.com");
		create_user("player2", "pass123", "player2@test.com");
		save_to_file();
		return true;
	}
	
	// Cria novo usuário
	bool create_user(string username, string password, string email = "") {
		if (users.exists(username)) {
			return false; // Username já existe
		}
		
		if (username.length() < 3 || username.length() > 16) {
			return false;
		}
		
		if (password.length() < 6) {
			return false;
		}
		
		User@ user = User();
		user.username = username;
		user.password_hash = password; // Em produção deveria ser hash
		user.email = email;
		user.created_at = datetime();
		
		@users[username] = @user;
		save_to_file(); // Salva após criar usuário
		return true;
	}
	
	// Alias para registro (usado pelo servidor)
	bool register_user(string username, string password) {
		return create_user(username, password, "");
	}
	
	// Verifica login
	bool verify_login(string username, string password) {
		if (!users.exists(username)) {
			return false;
		}
		
		User@ user;
		users.get(username, @user);
		
		if (@user == null) {
			return false;
		}
		
		return user.password_hash == password;
	}
	
	// Cria sessão
	string create_session(string username) {
		if (!users.exists(username)) {
			return "";
		}
		
		// Gera token simples
		string token = username + "_" + datetime().year;
		sessions.set(token, username);
		
		User@ user;
		users.get(username, @user);
		if (@user != null) {
			user.session_token = token;
		}
		
		return token;
	}
	
	// Valida sessão
	bool validate_session(string token) {
		return sessions.exists(token);
	}
	
	// Obtém username de um token
	string get_username_from_token(string token) {
		if (!sessions.exists(token)) {
			return "";
		}
		
		string username;
		sessions.get(token, username);
		return username;
	}
	
	// Obtém usuário
	User@ get_user(string username) {
		if (!users.exists(username)) {
			return null;
		}
		
		User@ user;
		users.get(username, @user);
		return user;
	}
	
	// Obtém estatísticas do usuário
	dictionary get_user_stats(string username) {
		dictionary stats;
		User@ user = get_user(username);
		if (@user == null) {
			return stats;
		}
		
		stats.set("games_played", user.games_played);
		stats.set("games_won", user.games_won);
		stats.set("crewmate_wins", user.crewmate_wins);
		stats.set("impostor_wins", user.impostor_wins);
		stats.set("tasks_completed", user.tasks_completed);
		stats.set("kills", user.kills);
		
		return stats;
	}
	
	// Atualiza estatísticas
	bool update_stats(string username, dictionary stats) {
		User@ user = get_user(username);
		if (@user == null) {
			return false;
		}
		
		stats.get("games_played", user.games_played);
		stats.get("games_won", user.games_won);
		stats.get("crewmate_wins", user.crewmate_wins);
		stats.get("impostor_wins", user.impostor_wins);
		stats.get("tasks_completed", user.tasks_completed);
		stats.get("kills", user.kills);
		
		return true;
	}
	
	// Remove sessão
	void remove_session(string token) {
		if (sessions.exists(token)) {
			sessions.delete(token);
		}
	}
	
	// Fecha banco de dados
	void close() {
		save_to_file(); // Salva antes de fechar
		users.delete_all();
		sessions.delete_all();
	}
	
	// Salva dados em arquivo
	private bool save_to_file() {
		datastream ds;
		ds.binary = true;
		
		// Obtém lista de usuários
		string[] keys = users.get_keys();
		ds.write_uint(keys.length());
		
		for (uint i = 0; i < keys.length(); i++) {
			User@ user;
			users.get(keys[i], @user);
			
			if (@user != null) {
				ds.write_string(user.username);
				ds.write_string(user.password_hash);
				ds.write_string(user.email);
				ds.write_uint(user.games_played);
				ds.write_uint(user.games_won);
				ds.write_uint(user.crewmate_wins);
				ds.write_uint(user.impostor_wins);
				ds.write_uint(user.tasks_completed);
				ds.write_uint(user.kills);
			}
		}
		
		// Salva em arquivo
		file f;
		if (f.open(db_file, "wb")) {
			string data = ds.read();
			f.write(data);
			f.close();
			return true;
		}
		
		return false;
	}
	
	// Carrega dados do arquivo
	private bool load_from_file() {
		file f;
		if (!f.open(db_file, "rb")) {
			return false;
		}
		
		string data = f.read();
		f.close();
		
		datastream ds;
		ds.binary = true;
		ds << data;
		
		try {
			uint count = ds.read_uint();
			
			for (uint i = 0; i < count; i++) {
				User@ user = User();
				user.username = ds.read_string();
				user.password_hash = ds.read_string();
				user.email = ds.read_string();
				user.games_played = ds.read_uint();
				user.games_won = ds.read_uint();
				user.crewmate_wins = ds.read_uint();
				user.impostor_wins = ds.read_uint();
				user.tasks_completed = ds.read_uint();
				user.kills = ds.read_uint();
				user.created_at = datetime();
				
				@users[user.username] = @user;
			}
			
			return true;
		} catch {
			return false;
		}
	}
	
	// Métodos auxiliares para console do servidor
	int get_user_count() {
		string[] keys = users.get_keys();
		return keys.length();
	}
	
	string[] get_all_usernames() {
		return users.get_keys();
	}
}

// Instância global
UserDatabase@ g_user_db = null;
