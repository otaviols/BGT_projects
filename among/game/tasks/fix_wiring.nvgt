// Fix Wiring Task - Quick Time Event com sequência de teclas
#include "../task_manager.nvgt"

class FixWiringTask {
	string[] color_sequence;
	int current_step = 0;
	bool completed = false;
	timer task_timer;
	int TIME_LIMIT = 30000; // 30 segundos
	
	FixWiringTask() {
		generate_sequence();
	}
	
	void generate_sequence() {
		string[] colors = {"red", "blue", "yellow", "green"};
		
		// Gera sequência aleatória de 4 cores
		for (uint i = 0; i < 4; i++) {
			color_sequence.insert_last(colors[random(0, colors.length() - 1)]);
		}
	}
	
	bool start() {
		current_step = 0;
		completed = false;
		task_timer.restart();
		
		screen_reader_speak(tr("task_fix_wiring_start"), true);
		play_instructions();
		
		return run();
	}
	
	void play_instructions() {
		wait(500);
		screen_reader_speak(tr("task_fix_wiring_instructions"), true);
		wait(1000);
		
		// Anuncia a sequência
		for (uint i = 0; i < color_sequence.length(); i++) {
			string color_key = "color_" + color_sequence[i];
			screen_reader_speak(tr(color_key), true);
			g_audio.play_ui("sounds/wire_" + color_sequence[i] + ".ogg");
			wait(800);
		}
		
		screen_reader_speak(tr("task_fix_wiring_repeat"), true);
	}
	
	bool run() {
		while (current_step < int(color_sequence.length())) {
			wait(50);
			
			// Verifica timeout
			if (task_timer.elapsed >= TIME_LIMIT) {
				screen_reader_speak(tr("task_timeout"), true);
				g_audio.play_ui("sounds/task_fail.ogg");
				return false;
			}
			
			// Mapeia teclas para cores
			string pressed_color = "";
			
			if (key_pressed(KEY_R)) {
				pressed_color = "red";
			} else if (key_pressed(KEY_B)) {
				pressed_color = "blue";
			} else if (key_pressed(KEY_Y)) {
				pressed_color = "yellow";
			} else if (key_pressed(KEY_G)) {
				pressed_color = "green";
			} else if (key_pressed(KEY_ESCAPE)) {
				return false; // Cancelar
			}
			
			if (pressed_color != "") {
				if (pressed_color == color_sequence[current_step]) {
					// Correto
					current_step++;
					g_audio.play_ui("sounds/wire_connect.ogg");
					
					if (current_step < int(color_sequence.length())) {
						screen_reader_speak(tr("task_correct") + " " + current_step + "/" + color_sequence.length(), true);
					}
				} else {
					// Errado - reinicia
					current_step = 0;
					g_audio.play_ui("sounds/task_fail.ogg");
					screen_reader_speak(tr("task_wrong_restart"), true);
					wait(1000);
					play_instructions();
				}
			}
		}
		
		// Task completo
		completed = true;
		screen_reader_speak(tr("task_complete"), true);
		g_audio.play_ui("sounds/task_complete.ogg");
		
		return true;
	}
	
	bool is_completed() {
		return completed;
	}
}
