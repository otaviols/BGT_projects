// fuel_engines.nvgt
// Task de abastecer os motores: segure Espaço e o tanque começa a carregar, marcando cada etapa com
// um bipe grave. Quando ele enche, o bipe muda - é a hora de SOLTAR. Continuar segurando depois
// disso transborda e perde a task; soltar antes só pausa, e dá pra continuar de onde parou.
//
// Quantos bipes o tanque precisa é sorteado a cada vez, de propósito: contar não resolve, só
// reconhecer o som de "cheio" resolve. É a task que ensina o jogador a esperar um sinal em vez de
// cronometrar - e a mesma escuta que ele vai usar pra perceber passos se aproximando.

#include "task_common.nvgt"

bool run_fuel_engines_task(game_client@ client) {
	const uint TICKS_MIN = 4;            // quantos bipes de carga até encher
	const uint TICKS_MAX = 8;
	const float SECONDS_PER_TICK = 0.55; // ritmo da carga
	const float OVERFLOW_SECONDS = 1.2;  // tolerância depois de cheio antes de transbordar

	speak(tr("task.fuel_engines.instructions"));

	uint ticks_needed = uint(random(int(TICKS_MIN), int(TICKS_MAX)));
	uint ticks_played = 0;
	float held = 0.0;
	float overflow_timer = 0.0;
	bool full = false;

	timer frame_clock;
	frame_clock.restart();

	while (true) {
		wait(5);
		client.update();
		if (task_cancel_requested(client)) return false;
		float delta = float(frame_clock.elapsed) / 1000.0;
		frame_clock.restart();

		if (!key_down(KEY_SPACE)) {
			if (full) {
				// Soltou dentro da janela: tanque cheio na medida.
				task_sound(SND_BEEP_COMPLETE);
				speak(tr("task.completed"));
				return true;
			}
			continue; // ainda não encheu: soltar só pausa a carga
		}

		if (full) {
			overflow_timer += delta;
			if (overflow_timer < OVERFLOW_SECONDS) continue;
			task_sound(SND_CARD_ERROR);
			speak(tr("task.fuel_engines.overflow"));
			return false;
		}

		held += delta;
		uint expected_ticks = uint(held / SECONDS_PER_TICK);
		if (expected_ticks <= ticks_played) continue;

		ticks_played = expected_ticks;
		if (ticks_played < ticks_needed) {
			task_sound(SND_FILLING); // bipe grave de carga: o tanque subindo
			continue;
		}
		full = true;
		task_sound(SND_FILLING_COMPLETE); // o mesmo bipe, agora com o som de completo: solte AGORA
	}
	return false; // inalcançável - o laço só termina via return acima
}
