// water_plants.nvgt
// Task da estufa: três canteiros, um à sua esquerda, um à frente e um à direita. Segure Espaço pra
// regar o canteiro da vez - a água corre no ouvido dele, e um "gluglu" marca cada etapa do canteiro
// enchendo. Quando ele enche, o som muda: é a hora de SOLTAR. Segurar demais transborda e perde a
// task; soltar antes da hora só pausa, dá pra continuar regando.
//
// A task é toda de reação a um som, sem contagem de tempo visível - e o lado de onde vem a água diz
// em qual canteiro você está, o que a mantém navegável de ouvido mesmo com os três em sequência.

#include "task_common.nvgt"

// Pan de cada canteiro: esquerda, centro, direita.
const array<float> PLANT_PANS = {-100.0, 0.0, 100.0};

bool run_water_plants_task(game_client@ client) {
	const float FILL_SECONDS_MIN = 1.6;  // quanto cada canteiro demora pra encher
	const float FILL_SECONDS_MAX = 3.2;
	const float OVERFLOW_SECONDS = 1.0;  // tolerância depois de cheio antes de transbordar
	const uint FILL_TICKS = 4;           // quantos "gluglus" até encher

	speak(tr("task.water_plants.instructions"));
	wait(500);

	for (uint plant = 0; plant < PLANT_PANS.length(); plant++) {
		float pan = PLANT_PANS[plant];
		float needed = random_range(FILL_SECONDS_MIN, FILL_SECONDS_MAX);
		float watered = 0.0;
		uint ticks_played = 0;
		bool full = false;
		float overflow_timer = 0.0;
		bool pouring = false;

		sound water;
		if (!water.load("sounds/" + SND_WATER_FLOW)) return false;
		water.pan = pan;

		timer frame_clock;
		frame_clock.restart();
		while (true) {
			wait(5);
			client.update();
			if (task_cancel_requested(client)) {
				water.stop();
				return false;
			}
			float delta = float(frame_clock.elapsed) / 1000.0;
			frame_clock.restart();

			if (key_down(KEY_SPACE)) {
				if (!pouring) {
					pouring = true;
					water.play_looped();
				}
				if (full) {
					// Já encheu e continua regando: a paciência do canteiro é curta.
					overflow_timer += delta;
					if (overflow_timer >= OVERFLOW_SECONDS) {
						water.stop();
						task_sound(SND_CARD_ERROR, pan);
						speak(tr("task.water_plants.overflow"));
						return false;
					}
					continue;
				}

				watered += delta;
				// Um gole a cada fatia do enchimento: é o que dá pra sentir o canteiro subindo. A
				// variante é sorteada pra não virar um bipe repetido - mesma ideia dos passos.
				uint expected_ticks = uint((watered / needed) * FILL_TICKS);
				if (expected_ticks > ticks_played && expected_ticks <= FILL_TICKS) {
					ticks_played = expected_ticks;
					task_sound(liquid_sound(random(1, int(LIQUID_VARIANT_COUNT))), pan);
				}
				if (watered >= needed) {
					full = true;
					task_sound(SND_BEEP_COMPLETE, pan); // canteiro cheio: o aviso de soltar
				}
				continue;
			}

			// Soltou.
			if (pouring) {
				pouring = false;
				water.stop();
			}
			if (full) break; // canteiro pronto, vai pro próximo
		}

		wait(300); // respiro entre um canteiro e outro
	}

	task_sound(SND_CARD_COMPLETE); // som de "task inteira concluída", diferente do de canteiro cheio
	speak(tr("task.completed"));
	return true;
}
