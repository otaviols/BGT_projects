// Download Data Task - Timer-based com barra de progresso
#include "../task_manager.nvgt"

class DownloadDataTask {
	int progress = 0;
	bool completed = false;
	bool downloading = false;
	timer progress_timer;
	timer announce_timer;
	int TOTAL_TIME = 9000; // 9 segundos
	int ANNOUNCE_INTERVAL = 2000; // Anuncia a cada 2 segundos
	
	bool start() {
		progress = 0;
		completed = false;
		downloading = false;
		
		screen_reader_speak(tr("task_download_data_start"), true);
		wait(500);
		screen_reader_speak(tr("task_download_data_instructions"), true);
		
		return run();
	}
	
	bool run() {
		while (!completed) {
			wait(50);
			
			// Pressionar espaço para iniciar/continuar download
			if (key_pressed(KEY_SPACE) && !downloading) {
				start_download();
			}
			
			// ESC para cancelar
			if (key_pressed(KEY_ESCAPE)) {
				return false;
			}
			
			// Atualiza progresso
			if (downloading) {
				update_progress();
			}
		}
		
		return true;
	}
	
	void start_download() {
		downloading = true;
		progress_timer.restart();
		announce_timer.restart();
		
		screen_reader_speak(tr("task_download_started"), true);
		g_audio.play_ui("sounds/download_start.ogg");
	}
	
	void update_progress() {
		int elapsed = progress_timer.elapsed;
		progress = int((float(elapsed) / float(TOTAL_TIME)) * 100);
		
		if (progress >= 100) {
			progress = 100;
			completed = true;
			downloading = false;
			
			screen_reader_speak(tr("task_download_complete"), true);
			g_audio.play_ui("sounds/task_complete.ogg");
			return;
		}
		
		// Anuncia progresso periodicamente
		if (announce_timer.elapsed >= ANNOUNCE_INTERVAL) {
			announce_timer.restart();
			
			// Arredonda para múltiplo de 10
			int announce_progress = (progress / 10) * 10;
			screen_reader_speak(announce_progress + "%", true);
			g_audio.play_ui("sounds/download_progress.ogg", 0.3);
		}
	}
	
	bool is_completed() {
		return completed;
	}
	
	int get_progress() {
		return progress;
	}
}
