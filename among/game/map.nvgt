// map.nvgt
// Definição do mapa: salas (retângulos), corredores conectando-as e objetos interativos
// posicionados dentro delas. Coordenadas em "unidades de mundo" (ver PLAYER_MOVE_SPEED).
// Tudo isso é dado estático compartilhado entre cliente e servidor - o servidor usa para validar
// posição/alcance de interação, o cliente usa para tocar os sons posicionados corretos.

#include "../config/game_constants.nvgt"

class map_zone {
	string id;
	string name_key; // chave de i18n, ex: "room.cafeteria"
	float center_x, center_y;
	float half_w, half_h;
	string floor_sound_prefix; // ex: "Tile", "MetalTile", "EarthTile", "VentTile" (arquivos sounds/<prefix><n>.wav)
	bool is_corridor;

	map_zone(const string&in id, const string&in name_key, float cx, float cy, float hw, float hh,
			const string&in floor_prefix, bool corridor = false) {
		this.id = id;
		this.name_key = name_key;
		center_x = cx;
		center_y = cy;
		half_w = hw;
		half_h = hh;
		floor_sound_prefix = floor_prefix;
		is_corridor = corridor;
	}

	bool contains(float x, float y) const {
		return x >= center_x - half_w && x <= center_x + half_w &&
			y >= center_y - half_h && y <= center_y + half_h;
	}
}

// Tipos de objeto interativo.
enum map_object_type {
	OBJ_TASK_SPOT = 0,
	OBJ_VENT,
	OBJ_SABOTAGE_PANEL,
	OBJ_EMERGENCY_BUTTON,
	OBJ_DECORATION // mesa, cadeira, etc: só emite som ambiente, sem interação de gameplay
}

class map_object {
	string id;
	string name_key;
	float x, y;
	string room_id;
	int obj_type;
	string sound_path;      // som tocado ao interagir / ambiente contínuo baixo
	string task_type;       // se OBJ_TASK_SPOT: "fix_wiring", "download_data", etc.
	string linked_object_id; // se OBJ_VENT: id do vent de destino

	map_object(const string&in id, const string&in name_key, float x, float y, const string&in room_id,
			int obj_type, const string&in sound_path, const string&in task_type = "",
			const string&in linked_object_id = "") {
		this.id = id;
		this.name_key = name_key;
		this.x = x;
		this.y = y;
		this.room_id = room_id;
		this.obj_type = obj_type;
		this.sound_path = sound_path;
		this.task_type = task_type;
		this.linked_object_id = linked_object_id;
	}
}

class game_map {
	string name;
	array<map_zone@> zones;
	array<map_object@> objects;

	map_zone@ zone_at(float x, float y) const {
		for (uint i = 0; i < zones.length(); i++) {
			if (zones[i].contains(x, y)) return zones[i];
		}
		return null;
	}

	string room_id_at(float x, float y) const {
		map_zone@ z = zone_at(x, y);
		return @z == null ? "" : z.id;
	}

	map_object@ find_object(const string&in id) const {
		for (uint i = 0; i < objects.length(); i++) {
			if (objects[i].id == id) return objects[i];
		}
		return null;
	}

	array<map_object@>@ objects_in_room(const string&in room_id) const {
		array<map_object@> result;
		for (uint i = 0; i < objects.length(); i++) {
			if (objects[i].room_id == room_id) result.insert_last(objects[i]);
		}
		return result;
	}

	array<map_object@>@ objects_by_type(int obj_type) const {
		array<map_object@> result;
		for (uint i = 0; i < objects.length(); i++) {
			if (objects[i].obj_type == obj_type) result.insert_last(objects[i]);
		}
		return result;
	}
}

// Mapa padrão do MVP: layout simplificado inspirado no Skeld clássico, 8 salas + corredores.
game_map@ build_the_hub_map() {
	game_map@ m = game_map();
	m.name = "the_hub";

	// Salas
	m.zones.insert_last(map_zone("cafeteria", "room.cafeteria", 0, 0, 12, 8, "Tile"));
	m.zones.insert_last(map_zone("weapons", "room.weapons", -30, 0, 8, 8, "Tile"));
	m.zones.insert_last(map_zone("navigation", "room.navigation", 35, 0, 8, 8, "MetalTile"));
	m.zones.insert_last(map_zone("admin", "room.admin", 0, -25, 8, 8, "Tile"));
	m.zones.insert_last(map_zone("medbay", "room.medbay", -30, -25, 8, 8, "Tile"));
	m.zones.insert_last(map_zone("storage", "room.storage", 0, -50, 10, 8, "EarthTile"));
	m.zones.insert_last(map_zone("electrical", "room.electrical", -30, -50, 8, 8, "MetalTile"));
	m.zones.insert_last(map_zone("reactor", "room.reactor", -30, -75, 8, 8, "MetalTile"));

	// Corredores (ligam as salas acima)
	m.zones.insert_last(map_zone("corridor_cafeteria_weapons", "corridor", -17, 0, 5, 3, "Tile", true));
	m.zones.insert_last(map_zone("corridor_cafeteria_navigation", "corridor", 19.5, 0, 7.5, 3, "Tile", true));
	m.zones.insert_last(map_zone("corridor_cafeteria_admin", "corridor", 0, -12.5, 3, 4.5, "Tile", true));
	m.zones.insert_last(map_zone("corridor_weapons_medbay", "corridor", -30, -12.5, 3, 4.5, "Tile", true));
	m.zones.insert_last(map_zone("corridor_admin_medbay", "corridor", -15, -25, 7, 3, "Tile", true));
	m.zones.insert_last(map_zone("corridor_admin_storage", "corridor", 0, -37.5, 3, 4.5, "Tile", true));
	m.zones.insert_last(map_zone("corridor_medbay_electrical", "corridor", -30, -37.5, 3, 4.5, "Tile", true));
	m.zones.insert_last(map_zone("corridor_storage_electrical", "corridor", -16, -50, 6, 3, "EarthTile", true));
	m.zones.insert_last(map_zone("corridor_electrical_reactor", "corridor", -30, -62.5, 3, 4.5, "MetalTile", true));

	// Vents (tríade clássica: reactor <-> electrical <-> medbay), só usável pelo impostor
	m.objects.insert_last(map_object("vent_reactor", "object.vent", -30, -71, "reactor", OBJ_VENT,
		"sounds/ventDoor1.wav", "", "vent_electrical"));
	m.objects.insert_last(map_object("vent_electrical", "object.vent", -30, -46, "electrical", OBJ_VENT,
		"sounds/ventDoor1.wav", "", "vent_medbay"));
	m.objects.insert_last(map_object("vent_medbay", "object.vent", -30, -21, "medbay", OBJ_VENT,
		"sounds/ventDoor2.wav", "", "vent_reactor"));

	// Tasks (espalhadas por várias salas, jogador recebe um subconjunto aleatório)
	m.objects.insert_last(map_object("task_wiring_admin", "task.fix_wiring.name", 3, -22, "admin",
		OBJ_TASK_SPOT, "sounds/eletricalString1.wav", "fix_wiring"));
	m.objects.insert_last(map_object("task_wiring_electrical", "task.fix_wiring.name", -33, -47, "electrical",
		OBJ_TASK_SPOT, "sounds/eletricalString2.wav", "fix_wiring"));
	m.objects.insert_last(map_object("task_wiring_navigation", "task.fix_wiring.name", 38, 3, "navigation",
		OBJ_TASK_SPOT, "sounds/eletricalString3.wav", "fix_wiring"));
	m.objects.insert_last(map_object("task_download_admin", "task.download_data.name", -3, -28, "admin",
		OBJ_TASK_SPOT, "sounds/beep.wav", "download_data"));
	m.objects.insert_last(map_object("task_download_navigation", "task.download_data.name", 32, -3, "navigation",
		OBJ_TASK_SPOT, "sounds/beep.wav", "download_data"));
	m.objects.insert_last(map_object("task_download_weapons", "task.download_data.name", -33, 3, "weapons",
		OBJ_TASK_SPOT, "sounds/beep.wav", "download_data"));
	m.objects.insert_last(map_object("task_garbage_cafeteria", "task.empty_garbage.name", 5, 5, "cafeteria",
		OBJ_TASK_SPOT, "sounds/BeepComplet.wav", "empty_garbage"));
	m.objects.insert_last(map_object("task_garbage_storage", "task.empty_garbage.name", 3, -53, "storage",
		OBJ_TASK_SPOT, "sounds/BeepComplet.wav", "empty_garbage"));
	m.objects.insert_last(map_object("task_align_navigation", "task.align_engine.name", 35, -3, "navigation",
		OBJ_TASK_SPOT, "sounds/beep.wav", "align_engine"));
	m.objects.insert_last(map_object("task_card_admin", "task.swipe_card.name", -3, -22, "admin",
		OBJ_TASK_SPOT, "sounds/GetCard.wav", "swipe_card"));

	// Sabotagens
	m.objects.insert_last(map_object("panel_lights_electrical", "sabotage.lights.name", -27, -53, "electrical",
		OBJ_SABOTAGE_PANEL, "sounds/openPanel.wav", "lights"));
	m.objects.insert_last(map_object("panel_oxygen_admin", "sabotage.oxygen.name", 3, -22, "admin",
		OBJ_SABOTAGE_PANEL, "sounds/openPanel.wav", "oxygen"));
	m.objects.insert_last(map_object("panel_oxygen_electrical", "sabotage.oxygen.name", -33, -53, "electrical",
		OBJ_SABOTAGE_PANEL, "sounds/openPanel.wav", "oxygen"));

	// Botão de emergência
	m.objects.insert_last(map_object("emergency_button", "game.emergency_meeting_called", 0, 3, "cafeteria",
		OBJ_EMERGENCY_BUTTON, "sounds/emergence1.wav"));

	return m;
}
