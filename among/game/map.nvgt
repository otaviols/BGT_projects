// map.nvgt
// Definição do mapa: salas (retângulos), corredores conectando-as e objetos interativos
// posicionados dentro delas. Coordenadas em "unidades de mundo" (ver PLAYER_MOVE_SPEED).
// Tudo isso é dado estático compartilhado entre cliente e servidor - o servidor usa para validar
// posição/alcance de interação, o cliente usa para tocar os sons posicionados corretos.

#include "../config/game_constants.nvgt"
#include "../audio/sound_catalog.nvgt"
#include "../lang/i18n.nvgt"

class map_zone {
	string id;
	string name_key; // chave de i18n, ex: "room.cafeteria"
	float center_x, center_y;
	float half_w, half_h;
	string floor_sound_prefix; // ex: "Tile", "MetalTile", "EarthTile", "VentTile" (arquivos sounds/<prefix><n>.wav)
	bool is_corridor;

	map_zone(const string&in id, const string&in name_key, float cx, float cy, float hw, float hh,
			const string&in floor_prefix, bool corridor = false) {
		this.id = id;
		this.name_key = name_key;
		center_x = cx;
		center_y = cy;
		half_w = hw;
		half_h = hh;
		floor_sound_prefix = floor_prefix;
		is_corridor = corridor;
	}

	bool contains(float x, float y) const {
		return x >= center_x - half_w && x <= center_x + half_w &&
			y >= center_y - half_h && y <= center_y + half_h;
	}
}

// Tipos de objeto interativo.
enum map_object_type {
	OBJ_TASK_SPOT = 0,
	OBJ_VENT,
	OBJ_SABOTAGE_PANEL,
	OBJ_EMERGENCY_BUTTON,
	OBJ_DECORATION // mesa, cadeira, etc: só emite som ambiente, sem interação de gameplay
}

class map_object {
	string id;
	string name_key;
	float x, y;
	string room_id;
	int obj_type;
	string sound_path;      // som tocado UMA VEZ ao interagir (abrir painel, usar vent, etc.)
	string beacon_sound_path; // som CONTÍNUO posicionado, pra achar o objeto de longe - "" = sem beacon
	string task_type;       // se OBJ_TASK_SPOT: "fix_wiring", "download_data", etc.
	string linked_object_id; // se OBJ_VENT: id do vent de destino

	map_object(const string&in id, const string&in name_key, float x, float y, const string&in room_id,
			int obj_type, const string&in sound_path, const string&in task_type = "",
			const string&in linked_object_id = "", const string&in beacon_sound_path = "") {
		this.id = id;
		this.name_key = name_key;
		this.x = x;
		this.y = y;
		this.room_id = room_id;
		this.obj_type = obj_type;
		this.sound_path = sound_path;
		this.task_type = task_type;
		this.linked_object_id = linked_object_id;
		this.beacon_sound_path = beacon_sound_path;
	}
}

class game_map {
	string name;
	array<map_zone@> zones;
	array<map_object@> objects;

	// --- Portas ---
	// Uma "porta" é um CORREDOR fechado: enquanto está fechado, ninguém vivo atravessa aquele
	// corredor (é a única passagem entre duas salas). Os ids ficam aqui, junto do mapa, porque
	// servidor e cliente têm cada um a sua instância e os dois precisam da mesma resposta em
	// is_walkable. Quem manda no tempo é sempre o servidor: no cliente os timers ficam zerados e as
	// portas só abrem quando chega o pacote dizendo que abriram (assim os dois lados nunca discordam
	// sobre uma porta estar aberta ou não).
	array<string> closed_door_zones;
	array<float> closed_door_timers;

	bool is_door_closed(const string&in zone_id) const {
		return closed_door_zones.find(zone_id) != -1;
	}

	void close_doors(array<string>@ zone_ids, float seconds) {
		for (uint i = 0; i < zone_ids.length(); i++) {
			int existing = closed_door_zones.find(zone_ids[i]);
			if (existing != -1) {
				closed_door_timers[existing] = seconds;
				continue;
			}
			closed_door_zones.insert_last(zone_ids[i]);
			closed_door_timers.insert_last(seconds);
		}
	}

	// Abre TODAS as portas de uma vez e devolve quais estavam fechadas (pra avisar quem precisa).
	array<string>@ open_all_doors() {
		array<string> opened = closed_door_zones;
		closed_door_zones.resize(0);
		closed_door_timers.resize(0);
		return opened;
	}

	void open_doors(array<string>@ zone_ids) {
		for (uint i = 0; i < zone_ids.length(); i++) {
			int index = closed_door_zones.find(zone_ids[i]);
			if (index == -1) continue;
			closed_door_zones.remove_at(index);
			closed_door_timers.remove_at(index);
		}
	}

	// Só o servidor chama isto (no cliente os timers são 0). Devolve as portas que acabaram de abrir.
	array<string>@ tick_doors(float delta_seconds) {
		array<string> opened;
		for (int i = int(closed_door_zones.length()) - 1; i >= 0; i--) {
			if (closed_door_timers[i] <= 0.0) continue;
			closed_door_timers[i] -= delta_seconds;
			if (closed_door_timers[i] > 0.0) continue;
			opened.insert_last(closed_door_zones[i]);
			closed_door_zones.remove_at(i);
			closed_door_timers.remove_at(i);
		}
		return opened;
	}

	map_zone@ zone_at(float x, float y) const {
		for (uint i = 0; i < zones.length(); i++) {
			if (zones[i].contains(x, y)) return zones[i];
		}
		return null;
	}

	string room_id_at(float x, float y) const {
		map_zone@ z = zone_at(x, y);
		return @z == null ? "" : z.id;
	}

	map_zone@ find_zone(const string&in id) const {
		for (uint i = 0; i < zones.length(); i++) {
			if (zones[i].id == id) return zones[i];
		}
		return null;
	}

	// Uma posição só é válida se cair dentro de alguma sala ou corredor - o resto do "mundo" é
	// parede/vazio. Usado tanto pelo cliente (som de bater na parede) quanto pelo servidor
	// (anti-cheat: rejeita posições fora de qualquer sala/corredor).
	bool is_walkable(float x, float y) const {
		map_zone@ zone = zone_at(x, y);
		return @zone != null && !is_door_closed(zone.id);
	}

	// Um passo de (from) para (to) é permitido?
	//
	// Parede é parede para todo mundo. Porta fechada barra só quem está FORA dela: quem já estava
	// dentro do corredor na hora em que a porta fechou continua andando normalmente e consegue sair
	// pelo outro lado. Sem essa distinção, o jogador pego dentro do corredor ficava congelado no
	// lugar até a porta reabrir - qualquer passo que ele tentasse caía dentro do mesmo corredor
	// fechado e era recusado, como se ele estivesse entalado na porta.
	//
	// Fantasma atravessa porta fechada de qualquer jeito, igual ao jogo original, onde morto passa
	// por tudo - é também o que garante que ele nunca fica preso longe das tasks dele.
	bool can_move(float from_x, float from_y, float to_x, float to_y, bool alive) const {
		map_zone@ destination = zone_at(to_x, to_y);
		if (@destination == null) return false; // fora de qualquer sala ou corredor
		if (!is_door_closed(destination.id)) return true;
		if (!alive) return true;

		map_zone@ origin = zone_at(from_x, from_y);
		return @origin != null && origin.id == destination.id;
	}

	map_object@ find_object(const string&in id) const {
		for (uint i = 0; i < objects.length(); i++) {
			if (objects[i].id == id) return objects[i];
		}
		return null;
	}

	// IDs de todo vent conectado a este (mesma rede) - ver linked_object_id, que guarda vários IDs
	// separados por vírgula em vez de um destino fixo só.
	array<string>@ vent_connections(map_object@ vent) const {
		array<string> result;
		if (@vent == null || vent.linked_object_id == "") return result;
		string[]@ parts = vent.linked_object_id.split(",");
		for (uint i = 0; i < parts.length(); i++) result.insert_last(parts[i]);
		return result;
	}

	// --- Grafo de zonas (usado pela IA dos bots pra andar de sala em sala) ---
	// A ligação entre salas não está escrita em lugar nenhum: ela sai do ID de cada corredor, que
	// por convenção é "corridor_<sala_a>_<sala_b>" (ver build_the_hub_map). Como todo id de sala é
	// uma palavra só, dá pra recuperar as duas pontas com um split.
	array<string>@ zone_neighbors(const string&in zone_id) const {
		array<string> result;
		for (uint i = 0; i < zones.length(); i++) {
			map_zone@ z = zones[i];
			if (!z.is_corridor) continue;
			array<string>@ parts = z.id.split("_");
			if (parts.length() != 3) continue;
			if (z.id == zone_id) {
				result.insert_last(parts[1]);
				result.insert_last(parts[2]);
			} else if (parts[1] == zone_id || parts[2] == zone_id) {
				result.insert_last(z.id);
			}
		}
		return result;
	}

	// Menor caminho (em número de zonas) de from_zone até to_zone, já SEM a zona de origem e COM a
	// de destino. Devolve lista vazia se já estiver lá ou se não houver caminho. Andar em linha reta
	// do centro de uma zona até o centro da zona vizinha sempre passa por dentro das duas (as salas
	// e corredores deste mapa são retângulos alinhados), então o centro de cada zona do caminho serve
	// como waypoint sem precisar de nada mais esperto que isso.
	array<string>@ zone_path(const string&in from_zone, const string&in to_zone) const {
		array<string> path;
		if (from_zone == "" || to_zone == "" || from_zone == to_zone) return path;

		array<string> queue = {from_zone};
		dictionary came_from; // zona -> zona anterior no caminho
		came_from.set(from_zone, string(""));
		bool found = false;

		for (uint head = 0; head < queue.length() && !found; head++) {
			string current = queue[head];
			array<string>@ neighbors = zone_neighbors(current);
			for (uint i = 0; i < neighbors.length(); i++) {
				string next = neighbors[i];
				if (came_from.exists(next)) continue;
				came_from.set(next, current);
				if (next == to_zone) { found = true; break; }
				queue.insert_last(next);
			}
		}
		if (!found) return path;

		string step = to_zone;
		while (step != "" && step != from_zone) {
			path.insert_at(0, step);
			string previous;
			came_from.get(step, previous);
			step = previous;
		}
		return path;
	}

	// Salas de verdade (sem corredores) - a IA dos bots usa pra sortear pra onde passear.
	array<map_zone@>@ room_zones() const {
		array<map_zone@> result;
		for (uint i = 0; i < zones.length(); i++) {
			if (!zones[i].is_corridor) result.insert_last(zones[i]);
		}
		return result;
	}

	array<map_object@>@ objects_in_room(const string&in room_id) const {
		array<map_object@> result;
		for (uint i = 0; i < objects.length(); i++) {
			if (objects[i].room_id == room_id) result.insert_last(objects[i]);
		}
		return result;
	}

	array<map_object@>@ objects_by_type(int obj_type) const {
		array<map_object@> result;
		for (uint i = 0; i < objects.length(); i++) {
			if (objects[i].obj_type == obj_type) result.insert_last(objects[i]);
		}
		return result;
	}
}

// Nome falado de um objeto do mapa. Botão e painel têm nome genérico (o name_key deles guarda outra
// coisa: o texto do evento e o nome da sabotagem), o resto usa a própria chave. Fica aqui, junto do
// mapa, porque tanto o laço do jogo quanto o radar de objetos falam nome de objeto.
string object_name(map_object@ o) {
	if (@o == null) return "";
	if (o.obj_type == OBJ_EMERGENCY_BUTTON) return tr("object.emergency_button");
	if (o.obj_type == OBJ_SABOTAGE_PANEL) return tr("object.sabotage_panel");
	return tr(o.name_key);
}

// O que o radar no modo "objetos" enxerga a partir de (x, y): o que existe na sala, dentro do
// alcance do radar, e que faça sentido pra ESTE jogador.
//
// Task só entra se for SUA e ainda estiver pendente. Antes o radar listava as tasks de todo mundo,
// o que é ruído puro - você não pode fazer a task dos outros - e ainda entregava o mapa de tarefas
// alheio. Painéis, vents e botão continuam entrando pra qualquer um: são pontos de referência da
// nave, não segredo de ninguém.
//
// O botão de emergência é a exceção: com as luzes apagadas ele não funciona, então some do radar
// também (ver emergency_button_block_reason em core/game_state.nvgt).
array<map_object@>@ interactables_in_room(game_map@ map, const string&in room_id, float from_x, float from_y,
		array<string>@ my_task_object_ids, const string&in active_sabotage_id = "") {
	array<map_object@> result;
	array<map_object@>@ all = map.objects_in_room(room_id);
	for (uint i = 0; i < all.length(); i++) {
		map_object@ o = all[i];
		if (o.obj_type == OBJ_DECORATION) continue;
		if (o.obj_type == OBJ_EMERGENCY_BUTTON && active_sabotage_id == "lights") continue;
		if (o.obj_type == OBJ_TASK_SPOT) {
			if (@my_task_object_ids == null || my_task_object_ids.find(o.id) == -1) continue;
		}
		if (distance_2d(from_x, from_y, o.x, o.y) > RADAR_OBJECT_RANGE) continue;
		result.insert_last(o);
	}
	return result;
}

// Mapa padrão do MVP: layout simplificado inspirado no Skeld clássico, 8 salas + corredores.
game_map@ build_the_hub_map() {
	game_map@ m = game_map();
	m.name = "the_hub";

	// Salas
	m.zones.insert_last(map_zone("cafeteria", "room.cafeteria", 0, 0, 12, 8, "WoodTile"));
	m.zones.insert_last(map_zone("weapons", "room.weapons", -30, 0, 8, 8, "Tile"));
	m.zones.insert_last(map_zone("navigation", "room.navigation", 35, 0, 8, 8, "MetalTile"));
	m.zones.insert_last(map_zone("admin", "room.admin", 0, -25, 8, 8, "Tile"));
	m.zones.insert_last(map_zone("medbay", "room.medbay", -30, -25, 8, 8, "Tile"));
	m.zones.insert_last(map_zone("storage", "room.storage", 0, -50, 10, 8, "MetalBeltTile"));
	m.zones.insert_last(map_zone("electrical", "room.electrical", -30, -50, 8, 8, "MetalTile"));
	m.zones.insert_last(map_zone("reactor", "room.reactor", -30, -75, 8, 8, "MetalTile"));

	// Corredores (ligam as salas acima). Cada um tem NOME PRÓPRIO: o jogo anuncia o nome da zona toda
	// vez que se entra nela, na tecla C, e no aviso de corpo encontrado - com todos chamados
	// "Corredor" (como era antes), saber que o corpo estava "no corredor" não dizia nada, porque são
	// nove. O nome é o do lugar pra onde o corredor leva saindo do centro do mapa; quando dois
	// corredores disputam o mesmo destino, o segundo fica com o nome da região.
	m.zones.insert_last(map_zone("corridor_cafeteria_weapons", "corridor.weapons", -17, 0, 5, 3, "Tile", true));
	m.zones.insert_last(map_zone("corridor_cafeteria_navigation", "corridor.navigation", 19.5, 0, 7.5, 3, "Tile", true));
	m.zones.insert_last(map_zone("corridor_cafeteria_admin", "corridor.admin", 0, -12.5, 3, 4.5, "Tile", true));
	// Liga armas e enfermaria: os dois nomes já são de outros corredores, e este é o trecho mais a
	// oeste do mapa - daí o nome pela região.
	m.zones.insert_last(map_zone("corridor_weapons_medbay", "corridor.west", -30, -12.5, 3, 4.5, "Tile", true));
	m.zones.insert_last(map_zone("corridor_admin_medbay", "corridor.medbay", -15, -25, 7, 3, "Tile", true));
	m.zones.insert_last(map_zone("corridor_admin_storage", "corridor.storage", 0, -37.5, 3, 4.5, "Tile", true));
	m.zones.insert_last(map_zone("corridor_medbay_electrical", "corridor.electrical", -30, -37.5, 3, 4.5, "Tile", true));
	// Único corredor com piso de terra, o que já dá identidade própria a ele de ouvido.
	m.zones.insert_last(map_zone("corridor_storage_electrical", "corridor.cargo", -16, -50, 6, 3, "EarthTile", true));
	m.zones.insert_last(map_zone("corridor_electrical_reactor", "corridor.reactor", -30, -62.5, 3, 4.5, "MetalTile", true));

	// Vents: uma rede só, com as três bocas totalmente conectadas entre si (não é uma corrente de um
	// sentido só). Só o impostor usa. linked_object_id guarda TODOS os vents conectados, separados
	// por vírgula (ver vent_connections()).
	//
	// As bocas ficam nos TRÊS CANTOS do mapa - navegação (extremo leste), armas (sudoeste) e reator
	// (extremo norte) - e nenhum par delas é ligado por corredor direto. Isso é o ponto todo do vent:
	// antes as três ficavam empilhadas na coluna oeste (reator, elétrica, enfermaria), ou seja,
	// paralelas ao corredor que já ligava as três a pé - viajar pelo duto economizava alguns segundos
	// e não criava álibi nenhum. Agora sumir na navegação e reaparecer no reator é uma travessia que
	// NÃO existe a pé em tempo nenhum, que é o que torna o vent uma arma de verdade.
	//
	// A navegação é de propósito a sala com mais tasks do mapa (fiação, download, alinhar motor,
	// asteroides e o painel de comunicações): é onde o tripulante fica mais tempo sozinho, e agora é
	// de onde o impostor some.
	m.objects.insert_last(map_object("vent_navigation", "object.vent", 35, 6, "navigation", OBJ_VENT,
		SND_VENT_DOOR_1, "", "vent_weapons,vent_reactor", SND_VENT_BEACON));
	m.objects.insert_last(map_object("vent_weapons", "object.vent", -30, 6, "weapons", OBJ_VENT,
		SND_VENT_DOOR_2, "", "vent_navigation,vent_reactor", SND_VENT_BEACON));
	m.objects.insert_last(map_object("vent_reactor", "object.vent", -30, -71, "reactor", OBJ_VENT,
		SND_VENT_DOOR_1, "", "vent_navigation,vent_weapons", SND_VENT_BEACON));

	// Tasks (espalhadas por várias salas, jogador recebe um subconjunto aleatório). O beacon é por
	// TIPO de task, não por sala - a mesma task em salas diferentes soa igual de propósito.
	m.objects.insert_last(map_object("task_wiring_admin", "task.fix_wiring.name", 3, -22, "admin",
		OBJ_TASK_SPOT, "sounds/" + electrical_string_sound(1), "fix_wiring", "", SND_TASK_BEACON_FIX_WIRING));
	m.objects.insert_last(map_object("task_wiring_electrical", "task.fix_wiring.name", -33, -47, "electrical",
		OBJ_TASK_SPOT, "sounds/" + electrical_string_sound(2), "fix_wiring", "", SND_TASK_BEACON_FIX_WIRING));
	m.objects.insert_last(map_object("task_wiring_navigation", "task.fix_wiring.name", 38, 3, "navigation",
		OBJ_TASK_SPOT, "sounds/" + electrical_string_sound(3), "fix_wiring", "", SND_TASK_BEACON_FIX_WIRING));
	m.objects.insert_last(map_object("task_download_admin", "task.download_data.name", -3, -28, "admin",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "download_data", "", SND_TASK_BEACON_DOWNLOAD_DATA));
	m.objects.insert_last(map_object("task_download_navigation", "task.download_data.name", 32, -3, "navigation",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "download_data", "", SND_TASK_BEACON_DOWNLOAD_DATA));
	m.objects.insert_last(map_object("task_download_weapons", "task.download_data.name", -33, 3, "weapons",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "download_data", "", SND_TASK_BEACON_DOWNLOAD_DATA));
	m.objects.insert_last(map_object("task_garbage_cafeteria", "task.empty_garbage.name", 5, 5, "cafeteria",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP_COMPLETE, "empty_garbage", "", SND_TASK_BEACON_EMPTY_GARBAGE));
	m.objects.insert_last(map_object("task_garbage_storage", "task.empty_garbage.name", 3, -53, "storage",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP_COMPLETE, "empty_garbage", "", SND_TASK_BEACON_EMPTY_GARBAGE));
	m.objects.insert_last(map_object("task_align_navigation", "task.align_engine.name", 35, -3, "navigation",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "align_engine", "", SND_TASK_BEACON_ALIGN_ENGINE));
	m.objects.insert_last(map_object("task_card_admin", "task.swipe_card.name", -3, -22, "admin",
		OBJ_TASK_SPOT, "sounds/" + SND_GET_CARD, "swipe_card", "", SND_TASK_BEACON_SWIPE_CARD));
	m.objects.insert_last(map_object("task_manifolds_reactor", "task.unlock_manifolds.name", -33, -78, "reactor",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "unlock_manifolds", "", SND_TASK_BEACON_UNLOCK_MANIFOLDS));
	m.objects.insert_last(map_object("task_manifolds_medbay", "task.unlock_manifolds.name", -33, -28, "medbay",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "unlock_manifolds", "", SND_TASK_BEACON_UNLOCK_MANIFOLDS));
	m.objects.insert_last(map_object("task_fuel_storage", "task.fuel_engines.name", -3, -53, "storage",
		OBJ_TASK_SPOT, "sounds/" + SND_PULLING_GARBAGE_LEVER, "fuel_engines", "", SND_TASK_BEACON_FUEL_ENGINES));
	m.objects.insert_last(map_object("task_fuel_reactor", "task.fuel_engines.name", -27, -78, "reactor",
		OBJ_TASK_SPOT, "sounds/" + SND_PULLING_GARBAGE_LEVER, "fuel_engines", "", SND_TASK_BEACON_FUEL_ENGINES));
	m.objects.insert_last(map_object("task_asteroids_weapons", "task.clear_asteroids.name", -27, -3, "weapons",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "clear_asteroids", "", SND_TASK_BEACON_CLEAR_ASTEROIDS));
	m.objects.insert_last(map_object("task_asteroids_navigation", "task.clear_asteroids.name", 32, 3, "navigation",
		OBJ_TASK_SPOT, "sounds/" + SND_BEEP, "clear_asteroids", "", SND_TASK_BEACON_CLEAR_ASTEROIDS));

	// Sabotagens
	m.objects.insert_last(map_object("panel_lights_electrical", "sabotage.lights.name", -27, -53, "electrical",
		OBJ_SABOTAGE_PANEL, SND_OPEN_PANEL, "lights", "", SND_PANEL_BEACON_LIGHTS));
	m.objects.insert_last(map_object("panel_oxygen_admin", "sabotage.oxygen.name", 6, -20, "admin",
		OBJ_SABOTAGE_PANEL, SND_OPEN_PANEL, "oxygen", "", SND_PANEL_BEACON_OXYGEN));
	m.objects.insert_last(map_object("panel_oxygen_electrical", "sabotage.oxygen.name", -33, -53, "electrical",
		OBJ_SABOTAGE_PANEL, SND_OPEN_PANEL, "oxygen", "", SND_PANEL_BEACON_OXYGEN));
	m.objects.insert_last(map_object("panel_comms_navigation", "sabotage.comms.name", 38, -6, "navigation",
		OBJ_SABOTAGE_PANEL, SND_OPEN_PANEL, "comms", "", SND_PANEL_BEACON_COMMS));

	// Botão de emergência - sound_path toca ao interagir (hoje nenhum, ver nota abaixo);
	// beacon_sound_path é o som contínuo pra achar o botão de longe.
	m.objects.insert_last(map_object("emergency_button", "game.emergency_meeting_called", 0, 3, "cafeteria",
		OBJ_EMERGENCY_BUTTON, "", "", "", SND_BUTTON_BEACON));

	// Ambiente por sala (OBJ_DECORATION, sem interação): um som de fundo em loop por sala, no centro
	// dela, um arquivo próprio pra cada uma.
	m.objects.insert_last(map_object("ambient_cafeteria", "room.cafeteria", 0, 0, "cafeteria",
		OBJ_DECORATION, SND_AMBIENT_CAFETERIA));
	m.objects.insert_last(map_object("ambient_weapons", "room.weapons", -30, 0, "weapons",
		OBJ_DECORATION, SND_AMBIENT_WEAPONS));
	m.objects.insert_last(map_object("ambient_navigation", "room.navigation", 35, 0, "navigation",
		OBJ_DECORATION, SND_AMBIENT_NAVIGATION));
	m.objects.insert_last(map_object("ambient_admin", "room.admin", 0, -25, "admin",
		OBJ_DECORATION, SND_AMBIENT_ADMIN));
	m.objects.insert_last(map_object("ambient_medbay", "room.medbay", -30, -25, "medbay",
		OBJ_DECORATION, SND_AMBIENT_MEDBAY));
	m.objects.insert_last(map_object("ambient_storage", "room.storage", 0, -50, "storage",
		OBJ_DECORATION, SND_AMBIENT_STORAGE));
	m.objects.insert_last(map_object("ambient_electrical", "room.electrical", -30, -50, "electrical",
		OBJ_DECORATION, SND_AMBIENT_ELECTRICAL));
	m.objects.insert_last(map_object("ambient_reactor", "room.reactor", -30, -75, "reactor",
		OBJ_DECORATION, SND_AMBIENT_REACTOR));

	// Som de passagem: toca nos corredores (mesmo mecanismo de ambiente por sala acima), pra dar uma
	// pista sonora de "você está numa passagem entre salas". Um arquivo só, compartilhado por todos.
	m.objects.insert_last(map_object("passage_cafeteria_weapons", "corridor", -17, 0,
		"corridor_cafeteria_weapons", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_cafeteria_navigation", "corridor", 19.5, 0,
		"corridor_cafeteria_navigation", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_cafeteria_admin", "corridor", 0, -12.5,
		"corridor_cafeteria_admin", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_weapons_medbay", "corridor", -30, -12.5,
		"corridor_weapons_medbay", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_admin_medbay", "corridor", -15, -25,
		"corridor_admin_medbay", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_admin_storage", "corridor", 0, -37.5,
		"corridor_admin_storage", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_medbay_electrical", "corridor", -30, -37.5,
		"corridor_medbay_electrical", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_storage_electrical", "corridor", -16, -50,
		"corridor_storage_electrical", OBJ_DECORATION, SND_PASSAGE));
	m.objects.insert_last(map_object("passage_electrical_reactor", "corridor", -30, -62.5,
		"corridor_electrical_reactor", OBJ_DECORATION, SND_PASSAGE));

	return m;
}
