// server_main.nvgt
// Ponto de entrada do servidor dedicado. Compile e execute este arquivo para hospedar uma
// partida (ex: `nvgt server_main.nvgt` ou compile para um executável com `nvgt -c`).

// Sem isso a pasta lang/ não vai pro pacote compilado - o servidor usa tr() pra montar mensagens
// que manda aos clientes (ex.: aviso de reunião falhou, mínimo de jogadores), e sem o .json ele
// cairia no fallback de mandar a própria chave crua em vez do texto.
#pragma asset lang

#include "network/server.nvgt"

void main() {
	game_server server;
	if (!server.start(DEFAULT_SERVER_PORT)) {
		println("Falha ao iniciar o servidor.");
		return;
	}
	println("Servidor rodando na porta " + DEFAULT_SERVER_PORT + "...");
	server.run();
}
