// net_packet.nvgt
// Envelope de mensagem trocada pela rede. Encapsula um json_object com um campo "type"
// obrigatório e demais campos livres. Serializa para string (formato usado por network.send).

// Um valor de ponto flutuante sem casas decimais (ex: -3.0) é serializado como inteiro no JSON
// ("-3") e reanalisado como int64. Converter int64 -> float (ou -> double) direto dispara
// "Lost precision" na engine (Poco::Var), que compara só a largura declarada dos tipos (63 bits vs
// 53/24) e não o valor real - mesmo -3 sofre esse erro. Extrair como int64 e deixar o AngelScript
// fazer a conversão numérica evita esse caminho. Use isso (não `float(valor_json)` direto) em
// qualquer lugar que ler um campo numérico de um json_object/var vindo da rede.
float safe_var_to_float(var@ v) {
	if (v.is_integer) return float(int64(v));
	return float(v);
}

class net_packet {
	json_object@ obj;

	net_packet(const string&in msg_type) {
		@obj = json_object();
		obj.set("type", msg_type);
	}

	// Construtor interno vazio, usado por packet_from_wire() para popular obj a partir do parser.
	net_packet() {
		@obj = json_object();
	}

	string get_type() const property {
		if (!obj.exists("type")) return "";
		return string(obj["type"]);
	}

	void set_string(const string&in key, const string&in value) { obj.set(key, value); }
	void set_int(const string&in key, int value) { obj.set(key, value); }
	void set_int64(const string&in key, int64 value) { obj.set(key, value); }
	void set_uint64(const string&in key, uint64 value) { obj.set(key, value); }
	void set_float(const string&in key, float value) { obj.set(key, value); }
	void set_bool(const string&in key, bool value) { obj.set(key, value); }
	void set_array(const string&in key, json_array@ value) { obj.set(key, value); }
	void set_object(const string&in key, json_object@ value) { obj.set(key, value); }

	// Substituições de uma mensagem traduzível ({name}, {seconds}...), como um objeto aninhado.
	//
	// Existe porque o servidor manda CHAVE de tradução, não texto pronto (ver S_ERROR em
	// network/protocol.nvgt): quem traduz é o cliente, no idioma DELE, e para isso os valores que
	// entram no texto precisam viajar separados da frase.
	// Tudo vira string: o outro lado só vai substituir isso dentro de um texto, e number de JSON
	// voltaria como "5.0" onde se espera "5".
	void set_params(const string&in key, dictionary@ params) {
		if (@params == null) return;
		json_object@ o = json_object();
		array<string>@ names = params.get_keys();
		for (uint i = 0; i < names.length(); i++) {
			string value;
			params.get(names[i], value);
			o.set(names[i], value);
		}
		obj.set(key, o);
	}

	dictionary@ get_params(const string&in key) const {
		dictionary@ result = dictionary();
		if (!obj.exists(key)) return result;
		json_object@ o = obj.get_object(key);
		if (@o == null) return result;
		array<string>@ names = o.get_keys();
		for (uint i = 0; i < names.length(); i++) result.set(names[i], string(o[names[i]]));
		return result;
	}

	string get_string(const string&in key, const string&in default_value = "") const {
		if (!obj.exists(key)) return default_value;
		return string(obj[key]);
	}

	int get_int(const string&in key, int default_value = 0) const {
		if (!obj.exists(key)) return default_value;
		return int(obj[key]);
	}

	uint64 get_uint64(const string&in key, uint64 default_value = 0) const {
		if (!obj.exists(key)) return default_value;
		return uint64(obj[key]);
	}

	int64 get_int64(const string&in key, int64 default_value = 0) const {
		if (!obj.exists(key)) return default_value;
		return int64(obj[key]);
	}

	float get_float(const string&in key, float default_value = 0.0) const {
		if (!obj.exists(key)) return default_value;
		var@ v = obj[key];
		return safe_var_to_float(v);
	}

	bool get_bool(const string&in key, bool default_value = false) const {
		if (!obj.exists(key)) return default_value;
		return bool(obj[key]);
	}

	json_array@ get_array(const string&in key) const {
		if (!obj.exists(key)) return null;
		return obj.get_array(key);
	}

	json_object@ get_object(const string&in key) const {
		if (!obj.exists(key)) return null;
		return obj.get_object(key);
	}

	string to_wire() const {
		return obj.stringify();
	}
}

// Constrói um net_packet a partir dos bytes recebidos pela rede (network_event.message).
// Retorna null se a mensagem não for um JSON válido com campo "type".
net_packet@ packet_from_wire(const string&in wire) {
	// parse_json LANÇA exceção em JSON malformado, e todo pacote da rede passa por aqui: sem este
	// try, uma única mensagem estranha (truncada, corrompida, de uma versão diferente do jogo)
	// derrubava o cliente inteiro. Pacote que não dá pra ler é pacote descartado, e o jogo segue.
	var@ parsed = null;
	try {
		@parsed = parse_json(wire);
	}
	catch {
		return null;
	}
	if (@parsed == null) return null;

	json_object@ o = cast<json_object@>(parsed);
	if (@o == null) return null;
	if (!o.exists("type")) return null;

	net_packet@ p = net_packet();
	@p.obj = o;
	return p;
}
