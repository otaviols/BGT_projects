// server.nvgt
// Servidor dedicado: aceita conexões, gerencia lobbies e delega a lógica de partida para
// core/game_state.nvgt. Mantém-se sempre de pé; jogadores criam/entram em partidas.

#include "protocol.nvgt"
#include "packet.nvgt"
#include "../config/game_constants.nvgt"
#include "../config/colors.nvgt"
#include "../config/lobby_config.nvgt"
#include "../config/presets.nvgt"
#include "../core/player.nvgt"
#include "../core/game_state.nvgt"
#include "../game/map.nvgt"
#include "../database/user_db.nvgt"
#include "../i18n.nvgt"

uint g_lobby_counter = 0;
// Ids de bot vivem bem longe da faixa que o ENet usa pra peers de verdade (que vão de 0 até o
// max_peers do setup_server), então nunca colidem com o id de um jogador conectado.
uint64 g_bot_peer_counter = 1000000;

void shuffle_int_array(array<int>@ arr) {
	for (int i = int(arr.length()) - 1; i > 0; i--) {
		int j = random(0, i);
		int tmp = arr[i];
		arr[i] = arr[j];
		arr[j] = tmp;
	}
}

void shuffle_player_array(array<game_player@>@ arr) {
	for (int i = int(arr.length()) - 1; i > 0; i--) {
		int j = random(0, i);
		game_player@ tmp = @arr[i];
		@arr[i] = @arr[j];
		@arr[j] = @tmp;
	}
}

void shuffle_object_array(array<map_object@>@ arr) {
	for (int i = int(arr.length()) - 1; i > 0; i--) {
		int j = random(0, i);
		map_object@ tmp = @arr[i];
		@arr[i] = @arr[j];
		@arr[j] = @tmp;
	}
}

class game_server {
	network@ net;
	array<game_player@> connections;
	array<game_state@> lobbies;
	timer@ clock;
	// Reinício anunciado (ver C_ADMIN_DRAIN): enquanto faltar tempo, nenhuma partida nova começa.
	timer@ drain_clock = null;
	float drain_seconds = 0.0;

	bool draining() const {
		return @drain_clock != null && float(drain_clock.elapsed) / 1000.0 < drain_seconds;
	}
	int draining_seconds_left() const {
		if (!draining()) return 0;
		return int(drain_seconds - float(drain_clock.elapsed) / 1000.0);
	}
	uint matches_in_progress() const {
		uint n = 0;
		for (uint i = 0; i < lobbies.length(); i++) if (lobbies[i].state != "waiting" && lobbies[i].state != "ended") n++;
		return n;
	}

	// As duas falhas possíveis aqui têm causas e consertos completamente diferentes - porta ocupada
	// de um lado, permissão de arquivo do outro - e uma mensagem única ("Falha ao iniciar") obriga
	// quem administra o servidor a adivinhar qual das duas foi. Cada uma diz o que aconteceu.
	//
	// O caminho do banco aparece na mensagem de propósito: o NVGT resolve caminho relativo pelo
	// diretório do EXECUTÁVEL, não pelo diretório de trabalho, então o arquivo quase nunca está
	// onde quem procura espera - e sem o caminho impresso não há como saber onde ele tentou.
	bool start(uint16 port) {
		@net = network();
		if (!net.setup_server(port, MAX_PACKET_CHANNELS, MAX_PLAYERS * 30)) {
			println("Não consegui abrir a porta " + port + "/UDP. Ela já está em uso por outro processo?");
			return false;
		}

		@g_user_db = user_database();
		const string db_path = "among_users.db";
		if (!g_user_db.open(db_path)) {
			println("Não consegui abrir o banco de contas (" + db_path + ").");
			println("Ele fica na pasta do executável, não na pasta de onde o servidor foi chamado.");
			println("Verifique se essa pasta existe e se o usuário do servidor pode escrever nela.");
			return false;
		}

		g_i18n.load_language(language_default());
		@clock = timer();
		return true;
	}

	void run() {
		// Processar só 1 evento por volta (jeito antigo) deixava a fila crescer sem parar com
		// vários jogadores reais se movendo ao mesmo tempo. Drenar TUDO sem limite (o que tentamos
		// antes) troca um problema por outro: sob carga alta e contínua, o laço interno pode nunca
		// esvaziar de vez (sempre chega gente nova enquanto processa), e o servidor fica preso ali
		// sem nunca chegar no wait(5) - isso atrasa o tick_lobbies() e pode fazer o ENet achar que
		// um peer sumiu (kickando gente do nada) só por falta de round-trip a tempo. O meio-termo:
		// processa até um limite por volta, garantindo que sempre volta pro wait(5) regularmente.
		const uint MAX_EVENTS_PER_TICK = 200;
		while (true) {
			for (uint processed = 0; processed < MAX_EVENTS_PER_TICK; processed++) {
				const network_event@ ev = net.request(0);
				if (@ev == null || ev.type == event_none) break;
				handle_event(ev);
			}

			float delta = float(clock.elapsed) / 1000.0;
			clock.restart();
			tick_lobbies(delta);
			wait(5);
		}
	}

	// --- Infra de conexão ---

	game_player@ find_connection(uint64 peer_id) const {
		for (uint i = 0; i < connections.length(); i++) {
			if (connections[i].peer_id == peer_id) return connections[i];
		}
		return null;
	}

	game_state@ find_lobby(const string&in lobby_id) const {
		for (uint i = 0; i < lobbies.length(); i++) {
			if (lobbies[i].lobby_id == lobby_id) return lobbies[i];
		}
		return null;
	}

	// O código é comparado sem diferença de maiúsculas e sem espaços nas pontas: ele é ditado de viva
	// voz entre amigos, e ninguém dita maiúscula. Limite de tamanho porque vem da máquina do jogador.
	string normalize_join_code(const string&in raw) const {
		string code = raw.trim_whitespace().lower();
		if (code.length() > MAX_JOIN_CODE_LENGTH) code = code.substr(0, MAX_JOIN_CODE_LENGTH);
		return code;
	}

	game_state@ find_lobby_by_code(const string&in code) const {
		if (code == "") return null;
		for (uint i = 0; i < lobbies.length(); i++) {
			if (lobbies[i].join_code == code) return lobbies[i];
		}
		return null;
	}

	game_state@ find_lobby_of_peer(uint64 peer_id) const {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || conn.lobby_id == "") return null;
		return find_lobby(conn.lobby_id);
	}

	void send_to(uint64 peer_id, net_packet@ pkt, bool reliable = true) {
		if (reliable) net.send_reliable(peer_id, pkt.to_wire(), CHANNEL_RELIABLE);
		else net.send_unreliable(peer_id, pkt.to_wire(), CHANNEL_UNRELIABLE);
	}

	// Bot não tem conexão: mandar pacote pro "peer" dele seria jogar no lixo (ou pior, mirar um peer
	// que não existe), então todo envio em massa pula bot.
	//
	// Quem SAIU no meio da partida também não recebe nada. O registro dele continua na lista (para a
	// contagem de vivos, ver remove_from_lobby) com o MESMO peer_id da conexão, e a conexão a esta
	// altura pode estar em outra sala. Mandar pacote para esse peer_id era mandar a partida antiga
	// para dentro da nova: o jogador recebia o S_GAME_OVER de uma partida que já tinha abandonado e
	// o cliente dele, obediente, saía da partida em que estava - "como se tivesse vencido".
	void broadcast_to_lobby(game_state@ lobby, net_packet@ pkt, uint64 exclude_peer = 0, bool reliable = true) {
		for (uint i = 0; i < lobby.players.length(); i++) {
			if (!reaches_client(lobby.players[i])) continue;
			if (lobby.players[i].peer_id == exclude_peer) continue;
			send_to(lobby.players[i].peer_id, pkt, reliable);
		}
	}

	// Fantasma (morto/expulso) só é visto/ouvido por outros fantasmas - vivos nunca recebem a posição
	// dele (ver on_move).
	void broadcast_to_dead_players(game_state@ lobby, net_packet@ pkt, uint64 exclude_peer = 0) {
		for (uint i = 0; i < lobby.players.length(); i++) {
			if (!reaches_client(lobby.players[i])) continue;
			if (lobby.players[i].peer_id == exclude_peer || lobby.players[i].alive) continue;
			send_to(lobby.players[i].peer_id, pkt, false);
		}
	}

	// Está no saguão: conectado, autenticado e fora de qualquer sala. É a definição inteira - não há
	// um "entrar no saguão" para o cliente pedir, porque isso seria um estado a mais para sair de
	// sincronia com o que o servidor já sabe.
	bool in_hall(game_player@ p) const {
		return @p != null && !p.is_bot && p.authenticated && p.lobby_id == "";
	}

	void broadcast_to_hall(net_packet@ pkt) {
		for (uint i = 0; i < connections.length(); i++) {
			if (!in_hall(connections[i])) continue;
			send_to(connections[i].peer_id, pkt);
		}
	}

	// Quem está no saguão agora, para todos que estão nele. Mandado sempre que essa lista pode ter
	// mudado: login, entrar numa sala, sair de uma, e queda de conexão.
	void send_hall_state() {
		net_packet@ pkt = net_packet(S_HALL_STATE);
		json_array@ names = json_array();
		for (uint i = 0; i < connections.length(); i++) {
			if (!in_hall(connections[i])) continue;
			names.add(connections[i].username);
		}
		pkt.set_array("players", names);
		broadcast_to_hall(pkt);
	}

	void on_hall_chat(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (!in_hall(conn)) return; // quem está numa sala fala na sala, não aqui
		string text = pkt.get_string("text").trim_whitespace();
		if (text == "") return;
		if (text.length() > MAX_CHAT_LENGTH) text = text.substr(0, MAX_CHAT_LENGTH);
		net_packet@ msg = net_packet(S_HALL_CHAT);
		msg.set_string("name", conn.username); // nome é identidade: viaja como está, sem tradução
		msg.set_string("text", text);
		broadcast_to_hall(msg);
	}

	// Há alguém do outro lado deste registro? Bot não tem conexão; quem saiu da partida tem uma
	// conexão que já não pertence a esta sala.
	bool reaches_client(game_player@ p) const {
		return !p.is_bot && !p.left_match;
	}

	void handle_event(const network_event@ ev) {
		if (ev.type == event_connect) {
			game_player@ conn = game_player(ev.peer_id, "");
			connections.insert_last(conn);
		} else if (ev.type == event_disconnect || ev.type == event_disconnect_timeout) {
			on_disconnect(ev.peer_id);
		} else if (ev.type == event_receive) {
			if (ev.channel == CHANNEL_VOICE) { on_voice_frame(ev.peer_id, ev.message); return; }
			net_packet@ pkt = packet_from_wire(ev.message);
			if (@pkt != null) route_packet(ev.peer_id, pkt);
		}
	}

	// Um quadro de voz de `peer_id`. O servidor não decodifica nada - só decide QUEM recebe (a regra
	// está em game_state.can_hear_voice) e repassa os bytes como vieram. É o pacote mais frequente
	// do jogo (50 por segundo por pessoa falando), então nada aqui aloca além do envelope.
	void on_voice_frame(uint64 peer_id, const string&in audio) {
		if (audio.length() == 0 || audio.length() > VOICE_MAX_FRAME_BYTES) return;
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || !lobby.config.voice_chat) return;
		game_player@ talker = lobby.find_player(peer_id);
		// Dentro do duto ninguém é ouvido: a voz posicionada entregaria onde o duto está.
		if (@talker == null || talker.vented) return;
		string wire = voice_wire(peer_id, audio);
		for (uint i = 0; i < lobby.players.length(); i++) {
			game_player@ p = lobby.players[i];
			if (!reaches_client(p) || p.peer_id == peer_id || !p.voice_enabled) continue;
			if (!lobby.can_hear_voice(talker, p)) continue;
			net.send_unreliable(p.peer_id, wire, CHANNEL_VOICE);
		}
	}

	void on_voice_state(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null) return;
		conn.voice_enabled = pkt.get_bool("enabled");
	}

	void on_disconnect(uint64 peer_id) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby != null) remove_from_lobby(lobby, peer_id);

		for (uint i = 0; i < connections.length(); i++) {
			if (connections[i].peer_id == peer_id) { connections.remove_at(i); break; }
		}
		send_hall_state(); // caiu: sai da lista de quem está no saguão
	}

	void remove_from_lobby(game_state@ lobby, uint64 peer_id) {
		// Quem sai (ou cai) larga o posto - senão ele fica preso a alguém que não está mais aqui.
		if (lobby.release_cameras(peer_id)) broadcast_camera_watching(lobby);
		end_visible_task(lobby, peer_id);
		string left_name = "";
		game_player@ p = lobby.find_player(peer_id);
		if (@p != null) left_name = p.username;

		// Durante uma partida em andamento, remover o jogador do array quebraria a contagem de
		// vivos (alive_crewmate_count()/alive_impostor_count()) usada pra decidir quem venceu -
		// um crewmate saindo faria parecer que os impostores têm maioria na hora, por exemplo,
		// terminando o jogo do nada pros que ficaram.
		//
		// A saída é deixar na partida um REGISTRO do jogador (morto, marcado como "caiu") e devolver
		// o objeto de CONEXÃO limpo pra ele. Os dois não podem ser a mesma coisa: quem sai vai entrar
		// noutra lobby ainda com essa partida rolando, e se a partida antiga continuasse segurando o
		// objeto dele, o fim daquela partida ia mexer no jogador no meio da partida NOVA - zerando
		// papel e tasks, e tirando ele da lobby em que ele está agora.
		bool match_active = lobby.state != "waiting" && lobby.state != "ended";
		if (match_active) {
			if (@p != null) {
				game_player@ record = game_player(p.peer_id, p.username);
				record.color = p.color;
				record.set_role(p.role_id);
				record.tasks = p.tasks;
				record.x = p.x;
				record.y = p.y;
				record.alive = false;
				record.left_match = true; // as tasks dele param de contar já (ver counts_for_task_win)
				for (uint i = 0; i < lobby.players.length(); i++) {
					if (lobby.players[i].peer_id == peer_id) { @lobby.players[i] = record; break; }
				}
				p.reset_match_state(); // a conexão sai daqui sem nenhuma herança da partida
			}
		} else {
			for (uint i = 0; i < lobby.players.length(); i++) {
				if (lobby.players[i].peer_id == peer_id) { lobby.players.remove_at(i); break; }
			}
			// Sobrar só bot não é "lobby com gente": eles não conseguem iniciar partida nem sair
			// sozinhos, então a lobby seria um fantasma na lista de partidas pra sempre.
			if (lobby.human_count() == 0) {
				for (uint i = 0; i < lobbies.length(); i++) {
					if (lobbies[i].lobby_id == lobby.lobby_id) { lobbies.remove_at(i); break; }
				}
				return;
			}
			if (lobby.host_peer_id == peer_id) {
				for (uint i = 0; i < lobby.players.length(); i++) {
					if (lobby.players[i].is_bot) continue; // bot não pode ser anfitrião: não aperta Enter
					lobby.host_peer_id = lobby.players[i].peer_id;
					break;
				}
			}
		}

		// Inclui nome e o anfitrião atual (pode ter mudado nesta mesma saída) pra que o cliente
		// consiga anunciar quem saiu e quem é o novo anfitrião sem precisar de outro pacote.
		net_packet@ left = net_packet(S_PLAYER_LEFT);
		left.set_uint64("peer_id", peer_id);
		left.set_string("name", left_name);
		left.set_uint64("host_peer_id", lobby.host_peer_id);
		broadcast_to_lobby(lobby, left);
		// Na sala de espera, um retrato novo: a lista de quem está na sala (tecla P) vem do último
		// S_LOBBY_STATE, e sem este envio quem saiu continuava listado como se estivesse lá.
		if (!match_active) send_lobby_state(lobby, 0);
	}

	// --- Roteamento ---

	void route_packet(uint64 peer_id, net_packet@ pkt) {
		string t = pkt.type;
		if (t == C_LOGIN) on_login(peer_id, pkt);
		else if (t == C_LOGOUT) on_logout(peer_id, pkt);
		else if (t == C_REGISTER) on_register(peer_id, pkt);
		else if (t == C_LIST_LOBBIES) on_list_lobbies(peer_id, pkt);
		else if (t == C_CREATE_LOBBY) on_create_lobby(peer_id, pkt);
		else if (t == C_JOIN_LOBBY) on_join_lobby(peer_id, pkt);
		else if (t == C_LEAVE_LOBBY) on_leave_lobby(peer_id, pkt);
		else if (t == C_UPDATE_LOBBY_CONFIG) on_update_lobby_config(peer_id, pkt);
		else if (t == C_START_GAME) on_start_game(peer_id, pkt);
		else if (t == C_ADD_BOT) on_add_bot(peer_id, pkt);
		else if (t == C_REMOVE_BOT) on_remove_bot(peer_id, pkt);
		else if (t == C_MOVE) on_move(peer_id, pkt);
		else if (t == C_START_TASK) on_start_task(peer_id, pkt);
		else if (t == C_TASK_INPUT) on_task_input(peer_id, pkt);
		else if (t == C_KILL) on_kill(peer_id, pkt);
		else if (t == C_REPORT_BODY) on_report_body(peer_id, pkt);
		else if (t == C_CALL_MEETING) on_call_meeting(peer_id, pkt);
		else if (t == C_CAST_VOTE) on_cast_vote(peer_id, pkt);
		else if (t == C_USE_VENT) on_use_vent(peer_id, pkt);
		else if (t == C_VENT_TRAVEL) on_vent_travel(peer_id, pkt);
		else if (t == C_RADAR_SCAN) on_radar_scan(peer_id, pkt);
		else if (t == C_RADAR_TRACK) on_radar_track(peer_id, pkt);
		else if (t == C_TRIGGER_SABOTAGE) on_trigger_sabotage(peer_id, pkt);
		else if (t == C_CLOSE_DOORS) on_close_doors(peer_id, pkt);
		else if (t == C_INTERACT) on_interact(peer_id, pkt);
		else if (t == C_PING) on_ping(peer_id, pkt);
		else if (t == C_CHAT_MESSAGE) on_chat_message(peer_id, pkt);
		else if (t == C_VOICE_STATE) on_voice_state(peer_id, pkt);
		else if (t == C_HALL_CHAT) on_hall_chat(peer_id, pkt);
		else if (t == C_SEND_FEEDBACK) on_send_feedback(peer_id, pkt);
		else if (t == C_FEEDBACK_REPLIES_GET) on_feedback_replies_get(peer_id, pkt);
		else if (t == C_FEEDBACK_REPLY_READ) on_feedback_reply_read(peer_id, pkt);
		else if (t == C_ADMIN_REPLY) on_admin_reply(peer_id, pkt);
		else if (t == C_SEND_TRANSLATION) on_send_translation(peer_id, pkt);
		else if (t == C_ADMIN_LIST_TRANSLATIONS) on_admin_list_translations(peer_id, pkt);
		else if (t == C_ADMIN_DELETE_TRANSLATION) on_admin_delete_translation(peer_id, pkt);
		else if (t == C_ADMIN_DRAIN) on_admin_drain(peer_id, pkt);
		else if (t == C_ADMIN_STATUS) on_admin_status(peer_id, pkt);
		else if (t == C_CAMERA_ENTER) on_camera_enter(peer_id, pkt);
		else if (t == C_CAMERA_LEAVE) on_camera_leave(peer_id, pkt);
		else if (t == C_CAMERA_SWITCH) on_camera_switch(peer_id, pkt);
		else if (t == C_CAMERA_SCAN) on_camera_scan(peer_id, pkt);
		else if (t == C_USE_ABILITY) on_use_ability(peer_id, pkt);
	}

	// --- Habilidades dos papéis ---

	// A porta única das habilidades. O que é comum a todas fica aqui - partida em andamento, o papel
	// TEM esta habilidade, está vivo (ou ela vale morto), fora de recarga - e o que cada uma faz
	// fica em run_ability, um caso por id. A recarga só começa se a habilidade DEU: uma tentativa
	// recusada (alvo fora do alcance, nada para consertar) não pode custar o cooldown inteiro.
	void on_use_ability(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		game_player@ p = lobby.find_player(peer_id);
		if (@p == null) return;
		string ability = pkt.get_string("ability");
		role_traits@ role = p.role();
		if (ability == "" || role.ability_id != ability) { send_ability_result(peer_id, ability, false, "role.ability_not_yours"); return; }
		// Capacidade, que conhece os três casos (só vivo, vivo e morto, só morto). O anjo da guarda
		// VIVO cai aqui, e o motivo é próprio: "seu papel só age depois de morrer" - dizer a ele
		// "fantasma não interage" seria o contrário do que acontece.
		if (!player_abilities(role, p.alive).has_ability()) {
			send_ability_result(peer_id, ability, false, p.alive ? "role.ability_only_dead" : "game.ghost_cannot_interact");
			return;
		}
		if (p.ability_cooldown_remaining > 0.0) {
			dictionary@ params = dictionary();
			params.set("seconds", "" + int(p.ability_cooldown_remaining + 0.5));
			send_ability_result(peer_id, ability, false, "role.ability_cooldown", params);
			return;
		}
		// A mensagem serve aos DOIS casos: o motivo da recusa, ou o que o jogador precisa ouvir
		// quando dá certo (o anjo ouve QUEM ele protegeu - é o único retorno que ele tem).
		string message_key = "";
		dictionary@ message_params = dictionary();
		if (!run_ability(lobby, p, ability, pkt, message_key, message_params)) {
			send_ability_result(peer_id, ability, false, message_key != "" ? message_key : "role.ability_unavailable", message_params);
			return;
		}
		p.ability_cooldown_remaining = role.ability_cooldown_seconds;
		send_ability_result(peer_id, ability, true, message_key, message_params, role.ability_cooldown_seconds);
	}

	// O que cada habilidade FAZ. Devolve false com message_key preenchida quando não dá, e pode
	// preenchê-la no sucesso com o que o jogador deve ouvir. Um caso por id; o papel novo
	// acrescenta o dele aqui e em role_traits, e nada mais.
	bool run_ability(game_state@ lobby, game_player@ p, const string&in ability, net_packet@ pkt,
			string&out message_key, dictionary@ message_params) {
		if (ability == ABILITY_SHIELD) {
			string protegido;
			if (!lobby.try_shield_player(p.peer_id, pkt.get_uint64("target_peer_id"), protegido, message_key)) return false;
			// NADA é transmitido: nem para o protegido, nem para a partida. O escudo só aparece
			// como um ataque que não acontece, e quem atacou não recebe explicação nenhuma.
			message_params.set("name", protegido);
			message_key = "role.shield_cast";
			return true;
		}
		if (ability == ABILITY_REMOTE_FIX) {
			net_packet@ fixed;
			if (!lobby.try_remote_fix_sabotage(p.peer_id, fixed, message_key)) return false;
			// O MESMO pacote do conserto normal, para a partida inteira: o resto do jogo (alarme,
			// marcadores, painel aberto de quem estava consertando) já sabe tratá-lo, e nada precisa
			// aprender que existe um segundo jeito de a sabotagem acabar.
			//
			// Ninguém é avisado de QUEM consertou, e isso é deliberado: o sinal é a sabotagem
			// terminar sem ninguém ter chegado ao painel. Quem estava correndo para lá ouve isso e
			// tira as próprias conclusões - inclusive a errada, que é metade da graça.
			broadcast_to_lobby(lobby, fixed);
			return true;
		}
		message_key = "role.ability_unavailable";
		return false;
	}

	void send_ability_result(uint64 peer_id, const string&in ability, bool ok, const string&in message_key,
			dictionary@ params = null, float cooldown_seconds = 0.0) {
		net_packet@ r = net_packet(S_ABILITY_RESULT);
		r.set_string("ability", ability);
		r.set_bool("ok", ok);
		r.set_string(MSG_KEY_FIELD, message_key);
		if (@params != null) r.set_params(MSG_PARAMS_FIELD, params);
		r.set_float("cooldown_seconds", cooldown_seconds);
		send_to(peer_id, r);
	}

	// --- Autenticação ---

	void on_login(uint64 peer_id, net_packet@ pkt) {
		string username = pkt.get_string("username");
		string password = pkt.get_string("password");
		string token = pkt.get_string("token");
		net_packet@ result = net_packet(S_LOGIN_RESULT);

		// O corte por protocolo vem ANTES de conferir a senha: a resposta é a mesma S_LOGIN_RESULT que
		// todo cliente já entende, só que com o motivo certo. Recusar aqui, e não na conexão, é o que
		// deixa o cliente ouvir o porquê - na conexão ele só veria a rede cair.
		int protocol = pkt.get_int("protocol", 0);
		if (protocol < MIN_PROTOCOL_VERSION) {
			result.set_bool("ok", false);
			result.set_string("message", "login.update_required");
			send_to(peer_id, result);
			println("[login] protocolo " + protocol + " recusado (minimo " + MIN_PROTOCOL_VERSION + ")");
			return;
		}

		bool ok;
		if (token != "") {
			username = g_user_db.session_user(token);
			ok = username != "";
		} else {
			ok = g_user_db.verify_login(username, password);
		}
		if (ok) {
			game_player@ conn = find_connection(peer_id);
			if (@conn != null) {
				conn.username = username;
				conn.authenticated = true;
				conn.protocol_version = protocol;
			}
			result.set_bool("ok", true);
			result.set_string("message", "login.success");
			result.set_string("username", username);
			// Pediu para lembrar: sai um token novo; o cliente guarda o token, nunca a senha.
			if (token == "" && pkt.get_bool("remember")) result.set_string("session_token", g_user_db.create_session(username));
			// O cliente não tem como descobrir sozinho com que id o servidor o identifica (o id que
			// o ENet dele devolve é só um handle local) - sem isso ele compara maçã com laranja em
			// todo peer_id que chega e às vezes "acerta" o de outro jogador (ver game_client).
			result.set_uint64("peer_id", peer_id);
		} else {
			result.set_bool("ok", false);
			result.set_string("message", "login.invalid_credentials");
		}
		send_to(peer_id, result);
		if (ok) {
			// Antes do retrato do saguão: a sessão velha tem que sair da lista de quem está online,
			// senão o mesmo nome apareceria duas vezes nela.
			drop_other_sessions(peer_id, username);
			// Depois de responder, e não antes: assim quem acabou de entrar já se vê na lista.
			send_hall_state();
		}
	}

	// Uma conta, uma sessão: entrar de novo DERRUBA a anterior.
	//
	// A alternativa - recusar a entrada nova - parece mais educada e é pior na prática: uma conexão
	// que caiu feio (queda de luz, cabo arrancado, jogo fechado no braço) continua de pé para o
	// servidor até o ENet desistir dela, e nesse meio-tempo a pessoa não conseguiria voltar ao
	// próprio jogo. Derrubando, reconectar simplesmente funciona - e quem empresta a conta descobre
	// na hora que duas pessoas não cabem nela.
	//
	// `softly` porque o ENet entrega o que está na fila antes de desligar: assim o aviso do porquê
	// chega a quem foi derrubado, em vez de ele só ver a conexão cair sem explicação.
	void drop_other_sessions(uint64 keep_peer_id, const string&in username) {
		for (int i = int(connections.length()) - 1; i >= 0; i--) {
			game_player@ other = connections[i];
			if (other.peer_id == keep_peer_id || !other.authenticated || other.username != username) continue;
			send_error(other.peer_id, "login.session_replaced");
			net.disconnect_peer_softly(other.peer_id);
			// A limpeza é feita AQUI, e não deixada para o evento de desconexão: o peer já saiu do
			// mapa da rede, e sem isto a sessão velha continuaria pendurada na sala (contando como
			// jogador, recebendo pacotes que ninguém lê) até o ENet avisar.
			on_disconnect(other.peer_id);
		}
	}

	void on_logout(uint64 peer_id, net_packet@ pkt) {
		g_user_db.delete_session(pkt.get_string("token"));
	}

	void on_register(uint64 peer_id, net_packet@ pkt) {
		string username = pkt.get_string("username");
		string password = pkt.get_string("password");
		string err;
		bool ok = g_user_db.create_user(username, password, err);

		net_packet@ result = net_packet(S_REGISTER_RESULT);
		result.set_bool("ok", ok);
		result.set_string("message", ok ? "login.register_success" : ("login." + err));
		send_to(peer_id, result);
	}

	// --- Lobbies ---

	void on_list_lobbies(uint64 peer_id, net_packet@ pkt) {
		json_array@ list = json_array();
		for (uint i = 0; i < lobbies.length(); i++) {
			game_state@ lobby = lobbies[i];
			if (lobby.state != "waiting") continue;
			// Partida privada não aparece: o sentido dela é ser encontrada só por quem tem o código.
			// Listá-la "trancada" só convidaria tentativa de adivinhação.
			if (lobby.is_private()) continue;
			json_object@ entry = json_object();
			entry.set("id", lobby.lobby_id);
			entry.set("name", lobby.lobby_name);
			entry.set("current", int(lobby.players.length()));
			entry.set("max", int(lobby.config.max_players));
			// A configuração vai junto na LISTA, e não só depois de entrar: escolher uma sala sem
			// saber quantos impostores tem e se a sabotagem está ligada é escolher no escuro, e o
			// preço de descobrir é entrar, olhar e sair.
			entry.set("config", lobby.config.to_json(lobby.players.length()));
			list.add(entry);
		}
		net_packet@ result = net_packet(S_LOBBY_LIST);
		result.set_array("lobbies", list);
		send_to(peer_id, result);
	}

	void on_create_lobby(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || !conn.authenticated) return;
		leave_current_lobby(peer_id); // ninguém entra numa lobby estando em outra

		game_state@ lobby = game_state();
		lobby.lobby_id = "lobby_" + (++g_lobby_counter);
		lobby.lobby_name = pkt.get_string("lobby_name", "Partida de " + conn.username);
		@lobby.config = get_preset(pkt.get_string("preset", "classic"));
		// Os ajustes do anfitrião entram por cima do preset; o que ele não mexeu chega como -1 e é
		// ignorado. Clientes antigos, que só mandavam o cooldown, continuam funcionando: os campos
		// que eles não enviam viram -1 aqui pelo valor padrão da leitura.
		lobby_overrides overrides;
		overrides.read_from_packet(pkt);
		overrides.apply_to(lobby.config);
		// validate() DEPOIS de aplicar, e não antes: estes números vieram da máquina do jogador, e é
		// aqui que um "1000 jogadores" ou um cooldown de meio segundo voltam para dentro dos limites.
		lobby.config.validate();
		lobby.join_code = normalize_join_code(pkt.get_string("join_code", ""));
		lobby.host_peer_id = peer_id;
		@lobby.map = build_the_hub_map();

		conn.lobby_id = lobby.lobby_id;
		lobby.players.insert_last(conn);
		lobbies.insert_last(lobby);

		send_lobby_state(lobby, peer_id);
		send_hall_state(); // quem criou a sala saiu do saguão (entrar numa sala não é o único caminho)
	}

	void on_join_lobby(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || !conn.authenticated) return;

		string lobby_id = pkt.get_string("lobby_id");
		string join_code = normalize_join_code(pkt.get_string("join_code", ""));
		net_packet@ result = net_packet(S_JOIN_RESULT);

		// Sem id, a porta é o código: a partida privada não está na lista, então o cliente não tem
		// como saber o id dela. Com id, o código é exigido se a partida for privada - senão bastaria
		// saber o id (que já circulou na lista um dia) para pular a tranca.
		game_state@ lobby;
		string fail_key = "lobby.join_failed";
		if (lobby_id == "") {
			@lobby = find_lobby_by_code(join_code);
			if (@lobby == null) fail_key = "lobby.code_not_found";
		} else {
			@lobby = find_lobby(lobby_id);
			if (@lobby != null && lobby.is_private() && lobby.join_code != join_code) {
				@lobby = null;
				fail_key = "lobby.code_not_found";
			}
		}
		if (@lobby != null && lobby.state != "waiting") { @lobby = null; fail_key = "lobby.in_progress"; }
		if (@lobby != null && lobby.players.length() >= lobby.config.max_players) { @lobby = null; fail_key = "lobby.full"; }
		// Sala com papéis especiais só recebe cliente que sabe o que eles são. Recusar na porta, e
		// não no início da partida: quem entrasse ficaria esperando uma partida que nunca ia começar
		// por causa dele, sem saber. (O cliente velho ouve a chave crua, e é o melhor que dá: ele
		// não tem o texto. O updater já avisou antes.)
		if (@lobby != null && lobby.config.uses_roles() && conn.protocol_version < ROLES_MIN_PROTOCOL) { @lobby = null; fail_key = "lobby.needs_update"; }

		if (@lobby == null) {
			result.set_bool("ok", false);
			result.set_string("message", "lobby_unavailable");
			// O motivo vai como chave: "não deu" não diz ao jogador se errou o código, se a sala
			// encheu ou se a partida já começou - e cada um desses pede uma reação diferente dele.
			result.set_string(MSG_KEY_FIELD, fail_key);
			send_to(peer_id, result);
			return;
		}

		leave_current_lobby(peer_id); // ninguém entra numa lobby estando em outra
		conn.lobby_id = lobby.lobby_id;
		lobby.players.insert_last(conn);

		result.set_bool("ok", true);
		send_to(peer_id, result);

		send_hall_state(); // entrou numa sala: sai da lista do saguão

		net_packet@ joined = net_packet(S_PLAYER_JOINED);
		joined.set_uint64("peer_id", peer_id);
		joined.set_string("name", conn.username);
		broadcast_to_lobby(lobby, joined, peer_id);

		send_lobby_state(lobby, 0);
	}

	// O anfitrião muda as regras da sala aberta. Os ajustes entram POR CIMA da configuração atual, e
	// não de um preset: o que ele deixou em branco tem que continuar valendo como está. E a validação
	// roda de novo, pelo mesmo motivo de sempre - os números vieram da máquina do jogador.
	void on_update_lobby_config(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.host_peer_id != peer_id) { send_error(peer_id, "lobby.edit_host_only"); return; }
		if (lobby.state != "waiting") { send_error(peer_id, "lobby.edit_only_in_waiting"); return; }

		lobby_overrides overrides;
		overrides.read_from_packet(pkt);
		overrides.apply_to(lobby.config);
		lobby.config.validate();

		// Todo mundo recebe o retrato novo E um aviso falado: quem já ouviu as regras uma vez não
		// vai apertar C de novo por conta própria, e uma partida com regras que mudaram em silêncio é
		// uma partida em que alguém joga com as regras erradas.
		send_lobby_state(lobby, 0);
		broadcast_to_lobby(lobby, build_message(S_ERROR, "lobby.config_changed"));
	}

	void on_leave_lobby(uint64 peer_id, net_packet@ pkt) {
		leave_current_lobby(peer_id);
	}

	// Tira o jogador da lobby em que ele estiver, se estiver em alguma. Usado ao sair de propósito e
	// como garantia antes de entrar em outra: estar em duas lobbies ao mesmo tempo mandaria pacote
	// pro lugar errado e contaria o jogador duas vezes.
	void leave_current_lobby(uint64 peer_id) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		remove_from_lobby(lobby, peer_id);
		game_player@ conn = find_connection(peer_id);
		if (@conn != null) conn.lobby_id = "";
		send_hall_state(); // voltou ao saguão
	}

	// --- Bots (jogadores controlados pelo servidor) ---
	// Só o anfitrião mexe nisso, e só na sala de espera: adicionar/tirar jogador no meio da partida
	// bagunçaria a contagem de vivos que decide quem venceu.
	void on_add_bot(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.host_peer_id != peer_id) return;
		if (lobby.state != "waiting") { send_error(peer_id, "lobby.bot_only_in_waiting"); return; }
		if (lobby.players.length() >= lobby.config.max_players) { send_error(peer_id, "lobby.bot_lobby_full"); return; }
		if (lobby.bot_count() >= MAX_BOTS_PER_LOBBY) { send_error(peer_id, "lobby.bot_limit_reached"); return; }

		game_player@ bot = game_player(++g_bot_peer_counter, "");
		// Nome de bot NÃO é traduzido, e isso é de propósito: é um nome próprio, como o de qualquer
		// jogador. Ele vai para o elenco, para o chat e para a tela de votação, onde é comparado com
		// o que as pessoas falam entre si - se cada cliente o traduzisse para um idioma diferente,
		// duas pessoas na mesma partida estariam acusando "nomes" diferentes pelo mesmo bot.
		bot.username = "Bot " + (lobby.bot_count() + 1);
		bot.is_bot = true;
		bot.authenticated = true;
		bot.lobby_id = lobby.lobby_id;
		lobby.players.insert_last(bot);

		net_packet@ joined = net_packet(S_PLAYER_JOINED);
		joined.set_uint64("peer_id", bot.peer_id);
		joined.set_string("name", bot.username);
		broadcast_to_lobby(lobby, joined);
		send_lobby_state(lobby, 0);
	}

	void on_remove_bot(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.host_peer_id != peer_id) return;
		if (lobby.state != "waiting") { send_error(peer_id, "lobby.bot_only_in_waiting"); return; }

		// Tira o último adicionado (é o que a tecla sugere: adiciona com B, desfaz com Shift+B).
		for (int i = int(lobby.players.length()) - 1; i >= 0; i--) {
			if (!lobby.players[i].is_bot) continue;
			string bot_name = lobby.players[i].username;
			uint64 bot_peer = lobby.players[i].peer_id;
			lobby.players.remove_at(i);

			net_packet@ left = net_packet(S_PLAYER_LEFT);
			left.set_uint64("peer_id", bot_peer);
			left.set_string("name", bot_name);
			left.set_uint64("host_peer_id", lobby.host_peer_id);
			broadcast_to_lobby(lobby, left);
			send_lobby_state(lobby, 0);
			return;
		}
		send_error(peer_id, "lobby.bot_none_to_remove");
	}

	// Manda um aviso para o jogador como CHAVE de tradução, nunca como frase pronta: os jogadores de
	// uma mesma partida podem estar em idiomas diferentes, e quem sabe o idioma de cada um é o
	// cliente dele. Ver o bloco de mensagens traduzíveis em network/protocol.nvgt.
	void send_error(uint64 peer_id, const string&in message_key, dictionary@ params = null) {
		send_to(peer_id, build_message(S_ERROR, message_key, params));
	}

	// Monta um pacote de mensagem traduzível. Além da chave e das substituições, inclui o texto já
	// traduzido no idioma do servidor - isso é só para os clientes até a 0.11.1, que não conhecem a
	// chave e mostrariam um aviso em branco sem esse campo.
	net_packet@ build_message(const string&in packet_type, const string&in message_key, dictionary@ params = null) {
		net_packet@ pkt = net_packet(packet_type);
		pkt.set_string(MSG_KEY_FIELD, message_key);
		if (@params != null) pkt.set_params(MSG_PARAMS_FIELD, params);
		pkt.set_string(MSG_LEGACY_TEXT_FIELD, @params != null ? tr(message_key, params) : tr(message_key));
		return pkt;
	}

	// Envia o estado da lobby. Se target_peer for 0, transmite para todos os membros.
	void send_lobby_state(game_state@ lobby, uint64 target_peer) {
		net_packet@ pkt = net_packet(S_LOBBY_STATE);
		pkt.set_string("lobby_id", lobby.lobby_id);
		pkt.set_string("lobby_name", lobby.lobby_name);
		pkt.set_int("max_players", int(lobby.config.max_players));
		pkt.set_uint64("host_peer_id", lobby.host_peer_id);
		pkt.set_object("config", lobby.config.to_json(lobby.players.length()));
		// O código vai para quem JÁ está dentro: é como o anfitrião o relembra para ditar aos amigos,
		// e como quem entrou sabe que está numa sala fechada. Quem está fora nunca vê este pacote.
		pkt.set_string("join_code", lobby.join_code);

		json_array@ players_json = json_array();
		for (uint i = 0; i < lobby.players.length(); i++) {
			json_object@ pj = json_object();
			pj.set("peer_id", lobby.players[i].peer_id);
			pj.set("name", lobby.players[i].username);
			// Quem é bot vai marcado: numa sala com bots, saber quantos dos "jogadores" são de
			// verdade muda a leitura de quanta gente falta para começar.
			pj.set("is_bot", lobby.players[i].is_bot);
			players_json.add(pj);
		}
		pkt.set_array("players", players_json);

		if (target_peer != 0) send_to(target_peer, pkt);
		else broadcast_to_lobby(lobby, pkt);
	}

	// --- Início de partida ---

	void on_start_game(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.host_peer_id != peer_id) return;
		// Reinício a caminho: uma partida que começasse agora seria derrubada no meio. Melhor não
		// começar - e dizer por quê, com o tempo que falta.
		if (draining()) {
			dictionary@ p = dictionary();
			p.set("minutes", "" + ((draining_seconds_left() + 59) / 60));
			send_error(peer_id, "server.restart_soon_no_start", p);
			return;
		}
		if (lobby.players.length() < MIN_PLAYERS) {
			dictionary@ p = dictionary();
			p.set("min", "" + MIN_PLAYERS);
			send_error(peer_id, "lobby.min_players_warning", p);
			return;
		}
		// Papéis ligados DEPOIS de alguém velho já estar dentro (a porta só barra quem chega): a partida
		// não começa, e o anfitrião ouve QUEM precisa atualizar - senão ele desligaria os papéis sem
		// saber por quê, ou expulsaria a pessoa errada.
		if (lobby.config.uses_roles()) {
			array<string> outdated;
			for (uint i = 0; i < lobby.players.length(); i++) {
				game_player@ p = lobby.players[i];
				if (!p.is_bot && p.protocol_version < ROLES_MIN_PROTOCOL) outdated.insert_last(p.username);
			}
			if (outdated.length() > 0) {
				dictionary@ p = dictionary();
				p.set("names", join(outdated, ", "));
				send_error(peer_id, "lobby.roles_need_update", p);
				return;
			}
		}

		// Sorteio dos papéis, bot e gente no mesmo bolo: a IA de impostor caça, mata quando ninguém
		// está vendo e sabota (ver game_state.update_bot_impostor), então um bot impostor é uma
		// partida de verdade - e do outro lado, um humano sozinho contra bots tem quem o cace.
		array<game_player@> shuffled = lobby.players;
		shuffle_player_array(shuffled);

		int impostor_count = lobby.config.resolved_impostor_count(shuffled.length());
		array<int>@ color_ids = all_color_ids();
		shuffle_int_array(color_ids);

		// Tasks comuns desta partida: sorteadas UMA vez, aqui, e entregues iguais a todo tripulante
		// (ver COMMON_TASK_TYPES). O resto do sorteio, mais abaixo, é individual e usa só as tasks
		// não-comuns - senão uma task comum poderia sair duas vezes pra mesma pessoa.
		array<map_object@> common_spots;
		array<map_object@> personal_spots;
		array<map_object@>@ all_spots = lobby.map.objects_by_type(OBJ_TASK_SPOT);
		array<string> chosen_common_types;
		for (uint i = 0; i < COMMON_TASK_TYPES.length(); i++) {
			if (random_range(0.0, 1.0) <= COMMON_TASK_CHANCE) chosen_common_types.insert_last(COMMON_TASK_TYPES[i]);
		}
		for (uint i = 0; i < all_spots.length(); i++) {
			map_object@ spot = all_spots[i];
			bool is_common_type = COMMON_TASK_TYPES.find(spot.task_type) != -1;
			if (!is_common_type) {
				personal_spots.insert_last(spot);
				continue;
			}
			// Task comum que não foi sorteada nesta partida não existe pra ninguém.
			if (chosen_common_types.find(spot.task_type) != -1) common_spots.insert_last(spot);
		}

		// Papéis especiais, sorteados DENTRO de cada time: os N primeiros do embaralhamento são o time
		// impostor, e cada papel de impostor sai entre eles; os de tripulação, entre o resto. Como a
		// lista já está embaralhada, "os primeiros de cada time" é um sorteio. A configuração pode
		// pedir mais papéis do que há gente no time (a sala foi validada pela LOTAÇÃO, não por quem
		// veio): quem não couber não sai. A regra inteira - chance por vaga, bot fora, quem não cabe
		// - mora em draw_special_roles (game/roles/role_traits.nvgt), para a sonda poder chamar a
		// MESMA função em vez de reimplementá-la e passar com o código quebrado.
		//
		// O S_GAME_START anuncia o que a sala CONFIGUROU, nunca o que saiu daqui: dizer o resultado
		// entregaria de graça a dedução que a chance existe para criar.
		array<bool> bot_flags;
		for (uint i = 0; i < shuffled.length(); i++) bot_flags.insert_last(shuffled[i].is_bot);
		array<string> role_of = draw_special_roles(shuffled.length(), uint(impostor_count), bot_flags,
			lobby.config.role_counts, lobby.config.role_chances);

		for (uint i = 0; i < shuffled.length(); i++) {
			game_player@ p = shuffled[i];
			string team = int(i) < impostor_count ? TEAM_IMPOSTOR : TEAM_CREW;
			p.set_role(role_of[i] != "" ? role_of[i] : base_role_of_team(team));
			p.color = color_ids[i % color_ids.length()];
			p.alive = true;
			p.left_match = false;
			p.vented = false;
			p.current_vent_id = "";
			p.kill_cooldown_remaining = lobby.config.kill_cooldown_seconds;
			// A habilidade começa PRONTA, como no original. Não é o cooldown do kill: aquele existe
			// para o primeiro corpo não aparecer no segundo um da partida.
			p.ability_cooldown_remaining = 0.0;
			p.meetings_called = 0;
			p.radar_index = -1;
			p.last_move_time = 0.0;
			p.tasks.resize(0);
			p.x = float(random(-30, 30)) / 10.0;
			p.y = float(random(-30, 30)) / 10.0;

			// Quem tem tarefas é quem as tem CONTANDO para o time (ver role_traits): o engenheiro faz
			// tarefas como qualquer tripulante, e o impostor só finge fazê-las.
			if (p.role().tasks_count_for_crew) {
				// Primeiro as comuns, IGUAIS pra todo mundo (mesmo ponto do mapa, inclusive).
				for (uint c = 0; c < common_spots.length(); c++) {
					player_task pt;
					pt.object_id = common_spots[c].id;
					pt.task_type = common_spots[c].task_type;
					p.tasks.insert_last(pt);
				}
				// Depois as individuais, sorteadas POR CATEGORIA: primeiro as longas que a sala pediu,
				// depois curtas até fechar o total. Sortear tudo de um monte só devolvia partidas em
				// que um jogador andava a nave inteira e outro resolvia tudo num canto - e a diferença
				// entre esses dois jogadores, num jogo em que andar faz barulho, é enorme.
				array<map_object@> long_pool;
				array<map_object@> short_pool;
				for (uint s = 0; s < personal_spots.length(); s++) {
					// Ponto do MEIO de uma corrente não entra no sorteio: ele é a continuação de uma
					// tarefa, não uma tarefa (ver is_chain_start em game/map.nvgt).
					if (lobby.map.object_in_chain(personal_spots[s].id) && !lobby.map.is_chain_start(personal_spots[s].id)) continue;
					if (task_is_long(personal_spots[s].task_type)) long_pool.insert_last(personal_spots[s]);
					else short_pool.insert_last(personal_spots[s]);
				}
				shuffle_object_array(long_pool);
				shuffle_object_array(short_pool);

				uint total = lobby.config.task_count_per_crewmate;
				total = total > p.tasks.length() ? total - p.tasks.length() : 0;
				uint want_long = lobby.config.long_task_count;
				if (want_long > total) want_long = total;
				if (want_long > long_pool.length()) want_long = long_pool.length();
				// O que faltar de longa vira curta, e vice-versa: o mapa tem um número fixo de pontos
				// de cada tipo, e é melhor entregar o total pedido do que respeitar a proporção à risca.
				uint want_short = total - want_long;
				if (want_short > short_pool.length()) {
					uint sobra = want_short - short_pool.length();
					want_short = short_pool.length();
					if (want_long + sobra <= long_pool.length()) want_long += sobra;
				}
				for (uint t = 0; t < want_long; t++) {
					player_task pt;
					pt.object_id = long_pool[t].id;
					pt.task_type = long_pool[t].task_type;
					pt.phase_count = lobby.map.phase_count_of(pt.task_type);
					p.tasks.insert_last(pt);
				}
				for (uint t = 0; t < want_short; t++) {
					player_task pt;
					pt.object_id = short_pool[t].id;
					pt.task_type = short_pool[t].task_type;
					pt.phase_count = lobby.map.phase_count_of(pt.task_type);
					p.tasks.insert_last(pt);
				}
			}
		}

		lobby.bodies.resize(0);
		lobby.votes.resize(0);
		lobby.active_sabotage = "";
		lobby.last_sabotage_id = "";
		lobby.meeting_cooldown_remaining = 0.0;
		lobby.doors_cooldown_remaining = 0.0;
		lobby.map.open_all_doors();
		lobby.sabotage_fixed_panels.resize(0);
		lobby.winner = "";
		lobby.elapsed_time = 0.0;
		// Zerar isto era esquecido: o valor sobrava da partida ANTERIOR nessa mesma lobby.
		lobby.sabotage_cooldown_remaining = SABOTAGE_INITIAL_COOLDOWN_SECONDS;
		lobby.state = "in_progress";

		json_array@ roster = json_array();
		for (uint i = 0; i < lobby.players.length(); i++) {
			json_object@ rj = json_object();
			rj.set("peer_id", lobby.players[i].peer_id);
			rj.set("name", lobby.players[i].username);
			rj.set("color", lobby.players[i].color);
			rj.set("x", lobby.players[i].x);
			rj.set("y", lobby.players[i].y);
			roster.add(rj);
		}

		for (uint i = 0; i < lobby.players.length(); i++) {
			game_player@ p = lobby.players[i];
			if (p.is_bot) continue; // não tem pra quem mandar
			net_packet@ start = net_packet(S_GAME_START);
			start.set_string("map_name", lobby.map.name);
			start.set_bool("your_role_impostor", p.is_impostor); // clientes até o protocolo 1
			start.set_string("your_role", p.role_id);
			// O que a SALA configurou (id -> quantos, e a chance de cada um), para todo mundo: assim
			// como o número de impostores, saber que "pode haver um xerife" muda a leitura de tudo o
			// que acontece. É a configuração, e nunca o resultado do sorteio: dizer o que realmente
			// saiu entregaria a dedução que a chance existe para criar.
			json_object@ cfg_json = lobby.config.to_json(lobby.players.length());
			start.set_object("role_counts", cfg_json.get_object("role_counts"));
			start.set_object("role_chances", cfg_json.get_object("role_chances"));
			start.set_int("your_color", p.color);
			start.set_uint64("your_peer_id", p.peer_id);
			start.set_float("your_x", p.x);
			start.set_float("your_y", p.y);
			start.set_float("kill_cooldown_seconds", lobby.config.kill_cooldown_seconds);
			start.set_float("sabotage_cooldown_seconds", lobby.sabotage_cooldown_remaining);
			// Regra de voz da sala: sem ela o cliente capturaria e mandaria áudio que o servidor iria
			// descartar - microfone aberto à toa.
			start.set_bool("voice_chat", lobby.config.voice_chat);
			// O cliente decide sozinho se abre o microfone, e precisa da MESMA regra que o servidor
			// usa para decidir quem ouve - senão ele cala a reunião que o servidor deixaria passar.
			start.set_bool("comms_affects_meeting", lobby.config.comms_affects_meeting);
			// Quantos impostores existem. Vai pra todo mundo: o tripulante precisa saber se está caçando
			// um ou três, senão a discussão da reunião é chute puro.
			start.set_int("impostor_count", impostor_count);

			// Os OUTROS impostores, mandados só pra quem é impostor - cada um precisa saber quem é do
			// time dele pra não se denunciar sozinho na reunião. A lista sai montada por destinatário
			// justamente pra nunca sair daqui pra um tripulante.
			// Vai peer_id junto com o nome porque o cliente usa os ids pra nunca mirar um parceiro na
			// hora de matar (ver a tecla de kill em game/game_loop.nvgt).
			if (p.is_impostor) {
				json_array@ partners = json_array();
				for (uint j = 0; j < lobby.players.length(); j++) {
					game_player@ other = lobby.players[j];
					if (!other.is_impostor || other.peer_id == p.peer_id) continue;
					json_object@ entry = json_object();
					entry.set("peer_id", other.peer_id);
					entry.set("name", other.username);
					partners.add(entry);
				}
				start.set_array("impostor_partners", partners);
			}
			start.set_array("players", roster);

			json_array@ tasks_json = json_array();
			for (uint t = 0; t < p.tasks.length(); t++) {
				json_object@ tj = json_object();
				tj.set("object_id", p.tasks[t].object_id);
				tj.set("task_type", p.tasks[t].task_type);
				// A fase vai junto porque a partida pode ter recomeçado com a tarefa no meio (reunião,
				// reconexão): o cliente precisa mirar o ponto certo, não o começo da corrente.
				tj.set("phase", int(p.tasks[t].phase));
				tj.set("phase_count", int(p.tasks[t].phase_count));
				tasks_json.add(tj);
			}
			start.set_array("tasks", tasks_json);

			send_to(p.peer_id, start);
		}

		broadcast_to_lobby(lobby, lobby.build_task_progress_packet()); // placar zerado, pra todo mundo já começar sabendo o total
	}

	// --- Jogo em andamento ---

	void on_move(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		float x = pkt.get_float("x");
		float y = pkt.get_float("y");
		if (!lobby.try_move_player(peer_id, x, y)) return;

		game_player@ p = lobby.find_player(peer_id);
		if (@p == null || p.vented) return; // jogador escondido no vent não transmite posição

		net_packet@ moved = net_packet(S_PLAYER_MOVED);
		moved.set_uint64("peer_id", peer_id);
		moved.set_float("x", x);
		moved.set_float("y", y);
		if (p.alive) broadcast_to_lobby(lobby, moved, peer_id, false);
		else broadcast_to_dead_players(lobby, moved, peer_id); // fantasma: invisível pra quem tá vivo
	}

	// A minigame roda no cliente; o servidor só se importa com a task VISÍVEL (o scan): confere que
	// o jogador tem mesmo essa task pendente e, só então, avisa a partida. É essa conferência que
	// transforma o som do scanner em prova - o impostor pode abrir o que quiser no cliente dele, mas
	// o servidor não anuncia um scan de quem não tem scan para fazer.
	void on_start_task(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		string object_id = pkt.get_string("task_id");
		if (!lobby.try_start_visible_task(peer_id, object_id)) return;
		game_player@ p = lobby.find_player(peer_id);
		broadcast_task_visible(lobby, peer_id, @p != null ? p.username : "", object_id, true);
	}

	void broadcast_task_visible(game_state@ lobby, uint64 peer_id, const string&in name, const string&in object_id, bool active) {
		net_packet@ pkt = net_packet(S_TASK_VISIBLE);
		pkt.set_uint64("peer_id", peer_id);
		pkt.set_string("name", name);
		pkt.set_string("object_id", object_id);
		pkt.set_bool("active", active);
		// Quem faz a task já ouve o scanner no próprio cliente; para ele o aviso seria eco.
		broadcast_to_lobby(lobby, pkt, peer_id);
	}

	// Encerra a task visível (de um jogador, ou de quem estiver nela com peer 0) e avisa a partida.
	// Chamado de todo lugar que interrompe a task: fim normal, reunião, morte, saída.
	void end_visible_task(game_state@ lobby, uint64 peer_id = 0) {
		uint64 quem = lobby.end_visible_task(peer_id);
		if (quem == 0) return;
		game_player@ p = lobby.find_player(quem);
		broadcast_task_visible(lobby, quem, @p != null ? p.username : "", "", false);
	}

	void on_task_input(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		// Fantasma (morto ou expulso) CONTINUA fazendo task, e isso é essencial: é o que dá aos
		// tripulantes chance de ganhar pelas tasks depois de perder gente. Ele só não interage com
		// mais nada (botão, painel, vent - ver game/game_loop.nvgt).
		game_player@ p = lobby.find_player(peer_id);
		if (@p == null) return;

		string task_id = pkt.get_string("task_id");
		bool success = pkt.get_bool("success");
		// O resultado (bom ou ruim) é o fim da minigame: a task visível, se era este jogador, acaba
		// aqui - ANTES dos retornos abaixo, senão um scan cancelado ficaria soando para sempre.
		end_visible_task(lobby, peer_id);
		if (!success) return;
		string next_object_id;
		uint phase;
		if (!lobby.advance_task(p, task_id, next_object_id, phase)) return;

		// A estatística conta FASES concluídas: é o que o jogador fez, e é o mesmo passo que move a
		// barra da equipe.
		g_user_db.increment_stat(p.username, "tasks_completed", 1);

		net_packet@ result = net_packet(S_TASK_RESULT);
		result.set_string("task_id", task_id);
		result.set_bool("ok", true);
		result.set_int("progress", p.task_progress_percent());
		// Vazio quando a tarefa acabou; com valor, é o ponto da próxima fase (ver advance_task).
		result.set_string("next_object_id", next_object_id);
		result.set_int("phase", int(phase));
		send_to(peer_id, result);

		// Placar da equipe vai pra TODO mundo, impostor incluído: pro tripulante é saber quanto falta,
		// pro impostor é o relógio correndo contra ele (ver run_task_list_menu no cliente).
		broadcast_to_lobby(lobby, lobby.build_task_progress_packet());
	}

	void on_kill(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		uint64 target_peer = pkt.get_uint64("target_peer");

		// Antes falhava em silêncio (o impostor apertava matar, nada acontecia, e não tinha como
		// saber se foi cooldown, alcance, ou alvo já morto) - agora pelo menos o caso mais comum
		// (cooldown) avisa por quê.
		game_player@ killer = lobby.find_player(peer_id);
		if (@killer != null && killer.role().can_kill && killer.alive && killer.kill_cooldown_remaining > 0.0) {
			send_error(peer_id, "game.kill_on_cooldown");
			return;
		}

		net_packet@ event;
		bool misfire = false;
		if (lobby.try_kill(peer_id, target_peer, event, misfire)) {
			// QUEM morreu sai do pacote, e não do alvo pedido: no tiro errado do xerife quem cai é o
			// atirador, e limpar o estado do alvo deixaria o morto de verdade preso na câmera.
			uint64 victim_peer = event.get_uint64("peer_id");
			// A vítima larga o posto: fantasma não opera equipamento, e um posto preso a quem morreu
			// ficaria bloqueado para o resto da partida. Ela também precisa ser AVISADA, ou o cliente
			// dela continua na câmera, sem andar, agora como fantasma.
			if (lobby.release_cameras(victim_peer)) {
				send_camera_state(victim_peer, false, "");
				broadcast_camera_watching(lobby);
			}
			end_visible_task(lobby, victim_peer); // morreu no scanner: o scanner para
			broadcast_to_lobby(lobby, event);

			// Papel que anuncia a própria morte (alarmista). DEPOIS do pacote da morte, para o som
			// do assassinato vir antes do aviso - a ordem inversa contaria o que aconteceu e só
			// então deixaria ouvir. Sai da capacidade, não do id: um papel futuro pode fazer igual.
			game_player@ victim = lobby.find_player(victim_peer);
			if (@victim != null && victim.role().announces_own_death) {
				net_packet@ alarm = net_packet(S_DEATH_ALARM);
				alarm.set_string("name", victim.username);
				map_zone@ zone = lobby.map.find_zone(lobby.map.room_id_at(victim.x, victim.y));
				// A SALA, e não a posição: o aviso diz onde procurar, não entrega o ponto exato -
				// quem quiser mais que isso tem que ir até lá. E nunca diz quem matou.
				alarm.set_string("room_key", @zone != null ? zone.name_key : "");
				broadcast_to_lobby(lobby, alarm);
			}
			// O tiro errado é dito SÓ a quem errou, depois do pacote da morte: para todos os outros
			// (inclusive para quem ele mirou) aquilo foi um assassinato qualquer, e é isso que
			// mantém o xerife sendo uma aposta em vez de um detector.
			if (misfire) send_error(peer_id, "role.sheriff_misfire");
		}
	}

	void on_report_body(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		game_player@ p = lobby.find_player(peer_id);
		if (@p == null || !p.alive) return;

		body_info@ body = lobby.find_body_near(p.x, p.y, PLAYER_REPORT_RANGE);
		if (@body == null) return;
		if (lobby.meetings_blocked_by_sabotage()) { send_error(peer_id, "sabotage.blocks_meeting"); return; }

		net_packet@ reported = net_packet(S_BODY_REPORTED);
		reported.set_uint64("reporter_peer", peer_id);
		reported.set_uint64("body_peer", body.victim_peer_id);
		// ONDE o corpo foi achado é metade da informação de uma reunião - sem isso a discussão
		// começava sem ninguém saber de que sala se está falando. Vai a chave de i18n da sala (o
		// servidor é quem tem o mapa aqui), o cliente só traduz.
		map_zone@ body_zone = lobby.map.find_zone(body.room_id);
		reported.set_string("room_key", @body_zone != null ? body_zone.name_key : "");
		broadcast_to_lobby(lobby, reported);

		for (uint i = 0; i < lobby.bodies.length(); i++) {
			if (lobby.bodies[i].id == body.id) { lobby.bodies.remove_at(i); break; }
		}

		net_packet@ event;
		if (lobby.start_meeting(peer_id, "body", event)) {
			// Reunião leva todo mundo para a cafeteria - ninguém fica operando câmera. Sem chave de
			// aviso: o anúncio da reunião já explica o que aconteceu.
			close_cameras(lobby);
			interrupt_visible_task(lobby);
			broadcast_meeting_and_voting(lobby, event);
		}
	}

	// Manda o aviso de reunião (com a posição de teleporte) e, na sequência, já abre a votação - não
	// existe mais uma fase de discussão separada esperando um timer (ver game_state.start_meeting()).
	void broadcast_meeting_and_voting(game_state@ lobby, net_packet@ meeting_event) {
		broadcast_to_lobby(lobby, meeting_event);
		// Quem foi tirado do vent pela reunião (ver game_state.start_meeting) precisa saber - senão o
		// cliente segue achando que está escondido e continua bloqueando o movimento sozinho.
		if (lobby.meeting_doors_opened.length() > 0) {
			broadcast_to_lobby(lobby, lobby.build_doors_packet(lobby.meeting_doors_opened, false));
		}
		for (uint i = 0; i < lobby.meeting_unvented_peers.length(); i++) {
			net_packet@ vent_state = net_packet(S_VENT_STATE);
			vent_state.set_bool("vented", false);
			vent_state.set_float("x", MEETING_GATHER_X);
			vent_state.set_float("y", MEETING_GATHER_Y);
			send_to(lobby.meeting_unvented_peers[i], vent_state);
		}
		net_packet@ vs = net_packet(S_VOTING_STARTED);
		vs.set_float("voting_time", lobby.voting_timer);
		broadcast_to_lobby(lobby, vs);
	}

	void on_call_meeting(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		if (lobby.state != "in_progress") {
			// Já tem reunião/votação rolando, ou a partida acabou - sem isso o botão parecia
			// simplesmente não fazer nada quando apertado de novo nesse meio tempo.
			send_error(peer_id, "game.meeting_call_failed");
			return;
		}
		game_player@ p = lobby.find_player(peer_id);
		if (@p == null || !p.alive) return;
		string button_block_reason = lobby.emergency_button_block_reason();
		if (button_block_reason != "") { send_error(peer_id, button_block_reason); return; }

		// Recarga depois da última reunião: diz quanto falta, em vez do genérico "não deu certo".
		if (lobby.emergency_button_cooldown_reason() != "") {
			dictionary@ cd = dictionary();
			cd.set("seconds", "" + int(lobby.meeting_cooldown_remaining + 0.5));
			send_error(peer_id, lobby.emergency_button_cooldown_reason(), cd);
			return;
		}

		// Não valida distância até o botão aqui: a posição que o servidor tem vem do canal de
		// movimento não confiável e pode estar sempre um pouco atrás da posição real (o cliente já
		// só deixa chamar isso quando o jogador está perto o bastante, via find_interactable) -
		// checar de novo aqui só causava falha na primeira tentativa (posição ainda desatualizada)
		// e sucesso na segunda, de forma inconsistente. Chamar reunião não tem risco sério de ser
		// abusado à distância (o limite de reuniões por jogador já existe), então confiamos no
		// cliente pra essa validação específica.
		net_packet@ event;
		if (lobby.start_meeting(peer_id, "button", event)) {
			close_cameras(lobby);
			interrupt_visible_task(lobby);
			broadcast_meeting_and_voting(lobby, event);
		} else {
			// Sem isso o jogador aperta o botão e não acontece nada nem fala nada - ex.: já gastou
			// as reuniões de emergência permitidas, ou uma reunião/votação já está em andamento.
			send_error(peer_id, "game.meeting_call_failed");
		}
	}

	void on_cast_vote(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		int64 target = pkt.get_int64("target_peer", -1);
		if (!lobby.cast_vote(peer_id, target)) {
			// Antes o cliente não sabia se o voto foi mesmo aceito - dava pra abrir o menu de novo e
			// "votar" outra vez sem nenhum aviso, mesmo o servidor já ignorando o segundo voto.
			send_error(peer_id, "game.already_voted");
			return;
		}
		game_player@ voter = lobby.find_player(peer_id);
		if (@voter != null) {
			net_packet@ cast_pkt = net_packet(S_VOTE_CAST);
			cast_pkt.set_uint64("voter_peer", peer_id);
			cast_pkt.set_string("voter_name", voter.username);
			// Com os votos abertos, o ALVO vai junto, na hora. Fechados, nem viaja: o cliente é a
			// máquina do jogador, e "manda mas não fala" seria mandar para quem quisesse ler.
			cast_pkt.set_bool("target_revealed", lobby.config.show_votes);
			if (lobby.config.show_votes) {
				cast_pkt.set_bool("skipped", target == -1);
				game_player@ tp = target == -1 ? null : lobby.find_player(uint64(target));
				cast_pkt.set_string("target_name", @tp != null ? tp.username : "");
			}
			broadcast_to_lobby(lobby, cast_pkt);
		}
	}

	// Entra num vent perto (achado por proximidade, igual qualquer outro objeto interativo). Uma vez
	// dentro, sair ou viajar pra outro vent da mesma rede usa on_vent_travel (tecla V no cliente) -
	// esses não dependem de proximidade porque a rede inteira conta como "dentro do vent".
	void on_use_vent(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		game_player@ p = lobby.find_player(peer_id);
		// Capacidade, e não identidade: o engenheiro também usa os dutos (ver role_traits). Perguntar
		// "é impostor?" aqui era o que obrigaria cada papel novo a revisitar este ponto.
		if (@p == null || p.vented || !player_abilities(p.role(), p.alive).can_vent()) return;

		string vent_id = pkt.get_string("vent_id");
		map_object@ vent = lobby.map.find_object(vent_id);
		if (@vent == null || vent.obj_type != OBJ_VENT) return;
		if (distance_2d(p.x, p.y, vent.x, vent.y) > PLAYER_INTERACT_RANGE) return;

		p.x = vent.x;
		p.y = vent.y;
		p.vented = true;
		p.current_vent_id = vent_id;

		net_packet@ result = net_packet(S_VENT_STATE);
		result.set_bool("vented", true);
		result.set_float("x", p.x);
		result.set_float("y", p.y);
		send_to(peer_id, result);
		broadcast_vent_sound(lobby, peer_id, vent_id);
	}

	// A tampa do vent abrindo é ouvida por quem está por perto - é o que equilibra o vent, que não
	// tem recarga nenhuma (igual ao jogo original, onde entrar e sair é livre, mas visível e audível
	// pra quem estiver na sala). Vai pra todo mundo MENOS quem usou: esse já toca o som no próprio
	// cliente, na hora, sem esperar a rede.
	// Viajar de um vent pro outro NÃO faz som pra ninguém de fora: a tampa não abre, o impostor segue
	// escondido - também como no original.
	void broadcast_vent_sound(game_state@ lobby, uint64 user_peer, const string&in vent_id) {
		if (vent_id == "") return;
		net_packet@ vent_sound = net_packet(S_VENT_SOUND);
		vent_sound.set_string("vent_id", vent_id);
		broadcast_to_lobby(lobby, vent_sound, user_peer);
	}

	// Sair do vent (target_vent_id == "") ou viajar pra outro vent CONECTADO ao atual, permanecendo
	// escondido - só chamado enquanto já vented (ver tecla V / menu de vent no cliente).
	void on_vent_travel(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		game_player@ p = lobby.find_player(peer_id);
		if (@p == null || !p.alive || !p.vented) return;

		string target_id = pkt.get_string("target_vent_id");

		if (target_id == "") {
			string exited_vent_id = p.current_vent_id;
			p.vented = false;
			p.current_vent_id = "";
			broadcast_vent_sound(lobby, peer_id, exited_vent_id); // a tampa abrindo, ouvida por quem está perto
			net_packet@ moved = net_packet(S_PLAYER_MOVED);
			moved.set_uint64("peer_id", peer_id);
			moved.set_float("x", p.x);
			moved.set_float("y", p.y);
			broadcast_to_lobby(lobby, moved, peer_id, false);

			net_packet@ result = net_packet(S_VENT_STATE);
			result.set_bool("vented", false);
			result.set_float("x", p.x);
			result.set_float("y", p.y);
			send_to(peer_id, result);
			return;
		}

		map_object@ current_vent = lobby.map.find_object(p.current_vent_id);
		map_object@ target_vent = lobby.map.find_object(target_id);
		if (@current_vent == null || @target_vent == null || target_vent.obj_type != OBJ_VENT) return;
		if (lobby.map.vent_connections(current_vent).find(target_id) == -1) return; // não conectado

		p.x = target_vent.x;
		p.y = target_vent.y;
		p.current_vent_id = target_id;

		net_packet@ result = net_packet(S_VENT_STATE);
		result.set_bool("vented", true);
		result.set_float("x", p.x);
		result.set_float("y", p.y);
		send_to(peer_id, result);
	}

	// Quem `me` consegue perceber pelo radar agora. Uma função só para o radar normal e o travado:
	// se a regra de percepção morasse em dois lugares, um dia um deles deixaria de excluir o duto.
	//
	// Sabotagem não atrapalha quem sabota: o impostor mantém o radar inteiro nos dois casos abaixo.
	// É a mesma lógica do jogo original, onde o apagão não cega o impostor - a sabotagem é uma
	// arma dele, e uma arma que atinge o próprio dono deixa de ser usada.
	//
	// Devolve null com `fail_key` preenchida quando o radar está fora (comunicações sabotadas): é o
	// equivalente aqui ao "esconder as tasks" do jogo original - tira a ferramenta principal de saber
	// quem está perto de você.
	array<game_player@>@ radar_targets(game_state@ lobby, game_player@ me, string&out fail_key) {
		fail_key = "";
		// Quem é cegado pelas comunicações sai do papel, não de "é impostor?" - o engenheiro é
		// tripulante e sofre igual, mas um papel futuro pode não sofrer.
		bool blinded_by_sabotage = !me.role().immune_to_comms;
		if (blinded_by_sabotage && lobby.active_sabotage == "comms") {
			fail_key = "sabotage.comms.radar_down";
			return null;
		}
		array<game_player@>@ nearby = lobby.players_in_same_room(me.peer_id);
		// Luzes apagadas: o radar vira quase um tato - só sente quem está bem colado, mesmo estando
		// todo mundo na mesma sala.
		if (blinded_by_sabotage && lobby.active_sabotage == "lights") {
			array<game_player@> in_reach;
			for (uint i = 0; i < nearby.length(); i++) {
				if (distance_2d(me.x, me.y, nearby[i].x, nearby[i].y) <= RADAR_LIGHTS_OUT_RANGE) in_reach.insert_last(nearby[i]);
			}
			nearby = in_reach;
		}
		return nearby;
	}

	void on_radar_scan(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		game_player@ me = lobby.find_player(peer_id);
		if (@me == null) return; // fantasma (morto/expulso) também pode usar o radar - só não aparece nele

		string fail_key;
		array<game_player@>@ nearby = radar_targets(lobby, me, fail_key);
		if (@nearby == null) { send_error(peer_id, fail_key); return; }

		net_packet@ result = net_packet(S_RADAR_RESULT);
		if (nearby.length() == 0) {
			result.set_bool("empty", true);
			send_to(peer_id, result);
			return;
		}

		int direction = pkt.get_int("direction", 1);
		me.radar_index = (me.radar_index + direction) % int(nearby.length());
		if (me.radar_index < 0) me.radar_index += int(nearby.length());

		fill_radar_result(result, me, nearby[me.radar_index]);
		send_to(peer_id, result);
	}

	// Radar travado: o alvo ainda pode ser percebido? Responde pela MESMA lista do radar normal - o
	// alvo que entrou num duto, saiu da sala ou sumiu no escuro deixa de estar nela, e a trava cai.
	void on_radar_track(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		game_player@ me = lobby.find_player(peer_id);
		if (@me == null) return;

		net_packet@ result = net_packet(S_RADAR_RESULT);
		result.set_bool("track", true);

		string fail_key;
		array<game_player@>@ nearby = radar_targets(lobby, me, fail_key);
		uint64 target_peer = pkt.get_uint64("peer_id");
		game_player@ target = null;
		if (@nearby != null) {
			for (uint i = 0; i < nearby.length(); i++) {
				if (nearby[i].peer_id == target_peer) { @target = nearby[i]; break; }
			}
		}
		if (@target == null) {
			result.set_bool("empty", true);
			result.set_bool("lost", true);
			send_to(peer_id, result);
			return;
		}
		fill_radar_result(result, me, target);
		send_to(peer_id, result);
	}

	void fill_radar_result(net_packet@ result, game_player@ me, game_player@ target) {
		result.set_bool("empty", false);
		result.set_uint64("peer_id", target.peer_id);
		result.set_string("name", target.username);
		result.set_float("x", target.x);
		result.set_float("y", target.y);
		result.set_float("distance", distance_2d(me.x, me.y, target.x, target.y));
	}

	void on_trigger_sabotage(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		string sabotage_id = pkt.get_string("sabotage_id");

		net_packet@ event;
		string fail_key;
		if (lobby.trigger_sabotage(peer_id, sabotage_id, event, fail_key)) {
			// Comunicações fora derrubam o posto de câmeras junto com o radar e os marcadores: é a
			// resposta do impostor contra a segurança, e sem ela a câmera seria vigilância sem
			// contrapartida.
			if (sabotage_id == "comms") close_cameras(lobby, "camera.comms_down");
			broadcast_to_lobby(lobby, event);
		} else {
			// Antes falhava calado - o impostor escolhia a sabotagem no menu e não acontecia nada,
			// sem nenhuma pista de que a lobby simplesmente não permite sabotagem (preset "rápido"),
			// de que ainda está em recarga, ou de que é a mesma da vez passada.
			send_error(peer_id, fail_key);
		}
	}

	void on_close_doors(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		array<string>@ closed_zones;
		if (!lobby.close_doors_of_room(peer_id, pkt.get_string("room_id"), closed_zones)) {
			send_error(peer_id, "game.doors_unavailable");
			return;
		}
		broadcast_to_lobby(lobby, lobby.build_doors_packet(closed_zones, true));
	}

	// Responde na hora, sem checar lobby/estado - o cliente usa isso só pra medir o round-trip de rede.
	// --- Câmeras de segurança ---

	// Fecha o posto de câmeras, seja quem for que esteja nele, e AVISA quem estava observando.
	//
	// O aviso é a parte que faltava: sem ele o cliente de quem observava continuava na câmera - sem
	// andar, ouvindo outra sala, esperando um ESC que não resolvia nada, porque para o servidor ele
	// já tinha saído. Todo lugar que derruba a câmera passa por aqui.
	void close_cameras(game_state@ lobby, const string&in message_key = "") {
		uint64 quem = lobby.release_cameras_any();
		if (quem == 0) return;
		send_camera_state(quem, false, "", message_key);
		broadcast_camera_watching(lobby);
	}

	// Reunião: todo mundo é teleportado, e uma task visível pela metade não pode continuar soando
	// numa enfermaria vazia. Chamado junto do close_cameras nos dois começos de reunião.
	void interrupt_visible_task(game_state@ lobby) {
		end_visible_task(lobby);
	}

	void send_camera_state(uint64 peer_id, bool active, const string&in room_id, const string&in message_key = "") {
		net_packet@ pkt = net_packet(S_CAMERA_STATE);
		pkt.set_bool("active", active);
		pkt.set_string("room_id", room_id);
		pkt.set_string("message_key", message_key);
		send_to(peer_id, pkt);
	}

	// Conta para a partida INTEIRA qual sala está sob observação. É isto que faz o zumbido tocar
	// para quem está lá - e também para quem entrar na sala depois, que é o caso que um aviso
	// pontual não cobriria.
	void broadcast_camera_watching(game_state@ lobby) {
		net_packet@ pkt = net_packet(S_CAMERA_WATCHING);
		pkt.set_string("room_id", lobby.camera_room_id);
		broadcast_to_lobby(lobby, pkt);
	}

	void on_camera_enter(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		string fail = lobby.try_enter_cameras(peer_id);
		if (fail != "") {
			send_camera_state(peer_id, false, "", fail);
			return;
		}
		send_camera_state(peer_id, true, lobby.camera_room_id);
		broadcast_camera_watching(lobby);
	}

	void on_camera_leave(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		if (!lobby.release_cameras(peer_id)) return;
		send_camera_state(peer_id, false, "");
		broadcast_camera_watching(lobby);
	}

	void on_camera_switch(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.camera_user_peer != peer_id) return;
		// A sala tem que existir no mapa: o id vem do cliente, e um id inventado deixaria a câmera
		// apontada para lugar nenhum - sem som, sem erro, parecendo defeito.
		string room_id = pkt.get_string("room_id");
		map_zone@ zone = lobby.map.find_zone(room_id);
		if (@zone == null) return;
		lobby.camera_room_id = room_id;
		send_camera_state(peer_id, true, room_id);
		broadcast_camera_watching(lobby);
	}

	// Quem está na sala observada. Só responde a quem realmente está no posto - a pergunta é sobre
	// uma sala que só faz sentido para quem a está observando, e responder a qualquer um daria um
	// radar de sala arbitrária a quem não pagou o preço de ficar parado na segurança.
	void on_camera_scan(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.camera_user_peer != peer_id) return;

		array<game_player@>@ there = lobby.players_in_room(lobby.camera_room_id, peer_id);
		json_array@ names = json_array();
		for (uint i = 0; i < there.length(); i++) names.add(there[i].username);

		net_packet@ result = net_packet(S_CAMERA_PLAYERS);
		result.set_array("names", names);
		send_to(peer_id, result);
	}

	// --- Respostas aos recados ---

	void on_feedback_replies_get(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || conn.username == "") return;
		send_feedback_replies(peer_id, conn.username);
	}

	void send_feedback_replies(uint64 peer_id, const string&in username) {
		net_packet@ resposta = net_packet(S_FEEDBACK_REPLIES);
		resposta.set_array("replies", g_user_db.unread_feedback_replies(username));
		send_to(peer_id, resposta);
	}

	void on_feedback_reply_read(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || conn.username == "") return;
		g_user_db.mark_feedback_reply_read(pkt.get_int("reply_id", 0), conn.username);
	}

	// Quem faz o jogo responde a um recado, pela ferramenta de administração (tools/reply_feedback).
	//
	// A comparação do token é o único portão: não há conta de administrador, porque uma conta seria
	// mais uma senha para vazar dentro do mesmo banco que ela protege. Token vazio no servidor
	// desliga a função inteira - melhor nenhuma resposta do que qualquer um respondendo.
	//
	// Se o dono do recado estiver conectado, ele recebe a resposta na hora; senão, na próxima vez que
	// entrar (ver on_feedback_replies_get).
	void on_admin_reply(uint64 peer_id, net_packet@ pkt) {
		net_packet@ result = net_packet(S_ADMIN_RESULT);
		string expected = read_environment_variable("AMONGUS_ADMIN_TOKEN", "");
		if (expected == "" || pkt.get_string("token", "") != expected) {
			result.set_bool("ok", false);
			result.set_string("message", expected == "" ? "server_has_no_token" : "bad_token");
			send_to(peer_id, result);
			return;
		}
		int feedback_id = pkt.get_int("feedback_id", 0);
		string text = pkt.get_string("text", "").trim_whitespace();
		if (text.length() > MAX_FEEDBACK_TEXT_LENGTH) text = text.substr(0, MAX_FEEDBACK_TEXT_LENGTH);
		if (feedback_id <= 0 || text == "") {
			result.set_bool("ok", false);
			result.set_string("message", "bad_request");
			send_to(peer_id, result);
			return;
		}
		string dono = g_user_db.save_feedback_reply(feedback_id, text);
		if (dono == "") {
			result.set_bool("ok", false);
			result.set_string("message", "feedback_not_found");
			send_to(peer_id, result);
			return;
		}
		result.set_bool("ok", true);
		result.set_string("message", "delivered_to:" + dono);
		send_to(peer_id, result);

		for (uint i = 0; i < connections.length(); i++) {
			if (connections[i].username == dono) send_feedback_replies(connections[i].peer_id, dono);
		}
	}

	// --- Traduções enviadas pelo jogo ---

	// O arquivo é validado ANTES de gravar: tamanho, JSON que abre, language.name presente e um código
	// de idioma que sirva de nome de arquivo. Não é para julgar a tradução - isso é de quem revisa -
	// mas um arquivo que nem carrega não vale o espaço no banco, e o jogador merece saber na hora
	// que mandou algo quebrado, em vez de descobrir semanas depois que foi descartado.
	void on_send_translation(uint64 peer_id, net_packet@ pkt) {
		net_packet@ ack = net_packet(S_TRANSLATION_ACK);
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || conn.username == "") { ack.set_bool("ok", false); ack.set_string("message_key", "translation.send_failed"); send_to(peer_id, ack); return; }

		string code = pkt.get_string("code", "").trim_whitespace();
		string content = pkt.get_string("content", "");
		string fail = "";
		if (!is_valid_language_code(code)) fail = "translation.bad_code";
		else if (BUILTIN_LANGUAGES.find(code) != -1) fail = "translation.builtin";
		else if (content.length() == 0 || content.length() > MAX_TRANSLATION_BYTES) fail = "translation.too_big";
		else fail = validate_translation_json(content);
		if (fail == "") {
			if (!g_user_db.save_translation(conn.username, code, content)) fail = "translation.send_failed";
		}
		ack.set_bool("ok", fail == "");
		ack.set_string("message_key", fail == "" ? "translation.sent" : fail);
		send_to(peer_id, ack);
	}

	// "" se o conteúdo é um JSON de tradução aceitável, senão a chave do motivo.
	//
	// Dentro de try/catch porque o parse_json do NVGT LANÇA exceção em JSON malformado em vez de
	// devolver null - e uma exceção não tratada aqui derruba o servidor inteiro. Descoberto no
	// teste: um envio com "{" solto matou o processo para todos os jogadores conectados. Conteúdo
	// que vem da rede nunca pode ter o poder de derrubar o servidor.
	string validate_translation_json(const string&in content) {
		try {
			var@ parsed = parse_json(content);
			json_object@ obj = @parsed != null ? cast<json_object@>(parsed) : null;
			if (@obj == null) return "translation.bad_json";
			if (!obj.exists("language.name")) return "translation.no_name";
			if (string(obj["language.name"]) == "") return "translation.no_name";
			return "";
		} catch {
			return "translation.bad_json";
		}
	}

	// Só letras, dígitos e sublinhado, como "es_LATAM": o código vira nome de arquivo do outro lado,
	// e um "../x" aqui seria um caminho, não um idioma.
	bool is_valid_language_code(const string&in code) const {
		if (code.length() < 2 || code.length() > 16) return false;
		for (uint i = 0; i < code.length(); i++) {
			string c = code.substr(i, 1);
			bool ok = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_";
			if (!ok) return false;
		}
		return true;
	}

	bool admin_token_ok(uint64 peer_id, net_packet@ pkt) {
		string expected = read_environment_variable("AMONGUS_ADMIN_TOKEN", "");
		if (expected != "" && pkt.get_string("token", "") == expected) return true;
		net_packet@ result = net_packet(S_ADMIN_RESULT);
		result.set_bool("ok", false);
		result.set_string("message", expected == "" ? "server_has_no_token" : "bad_token");
		send_to(peer_id, result);
		return false;
	}

	void on_admin_list_translations(uint64 peer_id, net_packet@ pkt) {
		if (!admin_token_ok(peer_id, pkt)) return;
		net_packet@ out_pkt = net_packet(S_ADMIN_TRANSLATIONS);
		out_pkt.set_array("items", g_user_db.list_translations());
		send_to(peer_id, out_pkt);
	}

	void on_admin_delete_translation(uint64 peer_id, net_packet@ pkt) {
		if (!admin_token_ok(peer_id, pkt)) return;
		bool ok = g_user_db.delete_translation(pkt.get_string("username", ""), pkt.get_string("code", ""));
		net_packet@ result = net_packet(S_ADMIN_RESULT);
		result.set_bool("ok", ok);
		result.set_string("message", ok ? "deleted" : "delete_failed");
		send_to(peer_id, result);
	}

	// --- Reinício anunciado ---

	void on_admin_drain(uint64 peer_id, net_packet@ pkt) {
		if (!admin_token_ok(peer_id, pkt)) return;
		drain_seconds = float(pkt.get_int("seconds", 120));
		@drain_clock = timer();
		// Todo mundo conectado ouve, esteja onde estiver: menu, sala de espera, partida.
		dictionary@ p = dictionary();
		p.set("minutes", "" + ((int(drain_seconds) + 59) / 60));
		net_packet@ aviso = build_message(S_ERROR, "server.restart_in", p);
		for (uint i = 0; i < connections.length(); i++) send_to(connections[i].peer_id, aviso);
		net_packet@ result = net_packet(S_ADMIN_RESULT);
		result.set_bool("ok", true);
		result.set_string("message", "draining:" + int(drain_seconds));
		send_to(peer_id, result);
	}

	void on_admin_status(uint64 peer_id, net_packet@ pkt) {
		if (!admin_token_ok(peer_id, pkt)) return;
		net_packet@ st = net_packet(S_ADMIN_STATUS);
		st.set_int("connections", int(connections.length()));
		st.set_int("lobbies", int(lobbies.length()));
		st.set_int("in_progress", int(matches_in_progress()));
		st.set_int("draining_seconds", draining_seconds_left());
		send_to(peer_id, st);
	}

	void on_ping(uint64 peer_id, net_packet@ pkt) {
		send_to(peer_id, net_packet(S_PONG));
	}

	// Recado de um jogador para quem faz o jogo. Grava no banco e confirma.
	//
	// Exige estar autenticado: sem isso qualquer um que abrisse um socket na porta poderia encher a
	// tabela, e o recado perderia justamente o que o torna útil - saber de quem veio para poder
	// perguntar mais.
	void on_send_feedback(uint64 peer_id, net_packet@ pkt) {
		net_packet@ ack = net_packet(S_FEEDBACK_ACK);

		game_player@ conn = find_connection(peer_id);
		if (@conn == null || conn.username == "") {
			ack.set_bool("ok", false);
			send_to(peer_id, ack);
			return;
		}

		string text = pkt.get_string("text");
		if (text == "") {
			ack.set_bool("ok", false);
			send_to(peer_id, ack);
			return;
		}

		// Corte de tamanho no SERVIDOR, e não só na tela: o cliente é a máquina do jogador, e o que
		// chega pela rede pode não ter passado pela tela nenhuma. O crash.log tem folga maior porque
		// é ele que carrega o rastro do erro - cortar curto demais jogaria fora justamente o fim do
		// arquivo, que é onde está o crash mais recente.
		if (text.length() > MAX_FEEDBACK_TEXT_LENGTH) text = text.substr(0, MAX_FEEDBACK_TEXT_LENGTH);
		string crash_log = pkt.get_string("crash_log");
		if (crash_log.length() > MAX_FEEDBACK_CRASH_LOG_LENGTH) {
			// Fica com o FINAL: num log que acumula (ver core/crash_log.nvgt), o que interessa é o
			// último crash, não o primeiro.
			crash_log = crash_log.substr(crash_log.length() - MAX_FEEDBACK_CRASH_LOG_LENGTH);
		}

		bool ok = @g_user_db != null && g_user_db.save_feedback(conn.username, text,
			pkt.get_string("version"), pkt.get_string("language"), pkt.get_bool("in_match"),
			pkt.get_string("role"), pkt.get_string("room"), crash_log);

		// Também vai para o log do servidor: `kubectl logs` é o jeito mais rápido de ver um recado
		// chegando ao vivo, sem abrir o banco.
		if (ok) println("[feedback] " + conn.username + ": " + text);

		ack.set_bool("ok", ok);
		send_to(peer_id, ack);
	}

	// Roteamento do chat: só existe chat na lobby (waiting) e durante reunião/votação, e nesses dois
	// casos ele é aberto pra todo mundo.
	// Não existe mais chat durante a partida em andamento. O que existia era um chat por facção
	// (impostores conversando entre si), e isso entregava o jogo: quem NÃO recebia aquelas mensagens
	// sabia na hora que os outros eram impostores - e o impostor sabia quem era o parceiro sem
	// precisar descobrir. Conversa é na reunião, com todo mundo junto, que é onde ela vale.
	void on_chat_message(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		game_player@ sender = lobby.find_player(peer_id);
		if (@sender == null) return;

		if (lobby.state == "in_progress") {
			send_error(peer_id, "chat.only_in_meeting");
			return;
		}
		if (!sender.alive) { // morto só lê o chat, não manda mensagem
			send_error(peer_id, "chat.dead_cannot_send");
			return;
		}
		string text = pkt.get_string("text");
		if (text == "") return;
		if (text.length() > MAX_CHAT_LENGTH) text = text.substr(0, MAX_CHAT_LENGTH);

		net_packet@ msg = net_packet(S_CHAT_MESSAGE);
		msg.set_uint64("peer_id", peer_id);
		msg.set_string("name", sender.username);
		msg.set_string("text", text);
		broadcast_to_lobby(lobby, msg);
	}

	// Avisa a partida de que UM painel saiu do caminho, sem a sabotagem ter acabado. É o que permite
	// ao cliente não oferecer de novo um painel já resolvido.
	void broadcast_sabotage_progress(game_state@ lobby, const string&in sabotage_id,
			const string&in object_id, int fixed, int required) {
		net_packet@ pkt = net_packet(S_SABOTAGE_PROGRESS);
		pkt.set_string("sabotage_id", sabotage_id);
		pkt.set_string("object_id", object_id);
		pkt.set_int("fixed", fixed);
		pkt.set_int("required", required);
		broadcast_to_lobby(lobby, pkt);
	}

	void on_interact(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null || lobby.state != "in_progress") return;
		string object_id = pkt.get_string("object_id");

		net_packet@ event;
		int panels_fixed, panels_required;
		string fail_key;
		if (lobby.try_fix_sabotage_panel(peer_id, object_id, event, panels_fixed, panels_required, fail_key)) {
			broadcast_to_lobby(lobby, event);
		} else if (fail_key != "") {
			send_error(peer_id, fail_key);
		} else if (panels_required > 0) {
			// Painel certo, mas ainda falta consertar outro(s) - sem isso parecia que o painel "não
			// funcionava" quando na verdade só precisava de mais um conserto em outro lugar.
			dictionary@ p = dictionary();
			p.set("fixed", "" + panels_fixed);
			p.set("required", "" + panels_required);
			send_error(peer_id, "sabotage.panel_progress", p);
			// E a partida inteira fica sabendo QUAL painel saiu do caminho: é o que impede outra
			// pessoa de atravessar a nave para resolver um painel que já está resolvido.
			broadcast_sabotage_progress(lobby, lobby.active_sabotage, object_id, panels_fixed, panels_required);
		}
	}

	// --- Tick geral ---

	void tick_lobbies(float delta) {
		// De trás pra frente porque uma lobby pode sair da lista aqui dentro (ver o fim da partida
		// logo abaixo) - percorrer de frente pulando índices é o jeito clássico de deixar uma lobby
		// sem tick por um quadro.
		for (int i = int(lobbies.length()) - 1; i >= 0; i--) {
			game_state@ lobby = lobbies[i];
			if (lobby.state == "waiting" || lobby.state == "ended") continue;
			array<net_packet@>@ events = lobby.tick(delta);
			for (uint e = 0; e < events.length(); e++) {
				// Movimento (hoje só de bot) vai pelo canal não confiável, igual o dos jogadores de
				// verdade: chega muitas vezes por segundo e perder um pacote não custa nada.
				bool reliable = events[e].type != S_PLAYER_MOVED;
				broadcast_to_lobby(lobby, events[e], 0, reliable);
			}
			// A partida acabou (o S_GAME_OVER acabou de sair): a sala REABRE para a mesma turma.
			if (lobby.state == "ended") reopen_lobby(i);
		}
	}

	// Fim de partida: a sala volta ao estado de espera com a mesma gente dentro, em vez de sumir.
	//
	// Era assim que terminava antes: a sala fechava e todo mundo caía no navegador de partidas,
	// obrigando o grupo a se reorganizar a cada rodada - combinar de novo quem cria, achar a sala,
	// redigitar o código da partida privada. Manter a sala é o comportamento do jogo original.
	//
	// O que NÃO pode sobreviver à partida está em reopen_for_next_match(); o que não pode sobreviver
	// no JOGADOR está em reset_match_state(). Quem saiu no meio só existia como registro para a
	// contagem de vivos não quebrar (ver remove_from_lobby) - esse registro sai daqui, senão a sala
	// de espera listaria gente que foi embora e a próxima partida contaria com ela.
	void reopen_lobby(int index) {
		game_state@ lobby = lobbies[index];
		for (int i = int(lobby.players.length()) - 1; i >= 0; i--) {
			if (lobby.players[i].left_match) lobby.players.remove_at(i);
		}
		// Sobrou só bot (ou ninguém): não há para quem reabrir, e uma sala assim ficaria para sempre
		// na lista sem nunca começar nada - bot não aperta Enter.
		if (lobby.human_count() == 0) { close_lobby(index); return; }
		lobby.reopen_for_next_match();
		// O anfitrião pode ter caído no meio da partida: sem isto a sala reabriria sem ninguém que
		// possa iniciar a próxima.
		if (@lobby.find_player(lobby.host_peer_id) == null) {
			for (uint i = 0; i < lobby.players.length(); i++) {
				if (lobby.players[i].is_bot) continue; // bot não pode ser anfitrião
				lobby.host_peer_id = lobby.players[i].peer_id;
				break;
			}
		}
		// Logo depois do S_GAME_OVER, e é por este retrato que o cliente sabe que a sala continua de
		// pé (e quem é o anfitrião agora) - ver run_game em game/game_loop.nvgt.
		send_lobby_state(lobby, 0);
	}

	// Encerra e apaga a lobby de índice `index`. Hoje só quando não sobrou ninguém para reabrir.
	//
	// A lobby não sobrevive à partida de propósito. Todo cliente volta pro navegador de partidas
	// quando a tela de fim de jogo fecha (ver AmongUs.nvgt), então uma lobby que continuasse de pé
	// seria uma sala sem ninguém dentro que ainda acha que tem gente: os jogadores continuariam
	// marcados como membros dela, entrariam numa segunda lobby estando em duas ao mesmo tempo, e os
	// pacotes iriam pro lugar errado. Fechar aqui é o que garante que a partida seguinte começa do
	// zero, sem herança nenhuma.
	void close_lobby(int index) {
		game_state@ lobby = lobbies[index];
		// Os game_player são objetos de CONEXÃO e continuam vivos depois da lobby - limpar o estado
		// de partida deles é o que impede a próxima sala de herdar morte, papel e tasks da anterior.
		lobby.reset_players_after_match();
		for (uint i = 0; i < lobby.players.length(); i++) {
			game_player@ conn = find_connection(lobby.players[i].peer_id);
			if (@conn == null) continue; // bot: some junto com a lobby
			// Só solta quem AINDA está nesta lobby. Quem saiu no meio da partida já pode estar em
			// outra sala a esta altura, e limpar o lobby_id dele aqui o expulsaria de lá.
			if (conn.lobby_id == lobby.lobby_id) conn.lobby_id = "";
		}
		lobbies.remove_at(index);
		send_hall_state(); // quem estava nela voltou ao saguão
	}
}
