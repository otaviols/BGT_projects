// server_accounts.nvgt
// Contas: cadastro, login (com senha ou token de sessão), sair, apagar conta, cor preferida e estatísticas.
//
// Parte do game_server (src/network/server.nvgt), como `mixin class`: o AngelScript não tem classe
// parcial, e o mixin é o jeito de a mesma classe morar em vários arquivos. Os métodos daqui enxergam
// os campos e os métodos de todas as outras partes, e não compilam sozinhos - quem inclui é o server.nvgt.

mixin class server_accounts_part {
	void on_login(uint64 peer_id, net_packet@ pkt) {
		string username = pkt.get_string("username");
		string password = pkt.get_string("password");
		string token = pkt.get_string("token");
		net_packet@ result = net_packet(S_LOGIN_RESULT);

		// O corte por protocolo vem ANTES de conferir a senha: a resposta é a mesma S_LOGIN_RESULT que
		// todo cliente já entende, só que com o motivo certo. Recusar aqui, e não na conexão, é o que
		// deixa o cliente ouvir o porquê - na conexão ele só veria a rede cair.
		int protocol = pkt.get_int("protocol", 0);
		if (protocol < MIN_PROTOCOL_VERSION) {
			result.set_bool("ok", false);
			result.set_string("message", "login.update_required");
			send_to(peer_id, result);
			println("[login] protocolo " + protocol + " recusado (minimo " + MIN_PROTOCOL_VERSION + ")");
			return;
		}

		// O token de VOLTA (ver server_rejoin.nvgt): o cliente voltando sozinho depois de cair, sem senha.
		// Só serve para isso - um token que não é de um lugar guardado (nem de uma conexão que ainda vai
		// cair) é recusado, e o cliente desiste de voltar.
		string rejoin_token = pkt.get_string("rejoin_token");
		bool ok;
		if (rejoin_token != "") {
			username = account_of_rejoin_token(rejoin_token);
			ok = username != "";
		} else if (token != "") {
			username = g_user_db.session_user(token);
			ok = username != "";
		} else {
			ok = g_user_db.verify_login(username, password);
		}
		game_player@ conn = ok ? find_connection(peer_id) : null;
		if (ok && @conn != null) {
			conn.username = username;
			conn.authenticated = true;
			conn.protocol_version = protocol;
			// Só um nome da lista: o texto vem da máquina do jogador e vira linha no banco.
			string plataforma = pkt.get_string("platform", "unknown");
			if (CLIENT_PLATFORMS.find(plataforma) < 0) plataforma = "unknown";
			conn.client_platform = plataforma;
			g_user_db.record_client_login(username, plataforma, safe_client_version(pkt.get_string("version", "")));
			if (protocol >= REJOIN_PROTOCOL) conn.rejoin_token = string_base64_encode(random_bytes(24));
		}
		// A sessão velha sai ANTES de procurar o lugar guardado: quando o cliente percebe a queda antes do
		// servidor, é derrubando a conexão velha aqui que o lugar fica guardado (try_hold) - a tempo da
		// volta, logo abaixo, encontrá-lo. E antes do retrato do saguão: o mesmo nome apareceria duas vezes.
		if (ok) drop_other_sessions(peer_id, username);
		game_player@ guardado = null;
		if (ok && @conn != null && protocol >= REJOIN_PROTOCOL) @guardado = find_held(username);
		if (@guardado != null) rejoin_held(conn, guardado);

		if (ok) {
			result.set_bool("ok", true);
			result.set_string("message", "login.success");
			result.set_string("username", username);
			// O e-mail da conta, para a tela de configurações dizer qual é (ou que não há).
			result.set_string("email", g_user_db.get_email(username));
			result.set_bool("stats_visible", g_user_db.stats_visible(username));
			// Pediu para lembrar: sai um token novo; o cliente guarda o token, nunca a senha.
			if (token == "" && rejoin_token == "" && pkt.get_bool("remember")) result.set_string("session_token", g_user_db.create_session(username));
			// O cliente não tem como descobrir sozinho com que id o servidor o identifica (o id que
			// o ENet dele devolve é só um handle local) - sem isso ele compara maçã com laranja em
			// todo peer_id que chega e às vezes "acerta" o de outro jogador (ver game_client). Quem VOLTOU
			// recebe o id antigo, o da partida.
			result.set_uint64("peer_id", @guardado != null ? guardado.peer_id : peer_id);
			if (@conn != null && conn.rejoin_token != "") result.set_string("rejoin_token", conn.rejoin_token);
			result.set_bool("rejoin", @guardado != null);
		} else {
			result.set_bool("ok", false);
			result.set_string("message", rejoin_token != "" ? "login.rejoin_failed" : "login.invalid_credentials");
		}
		send_to(peer_id, result);
		if (@guardado != null) {
			game_state@ sala = find_lobby(guardado.lobby_id);
			if (@sala != null) send_rejoin_state(sala, guardado);
		}
		// Depois de responder, e não antes: assim quem acabou de entrar já se vê na lista.
		if (ok) send_hall_state();
	}

	// Uma conta, uma sessão: entrar de novo DERRUBA a anterior.
	//
	// A alternativa - recusar a entrada nova - parece mais educada e é pior na prática: uma conexão
	// que caiu feio (queda de luz, cabo arrancado, jogo fechado no braço) continua de pé para o
	// servidor até o ENet desistir dela, e nesse meio-tempo a pessoa não conseguiria voltar ao
	// próprio jogo. Derrubando, reconectar simplesmente funciona - e quem empresta a conta descobre
	// na hora que duas pessoas não cabem nela.
	//
	// `softly` porque o ENet entrega o que está na fila antes de desligar: assim o aviso do porquê
	// chega a quem foi derrubado, em vez de ele só ver a conexão cair sem explicação.
	void drop_other_sessions(uint64 keep_peer_id, const string&in username) {
		for (int i = int(connections.length()) - 1; i >= 0; i--) {
			game_player@ other = connections[i];
			if (other.peer_id == keep_peer_id || !other.authenticated || other.username != username) continue;
			send_error(other.peer_id, "login.session_replaced");
			drop_net_peer(other.peer_id); // e ignora o desligamento atrasado dela (ver server_rejoin.nvgt)
			// A limpeza é feita AQUI, e não deixada para o evento de desconexão: o peer já saiu do
			// mapa da rede, e sem isto a sessão velha continuaria pendurada na sala (contando como
			// jogador, recebendo pacotes que ninguém lê) até o ENet avisar.
			on_disconnect(other.peer_id, "sessao substituida (a conta entrou em outro lugar)");
		}
	}

	void on_logout(uint64 peer_id, net_packet@ pkt) {
		g_user_db.delete_session(pkt.get_string("token"));
	}

	// Apaga a conta de quem está conectado. Só do saguão (fora de sala): apagar no meio de uma sala
	// deixaria um jogador sem conta dentro dela. Confere a SENHA de novo (ver C_DELETE_ACCOUNT).
	//
	// Depois de apagar, a conexão deixa de estar autenticada e toda outra sessão da conta cai - um
	// segundo computador logado continuaria "dentro" de uma conta que não existe mais.
	void on_delete_account(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		net_packet@ result = net_packet(S_DELETE_ACCOUNT_RESULT);
		string fail = "";
		if (@conn == null || !conn.authenticated) fail = "account.delete_not_logged_in";
		else if (conn.lobby_id != "") fail = "account.delete_in_lobby";
		else if (!g_user_db.verify_login(conn.username, pkt.get_string("password"))) fail = "account.delete_wrong_password";
		string username = @conn != null ? conn.username : "";
		if (fail == "" && !g_user_db.delete_account(username)) fail = "account.delete_failed";
		result.set_bool("ok", fail == "");
		result.set_string("message", fail == "" ? "account.deleted" : fail);
		send_to(peer_id, result);
		if (fail != "") return;

		println("[conta] apagada: " + username);
		drop_other_sessions(peer_id, username);
		conn.authenticated = false;
		conn.username = "";
		send_hall_state(); // saiu da lista de quem está online
	}

	// Troca a senha de quem está conectado (recado #239). Confere a ATUAL de novo, como o apagar conta: o
	// token lembrado num computador emprestado não pode bastar. Só do saguão, pelo mesmo motivo de lá - é
	// onde a tela existe, e uma partida não é hora de mexer em conta.
	//
	// Trocou: todas as sessões lembradas caem (change_password) e as outras conexões da conta também -
	// quem troca a senha está, quase sempre, expulsando alguém. Se o pedido diz que este computador
	// lembrava a conta, ele recebe um token novo, senão o próximo início pediria a senha sem explicar.
	void on_change_password(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		net_packet@ result = net_packet(S_CHANGE_PASSWORD_RESULT);
		string fail = "";
		if (@conn == null || !conn.authenticated) fail = "account.delete_not_logged_in";
		else if (conn.lobby_id != "") fail = "account.password_in_lobby";
		else if (!g_user_db.verify_login(conn.username, pkt.get_string("password"))) fail = "account.password_wrong_current";
		if (fail == "") fail = g_user_db.change_password(conn.username, pkt.get_string("new_password"));
		result.set_bool("ok", fail == "");
		result.set_string("message", fail == "" ? "account.password_changed" : fail);
		if (fail == "" && pkt.get_bool("remember")) result.set_string("session_token", g_user_db.create_session(conn.username));
		send_to(peer_id, result);
		if (fail != "") return;
		println("[conta] senha trocada: " + conn.username);
		drop_other_sessions(peer_id, conn.username);
	}

	// A cor que o jogador quer, escolhida na sala de espera (tecla E). Só da sala, e só antes da
	// partida: a cor da partida é decidida no início. Quem chegou primeiro fica com a cor - a unicidade
	// é garantida AQUI, na hora da escolha, para o início da partida não ter conflito a resolver e a
	// pessoa saber na hora que precisa escolher outra. A resposta é o retrato da sala de sempre.
	void on_choose_color(uint64 peer_id, net_packet@ pkt) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		game_player@ p = find_connection(peer_id);
		if (@lobby == null || @p == null || lobby.state != "waiting") return;
		int cor = pkt.get_int("color", -1);
		if (cor < -1 || cor >= int(COLOR_COUNT)) return; // vem da máquina do jogador
		if (cor >= 0) {
			for (uint i = 0; i < lobby.players.length(); i++) {
				game_player@ outro = lobby.players[i];
				if (outro.peer_id == peer_id || outro.chosen_color != cor) continue;
				dictionary@ params = dictionary();
				params.set("color", color_mark(cor));
				params.set("name", outro.username);
				send_error(peer_id, "lobby.color_taken", params);
				return;
			}
		}
		p.chosen_color = cor;
		send_lobby_state(lobby, 0);
	}

	void on_get_stats(uint64 peer_id) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || !conn.authenticated) return;
		user_stats@ s = g_user_db.get_stats(conn.username);
		net_packet@ r = net_packet(S_STATS);
		r.set_int("games_played", s.games_played);
		r.set_int("games_won", s.games_won);
		r.set_int("crewmate_wins", s.crewmate_wins);
		r.set_int("impostor_wins", s.impostor_wins);
		r.set_int("neutral_wins", s.neutral_wins);
		r.set_int("tasks_completed", s.tasks_completed);
		r.set_int("kills", s.kills);
		// A posição no ranking (0 = fora dele), e por que pode estar fora: escondido, ou poucas partidas.
		r.set_bool("visible", g_user_db.stats_visible(conn.username));
		r.set_int("rank", ranking_position(g_user_db.ranking(), conn.username));
		r.set_int("rank_min_games", RANKING_MIN_GAMES);
		// Por time (só o clássico, como os rankings) e por modo - ver RANKING_KINDS.
		// Contadores por posição em RANKING_KINDS, e não num dictionary: a primeira versão somava num
		// dictionary (get num `int`, set da soma) e devolveu lixo - 731 partidas numa conta com uma. A causa
		// exata não foi isolada; arrays de int não têm o que dar errado.
		array<match_split@>@ cortes = g_user_db.match_breakdown(conn.username);
		array<int> jogos(RANKING_KINDS.length(), 0);
		array<int> vitorias(RANKING_KINDS.length(), 0);
		for (uint i = 0; i < cortes.length(); i++) {
			array<string> chaves = {"mode_" + cortes[i].mode};
			if (cortes[i].mode == GAME_MODE_CLASSIC) chaves.insert_last("team_" + cortes[i].team);
			for (uint k = 0; k < chaves.length(); k++) {
				int at = RANKING_KINDS.find(chaves[k]);
				if (at < 0) continue;
				jogos[at] += cortes[i].games;
				vitorias[at] += cortes[i].wins;
			}
		}
		json_array@ por = json_array();
		for (uint i = 0; i < RANKING_KINDS.length(); i++) {
			if (jogos[i] == 0) continue;
			json_object@ e = json_object();
			e.set("kind", RANKING_KINDS[i]);
			e.set("games", jogos[i]);
			e.set("wins", vitorias[i]);
			por.add(e);
		}
		r.set_array("splits", por);
		send_to(peer_id, r);
	}

	int ranking_position(array<ranking_entry@>@ lista, const string&in username) {
		for (uint i = 0; i < lista.length(); i++) if (lista[i].username == username) return int(i) + 1;
		return 0;
	}

	void on_get_ranking(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || !conn.authenticated) return;
		string tipo = pkt.get_string("kind", "general");
		if (RANKING_KINDS.find(tipo) < 0) tipo = "general";
		array<ranking_entry@>@ lista = g_user_db.ranking(tipo);
		net_packet@ r = net_packet(S_RANKING);
		r.set_string("kind", tipo);
		json_array@ primeiros = json_array();
		for (uint i = 0; i < lista.length() && int(i) < RANKING_TOP; i++) {
			json_object@ e = json_object();
			e.set("name", lista[i].username);
			e.set("games", lista[i].games);
			e.set("wins", lista[i].wins);
			primeiros.add(e);
		}
		r.set_array("entries", primeiros);
		r.set_int("my_rank", ranking_position(lista, conn.username));
		r.set_int("min_games", tipo == "general" ? RANKING_MIN_GAMES : RANKING_MIN_GAMES_SPLIT);
		send_to(peer_id, r);
	}

	// Quem está na sala, com o resumo de quem deixa mostrar. Só partidas, vitórias, o lado em que mais
	// vence e a posição: assassinatos e tarefas ficam só para o dono - "matou trezentos" seria um rótulo
	// de impostor antes de a partida começar.
	void on_get_room_stats(uint64 peer_id) {
		game_state@ lobby = find_lobby_of_peer(peer_id);
		if (@lobby == null) return;
		array<ranking_entry@>@ lista = g_user_db.ranking();
		net_packet@ r = net_packet(S_ROOM_STATS);
		json_array@ quem = json_array();
		for (uint i = 0; i < lobby.players.length(); i++) {
			game_player@ p = lobby.players[i];
			json_object@ e = json_object();
			e.set("name", p.username);
			e.set("bot", p.is_bot);
			bool visivel = !p.is_bot && g_user_db.stats_visible(p.username);
			e.set("visible", visivel);
			if (visivel) {
				user_stats@ s = g_user_db.get_stats(p.username);
				e.set("games", s.games_played);
				e.set("wins", s.games_won);
				string melhor = "";
				int mais = 0;
				if (s.crewmate_wins > mais) { mais = s.crewmate_wins; melhor = "crew"; }
				if (s.impostor_wins > mais) { mais = s.impostor_wins; melhor = "impostor"; }
				if (s.neutral_wins > mais) { mais = s.neutral_wins; melhor = "neutral"; }
				e.set("best", melhor);
				e.set("rank", ranking_position(lista, p.username));
			}
			quem.add(e);
		}
		r.set_array("players", quem);
		send_to(peer_id, r);
	}

	void on_set_stats_visible(uint64 peer_id, net_packet@ pkt) {
		game_player@ conn = find_connection(peer_id);
		if (@conn == null || !conn.authenticated) return;
		g_user_db.set_stats_visible(conn.username, pkt.get_bool("visible"));
	}

	// Estatísticas da partida que acabou, para cada PESSOA (bot não tem conta). Mora aqui, e não no
	// game_state, porque o banco é do servidor - o game_state roda também nas sondas, sem banco.
	//
	// Quem venceu sai do vencedor da partida e do PAPEL: "crewmates" vence quem joga com a tripulação
	// (wins_with_crew), "impostors" o time impostor, e o neutro só quando é ele o vencedor sozinho.
	// Quem saiu no meio conta a partida, mas não a vitória - não estava lá quando ela aconteceu.
	void record_match_stats(game_state@ lobby) {
		g_user_db.begin_batch(); // uma transação para a partida inteira (ver begin_batch)
		record_match_counters(lobby);
		for (uint i = 0; i < lobby.players.length(); i++) {
			game_player@ p = lobby.players[i];
			if (p.is_bot || p.username == "") continue;
			g_user_db.increment_stat(p.username, "games_played", 1);
			role_traits@ r = p.role();
			// Quem saiu no meio também ganha a linha, como derrota: é uma partida jogada, como no games_played.
			if (p.left_match) { g_user_db.record_match_result(p.username, lobby.config.game_mode, r.team, false); continue; }
			string coluna = "";
			if (lobby.winner == "crewmates" && r.wins_with_crew) coluna = "crewmate_wins";
			else if (lobby.winner == "impostors" && r.team == TEAM_IMPOSTOR) coluna = "impostor_wins";
			else if (lobby.winner == WINNER_NEUTRAL && p.peer_id == lobby.neutral_winner_peer) coluna = "neutral_wins";
			else if (lobby.winner == WINNER_LOVERS && p.lover != 0 && p.alive) coluna = "neutral_wins";
			// A linha do match_results vai para toda partida, vencida ou não (é dela que sai o aproveitamento).
			g_user_db.record_match_result(p.username, lobby.config.game_mode, r.team, coluna != "");
			if (coluna == "") continue;
			g_user_db.increment_stat(p.username, "games_won", 1);
			g_user_db.increment_stat(p.username, coluna, 1);
		}
		g_user_db.end_batch();
	}

	// Tarefas e mortes da partida, contadas na memória (match_tasks_done, match_kills) e gravadas aqui.
	// Também quando a sala fecha no meio da partida (close_lobby): antes elas iam ao banco na hora, e uma
	// partida abandonada não pode apagar o que a pessoa fez nela. Zera depois de gravar, para nenhum
	// caminho gravar duas vezes.
	void record_match_counters(game_state@ lobby) {
		for (uint i = 0; i < lobby.players.length(); i++) {
			game_player@ p = lobby.players[i];
			if (p.is_bot || p.username == "") continue;
			if (p.match_tasks_done > 0) g_user_db.increment_stat(p.username, "tasks_completed", int(p.match_tasks_done));
			if (p.match_kills > 0) g_user_db.increment_stat(p.username, "kills", int(p.match_kills));
			p.match_tasks_done = 0;
			p.match_kills = 0;
		}
	}

	void on_register(uint64 peer_id, net_packet@ pkt) {
		string username = pkt.get_string("username");
		string password = pkt.get_string("password");
		// Com e-mail, a conta só nasce quando o código chegar (ver server_email.nvgt).
		string email = pkt.get_string("email").trim_whitespace();
		if (email != "") { register_with_email(peer_id, username, password, email, pkt.get_string("language")); return; }
		// No lançamento o e-mail é obrigatório (email.json, "required"); nos testes, não.
		if (g_email.required) {
			net_packet@ recusa = net_packet(S_REGISTER_RESULT);
			recusa.set_bool("ok", false);
			recusa.set_bool("email_required", true);
			recusa.set_string("message", "email.required");
			send_to(peer_id, recusa);
			return;
		}
		string err;
		bool ok = g_user_db.create_user(username, password, err);

		net_packet@ result = net_packet(S_REGISTER_RESULT);
		result.set_bool("ok", ok);
		result.set_string("message", ok ? "login.register_success" : ("login." + err));
		send_to(peer_id, result);
	}
}
