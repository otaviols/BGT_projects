// protocol.nvgt
// Definição de todos os tipos de mensagem trocados entre cliente e servidor.
// O payload de cada pacote é um json_object (ver packet.nvgt) serializado como string.
// Canais: 0 = confiável (estado de jogo, eventos), 1 = não confiável (posição/movimento).

// tr() vem daqui (tr_server_message, no fim do arquivo). Declarado pelo mesmo motivo de sempre:
// compilar por ordem de inclusão é compilar por sorte.
#include "../i18n.nvgt"

const uint8 CHANNEL_RELIABLE = 0;
const uint8 CHANNEL_UNRELIABLE = 1;
// Voz. É o ÚNICO canal que não carrega JSON: um quadro de voz são 320 bytes de áudio a cada 20 ms,
// e embrulhá-lo em JSON (base64 + chaves) custaria um terço a mais de banda para nada. O que viaja
// aqui é binário puro - ver voice_wire()/voice_unwire() abaixo. Cliente antigo que receba isto tenta
// ler como JSON, falha e descarta em silêncio (packet_from_wire devolve null), então o canal novo
// não derruba ninguém.
const uint8 CHANNEL_VOICE = 2;

// Cliente -> servidor no canal de voz: só o áudio (mu-law, 16 kHz, mono). Quem fala é o peer da
// conexão, então nada precisa ir no pacote. Servidor -> cliente: o peer de quem falou na frente,
// porque quem ouve precisa posicionar cada voz no ponto de quem falou.
// Formato: 1 byte com o tamanho do cabeçalho, o peer_id em decimal, e o áudio.
string voice_wire(uint64 talker_peer, const string&in audio) {
	string head = "" + talker_peer;
	return ascii_to_character(head.length()) + head + audio;
}
// Devolve false se o pacote não tiver a forma esperada.
bool voice_unwire(const string&in wire, uint64&out talker_peer, string&out audio) {
	talker_peer = 0;
	audio = "";
	if (wire.length() < 2) return false;
	uint head_len = uint(character_to_ascii(wire.substr(0, 1)));
	if (head_len == 0 || wire.length() < 1 + head_len) return false;
	talker_peer = parse_int(wire.substr(1, head_len));
	audio = wire.substr(1 + head_len);
	return talker_peer != 0 && audio.length() > 0;
}
// Maior quadro aceito: 200 ms de áudio. O cliente manda 20 ms por vez (ou o que acumulou enquanto
// uma tela bloqueante prendeu o laço); mais que isto é lixo ou abuso.
const uint VOICE_MAX_FRAME_BYTES = 3200;
// A voz alcança menos que o passo: dá para ouvir alguém na mesma sala, não do outro lado da nave.
// Quem está dentro do alcance é decidido pelo SERVIDOR (ver game_state.can_hear_voice), e o cliente
// só atenua pela distância o que recebeu.
const float VOICE_RANGE = 8.0;

// Cliente -> Servidor
// Duas formas: {username, password, remember} ou {token} - o token veio de um login anterior com
// remember=true (S_LOGIN_RESULT.session_token) e é o que "lembrar de mim" guarda em disco: a senha
// nunca fica no computador do jogador.
const string C_LOGIN = "c_login";                 // {username, password, remember} | {token}
const string C_LOGOUT = "c_logout";               // {token} - esquece este computador
// Apaga a conta de quem está logado. Pede a SENHA mesmo para quem entrou por token: o token lembrado
// num computador emprestado não pode bastar para apagar uma conta.
const string C_DELETE_ACCOUNT = "c_delete_account"; // {password}
// A cor que o jogador quer na sala de espera (-1 = sem preferência, sortear). Só vale quando a sala
// deixa escolher (lobby_config.color_choice); fora disso fica guardada e não é usada. A resposta é o
// S_LOBBY_STATE de sempre, e S_ERROR "lobby.color_taken" se outra pessoa da sala já a escolheu.
const string C_CHOOSE_COLOR = "c_choose_color"; // {color}
// As estatísticas da própria conta (tela "Minhas estatísticas" na lista de partidas).
const string C_GET_STATS = "c_get_stats";         // {}
const string S_STATS = "s_stats";                 // {games_played, games_won, crewmate_wins, impostor_wins, neutral_wins, tasks_completed, kills}
const string C_REGISTER = "c_register";           // {username, password}
const string C_LIST_LOBBIES = "c_list_lobbies";   // {}
// join_code (opcional) torna a partida PRIVADA: ela some da lista e só entra quem souber o código.
// Foi o pedido mais repetido do beta - jogar só com os amigos, como no jogo original.
const string C_CREATE_LOBBY = "c_create_lobby";   // {lobby_name, preset, join_code, ...overrides} (-1 = usa o preset)
// Duas formas de entrar: por lobby_id (escolhida na lista) ou, com lobby_id vazio, por join_code -
// a partida privada não está na lista, então o código é a única porta.
const string C_JOIN_LOBBY = "c_join_lobby";       // {lobby_id} ou {join_code}
const string C_LEAVE_LOBBY = "c_leave_lobby";     // {}
// O anfitrião muda as regras com a sala aberta. Só na espera, só o anfitrião; o que vem em branco
// (-1/"") mantém o valor atual. A resposta é um S_LOBBY_STATE novo para toda a sala.
const string C_UPDATE_LOBBY_CONFIG = "c_update_lobby_config"; // {...overrides}
const string C_START_GAME = "c_start_game";       // {} (só host)
const string C_ADD_BOT = "c_add_bot";             // {} (só host, só na sala de espera)
const string C_REMOVE_BOT = "c_remove_bot";       // {} (só host, tira o último bot adicionado)
const string C_MOVE = "c_move";                   // {x, y, seq}
const string C_INTERACT = "c_interact";           // {object_id}
const string C_START_TASK = "c_start_task";       // {task_id} - abriu a minigame; no scan, é o que faz o servidor avisar quem está perto
const string C_TASK_INPUT = "c_task_input";       // {task_id, input}
const string C_KILL = "c_kill";                   // {target_peer}
const string C_REPORT_BODY = "c_report_body";     // {body_id}
const string C_CALL_MEETING = "c_call_meeting";   // {}
const string C_CAST_VOTE = "c_cast_vote";         // {target_peer}  (target_peer = -1 para pular)
const string C_USE_VENT = "c_use_vent";           // {vent_id} - entrar num vent perto (só quando não vented)
const string C_VENT_TRAVEL = "c_vent_travel";     // {target_vent_id} - "" = sair, senão viaja pra outro vent da rede (só quando já vented)
const string C_RADAR_SCAN = "c_radar_scan";       // {direction} (1 = próximo, -1 = anterior)
// Radar TRAVADO num alvo: o cliente repete esta pergunta a cada meio segundo e só bipa. Quem decide
// se o alvo ainda pode ser percebido (mesma sala, vivo, fora de duto, luzes) é o servidor, pela mesma
// regra do radar normal - travar no cliente, com as posições que ele já tem, continuaria bipando em
// cima do duto onde alguém acabou de sumir.
const string C_RADAR_TRACK = "c_radar_track";     // {peer_id}
const string C_TRIGGER_SABOTAGE = "c_trigger_sabotage"; // {sabotage_id} ("lights" | "oxygen" | "comms"), só impostor
const string C_CLOSE_DOORS = "c_close_doors";     // {room_id} - tranca aquela sala, só impostor (vivo ou morto)
const string C_PING = "c_ping";                   // {} - servidor responde na hora com S_PONG
const string C_CHAT_MESSAGE = "c_chat_message";   // {text}
// O jogador avisa se quer RECEBER voz. Sem isto o servidor mandaria 128 kbps de áudio para quem
// desligou o chat de voz nas configurações (ou joga numa versão que nem o conhece).
const string C_VOICE_STATE = "c_voice_state";     // {enabled}
// Saguão: quem está conectado e FORA de qualquer sala (o menu de partidas). Existe para o grupo
// conseguir se combinar antes de alguém criar a sala - até aqui, quem chegava ao servidor não tinha
// como saber se havia mais alguém online, nem como falar com quem estivesse.
const string C_HALL_CHAT = "c_hall_chat";         // {text}
// Câmeras de segurança. Um jogador de cada vez, e é o servidor que arbitra: dois pedindo ao mesmo
// tempo precisam de um árbitro só, e o cliente não tem como saber que outro já entrou.
const string C_CAMERA_ENTER = "c_camera_enter";   // {} - pedir o posto de câmeras
const string C_CAMERA_LEAVE = "c_camera_leave";   // {}
const string C_CAMERA_SWITCH = "c_camera_switch"; // {room_id} - apontar para outra sala
// Quem está na sala observada. É PERGUNTADO ao servidor, e não montado pelo cliente com as posições
// que ele já recebe, porque quem está dentro de um duto não pode aparecer - e só o servidor sabe
// disso. Contar essa pessoa entregava justamente a dedução que o duto existe para esconder; mandar o
// estado de duto para todos os clientes resolveria o sintoma criando um vazamento pior.
const string C_CAMERA_SCAN = "c_camera_scan";     // {} - quem está na sala que estou observando
// Habilidade ativa do papel (ver game/roles/role_traits.nvgt). Um pacote só para todas: o servidor
// confere se o papel do jogador TEM aquela habilidade e se ela está fora de recarga, e cada papel
// novo acrescenta um caso ao despacho, não um pacote ao protocolo. target_peer_id/object_id são
// opcionais, conforme a habilidade.
const string C_USE_ABILITY = "c_use_ability";     // {ability, target_peer_id?, object_id?, role_id?}

// Recado do jogador para quem faz o jogo. Vai pelo MESMO canal do resto: a sessão já está
// autenticada, então o servidor sabe de quem veio sem o jogador digitar nada, e nenhum endereço ou
// senha de serviço externo precisa viajar dentro do jogo distribuído.
// {text, version, language, in_match, role, room, crash_log}
const string C_SEND_FEEDBACK = "c_send_feedback";
// As respostas aos recados. O jogador pede as que ainda não ouviu (ao chegar na lista de partidas)
// e avisa quando ouviu uma. Ficam no mesmo canal do recado: quem mandou um recado recebe a resposta
// na próxima vez que abrir o jogo, sem precisar de email nem de nada fora dele.
const string C_FEEDBACK_REPLIES_GET = "c_feedback_replies_get";   // {}
const string C_FEEDBACK_REPLY_READ = "c_feedback_reply_read";     // {reply_id}
// Administração: quem faz o jogo responde a um recado. Protegido por um token que mora no servidor
// (variável de ambiente, vinda de um segredo do cluster) e NUNCA dentro do jogo distribuído - o
// cliente do jogador não conhece este pacote nem tem como montá-lo com um token válido.
const string C_ADMIN_REPLY = "c_admin_reply";                     // {token, feedback_id, text}
// Traduções feitas por jogadores. O tradutor já tem o arquivo (é o lang/<código>.json com que ele
// joga); o envio o leva ao servidor, autenticado. Quem decide se entra no jogo é quem faz o jogo,
// depois - o arquivo vai para o repositório de traduções e volta com a versão seguinte. O servidor
// guarda só o ÚLTIMO envio de cada pessoa por idioma: reenviar substitui, nada acumula.
const string C_SEND_TRANSLATION = "c_send_translation";           // {code, content}
// Administração (mesmo token do C_ADMIN_REPLY): lista o que foi enviado e apaga o que já foi
// recolhido, para o banco do servidor não guardar tradução para sempre.
const string C_ADMIN_LIST_TRANSLATIONS = "c_admin_list_translations";   // {token}
const string C_ADMIN_DELETE_TRANSLATION = "c_admin_delete_translation"; // {token, username, code}
// Reinício anunciado. O servidor guarda as partidas na memória: reiniciar no meio de uma derruba
// todo mundo. O deploy então AVISA com antecedência (todo jogador conectado ouve "o servidor vai
// reiniciar em N minutos"), proíbe partidas novas de começar, e espera as que estão rolando
// acabarem - ou o prazo - antes de trocar o servidor. Ver infra/deploy.ps1.
// Arquiva recados ja tratados: um por id, ou TODOS ate um id (until). Nao apaga - ver
// resolve_feedback em database/user_db.nvgt.
const string C_ADMIN_RESOLVE_FEEDBACK = "c_admin_resolve_feedback"; // {token, feedback_id, until, undo}
const string C_ADMIN_DRAIN = "c_admin_drain";     // {token, seconds}
const string C_ADMIN_STATUS = "c_admin_status";   // {token}
const string C_ADMIN_PLATFORMS = "c_admin_platforms"; // {token, days}
// Recado fixo do saguão. Texto VAZIO apaga. Existe para avisar os jogadores de algo (uma versão
// nova no site, uma manutenção) sem publicar uma versão do jogo só por causa do aviso.
const string C_ADMIN_SET_NOTICE = "c_admin_set_notice"; // {token, text}

// Servidor -> Cliente
const string S_LOGIN_RESULT = "s_login_result";           // {ok, message, username, peer_id, session_token?} - peer_id = como o SERVIDOR me identifica
const string S_REGISTER_RESULT = "s_register_result";     // {ok, message}
const string S_LOBBY_LIST = "s_lobby_list";               // {lobbies: [{id, name, current, max, config, host, in_progress}]} - in_progress só a partir do protocolo 9
const string S_LOBBY_STATE = "s_lobby_state";             // {lobby_id, players: [...], config}
const string S_JOIN_RESULT = "s_join_result";             // {ok, message}
const string S_GAME_START = "s_game_start";                // {map_name, your_role, your_color, your_peer_id, players, tasks, kill_cooldown_seconds, impostor_count, impostor_partners: [{peer_id, name}] (só pra impostor)}
const string S_PLAYER_MOVED = "s_player_moved";           // {peer_id, x, y, seq}
// Só para um jogador: quem está perceptível à volta dele (vivo, fora de duto, visível, fora da barriga
// do lobo), dentro de PERCEPTION_SET_RANGE. Mandado quando a lista MUDA. O elenco do cliente guarda o
// último ponto de todo mundo, e quem some sem andar (entrou no duto, foi engolido, ficou invisível)
// continuava "parado" lá - anunciado a quem passasse e mirado pela tecla de matar. Ver nearest_alive.
const string S_NEARBY_PLAYERS = "s_nearby_players";       // {peers: [peer_id...]}
const string S_PLAYER_JOINED = "s_player_joined";         // {peer_id, name, color}
const string S_PLAYER_LEFT = "s_player_left";             // {peer_id}
const string S_TASK_RESULT = "s_task_result";             // {task_id, ok, progress}
const string S_TASK_ASSIGNED = "s_task_assigned";         // {tasks: [...]}
// Task VISÍVEL (hoje só o scan da enfermaria): o servidor conferiu que o jogador tem a task e avisa a
// partida - o som do scanner toca no ponto da task para quem está perto, e é a prova de que quem
// está lá é tripulante. Impostor fingindo não gera isto, porque não tem a task para o servidor
// conferir. {active: false} quando termina, é cancelada, ou uma reunião/morte a interrompe.
const string S_TASK_VISIBLE = "s_task_visible";           // {peer_id, name, object_id, active}
const string S_TASK_PROGRESS = "s_task_progress";         // {completed, total, percent} - progresso da EQUIPE, vai pra todo mundo (impostor incluído)
const string S_PLAYER_KILLED = "s_player_killed";         // {peer_id, x, y} + {killer_peer, killer_color} SÓ para vítima e assassino (ver announce_kill)
// Quem viu o assassinato DE PERTO (dentro do alcance do kill, ver announce_kill): só para essa
// pessoa, com os nomes que ela vê - o disfarce do metamorfo vale, e no modo cor são cores.
const string S_KILL_WITNESSED = "s_kill_witnessed";     // {killer_name, victim_name, swallowed} - swallowed: foi o lobo engolindo, não um assassinato
// --- Lobo Mau ---
// Só para quem foi engolido: está na barriga, e de quem (o nome VERDADEIRO, como a vítima de um
// assassinato ouve quem a matou - lá dentro ele não tem a quem contar, além do próprio lobo).
const string S_SWALLOWED = "s_swallowed";                // {wolf_peer, wolf_name}
// Para a partida inteira, menos o lobo e o engolido: o SOM de engolir no ponto onde aconteceu, e nada
// mais - nem quem engoliu, nem quem foi engolido.
const string S_SWALLOW_SOUND = "s_swallow_sound";        // {x, y}
// Um corpo saiu do mapa: o lixeiro o limpou, ou o carregador o pegou. Para todos - todo cliente
// guarda os corpos para o som e para o reporte, e um corpo que só sumisse no servidor continuaria
// tocando no cliente. Não diz quem nem por quê.
const string S_BODY_REMOVED = "s_body_removed";          // {peer_id (o morto)}
// O carregador largou o corpo: ele volta a existir, no lugar novo.
const string S_BODY_PLACED = "s_body_placed";            // {peer_id (o morto), x, y}
// O som de limpar ou de arrastar um corpo, posicionado e sem nome.
// O médico trouxe alguém de volta: para todos (a lista de votação e o elenco voltam a contá-lo), e quem
// voltou se reconhece pelo peer_id. Não diz quem reviveu.
// Privado: o seu par de apaixonados morreu, e você morre junto (a partida recebe um S_PLAYER_KILLED
// sem assassino, como de qualquer morte).
const string S_HEARTBREAK = "s_heartbreak";              // {x, y}
const string S_PLAYER_REVIVED = "s_player_revived";      // {peer_id, x, y}
const string S_BODY_SOUND = "s_body_sound";              // {kind: "clean"|"drag", x, y}
// O lobo saiu do jogo (morto, expulso, saiu): quem estava na barriga volta vivo em (x, y). Para todos.
const string S_BELLY_RELEASED = "s_belly_released";      // {peers: [peer_id...], x, y}
const string S_BODY_REPORTED = "s_body_reported";         // {reporter_peer, body_peer, room_key} - room_key = chave i18n da sala onde o corpo estava
// Um papel que anuncia a própria morte caiu (ver announces_own_death em role_traits). Vai para a
// nave inteira, viva ou morta, e diz QUEM e ONDE - nunca quem matou.
const string S_DEATH_ALARM = "s_death_alarm";            // {name, room_key}
// O shapeshifter se transformou (ou voltou ao normal). O SOM vai a quem está perto - é o que
// impede a fantasia de ser grátis; nunca vai o nome de quem se transformou nem em quem.
// O nome com que um jogador aparece MUDOU (o metamorfo se transformou, ou voltou). Vai para a
// partida inteira porque o elenco de cada cliente e' a fonte de todo nome que ele fala sozinho -
// quem esta por perto, quem votou, quem esta falando. Nao diz que e' disfarce: diz o nome novo.
const string S_PLAYER_RENAMED = "s_player_renamed";      // {peer_id, name}
const string S_SHIFT_SOUND = "s_shift_sound";            // {x, y}
// Só para o próprio shapeshifter: a fantasia acabou (tempo, ou reunião começando).
const string S_SHIFT_ENDED = "s_shift_ended";            // {}
// Só para o próprio fantasma: a invisibilidade acabou (tempo, matar, ou reunião). NÃO existe um
// pacote de "som de sumir" para os vizinhos - sumir é silencioso para todo mundo menos para ele.
const string S_VANISH_ENDED = "s_vanish_ended";          // {}
const string S_MEETING_STARTED = "s_meeting_started";     // {reason, caller_peer, discussion_time, absent: [peer_id...]} - absent: na barriga do lobo, fora da lista
const string S_VOTING_STARTED = "s_voting_started";       // {voting_time, candidates: [...]}
const string S_VOTE_RESULT = "s_vote_result";             // {ejected_peer, ejected_name, was_impostor, tie, vote_breakdown: [{voter_name, target_name, skipped}]}
const string S_VOTE_CAST = "s_vote_cast";                 // {voter_peer, voter_name} - só avisa QUE votou, nunca em quem
// Alguém morreu NA MESA por um palpite do sniper. Vai para a partida inteira.
//
// O que ele carrega é decisão de jogo: quem MORREU, quem foi APONTADO e QUAL PAPEL foi dito - e
// nunca quem apontou. Acertando, a mesa descobre o papel da vítima; errando, descobre que o morto
// era impostor e que o alvo não é aquele papel. Nos dois casos a tripulação ganha informação de
// verdade, que é o que paga o preço de morrer numa fase em que ninguém deveria morrer. Pôr aqui
// quem apontou faria de todo palpite certo um suicídio, e o papel deixaria de existir na prática.
const string S_MEETING_KILL = "s_meeting_kill";           // {victim_peer, target_peer, guessed_role, correct}
const string S_SABOTAGE_STARTED = "s_sabotage_started";   // {sabotage_id, timer}
const string S_SABOTAGE_FIXED = "s_sabotage_fixed";       // {sabotage_id}
// Um painel foi consertado, mas a sabotagem ainda não acabou (o oxigênio pede dois). Existe para o
// cliente saber QUAIS painéis já estão prontos: sem isso, quem chegasse no painel já resolvido
// digitava o código inteiro para o servidor dizer no fim que não valia nada.
const string S_SABOTAGE_PROGRESS = "s_sabotage_progress"; // {sabotage_id, object_id, fixed, required}
// Lembrete de quanto falta numa sabotagem crítica. Quem decide QUANDO avisar é o servidor (a cada
// 30 segundos, e a cada segundo nos 10 finais), e não cada cliente com um relógio próprio: assim
// todo mundo ouve o mesmo número no mesmo instante, que é o que permite combinar "vai você no de
// cima que eu vou no de baixo" por voz e confiar no que o outro disse.
const string S_SABOTAGE_COUNTDOWN = "s_sabotage_countdown"; // {sabotage_id, seconds, final}
const string S_GAME_OVER = "s_game_over";                 // {winner, reason, crewmates_alive, crewmates_total, impostors_alive, impostors_total}
const string S_RADAR_RESULT = "s_radar_result";           // {peer_id, name, x, y, distance} ou {empty: true}; com track: true é resposta ao C_RADAR_TRACK (só bipa), e lost: true quando o alvo travado deixou de ser percebido
const string S_ERROR = "s_error";                          // {message}
// Aviso do SERVIDOR a todos (hoje: "vai reiniciar em N minutos"). Era um S_ERROR, dito na hora e
// perdido: não entrava no histórico de eventos nem tinha som, e quem estava ouvindo outra coisa não
// sabia que o servidor ia cair. Só vai a cliente do protocolo 6+; os anteriores seguem recebendo o
// S_ERROR, que é o que eles sabem dizer (ver on_admin_drain).
const string S_SERVER_NOTICE = "s_server_notice";          // {message_key, params}
const string S_PONG = "s_pong";                             // {} - resposta a C_PING, cliente mede o round-trip
const string S_CHAT_MESSAGE = "s_chat_message";             // {peer_id, name, text}
// Saguão (ver C_HALL_CHAT). Só chega a quem está fora de qualquer sala; quem entra numa deixa de
// receber, e é por isso que a conversa do saguão nunca atrapalha uma partida.
// O `notice` é o recado fixo do servidor (ver C_ADMIN_SET_NOTICE), e é a ÚNICA frase que o servidor
// manda pronta em vez de mandar uma chave de tradução. Não há como ser diferente: é texto escrito à
// mão por quem opera o servidor, e não existe uma chave para uma frase que ainda não foi escrita.
// Quem escreve decide em que idioma escreve; por isso ele é sempre acompanhado do que o cliente
// TRADUZ ("Recado do servidor:"), para ninguém confundir com fala de outro jogador.
const string S_HALL_STATE = "s_hall_state";                 // {players: [nomes], notice}
const string S_HALL_CHAT = "s_hall_chat";                   // {name, text}
// --- Saguão ao vivo (protocolo 9) ---
const int HALL_LIVE_PROTOCOL = 9;
// --- Espectador (também protocolo 9) ---
// Na sala de espera: "vou assistir a próxima partida" (on = true) ou "vou jogar". Quem assiste não
// entra no sorteio da equipe.
const string C_SET_SPECTATE = "c_set_spectate";             // {on}
// O espectador escolhe de quem acompanhar a partida: a voz que ele ouve é a que chega perto dessa pessoa.
const string C_SPECTATE_FOLLOW = "c_spectate_follow";       // {peer_id}
// Para quem vai assistir, no lugar do S_GAME_START: o elenco e as regras que a tela precisa - e NADA de
// papel, de ninguém (decisão do usuário: o espectador só descobre no fim, como todo mundo).
const string S_SPECTATE_START = "s_spectate_start";         // {players: [{peer_id, name, color, x, y, alive}], voice_chat, comms_affects_meeting, color_mode, in_meeting, follow}
const int SPECTATE_PROTOCOL = 9;
// A partida avisa quem está jogando quando alguém começa ou para de assistir (recado #185). Chave nova
// de fala: um cliente anterior não a conhece e falaria a chave crua, então só vai a partir daqui.
const int SPECTATOR_NOTICE_PROTOCOL = 11;
// Quantos podem assistir a mesma partida. Cada um recebe o tráfego público da partida inteira.
const uint MAX_SPECTATORS = 10;
// A lista de partidas, mandada SOZINHA a quem está no saguão sempre que ela muda - o cliente refaz o
// menu sem mexer no cursor. Mesmo formato do S_LOBBY_LIST, e um tipo próprio para nenhuma espera pela
// resposta de C_LIST_LOBBIES confundir uma com a outra. Partida privada nunca entra.
const string S_LOBBY_LIST_PUSH = "s_lobby_list_push";       // {lobbies: [...]}
// O que mudou na lista, para ser DITO: uma sala nova, uma partida que começou, uma que acabou e reabriu.
// Só de partidas públicas - sai da mesma lista, que já não tem as privadas.
const string S_HALL_EVENT = "s_hall_event";                 // {kind: created|started|reopened, room, by}
// Confirmação de que o recado foi GRAVADO (não só recebido). O jogador precisa disto: sem resposta,
// mandar feedback é falar no vácuo, e quem não tem certeza de que chegou manda de novo.
const string S_FEEDBACK_ACK = "s_feedback_ack";             // {ok}
const string S_DELETE_ACCOUNT_RESULT = "s_delete_account_result"; // {ok, message}
const string S_FEEDBACK_REPLIES = "s_feedback_replies";     // {replies: [{reply_id, feedback_id, feedback_text, reply_text, created_at}]}
const string S_ADMIN_RESULT = "s_admin_result";             // {ok, message} - só para a ferramenta de administração
const string S_TRANSLATION_ACK = "s_translation_ack";       // {ok, message_key}
const string S_ADMIN_TRANSLATIONS = "s_admin_translations"; // {items: [{username, code, content, created_at}]}
const string S_ADMIN_STATUS = "s_admin_status";             // {connections, lobbies, in_progress, draining_seconds, online_<plataforma>}
// Jogadores DISTINTOS por plataforma e por versão nos últimos `days` dias (ver record_client_login).
const string S_ADMIN_PLATFORMS = "s_admin_platforms";       // {days, platforms: [{name, players}], versions: [{name, players}]}
// Resposta ao próprio observador: entrou, trocou de sala, ou foi recusado/expulso.
const string S_CAMERA_STATE = "s_camera_state";             // {active, room_id, message_key}
// Para TODO mundo na partida: qual sala está sendo observada agora ("" = nenhuma).
//
// Vai para todos, e não só para quem está na sala, porque quem ENTRA nela depois precisa ouvir o
// zumbido também - e o cliente só sabe disso se souber qual sala está sob observação.
const string S_CAMERA_WATCHING = "s_camera_watching";       // {room_id}
// Resposta ao C_CAMERA_SCAN: os nomes de quem está na sala observada, em ordem. Nomes não são texto
// traduzível - são identidade, e viajam como estão (ver "Nada de identidade é traduzido").
const string S_CAMERA_PLAYERS = "s_camera_players";         // {names: [...]}
// Resposta PRIVADA a C_USE_ABILITY: deu ou não, e o porquê como chave. O que a habilidade faz no
// mundo (som, estado) viaja pelos pacotes que já existem para aquilo - isto aqui é só o retorno.
// O papel DESTE jogador mudou no meio da partida (o Carrasco que perdeu o alvo vira Bobo; o Amnésico
// que herdou um papel). Privado. Leva o que o cliente precisa para jogar o papel novo, que ele só
// recebia no começo: recargas, palpites, companheiros de impostor.
const string S_ROLE_CHANGED = "s_role_changed";           // {role_id, reason, kill_cooldown_seconds, ability_cooldown_seconds, ability_guesses, impostor_partners: [{peer_id, name}], execution_target_name?}
const string S_ABILITY_RESULT = "s_ability_result";         // {ability, ok, message_key, message_params?, cooldown_seconds}

// --- Mensagens traduzíveis vindas do servidor -------------------------------
//
// Todo texto que o servidor manda para ser LIDO pelo jogador viaja como CHAVE de tradução mais os
// valores que entram nela - nunca como frase pronta. Quem traduz é o cliente, no idioma que aquele
// jogador escolheu.
//
// O motivo é simples: o servidor é um só e os jogadores de uma mesma partida podem estar em idiomas
// diferentes. Traduzindo no servidor, todo mundo receberia o idioma DELE, e a escolha de idioma no
// jogo viraria mentira para tudo que viesse da rede.
//
const string MSG_KEY_FIELD = "message_key";       // chave de tradução, ex.: "chat.only_in_meeting"
const string MSG_PARAMS_FIELD = "message_params"; // objeto {nome: valor} com as substituições

// Traduz uma mensagem recebida do servidor no idioma DESTE cliente.
//
// Sem chave, devolve vazio: o servidor SEMPRE manda a chave (ver build_message), e um pacote sem
// ela é um pacote quebrado - falar um texto pronto em cima disso mascararia o defeito. Havia aqui
// um campo com o texto já traduzido, para clientes anteriores à 0.11.1; ele saiu na 0.31.0, junto
// com o corte de protocolo que impede essas versões de entrar.
string tr_server_message(net_packet@ pkt) {
	if (@pkt == null) return "";
	string key = pkt.get_string(MSG_KEY_FIELD);
	if (key == "") return "";
	return tr(key, pkt.get_params(MSG_PARAMS_FIELD));
}
const string S_VENT_STATE = "s_vent_state";                 // {vented, x, y} - resposta privada (só pra quem usou o vent)
const string S_VENT_SOUND = "s_vent_sound";                 // {vent_id} - tampa do vent abrindo, ouvida por QUEM ESTÁ PERTO (não vai pra quem usou)
const string S_DOORS_STATE = "s_doors_state";               // {closed, zones: [ids de sala]} - portas fechando ou abrindo
