// client.nvgt
// Conexão do lado do jogador: liga ao servidor, envia comandos (C_*) e entrega os pacotes
// recebidos (S_*) em uma fila para a camada de UI/áudio processar no loop principal do jogo.
// Não interpreta o conteúdo dos pacotes - só transporta net_packet@.

#include "protocol.nvgt"
#include "packet.nvgt"
#include "../config/game_constants.nvgt"
// send_create_lobby recebe um lobby_overrides. Antes isto vinha por tabela - quem incluía o cliente
// já tinha incluído a configuração de lobby antes - e compilava por ordem, não por dependência
// declarada. Bastava alguém incluir só o cliente para quebrar.
#include "../config/lobby_config.nvgt"

// Quem consome os quadros de voz. É uma interface, e não o audio/voice_chat.nvgt direto, para o
// cliente de rede não depender de microfone e alto-falante (o servidor e as ferramentas de tools/
// incluem este arquivo também).
//
// A voz NÃO entra na fila `incoming` de propósito. A fila só é lida pelo laço principal, e o jogo
// passa boa parte do tempo fora dele - numa task, na caixa de mensagem, num formulário - bombeando
// só update(). Se a voz ficasse na fila, quem abrisse uma task ficaria surdo até fechá-la e depois
// ouviria tudo de uma vez. Entregando aqui, dentro de update(), ela flui em qualquer tela.
interface voice_receiver {
	void on_voice_frame(const string&in wire);
	void tick();
}

class game_client {
	network@ net;
	voice_receiver@ voice = null;
	// Dois ids DIFERENTES, e confundir os dois já causou bug feio (ver abaixo):
	// - local_peer_id: o id que o ENet daqui devolveu pra ESTA conexão. Só serve pra mandar pacote
	//   (net.send_*), é um handle local.
	// - my_peer_id: o id que o SERVIDOR usa pra me identificar. É esse que aparece dentro dos
	//   pacotes (peer_id, voter_peer, host_peer_id, ...) e o único que pode ser comparado com eles.
	// Os dois quase nunca batem: cada host numera seus peers do próprio jeito. Como os dois
	// costumam começar em 1, comparar o local com um peer_id de pacote dava "falso positivo" no
	// primeiro jogador conectado - eu ouvia o meu nome no lugar do dele, achava que já tinha votado
	// quando ele votava, e o anfitrião não se reconhecia como anfitrião (Enter não iniciava nada).
	uint64 local_peer_id = 0;
	uint64 my_peer_id = 0;
	bool connected = false;
	array<net_packet@> incoming;
	// Há um pacote que INTERROMPE uma minigame esperando na fila (reunião, corpo reportado, fim de
	// partida)? As minigames precisam saber disso a cada quadro, e descobrir varrendo a fila custava
	// o quadro inteiro quando ela crescia (ver MAX_INCOMING_PACKETS). Marcado na chegada, custa nada.
	bool interrupt_pending = false;
	// A sabotagem que estava de pé acabou de ser consertada (por qualquer um). O painel de reparo é
	// uma tela bloqueante: sem este aviso, quem estava digitando o código continuava ali depois de
	// outra pessoa ter resolvido, e só descobria ao terminar.
	bool sabotage_ended = false;
	// A votação FECHOU (a apuração chegou). O menu de votação é uma tela bloqueante como o painel de
	// reparo: sem este aviso, quem estava com a lista de nomes aberta continuava escolhendo em quem
	// votar numa votação que já tinha acabado, e não ouvia a apuração nem o resultado - a tela só
	// fechava quando ele desistia. Marcado na chegada, como os outros: perguntar varrendo a fila a
	// cada quadro é o que já travou o jogo uma vez.
	bool voting_ended = false;
	// Qual painel acabou de ser resolvido por alguém, sem a sabotagem ter acabado (o oxigênio pede
	// dois). Serve para fechar o painel de quem estava no MESMO - dois entram juntos, um termina
	// primeiro, e o outro continuaria digitando um código que já não conta.
	string panel_fixed_id = "";

	bool connect_to(const string&in host, uint16 port) {
		@net = network();
		if (!net.setup_client(MAX_PACKET_CHANNELS, 1)) return false;
		local_peer_id = net.connect(host, port);
		return local_peer_id != 0;
	}

	// Deve ser chamado a cada quadro/loop do jogo. Processa eventos de rede pendentes e enfileira
	// os pacotes recebidos para poll_message() consumir.
	void update() {
		while (true) {
			const network_event@ ev = net.request(0);
			// net.request() nunca retorna null - quando não há nada pendente ele retorna um
			// evento de tipo event_none. É isso (não @ev == null) que sinaliza "acabaram os
			// eventos deste quadro" e permite sair do laço.
			if (@ev == null || ev.type == event_none) break;

			if (ev.type == event_connect) {
				connected = true;
			} else if (ev.type == event_disconnect || ev.type == event_disconnect_timeout) {
				connected = false;
			} else if (ev.type == event_receive) {
				if (ev.channel == CHANNEL_VOICE) {
					if (@voice != null) voice.on_voice_frame(ev.message);
					continue;
				}
				net_packet@ pkt = packet_from_wire(ev.message);
				if (@pkt != null) enqueue(pkt);
			}
		}
		// Captura do microfone e limpeza das vozes que calaram: roda junto com a rede, pelo mesmo
		// motivo de a recepção não ir para a fila - update() é a única coisa que TODA tela bombeia.
		if (@voice != null) voice.tick();
	}

	// Um quadro de voz, binário, sem JSON (ver CHANNEL_VOICE em protocol.nvgt). Não confiável: um
	// quadro perdido é um estalo de 20 ms; reenviá-lo chegaria tarde demais para servir.
	void send_voice(const string&in audio) {
		if (@net == null || !connected) return;
		net.send_unreliable(local_peer_id, audio, CHANNEL_VOICE);
	}

	void send_voice_state(bool enabled) {
		net_packet@ p = net_packet(C_VOICE_STATE);
		p.set_bool("enabled", enabled);
		send(p);
	}

	// Põe o pacote na fila, anotando se ele interrompe uma minigame e mantendo a fila dentro do teto.
	private void enqueue(net_packet@ pkt) {
		string type = pkt.type;
		if (type == S_MEETING_STARTED || type == S_BODY_REPORTED || type == S_GAME_OVER) interrupt_pending = true;
		if (type == S_SABOTAGE_FIXED) sabotage_ended = true;
		if (type == S_VOTE_RESULT) voting_ended = true;
		if (type == S_SABOTAGE_PROGRESS) panel_fixed_id = pkt.get_string("object_id");
		incoming.insert_last(pkt);
		if (incoming.length() > MAX_INCOMING_PACKETS) drop_oldest_position();
	}

	// Fila cheia: sai a posição mais antiga. É o único pacote que chega em rajada e o único que pode
	// ser descartado sem perda - posição é ESTADO, a mais nova substitui a anterior, e ela já viaja
	// pelo canal não confiável (a rede também a descarta). Nada que seja EVENTO sai daqui: perder
	// uma morte ou o início de uma reunião deixaria o cliente contando uma partida que não existe.
	private void drop_oldest_position() {
		for (uint i = 0; i < incoming.length(); i++) {
			if (incoming[i].type != S_PLAYER_MOVED) continue;
			incoming.remove_at(i);
			return;
		}
	}

	// Joga fora tudo que ainda estava na fila. Chamado ao sair de uma partida: o que sobrou lá é
	// notícia de uma partida que não é mais a sua (posição de gente, corpo reportado, fim de jogo), e
	// a tela seguinte processaria esses pacotes como se fossem da partida nova.
	void clear_incoming() {
		incoming.resize(0);
		interrupt_pending = false;
		sabotage_ended = false;
		voting_ended = false;
		panel_fixed_id = "";
	}

	// Retira a próxima mensagem recebida da fila, ou null se não houver nenhuma.
	net_packet@ poll_message() {
		if (incoming.length() == 0) {
			// Fila vazia: o que interrompia já foi entregue e tratado.
			interrupt_pending = false;
			sabotage_ended = false;
			voting_ended = false;
			panel_fixed_id = "";
			return null;
		}
		net_packet@ pkt = incoming[0];
		incoming.remove_at(0);
		return pkt;
	}

	void disconnect() {
		if (@net != null) net.disconnect_peer(local_peer_id);
		connected = false;
	}

	// --- Envio de comandos (Cliente -> Servidor) ---

	void send_login(const string&in username, const string&in password, bool remember = false) {
		net_packet@ p = net_packet(C_LOGIN);
		p.set_string("username", username);
		p.set_string("password", password);
		p.set_bool("remember", remember);
		p.set_int("protocol", PROTOCOL_VERSION);
		send(p);
	}

	// Login com o token guardado por "lembrar de mim" (ver C_LOGIN).
	void send_login_token(const string&in token) {
		net_packet@ p = net_packet(C_LOGIN);
		p.set_string("token", token);
		p.set_int("protocol", PROTOCOL_VERSION);
		send(p);
	}

	void send_logout(const string&in token) {
		net_packet@ p = net_packet(C_LOGOUT);
		p.set_string("token", token);
		send(p);
	}

	void send_register(const string&in username, const string&in password) {
		net_packet@ p = net_packet(C_REGISTER);
		p.set_string("username", username);
		p.set_string("password", password);
		send(p);
	}

	// --- Habilidade do papel ---
	// `role_id` é o palpite do sniper (qual papel ele diz que o alvo é). Fica aqui, e não num pacote
	// próprio, pela mesma razão que os outros: é UMA porta para todas as habilidades, e um papel novo
	// com um argumento novo não mexe no protocolo.
	void send_use_ability(const string&in ability, uint64 target_peer_id = 0, const string&in object_id = "",
			const string&in role_id = "") {
		net_packet@ p = net_packet(C_USE_ABILITY);
		p.set_string("ability", ability);
		if (target_peer_id != 0) p.set_uint64("target_peer_id", target_peer_id);
		if (object_id != "") p.set_string("object_id", object_id);
		if (role_id != "") p.set_string("role_id", role_id);
		send(p);
	}

	// --- Câmeras de segurança ---
	void send_camera_enter() { send(net_packet(C_CAMERA_ENTER)); }
	void send_camera_leave() { send(net_packet(C_CAMERA_LEAVE)); }
	void send_camera_scan() { send(net_packet(C_CAMERA_SCAN)); }
	void send_camera_switch(const string&in room_id) {
		net_packet@ p = net_packet(C_CAMERA_SWITCH);
		p.set_string("room_id", room_id);
		send(p);
	}

	void send_list_lobbies() {
		send(net_packet(C_LIST_LOBBIES));
	}

	// Recado do jogador para quem faz o jogo. O contexto (versão, papel, sala, crash.log) é montado
	// por quem chama - ver ui/feedback_screen.nvgt.
	void send_feedback(const string&in text, const string&in version, const string&in language,
		bool in_match, const string&in role, const string&in room, const string&in crash_log) {
		net_packet@ p = net_packet(C_SEND_FEEDBACK);
		p.set_string("text", text);
		p.set_string("version", version);
		p.set_string("language", language);
		p.set_bool("in_match", in_match);
		p.set_string("role", role);
		p.set_string("room", room);
		p.set_string("crash_log", crash_log);
		send(p);
	}

	// Ferramenta de administração (tools/reply_feedback.nvgt). Não é chamado por nenhuma tela do jogo:
	// o token vem do ambiente de quem administra, nunca de dentro do cliente distribuído.
	// Arquiva recados já tratados (ver tools/resolve_feedback.nvgt). Autorizado pelo mesmo token de
	// ambiente do C_ADMIN_REPLY: não há conta de administrador de propósito.
	void send_admin_resolve_feedback(const string&in token, int feedback_id, bool until, bool undo) {
		net_packet@ p = net_packet(C_ADMIN_RESOLVE_FEEDBACK);
		p.set_string("token", token);
		p.set_int("feedback_id", feedback_id);
		p.set_bool("until", until);
		p.set_bool("undo", undo);
		send(p);
	}
	void send_admin_reply(const string&in token, int feedback_id, const string&in text) {
		net_packet@ p = net_packet(C_ADMIN_REPLY);
		p.set_string("token", token);
		p.set_int("feedback_id", feedback_id);
		p.set_string("text", text);
		send(p);
	}

	void send_translation(const string&in code, const string&in content) {
		net_packet@ p = net_packet(C_SEND_TRANSLATION);
		p.set_string("code", code);
		p.set_string("content", content);
		send(p);
	}

	// Ferramenta de administração (tools/read_translations.nvgt).
	void send_admin_list_translations(const string&in token) {
		net_packet@ p = net_packet(C_ADMIN_LIST_TRANSLATIONS);
		p.set_string("token", token);
		send(p);
	}
	void send_admin_delete_translation(const string&in token, const string&in username, const string&in code) {
		net_packet@ p = net_packet(C_ADMIN_DELETE_TRANSLATION);
		p.set_string("token", token);
		p.set_string("username", username);
		p.set_string("code", code);
		send(p);
	}

	void send_admin_drain(const string&in token, int seconds) {
		net_packet@ p = net_packet(C_ADMIN_DRAIN);
		p.set_string("token", token);
		p.set_int("seconds", seconds);
		send(p);
	}
	void send_admin_status(const string&in token) {
		net_packet@ p = net_packet(C_ADMIN_STATUS);
		p.set_string("token", token);
		send(p);
	}
	// Texto vazio APAGA o recado do saguão - é assim que se tira um aviso que já não vale.
	void send_admin_set_notice(const string&in token, const string&in text) {
		net_packet@ p = net_packet(C_ADMIN_SET_NOTICE);
		p.set_string("token", token);
		p.set_string("text", text);
		send(p);
	}

	void send_feedback_replies_get() { send(net_packet(C_FEEDBACK_REPLIES_GET)); }
	void send_feedback_reply_read(int reply_id) {
		net_packet@ p = net_packet(C_FEEDBACK_REPLY_READ);
		p.set_int("reply_id", reply_id);
		send(p);
	}

	// Ajustes do anfitrião sobre o preset. O que ele não preencheu vai como -1 e o servidor mantém o
	// valor do preset - ver lobby_overrides em config/lobby_config.nvgt.
	void send_create_lobby(const string&in lobby_name, const string&in preset, const lobby_overrides&in overrides,
			const string&in join_code = "") {
		net_packet@ p = net_packet(C_CREATE_LOBBY);
		p.set_string("lobby_name", lobby_name);
		p.set_string("preset", preset);
		p.set_string("join_code", join_code);
		overrides.write_to_packet(p);
		send(p);
	}

	void send_create_lobby(const string&in lobby_name, const string&in preset, float kill_cooldown_override = -1.0) {
		net_packet@ p = net_packet(C_CREATE_LOBBY);
		p.set_string("lobby_name", lobby_name);
		p.set_string("preset", preset);
		p.set_float("kill_cooldown_override", kill_cooldown_override); // -1 = usa o valor padrão do preset
		send(p);
	}

	void send_join_lobby(const string&in lobby_id) {
		net_packet@ p = net_packet(C_JOIN_LOBBY);
		p.set_string("lobby_id", lobby_id);
		send(p);
	}

	// O anfitrião muda as regras da sala já aberta. Só os ajustes viajam: o que ficou em branco
	// (-1/"") mantém o valor atual - ver on_update_lobby_config no servidor.
	void send_update_lobby_config(const lobby_overrides&in overrides) {
		net_packet@ p = net_packet(C_UPDATE_LOBBY_CONFIG);
		overrides.write_to_packet(p);
		send(p);
	}

	// Entrar numa partida privada: ela não está na lista, então vai só o código.
	void send_join_by_code(const string&in join_code) {
		net_packet@ p = net_packet(C_JOIN_LOBBY);
		p.set_string("lobby_id", "");
		p.set_string("join_code", join_code);
		send(p);
	}

	void send_leave_lobby() {
		send(net_packet(C_LEAVE_LOBBY));
	}

	void send_start_game() {
		send(net_packet(C_START_GAME));
	}

	void send_add_bot() {
		send(net_packet(C_ADD_BOT));
	}

	void send_remove_bot() {
		send(net_packet(C_REMOVE_BOT));
	}

	void send_move(float x, float y) {
		net_packet@ p = net_packet(C_MOVE);
		p.set_float("x", x);
		p.set_float("y", y);
		send(p, false); // canal não confiável: posição é enviada com frequência, perda ocasional é aceitável
	}

	void send_interact(const string&in object_id) {
		net_packet@ p = net_packet(C_INTERACT);
		p.set_string("object_id", object_id);
		send(p);
	}

	void send_start_task(const string&in task_id) {
		net_packet@ p = net_packet(C_START_TASK);
		p.set_string("task_id", task_id);
		send(p);
	}

	void send_task_input(const string&in task_id, bool success) {
		net_packet@ p = net_packet(C_TASK_INPUT);
		p.set_string("task_id", task_id);
		p.set_bool("success", success);
		send(p);
	}

	void send_kill(uint64 target_peer) {
		net_packet@ p = net_packet(C_KILL);
		p.set_uint64("target_peer", target_peer);
		send(p);
	}

	void send_report_body(const string&in body_id) {
		net_packet@ p = net_packet(C_REPORT_BODY);
		p.set_string("body_id", body_id);
		send(p);
	}

	void send_call_meeting() {
		send(net_packet(C_CALL_MEETING));
	}

	void send_cast_vote(int64 target_peer) {
		net_packet@ p = net_packet(C_CAST_VOTE);
		p.set_int64("target_peer", target_peer);
		send(p);
	}

	void send_use_vent(const string&in vent_id) {
		net_packet@ p = net_packet(C_USE_VENT);
		p.set_string("vent_id", vent_id);
		send(p);
	}

	// target_vent_id == "" pede pra sair do vent; qualquer outro valor pede pra viajar (escondido)
	// até esse vent, se ele for conectado ao vent atual.
	void send_vent_travel(const string&in target_vent_id) {
		net_packet@ p = net_packet(C_VENT_TRAVEL);
		p.set_string("target_vent_id", target_vent_id);
		send(p);
	}

	void send_radar_scan(int direction) {
		net_packet@ p = net_packet(C_RADAR_SCAN);
		p.set_int("direction", direction);
		send(p, false);
	}

	void send_radar_track(uint64 peer_id) {
		net_packet@ p = net_packet(C_RADAR_TRACK);
		p.set_uint64("peer_id", peer_id);
		send(p, false); // vai a cada meio segundo; perder um não custa nada
	}

	void send_close_doors(const string&in room_id) {
		net_packet@ p = net_packet(C_CLOSE_DOORS);
		p.set_string("room_id", room_id);
		send(p);
	}

	void send_trigger_sabotage(const string&in sabotage_id) {
		net_packet@ p = net_packet(C_TRIGGER_SABOTAGE);
		p.set_string("sabotage_id", sabotage_id);
		send(p);
	}

	void send_ping() {
		send(net_packet(C_PING));
	}

	// Conversa do saguão (fora de qualquer sala) - ver C_HALL_CHAT em protocol.nvgt.
	void send_hall_chat(const string&in text) {
		net_packet@ p = net_packet(C_HALL_CHAT);
		p.set_string("text", text);
		send(p);
	}

	void send_chat_message(const string&in text) {
		net_packet@ p = net_packet(C_CHAT_MESSAGE);
		p.set_string("text", text);
		send(p);
	}

	private void send(net_packet@ pkt, bool reliable = true) {
		if (@net == null) return;
		if (reliable) net.send_reliable(local_peer_id, pkt.to_wire(), CHANNEL_RELIABLE);
		else net.send_unreliable(local_peer_id, pkt.to_wire(), CHANNEL_UNRELIABLE);
	}
}
