// client.nvgt
// Conexão do lado do jogador: liga ao servidor, envia comandos (C_*) e entrega os pacotes
// recebidos (S_*) em uma fila para a camada de UI/áudio processar no loop principal do jogo.
// Não interpreta o conteúdo dos pacotes - só transporta net_packet@.

#include "protocol.nvgt"
#include "packet.nvgt"
#include "../config/game_constants.nvgt"
// send_create_lobby recebe um lobby_overrides. Antes isto vinha por tabela - quem incluía o cliente
// já tinha incluído a configuração de lobby antes - e compilava por ordem, não por dependência
// declarada. Bastava alguém incluir só o cliente para quebrar.
#include "../config/lobby_config.nvgt"

class game_client {
	network@ net;
	// Dois ids DIFERENTES, e confundir os dois já causou bug feio (ver abaixo):
	// - local_peer_id: o id que o ENet daqui devolveu pra ESTA conexão. Só serve pra mandar pacote
	//   (net.send_*), é um handle local.
	// - my_peer_id: o id que o SERVIDOR usa pra me identificar. É esse que aparece dentro dos
	//   pacotes (peer_id, voter_peer, host_peer_id, ...) e o único que pode ser comparado com eles.
	// Os dois quase nunca batem: cada host numera seus peers do próprio jeito. Como os dois
	// costumam começar em 1, comparar o local com um peer_id de pacote dava "falso positivo" no
	// primeiro jogador conectado - eu ouvia o meu nome no lugar do dele, achava que já tinha votado
	// quando ele votava, e o anfitrião não se reconhecia como anfitrião (Enter não iniciava nada).
	uint64 local_peer_id = 0;
	uint64 my_peer_id = 0;
	bool connected = false;
	array<net_packet@> incoming;

	bool connect_to(const string&in host, uint16 port) {
		@net = network();
		if (!net.setup_client(MAX_PACKET_CHANNELS, 1)) return false;
		local_peer_id = net.connect(host, port);
		return local_peer_id != 0;
	}

	// Deve ser chamado a cada quadro/loop do jogo. Processa eventos de rede pendentes e enfileira
	// os pacotes recebidos para poll_message() consumir.
	void update() {
		while (true) {
			const network_event@ ev = net.request(0);
			// net.request() nunca retorna null - quando não há nada pendente ele retorna um
			// evento de tipo event_none. É isso (não @ev == null) que sinaliza "acabaram os
			// eventos deste quadro" e permite sair do laço.
			if (@ev == null || ev.type == event_none) break;

			if (ev.type == event_connect) {
				connected = true;
			} else if (ev.type == event_disconnect || ev.type == event_disconnect_timeout) {
				connected = false;
			} else if (ev.type == event_receive) {
				net_packet@ pkt = packet_from_wire(ev.message);
				if (@pkt != null) incoming.insert_last(pkt);
			}
		}
	}

	// Joga fora tudo que ainda estava na fila. Chamado ao sair de uma partida: o que sobrou lá é
	// notícia de uma partida que não é mais a sua (posição de gente, corpo reportado, fim de jogo), e
	// a tela seguinte processaria esses pacotes como se fossem da partida nova.
	void clear_incoming() {
		incoming.resize(0);
	}

	// Retira a próxima mensagem recebida da fila, ou null se não houver nenhuma.
	net_packet@ poll_message() {
		if (incoming.length() == 0) return null;
		net_packet@ pkt = incoming[0];
		incoming.remove_at(0);
		return pkt;
	}

	void disconnect() {
		if (@net != null) net.disconnect_peer(local_peer_id);
		connected = false;
	}

	// --- Envio de comandos (Cliente -> Servidor) ---

	void send_login(const string&in username, const string&in password) {
		net_packet@ p = net_packet(C_LOGIN);
		p.set_string("username", username);
		p.set_string("password", password);
		send(p);
	}

	void send_register(const string&in username, const string&in password) {
		net_packet@ p = net_packet(C_REGISTER);
		p.set_string("username", username);
		p.set_string("password", password);
		send(p);
	}

	void send_list_lobbies() {
		send(net_packet(C_LIST_LOBBIES));
	}

	// Recado do jogador para quem faz o jogo. O contexto (versão, papel, sala, crash.log) é montado
	// por quem chama - ver ui/feedback_screen.nvgt.
	void send_feedback(const string&in text, const string&in version, const string&in language,
		bool in_match, const string&in role, const string&in room, const string&in crash_log) {
		net_packet@ p = net_packet(C_SEND_FEEDBACK);
		p.set_string("text", text);
		p.set_string("version", version);
		p.set_string("language", language);
		p.set_bool("in_match", in_match);
		p.set_string("role", role);
		p.set_string("room", room);
		p.set_string("crash_log", crash_log);
		send(p);
	}

	// Ajustes do anfitrião sobre o preset. O que ele não preencheu vai como -1 e o servidor mantém o
	// valor do preset - ver lobby_overrides em config/lobby_config.nvgt.
	void send_create_lobby(const string&in lobby_name, const string&in preset, const lobby_overrides&in overrides) {
		net_packet@ p = net_packet(C_CREATE_LOBBY);
		p.set_string("lobby_name", lobby_name);
		p.set_string("preset", preset);
		overrides.write_to_packet(p);
		send(p);
	}

	void send_create_lobby(const string&in lobby_name, const string&in preset, float kill_cooldown_override = -1.0) {
		net_packet@ p = net_packet(C_CREATE_LOBBY);
		p.set_string("lobby_name", lobby_name);
		p.set_string("preset", preset);
		p.set_float("kill_cooldown_override", kill_cooldown_override); // -1 = usa o valor padrão do preset
		send(p);
	}

	void send_join_lobby(const string&in lobby_id) {
		net_packet@ p = net_packet(C_JOIN_LOBBY);
		p.set_string("lobby_id", lobby_id);
		send(p);
	}

	void send_leave_lobby() {
		send(net_packet(C_LEAVE_LOBBY));
	}

	void send_start_game() {
		send(net_packet(C_START_GAME));
	}

	void send_add_bot() {
		send(net_packet(C_ADD_BOT));
	}

	void send_remove_bot() {
		send(net_packet(C_REMOVE_BOT));
	}

	void send_move(float x, float y) {
		net_packet@ p = net_packet(C_MOVE);
		p.set_float("x", x);
		p.set_float("y", y);
		send(p, false); // canal não confiável: posição é enviada com frequência, perda ocasional é aceitável
	}

	void send_interact(const string&in object_id) {
		net_packet@ p = net_packet(C_INTERACT);
		p.set_string("object_id", object_id);
		send(p);
	}

	void send_start_task(const string&in task_id) {
		net_packet@ p = net_packet(C_START_TASK);
		p.set_string("task_id", task_id);
		send(p);
	}

	void send_task_input(const string&in task_id, bool success) {
		net_packet@ p = net_packet(C_TASK_INPUT);
		p.set_string("task_id", task_id);
		p.set_bool("success", success);
		send(p);
	}

	void send_kill(uint64 target_peer) {
		net_packet@ p = net_packet(C_KILL);
		p.set_uint64("target_peer", target_peer);
		send(p);
	}

	void send_report_body(const string&in body_id) {
		net_packet@ p = net_packet(C_REPORT_BODY);
		p.set_string("body_id", body_id);
		send(p);
	}

	void send_call_meeting() {
		send(net_packet(C_CALL_MEETING));
	}

	void send_cast_vote(int64 target_peer) {
		net_packet@ p = net_packet(C_CAST_VOTE);
		p.set_int64("target_peer", target_peer);
		send(p);
	}

	void send_use_vent(const string&in vent_id) {
		net_packet@ p = net_packet(C_USE_VENT);
		p.set_string("vent_id", vent_id);
		send(p);
	}

	// target_vent_id == "" pede pra sair do vent; qualquer outro valor pede pra viajar (escondido)
	// até esse vent, se ele for conectado ao vent atual.
	void send_vent_travel(const string&in target_vent_id) {
		net_packet@ p = net_packet(C_VENT_TRAVEL);
		p.set_string("target_vent_id", target_vent_id);
		send(p);
	}

	void send_radar_scan(int direction) {
		net_packet@ p = net_packet(C_RADAR_SCAN);
		p.set_int("direction", direction);
		send(p, false);
	}

	void send_close_doors(const string&in room_id) {
		net_packet@ p = net_packet(C_CLOSE_DOORS);
		p.set_string("room_id", room_id);
		send(p);
	}

	void send_trigger_sabotage(const string&in sabotage_id) {
		net_packet@ p = net_packet(C_TRIGGER_SABOTAGE);
		p.set_string("sabotage_id", sabotage_id);
		send(p);
	}

	void send_ping() {
		send(net_packet(C_PING));
	}

	void send_chat_message(const string&in text) {
		net_packet@ p = net_packet(C_CHAT_MESSAGE);
		p.set_string("text", text);
		send(p);
	}

	private void send(net_packet@ pkt, bool reliable = true) {
		if (@net == null) return;
		if (reliable) net.send_reliable(local_peer_id, pkt.to_wire(), CHANNEL_RELIABLE);
		else net.send_unreliable(local_peer_id, pkt.to_wire(), CHANNEL_UNRELIABLE);
	}
}
