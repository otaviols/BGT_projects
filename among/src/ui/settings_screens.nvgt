// settings_screens.nvgt
// Configurações do jogador: volume por família de som, mapa de teclas e voz. Tudo é salvo na hora
// de sair de cada tela (ver config/game_settings.nvgt) e vale já na próxima partida.

#include "menu.nvgt"
#include "form.nvgt"
#include "speech.nvgt"
#include "../config/game_settings.nvgt"
#include "../audio/sound_catalog.nvgt"
#include "../audio/voice_chat.nvgt"
#include "../i18n.nvgt"

// Som de amostra de cada família, na ordem de SOUND_FAMILY_*. Tocar o som DA FAMÍLIA ao mexer no
// controle é o que torna o ajuste possível de ouvido: você ouve o que está ajustando, no volume em
// que ficou, sem ter que entrar numa partida pra descobrir.
const array<string> FAMILY_PREVIEW_SOUNDS = {
	SND_MENU_CONFIRM,       // geral
	SND_AMBIENT_CAFETERIA,  // ambiente
	"sounds/steps/Tile1.ogg",     // passos
	SND_VENT_BEACON,        // marcadores
	"sounds/" + SND_BEEP,   // tasks
	SND_BODY_REPORTED,      // eventos
	SND_MENU_CLICK,         // interface
	SND_INTRO,              // música
	SND_MESSAGE_RECEIVED,   // vozes (não há voz gravada para servir de amostra; o aviso de chat é o parente mais próximo)
	SND_SABOTAGE_ALARM      // alarme da sabotagem
};

// A rede tem que continuar sendo servida enquanto estas telas estão abertas.
//
// O NVGT configura o peer para desistir entre 10 e 35 segundos sem resposta (enet_peer_timeout), e
// uma tela que bloqueia sem chamar client.update() não manda ACK nem keepalive nenhum: o servidor
// conclui que o jogador caiu e o tira da sala. Era o que acontecia ao abrir as configurações de
// dentro da sala de espera - a pessoa mexia num volume por vinte segundos e voltava para o
// navegador de partidas sem entender por quê.
//
// Fora de uma partida (menu inicial) não há cliente nenhum, e aí isto não faz nada.
game_client@ g_settings_pump_client;

void pump_client_during_settings(menu@ m, string data) {
	if (@g_settings_pump_client != null) g_settings_pump_client.update();
}

// O mesmo, para os laços de audio_form (que não têm callback de fundo).
void pump_settings_client() {
	if (@g_settings_pump_client != null) g_settings_pump_client.update();
}

// `client` é quem mantém a conexão viva enquanto o jogador mexe nas configurações; null quando não
// há partida (menu inicial).
void run_settings_menu(game_client@ client = null) {
	@g_settings_pump_client = client;
	while (true) {
		menu m;
		m.intro_text = tr("menu.settings");
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		m.sounds_prefix = "sounds/";
		m.add_item(tr("settings.volumes"), "volumes");
		// Separado dos volumes de propósito: o que está aqui muda a INFORMAÇÃO que o som carrega
		// (para onde é o sul, se há alguém ao alcance), e não o quão alto ele é.
		m.add_item(tr("settings.hearing"), "hearing");
		m.add_item(tr("settings.keys"), "keys");
		m.add_item(tr("settings.voice"), "voice");
		m.add_item(tr("settings.voice_chat"), "voice_chat");
		m.add_item(tr("settings.output_device"), "output");
		m.add_item(tr("settings.language"), "language");
		m.add_item(tr("menu.back"), "back");
		@m.background_callback = @pump_client_during_settings;
		m.run();

		string id = m.selected_item_id;
		if (id == "volumes") run_volume_screen();
		else if (id == "hearing") run_hearing_screen();
		else if (id == "keys") run_keys_screen();
		else if (id == "voice") run_voice_screen();
		else if (id == "voice_chat") run_voice_chat_screen();
		else if (id == "output") run_output_device_screen();
		else if (id == "language") run_language_screen();
		else return; // "back", ESC ou fechou sem escolher
	}
}

// --- Como eu ouço o jogo ---
//
// Separado dos volumes porque o que está aqui muda a INFORMAÇÃO que o som carrega, não o quão alto
// ele é: para onde fica o sul, e se há alguém ao alcance da sua ação.
void run_hearing_screen() {
	audio_form f;
	f.create_window(tr("settings.hearing"), false);
	int f_pitch = f.create_input_box(tr("settings.spatial_pitch"), "" + g_settings.spatial_pitch_percent);
	int f_beep = f.create_checkbox(tr("settings.target_range_beep"), g_settings.target_range_beep);
	int f_ok = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	f.focus(f_pitch); // audio_form nasce sem foco - ver CLAUDE.md
	speak(tr("settings.hearing_hint"));

	while (true) {
		wait(5);
		if (@g_settings_pump_client != null) g_settings_pump_client.update(); // a sala continua viva
		f.monitor();
		if (f.is_pressed(f_cancel)) { speak(tr("settings.cancelled")); return; }
		if (f.is_pressed(f_ok)) {
			int p = parse_int(f.get_text(f_pitch));
			if (p < 0) p = 0;
			if (p > SPATIAL_PITCH_MAX_PERCENT) p = SPATIAL_PITCH_MAX_PERCENT;
			g_settings.spatial_pitch_percent = p;
			g_settings.target_range_beep = f.is_checked(f_beep);
			g_settings.save();
			// O pool GUARDA o valor do tom: sem reaplicar, o ajuste só valeria na partida seguinte -
			// e o jogador testaria achando que não funcionou.
			if (@g_active_spatial != null) g_active_spatial.apply_pitch_setting();
			speak(tr("settings.saved"));
			return;
		}
	}
}

// --- Volumes ---
// Um controle deslizante por família. Mexer num controle toca a amostra daquela família no volume
// novo; o anterior é cortado, senão dois ou três sons se empilhariam enquanto a seta é segurada.
void run_volume_screen() {
	audio_form f;
	f.create_window(tr("settings.volumes"), false);

	array<int> sliders;
	array<int> last_values;
	for (uint i = 0; i < SOUND_FAMILY_COUNT; i++) {
		sliders.insert_last(f.create_slider(tr(SOUND_FAMILY_NAME_KEYS[i]), g_settings.volumes[i], 0, 100));
		last_values.insert_last(g_settings.volumes[i]);
	}
	int f_save = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	// Um audio_form nasce sem foco: sem isto as setas não mexem em volume nenhum até o jogador
	// apertar Tab, e a tela parece quebrada.
	if (sliders.length() > 0) f.focus(sliders[0]);

	array<int> original = g_settings.volumes;
	sound@ preview = null;

	while (true) {
		wait(5);
		pump_settings_client();
		f.monitor();

		if (f.is_pressed(f_cancel)) {
			g_settings.volumes = original; // desfaz tudo, inclusive o que já estava sendo ouvido
			g_settings.apply_master();
			if (@preview != null) preview.stop();
			speak(tr("settings.cancelled"));
			return;
		}
		if (f.is_pressed(f_save)) {
			if (@preview != null) preview.stop();
			g_settings.save();
			speak(tr("settings.saved"));
			return;
		}

		for (uint i = 0; i < sliders.length(); i++) {
			int value = f.get_slider(sliders[i]);
			if (value == last_values[i]) continue;
			last_values[i] = value;
			g_settings.volumes[i] = value;
			// O volume geral vale na hora porque é a engine inteira que muda - inclusive a amostra
			// que vai tocar no próximo passo.
			if (int(i) == SOUND_FAMILY_MASTER) g_settings.apply_master();

			if (@preview != null) preview.stop();
			@preview = sound_play(FAMILY_PREVIEW_SOUNDS[i], vector(FLOAT_MAX, FLOAT_MAX, FLOAT_MAX),
				g_settings.volume_db(int(i)), 0.0);
		}
	}
}

// --- Teclas ---
// Lista de ações; Enter numa delas entra no modo "aperte a tecla nova". A tecla é lida com
// keys_pressed(), que devolve o que foi apertado neste quadro - assim qualquer tecla serve, sem
// precisar de uma lista fixa de teclas conhecidas.
void run_keys_screen() {
	while (true) {
		menu m;
		m.intro_text = tr("settings.keys_hint");
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		m.sounds_prefix = "sounds/";

		for (uint i = 0; i < g_keys.bindings.length(); i++) {
			key_binding@ b = g_keys.bindings[i];
			dictionary@ p = dictionary();
			p.set("action", tr(b.name_key));
			p.set("key", get_key_name(b.key));
			m.add_item(tr("settings.key_item", p), "" + i);
		}
		m.add_item(tr("settings.restore_defaults"), "defaults");
		m.add_item(tr("menu.back"), "back");
		@m.background_callback = @pump_client_during_settings;
		m.run();

		string id = m.selected_item_id;
		if (id == "" || id == "back") {
			g_settings.save();
			return;
		}
		if (id == "defaults") {
			g_keys.restore_defaults();
			g_settings.save();
			speak(tr("settings.defaults_restored"));
			continue;
		}
		capture_key_for(parse_int(id));
	}
}

// Espera o jogador apertar a tecla nova pra esta ação. ESC cancela sem trocar nada.
void capture_key_for(int action) {
	if (action < 0 || action >= int(g_keys.bindings.length())) return;
	key_binding@ binding = g_keys.bindings[action];

	dictionary@ p = dictionary();
	p.set("action", tr(binding.name_key));
	speak(tr("settings.press_new_key", p));
	wait(300); // solta o Enter que abriu isto aqui, senão ele mesmo vira a tecla nova

	while (true) {
		wait(5);
		pump_settings_client();
		array<int>@ pressed = keys_pressed();
		if (pressed.length() == 0) continue;

		int key = pressed[0];
		if (key == KEY_ESCAPE) {
			speak(tr("settings.cancelled"));
			return;
		}

		// Tecla já usada por outra ação: uma das duas nunca aconteceria, e descobrir isso no meio de
		// uma partida seria péssimo. Recusa e explica de quem é a tecla.
		int conflict = g_keys.action_using(key, action);
		if (conflict != -1) {
			dictionary@ cp = dictionary();
			cp.set("key", get_key_name(key));
			cp.set("action", tr(g_keys.bindings[conflict].name_key));
			speak(tr("settings.key_in_use", cp));
			return;
		}

		binding.key = key;
		g_settings.save();
		dictionary@ ok = dictionary();
		ok.set("action", tr(binding.name_key));
		ok.set("key", get_key_name(key));
		speak(tr("settings.key_changed", ok));
		return;
	}
}

// --- Idioma ---
// A lista sai de lang/*.json, e não de uma lista fixa no código: acrescentar um idioma passa a ser
// só largar o .json na pasta, sem precisar mexer aqui. Os arquivos ficam soltos ao lado do
// executável mesmo no jogo compilado (são #pragma asset em AmongUs.nvgt), então find_files enxerga
// os mesmos idiomas rodando do fonte ou do build distribuído.
void run_language_screen() {
	array<string>@ codes = g_i18n.get_available_languages();
	if (codes.length() == 0) {
		// Não deveria acontecer num build íntegro - mas se acontecer, o jogo inteiro estaria falando
		// por chaves cruas, e um aviso claro é melhor do que uma lista vazia sem explicação.
		speak(tr("settings.language_none"));
		return;
	}

	menu m;
	m.intro_text = tr("settings.language_hint");
	m.click_sound = "ui/menu_click.ogg";
	m.select_sound = "ui/menu_confirm.ogg";
	m.sounds_prefix = "sounds/";

	for (uint i = 0; i < codes.length(); i++) {
		string label = language_display_name(codes[i]);
		string translator = g_i18n.translator_of(codes[i]);
		if (translator != "") {
			dictionary@ tp = dictionary();
			tp.set("language", label);
			tp.set("translator", translator);
			label = tr("settings.language_by", tp);
		}
		// O idioma atual é anunciado como tal: sem isso, quem entra na tela não tem como saber em qual
		// deles já está - a lista sozinha não diz.
		if (codes[i] == g_settings.language) {
			dictionary@ p = dictionary();
			p.set("language", label);
			label = tr("settings.language_current", p);
		}
		m.add_item(label, codes[i]);
	}
	m.add_item(tr("menu.back"), "back");
	@m.background_callback = @pump_client_during_settings;
	m.run();

	string chosen = m.selected_item_id;
	if (chosen == "" || chosen == "back") return;
	if (chosen == g_settings.language) return; // escolheu o que já estava

	// Se o arquivo estiver corrompido ou incompleto, load_language falha - e trocar o idioma salvo
	// para um que não carrega deixaria o jogo falando por chaves cruas no próximo boot, sem um
	// caminho óbvio de volta. Por isso a preferência só é gravada DEPOIS da troca dar certo.
	if (!g_i18n.load_language(chosen)) {
		speak(tr("settings.language_failed"));
		return;
	}
	g_settings.language = chosen;
	g_settings.save();

	// A frase de confirmação sai já no idioma novo: é a prova imediata, de ouvido, de que a troca
	// valeu. As telas que já estavam abertas continuam como estavam - o menu é remontado a cada
	// volta do laço em run_settings_menu(), então o resto se atualiza sozinho.
	speak(tr("settings.language_changed"));
}

// --- Voz ---
// Esta tela era a do speech.nvgt (tts_config), reaproveitada inteira. Ela teve que ser reescrita
// por um motivo simples: o laço dela é fechado, sem nenhum gancho, então a rede não podia ser
// servida enquanto ela estivesse aberta - e abrir a configuração de voz de dentro da sala de espera
// derrubava o jogador dela em poucos segundos.
//
// A reescrita trouxe de graça o que faltava: a tela de lá é em inglês fixo, e esta fala o idioma do
// jogador. Os valores continuam saindo e entrando pelo mesmo tts_dump_config/tts_load_config, então
// nada do que já estava salvo se perde.
void run_voice_screen() {
	audio_form f;
	f.create_window(tr("settings.voice"), false);
	int f_use_sr = f.create_checkbox(tr("settings.voice_use_screen_reader"), use_sr);
	int f_voices = f.create_list(tr("settings.voice_voice"));
	array<string>@ voice_names = tts.list_voices();
	for (uint i = 0; i < voice_names.length(); i++) {
		f.add_list_item(f_voices, voice_names[i] != "" ? voice_names[i] : tr("settings.voice_unknown"));
	}
	if (tts.voice > -1) f.set_list_position(f_voices, tts.voice);
	int f_rate = f.create_slider(tr("settings.voice_rate"), tts.rate, -10, 10);
	int f_volume = f.create_slider(tr("settings.voice_volume"), tts.volume, 0, 100);
	int f_save = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	f.focus(f_use_sr); // audio_form nasce sem foco nenhum

	// Guardados para desfazer no cancelar: os valores valem NA HORA (é assim que se ajusta uma voz
	// de ouvido - mexer e escutar), então cancelar precisa ter para onde voltar.
	bool orig_use_sr = use_sr;
	int orig_voice = tts.voice;
	int orig_rate = tts.rate;
	int orig_volume = tts.volume;
	int last_voice = tts.voice, last_rate = tts.rate, last_volume = tts.volume;

	while (true) {
		wait(5);
		pump_settings_client();
		f.monitor();

		use_sr = f.is_checked(f_use_sr);
		int voice = f.get_list_position(f_voices);
		if (voice != last_voice && voice > -1) { last_voice = voice; tts.set_voice(voice); speak(tr("settings.voice_sample")); }
		int rate = int(f.get_slider(f_rate));
		if (rate != last_rate) { last_rate = rate; tts.set_rate(rate); speak(tr("settings.voice_sample")); }
		int volume = int(f.get_slider(f_volume));
		if (volume != last_volume) { last_volume = volume; tts.set_volume(volume); speak(tr("settings.voice_sample")); }

		if (f.is_pressed(f_cancel)) {
			use_sr = orig_use_sr;
			if (tts.voice != orig_voice) tts.set_voice(orig_voice);
			if (tts.rate != orig_rate) tts.set_rate(orig_rate);
			if (tts.volume != orig_volume) tts.set_volume(orig_volume);
			speak(tr("settings.cancelled"));
			return;
		}
		if (f.is_pressed(f_save)) {
			g_settings.save();
			speak(tr("settings.saved"));
			return;
		}
	}
}

// --- Chat de voz ---
// Participar ou não, como o microfone abre (segurando a tecla de falar, ou sozinho quando a voz
// passa da sensibilidade), a sensibilidade, o microfone, e um teste: enquanto o botão de teste está
// ligado, o que passaria para os outros volta para o próprio fone - sem posição - que é o único jeito
// de saber, de ouvido, se o microfone certo está escolhido e se a sensibilidade corta ou deixa passar.
// A tecla de falar se troca em Teclas, como as outras.
void run_voice_chat_screen() {
	audio_form f;
	f.create_window(tr("settings.voice_chat"), false);
	int f_enabled = f.create_checkbox(tr("settings.voice_chat_enabled"), g_settings.voice_chat_enabled);
	int f_mode = f.create_list(tr("settings.voice_mode"));
	f.add_list_item(f_mode, tr("settings.voice_mode_key"), VOICE_MODE_KEY);
	f.add_list_item(f_mode, tr("settings.voice_mode_auto"), VOICE_MODE_AUTO);
	f.set_list_position(f_mode, g_settings.voice_mode == VOICE_MODE_AUTO ? 1 : 0);
	int f_mic_volume = f.create_slider(tr("settings.voice_mic_volume"), g_settings.voice_mic_volume, 0, VOICE_VOLUME_MAX_PERCENT);
	int f_sens = f.create_slider(tr("settings.voice_sensitivity"), g_settings.voice_sensitivity, 0, 100);
	int f_input = f.create_list(tr("settings.input_device"));
	// A primeira entrada é "padrão do sistema" (""); as seguintes são os aparelhos, guardados pelo nome.
	const array<string>@ inputs = get_sound_input_devices();
	f.add_list_item(f_input, tr("settings.device_default"), "");
	int input_pos = 0;
	for (uint i = 0; i < inputs.length(); i++) {
		f.add_list_item(f_input, inputs[i], inputs[i]);
		if (inputs[i] == g_settings.voice_input_device) input_pos = int(i) + 1;
	}
	f.set_list_position(f_input, input_pos);
	int f_test = f.create_checkbox(tr("settings.voice_test"), false);
	int f_save = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	f.focus(f_enabled);
	speak(tr("settings.voice_chat_hint"), false);

	bool orig_enabled = g_settings.voice_chat_enabled;
	string orig_mode = g_settings.voice_mode;
	int orig_sens = g_settings.voice_sensitivity;
	int orig_mic_volume = g_settings.voice_mic_volume;
	string orig_input = g_settings.voice_input_device;

	while (true) {
		wait(5);
		pump_settings_client();
		f.monitor();
		// Os valores valem na hora, porque o teste de microfone usa exatamente o que está na tela.
		g_settings.voice_chat_enabled = f.is_checked(f_enabled);
		int mode_pos = f.get_list_position(f_mode);
		g_settings.voice_mode = mode_pos == 1 ? VOICE_MODE_AUTO : VOICE_MODE_KEY;
		g_settings.voice_sensitivity = int(f.get_slider(f_sens));
		g_settings.voice_mic_volume = int(f.get_slider(f_mic_volume));
		int in_pos = f.get_list_position(f_input);
		g_settings.voice_input_device = in_pos > 0 ? f.get_list_item_id(f_input, in_pos) : "";
		bool testing = f.is_checked(f_test);
		if (testing != g_voice.monitoring) {
			if (testing) g_voice.start_monitor(); else g_voice.stop_monitor();
		}
		if (@g_settings_pump_client == null) g_voice.tick(); // fora de partida, o teste precisa disto

		if (f.is_pressed(f_cancel)) {
			g_voice.stop_monitor();
			g_settings.voice_chat_enabled = orig_enabled;
			g_settings.voice_mode = orig_mode;
			g_settings.voice_sensitivity = orig_sens;
			g_settings.voice_mic_volume = orig_mic_volume;
			g_settings.voice_input_device = orig_input;
			speak(tr("settings.cancelled"));
			return;
		}
		if (f.is_pressed(f_save)) {
			g_voice.stop_monitor();
			g_settings.save();
			// O servidor precisa saber se passei a querer (ou a não querer) receber voz.
			if (@g_voice.client != null) g_voice.announce(g_voice.client.connected);
			speak(tr("settings.saved"));
			return;
		}
	}
}

// --- Dispositivo de saída ---
// Por onde TODO o som do jogo sai. Vale na hora de escolher: a confirmação falada já sai pelo
// aparelho novo, e é assim que se descobre se era esse mesmo.
void run_output_device_screen() {
	const array<string>@ outputs = get_sound_output_devices();
	menu m;
	m.intro_text = tr("settings.output_device_hint");
	m.click_sound = "ui/menu_click.ogg";
	m.select_sound = "ui/menu_confirm.ogg";
	m.sounds_prefix = "sounds/";
	m.add_item(tr("settings.device_default") + (g_settings.audio_output_device == "" ? " " + tr("settings.device_current") : ""), "default");
	for (uint i = 0; i < outputs.length(); i++) {
		string label = outputs[i];
		if (outputs[i] == g_settings.audio_output_device) label += " " + tr("settings.device_current");
		m.add_item(label, outputs[i]);
	}
	m.add_item(tr("menu.back"), "back");
	@m.background_callback = @pump_client_during_settings;
	m.run();
	string chosen = m.selected_item_id;
	if (chosen == "" || chosen == "back") return;
	g_settings.audio_output_device = chosen == "default" ? "" : chosen;
	g_settings.apply_output_device(); // com "" volta ao que o sistema tinha escolhido ao abrir o jogo
	g_settings.save();
	speak(tr("settings.output_device_changed"));
}
