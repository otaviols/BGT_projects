// A primeira vez num computador: jogar com o modo gráfico ou só com som? (recado #235, e o #236 chegou
// ao mesmo problema: o modo nasce desligado, e quem enxerga e não usa leitor de tela não tinha como
// chegar à opção nos Ajustes sem alguém que soubesse o caminho). Um MENU, e não "aperte G": no celular
// não há gesto que vire a tecla G, e as setas e o Enter têm.
//
// Durante a pergunta a tela se desenha mesmo com o modo desligado - é para quem enxerga, e ninguém
// enxergaria uma pergunta em branco -, mas SEM tela cheia: quem joga por som não precisa ver a janela
// tomar a tela por um instante. A fala sai pela voz do jogo quando não há leitor de tela.
void run_graphics_mode_first_run() {
	g_settings.visual_map = true;
	g_visual_map.fullscreen_done = true;
	screen_menu m;
	m.intro_text = tr("visual.first_run_question");
	m.click_sound = "ui/menu_click.ogg";
	m.select_sound = "ui/menu_confirm.ogg";
	m.sounds_prefix = "sounds/";
	// Já em foco: quem enxerga vê de cara qual opção o Enter escolhe, sem ter que descobrir as setas. Antes
	// dos itens: o add_item também lê esta opção.
	m.focus_first_item = true;
	m.add_item(tr("visual.first_run_on"), "on");
	m.add_item(tr("visual.first_run_off"), "off");
	m.run();
	bool ligar = m.selected_item_id == "on";
	g_settings.visual_map = ligar;
	g_settings.visual_map_asked = true;
	g_settings.save();
	// Ligado: a tela cheia entra no próximo quadro desenhado, como em quem liga pelos Ajustes.
	g_visual_map.fullscreen_done = false;
	if (ligar) speak(tr("settings.visual_map_now_on"));
	else g_visual_map.clear_if_needed();
}

// Menu inicial (antes de conectar): conectar, aprender os sons do jogo, ou sair.
// Retorna true se o jogador escolheu conectar (main.nvgt segue o fluxo normal); false = saiu.
bool run_main_menu() {
	while (true) {
		menu_music_play(); // desde a abertura, e de volta depois do treino, do mapa e dos sons (que a calam)
		screen_menu m;
		m.intro_text = tr("app.title");
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		m.sounds_prefix = "sounds/";
		m.add_item(tr("menu.connect"), "connect");
		m.add_item(tr("menu.learn_sounds"), "learn_sounds");
		m.add_item(tr("menu.explore_map"), "explore_map");
		m.add_item(tr("menu.practice"), "practice");
		m.add_item(tr("menu.changelog"), "changelog");
		// Só com a tela de toque ligada (Android): no computador seria uma lista de coisas que não
		// existem ali.
		if (g_touch_enabled) m.add_item(tr("touch.menu_item"), "touch_help");
		m.add_item(tr("menu.settings"), "settings");
		m.add_item(tr("menu.support"), "support");
		m.add_item(tr("menu.exit"), "exit");
		m.run();
		string id = m.selected_item_id;

		if (id == "connect") return true;
		if (id == "learn_sounds") { run_learn_sounds_screen(); continue; }
		if (id == "explore_map") { run_explore_map_screen(); continue; }
		if (id == "practice") { run_practice_screen(); continue; }
		if (id == "changelog") { run_changelog_screen(); continue; }
		if (id == "touch_help") { run_touch_help_screen(); continue; }
		if (id == "settings") { run_settings_menu(); continue; }
		if (id == "support") { run_support_screen(); continue; }
		return false; // "exit", ESC ou fechou sem escolher
	}
	return false; // inalcançável - o laço só termina via return acima
}

// A lista dos gestos, um por item, para ler no ritmo de cada um. É um menu, e não uma fala só, porque
// são onze frases: dita de uma vez, a do meio já teria sido esquecida quando a última acabasse.
void run_touch_help_screen() {
	screen_menu m;
	m.intro_text = tr("touch.menu_item");
	m.click_sound = "ui/menu_click.ogg";
	m.select_sound = "ui/menu_confirm.ogg";
	m.sounds_prefix = "sounds/";
	array<string>@ linhas = tr("touch.help").split("|");
	for (uint i = 0; i < linhas.length(); i++) m.add_item(linhas[i], "" + i);
	m.run();
}

// Monta o catálogo de sons pra aprender (audio/sound_catalog.nvgt) e mostra o menu de preview
// pronto do NVGT (menu.nvgt: learn_game_sounds_menu) - setas navegam, Enter toca o som selecionado.
//
// A lista é escrita à mão (cada som precisa de um nome que diga ao jogador o que ele significa) e por
// isso envelhecia: na 0.50.7 faltavam 28 sons do catálogo e dois pisos - todos os papéis novos, as
// câmeras, o oxigênio. A sonda probe_learn_sounds compara esta lista com o catálogo inteiro e acusa o
// que faltar; o que fica de fora DE PROPÓSITO mora em LEARN_SOUNDS_LEFT_OUT, com o motivo.
//
// Fora de propósito: os sons de DENTRO dos minijogos (eles se aprendem fazendo a tarefa, no treino -
// isolados, "o tique do distribuidor" não diz nada), e o que está reservado e nunca toca.
const array<string> LEARN_SOUNDS_LEFT_OUT = {
	// O interruptor do painel da porta (a Base Polar): de dentro do minijogo, como os de tarefa - os de
	// sounds/tasks/ a sonda já reconhece sozinha; este mora em world/.
	SND_DOOR_SWITCH,
	// De dentro dos PAINÉIS DE REPARO (o teclado do código do oxigênio, o dial das comunicações): como
	// os de minijogo de tarefa, aprendem-se consertando, no treino. Caminhos sem a pasta, como o
	// catálogo os lista (ver all_sound_paths).
	"sounds/" + SND_CODE_KEY, "sounds/" + SND_CODE_GOOD, "sounds/" + SND_CODE_BAD,
	"sounds/" + SND_COMMS_PANEL_OPEN, "sounds/" + SND_COMMS_PANEL_CLOSE,
	"sounds/" + SND_COMMS_DIAL_STEP, "sounds/" + SND_COMMS_RADIO_VOICE
};

// Pergunta o mapa (como o Conhecer o mapa e o treino) e mostra os sons comuns mais os DELE: quem escolhe
// a nave não ouve a neve, e vice-versa (pedido do usuário, 2026-10-19). Com um mapa só, não pergunta.
// Depois, a CATEGORIA (recado #287): são quase cem sons, e numa lista só achar "o som da porta" era
// descer por todos os passos e ambientes antes.
void run_learn_sounds_screen() {
	string qual = choose_map("map.choose_learn");
	if (qual == "") return;
	menu_music_stop(); // o tema por baixo atrapalharia ouvir cada som
	array<learn_category@>@ categorias = learn_sound_categories(build_map(qual));
	while (true) {
		screen_menu c;
		c.intro_text = tr("learn.categories_hint");
		c.click_sound = "ui/menu_click.ogg";
		c.select_sound = "ui/menu_confirm.ogg";
		c.sounds_prefix = "sounds/";
		for (uint i = 0; i < categorias.length(); i++) {
			dictionary@ d = dictionary();
			d.set("name", tr(categorias[i].name_key));
			d.set("count", "" + categorias[i].sfx.size());
			c.add_item(tr("learn.category_item", d), "" + i);
		}
		c.add_item(tr("menu.back"), "__back__");
		c.run();
		string id = c.selected_item_id;
		if (id == "" || id == "__back__") return;
		screen_menu m;
		// Fica mesmo com as dicas desligadas: com o título vazio, o learn_game_sounds_menu do NVGT põe o
		// dele, em inglês.
		m.intro_text = tr("learn.menu_hint");
		m.sounds_prefix = "sounds/";
		// Os sons de navegar e confirmar, como todo menu do jogo. Sem eles esta era a única lista muda ao
		// andar (relato do usuário: "o som de interface não está funcionando lá").
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		learn_game_sounds_menu(categorias[parse_int(id)].sfx, "", @m, tr("menu.back"));
	}
}

class learn_category {
	string name_key;
	name_value_collection@ sfx = name_value_collection();
	learn_category(const string&in name_key) { this.name_key = name_key; }
}

// Todos os sons do mapa numa lista só, na ordem das categorias: é o que a sonda compara com o catálogo.
name_value_collection@ learn_sounds_collection(game_map@ map) {
	name_value_collection@ todos = name_value_collection();
	array<learn_category@>@ categorias = learn_sound_categories(map);
	for (uint c = 0; c < categorias.length(); c++)
		for (uint i = 0; i < categorias[c].sfx.size(); i++) todos.add(categorias[c].sfx.name_at(i), categorias[c].sfx.value_at(i));
	return todos;
}

// O rótulo dos passos de cada piso. Piso novo entra aqui também (ver som.md, "piso novo entra em DUAS
// tabelas"); um piso sem rótulo aparece com o nome cru, e a sonda acusa.
string footstep_learn_key(const string&in prefix) {
	if (prefix == "Tile") return "learn.footstep_tile";
	if (prefix == "MetalTile") return "learn.footstep_metal";
	if (prefix == "EarthTile") return "learn.footstep_earth";
	if (prefix == "WoodTile") return "learn.footstep_wood";
	if (prefix == "MetalBeltTile") return "learn.footstep_belt";
	if (prefix == "VentTile") return "learn.footstep_vent";
	if (prefix == "O2Tile") return "learn.footstep_o2";
	if (prefix == "ConcreteTile") return "learn.footstep_concrete";
	if (prefix == "SnowTile") return "learn.footstep_snow";
	return "";
}

bool map_has_task(game_map@ map, const string&in task_type) {
	for (uint i = 0; i < map.objects.length(); i++)
		if (map.objects[i].obj_type == OBJ_TASK_SPOT && map.objects[i].task_type == task_type) return true;
	return false;
}

array<learn_category@>@ learn_sound_categories(game_map@ map) {
	learn_category passos("learn.cat_steps"), lugares("learn.cat_places"), marcadores("learn.cat_markers"),
		partida("learn.cat_match"), papeis("learn.cat_roles"), menus("learn.cat_interface");
	// `sfx` aponta para a categoria do trecho: cada bloco abaixo troca a categoria antes de somar.
	name_value_collection@ sfx = passos.sfx;

	// A parte do MAPA sai do próprio mapa, e não de uma lista à mão: a lista à mão envelhecia calada (na
	// 0.50.7 faltavam 28 sons), e com dois mapas seriam duas para esquecer. O que é do mapa: os pisos das
	// salas dele, os ambientes, os marcadores de tudo que tem lá, o som geral, o scanner e a câmara.

	// Um piso por som: reconhecer o chão é como se sabe em que sala se está sem perguntar nada.
	//
	// As variantes vão como lista separada por vírgula (ver sound_variants_list) e NÃO na forma
	// abreviada "Tile{1...6}.ogg". A forma abreviada só existe em versões recentes do menu.nvgt; nas
	// mais antigas o texto com chaves é entregue direto ao carregador de som, que procura um arquivo
	// chamado "Tile{1...6}.ogg", não encontra, e fica mudo sem reclamar de nada.
	array<string> pisos;
	for (uint i = 0; i < map.zones.length(); i++)
		if (pisos.find(map.zones[i].floor_sound_prefix) < 0) pisos.insert_last(map.zones[i].floor_sound_prefix);
	if (map.objects_by_type(OBJ_VENT).length() > 0) pisos.insert_last("VentTile"); // o passo dentro do duto
	for (uint i = 0; i < pisos.length(); i++) {
		string chave = footstep_learn_key(pisos[i]);
		sfx.add(chave != "" ? tr(chave) : pisos[i], footstep_variants_list(pisos[i]));
	}

	@sfx = lugares.sfx;
	// Os ambientes, na ordem do mapa, um por som (a passagem e o vento se repetem por corredor).
	array<string> ja;
	for (uint i = 0; i < map.objects.length(); i++) {
		map_object@ o = map.objects[i];
		if (o.obj_type != OBJ_DECORATION || o.sound_path == "" || ja.find(o.sound_path) >= 0) continue;
		ja.insert_last(o.sound_path);
		string nome;
		if (o.name_key.starts_with("room.")) nome = tr("learn.ambient_prefix") + tr(o.name_key);
		else if (o.sound_path == SND_PASSAGE) nome = tr("learn.passage");
		else if (o.name_key == "outside") nome = tr("learn.outside");
		else nome = tr(o.name_key);
		sfx.add(nome, o.sound_path);
	}
	if (map.ship_ambience != "") sfx.add(tr("learn.ship_ambience"), map.ship_ambience);

	@sfx = marcadores.sfx;
	// Os marcadores: o botão, os painéis, os dutos, as câmeras e cada tarefa - um por som, com o nome
	// do ponto (o galão tem dois marcadores, e o nome de cada ponta diz qual é qual).
	for (uint i = 0; i < map.objects.length(); i++) {
		map_object@ o = map.objects[i];
		if (o.beacon_sound_path == "" || ja.find(o.beacon_sound_path) >= 0) continue;
		string nome;
		if (o.obj_type == OBJ_EMERGENCY_BUTTON) nome = tr("learn.button_beacon");
		else if (o.obj_type == OBJ_SABOTAGE_PANEL) nome = tr("learn.panel_" + o.task_type + "_beacon");
		else if (o.obj_type == OBJ_VENT) nome = tr("learn.vent_beacon");
		else if (o.obj_type == OBJ_SECURITY_CAMERAS) nome = tr("learn.camera_beacon");
		else if (o.obj_type == OBJ_TASK_SPOT) nome = tr("learn.task_beacon_prefix") + tr(o.name_key);
		else continue;
		ja.insert_last(o.beacon_sound_path);
		sfx.add(nome, o.beacon_sound_path);
	}
	@sfx = partida.sfx;
	if (map_has_task(map, "submit_scan"))
		sfx.add(tr("learn.medbay_scan"), "sounds/" + SND_MEDBAY_SCAN);
	if (map.decontamination_zone != "") {
		sfx.add(tr("learn.decontamination_close"), SND_DECONTAMINATION_CLOSE);
		sfx.add(tr("learn.decontamination_spray"), SND_DECONTAMINATION_SPRAY);
		sfx.add(tr("learn.decontamination_open"), SND_DECONTAMINATION_OPEN);
	}
	if (map.has_sabotage("contamination")) sfx.add(tr("learn.cough"), SND_COUGH);
	if (map.objects_by_type(OBJ_SECURITY_CAMERAS).length() > 0) {
		sfx.add(tr("learn.camera_on"), SND_CAMERA_ON);
		sfx.add(tr("learn.camera_switch"), SND_CAMERA_SWITCH);
		sfx.add(tr("learn.camera_off"), SND_CAMERA_OFF);
		sfx.add(tr("learn.camera_watching"), SND_CAMERA_WATCHING);
	}

	sfx.add(tr("learn.sabotage_alarm"), SND_SABOTAGE_ALARM);
	sfx.add(tr("learn.body_on_floor"), SND_BODY_ON_FLOOR);
	sfx.add(tr("learn.body_reported"), SND_BODY_REPORTED);
	// Mesmo motivo dos passos: lista por vírgula, não a forma abreviada com chaves.
	sfx.add(tr("learn.death"), sound_variants_list("death", int(KILLED_VARIANT_COUNT_FOR_CATALOG), "ogg", "events"));
	sfx.add(tr("learn.kill"), SND_KILL);
	sfx.add(tr("learn.wall_bump"), SND_WALL_BUMP);
	sfx.add(tr("learn.door_bump"), SND_DOOR_BUMP);
	sfx.add(tr("learn.door_close"), SND_DOOR_CLOSE);
	sfx.add(tr("learn.door_open"), SND_DOOR_OPEN);
	sfx.add(tr("learn.vent_door"), SND_VENT_DOOR_1 + "," + SND_VENT_DOOR_2);
	sfx.add(tr("learn.panel_open"), SND_OPEN_PANEL);
	sfx.add(tr("learn.panel_close"), SND_PANEL_CLOSE);
	sfx.add(tr("learn.meeting_alarm"), SND_MEETING_ALARM);
	sfx.add(tr("learn.target_in_range"), SND_TARGET_IN_RANGE);


	@sfx = papeis.sfx;
	// Papéis e o que eles fazem soar.
	sfx.add(tr("learn.shield_cast"), SND_SHIELD_CAST);
	sfx.add(tr("learn.veteran_alert"), SND_VETERAN_ALERT);
	sfx.add(tr("learn.shape_shift"), SND_SHAPE_SHIFT);
	sfx.add(tr("learn.vanish"), SND_VANISH);
	sfx.add(tr("learn.wolf_swallow"), SND_WOLF_SWALLOW);
	sfx.add(tr("learn.body_clean"), SND_BODY_CLEAN);
	sfx.add(tr("learn.body_drag"), SND_BODY_DRAG);
	sfx.add(tr("learn.body_eaten"), SND_BODY_EATEN);
	sfx.add(tr("learn.poison"), SND_POISON);
	sfx.add(tr("learn.sound_bomb"), SND_SOUND_BOMB);
	sfx.add(tr("learn.miner_dig"), SND_MINER_DIG);
	sfx.add(tr("learn.deaf_ringing"), SND_DEAF_RINGING);
	sfx.add(tr("learn.doctor_revive"), SND_DOCTOR_REVIVE);
	sfx.add(tr("learn.noisemaker_alarm"), SND_NOISEMAKER_ALARM);
	sfx.add(tr("learn.arsonist_fire"), SND_ARSONIST_FIRE);
	sfx.add(tr("learn.heartbeat"), SND_HEARTBEAT);
	sfx.add(tr("learn.drunk_can"), SND_DRUNK_CAN);
	sfx.add(tr("learn.addict_song"), SND_ADDICT_SONG);

	@sfx = partida.sfx;
	sfx.add(tr("learn.start_game"), SND_START_GAME);
	sfx.add(tr("learn.victory_crew"), SND_VICTORY_CREW);
	sfx.add(tr("learn.victory_impostor"), SND_VICTORY_IMPOSTOR);
	sfx.add(tr("learn.victory_neutral"), SND_VICTORY_DISCONNECT);
	@sfx = menus.sfx;
	sfx.add(tr("learn.player_enter"), SND_PLAYER_ENTER);
	sfx.add(tr("learn.player_leave"), SND_PLAYER_LEAVE);
	sfx.add(tr("learn.hall_room_open"), SND_HALL_ROOM_OPEN);
	sfx.add(tr("learn.hall_match_started"), SND_HALL_MATCH_STARTED);
	sfx.add(tr("learn.menu_click"), SND_MENU_CLICK);
	sfx.add(tr("learn.menu_confirm"), SND_MENU_CONFIRM);
	sfx.add(tr("learn.message_sent"), SND_MESSAGE_SENT);
	sfx.add(tr("learn.message_received"), SND_MESSAGE_RECEIVED);
	sfx.add(tr("learn.dialog_open"), SND_DIALOG_OPEN);
	sfx.add(tr("learn.dialog_close"), SND_DIALOG_CLOSE);
	@sfx = partida.sfx;
	sfx.add(tr("learn.radar_beep"), SND_RADAR_BEEP);
	sfx.add(tr("learn.vote_select"), SND_VOTE_SELECT);
	sfx.add(tr("learn.vote_confirm"), SND_VOTE_CONFIRM);
	sfx.add(tr("learn.vote_timer"), SND_VOTE_TIMER);
	sfx.add(tr("learn.countdown_tick"), SND_COUNTDOWN_TICK);
	sfx.add(tr("learn.ejected"), SND_EJECTED);
	sfx.add(tr("learn.task_inprogress"), "sounds/" + SND_TASK_INPROGRESS);
	sfx.add(tr("learn.task_complete"), "sounds/" + SND_TASK_COMPLETE);
	sfx.add(tr("learn.breaker_switch"), "sounds/" + SND_BREAKER_SWITCH);
	sfx.add(tr("learn.comms_static"), "sounds/" + SND_COMMS_STATIC);
	sfx.add(tr("learn.meeting_result"), SND_MEETING_RESULT);
	@sfx = menus.sfx;
	sfx.add(tr("learn.intro"), SND_INTRO);

	array<learn_category@> r = {passos, lugares, marcadores, partida, papeis, menus};
	for (int i = int(r.length()) - 1; i >= 0; i--) if (r[i].sfx.size() == 0) r.remove_at(i);
	return r;
}

// Conecta ao servidor e retorna true se a conexão foi estabelecida.
// Não existe mais tela pedindo o endereço: o jogo vai direto pro servidor oficial, e quem precisa
// de outro (testar contra um server_main local) usa o server.txt - ver config/server_address.nvgt.
bool connect_to_server(game_client@ client) {
	server_address address = resolve_server_address();
	speak(tr("menu.connecting")); // sem isto ficam alguns segundos de silêncio total até dar certo ou falhar

	// O nome que não resolve faz o connect_to falhar na hora; aí vale a reserva (o IP de hoje). Só para
	// o servidor oficial: quem apontou outro no server.txt quer exatamente aquele.
	bool conectando = client.connect_to(address.host, address.port);
	if (!conectando && !address.from_override && address.host != FALLBACK_SERVER_IP) {
		log_diagnostic("o nome " + address.host + " nao resolveu; tentando o IP de reserva");
		conectando = client.connect_to(FALLBACK_SERVER_IP, address.port);
	}
	if (!conectando) {
		speak(tr("menu.connect_failed"));
		return false;
	}

	// Espera a confirmação de conexão do ENet (evento event_connect) por alguns segundos.
	timer@ wait_clock = timer();
	while (float(wait_clock.elapsed) / 1000.0 < 5.0) {
		wait(20);
		client.update();
		if (client.connected) return true;
	}
	speak(tr("menu.connect_failed"));
	return false;
}

// A conexão das tentativas de volta (reconnect_to_match): a mesma do connect_to_server, sem falar nada -
// a cada poucos segundos, um "conectando" por cima da própria tentativa seria só ruído.
bool connect_quietly(game_client@ client, uint wait_ms) {
	server_address address = resolve_server_address();
	bool conectando = client.connect_to(address.host, address.port);
	if (!conectando && !address.from_override && address.host != FALLBACK_SERVER_IP)
		conectando = client.connect_to(FALLBACK_SERVER_IP, address.port);
	if (!conectando) return false;
	timer espera;
	while (espera.elapsed < wait_ms) {
		wait(20);
		client.update();
		if (client.connected) return true;
	}
	return false;
}

// O primeiro pacote deste tipo, esperando até `ms` (null se não chegou, ou se a conexão caiu).
net_packet@ wait_for_packet_type(game_client@ client, const string&in type, uint ms) {
	timer espera;
	while (espera.elapsed < ms) {
		wait(20);
		client.update();
		if (!client.connected) return null;
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == type) return pkt;
			@pkt = client.poll_message();
		}
	}
	return null;
}

// A conexão caiu no meio da partida: tenta VOLTAR a ela (ver REJOIN_PROTOCOL). O servidor guarda o lugar
// por um minuto; aqui se insiste por REJOIN_CLIENT_TRY_MS, reconectando e entrando com o token de volta
// (só na memória - a senha nunca é guardada). Devolve o S_GAME_START de volta, ou null se não deu: o lugar
// já não existe (a partida acabou, o prazo venceu, o servidor reiniciou), a rede não voltou a tempo, ou a
// pessoa desistiu com Esc. O caso que isto resolve (2026-10-13): quedas de rede de alguns segundos que
// derrubavam gente no meio da partida, com o servidor de pé.
net_packet@ reconnect_to_match(game_client@ client) {
	string token = client.rejoin_token;
	if (token == "") { speak(tr("net.connection_lost")); return null; }
	speak(tr("net.rejoin_trying"));
	g_net_stall_context = "voltando a partida";
	timer total;
	bool desistiu = false;
	while (total.elapsed < REJOIN_CLIENT_TRY_MS && !desistiu) {
		client.clear_incoming();
		if (connect_quietly(client, 4000)) {
			client.send_login_rejoin(token);
			net_packet@ r = wait_for_packet_type(client, S_LOGIN_RESULT, 5000);
			if (@r != null) {
				// Recusado: o servidor não tem mais o lugar. Insistir não muda isso.
				if (!r.get_bool("ok") || !r.get_bool("rejoin")) break;
				client.my_peer_id = r.get_uint64("peer_id");
				client.rejoin_token = r.get_string("rejoin_token", "");
				net_packet@ inicio = wait_for_packet_type(client, S_GAME_START, 5000);
				if (@inicio != null) return inicio;
				break;
			}
		}
		client.disconnect();
		// Uma pausa entre tentativas, com o Esc ouvido: a rede pode levar alguns segundos para voltar.
		timer pausa;
		while (pausa.elapsed < 2000) {
			wait(20);
			if (key_pressed(KEY_ESCAPE)) { desistiu = true; break; }
		}
	}
	client.disconnect();
	speak(tr("net.rejoin_failed"));
	return null;
}

// Tela combinada de login/cadastro. Envia C_LOGIN ou C_REGISTER e espera a resposta do servidor.
// Em caso de cadastro bem sucedido, tenta logar automaticamente com as mesmas credenciais.
// Reutiliza a classe login_result (database/models.nvgt): campo "ok" indica sucesso, "username" o
// nome final autenticado (o campo "message" não é usado aqui).
login_result run_login_screen(game_client@ client) {
	login_result result;

	// "Lembrar de mim": há um token de sessão guardado, então tenta entrar com ele antes de mostrar
	// o formulário. Se o servidor recusar (token vencido, conta apagada, servidor antigo), o token
	// é esquecido e o formulário aparece como sempre - com a senha em branco, que nunca é guardada.
	if (g_settings.session_token != "") {
		dictionary@ p = dictionary();
		p.set("name", g_settings.last_username);
		speak(tr("login.remembered", p));
		client.send_login_token(g_settings.session_token);
		if (wait_for_auth_result(client, false, g_settings.last_username, "", result, true)) return result;
		g_settings.session_token = "";
		g_settings.save();
	}

	audio_form f;
	screen_keyboard_follower teclado_tela;
	f.create_window(tr("menu.login"), false); // não sobrescreve o título da janela (nome do jogo)
	// Já vem com o último usuário que entrou nesta máquina; se houver um, o foco pula direto pra
	// senha, que é o único campo que ainda precisa ser digitado.
	int f_user = f.create_input_box(tr("login.username"), g_settings.last_username);
	int f_pass = f.create_input_box(tr("login.password"), "", "*");
	// Mostrar a senha (recado #288): o campo continua mascarado para o leitor (o NVGT não troca a máscara
	// de um campo criado), mas ligada, a caixa fala a senha digitada até ali e a mostra na tela.
	int f_show = f.create_checkbox(tr("login.show_password"), false);
	g_visual_show_passwords = false;
	bool mostrando = false;
	// Marcado por padrão: quem joga todo dia não quer digitar senha todo dia. O que fica no disco é
	// um token que o servidor emite e pode revogar - a senha em si nunca é gravada.
	int f_remember = f.create_checkbox(tr("login.remember"), true);
	int f_login = f.create_button(tr("menu.login"), true);
	int f_register = f.create_button(tr("menu.register"));
	int f_forgot = f.create_button(tr("forgot.button"));
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	// Sempre focar algo: um audio_form nasce sem foco, e sem isto quem entra pela primeira vez (sem
	// usuário salvo) digitava no vazio até apertar Tab.
	f.focus(g_settings.last_username != "" ? f_pass : f_user);

	while (true) {
		wait(5);
		client.update();
		f.monitor();
		teclado_tela.follow(f);
		bool mostrar = f.is_checked(f_show);
		if (mostrar != mostrando) {
			mostrando = mostrar;
			g_visual_show_passwords = mostrar;
			string digitada = f.get_text(f_pass);
			if (mostrar && digitada != "") {
				dictionary@ p = dictionary();
				p.set("password", digitada);
				speak(tr("login.password_is", p), false);
			}
		}
		if (f.is_pressed(f_cancel)) { g_visual_show_passwords = false; return result; }
		// O cadastro tem tela própria (1.0): a senha duas vezes e o e-mail, que pede um código.
		if (f.is_pressed(f_register)) {
			if (run_register_screen(client, f.get_text(f_user), f.get_text(f_pass), result, f.is_checked(f_remember))) {
				g_visual_show_passwords = false;
				return result;
			}
			continue;
		}
		if (f.is_pressed(f_forgot)) { run_forgot_password_screen(client, f.get_text(f_user)); continue; }

		if (f.is_pressed(f_login)) {
			string username = f.get_text(f_user);
			string password = f.get_text(f_pass);
			if (username.empty() || password.empty()) continue;

			bool remember = f.is_checked(f_remember);
			client.send_login(username, password, remember);

			if (!wait_for_auth_result(client, false, username, password, result, false, remember)) continue;
			g_visual_show_passwords = false;
			return result;
		}
	}
	return result; // inalcançável - o laço só termina via return acima
}

// Aguarda S_REGISTER_RESULT ou S_LOGIN_RESULT do servidor. Se o cadastro deu certo, envia login
// automaticamente em seguida e espera o resultado desse login também.
bool wait_for_auth_result(game_client@ client, bool was_register, const string&in username,
		const string&in password, login_result@ result, bool by_token = false, bool remember = false) {
	timer@ wait_clock = timer();
	bool logging_in_after_register = false;

	while (float(wait_clock.elapsed) / 1000.0 < 8.0) {
		wait(20);
		client.update();
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_REGISTER_RESULT && was_register && !logging_in_after_register) {
				if (!pkt.get_bool("ok")) {
					// O servidor manda a CHAVE do erro ("login.username_taken",
					// "login.invalid_password_length"...), e quem traduz é este cliente, no idioma
					// dele. Antes isto comparava com "username_taken" sem o prefixo - comparação que
					// nunca batia - e no resto dos casos falava a própria chave crua na tela.
					speak(tr(pkt.get_string("message")));
					return false;
				}
				speak(tr("login.register_success"));
				client.send_login(username, password, remember);
				logging_in_after_register = true;
				wait_clock.restart();
			} else if (pkt.type == S_LOGIN_RESULT) {
				if (!pkt.get_bool("ok")) {
					// O servidor manda a chave do motivo, mas até a 0.29.4 o cliente a ignorava e
					// dizia "credenciais inválidas" para qualquer falha. A recusa por protocolo velho
					// é o caso em que isso engana de verdade: a pessoa reveria a senha em vez de
					// atualizar. Ela faz o que o updater faz quando não consegue instalar: avisa e
					// abre a página de download.
					if (pkt.get_string("message") == "login.update_required") {
						speak(tr("login.update_required"));
						urlopen(DOWNLOAD_PAGE_URL);
						return false;
					}
					speak(tr(by_token ? "login.remembered_failed" : "login.invalid_credentials"));
					return false;
				}
				speak(tr("login.success"));
				// O token novo (se pedimos para lembrar) substitui o anterior; um login sem "lembrar"
				// apaga o que havia, para um computador emprestado não ficar com a sessão de alguém.
				if (!by_token) g_settings.session_token = pkt.get_string("session_token", "");
				// A partir daqui o cliente sabe com que id o servidor o identifica - tudo que compara
				// peer_id vindo de pacote (anfitrião, voto, chat, radar) depende disso estar certo.
				client.my_peer_id = pkt.get_uint64("peer_id");
				// O token de volta (só na memória) e se o servidor tinha o lugar desta conta guardado
				// numa partida - quem caiu e abriu o jogo de novo volta direto para ela.
				client.rejoin_token = pkt.get_string("rejoin_token", "");
				result.rejoin = pkt.get_bool("rejoin", false);
				result.ok = true;
				result.username = pkt.get_string("username", username);
				g_account_email = pkt.get_string("email", "");
				g_account_stats_visible = pkt.get_bool("stats_visible", true);
				// Guarda pra próxima vez. Só depois do login DAR CERTO: gravar antes deixaria um nome
				// errado esperando o jogador na abertura seguinte.
				g_settings.last_username = result.username;
				g_settings.save();
				return true;
			}
			@pkt = client.poll_message();
		}
	}
	speak(tr("menu.connect_failed"));
	return false;
}
