// explore_screen.nvgt
// Conhecer o mapa: andar pela nave sozinho, sem servidor, sem partida, sem pressão.
//
// Num jogo sem imagem, "ver o mapa" é isto - percorrê-lo com calma até o desenho das salas e dos
// corredores ficar na cabeça. Foi o pedido por trás de quatro recados diferentes ("um mapa", "um
// jeito de se orientar", "onde ficam as salas"): o problema não era falta de informação, era ter
// de aprendê-la enquanto um impostor anda por perto.
//
// Roda INTEIRAMENTE no cliente. O mapa, os ambientes de sala, os passos por piso, os marcadores e
// o radar de objetos já são locais na partida de verdade - o servidor só entra para saber onde os
// OUTROS estão, e aqui não há outros. Por isso nada de rede: quem quer só andar não precisa nem
// estar logado.
//
// O que existe aqui é deliberadamente pouco: andar, ouvir, o radar de objetos, a tecla de "onde
// estou" - e o que se aprende ONDE fica: as TAREFAS (recado #217, decisão do usuário: todas as do
// mapa), os PAINÉIS de reparo, todos tocando o marcador como se cada sabotagem estivesse no ar, e os
// DUTOS, com o menu de viagem (pedido do usuário, 2026-10-14: antes os dois apareciam e não faziam
// nada, e o painel nem tocava). O menu de treino ensina a tarefa; aqui se treina com o caminho até
// ela, que é o que a partida cobra. Câmeras e botão só dizem o que são.

#include "speech.nvgt"
#include "../audio/menu_music.nvgt"
#include "../audio/audio_manager.nvgt"
#include "../game/map.nvgt"
#include "../config/keybindings.nvgt"
#include "../config/game_constants.nvgt"
#include "../i18n.nvgt"
#include "../core/frame_timer.nvgt"
#include "../game/exit_alignment.nvgt"
#include "../core/touch_input.nvgt"
#include "practice_screen.nvgt"
#include "visual_map.nvgt"

// A fase que um ponto de tarefa representa: o depósito é a fase 0 de abastecer os motores, o motor é a
// 1. Cada ponto treina a SUA etapa - o caminho entre uma e outra é o jogador que faz, como na partida.
uint explore_phase_of(game_map@ map, map_object@ obj) {
	for (uint i = 0; i < map.chains.length(); i++) {
		if (map.chains[i].task_type != obj.task_type) continue;
		int fase = map.chains[i].object_ids.find(obj.id);
		if (fase >= 0) return uint(fase);
	}
	return 0;
}

// Velocidade de andar no mapa, em por cento do padrão (recado #204). Mais e menos mudam de 25 em 25, na
// mesma faixa que uma sala aceita (MOVE_SPEED_MIN/MAX_PERCENT): quem treina para uma sala rápida anda
// rápido aqui também. Guardada enquanto o jogo está aberto, e não nas preferências: é o momento, não um
// gosto - e voltar ao mapa sem ter de ajustar de novo é o que se espera de uma tecla.
int g_explore_speed_percent = 100;
const int EXPLORE_SPEED_STEP_PERCENT = 25;

void explore_change_speed(int passo) {
	int nova = g_explore_speed_percent + passo;
	if (nova < MOVE_SPEED_MIN_PERCENT) nova = MOVE_SPEED_MIN_PERCENT;
	if (nova > MOVE_SPEED_MAX_PERCENT) nova = MOVE_SPEED_MAX_PERCENT;
	g_explore_speed_percent = nova;
	dictionary@ p = dictionary();
	p.set("percent", "" + nova);
	speak(tr("explore.speed", p));
}

void run_explore_map_screen() {
	menu_music_stop();
	game_map@ map = build_the_hub_map();
	audio_manager@ audio = audio_manager();

	// Todos os pontos de task contam como "seus": o objetivo é saber que eles existem e onde ficam.
	array<string> all_task_ids;
	for (uint i = 0; i < map.objects.length(); i++) {
		if (map.objects[i].obj_type == OBJ_TASK_SPOT) all_task_ids.insert_last(map.objects[i].id);
	}

	float my_x = 0.0, my_y = 0.0; // centro da cafeteria, onde toda partida começa
	audio.update_listener(my_x, my_y);
	audio.start_ship_ambience();
	audio.start_room_ambience(map);
	// Todos os painéis tocam: aqui não há sabotagem, e é onde se aprende onde cada um fica.
	audio.start_landmark_beacons(map, all_task_ids, BEACON_ALL_PANELS);

	speak(tr("explore.intro"));

	string last_zone_id = "";
	string last_object_id = "";
	int object_index = -1;
	string object_room_id = "";
	frame_timer frame_clock;
	timer footstep_clock;
	timer wall_bump_clock;
	exit_alignment exits; // o mesmo aviso de saída da partida: é aqui que se aprende onde ficam as portas
	game_client@ offline = make_offline_client(); // a minigame pede um cliente; este não fala com ninguém
	get_characters(); // o que foi digitado ANTES (num formulário) não pode mudar a velocidade na entrada

	while (true) {
		wait(5);
		touch_match_frame(); // o manche do toque anda aqui como na partida - é onde se aprende o mapa
		float delta = frame_clock.tick(); // sem perder frações - ver core/frame_timer.nvgt
		if (delta > 0.1) delta = 0.1; // mesmo teto do laço da partida: um quadro longo não arremessa ninguém

		if (key_pressed(KEY_ESCAPE)) break;
		exits.update(map, audio, my_x, my_y);
		// Pelo CARACTERE digitado, e não pela tecla: KEY_EQUALS/KEY_MINUS são POSIÇÕES do teclado
		// americano, e no espanhol o "+" e o "-" ficam em outras teclas - a 0.50.6 não mudava a velocidade
		// para quem joga em espanhol (recado #209). O caractere é o mesmo em qualquer disposição, com ou
		// sem Shift. O numérico também gera o caractere; a tecla dele fica só de reserva, para quando nada
		// for digitado (sem NumLock) - lida sempre, para não sobrar aperto, e usada só nesse caso, senão um
		// aperto valeria dois passos. Mais e menos do numérico são de leitor de tela no NVDA e no JAWS.
		string digitado = get_characters();
		bool mais = digitado.find("+") >= 0 || digitado.find("=") >= 0;
		bool menos = digitado.find("-") >= 0;
		bool numerico_mais = key_pressed(KEY_NUMPAD_PLUS);
		bool numerico_menos = key_pressed(KEY_NUMPAD_MINUS);
		if (!mais && !menos) { mais = numerico_mais; menos = numerico_menos; }
		if (mais) explore_change_speed(EXPLORE_SPEED_STEP_PERCENT);
		else if (menos) explore_change_speed(-EXPLORE_SPEED_STEP_PERCENT);
		float velocidade = move_speed_for_percent(g_explore_speed_percent);

		float dx = 0.0, dy = 0.0;
		if (action_down(ACTION_MOVE_NORTH)) dy -= 1.0;
		if (action_down(ACTION_MOVE_SOUTH)) dy += 1.0;
		if (action_down(ACTION_MOVE_WEST)) dx -= 1.0;
		if (action_down(ACTION_MOVE_EAST)) dx += 1.0;

		if (dx != 0.0 || dy != 0.0) {
			float len = sqrt(dx * dx + dy * dy);
			dx /= len;
			dy /= len;
			float new_x = my_x + dx * velocidade * delta;
			float new_y = my_y + dy * velocidade * delta;

			if (map.can_move(my_x, my_y, new_x, new_y, true)) {
				my_x = new_x;
				my_y = new_y;
				audio.update_listener(my_x, my_y);

				map_zone@ zone = map.zone_at(my_x, my_y);
				string zone_id = @zone != null ? zone.id : "";
				if (zone_id != last_zone_id) {
					last_zone_id = zone_id;
					if (@zone != null) speak(tr(zone.name_key));
				}

				// Anuncia qualquer objeto de que se chega perto - aqui não há "meu" e "dos outros",
				// tudo é referência da nave.
				map_object@ nearby = nearest_object(map, my_x, my_y);
				string nearby_id = @nearby != null ? nearby.id : "";
				if (nearby_id != last_object_id) {
					last_object_id = nearby_id;
					if (@nearby != null) speak(object_name(nearby));
				}

				// O passo acompanha a velocidade, como na partida - correndo, um intervalo fixo soaria lento.
				if (float(footstep_clock.elapsed) / 1000.0 >= footstep_interval_for(velocidade)) {
					footstep_clock.restart();
					string prefix = @zone != null ? zone.floor_sound_prefix : "Tile";
					audio.play_footstep(prefix, footstep_variant_count(prefix), my_x, my_y);
				}
			} else if (float(wall_bump_clock.elapsed) / 1000.0 >= WALL_BUMP_INTERVAL_SECONDS) {
				wall_bump_clock.restart();
				audio.play_wall_bump(my_x, my_y);
			}
		}

		// Radar de objetos, igual ao da partida (Tab / Shift+Tab). Só o modo de objetos existe aqui:
		// o de jogadores pergunta ao servidor, e não há nem servidor nem jogadores.
		if (action_pressed(ACTION_RADAR)) {
			string room_id = map.room_id_at(my_x, my_y);
			array<map_object@>@ objects = interactables_in_room(map, room_id, my_x, my_y, all_task_ids, "");
			if (objects.length() == 0) {
				speak(tr("radar.no_objects_here"));
			} else {
				if (room_id != object_room_id) { object_room_id = room_id; object_index = -1; }
				int direction = (key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) ? -1 : 1;
				object_index = (object_index + direction) % int(objects.length());
				if (object_index < 0) object_index += int(objects.length());
				map_object@ target = objects[object_index];
				audio.play_radar_beep(target.x, target.y);
				speak(object_name(target));
			}
		}

		if (action_pressed(ACTION_ROOM_INFO)) {
			map_zone@ zone = map.zone_at(my_x, my_y);
			dictionary@ p = dictionary();
			p.set("room", @zone != null ? tr(zone.name_key) : tr("game.nothing_nearby"));
			p.set("x", "" + int(my_x));
			p.set("y", "" + int(my_y));
			speak(tr("game.location_info", p));
		}

		// Enter num ponto de tarefa abre a tarefa, a mesma minigame da partida; num painel de reparo, o
		// conserto daquela sabotagem; num duto, o menu de dentro dele. Nos outros objetos (câmeras,
		// botão), diz o que ele é. É o lugar de treinar tudo isso onde fica, sem o relógio correndo.
		if (action_pressed(ACTION_INTERACT)) {
			map_object@ obj = nearest_object(map, my_x, my_y);
			if (@obj != null && obj.obj_type == OBJ_TASK_SPOT && obj.task_type != "") {
				bool ok = run_task_minigame(offline, obj.task_type, explore_phase_of(map, obj));
				speak(tr(ok ? "practice.done" : "practice.not_done"));
				frame_clock.tick(); // o tempo da minigame não vira um passo
			} else if (@obj != null && obj.obj_type == OBJ_SABOTAGE_PANEL) {
				// O painel guarda a sabotagem dele no task_type (ver landmark_beacon_on). O código do
				// oxigênio vem do servidor na partida; aqui é sorteado, como no treino de reparos.
				string codigo = "";
				for (uint i = 0; i < 5; i++) codigo += "" + random(0, 9);
				bool ok = run_sabotage_panel(offline, obj.task_type, codigo, obj.id);
				speak(tr(ok ? "practice.done" : "practice.not_done"));
				frame_clock.tick();
			} else if (@obj != null && obj.obj_type == OBJ_VENT) {
				explore_vent(map, audio, obj, my_x, my_y);
				last_zone_id = map.room_id_at(my_x, my_y); // a sala do duto de saída: sem anunciá-la de novo ao andar
				last_object_id = "";
				frame_clock.tick();
			} else {
				speak(@obj != null ? object_name(obj) + ". " + tr("explore.object_hint") : tr("game.nothing_nearby"));
			}
		}

		// O mapa na tela, para quem enxerga: aqui não há outros jogadores, e todo ponto de tarefa é seu,
		// como nos marcadores sonoros desta tela.
		if (g_settings.visual_map) g_visual_map.handle_keys(); // F11: tela cheia
		if (g_settings.visual_map) g_visual_map.draw(map, my_x, my_y, COLOR_RED, true, false, null, null, all_task_ids, BEACON_ALL_PANELS);
		else g_visual_map.clear_if_needed();
	}
	g_visual_map.clear_if_needed(); // de volta ao menu: a janela não fica com a nave parada
	audio.stop_room_ambience();
	audio.stop_landmark_beacons();
}

// Dentro de um duto, no treino: o mesmo menu da partida (sair aqui, ou ir a outro duto da mesma rede),
// com a viagem feita aqui mesmo - não há servidor, e não há ninguém para ouvir a tampa. Na partida só o
// impostor e o engenheiro entram; aqui qualquer um, porque é onde se aprende para onde cada duto leva.
// ESC também sai, diferente da partida (lá ele só fecha o menu e o jogador continua escondido): aqui não
// há do que se esconder, e ficar preso no menu sem saber a tecla de sair seria o único jeito de travar.
void explore_vent(game_map@ map, audio_manager@ audio, map_object@ vent, float&inout x, float&inout y) {
	audio.play_object_interact(vent);
	speak(tr("game.vent_entered"));
	map_object@ atual = vent;
	while (true) {
		screen_menu m;
		m.intro_text = tr("game.vent_menu_hint");
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		m.sounds_prefix = "sounds/";
		m.add_item(tr("game.vent_exit"), "__exit__");
		array<string>@ ligados = map.vent_connections(atual);
		for (uint i = 0; i < ligados.length(); i++) {
			map_object@ dest = map.find_object(ligados[i]);
			if (@dest == null) continue;
			map_zone@ zone = map.find_zone(dest.room_id);
			dictionary@ p = dictionary();
			p.set("room", @zone != null ? tr(zone.name_key) : tr(dest.name_key));
			m.add_item(tr("game.vent_destination", p), dest.id);
		}
		m.run();
		string escolha = m.selected_item_id;
		map_object@ dest = escolha != "" && escolha != "__exit__" ? map.find_object(escolha) : null;
		if (@dest == null) {
			audio.play_object_interact(atual);
			speak(tr("game.vent_exited"));
			return;
		}
		@atual = dest;
		x = dest.x;
		y = dest.y;
		// O ouvinte vai ANTES do passo: tocado antes, o passo sairia no destino com os ouvidos ainda na
		// origem, e ficaria mudo (a mesma ordem da partida, em on_vent_state).
		audio.update_listener(x, y);
		audio.play_footstep("VentTile", footstep_variant_count("VentTile"), x, y);
		speak(tr("game.vent_traveled"));
	}
}

// O objeto mais perto dentro do alcance de interação, decoração de fora. Diferente do
// find_interactable da partida, não filtra por papel nem por task: aqui tudo é ponto de referência.
map_object@ nearest_object(game_map@ map, float x, float y) {
	map_object@ best = null;
	float best_dist = PLAYER_INTERACT_RANGE;
	for (uint i = 0; i < map.objects.length(); i++) {
		map_object@ o = map.objects[i];
		if (o.obj_type == OBJ_DECORATION) continue;
		float d = distance_2d(x, y, o.x, o.y);
		if (d <= best_dist) { best_dist = d; @best = o; }
	}
	return best;
}
