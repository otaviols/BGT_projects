// lobby_screens.nvgt
// Telas de lobby: navegador de partidas (listar/criar/entrar) e sala de espera (pronto/iniciar).

#include "menu.nvgt"
#include "form.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../core/client_state.nvgt"
#include "../core/chat_log.nvgt"
#include "../i18n.nvgt"
#include "../config/game_constants.nvgt"
#include "../audio/audio_manager.nvgt"
#include "feedback_screen.nvgt"
#include "feedback_replies_screen.nvgt"
#include "lobby_info.nvgt"
#include "../config/lobby_config.nvgt"
// KEY_CHAT* vêm de core/chat_log.nvgt (compartilhado com game/game_loop.nvgt)

// Resultado do navegador de lobbies: o jogador criou uma partida, entrou em uma existente, ou
// voltou ao menu anterior.
class lobby_browser_result {
	bool joined = false;
	bool go_back = false;
	bool is_host = false;

	// O primeiro S_LOBBY_STATE, quando ele chegou ANTES da sala de espera abrir.
	//
	// Quem cria a partida recebe esse retrato na hora da criação, e a espera que confirma a criação
	// tirava o pacote da fila e o jogava fora. A sala de espera então começava sem saber quem está
	// nela nem quais são as regras, e o servidor só manda outro retrato quando alguém entra ou sai -
	// então P e C ficavam mudos para o anfitrião sozinho, e passavam a funcionar "sozinhos" quando
	// chegava a segunda pessoa. Guardar o pacote é o que fecha esse buraco.
	net_packet@ initial_lobby_state = null;
}

// menu.run() e o monitor() de audio_form bloqueiam localmente enquanto o jogador decide (às vezes
// dezenas de segundos, alternando entre janelas ao testar com vários clientes) sem nunca chamar
// client.update(). Sem isso a conexão para de ser "servida" (nada de keepalive/ack via ENet) e o
// servidor pode considerá-la caída, fazendo a lista de lobbies parecer travada/vazia mesmo com o
// servidor funcionando. background_callback do menu.nvgt roda a cada iteração do monitor() interno,
// então usamos ele pra manter a rede viva enquanto o menu está aberto.
game_client@ g_lobby_pump_client;
void pump_client_during_menu(menu@ m, string data) {
	if (@g_lobby_pump_client != null) g_lobby_pump_client.update();
}

// Busca a lista de lobbies em espera no servidor e monta um menu navegável: cada partida existente
// + "Criar partida" + "Atualizar lista" + "Voltar".
lobby_browser_result run_lobby_browser_screen(game_client@ client) {
	lobby_browser_result result;
	audio_manager@ audio = audio_manager();
	audio.play_intro();

	// Anunciado UMA vez por visita ao navegador: o jogador que voltar de uma partida ouve de novo se
	// ainda não leu, mas não a cada "atualizar lista".
	bool replies_announced = false;

	while (true) {
		client.send_list_lobbies();
		json_array@ lobbies = wait_for_lobby_list(client);
		// As respostas aos recados vêm em pedido próprio, depois da lista: a espera pela lista joga
		// fora o que não é lista (ver CLAUDE.md), então os dois não podem viajar na mesma esperada.
		json_array@ replies = fetch_unread_feedback_replies(client);
		uint reply_count = @replies != null ? replies.length() : 0;
		if (reply_count > 0 && !replies_announced) {
			replies_announced = true;
			dictionary@ rp = dictionary();
			rp.set("count", "" + reply_count);
			speak(tr(reply_count == 1 ? "feedback.replies_one" : "feedback.replies_many", rp));
		}

		menu m;
		m.click_sound = "ui/menuclick.ogg";
		m.select_sound = "ui/menuconfirm.ogg";
		m.sounds_prefix = "sounds/";
		m.intro_text = @lobbies == null || lobbies.length() == 0 ? tr("lobby.no_lobbies") : tr("menu.join_lobby");
		@g_lobby_pump_client = client;
		@m.background_callback = @pump_client_during_menu;

		if (@lobbies != null) {
			for (uint i = 0; i < lobbies.length(); i++) {
				json_object@ entry = lobbies.get_object(i);
				if (@entry == null) continue;
				m.add_item(lobby_summary_text(entry), string(entry["id"]));
			}
		}
		m.add_item(tr("menu.create_lobby"), "__create__");
		// Partida privada não aparece na lista: esta é a única porta para ela.
		m.add_item(tr("lobby.join_by_code"), "__join_code__");
		m.add_item(tr("lobby.refresh"), "__refresh__");
		// O recado fica aqui, e não no menu inicial, por uma razão prática: o menu inicial vem ANTES
		// do login, e sem sessão autenticada o servidor não teria como saber de quem é o recado. Aqui
		// o jogador já entrou, e este é o lugar onde ele volta entre uma partida e outra - que é
		// exatamente quando alguém lembra de contar o que achou estranho.
		m.add_item(tr("feedback.menu_item"), "__feedback__");
		if (reply_count > 0) {
			dictionary@ rp = dictionary();
			rp.set("count", "" + reply_count);
			m.add_item(tr("feedback.replies_menu_item", rp), "__replies__");
		}
		m.add_item(tr("menu.back"), "__back__");

		m.run();
		string id = m.selected_item_id;

		if (id == "" || id == "__back__") {
			result.go_back = true;
			return result;
		}
		if (id == "__refresh__") continue;
		if (id == "__feedback__") {
			run_feedback_screen(client);
			continue;
		}
		if (id == "__replies__") {
			run_feedback_replies_screen(client, replies);
			continue;
		}
		if (id == "__join_code__") {
			string code = run_join_code_screen(client);
			if (code == "") continue;
			client.send_join_by_code(code);
			if (wait_for_join_result(client)) {
				result.joined = true;
				result.is_host = false;
				return result;
			}
			continue;
		}
		if (id == "__create__") {
			net_packet@ created = run_create_lobby_screen(client);
			if (@created != null) {
				result.joined = true;
				result.is_host = true;
				@result.initial_lobby_state = created;
				return result;
			}
			continue;
		}

		client.send_join_lobby(id);
		if (wait_for_join_result(client)) {
			result.joined = true;
			result.is_host = false;
			return result;
		}
	}
	return result; // inalcançável - o laço só termina via return acima
}

json_array@ wait_for_lobby_list(game_client@ client) {
	timer@ wait_clock = timer();
	while (float(wait_clock.elapsed) / 1000.0 < 5.0) {
		wait(20);
		client.update();
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_LOBBY_LIST) return pkt.get_array("lobbies");
			@pkt = client.poll_message();
		}
	}
	return null;
}

// Espera a resposta e, se não deu, DIZ por quê: código errado, sala cheia e partida já começada
// pedem reações diferentes do jogador, e "não foi possível entrar" não distingue nenhuma.
bool wait_for_join_result(game_client@ client) {
	timer@ wait_clock = timer();
	while (float(wait_clock.elapsed) / 1000.0 < 5.0) {
		wait(20);
		client.update();
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_JOIN_RESULT) {
				if (pkt.get_bool("ok")) return true;
				string motivo = pkt.get_string(MSG_KEY_FIELD, "");
				speak(tr(motivo != "" ? motivo : "lobby.join_failed"));
				return false;
			}
			@pkt = client.poll_message();
		}
	}
	speak(tr("lobby.join_failed"));
	return false;
}

// Pede o código de uma partida privada. Devolve "" se o jogador desistiu.
string run_join_code_screen(game_client@ client) {
	audio_form f;
	f.create_window(tr("lobby.join_by_code"), false);
	int f_code = f.create_input_box(tr("lobby.join_code_prompt"), "");
	int f_ok = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	f.focus(f_code); // audio_form nasce sem foco - ver CLAUDE.md

	while (true) {
		wait(5);
		client.update();
		f.monitor();
		if (f.is_pressed(f_cancel)) return "";
		if (f.is_pressed(f_ok)) return f.get_text(f_code);
	}
	return ""; // inalcançável
}

// O que sai do formulário de regras: os ajustes (o que ficou em branco vem como -1/"") e, na
// criação, o nome, o código e o preset.
class lobby_form_result {
	bool ok = false;
	string lobby_name;
	string join_code;
	string preset_id = "classic";
	lobby_overrides ov;
}

// O formulário de regras, usado em DOIS momentos: ao criar a partida e, pelo anfitrião, com a sala
// já aberta. É um só de propósito - duas telas com os mesmos campos divergiriam na primeira mudança.
//
// `current` distingue os dois: null é criação (com nome, código e preset); com a configuração atual,
// os campos vêm PREENCHIDOS com o que vale hoje, e o que o anfitrião apagar volta a ser "não mexi".
// Impostores no modo automático ficam em branco - preencher com o número resolvido de hoje o
// congelaria sem ninguém pedir.
lobby_form_result run_lobby_settings_form(game_client@ client, json_object@ current) {
	lobby_form_result r;
	bool creating = @current == null;

	audio_form f;
	f.create_window(tr(creating ? "menu.create_lobby" : "lobby.edit_settings"), false); // não sobrescreve o título da janela
	int f_name = -1, f_code = -1, f_preset = -1;
	if (creating) {
		f_name = f.create_input_box(tr("lobby.name"), tr("app.title"));
		// Vazio = pública. Com código, a partida some da lista e só entra quem o digitar. Fica logo
		// depois do nome porque "é só para os amigos?" é a primeira decisão de quem cria uma sala.
		f_code = f.create_input_box(tr("lobby.join_code"), "");
		f_preset = f.create_list(tr("menu.settings"));
		f.add_list_item(f_preset, tr("lobby.preset.classic_desc"), "classic");
		f.add_list_item(f_preset, tr("lobby.preset.quick_desc"), "quick");
		f.add_list_item(f_preset, tr("lobby.preset.chaos_desc"), "chaos");
	}
	// Ajustes finos sobre o preset. TODOS aceitam vazio, e vazio significa "usa o que o preset diz" -
	// é o que mantém a tela utilizável para quem só quer criar uma sala e jogar, enquanto abre a
	// porta para quem quer mexer. Um formulário que exigisse todos os campos transformaria a criação
	// de partida numa lição de casa.
	int f_kill_cooldown = f.create_input_box(tr("lobby.kill_cooldown_override"), current_float_text(current, "kill_cooldown_seconds"));
	int f_max_players = f.create_input_box(tr("lobby.max_players_override"), current_int_text(current, "max_players"));
	bool auto_impostors = @current != null && bool(current["impostors_automatic"]);
	int f_impostors = f.create_input_box(tr("lobby.impostor_count_override"), auto_impostors ? "" : current_int_text(current, "impostor_count"));
	int f_tasks = f.create_input_box(tr("lobby.task_count_override"), current_int_text(current, "task_count_per_crewmate"));
	int f_discussion = f.create_input_box(tr("lobby.discussion_time_override"), current_float_text(current, "discussion_time_seconds"));
	int f_voting = f.create_input_box(tr("lobby.voting_time_override"), current_float_text(current, "voting_time_seconds"));
	int f_meetings = f.create_input_box(tr("lobby.emergency_meetings_override"), current_int_text(current, "emergency_meetings_per_player"));
	int f_sabotages = f.create_list(tr("lobby.sabotages_override"));
	f.add_list_item(f_sabotages, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_sabotages, tr("lobby.override.enabled"), "on");
	f.add_list_item(f_sabotages, tr("lobby.override.disabled"), "off");
	if (@current != null) f.set_list_position(f_sabotages, bool(current["sabotages_enabled"]) ? 1 : 2);
	int f_ok = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	// Um audio_form nasce sem foco: sem isto o primeiro campo não recebia o que era digitado até o
	// jogador apertar Tab.
	f.focus(creating ? f_name : f_kill_cooldown);
	if (!creating) speak(tr("lobby.edit_settings_hint"));

	while (true) {
		wait(5);
		client.update(); // mantém a conexão viva enquanto o jogador preenche o formulário
		f.monitor();
		if (f.is_pressed(f_cancel)) return r;
		if (f.is_pressed(f_ok)) {
			r.ok = true;
			if (creating) {
				r.lobby_name = f.get_text(f_name);
				r.join_code = f.get_text(f_code);
				int preset_index = f.get_list_position(f_preset);
				r.preset_id = preset_index >= 0 ? f.get_list_item_id(f_preset, preset_index) : "classic";
			}
			// -1 em número e "" em texto significam "não mexi nisto": é o servidor que decide o
			// valor final. Mandar 0 no lugar seria pedir uma partida com zero tarefas por engano.
			r.ov.kill_cooldown_seconds = text_to_float_or_default(f.get_text(f_kill_cooldown));
			r.ov.max_players = text_to_int_or_default(f.get_text(f_max_players));
			r.ov.impostor_count = text_to_int_or_default(f.get_text(f_impostors));
			r.ov.task_count_per_crewmate = text_to_int_or_default(f.get_text(f_tasks));
			r.ov.discussion_time_seconds = text_to_float_or_default(f.get_text(f_discussion));
			r.ov.voting_time_seconds = text_to_float_or_default(f.get_text(f_voting));
			r.ov.emergency_meetings_per_player = text_to_int_or_default(f.get_text(f_meetings));
			int sab_index = f.get_list_position(f_sabotages);
			r.ov.sabotages = sab_index >= 0 ? f.get_list_item_id(f_sabotages, sab_index) : "";
			return r;
		}
	}
	return r; // inalcançável - o laço só termina via return acima
}

// Valor atual de um campo como texto para pré-preencher o formulário - "" quando não há configuração
// (criação) ou o campo não veio.
string current_int_text(json_object@ cfg, const string&in key) {
	if (@cfg == null || !cfg.exists(key)) return "";
	return "" + int(cfg[key]);
}
string current_float_text(json_object@ cfg, const string&in key) {
	if (@cfg == null || !cfg.exists(key)) return "";
	return seconds_text(float(cfg[key]));
}

// Tela de criação de partida.
//
// Devolve o primeiro S_LOBBY_STATE da partida criada, ou null se o jogador desistiu ou o servidor não
// respondeu. O pacote é DEVOLVIDO, e não descartado, porque é o único retrato da sala que o anfitrião
// recebe enquanto estiver sozinho nela.
net_packet@ run_create_lobby_screen(game_client@ client) {
	lobby_form_result r = run_lobby_settings_form(client, null);
	if (!r.ok) return null;
	client.send_create_lobby(r.lobby_name, r.preset_id, r.ov, r.join_code);
	return wait_for_lobby_state_after_create(client);
}

// Campo vazio (ou lixo digitado) vira -1 = "não mexi nisto, use o preset". Aceitar lixo como -1 em
// vez de recusar é deliberado: quem digitou "vinte" no lugar de "20" recebe a partida do preset em
// vez de um formulário travado que ele não consegue enxergar para descobrir onde errou.
float text_to_float_or_default(const string&in text) {
	if (text == "") return -1.0;
	float value = parse_float(text);
	return value > 0.0 ? value : -1.0;
}

int text_to_int_or_default(const string&in text) {
	if (text == "") return -1;
	int value = parse_int(text);
	return value > 0 ? value : -1;
}

// A criação é confirmada pelo primeiro S_LOBBY_STATE. Ele é DEVOLVIDO a quem chamou, não descartado:
// é o retrato de quem está na sala e de quais são as regras, e o servidor só manda outro quando
// alguém entra ou sai - o anfitrião sozinho nunca receberia um segundo.
net_packet@ wait_for_lobby_state_after_create(game_client@ client) {
	timer@ wait_clock = timer();
	while (float(wait_clock.elapsed) / 1000.0 < 5.0) {
		wait(20);
		client.update();
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_LOBBY_STATE) return pkt;
			@pkt = client.poll_message();
		}
	}
	return null;
}

// Último retrato da sala que o servidor mandou: quem está nela, quais são as regras, e o teto de
// jogadores. Guardado porque as teclas de "quem está aqui" e "quais as regras" respondem na hora, sem
// ir perguntar nada ao servidor.
//
// É uma classe, e não três variáveis soltas no laço, porque o retrato chega por dois caminhos - o
// pacote da criação da sala e os S_LOBBY_STATE que chegam depois - e os dois precisam aplicá-lo do
// mesmo jeito. Quando eram variáveis soltas, só o segundo caminho existia.
class lobby_snapshot {
	json_array@ players = null;
	json_object@ config = null;
	uint max_players = MAX_PLAYERS;
	string join_code = ""; // vazio = pública

	void apply(net_packet@ pkt) {
		if (@pkt == null) return;
		join_code = pkt.get_string("join_code", "");
		@players = pkt.get_array("players");
		@config = pkt.get_object("config");
		max_players = uint(pkt.get_int("max_players", int(MAX_PLAYERS)));
	}

	string name_of(uint64 peer_id) const {
		if (@players == null) return "";
		for (uint i = 0; i < players.length(); i++) {
			json_object@ pj = players.get_object(i);
			if (@pj != null && uint64(pj["peer_id"]) == peer_id) return string(pj["name"]);
		}
		return "";
	}
}

// " Partida privada. Código: xyz." - ou nada, se for pública. Dito na entrada e na tecla C: é
// assim que o anfitrião relembra o código para ditar aos amigos.
string private_lobby_text(const string&in join_code) {
	if (join_code == "") return "";
	dictionary@ p = dictionary();
	p.set("code", join_code);
	return " " + tr("lobby.info.private_code", p);
}

// Atualiza is_host/host_peer_id a partir de um novo valor vindo do servidor (S_LOBBY_STATE ou
// S_PLAYER_LEFT) e anuncia a troca de anfitrião - só quando já sabíamos quem era antes (host_peer_id
// != 0), pra não anunciar nada na entrada na sala.
void apply_host_change(game_client@ client, uint64&inout host_peer_id, bool&inout is_host,
		uint64 new_host_peer_id, const string&in new_host_name) {
	bool was_known = host_peer_id != 0;
	bool changed = was_known && new_host_peer_id != host_peer_id;
	host_peer_id = new_host_peer_id;
	is_host = client.my_peer_id == host_peer_id;
	if (!changed) return;
	if (is_host) {
		speak(tr("lobby.you_are_host") + " " + tr("lobby.host_start_hint"));
	} else if (new_host_name != "") {
		dictionary@ p = dictionary();
		p.set("name", new_host_name);
		speak(tr("lobby.new_host", p));
	}
}

// Sala de espera: fala entradas/saídas, o anfitrião inicia a partida (Enter) e qualquer um pode
// sair (ESC). Retorna o pacote S_GAME_START quando a partida começa, ou null se o jogador saiu
// antes disso.
// Não existe mais "marcar pronto": ninguém usava pra nada (o servidor nunca exigiu que todos
// estivessem prontos pra começar), era só um passo a mais antes de jogar.
net_packet@ run_waiting_room_screen(game_client@ client, bool is_host,
		net_packet@ initial_lobby_state = null) {
	audio_manager@ audio = audio_manager();
	uint64 host_peer_id = 0; // 0 = ainda não recebemos nenhum S_LOBBY_STATE

	chat_log@ messages_log = chat_log();
	chat_log@ events_log = chat_log();
	bool viewing_events_container = false; // false = mensagens, true = eventos

	// O retrato que veio da criação da sala vale desde já. Sem isto, quem cria a partida fica sem
	// resposta para P e C enquanto estiver sozinho: o próximo retrato só chega quando alguém entra.
	lobby_snapshot snapshot;
	snapshot.apply(initial_lobby_state);
	if (@initial_lobby_state != null) {
		apply_host_change(client, host_peer_id, is_host, initial_lobby_state.get_uint64("host_peer_id"), "");
	}

	// A dica das teclas vem junto do aviso de entrada: numa sala de espera ninguém vai descobrir
	// sozinho que P e C fazem alguma coisa, e é justamente ali que essas duas respostas importam.
	speak(tr(is_host ? "lobby.host_start_hint" : "lobby.waiting_for_host") + " " + tr("lobby.info.keys_hint")
		+ private_lobby_text(snapshot.join_code));

	while (true) {
		wait(10);
		client.update();
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_PLAYER_JOINED) {
				dictionary@ p = dictionary();
				p.set("name", pkt.get_string("name"));
				string joined_text = tr("lobby.player_joined", p);
				speak(joined_text);
				events_log.add("", joined_text);
				audio.play_player_enter();
			} else if (pkt.type == S_PLAYER_LEFT) {
				dictionary@ p = dictionary();
				p.set("name", pkt.get_string("name", "?"));
				string left_text = tr("lobby.player_left", p);
				speak(left_text);
				events_log.add("", left_text);
				audio.play_player_leave();
				apply_host_change(client, host_peer_id, is_host, pkt.get_uint64("host_peer_id"), "");
			} else if (pkt.type == S_LOBBY_STATE) {
				snapshot.apply(pkt);
				uint64 new_host_id = pkt.get_uint64("host_peer_id");
				apply_host_change(client, host_peer_id, is_host, new_host_id, snapshot.name_of(new_host_id));
			} else if (pkt.type == S_CHAT_MESSAGE) {
				string chat_name = pkt.get_string("name");
				string chat_text = pkt.get_string("text");
				messages_log.add(chat_name, chat_text);
				speak(chat_name + ": " + chat_text);
				if (pkt.get_uint64("peer_id") == client.my_peer_id) audio.play_message_sent();
				else audio.play_message_received();
			} else if (pkt.type == S_ERROR) {
				speak(tr_server_message(pkt));
			} else if (pkt.type == S_GAME_START) {
				return pkt;
			}
			@pkt = client.poll_message();
		}

		if (is_host && key_pressed(KEY_RETURN)) {
			client.send_start_game();
		}

		// B adiciona um bot, Shift+B tira o último - só o anfitrião, e o servidor confere de novo
		// (ver on_add_bot). Entrada e saída de bot são anunciadas pelo caminho normal de
		// S_PLAYER_JOINED / S_PLAYER_LEFT, então não precisa falar nada aqui.
		if (key_pressed(KEY_B)) {
			if (!is_host) speak(tr("lobby.bot_host_only"));
			else if (key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) client.send_remove_bot();
			else client.send_add_bot();
		}

		// O: o anfitrião muda as regras com a sala já aberta. Sem isto, mudar qualquer coisa era
		// desfazer a sala e criar outra - e perder quem já tinha entrado. A resposta vem pelo caminho
		// normal (um S_LOBBY_STATE novo para todos, mais o aviso falado), então nada especial aqui.
		if (key_pressed(KEY_O)) {
			if (!is_host) speak(tr("lobby.edit_host_only"));
			else {
				lobby_form_result r = run_lobby_settings_form(client, snapshot.config);
				if (r.ok) client.send_update_lobby_config(r.ov);
			}
		}

		// P: quem está na sala. C: quais são as regras desta partida.
		//
		// As duas respondem do último estado recebido, sem pedir nada ao servidor: a resposta é
		// imediata, e numa sala de espera o estado já chega sozinho a cada pessoa que entra ou sai.
		if (key_pressed(KEY_P)) speak(lobby_players_text(snapshot.players, snapshot.max_players));
		if (key_pressed(KEY_C)) speak(lobby_config_text(snapshot.config) + private_lobby_text(snapshot.join_code));

		if (action_pressed(ACTION_CHAT)) run_chat_compose(client);

		if (action_pressed(ACTION_CHAT_SWITCH) || key_pressed(KEY_CHAT_SWITCH_CONTAINER_ALT)) {
			viewing_events_container = !viewing_events_container;
			speak(tr(viewing_events_container ? "chat.events_container" : "chat.messages_container"));
		}

		bool chat_prev_pressed = action_pressed(ACTION_CHAT_PREV);
		bool chat_next_pressed = action_pressed(ACTION_CHAT_NEXT);
		if (chat_prev_pressed || chat_next_pressed) {
			chat_log@ active_log = viewing_events_container ? events_log : messages_log;
			bool shift_held = key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT);
			string line;
			if (chat_prev_pressed) line = shift_held ? active_log.move_first() : active_log.move_previous();
			else line = shift_held ? active_log.move_last() : active_log.move_next();
			speak(line != "" ? line : tr("chat.empty"));
		}

		if (key_pressed(KEY_ESCAPE)) {
			client.send_leave_lobby();
			return null;
		}
	}
	return null; // inalcançável - o laço só termina via return acima
}
