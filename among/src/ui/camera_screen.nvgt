// camera_screen.nvgt
// O posto de câmeras da segurança: observar UMA sala por vez, de longe.
//
// É o único ponto do jogo que dá informação de outra sala. Tudo o mais que o jogador sabe é local -
// ele ouve o que está perto - e é isso que torna a câmera valiosa e, se mal calibrada, quebrada.
// O equilíbrio está em três custos, todos deliberados:
//
//   1. Quem observa fica PARADO na segurança e deixa de ouvir o que acontece à sua volta. O truque
//      que faz isso funcionar é mover o OUVINTE do áudio para a sala observada: o jogador passa a
//      ouvir os passos e o ambiente de lá exatamente como ouviria se estivesse no lugar, e para de
//      ouvir o próprio entorno. Nenhum código de áudio novo foi preciso.
//   2. A sala observada AVISA que está sendo observada, com um zumbido contínuo. Quem entra nela
//      descobre sozinho, e o impostor pode escolher esperar - é o que faz a câmera ser um jogo dos
//      dois lados em vez de vigilância grátis.
//   3. Nomes custam uma ação a mais: o jogador ouve quem está lá apertando a tecla do radar. Sem
//      isso, a câmera responderia "onde está cada um" de graça e a discussão perderia a dúvida.
//
// As comunicações sabotadas derrubam o posto - mesma sabotagem que já tira radar e marcadores.
//
// NÃO há chiado de monitor por baixo de tudo, e isso foi decidido depois de ouvir: num jogo em que a
// informação É o som, uma camada constante por cima competia justamente com o que se veio escutar.
// Pelo mesmo motivo o aviso da sala observada toca bem abaixo dos outros marcadores (ver
// CAMERA_WATCHING_VOLUME_DB): ele precisa ser notado por quem presta atenção, não anunciado.

#include "menu.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../network/protocol.nvgt"
#include "../game/map.nvgt"
#include "../core/client_state.nvgt"
#include "../i18n.nvgt"

// Estado do posto no cliente. Fica fora da tela porque o laço da partida precisa saber se está
// observando (para não deixar o jogador andar) e qual sala (para posicionar o ouvinte).
class camera_view {
	bool active = false;
	string room_id = "";
	int room_index = 0;

	// As salas observáveis, na ordem em que as setas passam por elas.
	array<map_zone@> rooms;

	// A lista é ordenada pelo NOME que o jogador ouve, e não pela ordem em que as salas aparecem no
	// mapa - que é ordem de construção do cenário e não significa nada para quem está usando.
	//
	// Ordem alfabética não é a única possível, mas é a única PREVISÍVEL sem visão: o jogador aprende
	// uma vez onde cada sala cai e depois sabe quantas vezes apertar para chegar nela. Uma ordem
	// arbitrária obrigaria a varrer tudo toda vez.
	void build_room_list(game_map@ map) {
		rooms.resize(0);
		array<map_zone@>@ all = map.room_zones();
		for (uint i = 0; i < all.length(); i++) rooms.insert_last(all[i]);

		// Ordenação simples por inserção: são cerca de uma dúzia de salas, e ela roda uma vez por
		// partida - não vale trazer nada mais elaborado para isso.
		for (uint i = 1; i < rooms.length(); i++) {
			map_zone@ atual = rooms[i];
			int k = int(i) - 1;
			while (k >= 0 && tr(rooms[k].name_key) > tr(atual.name_key)) {
				@rooms[k + 1] = @rooms[k];
				k--;
			}
			@rooms[k + 1] = @atual;
		}
	}

	// "Cafeteria (3 de 11)". O número é o que dá noção de POSIÇÃO: sem ele, quem está varrendo as
	// salas não sabe se está no começo, no meio ou prestes a dar a volta.
	string current_room_text() const {
		map_zone@ z = current_zone();
		if (@z == null) return tr("camera.unknown_room");
		dictionary@ p = dictionary();
		p.set("room", tr(z.name_key));
		p.set("index", "" + (room_index + 1));
		p.set("total", "" + rooms.length());
		return tr("camera.room_position", p);
	}

	void start(const string&in room) {
		active = true;
		room_id = room;
		sync_index();
	}

	void stop() {
		active = false;
		room_id = "";
	}

	private void sync_index() {
		for (uint i = 0; i < rooms.length(); i++) {
			if (rooms[i].id == room_id) { room_index = int(i); return; }
		}
	}

	// Sala seguinte/anterior na lista, dando a volta. O jogador varre as salas com as setas, e parar
	// nas pontas obrigaria a voltar o caminho todo para chegar na primeira.
	string room_at_offset(int offset) const {
		if (rooms.length() == 0) return "";
		int n = int(rooms.length());
		int idx = ((room_index + offset) % n + n) % n;
		return rooms[idx].id;
	}

	map_zone@ current_zone() const {
		for (uint i = 0; i < rooms.length(); i++) {
			if (rooms[i].id == room_id) return rooms[i];
		}
		return null;
	}
}

// Quem está na sala observada, dito só quando o jogador pede (tecla do radar).
//
// Usa o elenco que o cliente já mantém - o servidor manda a posição de todo mundo, e é isso que faz
// a câmera funcionar sem nenhum pacote novo. Fantasma não entra: ele é invisível para quem está vivo.
string watched_room_players_text(client_roster@ roster, game_map@ map, const string&in room_id,
		uint64 my_peer_id) {
	array<string> nomes;
	for (uint i = 0; i < roster.entries.length(); i++) {
		roster_entry@ e = roster.entries[i];
		if (e.peer_id == my_peer_id || !e.alive) continue;
		if (map.room_id_at(e.x, e.y) != room_id) continue;
		nomes.insert_last(e.name);
	}
	if (nomes.length() == 0) return tr("camera.nobody_there");
	dictionary@ p = dictionary();
	p.set("names", join(nomes, ", "));
	return tr("camera.people_there", p);
}
