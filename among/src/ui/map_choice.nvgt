// map_choice.nvgt
// Qual mapa: a pergunta do treino e do Conhecer o mapa, fora da partida (na partida quem decide é a
// sala). Com um mapa só, não pergunta nada - a resposta é ele.

#include "visual_map.nvgt"
#include "../config/game_constants.nvgt"
#include "../i18n.nvgt"

// Os mapas que esta máquina oferece fora da partida: os publicados, e os em construção se a pasta do
// jogo tiver o MAPS_IN_TEST_FLAG. Lido por file_get_contents, e não file_exists: no Android "existe?" e
// "dá para ler?" discordam (ver CLAUDE.md) - um arquivo vazio também liga, então se escreve algo nele.
array<string>@ offered_map_ids() {
	return usable_map_ids();
}

// O id escolhido, ou "" se a pessoa saiu com Esc.
string choose_map(const string&in title_key) {
	array<string>@ ids = offered_map_ids();
	if (ids.length() == 1) return ids[0];
	screen_menu m;
	m.intro_text = tr(title_key);
	m.click_sound = "ui/menu_click.ogg";
	m.select_sound = "ui/menu_confirm.ogg";
	m.sounds_prefix = "sounds/";
	for (uint i = 0; i < ids.length(); i++) m.add_item(tr(map_name_key(ids[i])), ids[i]);
	m.run();
	return m.selected_item_id;
}
