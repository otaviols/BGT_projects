// radar.nvgt
// Radar de jogadores próximos: Tab / Shift+Tab. Servidor decide quem está por perto (mesma
// sala/área - decisão de design) e devolve um alvo por vez; aqui só tocamos o beep posicionado
// e falamos o nome via TTS.

#include "../game/map.nvgt"
#include "../network/client.nvgt"
#include "../network/protocol.nvgt"
#include "../audio/audio_manager.nvgt"
#include "../i18n.nvgt"
#include "speech.nvgt"

// Dois modos, alternados com Ctrl+Tab:
// - JOGADORES: quem está na mesma sala que você. Quem responde é o servidor (só ele sabe onde os
//   outros estão), um alvo por vez.
// - OBJETOS: o que existe na sala onde você está (tasks, vents, painéis, botão). Isso é mapa, não
//   estado de partida, então é resolvido aqui mesmo no cliente, sem ida e volta de rede.
// Nos dois casos o retorno é o mesmo: um beep posicionado no alvo mais o nome falado.
const int RADAR_MODE_PLAYERS = 0;
const int RADAR_MODE_OBJECTS = 1;

class radar_ui {
	game_client@ client;
	audio_manager@ audio;
	int mode = RADAR_MODE_PLAYERS;
	private string object_room_id = ""; // sala do último ciclo de objetos, pra reiniciar ao trocar de sala
	private int object_index = -1;

	// Radar CONTÍNUO (tecla Q): não é uma trava num alvo, é um MODO. Ligado, o alvo que o Tab
	// escolher fica bipando sozinho até sair de alcance; desligado, o Tab bipa uma vez e cala.
	//
	// Era uma trava por alvo antes: o Q só funcionava depois de um Tab, e perder o alvo desligava
	// tudo. Como modo, a escolha é feita uma vez (e guardada nas preferências) e o Tab passa a
	// mandar sozinho - trocar de alvo transfere o bipe, perder o alvo não desliga o modo. Os
	// jogadores se dividem nisso: uns querem acompanhar alguém sem apertar nada, outros acham o
	// bipe constante um ruído por cima do que vieram escutar.
	//
	// Continua limitado pela mesma regra do radar: mesma sala. Seguir alguém pela nave inteira de
	// graça seria forte demais; o modo tira o spam de tecla, não o limite.
	private uint64 last_target_peer = 0; // quem o Tab apontou por último
	private string last_target_name = "";
	uint64 tracked_peer = 0;             // quem está bipando agora (0 = ninguém)
	private timer track_clock;
	// Vale nos dois modos. Em objetos o bipe é local (o objeto não sai do lugar): toca no ponto dele
	// e cai quando saio da sala - o radar de objetos é da sala em que se está, e o contínuo não pode
	// enxergar mais longe que ele.
	private map_object@ last_target_object = null;
	map_object@ tracked_object = null;

	radar_ui(game_client@ client, audio_manager@ audio) {
		@this.client = client;
		@this.audio = audio;
	}

	void toggle_mode() {
		mode = mode == RADAR_MODE_PLAYERS ? RADAR_MODE_OBJECTS : RADAR_MODE_PLAYERS;
		object_index = -1;
		// O alvo é do modo em que foi escolhido; o MODO contínuo continua como está.
		stop_tracking();
		speak(tr(mode == RADAR_MODE_PLAYERS ? "radar.mode_players" : "radar.mode_objects"));
	}

	// Q: liga/desliga o radar contínuo. Não depende de haver um alvo - é uma preferência, e fica
	// guardada. Se já houver um alvo apontado, ele começa a bipar na hora, para a tecla ter efeito
	// audível imediato em vez de só valer "da próxima vez".
	void toggle_continuous() {
		g_settings.radar_continuous = !g_settings.radar_continuous;
		g_settings.save();
		if (!g_settings.radar_continuous) {
			stop_tracking();
			speak(tr("radar.continuous_off"));
			return;
		}
		speak(tr("radar.continuous_on"));
		start_tracking_last_target();
	}

	// Passa a bipar o último alvo do Tab, se houver um. Chamado ao ligar o modo e a cada Tab.
	private void start_tracking_last_target() {
		if (!g_settings.radar_continuous) return;
		if (mode == RADAR_MODE_OBJECTS) {
			if (@last_target_object == null) return;
			@tracked_object = last_target_object;
		} else {
			if (last_target_peer == 0) return;
			tracked_peer = last_target_peer;
			client.send_radar_track(tracked_peer);
		}
		track_clock.restart();
	}

	private void stop_tracking() {
		tracked_peer = 0;
		@tracked_object = null;
	}

	// Para o bipe sem desligar o modo. Usado pela reunião, que teleporta todo mundo: o alvo deixa de
	// fazer sentido, mas a preferência do jogador não muda por causa disso.
	void stop_tracking_public() { stop_tracking(); }

	// Chamar a cada quadro, com a posição de quem ouve. Pessoa travada: pergunta ao servidor de
	// tempos em tempos e a resposta (S_RADAR_RESULT com track) vira só o bip. Objeto travado: bipa
	// aqui mesmo, e solta sozinho quando saio da sala do objeto.
	void tick(game_map@ map, float x, float y) {
		if (float(track_clock.elapsed) / 1000.0 < RADAR_TRACK_INTERVAL_SECONDS) return;
		if (@tracked_object != null) {
			track_clock.restart();
			// Perder o alvo NÃO desliga o modo contínuo: ele continua ligado esperando o próximo
			// Tab. Antes isto era uma trava, e perdê-la obrigava a apertar Q de novo.
			if (map.room_id_at(x, y) != tracked_object.room_id) { @tracked_object = null; speak(tr("radar.lock_lost")); return; }
			audio.play_radar_beep(tracked_object.x, tracked_object.y);
			return;
		}
		if (tracked_peer == 0) return;
		track_clock.restart();
		client.send_radar_track(tracked_peer);
	}

	void scan_next(game_map@ map, float x, float y, array<string>@ my_task_object_ids, const string&in active_sabotage_id) {
		scan(1, map, x, y, my_task_object_ids, active_sabotage_id);
	}

	void scan_previous(game_map@ map, float x, float y, array<string>@ my_task_object_ids, const string&in active_sabotage_id) {
		scan(-1, map, x, y, my_task_object_ids, active_sabotage_id);
	}

	private void scan(int direction, game_map@ map, float x, float y, array<string>@ my_task_object_ids,
			const string&in active_sabotage_id) {
		if (mode == RADAR_MODE_PLAYERS) {
			client.send_radar_scan(direction);
			return;
		}

		string room_id = map.room_id_at(x, y);
		array<map_object@>@ objects = interactables_in_room(map, room_id, x, y, my_task_object_ids, active_sabotage_id);
		if (objects.length() == 0) {
			speak(tr("radar.no_objects_here"));
			return;
		}
		if (room_id != object_room_id) { // mudou de sala: começa a lista do zero
			object_room_id = room_id;
			object_index = -1;
		}
		object_index = (object_index + direction) % int(objects.length());
		if (object_index < 0) object_index += int(objects.length());

		map_object@ target = objects[object_index];
		@last_target_object = target;
		// No contínuo, o Tab TRANSFERE o bipe para o alvo novo - é o que o jogador está dizendo ao
		// apertar. Fora dele, o bipe abaixo é o único, e cala em seguida.
		start_tracking_last_target();
		audio.play_radar_beep(target.x, target.y);
		speak(object_name(target));
	}

	// Chamar quando o loop principal receber um pacote do tipo S_RADAR_RESULT.
	void handle_result(net_packet@ pkt) {
		bool tracking = pkt.get_bool("track", false);
		if (pkt.get_bool("empty", true)) {
			if (tracking) {
				// O alvo saiu de alcance (outra sala, duto, escuro): o bipe para e avisa, senão o
				// silêncio pareceria o jogo travado. O MODO contínuo continua ligado, esperando o
				// próximo Tab - perder alguém de vista não é motivo para desligar a preferência.
				if (tracked_peer != 0 && pkt.get_bool("lost", false)) { tracked_peer = 0; speak(tr("radar.lock_lost")); }
				return;
			}
			speak(tr("radar.no_players_nearby"));
			return;
		}
		float x = pkt.get_float("x");
		float y = pkt.get_float("y");
		string name = pkt.get_string("name");
		float distance = pkt.get_float("distance", -1.0);
		if (tracking) {
			if (tracked_peer != 0) audio.play_radar_beep(x, y); // só o bip: o nome já foi dito no Tab
			return;
		}
		last_target_peer = pkt.get_uint64("peer_id");
		last_target_name = name;
		// No contínuo, o Tab TRANSFERE o bipe para quem acabou de ser apontado.
		start_tracking_last_target();
		audio.play_radar_beep(x, y);
		// A contagem de "passos" (distância em unidades de mundo) não tinha uma correspondência
		// confiável com o que se ouve andando - em vez de reportar um número que engana, só fala o
		// nome; o som posicionado do beep já dá a noção de direção/proximidade.
		dictionary@ params = dictionary();
		params.set("name", name);
		speak(tr("radar.player_at", params));
	}
}
