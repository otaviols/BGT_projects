// radar.nvgt
// Radar de jogadores próximos: Tab / Shift+Tab. Servidor decide quem está por perto (mesma
// sala/área - decisão de design) e devolve um alvo por vez; aqui só tocamos o beep posicionado
// e falamos o nome via TTS.

#include "../game/map.nvgt"
#include "../network/client.nvgt"
#include "../network/protocol.nvgt"
#include "../audio/audio_manager.nvgt"
#include "../i18n.nvgt"
#include "speech.nvgt"

// Dois modos, alternados com Ctrl+Tab:
// - JOGADORES: quem está na mesma sala que você. Quem responde é o servidor (só ele sabe onde os
//   outros estão), um alvo por vez.
// - OBJETOS: o que existe na sala onde você está (tasks, vents, painéis, botão). Isso é mapa, não
//   estado de partida, então é resolvido aqui mesmo no cliente, sem ida e volta de rede.
// Nos dois casos o retorno é o mesmo: um beep posicionado no alvo mais o nome falado.
const int RADAR_MODE_PLAYERS = 0;
const int RADAR_MODE_OBJECTS = 1;

class radar_ui {
	game_client@ client;
	audio_manager@ audio;
	int mode = RADAR_MODE_PLAYERS;
	private string object_room_id = ""; // sala do último ciclo de objetos, pra reiniciar ao trocar de sala
	private int object_index = -1;

	// Radar travado (tecla Q): o último alvo apontado passa a bipar sozinho, com o tom pela
	// distância, até sair do alcance ou ser solto. Substitui o "apertar Tab sem parar" para
	// acompanhar alguém - que era o que os jogadores faziam, e pediram para não precisar fazer.
	//
	// Continua limitado pela mesma regra do radar: mesma sala. Seguir alguém pela nave inteira de
	// graça seria forte demais; a trava tira o spam, não o limite.
	private uint64 last_target_peer = 0; // quem o Tab apontou por último - é nele que o Q trava
	private string last_target_name = "";
	uint64 locked_peer = 0;
	private timer track_clock;
	// A trava vale nos dois modos. Em objetos ela é local (o objeto não sai do lugar): o bip toca no
	// ponto do objeto com o tom pela distância até ONDE EU ESTOU, e cai quando saio da sala - o
	// radar de objetos é da sala em que se está, e a trava não pode enxergar mais longe que ele.
	private map_object@ last_target_object = null;
	map_object@ locked_object = null;

	radar_ui(game_client@ client, audio_manager@ audio) {
		@this.client = client;
		@this.audio = audio;
	}

	void toggle_mode() {
		mode = mode == RADAR_MODE_PLAYERS ? RADAR_MODE_OBJECTS : RADAR_MODE_PLAYERS;
		object_index = -1;
		unlock(false); // a trava é do modo em que foi feita: trocar de modo é começar do zero
		speak(tr(mode == RADAR_MODE_PLAYERS ? "radar.mode_players" : "radar.mode_objects"));
	}

	// Q: trava no último alvo do Tab (pessoa ou objeto, conforme o modo), ou solta se já estava.
	void toggle_lock() {
		if (locked_peer != 0 || @locked_object != null) { unlock(true); return; }
		dictionary@ p = dictionary();
		if (mode == RADAR_MODE_OBJECTS) {
			if (@last_target_object == null) { speak(tr("radar.lock_no_target")); return; }
			@locked_object = last_target_object;
			p.set("name", object_name(locked_object));
		} else {
			if (last_target_peer == 0) { speak(tr("radar.lock_no_target")); return; }
			locked_peer = last_target_peer;
			p.set("name", last_target_name);
			client.send_radar_track(locked_peer);
		}
		track_clock.restart();
		speak(tr("radar.lock_on", p));
	}

	void unlock(bool announce) {
		if (locked_peer == 0 && @locked_object == null) return;
		locked_peer = 0;
		@locked_object = null;
		if (announce) speak(tr("radar.lock_off"));
	}

	// Chamar a cada quadro, com a posição de quem ouve. Pessoa travada: pergunta ao servidor de
	// tempos em tempos e a resposta (S_RADAR_RESULT com track) vira só o bip. Objeto travado: bipa
	// aqui mesmo, e solta sozinho quando saio da sala do objeto.
	void tick(game_map@ map, float x, float y) {
		if (float(track_clock.elapsed) / 1000.0 < RADAR_TRACK_INTERVAL_SECONDS) return;
		if (@locked_object != null) {
			track_clock.restart();
			if (map.room_id_at(x, y) != locked_object.room_id) { @locked_object = null; speak(tr("radar.lock_lost")); return; }
			audio.play_radar_beep(locked_object.x, locked_object.y);
			return;
		}
		if (locked_peer == 0) return;
		track_clock.restart();
		client.send_radar_track(locked_peer);
	}

	void scan_next(game_map@ map, float x, float y, array<string>@ my_task_object_ids, const string&in active_sabotage_id) {
		scan(1, map, x, y, my_task_object_ids, active_sabotage_id);
	}

	void scan_previous(game_map@ map, float x, float y, array<string>@ my_task_object_ids, const string&in active_sabotage_id) {
		scan(-1, map, x, y, my_task_object_ids, active_sabotage_id);
	}

	private void scan(int direction, game_map@ map, float x, float y, array<string>@ my_task_object_ids,
			const string&in active_sabotage_id) {
		if (mode == RADAR_MODE_PLAYERS) {
			client.send_radar_scan(direction);
			return;
		}

		string room_id = map.room_id_at(x, y);
		array<map_object@>@ objects = interactables_in_room(map, room_id, x, y, my_task_object_ids, active_sabotage_id);
		if (objects.length() == 0) {
			speak(tr("radar.no_objects_here"));
			return;
		}
		if (room_id != object_room_id) { // mudou de sala: começa a lista do zero
			object_room_id = room_id;
			object_index = -1;
		}
		object_index = (object_index + direction) % int(objects.length());
		if (object_index < 0) object_index += int(objects.length());

		map_object@ target = objects[object_index];
		@last_target_object = target;
		if (@locked_object != null) @locked_object = target; // travado: o Tab move a trava, como com pessoas
		audio.play_radar_beep(target.x, target.y);
		speak(object_name(target));
	}

	// Chamar quando o loop principal receber um pacote do tipo S_RADAR_RESULT.
	void handle_result(net_packet@ pkt) {
		bool tracking = pkt.get_bool("track", false);
		if (pkt.get_bool("empty", true)) {
			if (tracking) {
				// O alvo travado saiu de alcance (outra sala, duto, escuro) - a trava cai e avisa,
				// senão o silêncio pareceria o jogo travado.
				if (locked_peer != 0 && pkt.get_bool("lost", false)) { locked_peer = 0; speak(tr("radar.lock_lost")); }
				return;
			}
			speak(tr("radar.no_players_nearby"));
			return;
		}
		float x = pkt.get_float("x");
		float y = pkt.get_float("y");
		string name = pkt.get_string("name");
		float distance = pkt.get_float("distance", -1.0);
		if (tracking) {
			if (locked_peer != 0) audio.play_radar_beep(x, y); // só o bip: o nome já foi dito ao travar
			return;
		}
		last_target_peer = pkt.get_uint64("peer_id");
		last_target_name = name;
		// Apontar outro alvo com o Tab move a trava junto: o jogador está dizendo "este agora".
		if (locked_peer != 0) { locked_peer = last_target_peer; track_clock.restart(); }
		audio.play_radar_beep(x, y);
		// A contagem de "passos" (distância em unidades de mundo) não tinha uma correspondência
		// confiável com o que se ouve andando - em vez de reportar um número que engana, só fala o
		// nome; o som posicionado do beep já dá a noção de direção/proximidade.
		dictionary@ params = dictionary();
		params.set("name", name);
		speak(tr("radar.player_at", params));
	}
}
