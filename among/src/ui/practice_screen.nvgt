// practice_screen.nvgt
// Praticar: qualquer tarefa ou reparo de sabotagem, sozinho, sem servidor e sem partida.
//
// Nasceu de duas necessidades que são a mesma coisa vista de dois lados. Quem desenvolve precisava
// de um jeito de testar uma minigame sem montar uma partida de três pessoas toda vez; e os jogadores
// pediram um "modo de treino" desde os primeiros recados do beta - aprender a tarefa do combustível
// com um impostor por perto é a pior hora para aprender qualquer coisa.
//
// Roda EXATAMENTE o mesmo código da partida (task_manager e sabotage_panels), com um cliente de
// rede que existe mas não está ligado a nada: as minigames chamam client.update() e olham a fila de
// pacotes para saber se uma reunião começou, e as duas coisas funcionam com a fila vazia. Nada é
// enviado a lugar nenhum - o resultado é só dito.

#include "menu.nvgt"
#include "../audio/menu_music.nvgt"
#include "../core/hints.nvgt"
#include "map_choice.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../game/task_manager.nvgt"
#include "../game/map.nvgt"
#include "../game/sabotage_panels.nvgt"
#include "../i18n.nvgt"
#include "visual_map.nvgt"

// A ORDEM das tarefas, a mesma do manual. Só o tipo: o nome vem da tradução ("task.<tipo>.name"), a
// mesma que a partida usa. Quais aparecem é o mapa escolhido que diz (ver practice_task_types): uma
// tarefa de outro mapa não entra, e uma do mapa que não está aqui entra no fim.
const array<string> PRACTICE_TASKS = {
	"fix_wiring", "download_data", "empty_garbage", "align_engine", "swipe_card", "unlock_manifolds",
	"fuel_engines", "clear_asteroids", "roll_dice", "water_plants", "review_records", "submit_scan",
	"clean_o2_filter",
	"calibrate_distributor"
};
const array<string> PRACTICE_SABOTAGES = {"lights", "oxygen", "comms", "reactor", "seismic"};

// Um cliente de rede que existe mas não está conectado a nada. update() sem conexão não faz nada,
// e poll_message() devolve null - é tudo de que uma minigame precisa para rodar.
game_client@ make_offline_client() {
	game_client@ c = game_client();
	@c.net = network();
	c.net.setup_client(MAX_PACKET_CHANNELS, 1);
	return c;
}

// O mapa diz quais tarefas e reparos existem nele, e quantas fases cada tarefa tem (ver task_chain em
// game/map.nvgt) - o treino não usa nada do mundo, mas a tarefa tem que ser a mesma da partida.
game_map@ g_practice_map;

// As tarefas do mapa, na ordem do manual (PRACTICE_TASKS); as que a lista não conhece vêm no fim, na
// ordem do mapa - uma tarefa nova não some do treino por esquecerem de pô-la na lista.
array<string>@ practice_task_types(game_map@ map) {
	array<string> do_mapa;
	for (uint i = 0; i < map.objects.length(); i++) {
		map_object@ o = map.objects[i];
		if (o.obj_type == OBJ_TASK_SPOT && do_mapa.find(o.task_type) < 0) do_mapa.insert_last(o.task_type);
	}
	array<string> r;
	for (uint i = 0; i < PRACTICE_TASKS.length(); i++) if (do_mapa.find(PRACTICE_TASKS[i]) >= 0) r.insert_last(PRACTICE_TASKS[i]);
	for (uint i = 0; i < do_mapa.length(); i++) if (r.find(do_mapa[i]) < 0) r.insert_last(do_mapa[i]);
	return r;
}

// Os reparos do mapa: as sabotagens que têm painel nele, na ordem de PRACTICE_SABOTAGES e depois as outras.
array<string>@ practice_sabotages(game_map@ map) {
	// Só as que têm painel: a contaminação se conserta andando até a câmara, e não há minijogo a treinar.
	array<string> do_mapa;
	array<string>@ todas = map.sabotages();
	for (uint i = 0; i < todas.length(); i++) if (map.sabotage_has_panel(todas[i])) do_mapa.insert_last(todas[i]);
	array<string> r;
	for (uint i = 0; i < PRACTICE_SABOTAGES.length(); i++) if (do_mapa.find(PRACTICE_SABOTAGES[i]) >= 0) r.insert_last(PRACTICE_SABOTAGES[i]);
	for (uint i = 0; i < do_mapa.length(); i++) if (r.find(do_mapa[i]) < 0) r.insert_last(do_mapa[i]);
	return r;
}

void run_practice_screen() {
	string qual = choose_map("map.choose_practice");
	if (qual == "") return;
	menu_music_stop(); // os minijogos são de ouvido: nada por baixo
	game_client@ client = make_offline_client();
	if (@g_practice_map == null || g_practice_map.name != qual) @g_practice_map = build_map(qual);
	array<string>@ tarefas = practice_task_types(g_practice_map);
	array<string>@ reparos = practice_sabotages(g_practice_map);
	while (true) {
		screen_menu m;
		m.intro_text = hint_text("practice.hint");
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		m.sounds_prefix = "sounds/";
		for (uint i = 0; i < tarefas.length(); i++) {
			m.add_item(tr("task." + tarefas[i] + ".name"), "task:" + tarefas[i]);
		}
		for (uint i = 0; i < reparos.length(); i++) {
			dictionary@ p = dictionary();
			p.set("name", tr("sabotage." + reparos[i] + ".name"));
			m.add_item(tr("practice.repair_item", p), "sabotage:" + reparos[i]);
		}
		// A porta trancada com painel não é sabotagem, mas é um painel que se treina.
		if (g_practice_map.doors_have_panel) m.add_item(tr("practice.door_panel_item"), "door");
		m.add_item(tr("menu.back"), "__back__");
		m.run();
		string id = m.selected_item_id;
		if (id == "" || id == "__back__") return;

		bool ok;
		if (id == "door") {
			ok = run_door_panel(client);
		} else if (id.starts_with("task:")) {
			// Tarefa de várias fases treina INTEIRA, uma fase atrás da outra: é a tarefa que o jogador
			// vai encontrar. Sem isto, treinar "abastecer motores" era só pegar o galão - a etapa que
			// não tem o que treinar - e a parte de ouvido nunca aparecia.
			string tipo = id.substr(5);
			uint fases = g_practice_map.phase_count_of(tipo);
			// Tarefa de várias fases começa num ponto sorteado entre os começos dela (o nó do clima pergunta
			// no laboratório QUAL nó se consertou - ver run_task_minigame).
			string comeco = "";
			array<string> comecos;
			for (uint c = 0; c < g_practice_map.chains.length(); c++)
				if (g_practice_map.chains[c].task_type == tipo && g_practice_map.chains[c].object_ids.length() > 0)
					comecos.insert_last(g_practice_map.chains[c].object_ids[0]);
			if (comecos.length() > 0) comeco = comecos[random(0, comecos.length() - 1)];
			ok = true;
			for (uint fase = 0; fase < fases && ok; fase++) ok = run_task_minigame(client, tipo, fase, comeco);
		} else {
			// O código do oxigênio vem do servidor na partida; aqui é sorteado na hora.
			string code = "";
			for (uint i = 0; i < 5; i++) code += "" + random(0, 9);
			ok = run_sabotage_panel(client, id.substr(9), code);
		}
		speak(tr(ok ? "practice.done" : "practice.not_done"));
		wait(1800);
	}
}
