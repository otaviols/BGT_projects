// change_password_screen.nvgt
// "Trocar a senha", na lista de partidas (onde o jogador já está logado). Recado #239.
//
// No molde do apagar conta: pede a senha ATUAL mesmo a quem entrou pelo "lembrar de mim" - o token
// lembrado num computador emprestado não pode bastar para tomar uma conta. A nova vai duas vezes,
// porque de ouvido não há como conferir o que se digitou num campo de senha.
// Trocar o NOME ficou de fora de propósito: o nome é o login, e trocá-lo abriria caminho para alguém se
// passar por outra pessoa.

#include "form.nvgt"
#include "../core/screen_keyboard.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../network/protocol.nvgt"
#include "../i18n.nvgt"
#include "../config/game_constants.nvgt"
#include "../config/game_settings.nvgt"

void run_change_password_screen(game_client@ client) {
	audio_form f;
	screen_keyboard_follower teclado_tela;
	f.create_window(tr("account.password_title"), false);
	int f_atual = f.create_input_box(tr("account.password_current"), "", "*");
	int f_nova = f.create_input_box(tr("account.password_new"), "", "*");
	int f_repete = f.create_input_box(tr("account.password_repeat"), "", "*");
	int f_ok = f.create_button(tr("account.password_confirm"), false);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	f.focus(f_atual);

	while (true) {
		wait(5);
		f.monitor();
		teclado_tela.follow(f);
		client.update(); // mantém a conexão viva enquanto o jogador digita (ver notes/rede-e-telas.md)
		if (f.is_pressed(f_cancel)) return;
		if (!f.is_pressed(f_ok)) continue;
		string atual = f.get_text(f_atual);
		string nova = f.get_text(f_nova);
		if (atual == "") { speak(tr("account.delete_password_empty")); f.focus(f_atual); continue; }
		// As duas conferências que o cliente pode fazer sozinho, sem ida e volta: o servidor confere o
		// tamanho de novo (o valor vem da máquina do jogador).
		if (nova != f.get_text(f_repete)) { speak(tr("account.password_mismatch")); f.focus(f_nova); continue; }
		if (nova.length() < MIN_PASSWORD_LENGTH) { speak(tr("account.password_too_short")); f.focus(f_nova); continue; }

		client.send_change_password(atual, nova, g_settings.session_token != "");
		net_packet@ r = wait_change_password_result(client);
		if (@r == null) { speak(tr("account.delete_no_answer")); f.focus(f_atual); continue; }
		speak(tr(r.get_string("message")));
		if (!r.get_bool("ok")) { f.focus(r.get_string("message") == "account.password_wrong_current" ? f_atual : f_nova); continue; }
		// A troca apagou as sessões lembradas; quem lembrava a conta recebeu outra, que substitui a velha.
		string token = r.get_string("session_token");
		if (g_settings.session_token != "") { g_settings.session_token = token; g_settings.save(); }
		return;
	}
}

// A resposta do servidor, ou null se não chegou em 10 segundos. Só retira da fila o pacote que
// espera: o resto (saguão, respostas a recados) é de quem vier depois.
net_packet@ wait_change_password_result(game_client@ client) {
	timer clock;
	while (clock.elapsed < 10000) {
		wait(5);
		client.update();
		for (uint i = 0; i < client.incoming.length(); i++) {
			if (client.incoming[i].type != S_CHANGE_PASSWORD_RESULT) continue;
			net_packet@ r = client.incoming[i];
			client.incoming.remove_at(i);
			return r;
		}
	}
	return null;
}
