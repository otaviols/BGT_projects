// lobby_settings_form.nvgt
// Criar sala e configurá-la: o formulário, as predefinições salvas e os ajustes de cada papel.
//
// Parte das telas de sala (src/ui/lobby_screens.nvgt), que é quem inclui este arquivo e declara
// os #include de todas as partes: elas se chamam umas às outras e não compilam sozinhas.

// Segunda tela da criação: os TEMPOS de cada profissão (recarga, duração, janela do rastro).
//
// Só aparece para os papéis que acabaram de ser ligados na tela anterior, e só se algum foi: numa
// tela única seriam nove campos a mais para percorrer de ouvido mesmo numa sala sem papel nenhum -
// e o número cresce a cada papel novo. Quem não ligou nada nunca vê esta tela.
//
// Os campos saem de `role_traits.tunables`: um papel novo que declare um número ganha o campo aqui
// sozinho, sem ninguém lembrar de vir editar esta função.
//
// Devolve false se o anfitrião desistiu (ESC/cancelar), para a criação inteira ser cancelada em vez
// de criar a sala com metade do que ele pediu.
bool run_role_tunables_form(game_client@ client, lobby_overrides@ ov, json_object@ current) {
	// Quem foi ligado agora, na ordem de sempre.
	array<string> ligados;
	for (uint i = 0; i < CONFIGURABLE_ROLE_IDS.length(); i++) {
		string id = CONFIGURABLE_ROLE_IDS[i];
		int n = 0;
		if (ov.role_counts.get(id, n) && n > 0 && role_for(id).tunables.length() > 0) ligados.insert_last(id);
	}
	if (ligados.length() == 0) return true; // nada ligado: a tela nem abre

	json_object@ atuais = @current != null ? current.get_object("role_values") : null;

	audio_form f;
	screen_keyboard_follower teclado_tela;
	f.create_window(tr("lobby.role_tunables_title"), false);
	array<int> campos;
	array<string> chaves; // "papel.numero", na mesma ordem dos campos
	for (uint i = 0; i < ligados.length(); i++) {
		role_traits@ rt = role_for(ligados[i]);
		for (uint t = 0; t < rt.tunables.length(); t++) {
			string chave = ligados[i] + "." + rt.tunables[t].key;
			// Pré-preenchido com o que a sala já usa (na edição) ou com o padrão do papel (na
			// criação): aqui o campo vazio NÃO é "não mexi", é um número que precisa existir, então
			// mostrar o valor de partida é o que evita o anfitrião apagar sem querer e ficar com
			// zero.
			float valor = rt.tunables[t].default_value;
			if (@atuais != null && atuais.exists(chave)) valor = float(atuais[chave]);
			campos.insert_last(f.create_input_box(tr(rt.tunables[t].label_key(ligados[i])), seconds_text(valor)));
			chaves.insert_last(chave);
		}
	}
	int f_ok = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	f.focus(campos[0]); // audio_form nasce sem foco - ver CLAUDE.md
	speak(tr("lobby.role_tunables_hint"));

	g_voice.typing = true; // a tecla de falar é uma letra; aqui ela é texto
	while (true) {
		wait(5);
		client.update(); // a sala continua viva enquanto ele preenche (ver o prazo de 18 s no CLAUDE.md)
		f.monitor();
		teclado_tela.follow(f);
		if (f.is_pressed(f_cancel)) { g_voice.typing = false; return false; }
		if (f.is_pressed(f_ok)) {
			g_voice.typing = false;
			for (uint i = 0; i < campos.length(); i++) {
				float v = text_to_float_or_default(f.get_text(campos[i]));
				// Campo apagado volta ao padrão do papel, em vez de virar zero: zero numa duração é
				// uma habilidade que não faz nada, e ninguém pede isso de propósito.
				if (v < 0.0) continue;
				ov.role_values.set(chaves[i], v);
			}
			return true;
		}
	}
	return true; // inalcançável
}

// O que sai do formulário de regras: os ajustes (o que ficou em branco vem como -1/"") e, na
// criação, o nome, o código e o preset.
class lobby_form_result {
	bool ok = false;
	string lobby_name;
	string join_code;
	string preset_id = "classic";
	// Nome com que o anfitrião pediu para salvar estas regras ("" = não salvar). Vazio é o padrão:
	// salvar tem que ser uma escolha, não um efeito colateral de criar uma sala.
	string save_as = "";
	lobby_overrides ov;
}

// O formulário de regras, usado em DOIS momentos: ao criar a partida e, pelo anfitrião, com a sala
// já aberta. É um só de propósito - duas telas com os mesmos campos divergiriam na primeira mudança.
//
// `current` distingue os dois: null é criação (com nome, código e preset); com a configuração atual,
// os campos vêm PREENCHIDOS com o que vale hoje, e o que o anfitrião apagar volta a ser "não mexi".
// Impostores no modo automático ficam em branco - preencher com o número resolvido de hoje o
// congelaria sem ninguém pedir.
//
// O código de acesso aparece nos DOIS (`current_code` traz o de hoje): trocar entre pública e privada
// com a sala aberta era recriar a sala e chamar todo mundo de novo (recado #211).
lobby_form_result run_lobby_settings_form(game_client@ client, json_object@ current, bool creating = false,
		const string&in preset_base = "classic", const string&in current_code = "") {
	lobby_form_result r;
	// `creating` e `current` deixaram de ser a mesma pergunta: criar uma sala A PARTIR de uma
	// configuracao salva tem os dois (os campos vem preenchidos E o nome/codigo/preset aparecem).
	if (@current == null) creating = true;

	audio_form f;
	screen_keyboard_follower teclado_tela;
	f.create_window(tr(creating ? "menu.create_lobby" : "lobby.edit_settings"), false); // não sobrescreve o título da janela
	int f_name = -1, f_code = -1, f_preset = -1;
	if (creating) {
		f_name = f.create_input_box(tr("lobby.name"), g_settings.last_lobby_name != "" ? g_settings.last_lobby_name : tr("app.title"));
	}
	// Vazio = pública. Com código, a partida some da lista e só entra quem o digitar. Fica no alto
	// porque "é só para os amigos?" é a primeira decisão de quem cria uma sala.
	f_code = f.create_input_box(tr("lobby.join_code"), current_code);
	// O modo de jogo, separado das predefinições: o modo muda QUAIS regras existem (pega-pega não tem
	// reunião nem papel), e a predefinição só muda os números do clássico. Misturados numa lista só, o
	// anfitrião não tinha como trocar de modo com a sala aberta, e o formulário mostrava papéis no
	// pega-pega. Ao trocar, a tela esconde o que não vale e volta os campos ao padrão do modo.
	int f_mode = f.create_list(tr("lobby.game_mode"));
	f.add_list_item(f_mode, tr("lobby.mode.classic_desc"), GAME_MODE_CLASSIC);
	f.add_list_item(f_mode, tr("lobby.preset.tag_desc"), GAME_MODE_TAG);
	f.add_list_item(f_mode, tr("lobby.preset.wolves_desc"), GAME_MODE_WOLVES);
	string modo = @current != null && current.exists("game_mode") ? string(current["game_mode"]) : preset_base;
	if (modo == GAME_MODE_TAG) f.set_list_position(f_mode, 1);
	else if (modo == GAME_MODE_WOLVES) f.set_list_position(f_mode, 2);
	else { f.set_list_position(f_mode, 0); modo = GAME_MODE_CLASSIC; }
	if (creating) {
		f_preset = f.create_list(tr("menu.settings"));
		f.add_list_item(f_preset, tr("lobby.preset.classic_desc"), "classic");
		f.add_list_item(f_preset, tr("lobby.preset.quick_desc"), "quick");
		f.add_list_item(f_preset, tr("lobby.preset.chaos_desc"), "chaos");
		// Partindo de uma configuração salva, a lista já abre no preset sobre o qual ela foi feita -
		// senão o anfitrião teria de lembrar qual era, e errar aqui muda as regras por baixo dos
		// ajustes que ele acabou de carregar.
		if (preset_base == "quick") f.set_list_position(f_preset, 1);
		else if (preset_base == "chaos") f.set_list_position(f_preset, 2);
	}
	// Ajustes finos sobre o preset. TODOS aceitam vazio, e vazio significa "usa o que o preset diz" -
	// é o que mantém a tela utilizável para quem só quer criar uma sala e jogar, enquanto abre a
	// porta para quem quer mexer. Um formulário que exigisse todos os campos transformaria a criação
	// de partida numa lição de casa.
	int f_kill_cooldown = f.create_input_box(tr("lobby.kill_cooldown_override"), current_float_text(current, "kill_cooldown_seconds"));
	int f_max_players = f.create_input_box(tr("lobby.max_players_override"), current_int_text(current, "max_players"));
	bool auto_impostors = @current != null && bool(current["impostors_automatic"]);
	int f_impostors = f.create_input_box(tr("lobby.impostor_count_override"), auto_impostors ? "" : current_int_text(current, "impostor_count"));
	// Papéis especiais e modificadores numa tela À PARTE cada um, aberta por um botão logo depois dos
	// impostores (é a mesma pergunta: quem joga contra quem). Eram dois campos por papel aqui mesmo, e com
	// a leva de papéis da 0.50.0 o formulário passou dos 50 controles que o audio_form aceita: os campos
	// do fim - e o botão de confirmar - simplesmente não eram criados, e a sala nunca saía (ver
	// "audio_form tem teto de 50" no CLAUDE.md). Separados, também ficam mais curtos de percorrer.
	role_choice escolha;
	escolha.load(current);
	int f_roles_btn = f.create_button(role_choice_caption("lobby.roles_button", escolha, CONFIGURABLE_ROLE_IDS));
	int f_mods_btn = f.create_button(role_choice_caption("lobby.modifiers_button", escolha, CONFIGURABLE_MODIFIER_IDS));
	int f_tasks = f.create_input_box(tr("lobby.task_count_override"), current_int_text(current, "task_count_per_crewmate"));
	int f_long_tasks = f.create_input_box(tr("lobby.long_task_count_override"), current_int_text(current, "long_task_count"));
	int f_meeting_time = f.create_input_box(tr("lobby.meeting_time_override"), current_float_text(current, "meeting_time_seconds"));
	int f_meetings = f.create_input_box(tr("lobby.emergency_meetings_override"), current_int_text(current, "emergency_meetings_per_player"));
	int f_sabotages = f.create_list(tr("lobby.sabotages_override"));
	f.add_list_item(f_sabotages, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_sabotages, tr("lobby.override.enabled"), "on");
	f.add_list_item(f_sabotages, tr("lobby.override.disabled"), "off");
	if (@current != null) f.set_list_position(f_sabotages, bool(current["sabotages_enabled"]) ? 1 : 2);
	int f_vents = f.create_list(tr("lobby.vents_override"));
	f.add_list_item(f_vents, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_vents, tr("lobby.override.enabled"), "on");
	f.add_list_item(f_vents, tr("lobby.override.disabled"), "off");
	if (@current != null && current.exists("vents_enabled")) f.set_list_position(f_vents, bool(current["vents_enabled"]) ? 1 : 2);
	int f_colors = f.create_list(tr("lobby.colors_override"));
	f.add_list_item(f_colors, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_colors, tr("lobby.colors.random"), "random");
	f.add_list_item(f_colors, tr("lobby.colors.choice"), "choice");
	if (@current != null && current.exists("color_choice")) f.set_list_position(f_colors, bool(current["color_choice"]) ? 2 : 1);
	int f_color_mode = f.create_list(tr("lobby.color_mode_override"));
	f.add_list_item(f_color_mode, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_color_mode, tr("lobby.override.enabled"), "on");
	f.add_list_item(f_color_mode, tr("lobby.override.disabled"), "off");
	if (@current != null && current.exists("color_mode")) f.set_list_position(f_color_mode, bool(current["color_mode"]) ? 1 : 2);
	int f_reveal = f.create_list(tr("lobby.reveal_ejected_override"));
	f.add_list_item(f_reveal, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_reveal, tr("lobby.reveal.on"), "on");
	f.add_list_item(f_reveal, tr("lobby.reveal.off"), "off");
	if (@current != null && current.exists("reveal_ejected_role")) f.set_list_position(f_reveal, bool(current["reveal_ejected_role"]) ? 1 : 2);
	int f_votes = f.create_list(tr("lobby.show_votes_override"));
	f.add_list_item(f_votes, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_votes, tr("lobby.votes.on"), "on");
	f.add_list_item(f_votes, tr("lobby.votes.off"), "off");
	if (@current != null && current.exists("show_votes")) f.set_list_position(f_votes, bool(current["show_votes"]) ? 1 : 2);
	int f_emergency_cd = f.create_input_box(tr("lobby.emergency_cooldown_override"), current_float_text(current, "emergency_cooldown_seconds"));
	int f_comms_meeting = f.create_list(tr("lobby.comms_meeting_override"));
	f.add_list_item(f_comms_meeting, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_comms_meeting, tr("lobby.comms_meeting.on"), "on");
	f.add_list_item(f_comms_meeting, tr("lobby.comms_meeting.off"), "off");
	if (@current != null && current.exists("comms_affects_meeting")) f.set_list_position(f_comms_meeting, bool(current["comms_affects_meeting"]) ? 1 : 2);
	int f_voice = f.create_list(tr("lobby.voice_chat_override"));
	f.add_list_item(f_voice, tr("lobby.override.preset_default"), "");
	f.add_list_item(f_voice, tr("lobby.override.enabled"), "on");
	f.add_list_item(f_voice, tr("lobby.override.disabled"), "off");
	if (@current != null && current.exists("voice_chat")) f.set_list_position(f_voice, bool(current["voice_chat"]) ? 1 : 2);
	int f_speed = f.create_input_box(tr("lobby.move_speed_override"), current_int_text(current, "move_speed_percent"));
	// Salvar estas regras, por último e só na criação: é a pergunta que só faz sentido depois de
	// tudo estar preenchido. Vazio = não salva - a última usada é guardada sozinha de qualquer jeito
	// (ver run_create_lobby_screen), então ninguém precisa digitar nada para ter "a de ontem".
	int f_save_as = creating ? f.create_input_box(tr("lobby.preset_save_as"), "") : -1;
	int f_ok = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);

	// O que cada modo mostra. Só do clássico: tudo que é reunião, papel, sabotagem e duto. Fora do todos
	// lobos: recarga de kill (lá quem engole tem a recarga do lobo) e tarefas (lá vence o último de pé).
	array<int> so_classico = {f_preset, f_impostors, f_roles_btn, f_mods_btn, f_meeting_time, f_meetings, f_sabotages, f_vents,
		f_reveal, f_votes, f_emergency_cd, f_comms_meeting};
	array<int> fora_dos_lobos = {f_kill_cooldown, f_tasks, f_long_tasks};
	// O que volta ao padrão quando o modo muda: o valor de hoje era do modo de antes.
	array<int> textos = {f_kill_cooldown, f_max_players, f_impostors, f_tasks, f_long_tasks, f_meeting_time,
		f_meetings, f_emergency_cd, f_speed};
	array<int> listas = {f_sabotages, f_vents, f_colors, f_color_mode, f_reveal, f_votes, f_comms_meeting, f_voice};
	lobby_form_show_for_mode(f, modo, so_classico, fora_dos_lobos);

	// Sem o botão de confirmar o formulário não tem saída - e o audio_form não avisa quando recusa um
	// controle. Fica registrado, em vez de uma tela muda em que o Enter não faz nada.
	if (f_ok < 0) log_diagnostic("formulario de sala sem o botao de confirmar: controles demais");

	// Um audio_form nasce sem foco: sem isto o primeiro campo não recebia o que era digitado até o
	// jogador apertar Tab.
	f.focus(creating ? f_name : f_mode);
	if (!creating) speak(tr("lobby.edit_settings_hint"));

	g_voice.typing = true; // a tecla de falar é uma letra; aqui ela é texto
	while (true) {
		wait(5);
		client.update(); // mantém a conexão viva enquanto o jogador preenche o formulário
		f.monitor();
		teclado_tela.follow(f);
		int pos_modo = f.get_list_position(f_mode);
		string modo_agora = pos_modo >= 0 ? f.get_list_item_id(f_mode, pos_modo) : modo;
		if (modo_agora != modo) {
			modo = modo_agora;
			for (uint i = 0; i < textos.length(); i++) f.set_text(textos[i], "");
			for (uint i = 0; i < listas.length(); i++) f.set_list_position(listas[i], 0);
			escolha.clear();
			f.set_caption(f_roles_btn, role_choice_caption("lobby.roles_button", escolha, CONFIGURABLE_ROLE_IDS));
			f.set_caption(f_mods_btn, role_choice_caption("lobby.modifiers_button", escolha, CONFIGURABLE_MODIFIER_IDS));
			lobby_form_show_for_mode(f, modo, so_classico, fora_dos_lobos);
			// Dito com o foco ainda na lista: quem trocou precisa saber que o resto da tela mudou junto.
			speak(tr("lobby.mode_form_reset"), false);
		}
		// is_pressed CONSOME o aperto: lido duas vezes, o segundo dá false. Era assim que o botão de
		// papéis abria a tela de modificadores - a decisão de qual abrir lia de novo o que já tinha sido
		// lido. Cada botão uma vez, guardado (a mesma regra do key_pressed, no CLAUDE.md).
		bool apertou_papeis = f.is_pressed(f_roles_btn);
		bool apertou_mods = f.is_pressed(f_mods_btn);
		if (apertou_papeis || apertou_mods) {
			bool papeis = apertou_papeis;
			int botao = papeis ? f_roles_btn : f_mods_btn;
			run_role_choice_form(client, escolha, papeis ? CONFIGURABLE_ROLE_IDS : CONFIGURABLE_MODIFIER_IDS,
				papeis ? "lobby.roles_title" : "lobby.modifiers_title");
			f.set_caption(botao, role_choice_caption(papeis ? "lobby.roles_button" : "lobby.modifiers_button", escolha,
				papeis ? CONFIGURABLE_ROLE_IDS : CONFIGURABLE_MODIFIER_IDS));
			f.focus(botao); // de volta ao botão, que já diz quantos ficaram ligados
		}
		if (f.is_pressed(f_cancel)) { g_voice.typing = false; return r; }
		if (f.is_pressed(f_ok)) {
			g_voice.typing = false;
			r.ok = true;
			r.join_code = f.get_text(f_code);
			if (creating) {
				r.lobby_name = f.get_text(f_name);
				r.save_as = f.get_text(f_save_as);
				int preset_index = f.get_list_position(f_preset);
				r.preset_id = preset_index >= 0 ? f.get_list_item_id(f_preset, preset_index) : "classic";
				// Fora do clássico o modo É o preset (é o que o servidor entende na criação).
				if (modo != GAME_MODE_CLASSIC) r.preset_id = modo;
			} else {
				r.ov.game_mode = modo;
			}
			// -1 em número e "" em texto significam "não mexi nisto": é o servidor que decide o
			// valor final. Mandar 0 no lugar seria pedir uma partida com zero tarefas por engano.
			r.ov.kill_cooldown_seconds = text_to_float_or_default(visible_text(f, f_kill_cooldown));
			r.ov.max_players = text_to_int_or_default(f.get_text(f_max_players));
			r.ov.impostor_count = text_to_int_or_default(visible_text(f, f_impostors));
			// Papéis: vazio significa ZERO, e não "não mexi" - é a única forma de o anfitrião
			// desligar um papel que estava ligado (apagando o número). Por isso o campo é mandado
			// sempre, com 0 quando vazio.
			// Fora do clássico não há papel nenhum: o dicionário vai vazio, que é "não mexi" (e o servidor
			// limpa os papéis de qualquer jeito ao validar o modo).
			if (modo == GAME_MODE_CLASSIC) {
				array<string>@ ids_da_sala = configurable_ids();
				for (uint i = 0; i < ids_da_sala.length(); i++) {
					r.ov.role_counts.set(ids_da_sala[i], escolha.count(ids_da_sala[i]));
					r.ov.role_chances.set(ids_da_sala[i], escolha.chance(ids_da_sala[i]));
				}
			}
			r.ov.task_count_per_crewmate = text_to_int_or_default(visible_text(f, f_tasks));
			r.ov.long_task_count = text_to_int_or_default(visible_text(f, f_long_tasks));
			r.ov.meeting_time_seconds = text_to_float_or_default(visible_text(f, f_meeting_time));
			r.ov.emergency_meetings_per_player = text_to_int_or_default(visible_text(f, f_meetings));
			int sab_index = f.get_list_position(f_sabotages);
			r.ov.sabotages = sab_index >= 0 ? f.get_list_item_id(f_sabotages, sab_index) : "";
			int vents_index = f.get_list_position(f_vents);
			r.ov.vents = vents_index >= 0 ? f.get_list_item_id(f_vents, vents_index) : "";
			int colors_index = f.get_list_position(f_colors);
			r.ov.colors = colors_index >= 0 ? f.get_list_item_id(f_colors, colors_index) : "";
			int color_mode_index = f.get_list_position(f_color_mode);
			r.ov.color_mode = color_mode_index >= 0 ? f.get_list_item_id(f_color_mode, color_mode_index) : "";
			r.ov.move_speed_percent = text_to_int_or_default(f.get_text(f_speed));
			int rev_index = f.get_list_position(f_reveal);
			r.ov.reveal_ejected = rev_index >= 0 ? f.get_list_item_id(f_reveal, rev_index) : "";
			int votes_index = f.get_list_position(f_votes);
			r.ov.show_votes = votes_index >= 0 ? f.get_list_item_id(f_votes, votes_index) : "";
			int voice_index = f.get_list_position(f_voice);
			r.ov.voice_chat = voice_index >= 0 ? f.get_list_item_id(f_voice, voice_index) : "";
			r.ov.emergency_cooldown_seconds = text_to_float_or_default(visible_text(f, f_emergency_cd));
			int cm_index = f.get_list_position(f_comms_meeting);
			r.ov.comms_in_meeting = cm_index >= 0 ? f.get_list_item_id(f_comms_meeting, cm_index) : "";
				// Os tempos das profissoes vem numa SEGUNDA tela, e so das que foram ligadas aqui: numa
				// tela so seriam mais nove campos para percorrer de ouvido mesmo numa sala sem papel
				// nenhum. Quem nao ligou nada nao ve tela nenhuma.
				if (modo == GAME_MODE_CLASSIC && !run_role_tunables_form(client, r.ov, current)) { r.ok = false; return r; }
			return r;
		}
	}
	return r; // inalcançável - o laço só termina via return acima
}

// Os papéis e modificadores escolhidos para a sala, editados na tela própria (run_role_choice_form) e
// mandados junto do formulário principal. Começa com o que a sala já usa (edição ou configuração salva).
class role_choice {
	dictionary counts;  // id -> quantos (ausente = 0)
	dictionary chances; // id -> por cento (ausente = 100, "sempre")

	void load(json_object@ current) {
		clear();
		if (@current == null) return;
		json_object@ c = current.get_object("role_counts");
		json_object@ ch = current.get_object("role_chances");
		array<string>@ ids = configurable_ids();
		for (uint i = 0; i < ids.length(); i++) {
			if (@c != null && c.exists(ids[i]) && int(c[ids[i]]) > 0) counts.set(ids[i], int(c[ids[i]]));
			if (@ch != null && ch.exists(ids[i]) && int(ch[ids[i]]) < 100) chances.set(ids[i], int(ch[ids[i]]));
		}
	}
	void clear() { counts.delete_all(); chances.delete_all(); }
	int count(const string&in id) { int n = 0; if (counts.exists(id)) counts.get(id, n); return n; }
	int chance(const string&in id) { int c = 100; if (chances.exists(id)) chances.get(id, c); return c; }
	uint on_count(const array<string>@ ids) { uint n = 0; for (uint i = 0; i < ids.length(); i++) if (count(ids[i]) > 0) n++; return n; }
}

string role_choice_caption(const string&in key, role_choice@ escolha, const array<string>@ ids) {
	dictionary@ p = dictionary();
	p.set("count", "" + escolha.on_count(ids));
	return tr(key, p);
}

// A tela de papéis (ou de modificadores): dois campos por id, quantos e a chance de cada vaga. Vazio =
// zero, e zero é o jogo de sempre; chance vazia (ou 100) é "sempre", o óbvio para quem só quer ligar e
// jogar. A chance é o que impede a tripulação de assumir que o papel existe. Confirmar grava em
// `escolha`; cancelar deixa como estava.
void run_role_choice_form(game_client@ client, role_choice@ escolha, const array<string>@ ids, const string&in title_key) {
	audio_form f;
	screen_keyboard_follower teclado_tela;
	f.create_window(tr(title_key), false);
	array<int> f_counts, f_chances;
	for (uint i = 0; i < ids.length(); i++) {
		int n = escolha.count(ids[i]);
		f_counts.insert_last(f.create_input_box(tr("lobby.role_count." + ids[i]), n > 0 ? "" + n : ""));
		int c = escolha.chance(ids[i]);
		f_chances.insert_last(f.create_input_box(tr("lobby.role_chance." + ids[i]), c < 100 ? "" + c : ""));
	}
	int f_ok = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	if (f_ok < 0) log_diagnostic("tela de papeis sem o botao de confirmar: controles demais");
	f.focus(f_counts.length() > 0 ? f_counts[0] : f_ok);
	while (true) {
		wait(5);
		client.update();
		f.monitor();
		teclado_tela.follow(f);
		if (f.is_pressed(f_cancel)) return;
		if (f.is_pressed(f_ok)) {
			for (uint i = 0; i < ids.length(); i++) {
				int n = text_to_int_or_default(f.get_text(f_counts[i]));
				if (n > 0) escolha.counts.set(ids[i], n); else escolha.counts.delete(ids[i]);
				int c = text_to_int_or_default(f.get_text(f_chances[i]));
				if (c >= 0 && c < 100) escolha.chances.set(ids[i], c); else escolha.chances.delete(ids[i]);
			}
			return;
		}
	}
}

// Mostra no formulário só o que vale para o modo (ver o comentário da lista de modos acima). Campos -1
// (o da predefinição, que só existe na criação) ficam de fora.
void lobby_form_show_for_mode(audio_form@ f, const string&in modo, array<int>@ so_classico, array<int>@ fora_dos_lobos) {
	for (uint i = 0; i < so_classico.length(); i++)
		if (so_classico[i] >= 0) f.set_state(so_classico[i], true, modo == GAME_MODE_CLASSIC);
	for (uint i = 0; i < fora_dos_lobos.length(); i++)
		if (fora_dos_lobos[i] >= 0) f.set_state(fora_dos_lobos[i], true, modo != GAME_MODE_WOLVES);
}

// O texto de um campo, ou "" se ele está escondido pelo modo: escondido é "não mexi", e não o valor
// que ficou lá do modo anterior.
string visible_text(audio_form@ f, int c) {
	return f.is_visible(c) ? f.get_text(c) : "";
}

// Valor atual de um campo como texto para pré-preencher o formulário - "" quando não há configuração
// (criação) ou o campo não veio.
string current_int_text(json_object@ cfg, const string&in key) {
	if (@cfg == null || !cfg.exists(key)) return "";
	return "" + int(cfg[key]);
}

string current_float_text(json_object@ cfg, const string&in key) {
	if (@cfg == null || !cfg.exists(key)) return "";
	return seconds_text(float(cfg[key]));
}

// Tela de criação de partida.
//
// Devolve o primeiro S_LOBBY_STATE da partida criada, ou null se o jogador desistiu ou o servidor não
// respondeu. O pacote é DEVOLVIDO, e não descartado, porque é o único retrato da sala que o anfitrião
// recebe enquanto estiver sozinho nela.
net_packet@ run_create_lobby_screen(game_client@ client) {
	// De onde partir: os padrões, a última sala que ele criou, ou uma configuração salva. O menu só
	// aparece se houver algo salvo - quem nunca salvou nada cai direto no formulário, como antes.
	lobby_preset partida_base;
	string base_escolhida = run_lobby_preset_picker(client, partida_base);
	if (base_escolhida == "__cancel__") return null;

	json_object@ partida_inicial = null;
	if (base_escolhida != "__default__") {
		// Os ajustes salvos viram uma configuração RESOLVIDA, que é o formato que o formulário já
		// sabe preencher (o mesmo da edição de uma sala aberta). Assim não há um segundo caminho de
		// pré-preenchimento para manter em sincronia.
		lobby_config base = get_preset(partida_base.preset_id);
		partida_base.ov.apply_to(base);
		base.validate();
		@partida_inicial = base.to_json(base.max_players);
	}

	lobby_form_result r = run_lobby_settings_form(client, partida_inicial, true, partida_base.preset_id);
	if (!r.ok) return null;

	// A última usada é guardada SEMPRE, sem o jogador pedir: é o caso comum ("quero a de ontem") e
	// não custa uma decisão a ele. O nome só é gravado se ele digitou um.
	lobby_preset_save(LOBBY_PRESET_LAST_USED, r.preset_id, r.ov);
	// O nome também, pelo mesmo motivo. Vazio não apaga o lembrado: quem apagou o campo para usar o
	// padrão do servidor ("Partida de fulano") só desta vez não perde o nome de sempre.
	if (r.lobby_name != "") {
		g_settings.last_lobby_name = r.lobby_name;
		g_settings.save();
	}
	if (r.save_as != "") {
		lobby_preset_save(r.save_as, r.preset_id, r.ov);
		dictionary@ p = dictionary();
		p.set("name", r.save_as);
		speak(tr("lobby.preset_saved", p));
	}

	client.send_create_lobby(r.lobby_name, r.preset_id, r.ov, r.join_code);
	return wait_for_lobby_state_after_create(client);
}

// De qual configuração partir. Devolve "__default__" (regras de fábrica), "__cancel__" (desistiu) ou
// o nome escolhido - e nesse caso `out` vem preenchido.
//
// A tela inteira é pulada quando não há nada salvo: ninguém deve atravessar um menu para dizer "a
// única opção que existe".
string run_lobby_preset_picker(game_client@ client, lobby_preset@ destino) {
	while (true) {
		array<string> nomes = lobby_preset_names();
		bool tem_ultima = lobby_preset_exists(LOBBY_PRESET_LAST_USED);
		if (nomes.length() == 0 && !tem_ultima) return "__default__";

		screen_menu m;
		m.intro_text = tr("lobby.preset_picker_hint");
		m.click_sound = "ui/menu_click.ogg";
		m.select_sound = "ui/menu_confirm.ogg";
		m.sounds_prefix = "sounds/";
		@g_lobby_pump_client = client;
		@m.background_callback = @pump_client_during_menu;

		// A última usada vem primeiro: é a que mais gente vai querer, e num menu falado a primeira
		// posição é a única que não custa navegação.
		if (tem_ultima) m.add_item(tr("lobby.preset_last_used"), "__last__");
		m.add_item(tr("lobby.preset_defaults"), "__default__");
		for (uint i = 0; i < nomes.length(); i++) m.add_item(nomes[i], nomes[i]);
		if (nomes.length() > 0) m.add_item(tr("lobby.preset_delete"), "__delete__");
		m.add_item(tr("menu.back"), "__cancel__");
		m.run();

		string id = m.selected_item_id;
		if (id == "" || id == "__cancel__") return "__cancel__";
		if (id == "__default__") return "__default__";
		if (id == "__delete__") { run_lobby_preset_delete(client); continue; }

		string chave = id == "__last__" ? LOBBY_PRESET_LAST_USED : id;
		// Preset ilegível (arquivo de preferências corrompido, editado à mão): avisa e volta ao menu,
		// em vez de criar uma sala com metade das regras sem ninguém perceber.
		if (!lobby_preset_load(chave, destino)) { speak(tr("lobby.preset_unreadable")); continue; }
		return id;
	}
	return "__cancel__"; // inalcançável
}

// Apagar uma configuração salva. Sem isto a lista só cresce, e um nome digitado errado ficaria lá
// para sempre.
void run_lobby_preset_delete(game_client@ client) {
	array<string> nomes = lobby_preset_names();
	if (nomes.length() == 0) return;

	screen_menu m;
	m.intro_text = tr("lobby.preset_delete_hint");
	m.click_sound = "ui/menu_click.ogg";
	m.select_sound = "ui/menu_confirm.ogg";
	m.sounds_prefix = "sounds/";
	@g_lobby_pump_client = client;
	@m.background_callback = @pump_client_during_menu;
	for (uint i = 0; i < nomes.length(); i++) m.add_item(nomes[i], nomes[i]);
	m.add_item(tr("menu.back"), "__cancel__");
	m.run();

	string id = m.selected_item_id;
	if (id == "" || id == "__cancel__") return;
	lobby_preset_delete(id);
	dictionary@ p = dictionary();
	p.set("name", id);
	speak(tr("lobby.preset_deleted", p));
}

// Campo vazio (ou lixo digitado) vira -1 = "não mexi nisto, use o preset". Aceitar lixo como -1 em
// vez de recusar é deliberado: quem digitou "vinte" no lugar de "20" recebe a partida do preset em
// vez de um formulário travado que ele não consegue enxergar para descobrir onde errou.
float text_to_float_or_default(const string&in text) {
	if (text == "") return -1.0;
	float value = parse_float(text);
	return value > 0.0 ? value : -1.0;
}

int text_to_int_or_default(const string&in text) {
	if (text == "") return -1;
	int value = parse_int(text);
	return value > 0 ? value : -1;
}

// A criação é confirmada pelo primeiro S_LOBBY_STATE. Ele é DEVOLVIDO a quem chamou, não descartado:
// é o retrato de quem está na sala e de quais são as regras, e o servidor só manda outro quando
// alguém entra ou sai - o anfitrião sozinho nunca receberia um segundo.
net_packet@ wait_for_lobby_state_after_create(game_client@ client) {
	timer@ wait_clock = timer();
	while (float(wait_clock.elapsed) / 1000.0 < 5.0) {
		wait(20);
		client.update();
		drain_hall_packets(client); // o saguão não pode ser engolido por uma espera (ver drain_hall_packets)
		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			if (pkt.type == S_LOBBY_STATE) return pkt;
			@pkt = client.poll_message();
		}
	}
	return null;
}
