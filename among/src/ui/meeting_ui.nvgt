// meeting_ui.nvgt
// Reação do cliente a eventos de reunião/votação/sabotagem/corpo/fim de jogo: anúncios falados,
// sons de alarme e o menu de votação navegável por teclado (setas + Enter, ESC = pular votação).

#include "menu.nvgt"
#include "speech.nvgt"
#include "../network/protocol.nvgt"
#include "../network/packet.nvgt"
#include "../network/client.nvgt"
#include "../core/client_state.nvgt"
#include "../core/sabotage_rules.nvgt"
#include "../core/chat_log.nvgt"
#include "../audio/audio_manager.nvgt"
#include "../i18n.nvgt"
#include "../config/game_constants.nvgt"

// menu.run() bloqueia localmente enquanto o jogador escolhe o voto, sem nunca chamar
// client.update() - sem isso a conexão para de ser "servida" (nada de keepalive/ack via ENet)
// durante o tempo em que o menu fica aberto, podendo deixar a rede "travada" pra esse peer depois
// que a votação termina (mesmo problema já visto e corrigido no navegador de lobbies, ver
// ui/lobby_screens.nvgt - nome diferente aqui só pra não colidir com aquele global).
game_client@ g_vote_pump_client;
// A reunião de quem está com o menu aberto. Enquanto ele bloqueia, o laço da partida não roda - e
// eram dele os dois sinais que dizem ao jogador que o tempo está acabando: a fala do que chega e o
// tique dos dez segundos finais. Sem isto, quem abria a lista de nomes ficava numa sala silenciosa,
// sem chat, sem sabotagem e sem contagem, até desistir de votar.
meeting_ui@ g_vote_pump_ui;
void pump_client_during_vote_menu(menu@ m, string data) {
	if (@g_vote_pump_client != null) {
		g_vote_pump_client.update();
		// Fala o que chegou SEM tirar da fila: o laço principal ainda vai tratar cada pacote com
		// todos os efeitos dele (ver announce_background_events).
		announce_background_events(g_vote_pump_client);
	}
	if (@g_vote_pump_ui != null) g_vote_pump_ui.tick_vote_timer();
}

class meeting_ui {
	game_client@ client;
	audio_manager@ audio;
	client_roster@ roster;
	chat_log@ events_log;
	bool is_impostor;
	// Se ESTE jogador ainda está vivo. O laço da partida mantém isto em dia (ver game/game_loop.nvgt)
	// porque a sabotagem de luzes não deve cegar quem já morreu - ver core/sabotage_rules.nvgt.
	bool alive = true;
	// Com as luzes sabotadas os corpos ficam mudos (ver refresh_body_beacons em game/game_loop.nvgt) -
	// inclusive os que caírem DURANTE o apagão, que é o caso que mais importa.
	bool body_sounds_enabled = true;
	bool voting_active = false;
	bool has_voted = false; // reseta a cada reunião nova (ver on_voting_started)

	// Quanto tempo a fase atual (discussão ou votação) tinha, e desde quando ela começou. O servidor
	// manda a duração junto com o evento de início; o relógio corre aqui no cliente.
	//
	// É contagem LOCAL, e não um valor que o servidor fica reenviando: mandar o tempo restante a cada
	// segundo para todo mundo seria muito tráfego para uma informação que cada cliente consegue
	// calcular sozinho. O preço é uma diferença de fração de segundo em relação ao servidor, que não
	// muda nada para quem está decidindo em quem votar.
	private float phase_duration_seconds = 0.0;
	private timer@ phase_clock = null;

	private void start_phase_clock(float duration_seconds) {
		phase_duration_seconds = duration_seconds;
		@phase_clock = timer();
		phase_clock.restart();
	}

	// Segundos que faltam para a fase atual acabar, ou -1 se não há reunião em andamento.
	float phase_seconds_remaining() const {
		if (@phase_clock == null) return -1.0;
		float left = phase_duration_seconds - float(phase_clock.elapsed) / 1000.0;
		return left > 0.0 ? left : 0.0;
	}

	// Fala quanto falta para a fase atual terminar. É o que a tecla da lista de tarefas faz enquanto
	// a reunião está acontecendo - ver game/game_loop.nvgt.
	//
	// Diz também QUAL fase é: "faltam 20 segundos" sem dizer de quê é ambíguo justamente no momento
	// em que a diferença importa - o fim da discussão só abre a votação, o fim da votação encerra a
	// reunião com o voto que estiver valendo.
	void announce_time_remaining() {
		float left = phase_seconds_remaining();
		if (left < 0.0) return;
		dictionary@ p = dictionary();
		p.set("seconds", "" + int(left + 0.5)); // arredonda: "faltam 19,4 segundos" não ajuda ninguém
		speak(tr(voting_active ? "game.meeting_time_voting" : "game.meeting_time_discussion", p));
	}

	meeting_ui(game_client@ client, audio_manager@ audio, client_roster@ roster, chat_log@ events_log, bool is_impostor) {
		@this.client = client;
		@this.audio = audio;
		@this.roster = roster;
		@this.events_log = events_log;
		this.is_impostor = is_impostor;
	}

	private string name_of(uint64 peer_id) const {
		roster_entry@ e = roster.find(peer_id);
		return @e != null ? e.name : "";
	}

	// Fala na hora (igual sempre foi) e também guarda no container de eventos, pra dar pra reler
	// depois com PageUp/PageDown + vírgula/ponto.
	// `say` em false quando uma tela bloqueante já disse isto (ver core/event_speech.nvgt): o texto
	// ainda entra no histórico para ser relido, mas não é falado de novo ao fechar a tela.
	private void announce(const string&in text, bool say = true) {
		if (say) speak(text);
		events_log.add("", text);
	}

	void on_body_reported(net_packet@ pkt) {
		audio.stop_body_beacon(pkt.get_uint64("body_peer"));
		audio.play_body_reported_sound();
		dictionary@ params = dictionary();
		params.set("reporter", name_of(pkt.get_uint64("reporter_peer")));
		params.set("victim", name_of(pkt.get_uint64("body_peer")));
		string room_key = pkt.get_string("room_key");
		params.set("room", room_key != "" ? tr(room_key) : tr("game.unknown_room"));
		announce(tr("game.body_reported", params));
	}

	void on_meeting_started(net_packet@ pkt) {
		voting_active = false;
		start_phase_clock(pkt.get_float("discussion_time"));
		string reason = pkt.get_string("reason");
		if (reason == "button") {
			audio.play_meeting_alarm();
			dictionary@ params = dictionary();
			params.set("name", name_of(pkt.get_uint64("caller_peer")));
			announce(tr("game.emergency_meeting_called", params));
		} else {
			announce(tr("game.meeting_discussion"));
		}
	}

	void on_voting_started(net_packet@ pkt) {
		voting_active = true;
		has_voted = false;
		start_phase_clock(pkt.get_float("voting_time"));
		// Não abre o menu de votação sozinho - isso travava o jogador lá dentro sem conseguir usar
		// o chat pra discutir antes de votar. Agora é só um aviso; o jogador abre o menu quando
		// quiser com a tecla de votar (ver ACTION_VOTE em config/keybindings.nvgt).
		announce(tr("game.meeting_voting"));
	}

	// Avisa que ALGUÉM votou (sem dizer em quem) - dá pra acompanhar quantos já votaram sem
	// estragar o suspense do resultado final.
	void on_vote_cast(net_packet@ pkt) {
		uint64 voter_peer = pkt.get_uint64("voter_peer");
		if (voter_peer == client.my_peer_id) has_voted = true;
		dictionary@ params = dictionary();
		params.set("voter", pkt.get_string("voter_name"));
		// Votos abertos (regra da sala): o alvo vem junto e é dito na hora - é o que muda a discussão
		// enquanto ela acontece. Fechados: só "votou".
		if (pkt.get_bool("target_revealed", false)) {
			if (pkt.get_bool("skipped", false)) announce(tr("game.vote_cast_skip", params));
			else { params.set("target", pkt.get_string("target_name")); announce(tr("game.vote_cast", params)); }
		} else {
			announce(tr("game.vote_cast_announcement", params));
		}
	}

	void on_vote_result(net_packet@ pkt) {
		voting_active = false;
		// A reunião acabou: sem isto o relógio continuaria "correndo" e a tecla de tempo responderia
		// "faltam 0 segundos" no meio da partida seguinte, como se ainda houvesse reunião.
		@phase_clock = null;

		// A lista de quem votou em quem não é mais lida aqui: com os votos abertos ela foi dita voto
		// a voto durante a reunião, e com os votos fechados ela nem vem. Repetir no fim atrasava o
		// resultado em dez frases que todo mundo já tinha ouvido.
		audio.play_meeting_result();
		// Pausa de suspense: o som toca sozinho primeiro, e só DEPOIS vem o anúncio de quem foi
		// expulso - tocar os dois juntos (como estava antes) atropelava a fala e tirava a graça do
		// suspense, igual no jogo original onde o resultado só aparece depois do som.
		wait(1500);

		uint64 ejected_peer = pkt.get_uint64("ejected_peer");
		if (ejected_peer == 0) {
			announce(tr(pkt.get_bool("tie") ? "game.vote_result_tie" : "game.no_one_ejected"));
			return;
		}
		roster.mark_dead(ejected_peer);
		audio.play_ejected(); // só toca quando alguém É expulso, depois do som geral de resultado
		dictionary@ params = dictionary();
		params.set("name", pkt.get_string("ejected_name"));
		// O papel de quem foi expulso é a informação mais importante da reunião inteira: é o que diz
		// se a tripulação acertou ou linchou um inocente. O servidor já mandava isso desde sempre
		// (was_impostor no S_VOTE_RESULT) e o cliente estava jogando fora.
		// role_revealed ausente = servidor antigo, que sempre mandava o papel.
		if (!pkt.get_bool("role_revealed", true)) announce(tr("game.vote_result_ejected_unknown", params));
		else announce(tr(pkt.get_bool("was_impostor") ? "game.vote_result_ejected_impostor" : "game.vote_result_ejected_crewmate", params));
	}

	// Chamado quando o jogador aperta a tecla de votar - só faz algo se a votação estiver mesmo
	// rolando no momento e ele ainda não tiver votado nesta reunião.
	void open_vote_menu_if_active() {
		if (!voting_active) return;
		if (has_voted) { speak(tr("game.already_voted")); return; }
		run_voting_menu();
	}

	void on_sabotage_started(net_packet@ pkt) {
		string sabotage_id = pkt.get_string("sabotage_id");
		announce(sabotage_started_text(pkt), !pkt.announced);
		// O alarme e o alcance de audição NÃO são ligados aqui: quem manda neles é
		// apply_sabotage_effects (game/game_loop.nvgt), que é reavaliado também quando o jogador
		// morre e quando a reunião acaba. Com dois donos, cada caminho esquecia um deles.
	}

	// Lembrete de quanto falta na sabotagem crítica (marcos de 30 em 30) e a contagem dos 10 finais.
	void on_sabotage_countdown(net_packet@ pkt) {
		if (pkt.announced) return; // uma tela bloqueante já disse este número
		if (pkt.get_bool("final")) {
			// speak() direto, sem passar pelo registro de eventos: dez números seguidos entupiriam o
			// histórico que o jogador relê com PageUp/PageDown, empurrando pra fora justamente o que
			// interessa reler (quem reportou, quem votou em quem).
			// E sem esperar a fala anterior terminar - numa contagem, um número atrasado é pior do que
			// um número interrompido.
			speak(sabotage_countdown_text(pkt));
			return;
		}
		announce(sabotage_countdown_text(pkt));
	}

	void on_sabotage_fixed(net_packet@ pkt) {
		announce(sabotage_fixed_text(), !pkt.announced);
		// Desligar o alarme e devolver o alcance de audição é de apply_sabotage_effects (ver acima).
	}

	void on_player_killed(net_packet@ pkt) {
		uint64 peer_id = pkt.get_uint64("peer_id");
		roster.mark_dead(peer_id);
		float x = pkt.get_float("x");
		float y = pkt.get_float("y");
		int killer_color = pkt.get_int("killer_color");

		// Os dois sons do assassinato têm ouvintes DIFERENTES, e antes tocavam os dois para todo mundo.
		//
		//   morte - a reação de quem morreu. É pessoal: só a vítima ouve. Solto para os arredores, ele
		//           entregava o assassinato de graça e ainda soava, para quem levou a facada, como se
		//           fosse outra pessoa morrendo.
		//   kill  - o que o assassino e quem estiver por perto ouvem. É o único sinal do crime para
		//           fora, e é espacial: dá a direção sem dizer quem foi.
		//
		// A morte usa a cor da VÍTIMA (é o som dela), e não a de quem matou.
		if (peer_id == client.my_peer_id) {
			roster_entry@ victim = roster.find(peer_id);
			audio.play_death(@victim != null ? victim.color : killer_color, x, y);
		} else {
			audio.play_kill_laugh(killer_color, x, y);
		}
		if (body_sounds_enabled) audio.start_body_beacon(peer_id, x, y);
	}

	void on_game_over(net_packet@ pkt) {
		bool crewmates_won = pkt.get_string("winner") == "crewmates";
		announce(tr(crewmates_won ? "game.crewmates_win" : "game.impostors_win"));
		// Antes tocava win/defeat baseado só em quem venceu, sem checar o papel de quem está ouvindo -
		// impostores ouviam "vitória" quando os tripulantes ganhavam, e vice-versa.
		// A música é a do TIME que venceu, para todo mundo - como no original. Tripulante ouvindo a
		// música dos impostores sabe exatamente o que aconteceu.
		audio.play_victory(crewmates_won);
	}

	// Menu de votação: lista jogadores vivos + opção de pular. ESC/fechar sem escolher NÃO vota
	// (nem pula): o menu só fecha e dá pra abrir de novo com a tecla de votar enquanto a votação
	// estiver aberta. Antes ESC mandava "pular" - quem fechasse o menu sem querer perdia o voto
	// daquela reunião inteira sem nem saber.
	// Roda o menu até o jogador escolher (ou fechar), e devolve false se a VOTAÇÃO acabou antes disso.
	//
	// É o `run()` do menu aberto à mão - ele é `while (monitor()) wait(5)` e não tem como sair por
	// outro motivo. Quem avisa é o `voting_ended` do cliente, marcado na chegada da apuração, porque
	// varrer a fila de pacotes a cada quadro é o que já travou o jogo uma vez.
	private bool run_until_choice(menu@ m) {
		while (m.monitor()) {
			if (client.voting_ended) return false;
			wait(5);
		}
		return true;
	}

	private void run_voting_menu() {
		ui_sound(SND_DIALOG_OPEN);
		menu vote_menu;
		vote_menu.intro_text = tr("game.meeting_voting");
		vote_menu.click_sound = "ui/menu_click.ogg";
		vote_menu.select_sound = ""; // os sons de marcar e confirmar são os do voto, tocados abaixo
		vote_menu.sounds_prefix = "sounds/";
		@g_vote_pump_client = client;
		@g_vote_pump_ui = this;
		@vote_menu.background_callback = @pump_client_during_vote_menu;

		array<roster_entry@>@ alive = roster.alive_entries();
		for (uint i = 0; i < alive.length(); i++) {
			vote_menu.add_item(alive[i].name, "" + alive[i].peer_id);
		}
		vote_menu.add_item(tr("game.vote_skip"), "skip");

		// Dois passos, como no original: Enter MARCA um nome (som de seleção, e o menu continua
		// aberto), Enter de novo no mesmo nome CONFIRMA. Com um Enter só, um dedo apressado votava em
		// quem estava em cima na lista - e voto não se desfaz.
		string marked = "";
		while (true) {
			// Não é `vote_menu.run()`: aquele laço só termina por tecla, e a votação pode acabar
			// (por tempo, ou porque todo mundo já votou) com este menu aberto.
			if (!run_until_choice(vote_menu)) {
				ui_sound(SND_DIALOG_CLOSE);
				// Nada é dito aqui de propósito: o laço da partida volta a rodar no instante seguinte
				// e anuncia a apuração inteira. Uma frase nossa seria cortada por ela, ou a cortaria.
				return;
			}
			string selected_id = vote_menu.selected_item_id;
			if (selected_id == "") {
				ui_sound(SND_DIALOG_CLOSE);
				speak(tr("game.vote_cancelled"));
				return;
			}
			if (selected_id != marked) {
				marked = selected_id;
				audio.play_vote_select();
				dictionary@ p = dictionary();
				p.set("name", selected_id == "skip" ? tr("game.vote_skip") : name_of(uint64(parse_int(selected_id))));
				vote_menu.intro_text = tr("game.vote_marked", p);
				vote_menu.automatic_intro = true; // senão a instrução nova não é dita ao reabrir
				continue; // reabre o menu, com o cursor onde estava
			}
			break;
		}
		ui_sound(SND_DIALOG_CLOSE);

		if (marked == "skip") client.send_cast_vote(-1);
		else client.send_cast_vote(parse_int(marked));

		has_voted = true; // não espera o S_VOTE_CAST voltar da rede pra já bloquear reabrir o menu
		audio.play_vote_confirm();
	}

	// Tique dos últimos segundos da votação. Chamado a cada quadro pelo laço da partida; toca uma
	// vez por segundo quando faltam 10 ou menos, só na fase de votação - é o "decida agora".
	private int last_tick_second = -1;
	void tick_vote_timer() {
		if (!voting_active) { last_tick_second = -1; return; }
		float left = phase_seconds_remaining();
		if (left < 0.0 || left > 10.0) return;
		int second = int(left);
		if (second == last_tick_second) return;
		last_tick_second = second;
		audio.play_vote_timer_tick();
	}
}
