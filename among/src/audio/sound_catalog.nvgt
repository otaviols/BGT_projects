const string SND_PULLING_GARBAGE_LEVER = "tasks/pulling_garbage_lever.ogg"; // toca 1x ao COMEÇAR a segurar Enter na task de lixo
const string SND_GUN_FIRE = "tasks/gun_fire.ogg"; // cada tiro na task de limpar asteroides
const string SND_DICE = "tasks/dice.ogg";                       // dado rolando na sala de jogos
const string SND_WATER_FLOW = "tasks/waterflow.ogg";            // loop: água correndo enquanto se rega uma muda
