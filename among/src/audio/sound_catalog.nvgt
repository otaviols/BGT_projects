// Goles de água: marcam cada etapa do canteiro enchendo. São variantes justamente pra não virar um
// bipe repetido - mesma ideia dos passos por piso.
const uint LIQUID_VARIANT_COUNT = 4;
string liquid_sound(int variant_1_based) {
	return "tasks/liquid" + variant_1_based + ".ogg";
}
const string SND_VIDEO_OPENING = "tasks/opening_video_image.ogg"; // abre a gravação na sala de segurança
const string SND_TAPE_REWIND = "tasks/rewinding_tape.mp3";      // rebobina a fita antes de tocar o trecho

// fix_wiring usa 3 variantes numeradas - ver electrical_string_sound() abaixo.
const uint ELECTRICAL_STRING_VARIANT_COUNT = 3;
string electrical_string_sound(int variant_1_based) {
	return "tasks/eletricalString" + variant_1_based + ".ogg";
}

// --- Morte / kill (ver config/colors.nvgt pra fallback por cor) ---
const string SND_KILL = "sounds/events/kill.ogg";                  // ouvido por quem tiver perto do assassinato
const uint KILLED_VARIANT_COUNT_FOR_CATALOG = 4;            // ver colors.KILLED_SOUND_VARIANT_COUNT

// --- Passos por piso ---------------------------------------------------------
// Quantidade de variantes disponíveis em sounds/ para cada prefixo de piso (Tile1.wav, Tile2.wav,
// ...). Serve para não pedir uma variante que não existe como arquivo.
//
// Moradia destas funções: aqui, e não no laço da partida, porque quem precisa delas não é só ele -
// o menu de aprender os sons monta a lista de passos a partir das mesmas contagens, e ter dois
// lugares dizendo quantos arquivos existem é garantia de que um dia um vai discordar do outro.
int footstep_variant_count(const string&in floor_prefix) {
	if (floor_prefix == "Tile") return 6;
	if (floor_prefix == "MetalTile") return 8;
	if (floor_prefix == "MetalBeltTile") return 6;
	if (floor_prefix == "WoodTile") return 7;
	if (floor_prefix == "EarthTile") return 7;
	if (floor_prefix == "VentTile") return 4;
	return 2;
}

// Pisos que o jogo conhece. Serve para o catálogo listar os arquivos de passo sem repetir a lista -
// era assim que a contagem daqui e a lista de baixo saíam de sincronia.
const array<string> FOOTSTEP_FLOOR_PREFIXES = {
	"Tile", "MetalTile", "MetalBeltTile", "WoodTile", "EarthTile",
	// VentTile é o piso de DENTRO do duto: nenhuma sala usa esse prefixo, ele toca só quando o
	// impostor viaja de um vent para outro (ver run_vent_menu em game/game_loop.nvgt).
	"VentTile"
};

// Extensão do arquivo de passo de cada piso. Hoje são todos .ogg, mas a função continua existindo
// porque isso já mudou três vezes - e quando muda, muda só aqui.
string footstep_variant_extension(const string&in floor_prefix) {
	return "ogg";
}

// Correção de volume por piso, em dB.
//
// Os arquivos de passo não vêm todos no mesmo nível, e a diferença é grande demais para passar por
// estilo: medindo o RMS médio das variantes de cada piso, o Tile está 15 dB abaixo do MetalTile e o
// WoodTile 10 dB. Num jogo em que o passo alheio é a principal pista de que alguém está perto, um
// piso 15 dB mais baixo é um piso onde ninguém é ouvido chegando - e a sala vira segura por acidente.
//
// Os números abaixo trazem cada piso para o nível do mais alto. Não achatam o caráter de cada um: o
// que distingue madeira de metal é o timbre, não o volume. Medido assim (guardado aqui porque a
// próxima pessoa que trocar um arquivo de passo vai precisar refazer a conta):
//
//   RMS médio das variantes  ->  Tile -46,4  MetalTile -31,3  MetalBeltTile -31,2  WoodTile -41,0
//                                EarthTile -44,5  VentTile -36,4  CarpetTile -43,3  GlassTile -51,4
//                                SnowTile -39,7   (dBFS)
//
// Nenhuma correção chega perto de estourar: o pico mais alto depois do ajuste fica em torno de -7 dB.
float footstep_volume_db(const string&in floor_prefix) {
	// O Tile NÃO leva correção: o arquivo dele é o antigo, de antes da troca de sons, e ele já nasce
	// no nível dos outros (corpo -30,9 dB, contra -29,7 do MetalTile). Os +15 dB que existiram aqui
	// eram muleta para o arquivo novo, que vinha 14 dB mais baixo - e o arquivo novo foi descartado
	// justamente porque nenhum ganho o deixava bom.
	// WoodTile foi de +10 para +13: a medida da parte sonora pedia +13,2 e os +10 ainda soavam
	// baixos ao lado dos outros pisos. Pico depois do ajuste: -10,5 dB, sem risco de estourar.
	if (floor_prefix == "WoodTile") return 13.0;
	if (floor_prefix == "EarthTile") return 13.0;
	if (floor_prefix == "VentTile") return 5.0;
	if (floor_prefix == "CarpetTile") return 12.0;
	if (floor_prefix == "GlassTile") return 20.0;
	if (floor_prefix == "SnowTile") return 8.5;
	return 0.0; // MetalTile e MetalBeltTile já são a referência
}

// Caminho de UMA variante de passo, contando a pasta. Todo lugar que toca passo passa por aqui.
//
// A pasta é o detalhe que já custou caro: os passos moram em sounds/steps/, e quem montava o caminho
// à mão esquecia dela. Som que não existe não dá erro nenhum no NVGT - simplesmente não toca. Foi
// assim que a task de rever a gravação ficou sem os passos que ela pede para CONTAR, silenciosamente,
// depois que os sons foram organizados em pastas.
string footstep_sound_path(const string&in floor_prefix, int variant_1_based) {
	return "sounds/steps/" + floor_prefix + variant_1_based + "." +
		footstep_variant_extension(floor_prefix);
}

// Lista "sounds/X1.ext,sounds/X2.ext,..." das variantes de um som numerado, separada por VÍRGULA.
//
// A vírgula não é enfeite: é o formato que learn_game_sounds_menu (menu.nvgt) entende para "escolha
// um destes ao acaso". Versões mais novas dessa função também aceitam a forma abreviada
// "X{1...6}.ext", mas versões mais antigas NÃO - elas passam esse texto direto para o carregador de
// som, que procura um arquivo com chaves no nome, não acha, e não toca nada. Falha silenciosa: sem
// erro, sem aviso, só o item mudo.
//
// Era exatamente esse o bug dos passos e da morte no menu de aprender os sons. A lista por vírgula
// funciona nas duas versões, então é ela que se usa aqui - o jogo não fica refém de qual NVGT
// compilou o build.
string sound_variants_list(const string&in prefix, int count, const string&in extension,
		const string&in folder) {
	string list = "";
	for (int i = 1; i <= count; i++) {
		if (i > 1) list += ",";
		list += "sounds/" + folder + "/" + prefix + i + "." + extension;
	}
	return list;
}

// Atalho para os passos, que são o caso mais comum: as contagens e a extensão saem das funções
// acima, então acrescentar um arquivo de passo novo é mudar um número num lugar só.
string footstep_variants_list(const string&in floor_prefix) {
	return sound_variants_list(floor_prefix, footstep_variant_count(floor_prefix),
		footstep_variant_extension(floor_prefix), "steps");
}

// Retorna TODO caminho de som que o jogo pode precisar tocar, já expandindo os construídos
// dinamicamente (passos por piso, variantes de fix_wiring, variantes de morte) - é isso que
// tools/check_sounds.nvgt varre pra dizer o que falta em sounds/.
array<string>@ all_sound_paths() {
	array<string> list;

	list.insert_last(SND_MENU_CLICK);
	list.insert_last(SND_MENU_CONFIRM);
	list.insert_last(SND_INTRO);
	list.insert_last(SND_PLAYER_ENTER);
	list.insert_last(SND_PLAYER_LEAVE);
	list.insert_last(SND_START_GAME);
	list.insert_last(SND_WIN);
	list.insert_last(SND_DEFEAT);
	list.insert_last(SND_MEETING_RESULT);
	list.insert_last(SND_EJECTED);
	list.insert_last(SND_MEETING_ALARM);
	list.insert_last(SND_VOTE_CONFIRM);
	list.insert_last(SND_BODY_REPORTED);
	list.insert_last(SND_MESSAGE_SENT);
	list.insert_last(SND_MESSAGE_RECEIVED);
	list.insert_last(SND_DIALOG_OPEN);
	list.insert_last(SND_DIALOG_CLOSE);
	list.insert_last(SND_SHIP_AMBIENCE);
	list.insert_last(SND_SABOTAGE_ALARM);
	list.insert_last(SND_PASSAGE);
	list.insert_last(SND_WALL_BUMP);
	list.insert_last(SND_DOOR_BUMP);
	list.insert_last(SND_BODY_ON_FLOOR);
	list.insert_last(SND_BUTTON_BEACON);
	list.insert_last(SND_PANEL_BEACON_LIGHTS);
	list.insert_last(SND_PANEL_BEACON_OXYGEN);
	list.insert_last(SND_VENT_BEACON);
	list.insert_last(SND_TASK_BEACON_FIX_WIRING);
	list.insert_last(SND_TASK_BEACON_DOWNLOAD_DATA);
	list.insert_last(SND_TASK_BEACON_EMPTY_GARBAGE);
	list.insert_last(SND_TASK_BEACON_ALIGN_ENGINE);
	list.insert_last(SND_TASK_BEACON_SWIPE_CARD);
	list.insert_last(SND_PANEL_BEACON_COMMS);
	list.insert_last(SND_TASK_BEACON_UNLOCK_MANIFOLDS);
	list.insert_last(SND_TASK_BEACON_FUEL_ENGINES);
	list.insert_last(SND_TASK_BEACON_CLEAR_ASTEROIDS);
	list.insert_last(SND_TASK_BEACON_ROLL_DICE);
	list.insert_last(SND_TASK_BEACON_WATER_PLANTS);
	list.insert_last(SND_TASK_BEACON_REVIEW_RECORDS);
	list.insert_last(SND_AMBIENT_GAMES);
	list.insert_last(SND_AMBIENT_GREENHOUSE);
	list.insert_last(SND_AMBIENT_SECURITY);
	list.insert_last("sounds/" + SND_DICE);
	list.insert_last("sounds/" + SND_WATER_FLOW);
	list.insert_last("sounds/" + SND_FILLING);
	list.insert_last("sounds/" + SND_FILLING_COMPLETE);
	list.insert_last("sounds/" + SND_VIDEO_OPENING);
	list.insert_last("sounds/" + SND_TAPE_REWIND);
	for (int i = 1; i <= int(LIQUID_VARIANT_COUNT); i++) list.insert_last("sounds/" + liquid_sound(i));
	list.insert_last(SND_AMBIENT_CAFETERIA);
	list.insert_last(SND_AMBIENT_WEAPONS);
	list.insert_last(SND_AMBIENT_NAVIGATION);
	list.insert_last(SND_AMBIENT_ADMIN);
	list.insert_last(SND_AMBIENT_MEDBAY);
	list.insert_last(SND_AMBIENT_STORAGE);
	list.insert_last(SND_AMBIENT_ELECTRICAL);
	list.insert_last(SND_AMBIENT_REACTOR);
	list.insert_last(SND_VENT_DOOR_1);
	list.insert_last(SND_VENT_DOOR_2);
	list.insert_last(SND_OPEN_PANEL);
	list.insert_last(SND_DOOR_CLOSE);
	list.insert_last(SND_DOOR_OPEN);
	list.insert_last(SND_RADAR_BEEP);
	list.insert_last(SND_CAMERA_BEACON);
	list.insert_last(SND_CAMERA_ON);
	list.insert_last(SND_CAMERA_OFF);
	list.insert_last(SND_CAMERA_SWITCH);
	list.insert_last(SND_CAMERA_WATCHING);
	list.insert_last("sounds/" + SND_BEEP);
	list.insert_last("sounds/" + SND_BEEP_COMPLETE);
	list.insert_last("sounds/" + SND_CARD_ERROR);
	list.insert_last("sounds/" + SND_CARD_COMPLETE);
	list.insert_last("sounds/" + SND_GET_CARD);
	list.insert_last("sounds/" + SND_PULLING_GARBAGE_LEVER);
	list.insert_last("sounds/" + SND_GUN_FIRE);
	list.insert_last(SND_KILL);

	for (int i = 1; i <= int(ELECTRICAL_STRING_VARIANT_COUNT); i++) {
		list.insert_last("sounds/" + electrical_string_sound(i));
	}
	for (uint i = 1; i <= KILLED_VARIANT_COUNT_FOR_CATALOG; i++) {
		list.insert_last("sounds/events/killed" + i + ".ogg");
	}

	// Passos por piso, montados pelas MESMAS funções que o jogo usa para tocar. Escritos à mão aqui,
	// eles discordavam da contagem lá em cima toda vez que alguém acrescentava um arquivo - e o
	// sintoma era o conferidor acusando som faltando ou sobrando sem que nada estivesse errado.
	for (uint f = 0; f < FOOTSTEP_FLOOR_PREFIXES.length(); f++) {
		string prefix = FOOTSTEP_FLOOR_PREFIXES[f];
		for (int i = 1; i <= footstep_variant_count(prefix); i++) {
			list.insert_last(footstep_sound_path(prefix, i));
		}
	}

	return list;
}

// Sons opcionais: têm fallback no código se não existirem (ver config/colors.nvgt), então não
// contam como "faltando" - só avisamos que dariam mais variedade se existissem.
array<string>@ optional_sound_paths() {
	array<string> list;
	array<int>@ ids = all_color_ids();
	for (uint i = 0; i < ids.length(); i++) {
		string key = color_key(ids[i]);
		list.insert_last("sounds/colors/" + key + "/death.ogg");
		list.insert_last("sounds/colors/" + key + "/kill.ogg");
	}
	return list;
}

// Todo arquivo de som existente em disco, incluindo os das subpastas.
//
// find_files() NÃO é recursivo: com os sons organizados em sounds/steps, sounds/ui e companhia, um
// find_files("sounds/*") devolve ZERO arquivos. Isso derrubou de uma vez o gerador do pacote e o
// conferidor de sons - e o modo como falhou é o perigoso: o conferidor passou a dizer que TODOS os
// sons sumiram, quando eles estavam ali do lado.
//
// Os caminhos voltam relativos à raiz do projeto ("sounds/ui/menuclick.ogg"), que é a mesma forma
// usada no catálogo e no jogo.
array<string>@ all_sound_files_on_disk(const string&in base = "sounds") {
	array<string> result;
	array<string>@ files = find_files(base + "/*");
	for (uint i = 0; i < files.length(); i++) result.insert_last(base + "/" + files[i]);

	array<string>@ dirs = find_directories(base + "/*");
	for (uint i = 0; i < dirs.length(); i++) {
		array<string>@ nested = all_sound_files_on_disk(base + "/" + dirs[i]);
		for (uint k = 0; k < nested.length(); k++) result.insert_last(nested[k]);
	}
	return result;
}
