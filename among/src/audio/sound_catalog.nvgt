// sound_catalog.nvgt
// Catálogo central de todo arquivo de som que o jogo usa. Objetivo: um lugar só pra saber quais
// sons existem, o que cada um faz, e (via tools/check_sounds.nvgt) quais ainda faltam em sounds/.
//
// Convenção: as constantes SND_* de cenário/UI já incluem o prefixo "sounds/" (é o que
// spatial_audio/play_ui_sound esperam). As de tasks (usadas com task_sound(), que já prefixa
// "sounds/" sozinho) ficam sem prefixo de propósito - task_common.nvgt cuida disso.

#include "../config/colors.nvgt"

// --- UI / menus (sem posição) ---
