// voice_chat.nvgt
// Chat de voz por proximidade: captura o microfone, comprime, manda ao servidor; recebe as vozes dos
// outros e toca cada uma no ponto onde a pessoa está. Quem decide QUEM ouve é o servidor (ver
// game_state.can_hear_voice); aqui só se toca o que chegou, posicionado.
//
// O codec é mu-law (G.711, o do telefone) a 16 kHz, feito em script: 128 kbps por pessoa falando.
// Não é Opus porque o decodificador do NVGT só abre fluxo COMPLETO - a sonda provou que um fluxo
// Opus que cresce ao vivo responde "Invalid file" sempre (ver CLAUDE.md). O mu-law não depende de
// nada, tem latência de um quadro e qualidade de telefone, que para voz de jogo basta. Trocar por
// Opus um dia é trocar encode()/decode() e mais nada: rede, regra e interface não mudam.
//
// Roda de dentro de game_client.update() (interface voice_receiver, em network/client.nvgt), e não
// do laço principal: é a única coisa que toda tela bombeia, então a voz continua nas tasks, na caixa
// de mensagem e nos formulários.

#include "../network/client.nvgt"
#include "../config/game_settings.nvgt"
#include "../config/keybindings.nvgt"
#include "../core/client_state.nvgt"
#include "sound_catalog.nvgt"
#include "menu.nvgt"
#include "../i18n.nvgt"

const uint VOICE_SAMPLE_RATE = 16000;
// Um quadro de envio: 20 ms a 48 kHz (a taxa do motor). Menor que isto é cabeçalho demais por
// pacote; maior é latência que se percebe na conversa.
const uint VOICE_CAPTURE_FRAMES = 960;
// Depois que a voz cai abaixo da sensibilidade, o microfone ainda fica aberto este tanto: sem
// isso cada pausa entre palavras cortava o fim da frase.
const int VOICE_AUTO_HANGOVER_MS = 400;
// Voz que ficou este tempo sem quadro novo é descartada, para o objeto de som não viver para sempre.
const int VOICE_STREAM_IDLE_MS = 2000;
// Folga acumulada antes de começar a tocar cada fala (ver voice_stream.queue), e a pausa a partir
// da qual a próxima chegada conta como fala nova e junta folga de novo.
const int VOICE_JITTER_MS = 120;
const int VOICE_TALK_GAP_MS = 350;

// --- mu-law (G.711) ---------------------------------------------------------------------------
uint8 ulaw_from_sample(float f) {
	const int BIAS = 0x84, CLIP = 32635;
	int s = int(f * 32767.0);
	int sign = s < 0 ? 0x80 : 0;
	if (s < 0) s = -s;
	if (s > CLIP) s = CLIP;
	s += BIAS;
	int exponent = 7;
	int mask = 0x4000;
	while (exponent > 0 && (s & mask) == 0) { exponent--; mask >>= 1; }
	int mantissa = (s >> (exponent + 3)) & 0x0F;
	return uint8(~(sign | (exponent << 4) | mantissa) & 0xFF);
}
float sample_from_ulaw(uint8 u) {
	int v = ~int(u) & 0xFF;
	int sign = v & 0x80, exponent = (v >> 4) & 0x07, mantissa = v & 0x0F;
	int s = ((mantissa << 3) + 0x84) << exponent;
	s -= 0x84;
	return float(sign != 0 ? -s : s) / 32767.0;
}
// 48 kHz mono -> 16 kHz mu-law (média de cada três amostras: filtro simples, suficiente para voz).
string voice_encode(array<float>@ mono48) {
	string saida;
	for (uint i = 0; i + 2 < mono48.length(); i += 3) {
		saida += ascii_to_character(ulaw_from_sample((mono48[i] + mono48[i + 1] + mono48[i + 2]) / 3.0));
	}
	return saida;
}
array<float>@ voice_decode(const string&in bytes) {
	array<float> pcm(bytes.length());
	for (uint i = 0; i < bytes.length(); i++) pcm[i] = sample_from_ulaw(character_to_ascii(bytes.substr(i, 1)));
	return pcm;
}

// O microfone pode entregar estéreo, e som estéreo NÃO espacializa (sai centralizado, sem erro).
array<float>@ voice_to_mono(array<float>@ frames, uint channels) {
	if (channels <= 1) return frames;
	array<float> mono;
	mono.reserve(frames.length() / channels);
	for (uint i = 0; i + channels - 1 < frames.length(); i += channels) {
		float soma = 0;
		for (uint c = 0; c < channels; c++) soma += frames[i + c];
		mono.insert_last(soma / float(channels));
	}
	return mono;
}

// Nível de um quadro em dB (0 = fundo de escala). É o que a sensibilidade compara.
float voice_level_db(array<float>@ mono) {
	if (mono.length() == 0) return -100.0;
	float soma = 0;
	for (uint i = 0; i < mono.length(); i++) soma += mono[i] * mono[i];
	float rms = sqrt(soma / float(mono.length()));
	if (rms <= 0.00001) return -100.0;
	return 20.0 * log10(rms);
}
// Sensibilidade (0 a 100) -> limiar em dB. 100 abre com um sopro (-60 dB), 0 só com grito (-10 dB).
float voice_threshold_db(int sensitivity) {
	return -10.0 - float(sensitivity) * 0.5;
}

// A voz de UMA pessoa: um som contínuo alimentado quadro a quadro.
class voice_stream {
	uint64 peer_id;
	sound snd;
	timer last_frame;
	// Reserva contra o tremor da rede: os pacotes chegam a cada 20 ms na média, mas não a cada 20
	// ms de fato. Tocar cada um assim que chega deixava o som a zero de folga - qualquer pacote 30
	// ms atrasado era um buraco, e a voz saía picotada. Cada fala começa só depois de juntar
	// VOICE_JITTER_MS; daí em diante o que chega vai direto, e a folga se mantém.
	array<float> queue;
	bool playing = false;
	// Quanto já foi entregue ao motor desde que esta fala começou a tocar, e há quanto tempo. A
	// diferença entre os dois é a folga que resta - o motor não diz isso, e é a única forma de
	// perceber que a fila secou (ver on_voice_frame).
	uint64 written = 0;
	timer since_start;
}

class voice_chat : voice_receiver {
	game_client@ client;
	microphone@ mic = null;
	uint mic_channels = 1;
	int mic_device = -2; // com qual índice o microfone foi aberto (-2 = nenhum aberto)
	// A sala permite voz e há partida/sala para falar. Sem isto nada é capturado: microfone aberto
	// à toa é banda e privacidade jogadas fora.
	bool allowed = false;
	// O jogador está numa caixa de texto (chat, formulário da sala). A tecla de falar é uma letra,
	// e digitar essa letra abria o microfone no meio da mensagem. Enquanto isto for true, a tecla
	// não fala; o modo automático continua valendo.
	bool typing = false;
	bool transmitting = false;
	uint frames_sent = 0; // só para as sondas de tools/voice medirem a captura
	timer hangover;
	array<float> pending; // captura acumulada até dar um quadro de envio
	// Para posicionar as vozes: o elenco (com a posição de todos, inclusive a minha) e quem sou eu.
	// Sem elenco (sala de espera, reunião) as vozes tocam sem posição.
	client_roster@ roster = null;
	uint64 my_peer_id = 0;
	bool spatial = false;
	array<voice_stream@> streams;
	// Auto-escuta (tela de configurações): o que passa pelo microfone volta para o alto-falante.
	bool monitoring = false;
	sound monitor_snd;
	// Nome de cada peer que pode falar comigo (sala de espera e partida), para silenciar por nome.
	dictionary peer_names;

	void remember_name(uint64 peer, const string&in name) { if (name != "") peer_names.set("" + peer, name); }
	void forget_names() { peer_names.delete_all(); }
	string name_of(uint64 peer) const {
		string name;
		if (peer_names.exists("" + peer)) peer_names.get("" + peer, name);
		return name;
	}

	void attach(game_client@ c) {
		@client = c;
		@c.voice = this;
	}

	// Entrando numa partida: as vozes passam a ser posicionadas pelo elenco.
	void begin_match(client_roster@ r, uint64 me, bool room_allows) {
		@roster = r;
		my_peer_id = me;
		forget_names();
		for (uint i = 0; i < r.entries.length(); i++) remember_name(r.entries[i].peer_id, r.entries[i].name);
		spatial = true;
		allowed = room_allows;
		stop_all();
	}
	// Sala de espera (ou fim da partida): todo mundo se ouve, sem posição.
	void begin_lobby(bool room_allows) {
		@roster = null;
		spatial = false;
		allowed = room_allows;
		stop_all();
	}
	// Saiu de tudo: nada é capturado nem tocado.
	void leave() {
		@roster = null;
		forget_names();
		spatial = false;
		allowed = false;
		stop_all();
		close_mic();
	}

	// Avisa o servidor se quero receber voz. Chamado ao entrar numa sala e quando a configuração muda.
	void announce(bool connected_client) {
		if (@client == null || !connected_client) return;
		client.send_voice_state(g_settings.voice_chat_enabled);
	}

	void stop_all() {
		for (uint i = 0; i < streams.length(); i++) streams[i].snd.stop();
		streams.resize(0);
		if (transmitting) set_transmitting(false, false);
		pending.resize(0);
	}

	// --- Captura -------------------------------------------------------------------------------

	private bool open_mic() {
		int device = g_settings.input_device_index();
		if (@mic != null && mic_device == device) return true;
		close_mic();
		try {
			@mic = microphone(device);
			mic_channels = mic.get_output_channels(0);
			if (mic_channels == 0) mic_channels = 1;
			mic_device = device;
			return true;
		} catch {
			@mic = null;
			return false;
		}
	}
	private void close_mic() {
		@mic = null;
		mic_device = -2;
		mic_channels = 1;
	}

	private void set_transmitting(bool on, bool with_sound) {
		if (transmitting == on) return;
		transmitting = on;
		// Só no modo tecla: no automático o microfone abre e fecha a cada frase, e um clique por
		// frase seria um metrônomo por cima da conversa.
		if (with_sound && g_settings.voice_mode == VOICE_MODE_KEY) ui_sound(SND_MENU_CLICK);
	}

	// Chamado por game_client.update(). Lê o microfone, decide se a voz deve sair, e manda.
	void tick() {
		bool capture = (allowed && g_settings.voice_chat_enabled && @client != null && client.connected) || monitoring;
		if (!capture) {
			if (transmitting) set_transmitting(false, false);
			if (@mic != null) close_mic();
			expire_streams();
			return;
		}
		if (!open_mic()) { expire_streams(); return; }

		// read(0) = "tudo que há". read(n) devolve SEMPRE n quadros, mesmo sem ter n novos - medido:
		// 176 chamadas/s x 960 = 169 mil quadros/s de um microfone de 48 mil. Era a "qualidade
		// terrível" da primeira versão: 3,5x mais dados que fala, e a voz saía picada.
		array<float>@ frames = mic.read(0);
		if (@frames != null && frames.length() > 0) {
			array<float>@ mono = voice_to_mono(frames, mic_channels);
			for (uint i = 0; i < mono.length(); i++) pending.insert_last(mono[i]);
		}
		// Um pacote por 20 ms, SEMPRE - mesmo quando uma tela bloqueante (um wait(300) numa task)
		// deixou acumular meio segundo: mandar tudo num pacote só passava do limite que o servidor
		// aceita, ele descartava, e a voz sumia por um trecho.
		while (pending.length() >= VOICE_CAPTURE_FRAMES) {
			array<float> frame;
			frame.resize(VOICE_CAPTURE_FRAMES);
			for (uint i = 0; i < VOICE_CAPTURE_FRAMES; i++) frame[i] = pending[i];
			pending.remove_range(0, VOICE_CAPTURE_FRAMES);
			bool open;
			if (g_settings.voice_mode == VOICE_MODE_AUTO) {
				if (voice_level_db(frame) >= voice_threshold_db(g_settings.voice_sensitivity)) hangover.restart();
				open = hangover.elapsed <= VOICE_AUTO_HANGOVER_MS;
			} else {
				// Com Ctrl, a tecla de falar abre a lista de silenciar - não é fala.
				open = !typing && action_down(ACTION_TALK) && !key_down(KEY_LCTRL) && !key_down(KEY_RCTRL);
			}
			set_transmitting(open, true);
			if (open) {
				string bytes = voice_encode(frame);
				frames_sent++;
				if (monitoring) play_monitor(bytes);
				else client.send_voice(bytes);
			}
		}
		expire_streams();
	}

	// --- Recepção ------------------------------------------------------------------------------

	private voice_stream@ stream_for(uint64 peer) {
		for (uint i = 0; i < streams.length(); i++) if (streams[i].peer_id == peer) return streams[i];
		voice_stream@ s = voice_stream();
		s.peer_id = peer;
		streams.insert_last(s);
		return s;
	}

	private void expire_streams() {
		for (uint i = 0; i < streams.length(); i++) {
			if (streams[i].last_frame.elapsed <= VOICE_STREAM_IDLE_MS) continue;
			streams[i].snd.stop();
			streams.remove_at(i);
			i--;
		}
	}

	void on_voice_frame(const string&in wire) {
		if (!g_settings.voice_chat_enabled) return;
		uint64 talker;
		string audio;
		if (!voice_unwire(wire, talker, audio)) return;
		if (g_settings.is_muted(name_of(talker))) return;
		voice_stream@ s = stream_for(talker);
		if (s.last_frame.elapsed > VOICE_TALK_GAP_MS) s.playing = false; // pausa: a próxima é fala nova
		// A fila secou (a rede atrasou mais que a folga, ou o relógio de quem fala anda um pouco
		// mais devagar que o meu alto-falante): daqui em diante cada pacote tocaria com folga zero
		// e a voz tremeria sem parar. Melhor um buraco de 120 ms UMA vez e a folga refeita.
		if (s.playing && s.written < uint64(s.since_start.elapsed) * VOICE_SAMPLE_RATE / 1000) s.playing = false;
		s.last_frame.restart();
		array<float>@ pcm = voice_decode(audio);
		if (s.playing) {
			s.snd.stream_pcm(pcm, VOICE_SAMPLE_RATE, 1);
			s.written += pcm.length();
		} else {
			for (uint i = 0; i < pcm.length(); i++) s.queue.insert_last(pcm[i]);
			if (s.queue.length() < VOICE_SAMPLE_RATE * VOICE_JITTER_MS / 1000) return;
			// Buffer de 2 s explícito: o automático é 2x o primeiro pedaço, e a folga não pode
			// depender do tamanho do que chegou primeiro.
			s.snd.stream_pcm(s.queue, VOICE_SAMPLE_RATE, 1, VOICE_SAMPLE_RATE * 2);
			s.written = s.queue.length();
			s.since_start.restart();
			s.queue.resize(0);
			s.playing = true;
		}
		place(s);
	}

	// Posição e volume de uma voz. Reaplicado a CADA quadro, e depois do stream_pcm: o que se
	// configura antes do primeiro stream_pcm se perde (o som sai centralizado, sem erro) - foi a
	// lição da sonda. E as pessoas andam enquanto falam.
	private void place(voice_stream@ s) {
		s.snd.volume = g_settings.volume_db(SOUND_FAMILY_VOICES);
		roster_entry@ me = @roster != null ? roster.find(my_peer_id) : null;
		roster_entry@ who = @roster != null ? roster.find(s.peer_id) : null;
		if (!spatial || @me == null || @who == null) {
			s.snd.spatialization_enabled = false;
			return;
		}
		// Mesma convenção do sound_pool (ver spatial_audio.nvgt): ouvinte na origem, e o y do mundo
		// cresce para o sul, então inverte.
		s.snd.positioning = AUDIO_POSITIONING_ABSOLUTE;
		s.snd.spatialization_enabled = true;
		s.snd.rolloff = 1.0;
		s.snd.directional_attenuation_factor = 1.0;
		s.snd.set_position_3d(who.x - me.x, -(who.y - me.y), 0);
	}

	// --- Silenciar -----------------------------------------------------------------------------
	// Lista de quem está comigo; Enter alterna silenciado/ouvindo e a lista continua aberta, para
	// silenciar mais de um de uma vez. Ctrl + tecla de falar abre isto (ver game_loop e a sala de
	// espera). A rede continua sendo bombeada pelo callback do menu, senão a conexão cairia.
	void run_mute_menu() {
		while (true) {
			menu m;
			m.intro_text = tr("voice.mute_hint");
			m.click_sound = "ui/menuclick.ogg";
			m.select_sound = "ui/menuconfirm.ogg";
			m.sounds_prefix = "sounds/";
			@g_voice_pump_client = client;
			@m.background_callback = @pump_client_during_voice_menu;
			array<string>@ keys = peer_names.get_keys();
			uint listed = 0;
			for (uint i = 0; i < keys.length(); i++) {
				if (keys[i] == "" + my_peer_id) continue;
				string name; peer_names.get(keys[i], name);
				string label = name;
				if (g_settings.is_muted(name)) label = tr("voice.muted_item", name_params(name));
				m.add_item(label, name);
				listed++;
			}
			if (listed == 0) { speak(tr("voice.mute_nobody")); return; }
			m.add_item(tr("menu.back"), "back");
			m.run();
			string chosen = m.selected_item_id;
			if (chosen == "" || chosen == "back") return;
			bool now_muted = g_settings.toggle_muted(chosen);
			g_settings.save();
			speak(tr(now_muted ? "voice.now_muted" : "voice.now_unmuted", name_params(chosen)));
			wait(600); // deixa a confirmação ser ouvida antes de o menu reler o primeiro item
		}
	}

	// --- Auto-escuta (configurações) ---------------------------------------------------------------
	// O que sairia para os outros volta para o próprio alto-falante, sem posição: é como se ouve o
	// próprio microfone, a sensibilidade escolhida e o dispositivo certo antes de entrar numa partida.
	void start_monitor() { monitoring = true; hangover.restart(); }
	void stop_monitor() {
		monitoring = false;
		monitor_snd.stop();
		if (!allowed) close_mic();
		if (transmitting) set_transmitting(false, false);
	}
	private void play_monitor(const string&in bytes) {
		monitor_snd.stream_pcm(voice_decode(bytes), VOICE_SAMPLE_RATE, 1);
		monitor_snd.spatialization_enabled = false;
		monitor_snd.volume = g_settings.volume_db(SOUND_FAMILY_VOICES);
	}
}

dictionary@ name_params(const string&in name) { dictionary@ d = dictionary(); d.set("name", name); return d; }

game_client@ g_voice_pump_client;
void pump_client_during_voice_menu(menu@ m, string data) {
	if (@g_voice_pump_client != null) g_voice_pump_client.update();
}

voice_chat g_voice;
