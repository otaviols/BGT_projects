// menu_music.nvgt
// O tema do jogo nos menus: começa na abertura, repete sem parar e segue pelas telas de fora da
// partida (menu inicial, lista de partidas, sala de espera). Para onde o som é o jogo: a partida,
// assistir, o treino, o Conhecer o mapa e o menu de aprender os sons.
//
// Pedido do recado #277 (2026-10-15): o tema tocava UMA vez e só ao abrir a lista de partidas - e
// recomeçava do zero a cada volta a ela. Um som só, global, e não um por tela: cada tela com o seu
// era o que fazia o tema reiniciar a cada passagem (o audio_manager da lista morria com ela).

#include "sound_catalog.nvgt"
#include "../config/game_settings.nvgt"

sound@ g_menu_music = null;

// Liga o tema, se ainda não estiver tocando. Pode ser chamada de toda tela de menu: tocando, não faz
// nada, e é isso que deixa o tema seguir de uma tela para a outra sem recomeçar.
void menu_music_play() {
	if (@g_menu_music != null && g_menu_music.playing) {
		menu_music_refresh_volume();
		return;
	}
	sound s;
	if (!s.load(SND_INTRO)) return;
	s.volume = g_settings.volume_db(SOUND_FAMILY_MUSIC);
	s.play_looped();
	@g_menu_music = s;
}

void menu_music_stop() {
	if (@g_menu_music == null) return;
	g_menu_music.stop();
	@g_menu_music = null;
}

bool menu_music_playing() {
	return @g_menu_music != null && g_menu_music.playing;
}

// O volume da música mudou nas configurações: vale na hora, no tema que já está tocando.
void menu_music_refresh_volume() {
	if (@g_menu_music != null) g_menu_music.volume = g_settings.volume_db(SOUND_FAMILY_MUSIC);
}
