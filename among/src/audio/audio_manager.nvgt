// audio_manager.nvgt
// Sons específicos do jogo (passos, objetos do mapa, mortes, UI, sabotagem) construídos sobre
// spatial_audio.nvgt. Ponto único que o resto do jogo chama para tocar qualquer efeito sonoro.
// Os nomes de arquivo em si vêm todos de sound_catalog.nvgt - não escreva "sounds/..." aqui, adicione
// a constante lá.

#include "spatial_audio.nvgt"
#include "sound_catalog.nvgt"
#include "../config/game_constants.nvgt"
#include "../config/game_settings.nvgt"
#include "../config/colors.nvgt"
#include "../game/map.nvgt"

// Redução de volume (em dB, negativo = mais baixo) só pro "ambiente de fundo" (nave, sala,
// corredor) - beacons/alarmes ficam no volume normal porque carregam informação de jogo.
// Isto é a mixagem do JOGO; por cima dela vem ainda o volume que o JOGADOR escolheu pra família
// (ver config/game_settings.nvgt), e os dois se somam porque decibel soma.
const float AMBIENCE_VOLUME_DB = -10.0;

// Volume escolhido pelo jogador pra uma família, em dB. Todo som daqui passa por aqui - é o único
// ponto do jogo que decide a que família cada som pertence.
float family_db(int family) {
	return g_settings.volume_db(family);
}

// Uma tarefa visível de outro jogador tocando: o laço do scanner (slot) ou a hora do próximo disparo da
// arma (next_shot, em ticks(); 0 = não é arma). Ver start_visible_task.
class visible_task_sound {
	uint64 peer = 0;
	float x = 0, y = 0;
	int slot = -1;
	uint64 next_shot = 0;
}

class audio_manager {
	spatial_audio@ spatial;
	// Um beacon por corpo. Antes era um slot só: com dois corpos no chão, o mais novo calava o som
	// do anterior e aquele corpo virava mudo pro resto da partida.
	array<uint64> body_beacon_peers;
	array<int> body_beacon_slots;
	int ambient_sabotage_slot = -1;
	int ambient_ship_slot = -1;
	array<int> decoration_ambient_slots;
	array<int> landmark_beacon_slots;
	uint footstep_variant_seed = 0;

	audio_manager() {
		@spatial = spatial_audio();
	}

	void update_listener(float x, float y) {
		spatial.update_listener(x, y);
	}

	// --- Passos ---
	// Alterna entre as variantes numeradas do prefixo de piso (ex.: Tile1.wav, Tile2.wav). A pasta e
	// a extensão saem de footstep_sound_path(), que é o único lugar que monta caminho de passo.
	void play_footstep(const string&in floor_prefix, int variant_count, float x, float y) {
		if (variant_count <= 0) return;
		footstep_variant_seed = (footstep_variant_seed + 1) % uint(variant_count);
		spatial.play_once(footstep_sound_path(floor_prefix, int(footstep_variant_seed) + 1), x, y,
			family_db(SOUND_FAMILY_STEPS) + footstep_volume_db(floor_prefix));
	}

	// Toca quando o jogador tenta andar pra fora de qualquer sala/corredor (ver game_map.is_walkable).
	void play_wall_bump(float x, float y) {
		spatial.play_once(SND_WALL_BUMP, x, y, family_db(SOUND_FAMILY_STEPS));
	}

	// Esbarrão numa porta trancada. Som próprio (não o de parede) porque as duas coisas pedem reações
	// diferentes: parede é caminho errado, porta é só esperar ela abrir.
	void play_door_bump(float x, float y) {
		spatial.play_once(SND_DOOR_BUMP, x, y, family_db(SOUND_FAMILY_STEPS));
	}

	// --- Objetos do mapa ---
	void play_object_interact(map_object@ obj) {
		if (@obj == null || obj.sound_path == "") return;
		spatial.play_once(obj.sound_path, obj.x, obj.y, family_db(SOUND_FAMILY_TASKS));
	}

	// Porta fechando/abrindo, no lugar do corredor afetado.
	void play_door(float x, float y, bool closing) {
		spatial.play_once(closing ? SND_DOOR_CLOSE : SND_DOOR_OPEN, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	// Alguém contaminado tossiu (a contaminação). Ouvido de perto, como um passo.
	void play_cough(float x, float y) {
		spatial.play_once(SND_COUGH, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	void play_cough_self() { spatial.play_ui(SND_COUGH, false, family_db(SOUND_FAMILY_EVENTS)); }

	// A câmara de descontaminação: a porta dela fechando seguida do spray, ou a porta abrindo.
	void play_decontamination(float x, float y, bool closing) {
		if (!closing) {
			spatial.play_once(SND_DECONTAMINATION_OPEN, x, y, family_db(SOUND_FAMILY_EVENTS));
			return;
		}
		spatial.play_once(SND_DECONTAMINATION_CLOSE, x, y, family_db(SOUND_FAMILY_EVENTS));
		spatial.play_once(SND_DECONTAMINATION_SPRAY, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	int play_object_ambient(map_object@ obj) {
		if (@obj == null || obj.sound_path == "") return -1;
		return spatial.play_looping(obj.sound_path, obj.x, obj.y, true, family_db(SOUND_FAMILY_AMBIENCE));
	}

	// --- Cores / mortes ---
	// O aviso de alinhado com uma saída, no lado dela (ver game/exit_alignment.nvgt). Família dos
	// marcadores: é orientação, como os marcadores das tarefas.
	void play_exit_aligned(float x, float y) {
		spatial.play_once(SND_EXIT_ALIGNED, x, y, family_db(SOUND_FAMILY_BEACONS));
	}

	void play_death(int color_id, float x, float y) {
		spatial.play_once(color_death_sound_path(color_id), x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	void play_kill_laugh(int color_id, float x, float y) {
		spatial.play_once(color_kill_sound_path(color_id), x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	// --- Corpos no chão ---
	void start_body_beacon(uint64 victim_peer, float x, float y) {
		stop_body_beacon(victim_peer); // mesmo corpo duas vezes não empilha som
		int slot = spatial.play_looping(SND_BODY_ON_FLOOR, x, y, false, family_db(SOUND_FAMILY_BEACONS));
		if (slot == -1) return;
		body_beacon_peers.insert_last(victim_peer);
		body_beacon_slots.insert_last(slot);
	}

	void stop_body_beacon(uint64 victim_peer) {
		int index = body_beacon_peers.find(victim_peer);
		if (index == -1) return;
		spatial.stop_sound(body_beacon_slots[index]);
		body_beacon_peers.remove_at(index);
		body_beacon_slots.remove_at(index);
	}

	void stop_all_body_beacons() {
		for (uint i = 0; i < body_beacon_slots.length(); i++) spatial.stop_sound(body_beacon_slots[i]);
		body_beacon_peers.resize(0);
		body_beacon_slots.resize(0);
	}

	// Toca uma vez pra nave inteira quando um corpo é reportado (chamada de reunião por corpo).
	void play_body_reported_sound() { spatial.play_ui(SND_BODY_REPORTED, false, family_db(SOUND_FAMILY_EVENTS)); }

	// --- Chat ---
	void play_message_sent() { spatial.play_ui(SND_MESSAGE_SENT, false, family_db(SOUND_FAMILY_UI)); }
	void play_message_received() { spatial.play_ui(SND_MESSAGE_RECEIVED, false, family_db(SOUND_FAMILY_UI)); }

	// --- Ambiente da nave (toca durante toda a partida) ---
	// O som de fundo do MAPA inteiro (game_map.ship_ambience); vazio = o mapa não tem um.
	void start_ship_ambience(const string&in path = SND_SHIP_AMBIENCE) {
		stop_ship_ambience();
		if (path == "") return;
		ambient_ship_slot = spatial.play_ui(path, true, AMBIENCE_VOLUME_DB + family_db(SOUND_FAMILY_AMBIENCE));
	}

	void stop_ship_ambience() {
		if (ambient_ship_slot != -1) {
			spatial.stop_sound(ambient_ship_slot);
			ambient_ship_slot = -1;
		}
	}

	// --- Ambiente por sala (objetos OBJ_DECORATION do mapa) ---
	// Usa o tamanho real da sala (map_zone.half_w/half_h) como área de volume constante, senão o som
	// só ficava audível perto do centro dela (como qualquer outro som posicionado normal).
	void start_room_ambience(game_map@ map) {
		stop_room_ambience();
		array<map_object@>@ decorations = map.objects_by_type(OBJ_DECORATION);
		for (uint i = 0; i < decorations.length(); i++) {
			map_object@ obj = decorations[i];
			map_zone@ zone = map.find_zone(obj.room_id);
			int half_w = @zone != null ? int(zone.half_w) : 8; // fallback caso a sala não seja encontrada
			int half_h = @zone != null ? int(zone.half_h) : 8;
			int slot = spatial.play_room_ambience(obj.sound_path, obj.x, obj.y, half_w, half_h,
				AMBIENCE_VOLUME_DB + ambience_correction_db(obj.sound_path) + family_db(SOUND_FAMILY_AMBIENCE));
			if (slot != -1) decoration_ambient_slots.insert_last(slot);
		}
	}

	void stop_room_ambience() {
		for (uint i = 0; i < decoration_ambient_slots.length(); i++) spatial.stop_sound(decoration_ambient_slots[i]);
		decoration_ambient_slots.resize(0);
	}

	// --- Marcos do mapa (botão de emergência, vents, painéis de sabotagem, tasks) ---
	// Beacon posicionado (não de área) que fica mais alto quanto mais perto - diferente do ambiente
	// de sala, aqui o objetivo é justamente conseguir "seguir o som" até achar o objeto. Qualquer
	// objeto do mapa com beacon_sound_path preenchido entra automaticamente (ver map.nvgt), EXCETO
	// tasks: essas só tocam se o object_id estiver em my_task_object_ids - senão todo mundo ouviria
	// beacon de toda task do mapa o jogo inteiro (ruído inútil pro impostor, spoiler pro tripulante) -
	// e EXCETO painéis de reparo, que só apitam enquanto a sabotagem deles está acontecendo (é aí que
	// seguir o som até o painel serve pra alguma coisa; fora disso é só barulho constante).
	// A regra de QUAL objeto tem marcador tocando mora em landmark_beacon_on (game/map.nvgt): a tela para
	// quem enxerga desenha exatamente os mesmos marcadores, e duas regras divergiriam.
	void start_landmark_beacons(game_map@ map, array<string>@ my_task_object_ids = null, const string&in active_sabotage_id = "") {
		stop_landmark_beacons();
		for (uint i = 0; i < map.objects.length(); i++) {
			map_object@ obj = map.objects[i];
			if (!landmark_beacon_on(obj, my_task_object_ids, active_sabotage_id)) continue;
			int slot = spatial.play_looping(obj.beacon_sound_path, obj.x, obj.y, true, family_db(SOUND_FAMILY_BEACONS));
			if (slot != -1) landmark_beacon_slots.insert_last(slot);
		}
	}

	void stop_landmark_beacons() {
		for (uint i = 0; i < landmark_beacon_slots.length(); i++) spatial.stop_sound(landmark_beacon_slots[i]);
		landmark_beacon_slots.resize(0);
	}

	// --- Sabotagem ---
	// Alarme ouvido pela nave inteira (sem posição) - antes tocava só perto de um ponto fixo do
	// mapa, o que por coincidência caía perto do centro da cafeteria e só era audível ali.
	void start_sabotage_alarm() {
		stop_sabotage_alarm();
		// Família própria (ver SOUND_FAMILY_ALARM): é o único som do jogo que não para, e abaixá-lo não
		// pode custar o som da morte nem o do corpo encontrado.
		ambient_sabotage_slot = spatial.play_ui(SND_SABOTAGE_ALARM, true, family_db(SOUND_FAMILY_ALARM));
	}

	void stop_sabotage_alarm() {
		if (ambient_sabotage_slot != -1) {
			spatial.stop_sound(ambient_sabotage_slot);
			ambient_sabotage_slot = -1;
		}
	}

	// A partida acabou SEM o fim normal (a conexão caiu, ou o jogador saiu pelo Esc): cala tudo o que
	// ela deixou tocando em laço. Antes cada saída desligava a ambiência e os marcadores e esquecia o resto
	// - o alarme de sabotagem, o zumbido da sala sob câmera, o scanner, os corpos -, e quem caía ficava
	// ouvindo o alarme enquanto o jogo tentava voltar à partida (relato do usuário, 2026-10-14). Um "pare
	// tudo" no fim, em vez de mais uma linha por som: o próximo som em laço não precisa ser lembrado aqui.
	void stop_all() {
		stop_sabotage_alarm();
		stop_camera_watching();
		stop_visible_task();
		stop_all_body_beacons();
		stop_landmark_beacons();
		stop_room_ambience();
		stop_ship_ambience();
		spatial.stop_all();
	}

	// Toca uma vez pra nave inteira quando alguém aperta o botão de emergência (reunião chamada).
	void play_meeting_alarm() { spatial.play_ui(SND_MEETING_ALARM, false, family_db(SOUND_FAMILY_EVENTS)); }

	// Sabotagem de luzes reduz o alcance de audição ambiente (decisão de design).
	// Zumbido da sala sob observação. Um só de cada vez: só existe um posto de câmeras, então só
	// pode haver uma sala observada.
	// Segue o padrão dos outros beacons: play_looping devolve um "slot" que é o que se guarda para
	// poder parar depois. -1 significa que o som não pôde ser carregado (o arquivo ainda não existe,
	// por exemplo) - e aí não há nada a parar.
	private int camera_watching_slot = -1;

	void start_camera_watching(float x, float y) {
		stop_camera_watching();
		camera_watching_slot = spatial.play_looping(SND_CAMERA_WATCHING, x, y, false,
			family_db(SOUND_FAMILY_BEACONS) + CAMERA_WATCHING_VOLUME_DB);
	}

	void stop_camera_watching() {
		if (camera_watching_slot == -1) return;
		spatial.stop_sound(camera_watching_slot);
		camera_watching_slot = -1;
	}

	// --- Tarefas visíveis de outros jogadores (o exame médico, a arma dos asteroides) ---
	// Posicionadas no ponto da tarefa enquanto durarem: quem chegar no meio ouve. É a família dos
	// eventos, não dos marcadores - é informação de partida, não orientação. Uma por jogador.
	//
	// O scanner é um som em laço. A arma são DISPAROS soltos, em intervalos irregulares como os da própria
	// tarefa (tick_visible_tasks, a cada quadro): um tiro em laço viraria metralhadora, e o que se quer
	// ouvir é "alguém está atirando ali". Os tiros são do cliente de quem ouve, e não um a um pela rede: o
	// que é prova é o servidor ter anunciado a tarefa (ver try_start_visible_task), e não o ritmo dela.
	private array<visible_task_sound@> visible_tasks;
	void start_visible_task(uint64 peer, const string&in task_type, float x, float y) {
		stop_visible_task(peer);
		visible_task_sound v;
		v.peer = peer;
		v.x = x;
		v.y = y;
		if (task_type == "clear_asteroids") v.next_shot = ticks() + uint64(random(300, 900));
		else v.slot = spatial.play_looping("sounds/" + SND_MEDBAY_SCAN, x, y, false, family_db(SOUND_FAMILY_EVENTS));
		visible_tasks.insert_last(v);
	}
	// De um jogador, ou de todos com peer 0.
	void stop_visible_task(uint64 peer = 0) {
		for (int i = int(visible_tasks.length()) - 1; i >= 0; i--) {
			if (peer != 0 && visible_tasks[i].peer != peer) continue;
			if (visible_tasks[i].slot != -1) spatial.stop_sound(visible_tasks[i].slot);
			visible_tasks.remove_at(i);
		}
	}
	void tick_visible_tasks() {
		uint64 agora = ticks();
		for (uint i = 0; i < visible_tasks.length(); i++) {
			visible_task_sound@ v = visible_tasks[i];
			if (v.next_shot == 0 || agora < v.next_shot) continue;
			spatial.play_once("sounds/" + SND_ASTEROID_FIRE, v.x, v.y, family_db(SOUND_FAMILY_EVENTS));
			v.next_shot = agora + uint64(random(700, 1900));
		}
	}

	void apply_lights_out(bool active, int normal_max_distance) {
		if (active) spatial.set_max_distance(int(normal_max_distance * LIGHTS_OUT_AUDIO_RANGE_MULTIPLIER));
		else spatial.set_max_distance(normal_max_distance);
	}

	// --- UI / menus (sem posição) ---
	void play_ui_sound(const string&in name) {
		spatial.play_ui("sounds/" + name, false, family_db(SOUND_FAMILY_UI));
	}

	void play_menu_click() { spatial.play_ui(SND_MENU_CLICK, false, family_db(SOUND_FAMILY_UI)); }
	void play_menu_confirm() { spatial.play_ui(SND_MENU_CONFIRM, false, family_db(SOUND_FAMILY_UI)); }
	void play_player_enter() { spatial.play_ui(SND_PLAYER_ENTER, false, family_db(SOUND_FAMILY_UI)); }
	void play_player_leave() { spatial.play_ui(SND_PLAYER_LEAVE, false, family_db(SOUND_FAMILY_UI)); }
	// As duas devolvem o slot: a abertura da partida espera cada uma acabar antes do passo seguinte.
	int play_start_game() { return spatial.play_ui(SND_START_GAME, false, family_db(SOUND_FAMILY_EVENTS)); }
	int play_heartbeat() { return spatial.play_ui(SND_HEARTBEAT, false, family_db(SOUND_FAMILY_EVENTS)); }
	void play_victory(bool crewmates_won) { spatial.play_ui(crewmates_won ? SND_VICTORY_CREW : SND_VICTORY_IMPOSTOR, false, family_db(SOUND_FAMILY_EVENTS)); }
	// Vitória de um NEUTRO sozinho: nem a música da tripulação nem a dos impostores - nenhum dos dois
	// lados ganhou. Usa o som de vitória que estava reservado e sem uso (SND_VICTORY_DISCONNECT).
	void play_victory_neutral() { spatial.play_ui(SND_VICTORY_DISCONNECT, false, family_db(SOUND_FAMILY_EVENTS)); }
	void play_meeting_result() { spatial.play_ui(SND_MEETING_RESULT, false, family_db(SOUND_FAMILY_EVENTS)); }
	void play_ejected() { spatial.play_ui(SND_EJECTED, false, family_db(SOUND_FAMILY_EVENTS)); }
	void play_vote_select() { spatial.play_ui(SND_VOTE_SELECT, false, family_db(SOUND_FAMILY_UI)); }
	void play_vote_confirm() { spatial.play_ui(SND_VOTE_CONFIRM, false, family_db(SOUND_FAMILY_UI)); }
	void play_vote_timer_tick() { spatial.play_ui(SND_VOTE_TIMER, false, family_db(SOUND_FAMILY_EVENTS)); }

	// --- Radar ---
	// O tom sobe conforme o alvo se aproxima. O volume posicionado já cai com a distância, mas volume
	// é ambíguo (uma pessoa longe e o volume do jogo baixo soam igual); o tom não. É o padrão dos
	// marcadores de rastreio em outros audiogames, e é o que faz o radar travado ser acompanhável sem
	// olhar - você ouve o tom subir e sabe que está chegando.
	// O tom diz NORTE (mais agudo) ou SUL (mais grave) - a única pergunta que o estéreo não responde
	// sozinho. Ver RADAR_PITCH_DIRECTION_STEP para o motivo de não ser a distância.
	// A transformação do shapeshifter, ouvida por quem está perto. Família EVENTS, a mesma da porta
	// e da morte: é um acontecimento do mundo, não interface de quem usou.
	void play_shapeshift(float x, float y) {
		spatial.play_once(SND_SHAPE_SHIFT, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	void play_revive(float x, float y) {
		spatial.play_once(SND_DOCTOR_REVIVE, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	// O fogo do incendiário. Devolve o slot, para quem chama esperar ele acabar antes da vitória.
	int play_arsonist_fire() { return spatial.play_ui(SND_ARSONIST_FIRE, false, family_db(SOUND_FAMILY_EVENTS)); }

	bool is_playing(int slot) { return slot >= 0 && spatial.pool.sound_is_playing(slot); }

	// Limpar ("clean"), arrastar ("drag") ou comer ("devour", o abutre) um corpo, no ponto onde acontece.
	void play_body_sound(const string&in kind, float x, float y) {
		string som = kind == "clean" ? SND_BODY_CLEAN : (kind == "devour" ? SND_BODY_EATEN : SND_BODY_DRAG);
		if (kind == "dig") som = SND_MINER_DIG;
		spatial.play_once(som, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	// A bomba do ofuscador, no ponto onde explodiu, para todos.
	void play_sound_bomb(float x, float y) { spatial.play_once(SND_SOUND_BOMB, x, y, family_db(SOUND_FAMILY_EVENTS)); }

	// Posicionado: para o lobo e o engolido o ponto é onde eles mesmos estão, então soa "em cima".
	void play_wolf_swallow(float x, float y) {
		spatial.play_once(SND_WOLF_SWALLOW, x, y, family_db(SOUND_FAMILY_EVENTS));
	}

	// Alguém morreu NA MESA, pelo palpite do sniper. É o MESMO som do assassinato, tocado SEM
	// posição - e as duas coisas são a mensagem: "kill" já significa assassinato para quem joga, e a
	// ausência de posição diz que foi aqui, na reunião, e não em algum lugar da nave. Um som novo
	// para isto seria um significado novo para aprender onde já existe um que serve (ver a regra "um
	// sinal sonoro, um significado", em notes/som.md).
	void play_meeting_kill() { spatial.play_ui(SND_KILL, false, family_db(SOUND_FAMILY_EVENTS)); }

	void play_radar_beep(float x, float y) {
		float dy = spatial.listener_y - y; // o y do mundo cresce para o SUL
		float pitch = 100.0;
		if (dy > RADAR_SAME_ROW_TOLERANCE) pitch += RADAR_PITCH_DIRECTION_STEP;
		else if (dy < -RADAR_SAME_ROW_TOLERANCE) pitch -= RADAR_PITCH_DIRECTION_STEP;
		spatial.play_once(SND_RADAR_BEEP, x, y, family_db(SOUND_FAMILY_BEACONS), pitch);
	}
}
