// game_state.nvgt
// Estado autoritativo de uma partida em andamento: jogadores, mapa, corpos, sabotagens,
// reuniões/votação e condição de vitória. Não conhece a camada de rede diretamente - produz
// net_packet@ para o servidor transmitir aos clientes da lobby.

#include "../config/game_constants.nvgt"
#include "../config/lobby_config.nvgt"
#include "../game/map.nvgt"
#include "player.nvgt"
// A regra de quem é atrapalhado por qual sabotagem mora num lugar só, e o servidor também pergunta
// a ela (can_hear_voice): quem percebe quem se decide aqui, não no cliente.
#include "sabotage_rules.nvgt"
#include "../network/protocol.nvgt"
#include "../network/packet.nvgt"

class body_info {
	string id;
	uint64 victim_peer_id;
	float x, y;
	string room_id;

	// --- O que o detetive lê no corpo (ver try_examine_body) ---
	// Quando a pessoa morreu, no relógio da partida. Vira "há quanto tempo" na hora do exame.
	float death_time = 0.0;
	// Por onde o assassino passou nos segundos seguintes à morte, em ordem, sem repetir sala
	// seguida. É o rastro FRIO: ele para de crescer depois de KILLER_TRAIL_SECONDS, e é isso que
	// faz a informação do detetive virar testemunho (uma frase que ainda vale na reunião) em vez de
	// caçada (uma direção que apodrece em dez segundos).
	array<string> killer_trail;
	uint64 killer_peer_id = 0;   // só para gravar o rastro; NUNCA sai daqui
	float trail_until = 0.0;     // até quando gravar, no relógio da partida
	bool examined = false;       // um exame por corpo: cada corpo é uma pista, não uma consulta
}

class vote_entry {
	uint64 voter_peer_id;
	int64 target_peer_id; // -1 = pular voto
}

class game_state {
	string lobby_id;
	string lobby_name;
	// Vazio = partida pública. Com código, ela some da lista e só entra quem o digitar. A comparação
	// ignora maiúsculas: o código é ditado de viva voz entre amigos, e "Abc" e "abc" soam iguais.
	string join_code = "";
	bool is_private() const { return join_code != ""; }
	uint64 host_peer_id;
	lobby_config@ config;
	game_map@ map;
	array<game_player@> players;
	array<body_info> bodies;
	array<vote_entry> votes;

	string state = "waiting"; // waiting | in_progress | meeting | voting | ended
	float meeting_timer = 0.0;
	float voting_timer = 0.0;
	uint64 meeting_caller = 0;
	string meeting_reason = ""; // "body" | "button"
	// Quem estava escondido num vent quando a última reunião começou. O servidor precisa avisar
	// essas pessoas de que elas saíram do vent (ver broadcast_meeting_and_voting).
	array<uint64> meeting_unvented_peers;
	// Quem estava disfarçado quando a reunião começou: a fantasia cai, e essas pessoas precisam ser
	// avisadas - senão o shapeshifter volta da votação achando que ainda está fantasiado.
	array<uint64> meeting_unshifted_peers;
	array<string> meeting_doors_opened; // portas que a reunião abriu, pra avisar os clientes

	// Recarga do botão de emergência depois de uma reunião. Sem ela, o botão podia ser apertado de
	// novo no instante em que a votação terminava, com todo mundo ainda parado na cafeteria.
	float meeting_cooldown_remaining = 0.0;
	float doors_cooldown_remaining = 0.0; // recarga da ação de fechar portas (separada da sabotagem)
	string active_sabotage = ""; // "" | "lights" | "oxygen" | "comms"
	string last_sabotage_id = ""; // pra não deixar repetir a mesma sabotagem duas vezes seguidas
	float sabotage_timer = 0.0;
	// Último número já anunciado da contagem regressiva, para não repetir o mesmo segundo em ticks
	// seguidos (o laço roda dezenas de vezes por segundo). -1 = nada anunciado ainda nesta sabotagem.
	int last_sabotage_countdown = -1;
	float sabotage_cooldown_remaining = 0.0;
	array<string> sabotage_fixed_panels;

	// --- Câmeras de segurança ---
	// Quem está no posto agora (0 = livre) e para qual sala ele aponta.
	//
	// O posto é de UM de cada vez, e quem arbitra é o servidor: dois jogadores apertando Enter no
	// mesmo instante não têm como se acertar sozinhos, e o cliente não sabe que outro já entrou.
	uint64 camera_user_peer = 0;
	string camera_room_id = "";

	// Quem está numa task VISÍVEL agora (o scan da enfermaria), e em qual ponto. 0 = ninguém.
	// Um de cada vez basta: só existe um scanner na nave.
	uint64 visible_task_peer = 0;
	string visible_task_object_id = "";

	// Código do oxigênio desta sabotagem. Decidido aqui, uma vez, para ser o MESMO nos dois painéis:
	// quem ouviu num painel pode ditar para quem está no outro.
	string oxygen_code = "";

	string winner = ""; // "" | "crewmates" | "impostors"
	string win_reason = "";
	float elapsed_time = 0.0;

	uint bot_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].is_bot) count++;
		}
		return count;
	}

	uint human_count() const {
		return players.length() - bot_count();
	}

	game_player@ find_player(uint64 peer_id) const {
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].peer_id == peer_id) return players[i];
		}
		return null;
	}

	array<game_player@>@ alive_players() const {
		array<game_player@> result;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive) result.insert_last(players[i]);
		}
		return result;
	}

	// Um jogador conta pra vitória por tasks? Impostor não tem task, e quem caiu da partida não vai
	// terminar as dele nunca - deixar os dois de fora é o que faz a conta fechar.
	bool counts_for_task_win(game_player@ p) const {
		return !p.is_impostor && !p.left_match;
	}

	// Progresso de tasks da EQUIPE (todos os tripulantes, vivos e fantasmas - fantasma continua
	// fazendo task, ver network/server.on_task_input). É o mesmo número que decide a vitória por
	// tasks lá embaixo no tick, e por isso usa exatamente o mesmo critério de quem entra na conta.
	uint crew_task_total() const {
		uint total = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (counts_for_task_win(players[i])) total += players[i].task_count();
		}
		return total;
	}

	uint crew_task_completed() const {
		uint done = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (counts_for_task_win(players[i])) done += players[i].completed_task_count();
		}
		return done;
	}

	net_packet@ build_task_progress_packet() const {
		uint total = crew_task_total();
		uint done = crew_task_completed();
		net_packet@ pkt = net_packet(S_TASK_PROGRESS);
		pkt.set_int("completed", int(done));
		pkt.set_int("total", int(total));
		pkt.set_int("percent", total == 0 ? 100 : int((done * 100) / total));
		return pkt;
	}

	uint alive_crewmate_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && !players[i].is_impostor) count++;
		}
		return count;
	}

	uint alive_impostor_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && players[i].is_impostor) count++;
		}
		return count;
	}

	// Jogadores no mesmo cômodo/corredor que peer_id, vivos, não escondidos em vent - usado pelo radar.
	array<game_player@>@ players_in_same_room(uint64 peer_id) const {
		game_player@ me = find_player(peer_id);
		if (@me == null) return array<game_player@>();
		return players_in_room(map.room_id_at(me.x, me.y), peer_id);
	}

	// Quem está numa sala e pode ser percebido: vivo, fora de duto, visível, e não é quem está
	// perguntando.
	//
	// A regra mora aqui e não em cada lugar que precisa dela. O radar e a câmera de segurança são
	// duas perguntas diferentes sobre a MESMA coisa, e enquanto a câmera respondia sozinha, do lado
	// do cliente, ela contava quem estava escondido dentro de um duto - entregando de graça a
	// dedução que o duto existe para negar.
	array<game_player@>@ players_in_room(const string&in room_id, uint64 except_peer) const {
		array<game_player@> result;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			// `invisible()` entra ao lado de `vented` porque é a mesma ideia: presente, mas
			// imperceptível. Pendurar aqui é o que faz o radar E a câmera concordarem de graça.
			if (p.peer_id == except_peer || !p.alive || p.vented || p.invisible()) continue;
			if (map.room_id_at(p.x, p.y) == room_id) result.insert_last(p);
		}
		return result;
	}

	// Move validado usando o relógio interno da partida (elapsed_time) para calcular o delta desde
	// o último movimento aceito deste jogador - evita depender de relógio de rede não confiável.
	// Jogador morto (morto ou expulso) PODE se mover - vira fantasma, como no Among Us original -
	// quem trata a visibilidade/silêncio disso é on_move() (só retransmite pra outros mortos).
	bool try_move_player(uint64 peer_id, float x, float y) {
		game_player@ p = find_player(peer_id);
		if (@p == null) return false;
		if (state != "in_progress") return false; // movimento travado durante reunião/votação
		if (p.vented) return false; // escondido num vent - só sai/viaja pela rede (ver on_vent_travel)
		// De onde ele está pra onde quer ir: parede barra sempre, porta fechada só barra quem está do
		// lado de fora dela (ver game_map.can_move).
		if (!map.can_move(p.x, p.y, x, y, p.alive)) return false;
		float delta = elapsed_time - p.last_move_time;
		if (delta <= 0.0) delta = 1.0 / NETWORK_TICKS_PER_SECOND;
		bool ok = p.try_move(x, y, delta);
		// SÓ avança o relógio de referência quando o movimento é ACEITO. Antes avançava sempre,
		// mesmo numa rejeição - aí a janela de tempo pro próximo pacote ficava minúscula (só o
		// intervalo entre pacotes, não desde a última posição CONFIRMADA), enquanto o cliente
		// continuava andando localmente e se afastando cada vez mais da posição travada no servidor.
		// Resultado: depois de UM pacote rejeitado (ex.: um soluço de rede), o jogador ficava preso
		// pro resto da partida sem NUNCA mais conseguir um movimento aceito - exatamente o que
		// "curava" ao entrar numa reunião, porque lá a posição de todo mundo é resincronizada à
		// força (ver start_meeting).
		if (ok) p.last_move_time = elapsed_time;
		return ok;
	}

	// A recarga do tiro DESTE jogador. O xerife pode ter a dele, separada da do impostor (ver o
	// tunable do papel); zero ali significa "a mesma da sala", que é o campo vazio do formulário.
	float kill_cooldown_for(game_player@ p) const {
		if (@p == null) return config.kill_cooldown_seconds;
		float propria = config.role_value(p.role_id, TUNABLE_KILL_COOLDOWN);
		return propria > 0.0 ? propria : config.kill_cooldown_seconds;
	}

	// --- Kill ---
	//
	// Nem todo tiro mata quem foi mirado: o xerife que atira em quem NÃO é impostor morre no lugar
	// dele (ver role_sheriff). Por isso quem morre é decidido aqui, e não presumido - e o resto do
	// jogo continua recebendo um S_PLAYER_KILLED só, com a vítima que de fato caiu.
	bool try_kill(uint64 killer_peer, uint64 target_peer, net_packet@&out out_event) {
		bool ignorado = false;
		return try_kill(killer_peer, target_peer, out_event, ignorado);
	}

	bool try_kill(uint64 killer_peer, uint64 target_peer, net_packet@&out out_event, bool&out misfire) {
		misfire = false;
		game_player@ killer = find_player(killer_peer);
		game_player@ target = find_player(target_peer);
		if (@killer == null || @target == null) return false;
		if (!killer.can_kill()) return false;
		if (!target.alive || target.peer_id == killer.peer_id) return false;
		if (distance_2d(killer.x, killer.y, target.x, target.y) > PLAYER_KILL_RANGE) return false;

		// Escudo do anjo da guarda: o ataque simplesmente NÃO acontece.
		//
		// Aqui em cima de propósito, antes de qualquer outra coisa. Antes da recarga porque gastá-la
		// seria um aviso indireto - "apertei, não saiu som de kill e meu cooldown zerou" só pode
		// significar escudo. E antes do cálculo do tiro errado porque o escudo vale contra QUALQUER
		// ataque: o xerife que mira num inocente protegido também não morre. Uma regra só, sem
		// exceção para explicar no manual.
		if (target.shield_remaining > 0.0) return false;

		bool killer_is_impostor = killer.role().team == TEAM_IMPOSTOR;
		// Impostor não mata impostor. Além de não fazer sentido (são do mesmo time e se conhecem
		// desde o começo da partida), um mata-mata entre parceiros por engano entregava a rodada
		// inteira: some um impostor e a tripulação ganha de graça.
		if (killer_is_impostor && target.is_impostor) return false;

		// Quem atira pela TRIPULAÇÃO e erra o alvo morre no lugar dele. É o que faz o xerife ser uma
		// aposta e não uma arma: matar o inocente custa a própria vida, e a tripulação perde duas
		// pessoas de uma vez. O alvo não fica sabendo de nada - ele só ouve um assassinato do lado,
		// como qualquer vizinho, e essa ambiguidade é o ponto.
		misfire = !killer_is_impostor && !target.is_impostor;
		game_player@ victim = misfire ? killer : target;

		victim.alive = false;
		killer.kill_cooldown_remaining = kill_cooldown_for(killer);
		// Matar REVELA o fantasma. É o preço inteiro do papel: ele atravessa a nave sem ser
		// percebido, mas o instante do crime o devolve ao mundo - com som, no lugar onde está, para
		// quem estiver por perto. Sem isto ele mataria e sumiria de novo, e não haveria jogo do
		// outro lado. Quem avisa é o servidor, pelo mesmo caminho da invisibilidade que expira.
		if (killer.invisible()) killer.invisible_remaining = 0.0;

		body_info body;
		body.id = "body_" + victim.peer_id;
		body.victim_peer_id = victim.peer_id;
		body.x = victim.x;
		body.y = victim.y;
		body.room_id = map.room_id_at(victim.x, victim.y);
		// Para o detetive. Quem matou fica guardado só para gravar por onde ele anda daqui a pouco -
		// o nome dele NUNCA sai deste objeto. No tiro errado do xerife, quem "matou" é o próprio
		// morto, então o rastro nasce vazio e o exame não aponta ninguém: correto, porque não houve
		// assassino para rastrear.
		body.death_time = elapsed_time;
		body.killer_peer_id = killer.peer_id;
		body.trail_until = elapsed_time + config.role_value(ROLE_DETECTIVE, TUNABLE_TRAIL);
		bodies.insert_last(body);

		@out_event = net_packet(S_PLAYER_KILLED);
		out_event.set_uint64("peer_id", victim.peer_id);
		out_event.set_uint64("killer_peer", killer.peer_id);
		// O nome de quem matou NÃO viaja aqui, e isso é decisão, não esquecimento.
		//
		// A vítima resolve o nome pelo elenco dela, que não conhece disfarce nenhum - ou seja, quem
		// morre para o metamorfo descobre quem ele é DE VERDADE. É de propósito: quem morreu já
		// pagou o preço e não tem como contar a ninguém (não vota, não fala com vivo, e fantasma só
		// é ouvido por fantasma), então mentir para ele não compra nada ao impostor e só piora o
		// jogo de quem já perdeu. No caso normal a vítima também sabe quem a matou; fazer o
		// contrário aqui tornaria morrer para o metamorfo pior do que morrer para um impostor comum.
		//
		// E o nome verdadeiro não pode entrar NESTE pacote de jeito nenhum: ele é transmitido à
		// partida inteira. Seria o mesmo erro do `misfire` do xerife.
		out_event.set_int("killer_color", killer.color);
		out_event.set_float("x", victim.x);
		out_event.set_float("y", victim.y);
		// O tiro errado NÃO entra neste pacote: ele é transmitido à partida inteira, e qualquer um
		// leria "aquele que morreu era um xerife que errou" - de graça, sem ter visto nada. Quem
		// precisa saber é só quem morreu, e quem avisa é o servidor, em particular (ver on_kill).
		// Para todos os outros isto é um assassinato como qualquer outro, e é essa ambiguidade que
		// faz o xerife valer a pena.
		return true;
	}

	body_info@ find_body_near(float x, float y, float max_range) {
		for (uint i = 0; i < bodies.length(); i++) {
			if (distance_2d(x, y, bodies[i].x, bodies[i].y) <= max_range) return bodies[i];
		}
		return null;
	}

	// --- Portas ---
	// Fecha TODOS os corredores que dão pra uma sala, prendendo quem está lá dentro (e quem está
	// fora, do lado de fora). Não tem conserto: reabrem sozinhas quando o tempo acaba. É de
	// propósito que isso não passe pelo sistema de sabotagem - poder fechar a porta da elétrica E
	// apagar a luz ao mesmo tempo é justamente o que torna a jogada interessante.
	bool close_doors_of_room(uint64 impostor_peer, const string&in room_id, array<string>@&out closed_zones) {
		@closed_zones = array<string>();
		if (state != "in_progress") return false;
		game_player@ impostor = find_player(impostor_peer);
		if (@impostor == null || !impostor.is_impostor || !impostor.alive) return false;
		if (doors_cooldown_remaining > 0.0) return false;

		map_zone@ room = map.find_zone(room_id);
		if (@room == null || room.is_corridor) return false;

		array<string>@ neighbors = map.zone_neighbors(room_id); // pra uma sala, vizinhos = os corredores dela
		if (neighbors.length() == 0) return false;

		map.close_doors(neighbors, DOORS_CLOSED_SECONDS);
		doors_cooldown_remaining = DOORS_COOLDOWN_SECONDS;
		@closed_zones = neighbors;
		return true;
	}

	net_packet@ build_doors_packet(array<string>@ zones, bool closed) const {
		json_array@ list = json_array();
		for (uint i = 0; i < zones.length(); i++) list.add(zones[i]);
		net_packet@ pkt = net_packet(S_DOORS_STATE);
		pkt.set_bool("closed", closed);
		pkt.set_array("zones", list);
		return pkt;
	}

	// --- Reunião / votação ---
	// Vai direto pra votação (sem uma fase de "discussão" separada travando o menu) - todo mundo
	// vivo é teleportado pra cafeteria, o movimento trava (ver try_move_player), e o chat abre geral
	// pra todos (ver server.on_chat_message) durante o tempo combinado de discussão+votação.
	// Motivo pelo qual o botão de emergência não pode ser apertado agora ("" = pode). Reportar corpo
	// não passa por aqui: quem achou um corpo sempre pode reportar, como no jogo original.
	string emergency_button_cooldown_reason() const {
		if (meeting_cooldown_remaining > 0.0) return "game.meeting_cooldown_remaining";
		return "";
	}

	bool start_meeting(uint64 caller_peer, const string&in reason, net_packet@&out out_event) {
		if (state != "in_progress") return false;
		game_player@ caller = find_player(caller_peer);
		if (@caller == null || !caller.alive) return false;
		if (reason == "button" && caller.meetings_called >= config.emergency_meetings_per_player) return false;
		if (reason == "button" && meeting_cooldown_remaining > 0.0) return false;

		if (reason == "button") caller.meetings_called++;

		// Reunião abre tudo: todo mundo é teleportado pra cafeteria de qualquer jeito, e voltar da
		// votação preso atrás de uma porta que fechou antes da reunião não faria sentido nenhum.
		meeting_doors_opened = map.open_all_doors();

		// TODOS os corpos somem, não só o que foi reportado. A reunião já revela quem morreu (a lista
		// de vivos na votação diz), então um corpo esquecido no chão depois disso só serve pra ser
		// "reportado" de novo e gerar uma reunião repetida pela mesma morte.
		bodies.resize(0);

		// A reunião desfaz toda fantasia. Na reunião se vota POR NOME, e dois nomes iguais na lista
		// de votação não são um blefe: são uma tela quebrada, em que o voto pode cair na pessoa
		// errada. Na mesa todo mundo é quem é - o disfarce serve para o que acontece na nave.
		// A lista sai daqui para quem desfez ser avisado (ver broadcast_meeting_and_voting).
		meeting_unshifted_peers.resize(0);
		for (uint i = 0; i < players.length(); i++) {
			if (!players[i].disguised()) continue;
			players[i].set_disguise("", 0.0);
			meeting_unshifted_peers.insert_last(players[i].peer_id);
		}

		// E a invisibilidade cai junto, pelo mesmo motivo e por mais um: invisível não é ouvido, e
		// ficar mudo na reunião sem explicação seria um sinal luminoso de quem é o fantasma - o
		// oposto do que a habilidade existe para fazer. Quem volta é avisado pelo caminho de sempre
		// (was_invisible + expire_invisibility no tick), então o som da volta toca aqui também.
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].invisible()) players[i].invisible_remaining = 0.0;
		}

		// E o escudo do anjo, pela regra geral: o que a reunião não desfaz, ela recarrega de graça.
		// Ninguém mata durante a votação, então um escudo mantido só queima o relógio dele na mesa e
		// chega do outro lado com um resto imprevisível - quanto sobra dependia do tamanho da
		// discussão, que não é decisão de ninguém. Cortado, a proteção vale para a fase em que foi
		// lançada, e o anjo sai da votação podendo lançar outra (ver ability_cooldown_resets_on_meeting).
		// Como ninguém é avisado do escudo, ninguém é avisado de perdê-lo: não há pacote aqui.
		for (uint i = 0; i < players.length(); i++) {
			players[i].shield_remaining = 0.0;
		}

		meeting_unvented_peers.resize(0);
		for (uint i = 0; i < players.length(); i++) {
			if (!players[i].alive) continue;
			players[i].x = MEETING_GATHER_X;
			players[i].y = MEETING_GATHER_Y;
			// Reunião TIRA do vent quem estava escondido: o jogador é teleportado pra cafeteria de
			// qualquer jeito, e deixar a flag ligada era uma armadilha sem saída. Quem continuasse
			// "vented" não conseguia mais andar (try_move_player recusa quem está no vent) e só sairia
			// pelo menu do vent, que exige estar vivo - ou seja, quem fosse EXPULSO nessa reunião
			// ficava travado no lugar pelo resto da partida, sem andar e sem conseguir sair do vent.
			if (!players[i].vented) continue;
			players[i].vented = false;
			players[i].current_vent_id = "";
			meeting_unvented_peers.insert_last(players[i].peer_id);
		}

		// Cada bot já sai da reunião com a hora dele de votar marcada - sem isso a votação sempre
		// esperaria o timer inteiro numa partida com bot (ninguém vota por eles).
		for (uint i = 0; i < players.length(); i++) {
			if (!players[i].is_bot) continue;
			players[i].bot_voted = false;
			players[i].bot_action_timer = random_range(BOT_VOTE_MIN_SECONDS, BOT_VOTE_MAX_SECONDS);
		}

		state = "voting";
		voting_timer = config.discussion_time_seconds + config.voting_time_seconds;
		meeting_caller = caller_peer;
		meeting_reason = reason;
		votes.resize(0);

		@out_event = net_packet(S_MEETING_STARTED);
		out_event.set_uint64("caller_peer", caller_peer);
		out_event.set_string("reason", reason);
		out_event.set_float("gather_x", MEETING_GATHER_X);
		out_event.set_float("gather_y", MEETING_GATHER_Y);
		// A duração da discussão vai junto para o cliente conseguir dizer quanto falta sem perguntar
		// nada ao servidor (ver announce_time_remaining em ui/meeting_ui.nvgt). O protocolo já
		// previa este campo desde o começo; ele simplesmente nunca chegou a ser preenchido, e o
		// cliente lia zero.
		out_event.set_float("discussion_time", config.discussion_time_seconds);
		return true;
	}

	bool cast_vote(uint64 voter_peer, int64 target_peer) {
		if (state != "voting") return false;
		game_player@ voter = find_player(voter_peer);
		if (@voter == null || !voter.alive) return false;
		for (uint i = 0; i < votes.length(); i++) {
			if (votes[i].voter_peer_id == voter_peer) return false; // já votou
		}
		vote_entry v;
		v.voter_peer_id = voter_peer;
		v.target_peer_id = target_peer;
		votes.insert_last(v);
		return true;
	}

	bool all_alive_voted() const {
		uint alive_count = alive_crewmate_count() + alive_impostor_count();
		return votes.length() >= alive_count;
	}

	net_packet@ tally_votes() {
		dictionary counts;
		array<int64> targets;
		json_array@ breakdown = json_array(); // quem votou em quem, pra anunciar no cliente antes do resultado
		for (uint i = 0; i < votes.length(); i++) {
			int64 t = votes[i].target_peer_id;
			// dictionary.get() com chave AUSENTE não zera o &out: ele sai com LIXO (é assim que o
			// AngelScript trata &out não escrito). Sempre exists() antes.
			string key = "" + t;
			int64 c = 0;
			if (counts.exists(key)) counts.get(key, c);
			c++;
			counts.set(key, c);
			if (targets.find(t) == -1) targets.insert_last(t);

			game_player@ voter = find_player(votes[i].voter_peer_id);
			json_object@ entry = json_object();
			entry.set("voter_name", @voter != null ? voter.username : "");
			if (t == -1) {
				entry.set("skipped", true);
				entry.set("target_name", "");
			} else {
				game_player@ target = find_player(uint64(t));
				entry.set("skipped", false);
				entry.set("target_name", @target != null ? target.username : "");
			}
			breakdown.add(entry);
		}

		// "Pular" CONTA na apuração, como candidato a "ninguém". É a regra do jogo original, e é o
		// que impede a injustiça de antes: com nove jogadores pulando e um votando, aquele um voto
		// expulsava alguém - a vontade de nove pessoas valia zero. Agora alguém só é expulso se tiver
		// MAIS votos do que "pular" e do que qualquer outro; empate com "pular" é ninguém expulso.
		int64 skip_count = 0;
		// Sem exists() isto era o bug "todo mundo votou nele e ninguém foi expulso": sem nenhum
		// "pular" a chave não existia, skip_count saía com lixo e "vencia" a apuração como empate.
		if (counts.exists("-1")) counts.get("-1", skip_count);
		int64 best_target = -1;
		int64 best_count = 0;
		bool tie = false;
		for (uint i = 0; i < targets.length(); i++) {
			int64 t = targets[i];
			if (t == -1) continue;
			int64 c = 0;
			if (counts.exists("" + t)) counts.get("" + t, c);
			if (c > best_count) { best_count = c; best_target = t; tie = false; }
			else if (c == best_count && c > 0) tie = true;
		}
		if (best_target != -1 && best_count <= skip_count) {
			// Pular ganhou ou empatou com o mais votado: ninguém sai. Empate com pular é "empate" para
			// o jogador ouvir que a votação não decidiu nada.
			tie = best_count == skip_count;
			best_target = -1;
		}

		net_packet@ result = net_packet(S_VOTE_RESULT);
		// A lista de quem votou em quem só existe com os votos abertos - e nesse caso ela já foi dita
		// voto a voto durante a reunião, então o cliente não a repete no fim (ver on_vote_result).
		if (config.show_votes) result.set_array("vote_breakdown", breakdown);
		if (best_target != -1 && !tie && best_count > 0) {
			game_player@ ejected = find_player(uint64(best_target));
			if (@ejected != null) {
				ejected.alive = false;
				result.set_uint64("ejected_peer", ejected.peer_id);
				result.set_string("ejected_name", ejected.username);
				// Com a revelação desligada o papel NÃO viaja: o cliente é a máquina do jogador, e
				// mandar "só para ele não falar" seria mandar a resposta para quem quisesse ler.
				result.set_bool("role_revealed", config.reveal_ejected_role);
				if (config.reveal_ejected_role) result.set_bool("was_impostor", ejected.is_impostor);
				result.set_bool("tie", false);
			}
		} else {
			result.set_uint64("ejected_peer", 0);
			result.set_string("ejected_name", "");
			result.set_bool("was_impostor", false);
			result.set_bool("tie", tie);
		}

		state = "in_progress";
		votes.resize(0);

		// A partida recomeça com todo mundo junto na cafeteria. Sem zerar nada disso, a reunião virava
		// a melhor jogada do impostor: o cooldown de kill corria durante a discussão inteira e ele
		// saía da votação com a faca pronta, ao lado de todo mundo - bastava apertar matar. E o botão
		// de emergência podia ser apertado de novo no mesmo instante.
		// Vale para TODO mundo que pode matar, e não só para o impostor: o xerife sai da votação com
		// a arma recarregando pelo mesmo motivo, e com a recarga DELE (ver kill_cooldown_for).
		// A habilidade ativa segue a mesma regra, e por quem o PAPEL diz (ver
		// ability_cooldown_resets_on_meeting): nenhuma habilidade funciona durante a reunião, então
		// deixar a recarga correndo na discussão é recarregar de graça - o metamorfo saía da votação
		// pronto pra virar alguém no meio da multidão. As de defesa se recusam, e cada uma diz por quê
		// no próprio papel.
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].role().can_kill) players[i].kill_cooldown_remaining = kill_cooldown_for(players[i]);
			role_traits@ rt = players[i].role();
			if (rt.ability_id != "" && rt.ability_cooldown_resets_on_meeting) {
				players[i].ability_cooldown_remaining = config.role_value(players[i].role_id, TUNABLE_COOLDOWN);
			}
		}
		meeting_cooldown_remaining = config.emergency_cooldown_seconds;

		return result;
	}

	// --- Sabotagem ---
	// Sabotagem crítica = tem relógio e é derrota dos tripulantes se o tempo acabar. As outras duram
	// até alguém consertar o painel.
	bool is_critical_sabotage(const string&in sabotage_id) const {
		return sabotage_id == "oxygen";
	}

	bool trigger_sabotage(uint64 impostor_peer, const string&in sabotage_id, net_packet@&out out_event, string&out fail_key) {
		fail_key = "game.sabotage_unavailable";
		game_player@ impostor = find_player(impostor_peer);
		// Não exige estar VIVO: o impostor morto continua sabotando, como no jogo original. É o que
		// lhe resta - matar, ventilar e fechar portas acabam com ele -, e sem isso morrer cedo como
		// impostor era virar espectador. Ver can_sabotage em game/roles/role_traits.nvgt.
		if (@impostor == null || !impostor.is_impostor) return false;
		if (!config.sabotages_enabled) return false; // preset "rápido" desliga sabotagem (ver config/presets.nvgt)
		if (sabotage_id != "lights" && sabotage_id != "oxygen" && sabotage_id != "comms") return false;
		if (state != "in_progress") return false;
		if (active_sabotage != "") return false;
		if (sabotage_cooldown_remaining > 0.0) return false;
		// Sem isto o impostor martelava a MESMA sabotagem a partida inteira, que é o jeito mais
		// chato de jogar: a tripulação decora o caminho de um painel só e nada mais acontece.
		if (sabotage_id == last_sabotage_id) { fail_key = "game.sabotage_repeat"; return false; }

		active_sabotage = sabotage_id;
		last_sabotage_id = sabotage_id;
		sabotage_fixed_panels.resize(0);
		sabotage_timer = is_critical_sabotage(sabotage_id) ? SABOTAGE_OXYGEN_TIMER_SECONDS : 0.0;
		// Começa marcando o próprio total como "já anunciado", por dois motivos: a segunda sabotagem
		// crítica da partida não herda o número da primeira (o que faria ela pular avisos até passar
		// por baixo dele), e o total não é repetido logo de cara - o aviso de sabotagem iniciada já
		// diz "você tem 90 segundos", e o lembrete viria em cima, dizendo a mesma coisa duas vezes.
		last_sabotage_countdown = int(sabotage_timer);

		oxygen_code = "";
		if (sabotage_id == "oxygen") {
			for (uint i = 0; i < 5; i++) oxygen_code += "" + random(0, 9);
		}

		fail_key = "";
		@out_event = net_packet(S_SABOTAGE_STARTED);
		out_event.set_string("sabotage_id", sabotage_id);
		out_event.set_float("timer", sabotage_timer);
		out_event.set_bool("critical", is_critical_sabotage(sabotage_id));
		// O código vai para todos: ele não é segredo, é trabalho. O que custa é chegar ao painel e
		// digitar - e os dois painéis ficam em salas opostas.
		out_event.set_string("oxygen_code", oxygen_code);
		return true;
	}

	// Tenta ocupar o posto de câmeras. Devolve "" se conseguiu, ou a chave do motivo da recusa.
	//
	// As comunicações sabotadas derrubam as câmeras: é a mesma sabotagem que já tira radar,
	// marcadores e aviso de corpo, e sem isso o posto seria o único ponto do jogo que o impostor não
	// tem como cegar antes de agir.
	string try_enter_cameras(uint64 peer_id) {
		if (state != "in_progress") return "camera.unavailable";
		if (active_sabotage == "comms") return "camera.comms_down";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) return "camera.unavailable"; // fantasma não opera equipamento
		if (camera_user_peer != 0 && camera_user_peer != peer_id) return "camera.busy";
		camera_user_peer = peer_id;
		if (camera_room_id == "") camera_room_id = "cafeteria"; // uma sala qualquer para começar
		return "";
	}

	// Libera o posto se for este jogador que o ocupa. Chamado de MUITOS lugares - sair, morrer,
	// desconectar, reunião começar, comunicações caírem - porque um posto que fica preso a alguém
	// que já saiu bloquearia as câmeras para o resto da partida.
	bool release_cameras(uint64 peer_id) {
		if (camera_user_peer == 0 || camera_user_peer != peer_id) return false;
		camera_user_peer = 0;
		camera_room_id = "";
		return true;
	}

	// Avança a tarefa deste jogador que está no ponto `object_id`.
	//
	// Tarefa de uma fase só é marcada concluída, como sempre. De várias fases, anda UMA fase e o
	// ponto seguinte volta em `next_object_id` - é ele que o cliente passa a mirar (marcador, lista
	// de tarefas). A fase fica guardada aqui, no servidor: quem for interrompido por uma reunião no
	// meio da travessia volta com o galão na mão, e não do começo - punir quem reporta um corpo
	// seria punir exatamente o comportamento que o jogo quer.
	//
	// Devolve false se a pessoa não tem essa tarefa pendente nesse ponto.
	bool advance_task(game_player@ p, const string&in object_id, string&out next_object_id, uint&out phase) {
		next_object_id = "";
		phase = 0;
		if (@p == null) return false;
		for (uint i = 0; i < p.tasks.length(); i++) {
			player_task@ t = p.tasks[i];
			if (t.object_id != object_id || t.completed) continue;
			if (t.phase + 1 < t.phase_count) {
				t.phase++;
				t.object_id = map.chain_object_at(t.task_type, t.phase);
				next_object_id = t.object_id;
				phase = t.phase;
				return true;
			}
			t.completed = true;
			phase = t.phase;
			return true;
		}
		return false;
	}

	// Começa uma task visível para `peer`, se ele tiver essa task pendente e estiver vivo. Devolve
	// false quando não tem - que é exatamente o caso do impostor fingindo, e do fantasma (o scan de
	// quem já morreu não serve de álibi a ninguém).
	bool try_start_visible_task(uint64 peer, const string&in object_id) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) return false;
		// O scanner é de um de cada vez. Sem isto, três pessoas entrando juntas se sobrescreviam aqui:
		// o servidor passava a acompanhar só a última, o fim do scan das outras não avisava ninguém, e
		// o som do scanner ficava tocando (ou parava cedo) sem relação com quem estava nele.
		if (visible_task_peer != 0 && visible_task_peer != peer) return false;
		map_object@ spot = map.find_object(object_id);
		if (@spot == null || spot.obj_type != OBJ_TASK_SPOT || !task_is_visible(spot.task_type)) return false;
		bool pending = false;
		for (uint i = 0; i < p.tasks.length(); i++) {
			if (p.tasks[i].object_id == object_id && !p.tasks[i].completed) { pending = true; break; }
		}
		if (!pending) return false;
		visible_task_peer = peer;
		visible_task_object_id = object_id;
		return true;
	}

	// Quem ouve a voz de quem. É a regra de percepção do chat de voz, e mora aqui pelo mesmo motivo
	// de players_in_room(): o cliente não sabe quem está morto de verdade nem quem está num duto, e
	// entregar voz é entregar posição - uma voz posicionada denuncia onde a pessoa está.
	//
	// - Na sala de espera todo mundo se ouve, sem posição: é o bate-papo antes da partida.
	// - Na reunião e na votação todos os vivos se ouvem: é a discussão, e todos estão no mesmo lugar.
	// - Andando pela nave, a voz alcança VOICE_RANGE - a mesma sala, não a nave inteira - e quem
	//   está dentro de um duto não é ouvido por fora (ver on_voice_frame no servidor).
	// - Fantasma ouve todo mundo e só é ouvido por fantasma: o morto continua acompanhando a partida
	//   (como no jogo original) mas não pode contar aos vivos quem o matou.
	bool can_hear_voice(game_player@ talker, game_player@ listener) const {
		if (@talker == null || @listener == null) return false;
		if (state == "waiting" || state == "ended") return true;
		if (!talker.alive) return !listener.alive;
		if (!listener.alive) return true;
		// Comunicações sabotadas derrubam o rádio de todos os vivos, impostor incluído; na reunião,
		// só se a sala tiver escolhido isso. Toda essa decisão está em voice_down_for, para o cliente
		// poder tomar exatamente a mesma.
		bool in_meeting = state == "meeting" || state == "voting";
		if (voice_down_for(active_sabotage, talker.alive, in_meeting, config.comms_affects_meeting)) return false;
		if (voice_down_for(active_sabotage, listener.alive, in_meeting, config.comms_affects_meeting)) return false;
		if (in_meeting) return true; // na reunião todo mundo está no mesmo lugar: sem distância
		return distance_2d(talker.x, talker.y, listener.x, listener.y) <= VOICE_RANGE;
	}

	// Encerra a task visível se for deste jogador (ou de qualquer um, com peer 0). Devolve quem
	// estava nela, para o servidor avisar a partida - o mesmo motivo do release_cameras_any.
	uint64 end_visible_task(uint64 peer = 0) {
		if (visible_task_peer == 0 || (peer != 0 && visible_task_peer != peer)) return 0;
		uint64 quem = visible_task_peer;
		visible_task_peer = 0;
		visible_task_object_id = "";
		return quem;
	}

	// Libera seja quem for e devolve QUEM foi liberado (0 = não havia ninguém). Usado quando a
	// partida muda de fase ou a sabotagem derruba tudo.
	//
	// Devolve o peer, e não um sim/não, porque quem estava observando precisa ser avisado: o posto
	// fechar só no servidor deixava o cliente dele achando que ainda está na câmera - parado, surdo
	// para o próprio entorno e sem conseguir andar. Um estado que só existe de um lado é um jogador
	// travado.
	uint64 release_cameras_any() {
		if (camera_user_peer == 0) return 0;
		uint64 quem = camera_user_peer;
		camera_user_peer = 0;
		camera_room_id = "";
		return quem;
	}

	int required_panels_for(const string&in sabotage_id) const {
		return sabotage_id == "oxygen" ? 2 : 1;
	}

	// Reunião (botão ou reporte de corpo) fica bloqueada enquanto uma sabotagem crítica está de pé -
	// é assim no Among Us original, e é o que impede o caso em que a reunião come todo o tempo do
	// oxigênio e a tripulação volta pra partida já sem chance de chegar nos painéis.
	bool meetings_blocked_by_sabotage() const {
		return active_sabotage != "" && is_critical_sabotage(active_sabotage);
	}

	// Motivo pelo qual o botão de emergência não pode ser usado agora ("" = pode).
	// Além da sabotagem crítica, as LUZES também derrubam o botão: no escuro ninguém acha o botão
	// pra chamar reunião, e poder chamar uma reunião no apagão anulava a sabotagem inteira (todo
	// mundo era teleportado pra cafeteria em segurança). Reportar corpo continua valendo no escuro -
	// quem tropeçou num corpo tropeçou nele de verdade.
	string emergency_button_block_reason() const {
		if (active_sabotage == "") return "";
		if (is_critical_sabotage(active_sabotage)) return "sabotage.blocks_meeting";
		if (active_sabotage == "lights") return "sabotage.lights.blocks_button";
		return "";
	}

	// panels_fixed/panels_required saem preenchidos mesmo quando ainda falta painel (pra dar feedback
	// de progresso pra quem consertou parcialmente - ver network/server.on_interact) - só quando o
	// ÚLTIMO painel necessário é consertado é que out_event vem preenchido e o retorno é true.
	bool try_fix_sabotage_panel(uint64 peer_id, const string&in object_id, net_packet@&out out_event, int&out panels_fixed, int&out panels_required, string&out fail_key) {
		panels_fixed = 0;
		panels_required = 0;
		fail_key = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) return false;

		map_object@ obj = map.find_object(object_id);
		if (@obj == null || obj.obj_type != OBJ_SABOTAGE_PANEL) return false; // nem é painel: nada a explicar
		// Daqui pra baixo o jogador REALMENTE tentou consertar um painel, então toda saída sai com um
		// motivo - antes qualquer um desses casos falhava calado e o painel parecia simplesmente
		// quebrado (o cliente até tocava o som de abrir o painel e nada acontecia).
		if (active_sabotage == "") { fail_key = "sabotage.no_active"; return false; }
		if (obj.task_type != active_sabotage) { fail_key = "sabotage.wrong_panel"; return false; }
		// A posição que o servidor tem vem do canal não confiável e vive um pouco atrasada, então
		// aqui a distância é conferida com folga - conferir com o valor exato fazia o conserto falhar
		// de forma aleatória mesmo com o jogador colado no painel (mesmo motivo do botão de reunião).
		if (distance_2d(p.x, p.y, obj.x, obj.y) > PLAYER_INTERACT_RANGE * 2.0) { fail_key = "sabotage.too_far"; return false; }

		// Este painel já foi consertado por alguém (o oxigênio pede dois, e nada impedia de voltar ao
		// mesmo): dizer isso é o que evita a pessoa digitar o código de novo achando que está ajudando.
		if (sabotage_fixed_panels.find(object_id) != -1) { fail_key = "sabotage.panel_already_fixed"; return false; }
		sabotage_fixed_panels.insert_last(object_id);
		panels_fixed = int(sabotage_fixed_panels.length());
		panels_required = required_panels_for(active_sabotage);
		if (panels_fixed < panels_required) return false;

		@out_event = net_packet(S_SABOTAGE_FIXED);
		out_event.set_string("sabotage_id", active_sabotage);
		active_sabotage = "";
		sabotage_fixed_panels.resize(0);
		sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
		return true;
	}

	// Conserto REMOTO da sabotagem inteira, de onde quer que o jogador esteja (habilidade do
	// engenheiro). Resolve TODOS os painéis que faltavam de uma vez - resolver um só deixaria o
	// engenheiro atravessando a nave para o outro, que é exatamente o que a habilidade evita.
	//
	// Não é try_fix_sabotage_panel com a distância relaxada: aquele é o conserto NORMAL, que exige
	// estar no painel, e as duas coisas têm regras diferentes de propósito. O que elas compartilham
	// é o efeito, e por isso o pacote de fim de sabotagem é o MESMO (S_SABOTAGE_FIXED): o resto do
	// jogo não precisa saber por que a sabotagem acabou.
	//
	// Quem conserta daqui precisa estar VIVO: a habilidade não está na lista das que sobrevivem à
	// morte, e o fantasma não opera equipamento (mesma regra do scanner e da câmera).
	bool try_remote_fix_sabotage(uint64 peer_id, net_packet@&out out_event, string&out fail_key) {
		fail_key = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (active_sabotage == "") { fail_key = "sabotage.no_active"; return false; }

		@out_event = net_packet(S_SABOTAGE_FIXED);
		out_event.set_string("sabotage_id", active_sabotage);
		active_sabotage = "";
		sabotage_fixed_panels.resize(0);
		sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
		return true;
	}

	// Grava por onde o assassino anda nos primeiros segundos depois de cada morte recente.
	//
	// Roda por quadro e custa quase nada: no máximo um corpo ou dois estão gravando ao mesmo tempo,
	// e cada um só olha o jogador que o matou.
	//
	// DENTRO DO DUTO nada é gravado - nem a sala onde ele entrou de novo, nem para onde saiu.
	// Estado de duto é privado (é a mesma regra que impede o radar e a câmera de contarem quem está
	// escondido), e sem isso o rastro denunciaria uma viagem de duto a quem não estava lá para ouvir
	// a tampa. Na prática, ventilar vira a contra-jogada natural contra o detetive: some do rastro,
	// ao custo do barulho para quem estiver por perto.
	private void tick_killer_trails() {
		for (uint i = 0; i < bodies.length(); i++) {
			body_info@ b = bodies[i];
			if (b.trail_until <= 0.0 || elapsed_time > b.trail_until) continue;
			if (b.killer_trail.length() >= KILLER_TRAIL_MAX_ROOMS) continue;
			game_player@ k = find_player(b.killer_peer_id);
			if (@k == null || k.vented) continue;
			// Corredor não entra: o rastro é para ser DITO, e "corredor da navegação para armas" no
			// meio da frase a torna impossível de acompanhar de ouvido. As salas bastam para o rumo -
			// e `room_id_at` devolve corredor também, então o filtro é explícito.
			map_zone@ z = map.zone_at(k.x, k.y);
			if (@z == null || z.is_corridor) continue;
			string room = z.id;
			if (room == b.room_id) continue; // a sala do corpo é o ponto de partida, não o rastro
			if (b.killer_trail.length() > 0 && b.killer_trail[b.killer_trail.length() - 1] == room) continue;
			b.killer_trail.insert_last(room);
		}
	}

	// O detetive examina o corpo mais próximo: há quanto tempo a pessoa morreu e por onde o
	// assassino passou depois (ver tick_killer_trails).
	//
	// UM exame por corpo, e é o `examined` do próprio corpo que garante isso: cada corpo vira uma
	// pista única, e não uma fonte que se consulta de novo a cada dúvida. Quem chega num corpo já
	// examinado ouve isso, em vez de um silêncio que pareceria bug.
	//
	// O rastro NÃO diz quem matou, e nem poderia: ele é uma lista de salas, e quem estava nelas por
	// acaso entra na conta junto com o culpado. É essa ambiguidade que faz a pista valer uma
	// discussão em vez de encerrar a partida.
	bool try_examine_body(uint64 peer_id, int&out seconds_ago, array<string>&out trail, string&out fail_key) {
		fail_key = "";
		seconds_ago = 0;
		trail.resize(0);
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }

		body_info@ body = find_body_near(p.x, p.y, PLAYER_REPORT_RANGE);
		if (@body == null) { fail_key = "role.examine_no_body"; return false; }
		if (body.examined) { fail_key = "role.examine_already_done"; return false; }

		body.examined = true;
		seconds_ago = int(elapsed_time - body.death_time + 0.5);
		trail = body.killer_trail;
		return true;
	}

	// Assume o nome de outro jogador VIVO. Devolve o nome copiado, que é o que o shapeshifter ouve.
	//
	// O alvo não precisa estar perto - a jogada é justamente imitar alguém que está longe, para que
	// a pessoa imitada não esteja por ali para desmentir. O que impede isso de ser grátis é o SOM da
	// transformação (posicionado, ouvido por quem está do lado dele) e o microfone fechado enquanto
	// durar (ver on_voice_frame).
	//
	// Morto não se transforma: fantasma não aparece no radar de ninguém, então não haveria o que
	// disfarçar.
	bool try_shapeshift(uint64 peer_id, uint64 target_peer, string&out copied_name, string&out fail_key) {
		fail_key = "";
		copied_name = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		game_player@ target = find_player(target_peer);
		// Alvo morto entra no mesmo "esse não serve" de um alvo que não existe: dizer "essa pessoa
		// está morta" contaria ao impostor um corpo que ele talvez não tivesse encontrado.
		if (@target == null || !target.alive || target.peer_id == peer_id) { fail_key = "role.shift_bad_target"; return false; }

		p.set_disguise(target.display_name(), config.role_value(ROLE_SHAPESHIFTER, TUNABLE_DURATION));
		copied_name = p.disguise_name;
		return true;
	}

	// O fantasma some. Devolve false só se ele não puder agora (morto, ou já invisível).
	bool try_vanish(uint64 peer_id, string&out fail_key) {
		fail_key = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (p.invisible()) { fail_key = "role.vanish_already"; return false; }
		p.invisible_remaining = config.role_value(ROLE_PHANTOM, TUNABLE_DURATION);
		return true;
	}

	// Desfaz as invisibilidades que venceram, e devolve quem voltou a ser percebido - o servidor
	// avisa cada um e toca o som onde ele está.
	array<uint64>@ expire_invisibility() {
		array<uint64> voltaram;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			// `invisible_remaining == 0` não basta para saber que ele ESTAVA invisível: é preciso um
			// sinal de que acabou AGORA. O `was_invisible` é escrito no tick, junto do relógio.
			if (!p.was_invisible || p.invisible()) continue;
			p.was_invisible = false;
			voltaram.insert_last(p.peer_id);
		}
		return voltaram;
	}

	// Desfaz as fantasias cujo tempo acabou. Devolve quem voltou ao normal, para o servidor avisar
	// cada um e tocar o som onde ele está - a volta é tão audível quanto a ida, senão desfazer-se
	// no meio de uma sala seria grátis.
	array<uint64>@ expire_disguises() {
		array<uint64> voltaram;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (!p.disguised() || p.disguise_remaining > 0.0) continue;
			p.set_disguise("", 0.0);
			voltaram.insert_last(p.peer_id);
		}
		return voltaram;
	}

	// Escudo do anjo da guarda sobre alguém vivo. Devolve o NOME do protegido, porque é a única
	// coisa que o anjo ouve de volta - ninguém mais é avisado de nada.
	//
	// Exige o anjo MORTO (o papel só age depois de morrer) e o alvo perto: o fantasma tem que
	// atravessar a nave até quem quer salvar, e é esse custo que o impede de cobrir todo mundo.
	bool try_shield_player(uint64 angel_peer, uint64 target_peer, string&out target_name, string&out fail_key) {
		fail_key = "";
		target_name = "";
		game_player@ angel = find_player(angel_peer);
		game_player@ target = find_player(target_peer);
		if (@angel == null) return false;
		if (angel.alive) { fail_key = "role.ability_only_dead"; return false; }
		// Alvo morto ou ele mesmo: some no "ninguém por perto", sem uma recusa própria. Uma mensagem
		// específica para "esse já está morto" diria ao anjo algo que ele talvez não soubesse.
		if (@target == null || !target.alive || target.peer_id == angel.peer_id) { fail_key = "role.shield_no_target"; return false; }
		if (distance_2d(angel.x, angel.y, target.x, target.y) > GUARDIAN_SHIELD_RANGE) { fail_key = "role.shield_no_target"; return false; }

		// Relançar sobre quem já está protegido simplesmente renova - não é erro, e recusar
		// contaria ao anjo que aquela pessoa já está blindada por outro anjo.
		target.shield_remaining = config.role_value(ROLE_GUARDIAN_ANGEL, TUNABLE_DURATION);
		target_name = target.username;
		return true;
	}

	// --- IA dos bots ---
	// Bot vivo faz três coisas: anda até a próxima task dele, "faz" a task parado por alguns
	// segundos, e quando não tem mais task passeia entre as salas. Em reunião ele vota pular depois
	// de um tempinho. Nada disso é esperto de propósito: o objetivo é dar movimento (som de passos,
	// gente aparecendo no radar) e completar tasks pra encher a partida, não jogar bem.
	private void pick_bot_destination(game_player@ b) {
		b.bot_target_object_id = "";
		b.bot_has_target = false;

		// 1) Primeira task pendente dele.
		for (uint i = 0; i < b.tasks.length(); i++) {
			if (b.tasks[i].completed) continue;
			map_object@ spot = map.find_object(b.tasks[i].object_id);
			if (@spot == null) continue;
			b.bot_target_object_id = spot.id;
			b.bot_target_x = spot.x;
			b.bot_target_y = spot.y;
			b.bot_has_target = true;
			break;
		}

		// 2) Sem task pendente (ou é impostor, que não tem task nenhuma): passeia até uma sala
		// sorteada, senão o bot fica plantado no mesmo canto o resto da partida.
		if (!b.bot_has_target) {
			array<map_zone@>@ rooms = map.room_zones();
			if (rooms.length() == 0) return;
			map_zone@ destination = rooms[random(0, int(rooms.length()) - 1)];
			b.bot_target_x = destination.center_x;
			b.bot_target_y = destination.center_y;
			b.bot_has_target = true;
		}

		set_bot_path_to(b, b.bot_target_x, b.bot_target_y);
	}

	// Traça a rota até (x, y) e deixa o bot pronto pra andar.
	private void set_bot_path_to(game_player@ b, float x, float y) {
		string current_zone = map.room_id_at(b.x, b.y);
		b.bot_path = map.zone_path(current_zone, map.room_id_at(x, y));
		// O primeiro waypoint é o centro da PRÓPRIA zona onde o bot está. Sem isso ele saía de onde
		// estivesse (um canto da sala, por exemplo) reto na diagonal até o centro do corredor
		// seguinte, e essa diagonal atravessa a parede: o bot encostava na quina e ficava travado
		// lá pra sempre. Sala e corredor são retângulos, então centro-a-centro (e "qualquer ponto
		// da sala até o centro dela") nunca sai de dentro.
		if (b.bot_path.length() > 0 && current_zone != "") b.bot_path.insert_at(0, current_zone);
	}

	// --- Bot impostor ---
	// Caça o tripulante vivo mais próximo e mata quando dá: dentro do alcance, sem cooldown e sem
	// ninguém por perto pra ver. Também solta uma sabotagem de vez em quando. Não usa vent nem
	// reporta corpo - e não vira "melhor que gente" de propósito, a graça é ele ser um adversário
	// previsível o bastante pra ser descoberto numa reunião.
	private game_player@ nearest_prey(game_player@ hunter) const {
		game_player@ best = null;
		float best_dist = 0.0;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.is_impostor || !p.alive || p.peer_id == hunter.peer_id) continue;
			float dist = distance_2d(hunter.x, hunter.y, p.x, p.y);
			if (@best == null || dist < best_dist) {
				best_dist = dist;
				@best = p;
			}
		}
		return best;
	}

	// Alguém vivo (que não seja o assassino nem a vítima) perto o bastante pra testemunhar.
	private bool kill_has_witness(game_player@ killer, game_player@ victim) const {
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (!p.alive || p.peer_id == killer.peer_id || p.peer_id == victim.peer_id) continue;
			if (distance_2d(killer.x, killer.y, p.x, p.y) <= BOT_KILL_WITNESS_RANGE) return true;
		}
		return false;
	}

	// Devolve false quando não há nada a perseguir neste tick (o bot fica parado).
	private bool update_bot_impostor(game_player@ b, float delta_seconds, array<net_packet@>@ events) {
		game_player@ prey = nearest_prey(b);
		if (@prey == null) return false;

		if (b.can_kill() && distance_2d(b.x, b.y, prey.x, prey.y) <= PLAYER_KILL_RANGE && !kill_has_witness(b, prey)) {
			net_packet@ kill_event;
			if (try_kill(b.peer_id, prey.peer_id, kill_event)) {
				events.insert_last(kill_event);
				b.bot_has_target = false;
				b.bot_action_timer = random_range(BOT_POST_KILL_MIN_SECONDS, BOT_POST_KILL_MAX_SECONDS); // se afasta do corpo
				return false;
			}
		}

		if (config.sabotages_enabled && active_sabotage == "" && sabotage_cooldown_remaining <= 0.0 &&
				random_range(0.0, 1.0) < BOT_SABOTAGE_CHANCE_PER_SECOND * delta_seconds) {
			// Nunca a mesma da vez passada (trigger_sabotage recusaria de qualquer jeito).
			string sabotage_id = last_sabotage_id == "lights" ? "comms" : "lights";
			net_packet@ sabotage_event;
			string fail_key;
			if (trigger_sabotage(b.peer_id, sabotage_id, sabotage_event, fail_key)) events.insert_last(sabotage_event);
		}

		// A presa anda, então o ponto final é atualizado sempre - mas a ROTA só é refeita quando a
		// presa muda de sala. Refazer a rota a cada instante travava o bot: toda rota nova começa
		// pelo centro da zona onde ele está (ver set_bot_path_to), então ele dava dois passos rumo à
		// saída, recalculava, voltava pro centro, e ficava balançando ali pra sempre sem sair da sala.
		b.bot_repath_timer -= delta_seconds;
		string prey_zone = map.room_id_at(prey.x, prey.y);
		b.bot_target_object_id = "";
		b.bot_target_x = prey.x;
		b.bot_target_y = prey.y;
		if (!b.bot_has_target || (b.bot_repath_timer <= 0.0 && prey_zone != b.bot_target_zone)) {
			b.bot_repath_timer = BOT_REPATH_INTERVAL_SECONDS;
			b.bot_target_zone = prey_zone;
			b.bot_has_target = true;
			set_bot_path_to(b, prey.x, prey.y);
		}
		return true;
	}

	// Um passo de movimento. Devolve true se a posição mudou.
	private bool step_bot_towards(game_player@ b, float target_x, float target_y, float delta_seconds) {
		float dx = target_x - b.x;
		float dy = target_y - b.y;
		float dist = sqrt(dx * dx + dy * dy);
		if (dist <= 0.001) return false;
		float step = BOT_MOVE_SPEED * delta_seconds;
		if (step > dist) step = dist;
		float new_x = b.x + dx / dist * step;
		float new_y = b.y + dy / dist * step;
		// Bot fora de qualquer sala/corredor seria exatamente o que o servidor rejeita num jogador
		// de verdade (ver try_move_player). Se acontecer - inclusive por uma porta fechada na cara
		// dele -, o destino é recalculado do zero em vez de empurrar o bot pra dentro da parede.
		if (!map.can_move(b.x, b.y, new_x, new_y, b.alive)) {
			b.bot_has_target = false;
			b.bot_path.resize(0);
			b.bot_action_timer = 1.0;
			return false;
		}
		b.x = new_x;
		b.y = new_y;
		return true;
	}

	private void tick_bots(float delta_seconds, array<net_packet@>@ events) {
		for (uint i = 0; i < players.length(); i++) {
			game_player@ b = players[i];
			if (!b.is_bot || !b.alive) continue; // bot morto vira fantasma parado, sem som nenhum

			if (state == "voting") {
				if (b.bot_voted) continue;
				b.bot_action_timer -= delta_seconds;
				if (b.bot_action_timer > 0.0) continue;
				if (!cast_vote(b.peer_id, -1)) { b.bot_voted = true; continue; }
				b.bot_voted = true;
				net_packet@ cast_pkt = net_packet(S_VOTE_CAST);
				cast_pkt.set_uint64("voter_peer", b.peer_id);
				cast_pkt.set_string("voter_name", b.username);
				events.insert_last(cast_pkt);
				continue;
			}
			if (state != "in_progress") continue;

			if (b.bot_action_timer > 0.0) { // parado fazendo alguma coisa
				b.bot_action_timer -= delta_seconds;
				continue;
			}
			if (b.is_impostor) {
				if (!update_bot_impostor(b, delta_seconds, events)) continue;
			} else if (!b.bot_has_target) {
				pick_bot_destination(b);
				if (!b.bot_has_target) continue;
			}

			// Chegou no destino final: se era uma task, conclui (conta pra vitória dos tripulantes
			// igual a de qualquer jogador) e descansa antes de escolher o próximo destino.
			if (b.bot_path.length() == 0 && distance_2d(b.x, b.y, b.bot_target_x, b.bot_target_y) <= PLAYER_INTERACT_RANGE) {
				if (b.bot_target_object_id != "") {
					// Pelo mesmo caminho dos jogadores de verdade: uma tarefa de várias fases faz o bot
					// AVANÇAR de fase e caminhar até o ponto seguinte, em vez de concluir tudo de uma
					// vez parado no primeiro ponto.
					string next_object_id;
					uint phase;
					if (advance_task(b, b.bot_target_object_id, next_object_id, phase)) {
						events.insert_last(build_task_progress_packet());
						// O destino do bot passa a ser a fase nova; sem isto ele ficaria parado achando
						// que já terminou, e a tarefa nunca sairia do lugar.
						if (next_object_id != "") b.bot_target_object_id = next_object_id;
					}
					b.bot_action_timer = random_range(BOT_TASK_MIN_SECONDS, BOT_TASK_MAX_SECONDS);
				} else if (b.is_impostor) {
					b.bot_repath_timer = 0.0; // chegou onde a presa estava: recalcula na hora, sem pausa
				} else {
					b.bot_action_timer = random_range(BOT_IDLE_MIN_SECONDS, BOT_IDLE_MAX_SECONDS);
				}
				b.bot_has_target = false;
				b.bot_target_object_id = "";
				continue;
			}

			// Próximo waypoint: o centro da próxima zona do caminho, ou o destino em si quando já
			// está na zona certa.
			float waypoint_x = b.bot_target_x;
			float waypoint_y = b.bot_target_y;
			if (b.bot_path.length() > 0) {
				map_zone@ next_zone = map.find_zone(b.bot_path[0]);
				// Só conta como waypoint alcançado quando o bot chega no CENTRO da zona - entrar nela
				// não basta (ver a nota sobre a diagonal em pick_bot_destination).
				if (@next_zone == null || distance_2d(b.x, b.y, next_zone.center_x, next_zone.center_y) <= BOT_WAYPOINT_REACHED_DISTANCE) {
					b.bot_path.remove_at(0);
					continue;
				}
				waypoint_x = next_zone.center_x;
				waypoint_y = next_zone.center_y;
			}

			if (!step_bot_towards(b, waypoint_x, waypoint_y, delta_seconds)) continue;

			b.bot_broadcast_timer -= delta_seconds;
			if (b.bot_broadcast_timer > 0.0) continue;
			b.bot_broadcast_timer = BOT_MOVE_BROADCAST_INTERVAL;
			net_packet@ moved = net_packet(S_PLAYER_MOVED);
			moved.set_uint64("peer_id", b.peer_id);
			moved.set_float("x", b.x);
			moved.set_float("y", b.y);
			events.insert_last(moved);
		}
	}

	// Limpa o estado de PARTIDA de cada jogador. A lobby em si morre junto com a partida (ver
	// tick_lobbies em network/server.nvgt), mas os game_player NÃO morrem: eles são os objetos de
	// CONEXÃO, e a mesma pessoa vai entrar na próxima lobby carregando este objeto.
	//
	// Sem esta limpeza, quem morreu na partida anterior continuava marcado como morto na lobby
	// seguinte - e o servidor recusa mensagem de chat de morto, então a pessoa ficava muda sem
	// entender por quê. O mesmo valia pro papel de impostor, pras tasks e pros cooldowns.
	void reset_players_after_match() {
		for (uint i = 0; i < players.length(); i++) players[i].reset_match_state();
	}

	// Devolve a sala ao estado de espera para a MESMA turma jogar de novo, sem desfazer quem está
	// nela nem as regras que o anfitrião escolheu.
	//
	// Esta lista é o ponto único onde se decide o que pertence à partida que acabou. Um campo
	// esquecido aqui não dá erro nenhum: ele simplesmente atravessa para a partida seguinte e
	// aparece como um bug sem causa visível (um corpo que ninguém matou, uma sabotagem que começa
	// consertada, uma votação que já tem votos). Ao acrescentar estado de partida no game_state,
	// acrescente a limpeza dele aqui também.
	void reopen_for_next_match() {
		reset_players_after_match();
		state = "waiting";
		bodies.resize(0);
		votes.resize(0);
		meeting_timer = 0.0;
		voting_timer = 0.0;
		meeting_caller = 0;
		meeting_reason = "";
		meeting_unvented_peers.resize(0);
		meeting_unshifted_peers.resize(0);
		meeting_doors_opened.resize(0);
		meeting_cooldown_remaining = 0.0;
		doors_cooldown_remaining = 0.0;
		active_sabotage = "";
		last_sabotage_id = "";
		sabotage_timer = 0.0;
		last_sabotage_countdown = -1;
		sabotage_cooldown_remaining = 0.0;
		sabotage_fixed_panels.resize(0);
		oxygen_code = "";
		camera_user_peer = 0;
		camera_room_id = "";
		visible_task_peer = 0;
		visible_task_object_id = "";
		winner = "";
		win_reason = "";
		elapsed_time = 0.0;
		map.open_all_doors();
	}

	// --- Tick: avança timers, retorna eventos que o servidor precisa transmitir. ---
	array<net_packet@>@ tick(float delta_seconds) {
		array<net_packet@> events;
		elapsed_time += delta_seconds;

		for (uint i = 0; i < players.length(); i++) players[i].tick_cooldowns(delta_seconds);
		tick_bots(delta_seconds, events);
		tick_killer_trails();

		if (doors_cooldown_remaining > 0.0) {
			doors_cooldown_remaining -= delta_seconds;
			if (doors_cooldown_remaining < 0.0) doors_cooldown_remaining = 0.0;
		}

		if (meeting_cooldown_remaining > 0.0) {
			meeting_cooldown_remaining -= delta_seconds;
			if (meeting_cooldown_remaining < 0.0) meeting_cooldown_remaining = 0.0;
		}

		if (state == "in_progress") {
			array<string>@ reopened = map.tick_doors(delta_seconds);
			if (reopened.length() > 0) events.insert_last(build_doors_packet(reopened, false));
		}

		if (sabotage_cooldown_remaining > 0.0) {
			sabotage_cooldown_remaining -= delta_seconds;
			if (sabotage_cooldown_remaining < 0.0) sabotage_cooldown_remaining = 0.0;
		}

		// O relógio da sabotagem só corre com a partida realmente rolando: durante uma reunião todo
		// mundo está congelado na cafeteria e ninguém CONSEGUE consertar painel nenhum, então deixar
		// ele correndo fazia o oxigênio acabar (e os impostores ganharem) no meio da votação, e a
		// sabotagem de luzes expirar sem ninguém ter chance de fazer nada.
		// Só sabotagem crítica tem relógio, e ele só corre com a partida rolando de verdade: durante
		// uma reunião todo mundo está congelado na cafeteria e ninguém CONSEGUE chegar num painel.
		// Luzes e comunicações não têm relógio nenhum - ficam de pé até alguém consertar, que é o que
		// dá peso a elas (antes as luzes se resolviam sozinhas em 40s e viravam só um susto).
		if (active_sabotage != "" && is_critical_sabotage(active_sabotage) && state == "in_progress") {
			sabotage_timer -= delta_seconds;

			// Lembretes do relógio. Sem eles a sabotagem crítica era um silêncio de 90 segundos:
			// o jogador ouvia o alarme no começo, corria pro painel e não fazia ideia se ainda dava
			// tempo de tentar o segundo painel ou se já era. Num jogo sem tela, não existe um número
			// no canto pra conferir - ou o jogo fala, ou a informação não existe.
			//
			// Arredonda pra CIMA: com 29,4 segundos restantes o certo é dizer "30", porque dizer "29"
			// faria o aviso de 30 nunca acontecer em alguns ticks e a contagem pular números.
			int seconds_left = int(sabotage_timer + 0.999);
			if (seconds_left != last_sabotage_countdown && seconds_left > 0) {
				// Nos 10 segundos finais é um por um: é a contagem que cria a urgência e diz, sem
				// margem de dúvida, que não dá mais tempo de ir pro outro painel. Antes disso, marcos
				// de 30 em 30 - avisar de 10 em 10 durante um minuto e meio viraria ruído e atrapalharia
				// quem está tentando ouvir passos.
				bool is_final = seconds_left <= SABOTAGE_FINAL_COUNTDOWN_SECONDS;
				if (is_final || seconds_left % SABOTAGE_REMINDER_INTERVAL_SECONDS == 0) {
					last_sabotage_countdown = seconds_left;
					net_packet@ countdown = net_packet(S_SABOTAGE_COUNTDOWN);
					countdown.set_string("sabotage_id", active_sabotage);
					countdown.set_int("seconds", seconds_left);
					countdown.set_bool("final", is_final);
					events.insert_last(countdown);
				}
			}

			if (sabotage_timer <= 0.0) {
				winner = "impostors";
				win_reason = "oxygen_depleted";
				active_sabotage = "";
				sabotage_fixed_panels.resize(0);
				sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
			}
		}

		// "meeting" não existe mais como fase separada - start_meeting() já deixa o estado em
		// "voting" direto (ver lá). Só falta contar o tempo até acabar ou até todo mundo votar.
		if (state == "voting") {
			voting_timer -= delta_seconds;
			if (voting_timer <= 0.0 || all_alive_voted()) {
				events.insert_last(tally_votes());
			}
		}

		if (winner == "") {
			if (alive_impostor_count() == 0) { winner = "crewmates"; win_reason = "impostors_ejected"; }
			else if (alive_impostor_count() >= alive_crewmate_count()) { winner = "impostors"; win_reason = "majority"; }
			else {
				bool all_done = true;
				for (uint i = 0; i < players.length(); i++) {
					if (!counts_for_task_win(players[i])) continue;
					if (!players[i].all_tasks_completed()) { all_done = false; break; }
				}
				if (all_done && players.length() > 0) { winner = "crewmates"; win_reason = "tasks_completed"; }
			}
		}

		if (winner != "" && state != "ended") {
			state = "ended";
			uint crewmates_total = 0;
			uint impostors_total = 0;
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].is_impostor) impostors_total++;
				else crewmates_total++;
			}
			net_packet@ go = net_packet(S_GAME_OVER);
			go.set_string("winner", winner);
			go.set_string("reason", win_reason);
			go.set_int("crewmates_alive", int(alive_crewmate_count()));
			go.set_int("crewmates_total", int(crewmates_total));
			go.set_int("impostors_alive", int(alive_impostor_count()));
			go.set_int("impostors_total", int(impostors_total));
			// Quem era impostor, agora que a partida acabou: é o fechamento da história pra todo mundo
			// que passou a partida inteira desconfiando da pessoa errada.
			json_array@ impostor_names = json_array();
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].is_impostor) impostor_names.add(players[i].username);
			}
			go.set_array("impostors", impostor_names);
			events.insert_last(go);
			// A lobby não volta pra sala de espera: ela ACABA aqui. Quem faz o enterro é o servidor,
			// assim que terminar de transmitir este pacote (ver tick_lobbies).
		}

		return events;
	}
}
