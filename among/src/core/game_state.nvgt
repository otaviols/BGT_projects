// game_state.nvgt
// Estado autoritativo de uma partida em andamento: jogadores, mapa, corpos, sabotagens,
// reuniões/votação e condição de vitória. Não conhece a camada de rede diretamente - produz
// net_packet@ para o servidor transmitir aos clientes da lobby.

#include "../config/game_constants.nvgt"
#include "../config/lobby_config.nvgt"
#include "../game/map.nvgt"
#include "player.nvgt"
// A regra de quem é atrapalhado por qual sabotagem mora num lugar só, e o servidor também pergunta
// a ela (can_hear_voice): quem percebe quem se decide aqui, não no cliente.
#include "sabotage_rules.nvgt"
#include "../network/protocol.nvgt"
#include "../network/packet.nvgt"
// O game_state mora em vários arquivos (src/core/game_state/), um por assunto - ver o topo de cada um.
#include "game_state/state_kill.nvgt"
#include "game_state/state_meeting.nvgt"
#include "game_state/state_ship.nvgt"
#include "game_state/state_tasks.nvgt"
#include "game_state/state_roles.nvgt"
#include "game_state/state_bots.nvgt"

class body_info {
	string id;
	uint64 victim_peer_id;
	float x, y;
	string room_id;

	// --- O que o detetive lê no corpo (ver try_examine_body) ---
	// Quando a pessoa morreu, no relógio da partida. Vira "há quanto tempo" na hora do exame.
	float death_time = 0.0;
	// Por onde o assassino passou nos segundos seguintes à morte, em ordem, sem repetir sala
	// seguida. É o rastro FRIO: ele para de crescer depois de KILLER_TRAIL_SECONDS, e é isso que
	// faz a informação do detetive virar testemunho (uma frase que ainda vale na reunião) em vez de
	// caçada (uma direção que apodrece em dez segundos).
	array<string> killer_trail;
	uint64 killer_peer_id = 0;   // só para gravar o rastro; NUNCA sai daqui
	float trail_until = 0.0;     // até quando gravar, no relógio da partida
	bool examined = false;       // um exame por corpo: cada corpo é uma pista, não uma consulta
}

class vote_entry {
	uint64 voter_peer_id;
	int64 target_peer_id; // -1 = pular voto
}

// Uma ação que um BOT pede - consertar um painel, reportar um corpo - e que o servidor executa pelo
// MESMO tratador de um jogador (on_interact, on_report_body; ver tick_lobbies). O bot não faz a ação
// aqui dentro de propósito: o que ela dispara na rede (avisos de painel, reunião, câmeras, portas,
// scanner) mora no servidor, e um segundo caminho só para bot esqueceria metade - foi exatamente o
// que aconteceu com a morte por bot, que pulava câmera, scanner e o alarme do alarmista.
const string BOT_REQUEST_FIX_PANEL = "fix_panel";
const string BOT_REQUEST_REPORT = "report";
class bot_request {
	string kind;
	uint64 peer_id;
	string object_id;
	bot_request() {}
	bot_request(const string&in kind, uint64 peer_id, const string&in object_id = "") {
		this.kind = kind;
		this.peer_id = peer_id;
		this.object_id = object_id;
	}
}

// O vencedor quando é um NEUTRO sozinho (ver neutral_winner_peer e role_traits.solo_win).
const string WINNER_NEUTRAL = "neutral";

class game_state : state_kill_part, state_meeting_part, state_ship_part, state_tasks_part, state_roles_part, state_bots_part {
	string lobby_id;
	// Pedidos dos bots neste tick; o servidor os executa e esvazia a lista (ver bot_request).
	array<bot_request@> bot_requests;
	string lobby_name;
	// Vazio = partida pública. Com código, ela some da lista e só entra quem o digitar. A comparação
	// ignora maiúsculas: o código é ditado de viva voz entre amigos, e "Abc" e "abc" soam iguais.
	string join_code = "";
	bool is_private() const { return join_code != ""; }
	uint64 host_peer_id;
	lobby_config@ config;
	game_map@ map;
	array<game_player@> players;
	// Quem ASSISTE a partida. Uma lista à parte, e não jogadores marcados: toda a lógica do jogo -
	// votos, kill, vitória, tarefas, papéis - procura em `players`, então um espectador não tem como
	// influenciar nada por acidente. O que ele recebe é escolhido no servidor, caso a caso.
	array<game_player@> spectators;
	array<body_info> bodies;
	// Corpos nas mãos de um carregador: fora de `bodies` (não se reporta, não se examina, não faz
	// som) até ele largar. Duas listas paralelas: quem carrega e o quê.
	array<uint64> carrier_peers;
	array<body_info@> carried_bodies;
	// A troca do trocador nesta reunião (0 = nenhuma). Uma por reunião; zerada ao começar a próxima.
	uint64 swap_a = 0;
	uint64 swap_b = 0;
	array<vote_entry> votes;

	string state = "waiting"; // waiting | in_progress | meeting | voting | ended
	float meeting_timer = 0.0;
	float voting_timer = 0.0;
	uint64 meeting_caller = 0;
	string meeting_reason = ""; // "body" | "button"
	// Quem estava escondido num vent quando a última reunião começou. O servidor precisa avisar
	// essas pessoas de que elas saíram do vent (ver broadcast_meeting_and_voting).
	array<uint64> meeting_unvented_peers;
	// Quem estava disfarçado quando a reunião começou: a fantasia cai, e essas pessoas precisam ser
	// avisadas - senão o shapeshifter volta da votação achando que ainda está fantasiado.
	array<uint64> meeting_unshifted_peers;
	array<string> meeting_doors_opened; // portas que a reunião abriu, pra avisar os clientes

	// Recarga do botão de emergência depois de uma reunião. Sem ela, o botão podia ser apertado de
	// novo no instante em que a votação terminava, com todo mundo ainda parado na cafeteria.
	float meeting_cooldown_remaining = 0.0;
	float doors_cooldown_remaining = 0.0; // recarga da ação de fechar portas (separada da sabotagem)
	string active_sabotage = ""; // "" | "lights" | "oxygen" | "comms"
	string last_sabotage_id = ""; // pra não deixar repetir a mesma sabotagem duas vezes seguidas
	float sabotage_timer = 0.0;
	// Último número já anunciado da contagem regressiva, para não repetir o mesmo segundo em ticks
	// seguidos (o laço roda dezenas de vezes por segundo). -1 = nada anunciado ainda nesta sabotagem.
	int last_sabotage_countdown = -1;
	float sabotage_cooldown_remaining = 0.0;
	array<string> sabotage_fixed_panels;

	// --- Câmeras de segurança ---
	// Quem está no posto agora (0 = livre) e para qual sala ele aponta.
	//
	// O posto é de UM de cada vez, e quem arbitra é o servidor: dois jogadores apertando Enter no
	// mesmo instante não têm como se acertar sozinhos, e o cliente não sabe que outro já entrou.
	uint64 camera_user_peer = 0;
	string camera_room_id = "";

	// Quem está numa task VISÍVEL agora (o scan da enfermaria), e em qual ponto. 0 = ninguém.
	// Um de cada vez basta: só existe um scanner na nave.
	uint64 visible_task_peer = 0;
	string visible_task_object_id = "";

	// Código do oxigênio desta sabotagem. Decidido aqui, uma vez, para ser o MESMO nos dois painéis:
	// quem ouviu num painel pode ditar para quem está no outro.
	string oxygen_code = "";

	string winner = ""; // "" | "crewmates" | "impostors" | WINNER_NEUTRAL
	string win_reason = "";
	// Quem venceu SOZINHO quando o vencedor é um neutro (o Bobo expulso). 0 = nenhum.
	uint64 neutral_winner_peer = 0;
	float elapsed_time = 0.0;

	// Pacotes que nascem FORA do tick (uma morte pedida por um jogador, por exemplo) e que o tick
	// entrega junto dos dele, no ponto certo da ordem. Hoje só a volta de quem estava na barriga do
	// lobo: ela pode vir de um assassinato, de um palpite, da apuração ou de uma saída, e numa fila só
	// a entrega é uma só - depois do resultado da votação e antes da conferência de vitória.
	array<net_packet@> pending_events;

	// Quem OCUPA VAGA na sala: todo mundo menos quem marcou "vou assistir" na sala de espera. É esta
	// conta, e não players.length(), que a lotação e o teto de bots usam - quem só assiste não tira a
	// vaga de ninguém (pedido do usuário). Os espectadores têm o teto deles, MAX_SPECTATORS.
	uint seated_count() const {
		uint n = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (!(players[i].wants_to_spectate && !players[i].is_bot)) n++;
		}
		return n;
	}
	uint marked_spectator_count() const { return players.length() - seated_count(); }

	uint bot_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].is_bot) count++;
		}
		return count;
	}

	uint human_count() const {
		return players.length() - bot_count();
	}

	game_player@ find_player(uint64 peer_id) const {
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].peer_id == peer_id) return players[i];
		}
		return null;
	}

	array<game_player@>@ alive_players() const {
		array<game_player@> result;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive) result.insert_last(players[i]);
		}
		return result;
	}

	uint alive_crewmate_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && !players[i].is_impostor) count++;
		}
		return count;
	}

	uint alive_impostor_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && players[i].is_impostor) count++;
		}
		return count;
	}

	// Jogadores no mesmo cômodo/corredor que peer_id, vivos, não escondidos em vent - usado pelo radar.
	array<game_player@>@ players_in_same_room(uint64 peer_id) const {
		game_player@ me = find_player(peer_id);
		if (@me == null) return array<game_player@>();
		return players_in_room(map.room_id_at(me.x, me.y), peer_id);
	}

	// Quem está numa sala e pode ser percebido: vivo, fora de duto, visível, e não é quem está
	// perguntando.
	//
	// A regra mora aqui e não em cada lugar que precisa dela. O radar e a câmera de segurança são
	// duas perguntas diferentes sobre a MESMA coisa, e enquanto a câmera respondia sozinha, do lado
	// do cliente, ela contava quem estava escondido dentro de um duto - entregando de graça a
	// dedução que o duto existe para negar.
	array<game_player@>@ players_in_room(const string&in room_id, uint64 except_peer) const {
		array<game_player@> result;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.peer_id == except_peer || !is_perceptible(p)) continue;
			if (map.room_id_at(p.x, p.y) == room_id) result.insert_last(p);
		}
		return result;
	}

	// Pode ser percebido por outro jogador: vivo (o engolido tem alive = false), fora de duto e visível.
	// `invisible()` entra ao lado de `vented` porque é a mesma ideia: presente, mas imperceptível. A regra
	// mora aqui para o radar, a câmera e a lista de quem está perto (players_near) concordarem de graça.
	bool is_perceptible(game_player@ p) const {
		return p.alive && !p.vented && !p.invisible();
	}

	// Quem é perceptível a até `range` de `me`, sem ele. É a lista que o servidor manda a cada jogador em
	// S_NEARBY_PLAYERS.
	array<uint64>@ players_near(game_player@ me, float range) const {
		array<uint64> result;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.peer_id == me.peer_id || !is_perceptible(p)) continue;
			if (distance_2d(me.x, me.y, p.x, p.y) <= range) result.insert_last(p.peer_id);
		}
		return result;
	}

	// Move validado usando o relógio interno da partida (elapsed_time) para calcular o delta desde
	// o último movimento aceito deste jogador - evita depender de relógio de rede não confiável.
	// Jogador morto (morto ou expulso) PODE se mover - vira fantasma, como no Among Us original -
	// quem trata a visibilidade/silêncio disso é on_move() (só retransmite pra outros mortos).
	bool try_move_player(uint64 peer_id, float x, float y) {
		game_player@ p = find_player(peer_id);
		if (@p == null) return false;
		if (state != "in_progress") return false; // movimento travado durante reunião/votação
		if (p.vented) return false; // escondido num vent - só sai/viaja pela rede (ver on_vent_travel)
		if (p.swallowed()) return false; // na barriga do lobo: vai aonde ele for, não anda sozinho
		// Pega-pega: o pegador fica parado no começo (TAG_HEAD_START_SECONDS), com contagem para todos.
		if (in_tag_head_start() && p.is_impostor) return false;
		// De onde ele está pra onde quer ir: parede barra sempre, porta fechada só barra quem está do
		// lado de fora dela (ver game_map.can_move).
		if (!map.can_move(p.x, p.y, x, y, p.alive)) return false;
		float delta = elapsed_time - p.last_move_time;
		if (delta <= 0.0) delta = 1.0 / NETWORK_TICKS_PER_SECOND;
		bool ok = p.try_move(x, y, delta, config.move_speed() * p.speed_multiplier());
		// SÓ avança o relógio de referência quando o movimento é ACEITO. Antes avançava sempre,
		// mesmo numa rejeição - aí a janela de tempo pro próximo pacote ficava minúscula (só o
		// intervalo entre pacotes, não desde a última posição CONFIRMADA), enquanto o cliente
		// continuava andando localmente e se afastando cada vez mais da posição travada no servidor.
		// Resultado: depois de UM pacote rejeitado (ex.: um soluço de rede), o jogador ficava preso
		// pro resto da partida sem NUNCA mais conseguir um movimento aceito - exatamente o que
		// "curava" ao entrar numa reunião, porque lá a posição de todo mundo é resincronizada à
		// força (ver start_meeting).
		if (ok) p.last_move_time = elapsed_time;
		return ok;
	}

	// --- Lobo Mau ---

	// Pega-pega nos primeiros segundos: o pegador ainda está parado.
	bool in_tag_head_start() const {
		return config.game_mode == GAME_MODE_TAG && elapsed_time < TAG_HEAD_START_SECONDS;
	}

	game_player@ find_spectator(uint64 peer_id) const {
		for (uint i = 0; i < spectators.length(); i++) if (spectators[i].peer_id == peer_id) return spectators[i];
		return null;
	}

	// O espectador ouve a voz de `talker`? Como quem está ao lado de quem ele acompanha: andando, a
	// voz que chega até essa pessoa; na reunião, a mesa inteira (a mesma regra que a barriga do lobo
	// ganhou). Fantasma e barriga nunca: o espectador assiste a partida dos vivos. E as comunicações
	// sabotadas calam para ele o que calam para todos.
	bool spectator_hears(game_player@ talker, game_player@ spec) const {
		if (@talker == null || @spec == null) return false;
		if (state == "waiting" || state == "ended") return true;
		if (!talker.alive) return false;
		bool reuniao = state == "meeting" || state == "voting";
		if (voice_down_for(active_sabotage, true, reuniao, config.comms_affects_meeting)) return false;
		if (reuniao) return true;
		game_player@ alvo = find_player(spec.follow_peer);
		if (@alvo == null) return false;
		return distance_2d(talker.x, talker.y, alvo.x, alvo.y) <= VOICE_RANGE;
	}

	uint alive_count() const {
		uint n = 0;
		for (uint i = 0; i < players.length(); i++) if (players[i].alive) n++;
		return n;
	}

	// Ameaças vivas que não são impostores (o lobo). Ver role_traits.hostile_to_crew.
	uint alive_hostile_count() const {
		uint n = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && players[i].role().hostile_to_crew) n++;
		}
		return n;
	}

	// O neutro que venceu por sobrar (SOLO_WIN_LAST_STANDING): vivo, com a nave reduzida a ele e no
	// máximo mais um. null = ninguém.
	game_player@ last_standing_winner() const {
		if (alive_count() > 2) return null;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && players[i].role().solo_win == SOLO_WIN_LAST_STANDING) return players[i];
		}
		return null;
	}

	// Quem ouve a voz de quem. É a regra de percepção do chat de voz, e mora aqui pelo mesmo motivo
	// de players_in_room(): o cliente não sabe quem está morto de verdade nem quem está num duto, e
	// entregar voz é entregar posição - uma voz posicionada denuncia onde a pessoa está.
	//
	// - Na sala de espera todo mundo se ouve, sem posição: é o bate-papo antes da partida.
	// - Na reunião e na votação todos os vivos se ouvem: é a discussão, e todos estão no mesmo lugar.
	// - Andando pela nave, a voz alcança VOICE_RANGE - a mesma sala, não a nave inteira - e quem
	//   está dentro de um duto não é ouvido por fora (ver on_voice_frame no servidor).
	// - Fantasma ouve todo mundo e só é ouvido por fantasma: o morto continua acompanhando a partida
	//   (como no jogo original) mas não pode contar aos vivos quem o matou.
	bool can_hear_voice(game_player@ talker, game_player@ listener) const {
		if (@talker == null || @listener == null) return false;
		if (state == "waiting" || state == "ended") return true;
		// A BARRIGA DO LOBO vem antes de tudo, porque é a única regra que atravessa todas as outras:
		// quem está lá dentro fala com o lobo e com os outros engolidos, e só - sem distância, sem
		// sabotagem, e sem os fantasmas (a regra de baixo daria a eles a voz dos engolidos, e aos
		// engolidos a dos mortos). O lobo ouve a barriga sempre; é a graça do papel.
		// Na REUNIÃO, quem está na barriga ouve a mesa (decisão do usuário: ficar surdo à discussão
		// inteira tirava o engolido do jogo justo na hora que mais importa). Só ouve: a voz dele
		// continua chegando apenas ao lobo e aos outros engolidos, pela regra logo abaixo. As
		// comunicações sabotadas valem como para a mesa - quem não é ouvido nela não é ouvido aqui.
		bool reuniao = state == "meeting" || state == "voting";
		if (reuniao && listener.swallowed() && !talker.swallowed() && talker.alive) {
			return !voice_down_for(active_sabotage, talker.alive, true, config.comms_affects_meeting);
		}
		if (talker.swallowed() || listener.swallowed()) return in_same_belly(talker, listener);
		if (!talker.alive) return !listener.alive;
		if (!listener.alive) return true;
		// Comunicações sabotadas derrubam o rádio de todos os vivos, impostor incluído; na reunião,
		// só se a sala tiver escolhido isso. Toda essa decisão está em voice_down_for, para o cliente
		// poder tomar exatamente a mesma.
		bool in_meeting = state == "meeting" || state == "voting";
		if (voice_down_for(active_sabotage, talker.alive, in_meeting, config.comms_affects_meeting)) return false;
		if (voice_down_for(active_sabotage, listener.alive, in_meeting, config.comms_affects_meeting)) return false;
		if (in_meeting) return true; // na reunião todo mundo está no mesmo lugar: sem distância
		return distance_2d(talker.x, talker.y, listener.x, listener.y) <= VOICE_RANGE;
	}

	// Limpa o estado de PARTIDA de cada jogador. A lobby em si morre junto com a partida (ver
	// tick_lobbies em network/server.nvgt), mas os game_player NÃO morrem: eles são os objetos de
	// CONEXÃO, e a mesma pessoa vai entrar na próxima lobby carregando este objeto.
	//
	// Sem esta limpeza, quem morreu na partida anterior continuava marcado como morto na lobby
	// seguinte - e o servidor recusa mensagem de chat de morto, então a pessoa ficava muda sem
	// entender por quê. O mesmo valia pro papel de impostor, pras tasks e pros cooldowns.
	void reset_players_after_match() {
		for (uint i = 0; i < players.length(); i++) players[i].reset_match_state();
	}

	// Devolve a sala ao estado de espera para a MESMA turma jogar de novo, sem desfazer quem está
	// nela nem as regras que o anfitrião escolheu.
	//
	// Esta lista é o ponto único onde se decide o que pertence à partida que acabou. Um campo
	// esquecido aqui não dá erro nenhum: ele simplesmente atravessa para a partida seguinte e
	// aparece como um bug sem causa visível (um corpo que ninguém matou, uma sabotagem que começa
	// consertada, uma votação que já tem votos). Ao acrescentar estado de partida no game_state,
	// acrescente a limpeza dele aqui também.
	void reopen_for_next_match() {
		reset_players_after_match();
		state = "waiting";
		bodies.resize(0);
		carrier_peers.resize(0);
		carried_bodies.resize(0);
		swap_a = 0;
		swap_b = 0;
		votes.resize(0);
		meeting_timer = 0.0;
		voting_timer = 0.0;
		meeting_caller = 0;
		meeting_reason = "";
		meeting_unvented_peers.resize(0);
		meeting_unshifted_peers.resize(0);
		meeting_doors_opened.resize(0);
		meeting_cooldown_remaining = 0.0;
		doors_cooldown_remaining = 0.0;
		active_sabotage = "";
		last_sabotage_id = "";
		sabotage_timer = 0.0;
		last_sabotage_countdown = -1;
		sabotage_cooldown_remaining = 0.0;
		sabotage_fixed_panels.resize(0);
		oxygen_code = "";
		camera_user_peer = 0;
		camera_room_id = "";
		visible_task_peer = 0;
		visible_task_object_id = "";
		winner = "";
		neutral_winner_peer = 0;
		win_reason = "";
		elapsed_time = 0.0;
		pending_events.resize(0);
		map.open_all_doors();
	}

	// --- Tick: avança timers, retorna eventos que o servidor precisa transmitir. ---
	array<net_packet@>@ tick(float delta_seconds) {
		array<net_packet@> events;
		elapsed_time += delta_seconds;

		bool em_reuniao = state != "in_progress";
		for (uint i = 0; i < players.length(); i++) players[i].tick_cooldowns(delta_seconds, em_reuniao);
		tick_bots(delta_seconds, events);
		follow_wolves();
		tick_killer_trails();

		if (doors_cooldown_remaining > 0.0) {
			doors_cooldown_remaining -= delta_seconds;
			if (doors_cooldown_remaining < 0.0) doors_cooldown_remaining = 0.0;
		}

		if (meeting_cooldown_remaining > 0.0) {
			meeting_cooldown_remaining -= delta_seconds;
			if (meeting_cooldown_remaining < 0.0) meeting_cooldown_remaining = 0.0;
		}

		if (state == "in_progress") {
			array<string>@ reopened = map.tick_doors(delta_seconds);
			if (reopened.length() > 0) events.insert_last(build_doors_packet(reopened, false));
		}

		if (sabotage_cooldown_remaining > 0.0) {
			sabotage_cooldown_remaining -= delta_seconds;
			if (sabotage_cooldown_remaining < 0.0) sabotage_cooldown_remaining = 0.0;
		}

		// O relógio da sabotagem só corre com a partida realmente rolando: durante uma reunião todo
		// mundo está congelado na cafeteria e ninguém CONSEGUE consertar painel nenhum, então deixar
		// ele correndo fazia o oxigênio acabar (e os impostores ganharem) no meio da votação, e a
		// sabotagem de luzes expirar sem ninguém ter chance de fazer nada.
		// Só sabotagem crítica tem relógio, e ele só corre com a partida rolando de verdade: durante
		// uma reunião todo mundo está congelado na cafeteria e ninguém CONSEGUE chegar num painel.
		// Luzes e comunicações não têm relógio nenhum - ficam de pé até alguém consertar, que é o que
		// dá peso a elas (antes as luzes se resolviam sozinhas em 40s e viravam só um susto).
		if (active_sabotage != "" && is_critical_sabotage(active_sabotage) && state == "in_progress") {
			sabotage_timer -= delta_seconds;

			// Lembretes do relógio. Sem eles a sabotagem crítica era um silêncio de 90 segundos:
			// o jogador ouvia o alarme no começo, corria pro painel e não fazia ideia se ainda dava
			// tempo de tentar o segundo painel ou se já era. Num jogo sem tela, não existe um número
			// no canto pra conferir - ou o jogo fala, ou a informação não existe.
			//
			// Arredonda pra CIMA: com 29,4 segundos restantes o certo é dizer "30", porque dizer "29"
			// faria o aviso de 30 nunca acontecer em alguns ticks e a contagem pular números.
			int seconds_left = int(sabotage_timer + 0.999);
			if (seconds_left != last_sabotage_countdown && seconds_left > 0) {
				// Nos 10 segundos finais é um por um: é a contagem que cria a urgência e diz, sem
				// margem de dúvida, que não dá mais tempo de ir pro outro painel. Antes disso, marcos
				// de 30 em 30 - avisar de 10 em 10 durante um minuto e meio viraria ruído e atrapalharia
				// quem está tentando ouvir passos.
				bool is_final = seconds_left <= SABOTAGE_FINAL_COUNTDOWN_SECONDS;
				if (is_final || seconds_left % SABOTAGE_REMINDER_INTERVAL_SECONDS == 0) {
					last_sabotage_countdown = seconds_left;
					net_packet@ countdown = net_packet(S_SABOTAGE_COUNTDOWN);
					countdown.set_string("sabotage_id", active_sabotage);
					countdown.set_int("seconds", seconds_left);
					countdown.set_bool("final", is_final);
					events.insert_last(countdown);
				}
			}

			if (sabotage_timer <= 0.0) {
				winner = "impostors";
				win_reason = "oxygen_depleted";
				active_sabotage = "";
				sabotage_fixed_panels.resize(0);
				sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
			}
		}

		// "meeting" não existe mais como fase separada - start_meeting() já deixa o estado em
		// "voting" direto (ver lá). Só falta contar o tempo até acabar ou até todo mundo votar.
		if (state == "voting") {
			voting_timer -= delta_seconds;
			if (voting_timer <= 0.0 || all_alive_voted()) {
				events.insert_last(tally_votes());
			}
		}

		// Quem voltou da barriga neste tick (ou desde o último): antes da conferência de vitória, e
		// depois do resultado da votação - o cliente precisa ouvir a expulsão do lobo e SÓ ENTÃO a volta.
		for (uint i = 0; i < pending_events.length(); i++) events.insert_last(pending_events[i]);
		pending_events.resize(0);

		if (winner == "" && config.game_mode == GAME_MODE_WOLVES) {
			// Todos lobos: vence o ÚLTIMO de pé (decisão do usuário). Sem tarefa, sem maioria - só sobrar.
			if (alive_count() <= 1) {
				winner = WINNER_NEUTRAL;
				win_reason = "last_wolf";
				for (uint i = 0; i < players.length(); i++) if (players[i].alive) neutral_winner_peer = players[i].peer_id;
			}
		} else if (winner == "" && config.game_mode == GAME_MODE_TAG) {
			// Pega-pega: o pegador vence pegando TODO mundo (não por maioria - um contra um ainda é pega),
			// a tripulação vence completando as tarefas. Pegador que saiu entrega a partida.
			if (alive_impostor_count() == 0) { winner = "crewmates"; win_reason = "impostors_ejected"; }
			else if (alive_crewmate_count() == 0) { winner = "impostors"; win_reason = "all_caught"; }
			else if (crew_tasks_done()) { winner = "crewmates"; win_reason = "tasks_completed"; }
		} else if (winner == "") {
			// O lobo PRIMEIRO: sobrar com a nave reduzida a ele e mais um é a vitória dele, mesmo que o
			// outro seja um impostor - pela regra de baixo, um impostor e um lobo dariam a maioria ao
			// impostor, e o lobo nunca venceria.
			game_player@ sobrevivente = last_standing_winner();
			// O casal que sobra (os dois e mais um) vence junto - antes da maioria, senão um impostor
			// apaixonado e o terceiro dariam a vitória aos impostores.
			if (lovers_win_now()) {
				winner = WINNER_LOVERS;
				win_reason = "lovers_survived";
			}
			else if (@sobrevivente != null) {
				winner = WINNER_NEUTRAL;
				win_reason = "wolf_survived";
				neutral_winner_peer = sobrevivente.peer_id;
			}
			// Sem impostor vivo a tripulação vence - MAS não com uma ameaça viva: tirar os impostores
			// com o lobo ainda comendo gente não é vitória (hostile_to_crew).
			else if (alive_impostor_count() == 0 && alive_hostile_count() == 0) { winner = "crewmates"; win_reason = "impostors_ejected"; }
			// A maioria NÃO vale com gente na barriga do lobo: engolido não morreu, e o impostor precisa
			// derrubar o lobo para eles voltarem - a mesma exigência que a tripulação já tem com o lobo vivo
			// (recado #162: o lobo engolia a tripulação inteira e entregava a vitória aos impostores). De
			// barriga vazia, a maioria vale como sempre. Decisão do usuário, contra "lobo vivo bloqueia
			// sempre" (o Town of Us), que deixaria o impostor sem vencer com o lobo só andando pela nave.
			else if (alive_impostor_count() >= alive_crewmate_count() && !anyone_in_belly()) { winner = "impostors"; win_reason = "majority"; }
			else {
				bool all_done = true;
				for (uint i = 0; i < players.length(); i++) {
					if (!counts_for_task_win(players[i])) continue;
					if (!players[i].all_tasks_completed()) { all_done = false; break; }
				}
				if (all_done && players.length() > 0) { winner = "crewmates"; win_reason = "tasks_completed"; }
			}
		}

		if (winner != "" && state != "ended") {
			state = "ended";
			uint crewmates_total = 0;
			uint impostors_total = 0;
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].is_impostor) impostors_total++;
				else crewmates_total++;
			}
			net_packet@ go = net_packet(S_GAME_OVER);
			go.set_string("winner", winner);
			go.set_string("reason", win_reason);
			go.set_int("crewmates_alive", int(alive_crewmate_count()));
			go.set_int("crewmates_total", int(crewmates_total));
			go.set_int("impostors_alive", int(alive_impostor_count()));
			go.set_int("impostors_total", int(impostors_total));
			// Quem era impostor, agora que a partida acabou: é o fechamento da história pra todo mundo
			// que passou a partida inteira desconfiando da pessoa errada.
			json_array@ impostor_names = json_array();
			for (uint i = 0; i < players.length(); i++) {
				// No modo cor, o fim é onde a cor ganha nome de volta: "Fulano (Vermelho)". Sem isto
				// a partida inteira terminaria sem ninguém saber quem era o vermelho.
				if (!players[i].is_impostor) continue;
				impostor_names.add(players[i].named_by_color
					? players[i].username + " (" + players[i].public_name() + ")"
					: players[i].username);
			}
			go.set_array("impostors", impostor_names);
			// E quem era NEUTRO, com o papel: o mesmo fechamento da história. Um Bobo que ninguém soube
			// que existia faria da partida inteira uma charada sem resposta.
			json_array@ neutros = json_array();
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].role().team != TEAM_NEUTRAL) continue;
				json_object@ n = json_object();
				n.set("name", players[i].named_by_color
					? players[i].username + " (" + players[i].public_name() + ")"
					: players[i].username);
				n.set("role", players[i].role_id);
				n.set("won", players[i].peer_id == neutral_winner_peer);
				neutros.add(n);
			}
			go.set_array("neutrals", neutros);
			// O casal, revelado no fim como os neutros (e o vencedor, se foi ele).
			json_array@ casais = json_array();
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].lover == 0 || players[i].lover < players[i].peer_id) continue;
				game_player@ par = find_player(players[i].lover);
				if (@par == null) continue;
				json_object@ c = json_object();
				c.set("a", players[i].username);
				c.set("b", par.username);
				casais.add(c);
			}
			go.set_array("lovers", casais);
			events.insert_last(go);
			// A lobby não volta pra sala de espera: ela ACABA aqui. Quem faz o enterro é o servidor,
			// assim que terminar de transmitir este pacote (ver tick_lobbies).
		}

		return events;
	}
}
