// client_state.nvgt
// Espelho local (client-side) do elenco de jogadores da partida atual: nomes, cores e quem está
// vivo. Alimentado pelos pacotes S_GAME_START/S_PLAYER_KILLED/S_VOTE_RESULT/S_PLAYER_LEFT.
// Usado pela UI (radar já resolve nomes via servidor, mas votação/anúncios precisam de uma lista
// local de "quem está na partida" para montar o menu de votação).

#include "../network/packet.nvgt"
#include "../config/game_constants.nvgt"
#include "../i18n.nvgt" // spoken_name

class roster_entry {
	uint64 peer_id;
	string name;
	int color;
	bool alive = true;
	float x = 0.0;
	float y = 0.0;
	float step_distance = 0.0; // quanto andou desde o último passo tocado (ver walk_to)
	uint64 heard_at = 0;       // ticks() do último passo dele que TOCOU para mim (o mapa na tela - ver ui/visual_map.nvgt)

	// Andou de onde estava até (nx, ny): soma ao passo e diz se completou um. Chame ANTES de gravar a
	// posição nova. O passo soa a cada PASSO ANDADO, e não a cada tanto tempo: o ritmo é o da pessoa -
	// o Flash apressado, o Gigante arrastado, o pega-pega na velocidade da sala.
	//
	// Uma função só para a partida e para quem assiste: o espectador tinha a conta antiga, por tempo e
	// numa velocidade fixa, e no pega-pega ouvia os passos mais lentos do que a pessoa andava (recado
	// #186) - e sem a correção do vácuo abaixo.
	bool walk_to(float nx, float ny, float step_length) {
		if (step_length <= 0.0) return false;
		float andou = distance_2d(x, y, nx, ny);
		// Salto (duto, reunião, a volta da barriga): conta como um passo só, e não uma rajada.
		if (andou > step_length * 3.0) andou = step_length;
		step_distance += andou;
		if (step_distance < step_length) return false;
		// Desconta UM passo, e não zera: a posição chega pelo canal que tolera perda, e um pacote
		// perdido faz o seguinte trazer dois passos de distância - zerando, um passo sumia e ficava um
		// vácuo no meio da caminhada (relato do usuário). O que sobrar vai para o próximo.
		step_distance -= step_length;
		if (step_distance > step_length) step_distance = step_length;
		return true;
	}
}

// O elenco da partida em andamento, para quem precisa de um nome sem ter o objeto à mão - hoje, os
// avisos falados dentro de uma tela bloqueante (ver core/event_speech.nvgt), que só têm o pacote e
// precisam dizer QUEM matou. Apontado por run_game enquanto a partida dura, e solto no fim dela.
client_roster@ g_match_roster;

class client_roster {
	array<roster_entry@> entries;
	// Quem o SERVIDOR diz ser perceptível perto de mim (S_NEARBY_PLAYERS). nearest_alive só escolhe entre
	// eles: sem isto, quem entrou num duto, foi engolido ou ficou invisível continuava parado no último
	// ponto, e era anunciado a quem passasse e mirado pela tecla de matar. `perceptible_known` fica
	// falso com servidor antigo, que não manda a lista - aí vale o comportamento de antes.
	array<uint64> perceptible;
	bool perceptible_known = false;

	void reset() {
		entries.resize(0);
		perceptible.resize(0);
		perceptible_known = false;
	}

	void set_perceptible(net_packet@ pkt) {
		perceptible.resize(0);
		json_array@ peers = pkt.get_array("peers");
		if (@peers != null) for (uint i = 0; i < peers.length(); i++) perceptible.insert_last(uint64(peers[i]));
		perceptible_known = true;
	}

	void add(uint64 peer_id, const string&in name, int color, float x = 0.0, float y = 0.0) {
		roster_entry@ e = roster_entry();
		e.peer_id = peer_id;
		e.name = name;
		e.color = color;
		e.alive = true;
		e.x = x;
		e.y = y;
		entries.insert_last(e);
	}

	roster_entry@ find(uint64 peer_id) const {
		for (uint i = 0; i < entries.length(); i++) {
			if (entries[i].peer_id == peer_id) return entries[i];
		}
		return null;
	}

	void mark_dead(uint64 peer_id) {
		roster_entry@ e = find(peer_id);
		if (@e != null) e.alive = false;
	}

	// Troca o nome com que este jogador aparece (o disfarce do metamorfo entrando ou saindo).
	//
	// O elenco é a fonte de TODO nome que o cliente fala por conta própria - quem está por perto,
	// quem votou, quem está falando no chat de voz. Enquanto ele guardava só o nome verdadeiro, o
	// disfarce tinha um buraco por onde o jogo denunciava o metamorfo: bastava chegar perto dele e o
	// nome real era anunciado. Renomear aqui fecha todos esses caminhos de uma vez, inclusive os que
	// alguém acrescentar depois.
	void rename(uint64 peer_id, const string&in name) {
		roster_entry@ e = find(peer_id);
		if (@e != null && name != "") e.name = spoken_name(name); // o metamorfo no modo cor assume uma COR
	}

	void update_position(uint64 peer_id, float x, float y) {
		roster_entry@ e = find(peer_id);
		if (@e != null) { e.x = x; e.y = y; }
	}

	array<roster_entry@>@ alive_entries() const {
		array<roster_entry@> result;
		for (uint i = 0; i < entries.length(); i++) {
			if (entries[i].alive) result.insert_last(entries[i]);
		}
		return result;
	}

	// Jogador vivo mais próximo de (x,y), excluindo exclude_peer. Retorna null se ninguém dentro
	// de max_range estiver rastreado (posições só são conhecidas se S_PLAYER_MOVED já chegou).
	// also_exclude serve pra tirar um grupo inteiro da busca - hoje, os parceiros de impostor na
	// hora de escolher quem matar (ver game/game_loop.nvgt).
	roster_entry@ nearest_alive(float x, float y, uint64 exclude_peer, float max_range,
			const array<uint64>@ also_exclude = null) const {
		roster_entry@ best = null;
		float best_dist = max_range;
		for (uint i = 0; i < entries.length(); i++) {
			roster_entry@ e = entries[i];
			if (!e.alive || e.peer_id == exclude_peer) continue;
			if (perceptible_known && perceptible.find(e.peer_id) == -1) continue;
			if (@also_exclude != null && also_exclude.find(e.peer_id) != -1) continue;
			float dist = distance_2d(x, y, e.x, e.y);
			if (dist <= best_dist) {
				best_dist = dist;
				@best = e;
			}
		}
		return best;
	}

	// Popula o elenco a partir do pacote S_GAME_START (campo "players": [{peer_id, name, color, x, y}]).
	void load_from_start_packet(net_packet@ pkt) {
		reset();
		json_array@ players = pkt.get_array("players");
		if (@players == null) return;
		for (uint i = 0; i < players.length(); i++) {
			json_object@ p = players.get_object(i);
			if (@p == null) continue;
			var@ vx = p["x"];
			var@ vy = p["y"];
			// spoken_name: no modo cor o nome chega como marca de cor, e o elenco guarda a cor JÁ no
			// idioma deste jogador - é dele que saem quem está perto, quem fala na voz, a lista de votação.
			add(uint64(p["peer_id"]), spoken_name(string(p["name"])), int(p["color"]), safe_var_to_float(vx), safe_var_to_float(vy));
		}
	}
}
