// chat_log.nvgt
// Container navegável de linhas (mensagens de chat OU eventos do jogo) - usado duas vezes:
// um container de "mensagens" (chat de verdade) e um de "eventos" (anúncios do jogo: quem
// entrou/saiu, corpo reportado, sabotagem, etc.). Navegação: vírgula/ponto andam entre linhas,
// Shift+ponto/vírgula pulam pro fim/começo (ver game/game_loop.nvgt e ui/lobby_screens.nvgt).

#include "utf8.nvgt"
#include "form.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../i18n.nvgt"
#include "../config/keybindings.nvgt"
#include "../audio/voice_chat.nvgt"
#include "event_speech.nvgt"

// As teclas de chat e de voto agora vêm do mapa de teclas do jogador (config/keybindings.nvgt):
// ACTION_CHAT, ACTION_CHAT_PREV, ACTION_CHAT_NEXT, ACTION_CHAT_SWITCH e ACTION_VOTE.
// PageDown continua funcionando como segunda tecla de trocar de container, fixa, porque a dupla
// PageUp/PageDown é o gesto natural pra quem usa leitor de tela.
const int KEY_CHAT_SWITCH_CONTAINER_ALT = KEY_PAGEDOWN;

// O pacote que o laço principal está tratando agora (null fora disso). É por ele que chat_log.add sabe
// que a linha já foi registrada com uma tela aberta - ver net_packet.logged.
net_packet@ g_logging_packet = null;

// O histórico que as teclas de leitura (vírgula, ponto, PageUp/PageDown) percorrem, onde quer que o
// jogador esteja: no laço da partida, na sala de espera, ou DENTRO de um menu (votação, regras da sala,
// escolha de cor). Antes as teclas só eram lidas pelos laços principais - aberto um menu, a leitura
// travava, e o que chegava com ele aberto só entrava no histórico ao fechar. Na votação, que é
// justamente onde a conversa importa, não dava para reler o que acabara de ser dito.
class chat_review {
	chat_log@ messages;
	chat_log@ events;
	bool viewing_events = false;
	chat_review(chat_log@ messages, chat_log@ events) {
		@this.messages = messages;
		@this.events = events;
	}
}
chat_review@ g_chat_review = null;

// Liga o histórico desta tela (partida ou sala de espera) às teclas de leitura e ao registro do que
// chega com um menu aberto.
void begin_chat_review(chat_log@ messages, chat_log@ events) {
	@g_chat_review = chat_review(messages, events);
	@g_background_log_sink = @log_background_into_review;
}

void end_chat_review() {
	@g_chat_review = null;
	@g_background_log_sink = null;
}

// O que foi anunciado com uma tela aberta, no histórico certo: chat nas mensagens, o resto nos eventos.
void log_background_into_review(net_packet@ pkt, const string&in text) {
	if (@g_chat_review == null) return;
	if (pkt.type == S_CHAT_MESSAGE) g_chat_review.messages.add(spoken_name(pkt.get_string("name")), pkt.get_string("text"));
	else g_chat_review.events.add("", text);
}

// As teclas de leitura, num lugar só: os laços principais e os menus chamam esta função. Cada tecla é
// lida UMA vez e guardada (ver Armadilhas no CLAUDE.md: key_pressed é consumo de evento).
void chat_review_keys() {
	if (@g_chat_review == null) return;
	if (action_pressed(ACTION_CHAT_SWITCH) || key_pressed(KEY_CHAT_SWITCH_CONTAINER_ALT)) {
		g_chat_review.viewing_events = !g_chat_review.viewing_events;
		speak(tr(g_chat_review.viewing_events ? "chat.events_container" : "chat.messages_container"));
	}
	bool anterior = action_pressed(ACTION_CHAT_PREV);
	bool proxima = action_pressed(ACTION_CHAT_NEXT);
	if (!anterior && !proxima) return;
	chat_log@ log = g_chat_review.viewing_events ? g_chat_review.events : g_chat_review.messages;
	bool shift = key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT);
	string linha;
	if (anterior) linha = shift ? log.move_first() : log.move_previous();
	else linha = shift ? log.move_last() : log.move_next();
	speak(linha != "" ? linha : tr("chat.empty"));
}

class chat_line {
	string speaker_name; // "" = linha de evento/sistema, sem autor
	string text;
}

class chat_log {
	array<chat_line> lines;
	int cursor = -1;

	// Adiciona uma linha SEM mover o cursor. Antes o cursor pulava para a linha nova a cada chegada,
	// e quem estava relendo o histórico no meio de uma reunião perdia o lugar toda vez que alguém
	// falava - era impossível ler o chat enquanto o chat acontecia (recado #52). O cursor só vai
	// para a primeira linha quando o histórico estava vazio, para haver onde começar.
	void add(const string&in speaker_name, const string&in text) {
		// O pacote que o laço está tratando agora JÁ entrou no histórico enquanto uma tela estava
		// aberta (ver chat_review): registrar de novo duplicaria a linha.
		if (@g_logging_packet != null && g_logging_packet.logged) return;
		chat_line line;
		line.speaker_name = speaker_name;
		line.text = text;
		lines.insert_last(line);
		if (cursor < 0) cursor = 0;
	}

	bool get_empty() const property {
		return lines.length() == 0;
	}

	string format_line(uint index) const {
		if (index >= lines.length()) return "";
		if (lines[index].speaker_name == "") return lines[index].text;
		return lines[index].speaker_name + ": " + lines[index].text;
	}

	string current() const {
		if (get_empty()) return "";
		return format_line(uint(cursor));
	}

	string move_previous() {
		if (get_empty()) return "";
		if (cursor > 0) cursor--;
		return current();
	}

	string move_next() {
		if (get_empty()) return "";
		if (cursor < int(lines.length()) - 1) cursor++;
		return current();
	}

	string move_first() {
		if (get_empty()) return "";
		cursor = 0;
		return current();
	}

	string move_last() {
		if (get_empty()) return "";
		cursor = int(lines.length()) - 1;
		return current();
	}
}

// Trata, dentro da caixa de mensagem, só o que não pode esperar. Devolve false se a caixa deve fechar.
bool drain_chat_while_composing(game_client@ client, chat_log@ messages) {
	for (uint i = 0; i < client.incoming.length(); i++) {
		net_packet@ p = client.incoming[i];
		if (p.type == S_VOTE_RESULT || p.type == S_GAME_OVER) return false; // fica na fila; o laço trata
		if (p.type != S_CHAT_MESSAGE) continue;
		string name = spoken_name(p.get_string("name")); // modo cor: a cor de quem falou
		string text = p.get_string("text");
		if (@messages != null) messages.add(name, text);
		if (!p.announced) speak_chat(name + ": " + text);
		client.incoming.remove_at(i);
		i--;
	}
	return true;
}

// Caixa de texto simples pra escrever e mandar uma mensagem de chat. O servidor decide quem recebe
// (facção durante a partida, todo mundo na lobby/reunião/votação - ver network/server.nvgt).
// Enquanto a caixa está aberta, o laço principal não roda - então ela mesma cuida do que não pode
// esperar: mensagens de chat que chegam são guardadas e ditas (sem interromper a digitação), e o
// fim da reunião ou da partida FECHA a caixa, porque a mensagem não teria mais para quem ir. O resto
// dos pacotes fica na fila, intacto, para o laço principal tratar quando a caixa fechar - a caixa
// só tira da fila o que ela própria trata.
//
// Antes disto o jogo parecia travar ao abrir a caixa: ninguém ouvia o chat enquanto escrevia, e
// quem estava digitando quando a votação acabava continuava numa caixa fantasma.
// A mensagem passou do limite? Diz quanto, para a pessoa saber o quanto cortar.
bool chat_too_long(const string&in text) {
	uint n = utf8_length(text);
	if (n <= MAX_CHAT_LENGTH) return false;
	dictionary@ p = dictionary();
	p.set("count", "" + n);
	p.set("max", "" + MAX_CHAT_LENGTH);
	speak(tr("chat.too_long", p));
	return true;
}

void run_chat_compose(game_client@ client, chat_log@ messages = null) {
	audio_form f;
	f.create_window(tr("chat.compose_title"), false);
	int f_text = f.create_input_box(tr("chat.compose_label"));
	int f_send = f.create_button(tr("menu.confirm"), true);
	int f_cancel = f.create_button(tr("menu.cancel"), false, true);
	// Um audio_form nasce SEM controle nenhum focado (control_focus = -1 em form.nvgt): sem esta
	// linha, o que o jogador digita ao abrir a caixa não entra em lugar nenhum e o Enter não faz
	// nada, até ele apertar Tab. E ninguém aperta Tab numa caixa de mensagem - ele abriu para
	// escrever. Todo form do jogo precisa focar o primeiro campo na mão.
	f.focus(f_text);

	// A tecla de falar é uma letra: digitá-la aqui abria o microfone no meio da mensagem.
	g_voice.typing = true;
	while (true) {
		wait(5);
		client.update();
		// A caixa é uma tela bloqueante como qualquer outra: o que chega continua sendo dito.
		announce_background_events(client);
		if (!client.connected) { g_voice.typing = false; return; } // quem chamou vai avisar da queda
		if (!drain_chat_while_composing(client, messages)) {
			speak(tr("chat.compose_closed"));
			g_voice.typing = false;
			return;
		}
		f.monitor();
		if (f.is_pressed(f_cancel)) { g_voice.typing = false; return; }
		if (f.is_pressed(f_send)) {
			string text = f.get_text(f_text);
			// Passou do limite: avisa e deixa a caixa aberta para encurtar. O servidor cortaria calado,
			// e quem escreveu só descobriria pela metade que os outros ouviram.
			if (chat_too_long(text)) continue;
			if (text != "") {
				client.send_chat_message(text);
				speak(tr("chat.sent"));
			}
			g_voice.typing = false;
			return;
		}
	}
}
