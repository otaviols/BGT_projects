// state_roles.nvgt
// Habilidades dos papéis que mudam o estado da partida: lobo (barriga), metamorfo, fantasma, anjo.
//
// Parte do game_state (src/core/game_state.nvgt), como `mixin class`: o AngelScript não tem classe parcial, e o mixin
// é o jeito de a mesma classe morar em vários arquivos. Os métodos daqui enxergam os campos e os
// métodos de todas as outras partes, e não compilam sozinhos - quem inclui é o game_state.nvgt.

mixin class state_roles_part {
	// O lobo engole alguém ao alcance. Devolve false com `fail_key` quando não dá.
	//
	// As regras de quem pode ser alvo são as do assassinato (try_kill), pelos mesmos motivos: ninguém
	// dentro de duto, nem de um lado nem do outro; o escudo do anjo vale contra QUALQUER ataque. O que
	// muda é o efeito: nada de corpo, e o alvo não morre - vai para a barriga (swallowed_by), com
	// `alive = false` para sair da contagem, da votação e do radar de todo mundo.
	bool try_eat(uint64 wolf_peer, uint64 target_peer, string&out fail_key) {
		fail_key = "";
		game_player@ lobo = find_player(wolf_peer);
		game_player@ alvo = find_player(target_peer);
		if (@lobo == null || !lobo.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (lobo.vented) { fail_key = "role.eat_no_target"; return false; }
		// Alvo inválido, longe, no duto ou protegido: tudo cai no mesmo "ninguém ao alcance". Uma
		// recusa própria para o escudo contaria ao lobo que aquela pessoa está blindada.
		if (@alvo == null || !alvo.alive || alvo.peer_id == lobo.peer_id || alvo.vented || alvo.shield_remaining > 0.0 ||
				distance_2d(lobo.x, lobo.y, alvo.x, alvo.y) > PLAYER_KILL_RANGE ||
				map.door_blocks(lobo.x, lobo.y, alvo.x, alvo.y)) { // a porta trancada, como no kill (try_kill)
			fail_key = "role.eat_no_target";
			return false;
		}

		alvo.alive = false;
		alvo.swallowed_by = lobo.peer_id;
		// Carregador engolido larga o corpo onde estava (ver drop_carried_body).
		net_packet@ largado = drop_carried_body(alvo);
		if (@largado != null) pending_events.insert_last(largado);
		// A barriga desfaz o que o alvo estava usando para não ser percebido. O disfarce cai (o servidor
		// transmite o nome de volta - ver ABILITY_EAT em run_ability): lá dentro ele é quem é, e a
		// lista da reunião precisa ter o nome certo quando ele voltar.
		if (alvo.invisible()) alvo.invisible_remaining = 0.0;
		// Quem ele tinha engolido (se o alvo for outro lobo) sai junto, no mesmo ponto: a barriga de um
		// lobo engolido não passa para o outro.
		release_belly(alvo, alvo.x, alvo.y);
		return true;
	}

	// Quem estava na barriga deste jogador volta, vivo, em (x, y). Chamado em TODA forma de o lobo sair
	// do jogo - assassinato, palpite do atirador, expulsão, saída da partida -, e é inofensivo para
	// quem não é lobo (a barriga está vazia). O aviso sai pela fila do tick (pending_events).
	void release_belly(game_player@ lobo, float x, float y) {
		if (@lobo == null) return;
		json_array@ voltaram = json_array();
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.swallowed_by != lobo.peer_id) continue;
			p.swallowed_by = 0;
			// Quem saiu da partida lá dentro não volta: o registro dele fica morto (ver remove_from_lobby).
			if (p.left_match) continue;
			p.alive = true;
			p.x = x;
			p.y = y;
			// Sem isto, o primeiro passo depois da volta era medido desde o último movimento ANTES de
			// ser engolido - e a volta seria tratada como um salto qualquer.
			p.last_move_time = elapsed_time;
			// Volta como no começo da partida: a recarga de quem a começa correndo (o lobo) e a do kill
			// recomeçam inteiras. Lá dentro o relógio continuava andando, e todo mundo saía da barriga
			// com tudo pronto - no todos lobos isso virava uma devoração em cadeia (relato do usuário).
			if (p.role().ability_starts_on_cooldown) p.ability_cooldown_remaining = config.role_value(p.role_id, TUNABLE_COOLDOWN);
			if (p.role().can_kill) p.kill_cooldown_remaining = config.kill_cooldown_seconds;
			voltaram.add(p.peer_id);
		}
		if (voltaram.length() == 0) return;
		net_packet@ pkt = net_packet(S_BELLY_RELEASED);
		pkt.set_array("peers", voltaram);
		pkt.set_float("x", x);
		pkt.set_float("y", y);
		pending_events.insert_last(pkt);
	}

	// Os dois estão na MESMA barriga - contando o próprio lobo como parte dela.
	bool in_same_belly(game_player@ a, game_player@ b) const {
		uint64 barriga_a = a.swallowed() ? a.swallowed_by : a.peer_id;
		uint64 barriga_b = b.swallowed() ? b.swallowed_by : b.peer_id;
		if (barriga_a != barriga_b) return false;
		// O lobo precisa estar vivo para "ser a barriga": morto, ele não carrega ninguém (a soltura já
		// teria acontecido - isto é só a guarda para um estado que não deveria existir).
		game_player@ lobo = find_player(barriga_a);
		return @lobo != null && lobo.alive;
	}

	// Quem está na barriga fica ONDE O LOBO ESTÁ. É o que faz o radar do engolido varrer a sala do
	// lobo (recado #160: ele queria saber o que acontece lá fora) sem nenhuma regra nova no radar - a
	// varredura já parte da posição de quem pergunta. Para os outros nada muda: o engolido está com
	// alive = false, e ninguém o percebe onde quer que ele esteja.
	void follow_wolves() {
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (!p.swallowed()) continue;
			game_player@ lobo = find_player(p.swallowed_by);
			if (@lobo == null || !lobo.alive) continue;
			p.x = lobo.x;
			p.y = lobo.y;
		}
	}

	// Alguém está na barriga de um lobo agora. (Quem saiu da partida lá dentro não conta: ele não volta.)
	bool anyone_in_belly() const {
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].swallowed() && !players[i].left_match) return true;
		}
		return false;
	}

	// Assume o nome de outro jogador VIVO. Devolve o nome copiado, que é o que o shapeshifter ouve.
	//
	// O alvo não precisa estar perto - a jogada é justamente imitar alguém que está longe, para que
	// a pessoa imitada não esteja por ali para desmentir. O que impede isso de ser grátis é o SOM da
	// transformação (posicionado, ouvido por quem está do lado dele) e o microfone fechado enquanto
	// durar (ver on_voice_frame).
	//
	// Morto não se transforma: fantasma não aparece no radar de ninguém, então não haveria o que
	// disfarçar.
	bool try_shapeshift(uint64 peer_id, uint64 target_peer, string&out copied_name, string&out fail_key) {
		fail_key = "";
		copied_name = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		game_player@ target = find_player(target_peer);
		// Alvo morto entra no mesmo "esse não serve" de um alvo que não existe: dizer "essa pessoa
		// está morta" contaria ao impostor um corpo que ele talvez não tivesse encontrado.
		if (@target == null || !target.alive || target.peer_id == peer_id) { fail_key = "role.shift_bad_target"; return false; }

		p.set_disguise(target.display_name(), config.role_value(ROLE_SHAPESHIFTER, TUNABLE_DURATION));
		copied_name = p.disguise_name;
		return true;
	}

	// O fantasma some. Devolve false só se ele não puder agora (morto, ou já invisível).
	bool try_vanish(uint64 peer_id, string&out fail_key) {
		fail_key = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (p.invisible()) { fail_key = "role.vanish_already"; return false; }
		p.invisible_remaining = config.role_value(ROLE_PHANTOM, TUNABLE_DURATION);
		return true;
	}

	// Desfaz as invisibilidades que venceram, e devolve quem voltou a ser percebido - o servidor
	// avisa cada um e toca o som onde ele está.
	array<uint64>@ expire_invisibility() {
		array<uint64> voltaram;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			// `invisible_remaining == 0` não basta para saber que ele ESTAVA invisível: é preciso um
			// sinal de que acabou AGORA. O `was_invisible` é escrito no tick, junto do relógio.
			if (!p.was_invisible || p.invisible()) continue;
			p.was_invisible = false;
			voltaram.insert_last(p.peer_id);
		}
		return voltaram;
	}

	// Desfaz as fantasias cujo tempo acabou. Devolve quem voltou ao normal, para o servidor avisar
	// cada um e tocar o som onde ele está - a volta é tão audível quanto a ida, senão desfazer-se
	// no meio de uma sala seria grátis.
	array<uint64>@ expire_disguises() {
		array<uint64> voltaram;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (!p.disguised() || p.disguise_remaining > 0.0) continue;
			p.set_disguise("", 0.0);
			voltaram.insert_last(p.peer_id);
		}
		return voltaram;
	}

	// Escudo do anjo da guarda sobre alguém vivo. Devolve o NOME do protegido, porque é a única
	// coisa que o anjo ouve de volta - ninguém mais é avisado de nada.
	//
	// Exige o anjo MORTO (o papel só age depois de morrer) e o alvo perto: o fantasma tem que
	// atravessar a nave até quem quer salvar, e é esse custo que o impede de cobrir todo mundo.
	bool try_shield_player(uint64 angel_peer, uint64 target_peer, string&out target_name, string&out fail_key) {
		fail_key = "";
		target_name = "";
		game_player@ angel = find_player(angel_peer);
		game_player@ target = find_player(target_peer);
		if (@angel == null) return false;
		if (angel.alive) { fail_key = "role.ability_only_dead"; return false; }
		// Alvo morto ou ele mesmo: some no "ninguém por perto", sem uma recusa própria. Uma mensagem
		// específica para "esse já está morto" diria ao anjo algo que ele talvez não soubesse.
		if (@target == null || !target.alive || target.peer_id == angel.peer_id) { fail_key = "role.shield_no_target"; return false; }
		if (distance_2d(angel.x, angel.y, target.x, target.y) > GUARDIAN_SHIELD_RANGE) { fail_key = "role.shield_no_target"; return false; }

		// Relançar sobre quem já está protegido simplesmente renova - não é erro, e recusar
		// contaria ao anjo que aquela pessoa já está blindada por outro anjo.
		target.shield_remaining = config.role_value(ROLE_GUARDIAN_ANGEL, TUNABLE_DURATION);
		target_name = target.public_name();
		return true;
	}

	// --- Trocador ---

	// A troca desta reunião. Na mesa, os dois vivos e diferentes, e uma por reunião (a primeira).
	bool try_swap(uint64 swapper_peer, uint64 a, uint64 b, string&out a_name, string&out b_name, string&out fail_key) {
		if (state != "voting") { fail_key = "role.swap_not_in_meeting"; return false; }
		if (swap_a != 0) { fail_key = "role.swap_already"; return false; }
		game_player@ pa = find_player(a);
		game_player@ pb = find_player(b);
		if (a == b || @pa == null || @pb == null || !pa.alive || !pb.alive) { fail_key = "role.swap_invalid"; return false; }
		swap_a = a;
		swap_b = b;
		a_name = pa.public_name();
		b_name = pb.public_name();
		return true;
	}

	// --- Lixeiro e carregador ---

	// O corpo ao alcance de alguém, pelo índice em `bodies` (-1 = nenhum). O mesmo alcance do reporte:
	// é a distância em que o corpo "está ali" para qualquer um.
	int body_index_near(float x, float y) {
		for (uint i = 0; i < bodies.length(); i++)
			if (distance_2d(x, y, bodies[i].x, bodies[i].y) <= PLAYER_REPORT_RANGE) return int(i);
		return -1;
	}

	bool try_clean_body(uint64 peer, float&out x, float&out y, uint64&out victim, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		int i = body_index_near(p.x, p.y);
		if (i < 0) { fail_key = "role.no_body_near"; return false; }
		x = bodies[i].x;
		y = bodies[i].y;
		victim = bodies[i].victim_peer_id;
		bodies.remove_at(i);
		return true;
	}

	// --- Veterano, abutre e transportador (1.1) ---

	// O alerta do veterano. Relançar com o alerta ainda ligado não acontece: a recarga é maior que a duração.
	bool try_alert(uint64 peer, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		p.alert_remaining = config.role_value(ROLE_VETERAN, TUNABLE_DURATION);
		return true;
	}

	// O abutre come o corpo ao alcance (some, como o do lixeiro). Com N corpos ele vence na hora, sozinho.
	bool try_devour(uint64 peer, float&out x, float&out y, uint64&out victim, uint&out eaten, uint&out needed,
			string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		int i = body_index_near(p.x, p.y);
		if (i < 0) { fail_key = "role.no_body_near"; return false; }
		x = bodies[i].x;
		y = bodies[i].y;
		victim = bodies[i].victim_peer_id;
		bodies.remove_at(i);
		p.bodies_eaten++;
		eaten = p.bodies_eaten;
		needed = uint(config.role_value(ROLE_VULTURE, TUNABLE_BODIES) + 0.5);
		if (eaten >= needed && winner == "") {
			winner = WINNER_NEUTRAL;
			win_reason = "vulture_fed";
			neutral_winner_peer = p.peer_id;
		}
		return true;
	}

	// O transportador troca dois vivos de lugar, de qualquer distância. Ele pode ser um dos dois. Recusa
	// quem está num duto (a posição dele é segredo, e tirá-lo de lá denunciaria que estava) e quem está na
	// barriga do lobo (não está no mapa). Os dois param de ser recusados ao andar no instante seguinte: o
	// relógio do passo recomeça (last_move_time), senão o primeiro passo do novo lugar pareceria um salto.
	bool try_transport(uint64 peer, uint64 a, uint64 b, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		game_player@ pa = find_player(a);
		game_player@ pb = find_player(b);
		if (a == b || @pa == null || @pb == null || !pa.alive || !pb.alive || pa.vented || pb.vented
				|| pa.swallowed() || pb.swallowed()) { fail_key = "role.transport_invalid"; return false; }
		float ax = pa.x, ay = pa.y;
		pa.x = pb.x; pa.y = pb.y;
		pb.x = ax; pb.y = ay;
		pa.last_move_time = elapsed_time;
		pb.last_move_time = elapsed_time;
		return true;
	}

	// O recrutador transforma o tripulante colado nele em impostor, uma vez por partida. Recrutar gasta a
	// faca daquela recarga (decisão do usuário): o time ganha um, e ele perde o próximo kill.
	bool try_recruit(uint64 peer, uint64 target_peer, string&out target_name, string&out fail_key) {
		game_player@ p = find_player(peer);
		game_player@ t = find_player(target_peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (p.recruit_used) { fail_key = "role.recruit_used"; return false; }
		if (@t == null || !t.alive || t.peer_id == p.peer_id || distance_2d(p.x, p.y, t.x, t.y) > PLAYER_KILL_RANGE
				|| map.door_blocks(p.x, p.y, t.x, t.y)) { fail_key = "role.recruit_no_target"; return false; }
		// Só tripulante. Mirar num neutro ou num parceiro não acontece e não gasta - e a recusa é a mesma
		// do "ninguém ao alcance", para não contar ao recrutador que aquela pessoa é neutra.
		if (t.role().team != TEAM_CREW) { fail_key = "role.recruit_no_target"; return false; }
		t.set_role(ROLE_IMPOSTOR);
		// Impostor não tem tarefas (só finge): as dele saem, ou continuariam soando e valendo para ele.
		// Para o progresso do time já não contavam - a conta é pelo papel.
		t.tasks.resize(0);
		t.kill_cooldown_remaining = kill_cooldown_for(t);
		p.recruit_used = true;
		p.kill_cooldown_remaining = kill_cooldown_for(p);
		target_name = t.public_name();
		return true;
	}

	// O MINEIRO cava um duto onde está, na rede do duto mais próximo. Recusa dentro de um duto, fora de
	// sala ou corredor, e colado num duto que já existe. Os dutos cavados ficam guardados em `mined_vents`
	// para ir no começo de partida de quem voltar depois de cair (que monta o mapa do zero).
	bool try_mine(uint64 peer, string&out vent_id, string&out link_id, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive || p.vented) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (p.mine_used) { fail_key = "role.mine_used"; return false; }
		link_id = map.nearest_vent_id(p.x, p.y);
		map_object@ perto = map.find_object(link_id);
		if (@perto == null) { fail_key = "role.mine_no_network"; return false; }
		if (distance_2d(p.x, p.y, perto.x, perto.y) < MINER_MIN_VENT_DISTANCE) { fail_key = "role.mine_too_close"; return false; }
		vent_id = "vent_mined_" + p.peer_id;
		if (!map.add_mined_vent(vent_id, p.x, p.y, link_id)) { fail_key = "role.mine_bad_spot"; return false; }
		p.mine_used = true;
		mined_vent_ids.insert_last(vent_id);
		mined_vent_links.insert_last(link_id);
		mined_vent_x.insert_last(p.x);
		mined_vent_y.insert_last(p.y);
		return true;
	}

	// A bomba do OFUSCADOR: quem está VIVO na mesma sala que ele, menos ele, fica surdo. No duto e na
	// barriga não se está na sala; fantasma não é atingido (como em toda sabotagem). Fora de sala (num
	// ponto sem sala, que não deveria existir) recusa.
	bool try_sound_bomb(uint64 peer, array<uint64>@ surdos, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive || p.vented) { fail_key = "game.ghost_cannot_interact"; return false; }
		string sala = map.room_id_at(p.x, p.y);
		if (sala == "") { fail_key = "role.ability_unavailable"; return false; }
		for (uint i = 0; i < players.length(); i++) {
			game_player@ o = players[i];
			if (o is p || !o.alive || o.vented || o.swallowed()) continue;
			if (map.room_id_at(o.x, o.y) == sala) surdos.insert_last(o.peer_id);
		}
		return true;
	}

	// O DELATOR, conferido a cada tick da sala: faltando poucas tarefas, os impostores vivos descobrem
	// quem ele é (uma vez); com todas feitas, ele descobre quem são os impostores (uma vez). Só o delator
	// VIVO: morto, ele já não conta a ninguém, e os impostores não precisam mais caçá-lo. Devolve os avisos
	// como pares (quem ouve, chave, nome) - quem manda é o servidor.
	void snitch_news(array<uint64>@ quem, array<string>@ chave, array<string>@ nomes) {
		for (uint i = 0; i < players.length(); i++) {
			game_player@ d = players[i];
			if (!d.alive || d.role_id != ROLE_SNITCH) continue;
			uint faltam = 0;
			for (uint k = 0; k < d.tasks.length(); k++) if (!d.tasks[k].completed) faltam++;
			if (!d.snitch_exposed && faltam <= uint(config.role_value(ROLE_SNITCH, TUNABLE_TASKS_LEFT) + 0.5)) {
				d.snitch_exposed = true;
				for (uint k = 0; k < players.length(); k++) {
					if (!players[k].alive || !players[k].is_impostor) continue;
					quem.insert_last(players[k].peer_id); chave.insert_last("role.snitch_exposed"); nomes.insert_last(d.public_name());
				}
			}
			if (!d.snitch_told && faltam == 0) {
				d.snitch_told = true;
				array<string> impostores;
				for (uint k = 0; k < players.length(); k++) if (players[k].is_impostor) impostores.insert_last(players[k].public_name());
				quem.insert_last(d.peer_id); chave.insert_last("role.snitch_found"); nomes.insert_last(join(impostores, ", "));
			}
		}
	}

	bool is_carrying(uint64 peer) const { return carrier_peers.find(peer) != -1; }

	bool try_pick_body(uint64 peer, uint64&out victim, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (is_carrying(peer)) { fail_key = "role.drag_already"; return false; }
		int i = body_index_near(p.x, p.y);
		if (i < 0) { fail_key = "role.no_body_near"; return false; }
		body_info@ b = bodies[i];
		victim = b.victim_peer_id;
		carrier_peers.insert_last(peer);
		carried_bodies.insert_last(b);
		bodies.remove_at(i);
		return true;
	}

	// Larga o corpo onde o carregador está. Devolve o aviso para a partida (S_BODY_PLACED), ou null se
	// ele não carregava nada. Chamada ao largar de propósito E em toda saída dele: morrer, ser engolido,
	// sair da sala - senão o corpo sumiria da partida junto com ele.
	net_packet@ drop_carried_body(game_player@ p) {
		if (@p == null) return null;
		int i = carrier_peers.find(p.peer_id);
		if (i < 0) return null;
		body_info@ b = carried_bodies[i];
		carrier_peers.remove_at(i);
		carried_bodies.remove_at(i);
		b.x = p.x;
		b.y = p.y;
		b.room_id = map.room_id_at(p.x, p.y);
		bodies.insert_last(b);
		net_packet@ aviso = net_packet(S_BODY_PLACED);
		aviso.set_uint64("peer_id", b.victim_peer_id);
		aviso.set_float("x", b.x);
		aviso.set_float("y", b.y);
		return aviso;
	}

	// --- Carrasco ---

	// Sorteia o alvo de cada Carrasco: um tripulante (time da tripulação, bot incluído), nunca ele
	// mesmo. Sem ninguém para ser alvo, ele vira Bobo já no começo - devolvido na lista.
	array<uint64>@ assign_execution_targets() {
		array<uint64> virou_bobo;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ c = players[i];
			if (c.role().solo_win != SOLO_WIN_TARGET_EJECTED) continue;
			array<uint64> candidatos;
			for (uint j = 0; j < players.length(); j++)
				if (players[j].peer_id != c.peer_id && players[j].role().team == TEAM_CREW) candidatos.insert_last(players[j].peer_id);
			if (candidatos.length() == 0) { c.set_role(ROLE_JESTER); virou_bobo.insert_last(c.peer_id); continue; }
			c.execution_target = candidatos[random(0, candidatos.length() - 1)];
		}
		return virou_bobo;
	}

	// O Carrasco cujo alvo morreu de outro jeito (assassinado, palpite, fogo) ou saiu: vira Bobo. Engolido
	// NÃO conta - quem está na barriga pode voltar. Só com a partida correndo e sem vencedor: o alvo
	// expulso já deu a vitória a ele na apuração, antes daqui.
	array<uint64>@ convert_lost_executioners() {
		array<uint64> convertidos;
		if (winner != "" || (state != "in_progress" && state != "voting")) return convertidos;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ c = players[i];
			if (c.role().solo_win != SOLO_WIN_TARGET_EJECTED || c.execution_target == 0) continue;
			game_player@ alvo = find_player(c.execution_target);
			bool perdido = @alvo == null || alvo.left_match || (!alvo.alive && !alvo.swallowed());
			if (!perdido) continue;
			c.execution_target = 0;
			// Com um Bobo vivo em jogo, vira o RIVAL dele (com as tarefas que liberam a faca); sem, vira Bobo.
			bool ha_bobo = false;
			for (uint k = 0; k < players.length(); k++)
				if (players[k].alive && players[k].role_id == ROLE_JESTER && players[k].peer_id != c.peer_id) ha_bobo = true;
			if (ha_bobo) {
				c.set_role(ROLE_RIVAL_JESTER);
				c.kill_cooldown_remaining = 0.0; // quem trava a faca são as tarefas
				give_rival_tasks(c, uint(config.role_value(ROLE_EXECUTIONER, TUNABLE_RIVAL_TASKS) + 0.5));
			} else c.set_role(ROLE_JESTER);
			convertidos.insert_last(c.peer_id);
		}
		return convertidos;
	}

	// As tarefas do bobo rival, sorteadas na hora em que ele vira: curtas, de uma fase, individuais e NÃO
	// visíveis - a tarefa visível é prova de inocência, e o rival não é inocente. Não contam para a
	// tripulação (o papel não é dela); servem só para liberar a faca dele.
	void give_rival_tasks(game_player@ p, uint quantas) {
		p.tasks.resize(0);
		array<map_object@>@ pontos = map.objects_by_type(OBJ_TASK_SPOT);
		array<map_object@> livres;
		for (uint i = 0; i < pontos.length(); i++) {
			map_object@ o = pontos[i];
			if (COMMON_TASK_TYPES.find(o.task_type) != -1 || task_is_visible(o.task_type) || task_is_long(o.task_type)
				|| map.object_in_chain(o.id)) continue;
			livres.insert_last(o);
		}
		for (uint n = 0; n < quantas && livres.length() > 0; n++) {
			int k = random(0, int(livres.length()) - 1);
			player_task t;
			t.object_id = livres[k].id;
			t.task_type = livres[k].task_type;
			p.tasks.insert_last(t);
			livres.remove_at(k);
		}
	}

	// O bobo rival pode matar AGORA este alvo? "" = pode; senão, a chave do porquê (dita a ele).
	string rival_kill_refusal(game_player@ rival, game_player@ alvo) const {
		uint faltam = 0;
		for (uint i = 0; i < rival.tasks.length(); i++) if (!rival.tasks[i].completed) faltam++;
		if (faltam > 0) return "role.rival_tasks_left";
		if (@alvo == null || alvo.role_id != ROLE_JESTER) return "role.rival_only_jester";
		return "";
	}

	// --- Incendiário ---

	// Os vivos que ainda faltam encharcar (o próprio incendiário não conta; engolido não está na nave).
	uint not_doused_count(game_player@ a) const {
		uint n = 0;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.peer_id == a.peer_id || !p.alive || p.left_match) continue;
			if (a.doused.find(p.peer_id) == -1) n++;
		}
		return n;
	}

	bool try_douse(uint64 arsonist_peer, uint64 target_peer, uint&out remaining, string&out fail_key) {
		game_player@ a = find_player(arsonist_peer);
		game_player@ t = find_player(target_peer);
		if (@a == null || !a.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (@t == null || !t.alive || t.peer_id == a.peer_id || distance_2d(a.x, a.y, t.x, t.y) > PLAYER_KILL_RANGE
				|| map.door_blocks(a.x, a.y, t.x, t.y)) { fail_key = "role.douse_no_target"; return false; }
		if (a.doused.find(target_peer) != -1) { fail_key = "role.douse_already"; return false; }
		a.doused.insert_last(target_peer);
		remaining = not_doused_count(a);
		return true;
	}

	// Com todos os vivos encharcados: fogo. Todos morrem, sem corpo (não há reunião depois disso), e ele
	// vence sozinho.
	bool try_ignite(uint64 arsonist_peer, string&out fail_key) {
		game_player@ a = find_player(arsonist_peer);
		if (@a == null || !a.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (not_doused_count(a) > 0) { fail_key = "role.ignite_not_ready"; return false; }
		for (uint i = 0; i < players.length(); i++)
			if (players[i].peer_id != a.peer_id && players[i].alive) players[i].alive = false;
		winner = WINNER_NEUTRAL;
		win_reason = "arsonist_ignited";
		neutral_winner_peer = a.peer_id;
		return true;
	}

	// --- Amnésico ---

	// Herda o papel do morto ao alcance - qualquer um. O corpo continua lá: ninguém precisa saber.
	bool try_remember(uint64 peer, string&out new_role, string&out fail_key) {
		game_player@ p = find_player(peer);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		int i = body_index_near(p.x, p.y);
		if (i < 0) { fail_key = "role.no_body_near"; return false; }
		game_player@ morto = find_player(bodies[i].victim_peer_id);
		if (@morto == null) { fail_key = "role.no_body_near"; return false; }
		new_role = morto.role_id;
		p.set_role(new_role);
		// Papel de quem faz tarefa vem COM as tarefas do morto, no ponto em que ele as deixou: o amnésico
		// começa sem nenhuma, e herdar um tripulante sem tarefas deixava-o sem o que fazer e sem
		// disfarce (achado do usuário). Cópia, e o morto para de contar (tasks_passed_on): o total da
		// equipe fica igual. O fantasma dele segue com a lista, mas o que fizer ali não conta mais.
		if (p.role().tasks_count_for_crew && !morto.tasks_passed_on) {
			p.tasks = morto.tasks;
			morto.tasks_passed_on = true;
		}
		// O kill recarregando (ninguém herda uma faca pronta no meio de todo mundo) e o alvo do carrasco.
		// A habilidade do papel novo também começa recarregando: on_use_ability arma a recarga depois
		// daqui, já com o papel novo - herdar não dá uma habilidade pronta de graça.
		p.kill_cooldown_remaining = config.kill_cooldown_seconds;
		p.guesses_left = 0;
		p.execution_target = morto.execution_target;
		return true;
	}

	// --- Médico ---

	// Traz de volta o morto ao alcance, se a morte foi há menos que a janela. Ele volta onde caiu, vivo,
	// com as tarefas e o papel de antes; o corpo some. Com a regra padrão (a morte tira os modificadores,
	// ver strip_dead_modifiers) ele volta sozinho e sem nada.
	bool try_revive(uint64 doctor_peer, uint64&out victim, float&out x, float&out y, string&out fail_key) {
		uint64 par_ignorado;
		return try_revive(doctor_peer, victim, x, y, par_ignorado, fail_key);
	}

	// `partner`: na regra antiga (a sala desligou death_removes_modifiers), o par de apaixonados volta
	// junto - sem isso o revivido morreria de amor de novo no tick seguinte. E se o par já não tem CORPO
	// (limpo pelo lixeiro, carregado, ou nunca deixou um), o médico é recusado ANTES de gastar a recarga:
	// reviver alguém para cair morto no segundo seguinte pareceria defeito.
	bool try_revive(uint64 doctor_peer, uint64&out victim, float&out x, float&out y, uint64&out partner, string&out fail_key) {
		partner = 0;
		game_player@ d = find_player(doctor_peer);
		if (@d == null || !d.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		int i = body_index_near(d.x, d.y);
		if (i < 0) { fail_key = "role.no_body_near"; return false; }
		game_player@ morto = find_player(bodies[i].victim_peer_id);
		if (@morto == null || morto.left_match) { fail_key = "role.no_body_near"; return false; }
		if (elapsed_time - bodies[i].death_time > config.role_value(ROLE_DOCTOR, TUNABLE_WINDOW)) { fail_key = "role.revive_too_late"; return false; }
		// Regra antiga: o par morto precisa ter corpo para voltar junto.
		int corpo_do_par = -1;
		game_player@ par = morto.lover != 0 ? find_player(morto.lover) : null;
		bool par_morto = @par != null && !par.alive && !par.swallowed();
		if (par_morto) {
			for (uint b = 0; b < bodies.length(); b++) if (bodies[b].victim_peer_id == par.peer_id) corpo_do_par = int(b);
			if (corpo_do_par < 0) { fail_key = "role.revive_lover_gone"; return false; }
		}
		victim = morto.peer_id;
		x = bodies[i].x;
		y = bodies[i].y;
		morto.alive = true;
		morto.swallowed_by = 0;
		morto.x = x;
		morto.y = y;
		if (par_morto) {
			par.alive = true;
			par.x = bodies[corpo_do_par].x;
			par.y = bodies[corpo_do_par].y;
			partner = par.peer_id;
		}
		// Os dois corpos saem; o de índice maior primeiro, para o outro índice continuar valendo.
		if (corpo_do_par > i) { bodies.remove_at(corpo_do_par); bodies.remove_at(i); }
		else { bodies.remove_at(i); if (corpo_do_par >= 0) bodies.remove_at(corpo_do_par); }
		return true;
	}

	// A morte tira os modificadores: o par de apaixonados e a velocidade (Flash, Gigante). Decisão do
	// usuário, 2026-10-17. Antes o médico trazia o casal inteiro de volta, e o lixeiro que limpasse o corpo
	// do par matava o revivido de novo; agora quem volta, volta sozinho e na velocidade normal - um nerf
	// leve no médico, que em troca pode reviver quem só morreu de coração partido e não sabe quem matou.
	// O engolido não está morto (pode voltar) e fica com os dele. Chamada a cada tick, ANTES de
	// take_heartbreaks: o par vivo ainda aponta para o morto e morre de amor nesse mesmo tick; o dele sai
	// no seguinte.
	void strip_dead_modifiers() {
		if (!config.death_removes_modifiers) return; // a sala escolheu a regra antiga
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.alive || p.swallowed()) continue;
			p.lover = 0;
			p.speed_modifier = "";
			p.trait_modifier = "";
		}
	}

	// --- Modificadores ---

	// Quem ainda pode receber ESTE modificador. UM modificador por pessoa, no total - par, velocidade ou
	// traço (decisão do usuário, 2026-10-21; até ali dava para sair Flash, apaixonado e isca ao mesmo
	// tempo). Bot nunca recebe. Isca e lanterninha nunca saem para o time impostor: o lanterninha seria
	// vantagem no apagão que ele mesmo causa, e a isca não tem sentido num impostor (decisão do usuário).
	// O doente pode: quem o matar - o xerife - espera o dobro.
	private bool modifier_fits(game_player@ p, const string&in mod) const {
		if (p.is_bot || p.lover != 0 || p.speed_modifier != "" || p.trait_modifier != "") return false;
		if ((mod == MOD_TORCH || mod == MOD_BAIT) && p.role().team == TEAM_IMPOSTOR) return false;
		return true;
	}

	// Sorteia os modificadores depois dos papéis, entre os HUMANOS. Cada vaga rola a própria chance, como
	// as dos papéis, e o que não couber simplesmente não sai. Os casais primeiro: cada um precisa de DUAS
	// pessoas livres, e sorteados por último quase nunca achariam.
	void assign_modifiers() {
		int casais = config.role_count(MOD_LOVERS);
		for (int n = 0; n < casais; n++) {
			if (random(1, 100) > config.role_chance(MOD_LOVERS)) continue;
			array<game_player@> livres;
			for (uint i = 0; i < players.length(); i++)
				if (modifier_fits(players[i], MOD_LOVERS)) livres.insert_last(players[i]);
			if (livres.length() < 2) break;
			int a = random(0, livres.length() - 1);
			game_player@ pa = livres[a];
			livres.remove_at(a);
			// Nunca os DOIS impostores (decisão do usuário, 2026-10-22): eles já se conhecem e já vencem
			// juntos, e o casal não acrescentaria nada além de confundir a vitória dele. A graça é o casal
			// dividido - impostor e tripulante. Com o primeiro impostor, o par sai de quem não é.
			if (pa.is_impostor) {
				for (int k = int(livres.length()) - 1; k >= 0; k--) if (livres[k].is_impostor) livres.remove_at(k);
				if (livres.length() == 0) break;
			}
			game_player@ pb = livres[random(0, livres.length() - 1)];
			pa.lover = pb.peer_id;
			pb.lover = pa.peer_id;
			pa.lover_at_start = pb.peer_id;
			pb.lover_at_start = pa.peer_id;
		}
		array<string> um_por_vez = {MOD_FLASH, MOD_GIANT};
		for (uint t = 0; t < TRAIT_MODIFIER_IDS.length(); t++) um_por_vez.insert_last(TRAIT_MODIFIER_IDS[t]);
		for (uint m = 0; m < um_por_vez.length(); m++) {
			string mod = um_por_vez[m];
			int vagas = config.role_count(mod);
			for (int n = 0; n < vagas; n++) {
				if (random(1, 100) > config.role_chance(mod)) continue;
				array<game_player@> livres;
				for (uint i = 0; i < players.length(); i++)
					if (modifier_fits(players[i], mod)) livres.insert_last(players[i]);
				if (livres.length() == 0) break;
				game_player@ quem = livres[random(0, livres.length() - 1)];
				if (mod == MOD_FLASH || mod == MOD_GIANT) quem.speed_modifier = mod;
				else quem.trait_modifier = mod;
			}
		}
	}

	// O casal sobra: os dois vivos e, no máximo, mais uma pessoa.
	bool lovers_win_now() const {
		if (alive_count() > 3) return false;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].lover == 0 || !players[i].alive) continue;
			game_player@ par = find_player(players[i].lover);
			if (@par != null && par.alive) return true;
		}
		return false;
	}

	// Quem morre de amor: o apaixonado vivo cujo par morreu (engolido não é morto - pode voltar). Só com
	// a partida andando: morto na mesa (palpite, expulsão), o par cai quando a reunião acaba, e não na
	// mesa - um corpo deixado ali seria reportado pela reunião seguinte inteira. Cada um vira corpo onde
	// está, e a lista volta para o servidor avisar.
	array<uint64>@ take_heartbreaks() {
		strip_dead_modifiers();
		array<uint64> mortos;
		if (state != "in_progress" || winner != "") return mortos;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.lover == 0 || !p.alive) continue;
			game_player@ par = find_player(p.lover);
			if (@par == null || par.alive || par.swallowed()) continue;
			p.alive = false;
			body_info body;
			body.id = "body_" + p.peer_id;
			body.victim_peer_id = p.peer_id;
			body.x = p.x;
			body.y = p.y;
			body.room_id = map.room_id_at(p.x, p.y);
			body.death_time = elapsed_time;
			body.killer_peer_id = p.peer_id; // sem assassino: o rastro do detetive nasce vazio
			bodies.insert_last(body);
			mortos.insert_last(p.peer_id);
			// Morrer de amor é mais uma saída do jogo, e toda saída abre a barriga e larga o corpo
			// carregado. Esta tinha ficado de fora: o lobo apaixonado morria e quem ele tinha engolido
			// ficava preso numa barriga que não existia mais, até o fim da partida.
			release_belly(p, p.x, p.y);
			net_packet@ largado = drop_carried_body(p);
			if (@largado != null) pending_events.insert_last(largado);
		}
		return mortos;
	}
}
