// state_ship.nvgt
// A nave: portas, sabotagens e seus painéis, câmeras.
//
// Parte do game_state (src/core/game_state.nvgt), como `mixin class`: o AngelScript não tem classe parcial, e o mixin
// é o jeito de a mesma classe morar em vários arquivos. Os métodos daqui enxergam os campos e os
// métodos de todas as outras partes, e não compilam sozinhos - quem inclui é o game_state.nvgt.

mixin class state_ship_part {
	// --- Portas ---
	// Tranca as portas de uma sala, prendendo quem está lá dentro e deixando de fora quem está fora (ver
	// game_map.door_blocks). Não tem conserto: reabrem sozinhas quando o tempo acaba. É de
	// propósito que isso não passe pelo sistema de sabotagem - poder fechar a porta da elétrica E
	// apagar a luz ao mesmo tempo é justamente o que torna a jogada interessante.
	//
	// Quem pode é a MESMA pergunta que oferece a tecla (player_abilities.can_close_doors): o impostor
	// morto também fecha, como no original - escrita aqui à parte, a trava de "vivo" já divergiu.
	bool close_doors_of_room(uint64 impostor_peer, const string&in room_id, array<string>@&out closed_zones) {
		@closed_zones = array<string>();
		if (state != "in_progress") return false;
		game_player@ impostor = find_player(impostor_peer);
		if (@impostor == null || !player_abilities(impostor.role(), impostor.alive, impostor.swallowed()).can_close_doors()) return false;
		if (config.game_mode != GAME_MODE_CLASSIC) return false; // os modos não têm sabotagem, e trancar porta é uma delas
		if (doors_cooldown_remaining > 0.0) return false;

		if (!map.room_can_be_locked(room_id)) return false;

		closed_zones.insert_last(room_id);
		map.close_doors(closed_zones, map.doors_closed_seconds());
		doors_cooldown_remaining = DOORS_COOLDOWN_SECONDS;
		return true;
	}

	// Abrir uma sala trancada pelo painel da porta (a Base Polar). Quem pode: qualquer um VIVO e livre - o
	// tripulante preso com o impostor foge, quem está fora entra, e o próprio impostor também abre (no
	// original a porta não pergunta quem é). A distância tem folga, como a dos painéis de sabotagem: a
	// posição que o servidor tem vive um pouco atrasada.
	bool open_door_by_panel(uint64 peer_id, const string&in room_id, array<string>@&out opened) {
		@opened = array<string>();
		if (state != "in_progress" || !map.doors_have_panel) return false;
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive || p.swallowed()) return false;
		if (!map.is_door_closed(room_id)) return false;
		if (map.door_panel_at(p.x, p.y, DOOR_PANEL_RANGE * 2.0) != room_id) return false;
		opened.insert_last(room_id);
		map.open_doors(opened);
		return true;
	}

	// --- A câmara de descontaminação (a Base Polar) ---
	// Quem entra fica preso: a câmara se TRANCA por DECONTAMINATION_SECONDS, como uma porta trancada pelo
	// impostor - quem está dentro não sai, quem está fora não entra, e abre sozinha. É a mesma porta, e
	// por isso a mesma regra de passo (door_blocks) nos dois lados, sem nada novo no movimento. Quem chega
	// durante a rodada espera do lado de fora e ganha a rodada inteira dele depois: entrar no meio e ficar
	// preso um segundo só, pela rodada de outro, não faria sentido (o usuário, 2026-10-19). Quem entra
	// junto divide a rodada - e fica preso junto, inclusive com o impostor.
	void tick_decontamination(array<net_packet@>@ events) {
		string camara = map.decontamination_zone;
		if (camara == "") return;
		// Quem já passou deixa de ser "já passou" ao sair da câmara (ou morrer, ou sumir).
		for (int i = int(decontaminated_peers.length()) - 1; i >= 0; i--) {
			game_player@ p = find_player(decontaminated_peers[i]);
			if (@p == null || !p.alive || map.room_id_at(p.x, p.y) != camara) decontaminated_peers.remove_at(i);
		}
		if (map.is_door_closed(camara)) return; // rodando (ou trancada pelo impostor)
		array<uint64> dentro;
		bool alguem_novo = false;
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			// Fantasma não é preso (atravessa porta), e quem está no duto não está na sala.
			if (!p.alive || p.vented || p.swallowed() || map.room_id_at(p.x, p.y) != camara) continue;
			dentro.insert_last(p.peer_id);
			if (decontaminated_peers.find(p.peer_id) < 0) alguem_novo = true;
		}
		// Só começa rodada nova com a câmara livre de quem acabou de passar: senão quem entra atrás
		// prenderia de novo quem ainda está saindo. Quem entrar nesse meio-tempo passa junto com eles.
		bool saindo = false;
		for (uint i = 0; i < dentro.length(); i++) if (decontaminated_peers.find(dentro[i]) >= 0) saindo = true;
		if (!alguem_novo) return;
		for (uint i = 0; i < dentro.length(); i++) if (decontaminated_peers.find(dentro[i]) < 0) decontaminated_peers.insert_last(dentro[i]);
		if (saindo) return;
		array<string> zonas = {camara};
		map.close_doors(zonas, DECONTAMINATION_SECONDS);
		net_packet@ pkt = build_doors_packet(zonas, true);
		pkt.set_bool("decontamination", true); // o cliente toca o spray em vez do "portas trancadas"
		events.insert_last(pkt);
	}

	net_packet@ build_doors_packet(array<string>@ zones, bool closed) const {
		json_array@ list = json_array();
		for (uint i = 0; i < zones.length(); i++) list.add(zones[i]);
		net_packet@ pkt = net_packet(S_DOORS_STATE);
		pkt.set_bool("closed", closed);
		pkt.set_array("zones", list);
		// A recarga de trancar portas, que é da nave e não de um impostor: com ela o F do impostor diz
		// "portas em recarga" na hora, como a sabotagem, em vez de abrir a lista de salas para o servidor
		// recusar depois da escolha (pedido do usuário, 2026-10-16). Cliente antigo ignora o campo.
		pkt.set_float("doors_cooldown", doors_cooldown_remaining);
		return pkt;
	}

	// --- Sabotagem ---
	// Sabotagem crítica = tem relógio e é derrota dos tripulantes se o tempo acabar. As outras duram
	// até alguém consertar o painel.
	bool is_critical_sabotage(const string&in sabotage_id) const {
		return sabotage_id == "oxygen" || is_hold_sabotage(sabotage_id);
	}

	bool trigger_sabotage(uint64 impostor_peer, const string&in sabotage_id, net_packet@&out out_event, string&out fail_key) {
		fail_key = "game.sabotage_unavailable";
		game_player@ impostor = find_player(impostor_peer);
		// Não exige estar VIVO: o impostor morto continua sabotando, como no jogo original. É o que
		// lhe resta - matar, ventilar e fechar portas acabam com ele -, e sem isso morrer cedo como
		// impostor era virar espectador. Ver can_sabotage em game/roles/role_traits.nvgt.
		if (@impostor == null || !impostor.is_impostor) return false;
		// Morto sabota; engolido não - está preso, não livre pela nave (ver player_abilities).
		if (impostor.swallowed()) return false;
		if (!config.sabotages_enabled) return false; // preset "rápido" desliga sabotagem (ver config/presets.nvgt)
		// Só as que têm painel NESTE mapa: sem painel não há conserto, e o impostor ganharia só por escolher.
		if (!map.has_sabotage(sabotage_id)) return false;
		if (state != "in_progress") return false;
		if (active_sabotage != "") return false;
		if (sabotage_cooldown_remaining > 0.0) return false;
		// Sem isto o impostor martelava a MESMA sabotagem a partida inteira, que é o jeito mais
		// chato de jogar: a tripulação decora o caminho de um painel só e nada mais acontece.
		if (sabotage_id == last_sabotage_id) { fail_key = "game.sabotage_repeat"; return false; }
		// Sabotagem de segurar com alguém de versão anterior na partida: ele não saberia consertar.
		if (is_hold_sabotage(sabotage_id)) {
			for (uint i = 0; i < players.length(); i++) {
				if (!players[i].is_bot && players[i].protocol_version < HOLD_SABOTAGE_PROTOCOL) { fail_key = "game.sabotage_needs_update"; return false; }
			}
		}

		active_sabotage = sabotage_id;
		last_sabotage_id = sabotage_id;
		sabotage_fixed_panels.resize(0);
		clear_sabotage_holds();
		sabotage_timer = is_critical_sabotage(sabotage_id) ? SABOTAGE_OXYGEN_TIMER_SECONDS : 0.0;
		// Começa marcando o próprio total como "já anunciado", por dois motivos: a segunda sabotagem
		// crítica da partida não herda o número da primeira (o que faria ela pular avisos até passar
		// por baixo dele), e o total não é repetido logo de cara - o aviso de sabotagem iniciada já
		// diz "você tem 90 segundos", e o lembrete viria em cima, dizendo a mesma coisa duas vezes.
		last_sabotage_countdown = int(sabotage_timer);

		oxygen_code = "";
		if (sabotage_id == "oxygen") {
			for (uint i = 0; i < 5; i++) oxygen_code += "" + random(0, 9);
		}

		fail_key = "";
		@out_event = net_packet(S_SABOTAGE_STARTED);
		out_event.set_string("sabotage_id", sabotage_id);
		out_event.set_float("timer", sabotage_timer);
		out_event.set_bool("critical", is_critical_sabotage(sabotage_id));
		// O código vai para todos: ele não é segredo, é trabalho. O que custa é chegar ao painel e
		// digitar - e os dois painéis ficam em salas opostas.
		out_event.set_string("oxygen_code", oxygen_code);
		return true;
	}

	// Tenta ocupar o posto de câmeras. Devolve "" se conseguiu, ou a chave do motivo da recusa.
	//
	// As comunicações sabotadas derrubam as câmeras: é a mesma sabotagem que já tira radar,
	// marcadores e aviso de corpo, e sem isso o posto seria o único ponto do jogo que o impostor não
	// tem como cegar antes de agir.
	string try_enter_cameras(uint64 peer_id) {
		if (state != "in_progress") return "camera.unavailable";
		if (active_sabotage == "comms") return "camera.comms_down";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) return "camera.unavailable"; // fantasma não opera equipamento
		if (camera_user_peer != 0 && camera_user_peer != peer_id) return "camera.busy";
		camera_user_peer = peer_id;
		if (camera_room_id == "") camera_room_id = map.start_room; // a sala por onde o mapa começa
		return "";
	}

	// Libera o posto se for este jogador que o ocupa. Chamado de MUITOS lugares - sair, morrer,
	// desconectar, reunião começar, comunicações caírem - porque um posto que fica preso a alguém
	// que já saiu bloquearia as câmeras para o resto da partida.
	bool release_cameras(uint64 peer_id) {
		if (camera_user_peer == 0 || camera_user_peer != peer_id) return false;
		camera_user_peer = 0;
		camera_room_id = "";
		return true;
	}

	// Libera seja quem for e devolve QUEM foi liberado (0 = não havia ninguém). Usado quando a
	// partida muda de fase ou a sabotagem derruba tudo.
	//
	// Devolve o peer, e não um sim/não, porque quem estava observando precisa ser avisado: o posto
	// fechar só no servidor deixava o cliente dele achando que ainda está na câmera - parado, surdo
	// para o próprio entorno e sem conseguir andar. Um estado que só existe de um lado é um jogador
	// travado.
	uint64 release_cameras_any() {
		if (camera_user_peer == 0) return 0;
		uint64 quem = camera_user_peer;
		camera_user_peer = 0;
		camera_room_id = "";
		return quem;
	}

	int required_panels_for(const string&in sabotage_id) const {
		return sabotage_id == "oxygen" || is_hold_sabotage(sabotage_id) ? 2 : 1;
	}

	// --- Sabotagem de segurar (o sismógrafo) ---
	// Duas pessoas com a mão nos dois painéis ao mesmo tempo, por SABOTAGE_HOLD_TOGETHER_SECONDS. O
	// cliente só diz "pus"/"tirei" (C_SABOTAGE_HOLD); quem decide que estabilizou é o tick daqui, que vê
	// as duas mãos. E quem SOLTA quem não pode mais segurar (morreu, saiu, reunião, se afastou) também é
	// o tick, e só ele: um lugar só para desfazer, em vez de um em cada caminho de saída - a lição da
	// câmera e do duto (estado que existe nos dois lados).

	void clear_sabotage_holds() {
		sabotage_hold_panels.resize(0);
		sabotage_hold_peers.resize(0);
		sabotage_hold_together = 0.0;
	}

	// Quem segura este painel agora (0 = ninguém).
	uint64 sabotage_hold_holder(const string&in object_id) const {
		int i = sabotage_hold_panels.find(object_id);
		return i < 0 ? 0 : sabotage_hold_peers[i];
	}

	private net_packet@ sabotage_hold_packet(const string&in object_id, bool holding, uint64 peer_id) {
		net_packet@ pkt = net_packet(S_SABOTAGE_HOLD);
		pkt.set_string("object_id", object_id);
		pkt.set_bool("holding", holding);
		pkt.set_uint64("peer_id", peer_id);
		return pkt;
	}

	// Pôr (holding) ou tirar a mão. Devolve true se algo mudou, com o pacote para a partida inteira.
	bool set_sabotage_hold(uint64 peer_id, const string&in object_id, bool holding, net_packet@&out out_event, string&out fail_key) {
		fail_key = "";
		int ja = sabotage_hold_peers.find(peer_id);
		if (!holding) {
			// Tirar não pede validação nenhuma: soltar sempre pode, e sem estar segurando não há o que fazer.
			if (ja < 0 || sabotage_hold_panels[ja] != object_id) return false;
			sabotage_hold_panels.remove_at(ja);
			sabotage_hold_peers.remove_at(ja);
			@out_event = sabotage_hold_packet(object_id, false, peer_id);
			return true;
		}
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) return false;
		map_object@ obj = map.find_object(object_id);
		if (@obj == null || obj.obj_type != OBJ_SABOTAGE_PANEL) return false;
		if (active_sabotage == "") { fail_key = "sabotage.no_active"; return false; }
		if (obj.task_type != active_sabotage || !is_hold_sabotage(active_sabotage)) { fail_key = "sabotage.wrong_panel"; return false; }
		if (distance_2d(p.x, p.y, obj.x, obj.y) > PLAYER_INTERACT_RANGE * 2.0) { fail_key = "sabotage.too_far"; return false; }
		uint64 dono = sabotage_hold_holder(object_id);
		if (dono == peer_id) return false;
		if (dono != 0) { fail_key = "sabotage.hold_panel_busy"; return false; }
		// Uma mão por pessoa: segurar outro painel solta o anterior (não acontece andando, mas o pacote
		// vem da máquina do jogador).
		if (ja >= 0) { sabotage_hold_panels.remove_at(ja); sabotage_hold_peers.remove_at(ja); }
		sabotage_hold_panels.insert_last(object_id);
		sabotage_hold_peers.insert_last(peer_id);
		@out_event = sabotage_hold_packet(object_id, true, peer_id);
		return true;
	}

	void tick_sabotage_hold(float delta_seconds, array<net_packet@>@ events) {
		if (sabotage_hold_panels.length() == 0 && sabotage_hold_together == 0.0) return;
		if (active_sabotage == "" || !is_hold_sabotage(active_sabotage)) { clear_sabotage_holds(); return; }
		for (int i = int(sabotage_hold_panels.length()) - 1; i >= 0; i--) {
			game_player@ p = find_player(sabotage_hold_peers[i]);
			map_object@ obj = map.find_object(sabotage_hold_panels[i]);
			bool fica = @p != null && p.alive && state == "in_progress" && @obj != null
				&& distance_2d(p.x, p.y, obj.x, obj.y) <= PLAYER_INTERACT_RANGE * 2.0;
			if (fica) continue;
			events.insert_last(sabotage_hold_packet(sabotage_hold_panels[i], false, sabotage_hold_peers[i]));
			// O bot que perdeu o painel (a reunião o levou embora) volta a reagir à sabotagem do zero.
			if (@p != null && p.is_bot) { p.bot_fixing = false; p.bot_has_target = false; p.bot_action_timer = 0.0; }
			sabotage_hold_panels.remove_at(i);
			sabotage_hold_peers.remove_at(i);
		}
		if (int(sabotage_hold_panels.length()) < required_panels_for(active_sabotage)) { sabotage_hold_together = 0.0; return; }
		sabotage_hold_together += delta_seconds;
		if (sabotage_hold_together < SABOTAGE_HOLD_TOGETHER_SECONDS) return;
		// Estabilizou: o mesmo fim de sabotagem do conserto por painel.
		net_packet@ fim = net_packet(S_SABOTAGE_FIXED);
		fim.set_string("sabotage_id", active_sabotage);
		events.insert_last(fim);
		active_sabotage = "";
		sabotage_fixed_panels.resize(0);
		clear_sabotage_holds();
		sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
	}

	// panels_fixed/panels_required saem preenchidos mesmo quando ainda falta painel (pra dar feedback
	// de progresso pra quem consertou parcialmente - ver network/server.on_interact) - só quando o
	// ÚLTIMO painel necessário é consertado é que out_event vem preenchido e o retorno é true.
	bool try_fix_sabotage_panel(uint64 peer_id, const string&in object_id, net_packet@&out out_event, int&out panels_fixed, int&out panels_required, string&out fail_key) {
		panels_fixed = 0;
		panels_required = 0;
		fail_key = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) return false;

		map_object@ obj = map.find_object(object_id);
		if (@obj == null || obj.obj_type != OBJ_SABOTAGE_PANEL) return false; // nem é painel: nada a explicar
		// Daqui pra baixo o jogador REALMENTE tentou consertar um painel, então toda saída sai com um
		// motivo - antes qualquer um desses casos falhava calado e o painel parecia simplesmente
		// quebrado (o cliente até tocava o som de abrir o painel e nada acontecia).
		if (active_sabotage == "") { fail_key = "sabotage.no_active"; return false; }
		if (obj.task_type != active_sabotage) { fail_key = "sabotage.wrong_panel"; return false; }
		// Painel de SEGURAR não se conserta sozinho: é o tick que estabiliza, com as duas mãos.
		if (is_hold_sabotage(active_sabotage)) return false;
		// A posição que o servidor tem vem do canal não confiável e vive um pouco atrasada, então
		// aqui a distância é conferida com folga - conferir com o valor exato fazia o conserto falhar
		// de forma aleatória mesmo com o jogador colado no painel (mesmo motivo do botão de reunião).
		if (distance_2d(p.x, p.y, obj.x, obj.y) > PLAYER_INTERACT_RANGE * 2.0) { fail_key = "sabotage.too_far"; return false; }

		// Este painel já foi consertado por alguém (o oxigênio pede dois, e nada impedia de voltar ao
		// mesmo): dizer isso é o que evita a pessoa digitar o código de novo achando que está ajudando.
		if (sabotage_fixed_panels.find(object_id) != -1) { fail_key = "sabotage.panel_already_fixed"; return false; }
		sabotage_fixed_panels.insert_last(object_id);
		panels_fixed = int(sabotage_fixed_panels.length());
		panels_required = required_panels_for(active_sabotage);
		if (panels_fixed < panels_required) return false;

		@out_event = net_packet(S_SABOTAGE_FIXED);
		out_event.set_string("sabotage_id", active_sabotage);
		active_sabotage = "";
		sabotage_fixed_panels.resize(0);
		sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
		return true;
	}

	// Conserto REMOTO da sabotagem inteira, de onde quer que o jogador esteja (habilidade do
	// engenheiro). Resolve TODOS os painéis que faltavam de uma vez - resolver um só deixaria o
	// engenheiro atravessando a nave para o outro, que é exatamente o que a habilidade evita.
	//
	// Não é try_fix_sabotage_panel com a distância relaxada: aquele é o conserto NORMAL, que exige
	// estar no painel, e as duas coisas têm regras diferentes de propósito. O que elas compartilham
	// é o efeito, e por isso o pacote de fim de sabotagem é o MESMO (S_SABOTAGE_FIXED): o resto do
	// jogo não precisa saber por que a sabotagem acabou.
	//
	// Quem conserta daqui precisa estar VIVO: a habilidade não está na lista das que sobrevivem à
	// morte, e o fantasma não opera equipamento (mesma regra do scanner e da câmera).
	bool try_remote_fix_sabotage(uint64 peer_id, net_packet@&out out_event, string&out fail_key) {
		fail_key = "";
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) { fail_key = "game.ghost_cannot_interact"; return false; }
		if (active_sabotage == "") { fail_key = "sabotage.no_active"; return false; }

		@out_event = net_packet(S_SABOTAGE_FIXED);
		out_event.set_string("sabotage_id", active_sabotage);
		active_sabotage = "";
		sabotage_fixed_panels.resize(0);
		sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
		return true;
	}
}
