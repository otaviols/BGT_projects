// player.nvgt
// Estado de um jogador durante uma partida (compartilhado entre servidor e cliente).
// Posição é client-authoritative (o cliente informa via C_MOVE), o servidor só valida limites
// de velocidade (ver PLAYER_MAX_SPEED_TOLERANCE) e retransmite aos demais.

#include "../config/game_constants.nvgt"
#include "../config/colors.nvgt"
#include "../game/roles/role_traits.nvgt"

class player_task {
	// O ponto da fase ATUAL - ele muda quando a tarefa avança (ver game_state.advance_task).
	string object_id;
	string task_type;
	bool completed = false;
	// Tarefa de várias fases (ver task_chain em game/map.nvgt). phase_count = 1 é o caso comum.
	uint phase = 0;
	uint phase_count = 1;
	// Os pontos desta tarefa, na ordem, PARA ESTE JOGADOR. Vazio quando a tarefa tem uma fase só.
	//
	// Mora aqui, e não no mapa, porque um tipo pode ter mais de uma corrente: abastecer os motores
	// leva o galão ao reator OU ao motor leste, sorteado por jogador. Antes o destino saía de
	// `map.chain_object_at(tipo, fase)`, que é global - dois jogadores com a mesma tarefa iam
	// obrigatoriamente ao mesmo lugar, e a rota virava informação de graça para quem deduz.
	array<string> chain;

	// O ponto da fase `fase` na corrente deste jogador, ou "" se ele não a conhece. Servidor e
	// cliente perguntam AQUI: o cliente calculava o destino pelo mapa, que só sabe da primeira
	// corrente, e mandava ao reator quem o servidor tinha sorteado para o motor leste. A tarefa
	// então nunca fechava - o servidor esperava o galão num lugar e ele era entregue no outro.
	string chain_object(uint fase) const {
		return fase < chain.length() ? chain[fase] : "";
	}
}

class game_player {
	uint64 peer_id;
	string username;
	bool authenticated = false;
	// Versão do protocolo que ESTE cliente declarou no login (0 = anterior ao campo). Fica na conexão
	// para o servidor poder decidir, por sala, o que oferecer a quem: uma sala com recurso que só o
	// cliente novo entende precisa saber quem é novo.
	int protocol_version = 0;
	// De onde este jogador entrou (ver client_platform_name). "unknown" = cliente anterior à 0.43.0,
	// que não dizia.
	string client_platform = "unknown";
	string lobby_id = "";
	int color = COLOR_RED;
	// A cor que ele ESCOLHEU na sala de espera (-1 = nenhuma). É separada de `color` porque `color` é
	// a da partida, decidida no início: numa sala que sorteia, a escolha fica guardada e não vale.
	// Zera ao entrar numa sala - o cliente reenvia a preferência dele, e uma escolha feita em outra
	// sala não pode ocupar cor nesta.
	int chosen_color = -1;
	float x = 0.0;
	float y = 0.0;
	uint32 last_move_seq = 0;
	bool alive = true;
	// Quem o engoliu (o Lobo Mau), ou 0. Engolido tem `alive = false` - e é isso que o tira de TUDO que
	// pergunta por vivo (contagem de vitória, votação, radar, alvo de kill) sem uma condição nova em
	// cada lugar. O que precisa de condição própria é o contrário: as liberdades do fantasma (andar,
	// fazer tarefa, ouvir os mortos), que o engolido não tem. Ver game_state.try_eat.
	uint64 swallowed_by = 0;
	bool swallowed() const { return swallowed_by != 0; }
	// O papel é a fonte; is_impostor é DERIVADO dele em set_role() e existe porque o resto do servidor
	// ainda pergunta pelo time em dezenas de lugares (contagem de vivos, vitória, alvo de kill). Os
	// dois nunca são escritos separados - é o que impede um shapeshifter de contar como tripulante.
	string role_id = ROLE_CREWMATE;
	bool is_impostor = false;
	bool vented = false;
	string current_vent_id = ""; // qual vent ele está "dentro" agora, só relevante enquanto vented
	float kill_cooldown_remaining = 0.0;
	// Recarga da habilidade do papel (ver role_traits.ability_id). Uma só, porque o papel tem uma só.
	float ability_cooldown_remaining = 0.0;
	// Escudo do anjo da guarda: enquanto maior que zero, nenhum ataque contra este jogador acontece
	// (ver try_kill). Ele NÃO sabe que está protegido, e ninguém mais sabe.
	float shield_remaining = 0.0;

	// Disfarce do shapeshifter: o nome com que ele aparece PARA OS OUTROS, e por quanto tempo ainda.
	// Vazio = ele mesmo. Tudo que conta um nome a outro jogador passa por display_name(), e é isso
	// que garante que o disfarce não tenha buracos - um único ponto esquecido entregaria a jogada.
	string disguise_name = "";
	float disguise_remaining = 0.0;

	// Invisibilidade do fantasma. Enquanto durar, este jogador é "presente mas imperceptível" - a
	// MESMA semântica de quem está dentro de um duto, e por isso pendurada nos mesmos três pontos
	// (players_in_room, on_move e on_voice_frame) em vez de espalhada em condições novas.
	float invisible_remaining = 0.0;
	bool invisible() const { return invisible_remaining > 0.0; }
	// Ele ESTAVA invisível e ainda não foi avisado de que voltou. Sem esta marca não dá para
	// distinguir "acabou de reaparecer" de "nunca sumiu": os dois têm o contador em zero, e o
	// servidor tocaria o som de volta para todo mundo, o tempo todo.
	bool was_invisible = false;
	uint meetings_called = 0;
	// Palpites que o sniper ainda tem NESTA reunião. Recarregado no começo de cada uma (ver
	// start_meeting), e não gasto por tentativa recusada - só por palpite que saiu.
	uint guesses_left = 0;
	int radar_index = -1;
	float last_move_time = 0.0;
	array<player_task> tasks;

	// Caiu no meio da partida. Ele continua no elenco (tirar quebraria a contagem de vivos que decide
	// quem venceu), mas para de contar pra tudo que depende de alguém estar jogando de verdade - as
	// tasks dele, principalmente: sem isso a vitória por tasks nunca acontecia, porque o jogo ficava
	// esperando pra sempre as tasks de quem não está mais lá.
	bool left_match = false;

	// Quer receber voz (C_VOICE_STATE). Falso até o cliente dizer o contrário: cliente antigo nunca
	// diz, e assim não recebe 128 kbps de áudio que não sabe tocar.
	bool voice_enabled = false;

	// A última lista de quem é perceptível perto dele que o servidor mandou (ver S_NEARBY_PLAYERS), para
	// só mandar de novo quando mudar. Vazia no começo de cada partida, e por isso a primeira sempre sai.
	array<uint64> nearby_sent;
	bool nearby_sent_once = false;

	// --- Bot ---
	// Bots são game_player normais em tudo (entram na contagem, recebem tasks, podem ser mortos,
	// expulsos e reportados); a diferença é que ninguém manda C_MOVE por eles e nenhum pacote é
	// enviado pra eles. Quem os move é game_state.tick_bots().
	bool is_bot = false;
	array<string> bot_path;          // ids de zona que ainda faltam percorrer até o destino
	string bot_target_object_id = ""; // objeto do destino atual ("" = está só passeando)
	float bot_target_x = 0.0;
	float bot_target_y = 0.0;
	bool bot_has_target = false;
	float bot_action_timer = 0.0;    // > 0: parado (fazendo uma task, pensando, ou esperando pra votar)
	bool bot_voted = false;
	float bot_broadcast_timer = 0.0;
	float bot_repath_timer = 0.0;   // só bot impostor: a presa se move, a rota tem que ser refeita
	string bot_target_zone = "";    // zona do destino atual, pra saber quando a rota realmente mudou
	// Bot impostor: está CAÇANDO alguém (e quem), ou fingindo fazer tarefa. Ver update_bot_impostor.
	bool bot_hunting = false;
	uint64 bot_prey_peer = 0;
	// O destino atual é um PAINEL de sabotagem (e não uma tarefa): chegando, o bot pede o conserto.
	bool bot_fixing = false;
	// Tempo de "reação" antes de agir sobre algo que ele percebeu (sabotagem começando, corpo no
	// chão). Sem isto os bots reagiriam no mesmo quadro, todos juntos - um reporte instantâneo em
	// cima de todo corpo, e toda sabotagem com a nave inteira correndo ao painel antes do alarme
	// terminar. -1 = nada pendente.
	float bot_sabotage_reaction = -1.0;
	float bot_report_reaction = -1.0;

	game_player(uint64 peer_id, const string&in username) {
		this.peer_id = peer_id;
		this.username = username;
	}

	// Aplica um movimento vindo do cliente, validando se a distância percorrida desde a última
	// posição conhecida é fisicamente possível no tempo decorrido (anti-cheat simples).
	// `speed` é a velocidade DA SALA (lobby_config.move_speed), a mesma que o cliente recebe para andar.
	bool try_move(float new_x, float new_y, float delta_seconds, float speed) {
		float dist = distance_2d(x, y, new_x, new_y);
		float max_dist = speed * delta_seconds * PLAYER_MAX_SPEED_TOLERANCE;
		if (dist > max_dist && delta_seconds > 0.0) return false;
		x = new_x;
		y = new_y;
		return true;
	}

	// Conta FASES, não tarefas: uma tarefa de duas fases vale dois passos na barra da equipe, como
	// no jogo original. Contar por tarefa faria a barra parar durante a travessia inteira - o
	// jogador andaria meia nave sem nada acontecer no placar.
	uint task_count() const {
		uint count = 0;
		for (uint i = 0; i < tasks.length(); i++) count += tasks[i].phase_count;
		return count;
	}

	uint completed_task_count() const {
		uint count = 0;
		for (uint i = 0; i < tasks.length(); i++) {
			count += tasks[i].completed ? tasks[i].phase_count : tasks[i].phase;
		}
		return count;
	}

	bool all_tasks_completed() const {
		if (tasks.length() == 0) return true;
		// Compara FASES com FASES: desde que uma tarefa possa valer mais de um passo, comparar com o
		// número de tarefas daria "tudo pronto" no meio de uma travessia.
		return completed_task_count() == task_count();
	}

	int task_progress_percent() const {
		uint total = task_count();
		if (total == 0) return 100;
		return int((completed_task_count() * 100) / total);
	}

	// `in_meeting`: a recarga da HABILIDADE fica parada durante a reunião - nem recarrega de graça na
	// discussão, nem recomeça ao sair (ver role_traits.ability_cooldown_resets_on_meeting). O cliente
	// faz a mesma pausa com movement_frozen, senão os dois relógios divergiriam a cada reunião.
	void tick_cooldowns(float delta_seconds, bool in_meeting) {
		if (kill_cooldown_remaining > 0.0) {
			kill_cooldown_remaining -= delta_seconds;
			if (kill_cooldown_remaining < 0.0) kill_cooldown_remaining = 0.0;
		}
		if (ability_cooldown_remaining > 0.0 && !in_meeting) {
			ability_cooldown_remaining -= delta_seconds;
			if (ability_cooldown_remaining < 0.0) ability_cooldown_remaining = 0.0;
		}
		if (shield_remaining > 0.0) {
			shield_remaining -= delta_seconds;
			if (shield_remaining < 0.0) shield_remaining = 0.0;
		}
		// O disfarce NÃO é desfeito aqui: quem o desfaz precisa avisar o jogador e tocar o som, e
		// isso é do servidor (ver tick_disguises). Aqui só o relógio anda. O mesmo vale para a
		// invisibilidade.
		if (disguise_remaining > 0.0) {
			disguise_remaining -= delta_seconds;
			if (disguise_remaining < 0.0) disguise_remaining = 0.0;
		}
		if (invisible_remaining > 0.0) {
			was_invisible = true; // quem zerar isto é quem AVISAR que ele voltou (expire_invisibility)
			invisible_remaining -= delta_seconds;
			if (invisible_remaining < 0.0) invisible_remaining = 0.0;
		}
	}

	bool can_kill() const {
		return role().can_kill && alive && kill_cooldown_remaining <= 0.0;
	}

	// O nome com que ESTE jogador aparece para os outros. Todo pacote que leva nome de alguém a
	// outra pessoa usa isto, nunca `username` direto: o radar, a câmera, a lista de quem está na
	// sala. Um ponto esquecido é um buraco no disfarce, e o sintoma seria o pior possível - o
	// shapeshifter descoberto por um caminho só, sem nada acusando no código.
	// Como ELE é chamado nesta partida, sem disfarce nenhum: o nome, ou - no modo cor - a marca da cor
	// dele. É o que vai onde o disfarce não vale (votação, alarme, a vítima ouvindo quem a matou) e
	// onde hoje ia `username` cru. Fora de partida `named_by_color` é falso e isto é só o nome.
	string public_name() const {
		return named_by_color ? color_mark(color) : username;
	}

	// O que os OUTROS ouvem agora: o disfarce, se houver; senão o public_name. No modo cor o disfarce
	// é a marca do alvo, então o metamorfo assume a COR de quem copiou - o mesmo papel, na mesma regra.
	string display_name() const {
		return disguise_name != "" ? disguise_name : public_name();
	}

	// Modo cor ligado para ESTE jogador nesta partida. Ligado no início (on_start_game), desligado em
	// reset_match_state - e é por isso que public_name vale em qualquer lugar do servidor sem
	// perguntar à sala: na sala de espera e no saguão ele volta a ser o nome.
	bool named_by_color = false;

	bool disguised() const { return disguise_name != ""; }

	void set_disguise(const string&in name, float seconds) {
		disguise_name = name;
		disguise_remaining = name != "" ? seconds : 0.0;
	}

	void set_role(const string&in id) {
		role_id = id;
		is_impostor = role_for(id).team == TEAM_IMPOSTOR;
	}

	role_traits@ role() const { return role_for(role_id); }

	// Apaga tudo que é de UMA partida, deixando o objeto pronto pra próxima. Isto existe porque o
	// game_player é o objeto de CONEXÃO: ele sobrevive à partida, à lobby, e vai junto com o jogador
	// pra sala seguinte. Qualquer coisa que ficar aqui vira herança indevida - já foi assim que quem
	// morria numa partida continuava "morto" (e mudo no chat) na lobby seguinte.
	void reset_match_state() {
		named_by_color = false;
		alive = true;
		swallowed_by = 0;
		nearby_sent.resize(0);
		nearby_sent_once = false;
		left_match = false;
		set_role(ROLE_CREWMATE);
		vented = false;
		current_vent_id = "";
		tasks.resize(0);
		kill_cooldown_remaining = 0.0;
		ability_cooldown_remaining = 0.0;
		shield_remaining = 0.0;
		disguise_name = "";
		disguise_remaining = 0.0;
		invisible_remaining = 0.0;
		was_invisible = false;
		meetings_called = 0;
		guesses_left = 0;
		radar_index = -1;
		last_move_time = 0.0;
		bot_has_target = false;
		bot_path.resize(0);
		bot_action_timer = 0.0;
		bot_voted = false;
		bot_fixing = false;
		bot_hunting = false;
		bot_prey_peer = 0;
		bot_sabotage_reaction = -1.0;
		bot_report_reaction = -1.0;
	}
}
