// sabotage_rules.nvgt
// Quem é atrapalhado por uma sabotagem, e quem não é.
//
// A regra em si mora nas capacidades do papel (game/roles/role_traits.nvgt); o que existe aqui são
// só os atalhos usados no meio da lógica do cliente, onde se tem `is_impostor` e `alive` à mão e
// escrever `player_abilities(...)` em cada linha deixaria a condição ilegível.
//
// A regra vive num lugar só porque ela aparece em muitos pontos - marcadores de tarefa, som dos
// corpos, radar, aviso de corpo por perto, alcance de audição. Espalhada como `if` em cada um
// desses lugares, bastava esquecer um para o jogador ficar cego em metade das coisas e enxergando
// na outra metade, sem que nada denunciasse a inconsistência.

#include "../game/roles/role_traits.nvgt"

// Uma sabotagem atrapalha ESTE jogador agora?
bool sabotage_affects(const string&in which, const string&in active, bool is_impostor, bool alive) {
	player_abilities me(role_from_flag(is_impostor), alive);
	if (which == "comms") return me.blinded_by_comms(active);
	if (which == "lights") return me.blinded_by_lights(active);
	return active == which && alive;
}

bool comms_down_for(const string&in active, bool is_impostor, bool alive) {
	return sabotage_affects("comms", active, is_impostor, alive);
}

bool lights_out_for(const string&in active, bool is_impostor, bool alive) {
	return sabotage_affects("lights", active, is_impostor, alive);
}

// O rádio (chat de voz) cai com as comunicações sabotadas - e esta é a ÚNICA regra de percepção em
// que o impostor NÃO tem imunidade. Com imunidade, durante o apagão de comunicações só ele
// conseguiria falar: quem abrisse a boca estaria se entregando, e a sabotagem viraria um detector
// de impostor em vez de uma cegueira. Fantasma continua conversando, como em toda sabotagem.
//
// Na REUNIÃO a sabotagem só alcança a voz se a sala tiver escolhido isso (regra
// `comms_affects_meeting`). A reunião precisa entrar aqui, e não ficar como um `if` no servidor:
// o cliente também decide se abre o microfone, e as duas decisões têm que ser a MESMA - foi por
// discordarem que a regra desligada continuava calando a reunião (o servidor deixava a voz passar,
// o cliente nem capturava).
bool voice_down_for(const string&in active, bool alive, bool in_meeting = false,
		bool comms_affects_meeting = false) {
	if (active != "comms" || !alive) return false;
	return !in_meeting || comms_affects_meeting;
}
