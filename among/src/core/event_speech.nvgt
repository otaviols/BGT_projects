// event_speech.nvgt
// O texto falado de cada evento da partida, num lugar só - e a entrega desses avisos para quem está
// numa TELA BLOQUEANTE (uma task, um painel de reparo, a caixa de mensagem).
//
// O problema que isto resolve: enquanto uma minigame está aberta, o laço principal não roda, então
// nada do que chega é dito. O jogador ficava surdo ao chat e aos anúncios até fechar a tela - e no
// caso do oxigênio isso custa a partida, porque a contagem inteira acontecia em silêncio.
//
// A regra é ANUNCIAR SEM CONSUMIR. O pacote continua na fila e o laço principal ainda vai tratá-lo
// com todos os efeitos dele (elenco, alarme, marcadores, beacons) - se a tela bloqueante o tirasse
// da fila para falar, esses efeitos se perderiam e o jogo ficaria dizendo coisas que não aconteceram.
// Para não falar duas vezes, o pacote é MARCADO (net_packet.announced) e quem fala depois pergunta
// antes. Foi decisão do jogador: ele é avisado do oxigênio, e escolhe se larga a task ou não - o
// jogo não decide por ele.
//
// O texto de cada evento mora aqui porque agora há dois lugares que o dizem. Duplicar o tr() nos
// dois seria a receita para eles divergirem no dia em que um deles mudasse.

#include "../network/client.nvgt"
#include "../network/protocol.nvgt"
#include "../i18n.nvgt"
#include "client_state.nvgt"
#include "speech.nvgt"
#include "../game/roles/role_traits.nvgt" // o nome do papel neutro no fim da partida

string sabotage_started_text(net_packet@ pkt) {
	string sabotage_id = pkt.get_string("sabotage_id");
	string text = tr("sabotage." + sabotage_id + ".name"); // o nome sai da própria chave, sem lista fixa
	// Sabotagem crítica (oxigênio) tem relógio e é derrota se ninguém consertar - dizer quanto tempo
	// existe é a diferença entre correr pro painel certo e não fazer ideia do que fazer. Tudo numa
	// fala só porque speak() interrompe a anterior.
	if (pkt.get_bool("critical")) {
		dictionary@ p = dictionary();
		p.set("seconds", "" + int(pkt.get_float("timer")));
		text += " " + tr("sabotage.critical_warning", p);
	}
	return text;
}

string sabotage_countdown_text(net_packet@ pkt) {
	dictionary@ p = dictionary();
	p.set("seconds", "" + pkt.get_int("seconds"));
	return tr(pkt.get_bool("final") ? "sabotage.countdown_final" : "sabotage.countdown_remaining", p);
}

string sabotage_fixed_text() {
	return tr("sabotage.fixed");
}

// "Você viu Fulano matar Beltrano." - só para quem estava colado na vítima (ver announce_kill). Os
// nomes chegam como a testemunha os vê: o disfarce do metamorfo, ou a marca de cor no modo cor, que o
// tr() resolve.
string kill_witnessed_text(net_packet@ pkt) {
	dictionary@ p = dictionary();
	p.set("killer", pkt.get_string("killer_name"));
	p.set("victim", pkt.get_string("victim_name"));
	return tr(pkt.get_bool("swallowed", false) ? "game.swallow_witnessed" : "game.kill_witnessed", p);
}

// "Você foi engolido pelo Lobo Mau, Fulano..." - só para o engolido. O nome é o verdadeiro (ver
// S_SWALLOWED): lá dentro ele só tem o próprio lobo a quem contar.
string swallowed_text(net_packet@ pkt) {
	dictionary@ p = dictionary();
	p.set("name", pkt.get_string("wolf_name"));
	return tr("role.you_were_swallowed", p);
}

// A volta de quem estava na barriga. Para quem voltou, "você saiu"; para os outros, QUEM voltou - é
// aqui que a nave descobre quem o lobo tinha engolido, e isso já não protege ninguém: o lobo caiu.
string belly_released_text(net_packet@ pkt, client_roster@ roster, uint64 my_peer) {
	json_array@ peers = pkt.get_array("peers");
	if (@peers == null || peers.length() == 0) return "";
	array<string> nomes;
	bool eu = false;
	for (uint i = 0; i < peers.length(); i++) {
		uint64 quem = uint64(peers[i]);
		if (quem == my_peer) { eu = true; continue; }
		roster_entry@ e = @roster != null ? roster.find(quem) : null;
		if (@e != null) nomes.insert_last(e.name);
	}
	string texto = eu ? tr("role.you_were_released") : "";
	if (nomes.length() > 0) {
		dictionary@ p = dictionary();
		p.set("names", join(nomes, ", "));
		string outros = tr(nomes.length() == 1 ? "role.released_one" : "role.released_many", p);
		texto = texto == "" ? outros : texto + " " + outros;
	}
	return texto;
}

// Quem venceu, para o anúncio e para a tela de resultado direm a MESMA coisa. Com um neutro vencendo
// sozinho, diz quem e com que papel ("Fulano, o Bobo da Corte, venceu!").
string game_winner_text(net_packet@ pkt) {
	string winner = pkt.get_string("winner");
	if (winner == "crewmates") return tr("game.crewmates_win");
	if (winner == "impostors") return tr("game.impostors_win");
	json_array@ neutros = pkt.get_array("neutrals");
	if (@neutros != null) {
		for (uint i = 0; i < neutros.length(); i++) {
			json_object@ n = neutros.get_object(i);
			if (@n == null || !bool(n["won"])) continue;
			dictionary@ p = dictionary();
			p.set("name", string(n["name"]));
			p.set("role", tr(role_for(string(n["role"])).name_key()));
			return tr("game.neutral_win", p);
		}
	}
	return tr("game.neutral_win_unknown");
}

// "Neutros: Fulano (Bobo da Corte)." - quem era neutro, revelado no fim, como os impostores. "" se
// não havia nenhum.
string game_neutrals_text(net_packet@ pkt) {
	json_array@ neutros = pkt.get_array("neutrals");
	if (@neutros == null || neutros.length() == 0) return "";
	array<string> partes;
	for (uint i = 0; i < neutros.length(); i++) {
		json_object@ n = neutros.get_object(i);
		if (@n == null) continue;
		partes.insert_last(string(n["name"]) + " (" + tr(role_for(string(n["role"])).name_key()) + ")");
	}
	dictionary@ p = dictionary();
	p.set("names", join(partes, ", "));
	return tr("game.neutrals_were", p);
}

string chat_message_text(net_packet@ pkt) {
	return spoken_name(pkt.get_string("name")) + ": " + pkt.get_string("text");
}

string player_left_text(net_packet@ pkt) {
	string name = pkt.get_string("name", "");
	if (name == "") return "";
	dictionary@ p = dictionary();
	p.set("name", name);
	return tr("lobby.player_left", p);
}

// "Você foi eliminado por fulano" - só para a vítima, e só ela recebe o nome do assassino.
string you_were_killed_text(net_packet@ pkt, client_roster@ roster) {
	uint64 killer_peer = pkt.get_uint64("killer_peer");
	// Quem matou é você mesmo: é o tiro errado do xerife, que morre no lugar de quem mirou. Dizer
	// "você foi eliminado por <seu nome>" seria ridículo; o porquê chega logo atrás, em particular
	// (role.sheriff_misfire, mandado pelo servidor só a ele).
	if (killer_peer == pkt.get_uint64("peer_id")) return tr("game.you_were_killed");
	// `killer_real_name` só vem na CÓPIA que o servidor manda à vítima (ver on_kill): quem morre para
	// o metamorfo descobre quem ele é de verdade, porque já pagou o preço e não tem como contar a
	// ninguém. O elenco, que hoje carrega o nome disfarçado, é o plano B.
	string nome = pkt.get_string("killer_real_name");
	if (nome == "" && @roster != null) {
		roster_entry@ killer = roster.find(killer_peer);
		if (@killer != null) nome = killer.name;
	}
	if (nome == "") return tr("game.you_were_killed");
	dictionary@ p = dictionary();
	p.set("name", nome);
	return tr("game.you_were_killed_by", p);
}

// "Fulano morreu na elétrica." - o alarme de quem anuncia a própria morte (ver role_noisemaker).
// Mora aqui, e não no laço da partida, porque dois lugares o dizem: o laço e as telas bloqueantes.
string death_alarm_text(net_packet@ pkt) {
	dictionary@ p = dictionary();
	p.set("name", pkt.get_string("name"));
	string room_key = pkt.get_string("room_key");
	p.set("room", room_key != "" ? tr(room_key) : tr("game.unknown_room"));
	return tr("role.noisemaker_alarm", p);
}

// "Alguém apontou Fulano como xerife, e acertou: Fulano morreu." - a morte na mesa, pelo palpite do
// sniper (ver S_MEETING_KILL no protocolo).
//
// Nunca diz QUEM apontou, e isso é a regra do papel, não um esquecimento: o custo do sniper é o
// risco de morrer errando, não ser descoberto ao acertar. No caso do erro a frase entrega ele de
// qualquer jeito, porque quem morreu FOI ele - e é a assimetria que faz o palpite ser uma aposta.
//
// Mora aqui, com os outros, porque dois lugares o dizem: o laço da partida e as telas bloqueantes.
string meeting_kill_text(net_packet@ pkt, client_roster@ roster) {
	dictionary@ p = dictionary();
	p.set("role", tr("role." + pkt.get_string("guessed_role")));
	string alvo = "";
	string morto = "";
	if (@roster != null) {
		roster_entry@ a = roster.find(pkt.get_uint64("target_peer"));
		roster_entry@ m = roster.find(pkt.get_uint64("victim_peer"));
		if (@a != null) alvo = a.name;
		if (@m != null) morto = m.name;
	}
	p.set("target", alvo);
	p.set("name", morto);
	return tr(pkt.get_bool("correct") ? "role.guess_hit" : "role.guess_miss", p);
}

// O resultado do exame do detetive, montado no idioma DESTE cliente.
//
// O servidor manda o número e as CHAVES das salas separadas por "|", nunca a frase pronta: numa
// partida com gente em idiomas diferentes, quem sabe o idioma de cada um é o cliente dele. É a
// mesma regra de todo o resto que vem do servidor - só que aqui a substituição é uma lista, e
// tr_server_message colocaria "room.electrical|room.storage" cru dentro da frase.
string examine_result_text(net_packet@ pkt) {
	dictionary@ p = pkt.get_params(MSG_PARAMS_FIELD);
	string chaves = "";
	p.get("rooms", chaves);
	if (chaves != "") {
		array<string>@ partes = chaves.split("|");
		array<string> nomes;
		for (uint i = 0; i < partes.length(); i++) {
			if (partes[i] != "") nomes.insert_last(tr(partes[i]));
		}
		p.set("rooms", join(nomes, ", "));
	}
	return tr(pkt.get_string(MSG_KEY_FIELD), p);
}

// O que uma tela bloqueante deve dizer por este pacote, ou "" se ele não é para ser anunciado ali.
//
// Fica de fora o que a própria tela já trata (reunião, corpo reportado e fim de partida cancelam a
// minigame) e tudo que não é para ser ouvido no meio de uma task - progresso das tarefas da equipe,
// posição de quem anda, resultado de radar.
string background_event_text(net_packet@ pkt, game_client@ client) {
	string t = pkt.type;
	if (t == S_CHAT_MESSAGE) return chat_message_text(pkt);
	if (t == S_SABOTAGE_STARTED) return sabotage_started_text(pkt);
	if (t == S_SABOTAGE_COUNTDOWN) return sabotage_countdown_text(pkt);
	if (t == S_SABOTAGE_FIXED) return sabotage_fixed_text();
	if (t == S_PLAYER_LEFT) return player_left_text(pkt);
	if (t == S_ERROR) return tr_server_message(pkt);
	if (t == S_SERVER_NOTICE) return tr_server_message(pkt); // o reinício tem que chegar até a quem está numa tarefa
	// O alarme é ouvido de onde quer que a pessoa esteja - inclusive de dentro de uma task, que é
	// justamente onde ela estaria quando o impostor escolheu matar longe de todos.
	if (t == S_DEATH_ALARM) return death_alarm_text(pkt);
	// Quem VIU o assassinato de perto precisa ouvir mesmo no meio de uma tarefa - é exatamente onde
	// alguém costuma estar quando o impostor mata ao lado.
	if (t == S_KILL_WITNESSED) return kill_witnessed_text(pkt);
	// Engolido no meio de uma tarefa: a tela precisa dizer onde ele foi parar, senão ele termina a
	// minigame achando que conta.
	if (t == S_SWALLOWED) return swallowed_text(pkt);
	if (t == S_BELLY_RELEASED) return belly_released_text(pkt, g_match_roster, @client != null ? client.my_peer_id : 0);
	// A morte na mesa precisa chegar a quem está com a lista de votação aberta - que é exatamente
	// onde todo mundo está quando ela acontece.
	if (t == S_MEETING_KILL) return meeting_kill_text(pkt, g_match_roster);
	// A morte só é anunciada para a própria vítima: para os outros, o assassinato é o som, não o texto.
	if (t == S_PLAYER_KILLED && @client != null && pkt.get_uint64("peer_id") == client.my_peer_id) {
		return you_were_killed_text(pkt, g_match_roster);
	}
	return "";
}

// Diz o que chegou enquanto uma tela bloqueante está aberta, SEM tirar nada da fila. Chamado uma vez
// por quadro por essas telas (ver task_tick em game/tasks/task_common.nvgt).
void announce_background_events(game_client@ client) {
	if (@client == null) return;
	for (uint i = 0; i < client.incoming.length(); i++) {
		net_packet@ pkt = client.incoming[i];
		// Cada pacote é examinado UMA vez: o custo por quadro passa a ser o dos que acabaram de
		// chegar, e não o da fila inteira - que é a armadilha que já travou o jogo uma vez.
		if (pkt.announce_checked) continue;
		pkt.announce_checked = true;
		string text = background_event_text(pkt, client);
		if (text == "") continue;
		pkt.announced = true; // o laço principal ainda vai tratá-lo; só não vai repetir a fala
		// Sem interromper: quem está no meio de uma task ouvindo tons não pode ter o tom cortado.
		// A exceção é a contagem final do oxigênio, onde um número atrasado é pior que um cortado.
		speak(text, pkt.type == S_SABOTAGE_COUNTDOWN && pkt.get_bool("final"));
		// E entra no histórico JÁ, para ser relido sem fechar a tela (ver chat_review em chat_log).
		if (@g_background_log_sink != null && !pkt.logged) {
			g_background_log_sink(pkt, text);
			pkt.logged = true;
		}
	}
}

// Quem guarda no histórico o que foi anunciado com uma tela aberta. Um gancho, e não a chamada direta,
// porque o histórico (chat_log) inclui este arquivo - ele se pendura aqui (ver chat_review).
funcdef void background_log_sink(net_packet@ pkt, const string&in text);
background_log_sink@ g_background_log_sink = null;
