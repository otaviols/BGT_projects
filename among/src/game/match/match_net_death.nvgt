// match_net_death.nvgt
// Mortes: a própria, a testemunhada, o alarme do faz-barulho.
//
// Parte da match_session (src/game/game_loop.nvgt), como `mixin class`: um método por mensagem do
// servidor, chamado por handle_packet. Enxerga todos os campos da partida; não compila sozinho.

mixin class match_net_death_part {
	void on_player_killed(net_packet@ pkt) {
		mui.on_player_killed(pkt);
		// O corpo entra na lista ANTES de apply_sabotage_effects, logo abaixo: ele refaz os marcadores a
		// partir dela, e com o corpo ainda de fora quem morria parava de ouvir o próprio corpo até a lista
		// ser refeita por outro motivo.
		known_body_peers.insert_last(pkt.get_uint64("peer_id"));
		known_body_positions.insert_last(vector(pkt.get_float("x"), pkt.get_float("y"), 0.0));
		if (pkt.get_uint64("peer_id") == client.my_peer_id) {
			alive = false;
			mui.alive = false;
			// Virou fantasma: sabotagem não atinge morto, então o que estava ligado sai agora.
			apply_sabotage_effects(audio, mui, map, my_task_object_ids, active_sabotage_id,
				my_role, alive, known_body_peers, known_body_positions);
				// Dizer QUEM matou: no Among Us original a vítima vê o assassino, e aqui isso não vaza
			// nada pros vivos - morto não manda mensagem no chat nem vota (o servidor recusa os
			// dois). Sem o nome, "você foi eliminado" não dizia nada pra quem levou a facada.
			string killed_text = you_were_killed_text(pkt, roster);
			if (!pkt.announced) speak(killed_text);
			events_log.add("", killed_text);
		}
		if (pkt.get_uint64("killer_peer") == client.my_peer_id) my_kill_cooldown_remaining = kill_cooldown_config;
	}

	// O alarme toca SEM posição, para a nave inteira: ele não marca um lugar - a sala vai
	// dita na fala logo em seguida -, é o aviso de que aconteceu. Antes da fala, para o
	// som chamar a atenção e o texto explicar.
	void on_death_alarm(net_packet@ pkt) {
		task_sound_simple(SND_NOISEMAKER_ALARM);
		string alarm_text = death_alarm_text(pkt);
		// `!pkt.announced`: se uma tela bloqueante já disse isto, não repete ao fechá-la.
		if (!pkt.announced) speak(alarm_text);
		events_log.add("", alarm_text); // dá para reler: é a informação mais valiosa da partida
	}

	// Sem interromper: chega logo depois do som do assassinato, e cortar a fala anterior
	// podia engolir justamente o aviso de reunião ou de sabotagem que estava sendo dito.
	void on_kill_witnessed(net_packet@ pkt) {
		string visto = kill_witnessed_text(pkt);
		if (!pkt.announced) speak(visto, false);
		events_log.add("", visto);
	}

	// Um corpo saiu do mapa (o lixeiro limpou, o carregador pegou): para de soar e não se reporta mais.
	void on_body_removed(net_packet@ pkt) {
		int i = known_body_peers.find(pkt.get_uint64("peer_id"));
		if (i < 0) return;
		known_body_peers.remove_at(i);
		known_body_positions.remove_at(i);
		near_body_last_frame = false;
		apply_sabotage_effects(audio, mui, map, my_task_object_ids, active_sabotage_id,
			my_role, alive, known_body_peers, known_body_positions);
	}

	// O carregador largou o corpo: ele volta a soar, no lugar novo.
	void on_body_placed(net_packet@ pkt) {
		uint64 morto = pkt.get_uint64("peer_id");
		vector onde(pkt.get_float("x"), pkt.get_float("y"), 0.0);
		int i = known_body_peers.find(morto);
		if (i >= 0) known_body_positions[i] = onde;
		else { known_body_peers.insert_last(morto); known_body_positions.insert_last(onde); }
		apply_sabotage_effects(audio, mui, map, my_task_object_ids, active_sabotage_id,
			my_role, alive, known_body_peers, known_body_positions);
	}

	void on_body_sound(net_packet@ pkt) {
		audio.play_body_sound(pkt.get_string("kind"), pkt.get_float("x"), pkt.get_float("y"));
	}

	// O médico trouxe alguém de volta. Se fui eu: vivo de novo, onde caí. Se foi outro: ele volta ao elenco
	// (votação, quem está perto) e o corpo dele, se eu o conhecia, sai.
	void on_player_revived(net_packet@ pkt) {
		uint64 quem = pkt.get_uint64("peer_id");
		float rx = pkt.get_float("x"), ry = pkt.get_float("y");
		roster_entry@ e = roster.find(quem);
		if (@e != null) { e.alive = true; e.x = rx; e.y = ry; }
		audio.play_revive(rx, ry);
		int i = known_body_peers.find(quem);
		if (i >= 0) { known_body_peers.remove_at(i); known_body_positions.remove_at(i); }
		if (quem == client.my_peer_id) {
			alive = true;
			mui.alive = true;
			my_x = rx;
			my_y = ry;
			audio.update_listener(my_x, my_y);
			string texto = tr("role.you_were_revived");
			speak(texto);
			events_log.add("", texto);
		}
		apply_sabotage_effects(audio, mui, map, my_task_object_ids, active_sabotage_id,
			my_role, alive, known_body_peers, known_body_positions);
	}

	// O seu par de apaixonados morreu, e você morre junto, onde está.
	void on_heartbreak(net_packet@ pkt) {
		alive = false;
		mui.alive = false;
		known_body_peers.insert_last(client.my_peer_id);
		known_body_positions.insert_last(vector(pkt.get_float("x"), pkt.get_float("y"), 0.0));
		apply_sabotage_effects(audio, mui, map, my_task_object_ids, active_sabotage_id,
			my_role, alive, known_body_peers, known_body_positions);
		string texto = tr("modifier.heartbreak");
		speak(texto);
		events_log.add("", texto);
	}
}
