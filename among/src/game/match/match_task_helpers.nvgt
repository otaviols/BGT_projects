// match_task_helpers.nvgt
// As tarefas do lado do cliente: marcar feita e avançar de fase na hora, sem esperar o servidor.
//
// Funções da partida que não dependem do estado dela (recebem o que usam). Incluído pelo
// src/game/game_loop.nvgt, que declara os #include de todas as partes.

// Troca a lista de tarefas pela que veio do servidor: a do começo da partida e a que um papel novo traz
// (a herança do amnésico). `my_task_object_ids` guarda só as pendentes - é o que o radar e os
// marcadores procuram.
void load_tasks_from_json(json_array@ tasks_json, array<player_task>@ my_tasks, array<string>@ my_task_object_ids) {
	my_tasks.resize(0);
	my_task_object_ids.resize(0);
	if (@tasks_json == null) return;
	for (uint i = 0; i < tasks_json.length(); i++) {
		json_object@ tj = tasks_json.get_object(i);
		if (@tj == null) continue; // task malformada não pode derrubar a entrada na partida
		player_task pt;
		pt.object_id = string(tj["object_id"]);
		pt.task_type = string(tj["task_type"]);
		// Servidor antigo não manda fase: uma fase só, como sempre foi.
		if (tj.exists("phase")) pt.phase = uint(int(tj["phase"]));
		if (tj.exists("phase_count")) pt.phase_count = uint(int(tj["phase_count"]));
		if (tj.exists("completed")) pt.completed = bool(tj["completed"]);
		json_array@ chain_json = tj.get_array("chain");
		if (@chain_json != null) for (uint c = 0; c < chain_json.length(); c++) pt.chain.insert_last(string(chain_json[c]));
		my_tasks.insert_last(pt);
		if (!pt.completed) my_task_object_ids.insert_last(pt.object_id);
	}
}

bool my_tasks_all_completed(array<player_task>@ tasks) {
	if (tasks.length() == 0) return false;
	for (uint i = 0; i < tasks.length(); i++) {
		if (!tasks[i].completed) return false;
	}
	return true;
}

bool is_task_completed(array<player_task>@ tasks, const string&in object_id) {
	for (uint i = 0; i < tasks.length(); i++) {
		if (tasks[i].object_id == object_id) return tasks[i].completed;
	}
	return false;
}

// A tarefa de várias fases andou uma fase: o ponto que ela mira passa a ser o próximo, o marcador
// muda de lugar junto, e o jogador ouve para onde ir agora.
//
// Isto acontece localmente assim que a minigame termina, sem esperar o servidor - é o mesmo
// otimismo de mark_task_completed_locally, e pelo mesmo motivo: quem acabou de fazer a etapa já
// quer sair andando, e esperar a ida e volta da rede deixaria o marcador apontando para trás.
void advance_task_locally(game_map@ map, audio_manager@ audio, array<player_task>@ my_tasks,
		array<string>@ my_task_object_ids, const string&in object_id, const string&in next_object_id,
		const string&in active_sabotage_id, role_traits@ my_role, bool alive) {
	for (uint i = 0; i < my_tasks.length(); i++) {
		if (my_tasks[i].object_id != object_id || my_tasks[i].completed) continue;
		my_tasks[i].phase++;
		my_tasks[i].object_id = next_object_id;
		break;
	}
	for (uint i = 0; i < my_task_object_ids.length(); i++) {
		if (my_task_object_ids[i] == object_id) { my_task_object_ids[i] = next_object_id; break; }
	}
	refresh_landmark_beacons(audio, map, my_task_object_ids, active_sabotage_id, my_role, alive);
}

// Para onde ir agora, dito ao terminar uma fase. É o mesmo texto da lista de tarefas, de propósito:
// quem ouviu aqui e quem for conferir na lista depois têm que ouvir a mesma coisa.
string next_phase_text(game_map@ map, const string&in next_object_id) {
	map_object@ obj = map.find_object(next_object_id);
	if (@obj == null) return "";
	map_zone@ zone = map.find_zone(obj.room_id);
	dictionary@ p = dictionary();
	p.set("name", tr(obj.name_key));
	p.set("room", @zone != null ? tr(zone.name_key) : "");
	return tr("task.next_phase", p);
}

// Marca a task como feita localmente (pra find_interactable parar de oferecer ela de novo) e tira
// o beacon dela do mapa.
void mark_task_completed_locally(game_map@ map, audio_manager@ audio, array<player_task>@ my_tasks,
		array<string>@ my_task_object_ids, const string&in object_id, const string&in active_sabotage_id,
		role_traits@ my_role, bool alive) {
	// UMA tarefa, a primeira não concluída deste ponto - a mesma que o servidor conclui (advance_task).
	// Marcar todas as do ponto deixava a segunda de duas correntes que acabam no mesmo lugar (dois nós do
	// clima, um painel no laboratório) feita para o cliente e pendente para o servidor.
	for (uint i = 0; i < my_tasks.length(); i++) {
		if (my_tasks[i].object_id != object_id || my_tasks[i].completed) continue;
		my_tasks[i].completed = true;
		break;
	}
	for (uint i = 0; i < my_task_object_ids.length(); i++) {
		if (my_task_object_ids[i] == object_id) { my_task_object_ids.remove_at(i); break; }
	}
	refresh_landmark_beacons(audio, map, my_task_object_ids, active_sabotage_id, my_role, alive);
}
