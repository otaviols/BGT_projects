// task_common.nvgt
// Utilidades compartilhadas pelas minigames de tasks (game/tasks/*.nvgt). Cada minigame roda em um
// laço bloqueante local no cliente - travar a entrada por alguns segundos é aceitável já que o
// jogador está deliberadamente parado interagindo com um objeto. O resultado final (sucesso ou
// cancelamento) é reportado ao servidor via crewmate_controller.submit_task_result().

#include "speech.nvgt"
#include "../../i18n.nvgt"
#include "../../audio/sound_catalog.nvgt"
#include "../../config/game_settings.nvgt"
#include "../../network/client.nvgt"

const int TASK_CANCEL_KEY = KEY_ESCAPE;

// true se a minigame deve parar agora: o jogador pediu pra cancelar (ESC), OU chegou um evento que
// interrompe a partida (reunião, corpo reportado, fim de jogo).
//
// A minigame roda num laço bloqueante que chama client.update() mas não LÊ os pacotes recebidos -
// eles ficam na fila esperando o laço principal do jogo. Sem espiar essa fila aqui, quem estivesse
// no meio de uma task quando uma reunião começasse continuava preso na minigame durante a discussão
// inteira, e no fim mandava o resultado pro servidor - que recusa qualquer task fora do estado
// "in_progress". A task ficava marcada como feita SÓ no cliente: sumia da lista dele, nunca contava
// pro time, e não dava pra refazer. Agora a minigame simplesmente é abortada (nada é marcado, nada
// é enviado) e a task continua pendente pra ele voltar lá depois da reunião.
bool task_cancel_requested(game_client@ client) {
	if (key_pressed(KEY_ESCAPE)) return true;
	if (@client == null) return false;
	for (uint i = 0; i < client.incoming.length(); i++) {
		string type = client.incoming[i].type;
		if (type == S_MEETING_STARTED || type == S_BODY_REPORTED || type == S_GAME_OVER) return true;
	}
	return false;
}

// Embaralha uma lista pequena de inteiros (Fisher-Yates). Usado para sortear tons/posições.
void shuffle_int_list(array<int>@ arr) {
	for (int i = int(arr.length()) - 1; i > 0; i--) {
		int j = random(0, i);
		int tmp = arr[i];
		arr[i] = arr[j];
		arr[j] = tmp;
	}
}

// Toca um som de feedback simples, sem posicionamento (a minigame não conhece a posição do jogador).
// pan opcional pra minigames que trabalham com lados: -100 = só no ouvido esquerdo, 0 = no meio,
// 100 = só no direito (a mesma escala de sound.pan).
//
// Devolve o som que começou a tocar, para quem precisar esperar ele acabar (ver
// wait_for_task_sound). Quem não precisa simplesmente ignora o retorno.
sound@ task_sound(const string&in filename, float pan = 0.0) {
	return sound_play("sounds/" + filename, vector(FLOAT_MAX, FLOAT_MAX, FLOAT_MAX),
		g_settings.volume_db(SOUND_FAMILY_TASKS), pan);
}

// Espera um som de task terminar antes de seguir.
//
// Existe porque esperar um número fixo de milissegundos é chutar a duração do arquivo: quem trocar o
// som depois não tem como adivinhar que havia um `wait` casado com ele em algum lugar, e o sintoma é
// silencioso - dois sons tocando por cima um do outro, sem erro nenhum. Foi o que aconteceu com a
// fita rebobinando da sala de segurança, que ainda estava tocando quando os passos começavam.
//
// Continua chamando client.update() e respeitando o cancelamento: a espera pode durar segundos, e
// travar aqui prenderia o jogador na minigame durante uma reunião. Devolve false se a task foi
// cancelada nesse meio-tempo.
//
// O teto existe para o caso de o som nunca reportar que parou (arquivo faltando, por exemplo): a
// task continua, atrasada, em vez de travar para sempre.
bool wait_for_task_sound(sound@ s, game_client@ client, uint max_wait_ms = 15000) {
	timer limit;
	while (@s != null && s.playing && limit.elapsed < int(max_wait_ms)) {
		wait(20);
		if (@client != null) client.update();
		if (task_cancel_requested(client)) return false;
	}
	return true;
}
