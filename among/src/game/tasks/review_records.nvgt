// review_records.nvgt
// Task da sala de segurança: rever a gravação do corredor e dizer QUANTAS pessoas passaram por ali.
// A gravação é feita dos mesmos sons de passo do mapa - cada pessoa atravessa de um lado, com o seu
// piso e o seu ritmo, e as pessoas são separadas por silêncio. Você responde nas teclas 1 a 6.
//
// É a única task do jogo que não é reflexo nem memória de sequência: é contar coisas que se
// sobrepõem no tempo. E ela treina exatamente a habilidade que salva a sua vida no resto da partida,
// que é reconhecer passos alheios.

#include "task_common.nvgt"

// Pisos usados na gravação. São os mesmos arquivos que o jogador ouve andando pela nave, de
// propósito: o ouvido já foi treinado neles.
//
// Quantas variantes cada piso tem NÃO se escreve aqui: sai de footstep_variant_count(), a mesma
// função que o resto do jogo usa. Uma segunda lista de contagens acaba discordando da primeira no
// dia em que alguém acrescentar um arquivo.
const array<string> RECORD_FLOORS = {"Tile", "MetalTile", "WoodTile", "MetalBeltTile"};

bool run_review_records_task(game_client@ client) {
	const uint MIN_PEOPLE = 1;
	// Até seis pessoas: contar até quatro vira reconhecimento de padrão depois de algumas partidas,
	// e a task existe justamente para exigir contagem.
	const uint MAX_PEOPLE = 6;
	const uint STEPS_PER_PERSON_MIN = 3;
	const uint STEPS_PER_PERSON_MAX = 5;

	speak(tr("task.review_records.instructions"));

	// A abertura e a fita rebobinando são a introdução da gravação: cada uma só começa quando a
	// anterior acaba, e a contagem só começa depois delas. Com espera fixa, a fita ainda estava
	// rodando quando o primeiro passo tocava - e um passo por cima do chiado da fita é justamente o
	// passo que não dá para contar.
	if (!wait_for_task_sound(task_sound(SND_VIDEO_OPENING), client)) return false;
	if (!wait_for_task_sound(task_sound(SND_TAPE_REWIND), client)) return false;
	wait(300); // respiro entre a fita parar e a gravação começar

	uint people = uint(random(int(MIN_PEOPLE), int(MAX_PEOPLE)));

	// Cada pessoa: um piso e um lado próprios, passos num ritmo próprio. Pisos e lados diferentes são
	// o que permite separar duas pessoas seguidas - sem isso viraria uma fila de passos iguais.
	for (uint person = 0; person < people; person++) {
		string floor = RECORD_FLOORS[uint(random(0, int(RECORD_FLOORS.length()) - 1))];
		int variants = footstep_variant_count(floor);
		float pan = float(random(-100, 100));
		uint steps = uint(random(int(STEPS_PER_PERSON_MIN), int(STEPS_PER_PERSON_MAX)));
		int step_interval = random(280, 420); // o passo de cada pessoa tem o ritmo dela

		for (uint step = 0; step < steps; step++) {
			// O caminho sai de footstep_sound_path(), que sabe da pasta e da extensão. Montado à mão
			// aqui, ficava "sounds/Tile3.wav" - arquivo que não existe desde que os sons foram para
			// subpastas - e a gravação rodava MUDA: sem erro, sem passo, e sem como contar ninguém.
			task_sound_path(footstep_sound_path(floor, random(1, variants)), pan);
			wait(step_interval);
			client.update();
			if (task_cancel_requested(client)) return false;
		}
		wait(random(700, 1100)); // silêncio entre uma pessoa e a próxima
	}

	speak(tr("task.review_records.how_many"));

	while (true) {
		wait(5);
		client.update();
		if (task_cancel_requested(client)) return false;

		int answer = 0;
		if (key_pressed(KEY_1)) answer = 1;
		else if (key_pressed(KEY_2)) answer = 2;
		else if (key_pressed(KEY_3)) answer = 3;
		else if (key_pressed(KEY_4)) answer = 4;
		else if (key_pressed(KEY_5)) answer = 5;
		else if (key_pressed(KEY_6)) answer = 6;
		if (answer == 0) continue;

		if (uint(answer) != people) {
			task_sound(SND_CARD_ERROR);
			dictionary@ p = dictionary();
			p.set("count", "" + people);
			speak(tr("task.review_records.wrong", p));
			return false;
		}

		task_sound(SND_BEEP_COMPLETE);
		speak(tr("task.completed"));
		return true;
	}
	return false; // inalcançável - o laço só termina via return acima
}
