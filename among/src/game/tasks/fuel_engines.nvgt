// fuel_engines.nvgt
// Task de abastecer os motores: o tanque enche enquanto Espaço fica segurado, e o som do enchimento
// vai ficando mais agudo. Antes de começar, o painel toca o tom EXATO de "tanque cheio"; soltar
// antes disso é pouco combustível, passar do ponto transborda. É toda de ouvido: o acerto é
// reconhecer que o tom que está subindo chegou no tom que foi tocado como referência.
//
// Uma versão anterior tinha trocado isso por "segure e solte quando o som mudar". Ficou fácil demais
// e, pior, deixou de ser uma decisão: o jogo avisava a hora certa e só restava reagir. Aqui o jogo
// não avisa nada - quem julga se já chegou é o jogador, e é isso que dá margem para errar por pouco.
//
// O tom de referência e o do enchimento saem do MESMO arquivo de som, de propósito. Comparar duas
// alturas do mesmo timbre é uma tarefa que o ouvido resolve bem; comparar timbres diferentes é
// muito mais difícil, e a dificuldade viria do lugar errado.

#include "task_common.nvgt"

bool run_fuel_engines_task(game_client@ client) {
	const float START_PITCH = 70.0;
	const float PITCH_PER_SECOND = 25.0;
	const float PITCH_TOLERANCE = 9.0;
	const float OVERFLOW_MARGIN = 25.0; // passou muito do alvo: transbordou, falhou na hora

	speak(tr("task.fuel_engines.instructions"));

	// Sorteado a cada vez: com um alvo fixo, decorar o tempo de aperto resolveria a task sem ouvir
	// nada - que é exatamente o que se quer evitar.
	float target_pitch = float(random(110, 165));

	sound reference;
	if (reference.load("sounds/" + SND_FILLING)) {
		reference.pitch = target_pitch;
		// play_wait: a referência tem que terminar ANTES de o jogador poder começar a encher, senão
		// ela se sobrepõe ao enchimento e não sobra o que comparar.
		reference.play_wait();
	}
	wait(400);

	sound filling;
	if (!filling.load("sounds/" + SND_FILLING)) return false;
	filling.pitch = START_PITCH;

	float current_pitch = START_PITCH;
	bool holding = false;
	timer frame_clock;
	frame_clock.restart();

	while (true) {
		wait(5);
		client.update();
		if (task_cancel_requested(client)) {
			filling.stop();
			return false;
		}
		float delta = float(frame_clock.elapsed) / 1000.0;
		frame_clock.restart();

		if (key_down(KEY_SPACE)) {
			if (!holding) {
				holding = true;
				filling.play_looped();
			}
			current_pitch += PITCH_PER_SECOND * delta;
			filling.pitch = current_pitch;
			// Passar MUITO do alvo falha na hora, sem esperar soltar: a essa altura o tanque já
			// transbordou, e deixar o jogador continuar segurando seria só enganá-lo.
			if (current_pitch > target_pitch + OVERFLOW_MARGIN) {
				filling.stop();
				task_sound(SND_CARD_ERROR);
				speak(tr("task.fuel_engines.overflow"));
				return false;
			}
			continue;
		}

		if (!holding) continue; // ainda nem começou a segurar

		// Soltou: o tanque para onde parou.
		filling.stop();
		if (absf(current_pitch - target_pitch) <= PITCH_TOLERANCE) {
			task_sound(SND_FILLING_COMPLETE);
			speak(tr("task.completed"));
			return true;
		}
		// Errou: dizer PARA QUE LADO errou é o que transforma a tentativa seguinte em aprendizado em
		// vez de nova adivinhação.
		task_sound(SND_CARD_ERROR);
		speak(tr(current_pitch < target_pitch ? "task.fuel_engines.too_little" : "task.fuel_engines.overflow"));
		return false;
	}
	return false; // inalcançável - o laço só termina via return acima
}
