// empty_garbage.nvgt
// Reinterpretação acessível da task de esvaziar o lixo: segurar (puxar a alavanca) e depois reagir
// rápido a um sinal sonoro (soltar o lixo na hora certa), como no jogo original mas guiado só por
// áudio em vez de uma barra visual.

#include "task_common.nvgt"

bool run_empty_garbage_task(game_client@ client) {
	const float HOLD_SECONDS_REQUIRED = 2.0;
	const float REACTION_WINDOW_SECONDS = 1.0;

	speak(tr("task.empty_garbage.instructions"));

	// Etapa 1: segurar Espaço por HOLD_SECONDS_REQUIRED segundos. Usa Espaço (não Enter) porque Enter
	// já é a tecla de interagir/abrir a task - segurar ela de novo aqui confundia o jogador.
	float held = 0.0;
	bool was_holding = false;
	timer frame_clock;
	frame_clock.restart();
	while (held < HOLD_SECONDS_REQUIRED) {
		wait(5);
		client.update();
		if (task_cancel_requested(client)) return false;
		float delta = float(frame_clock.elapsed) / 1000.0;
		frame_clock.restart();
		if (key_down(KEY_SPACE)) {
			if (!was_holding) task_sound(SND_PULLING_GARBAGE_LEVER); // início do puxão - não repete enquanto segura
			held += delta;
			was_holding = true;
		} else {
			held = 0.0; // soltou cedo demais - recomeça a contagem
			was_holding = false;
		}
	}

	task_sound(SND_BEEP_COMPLETE);

	// Etapa 2: espera aleatória, depois toca o bipe de reação - o jogador precisa apertar Espaço
	// dentro da janela de reação.
	int wait_ms = random(500, 2000);
	uint waited = 0;
	while (waited < uint(wait_ms)) {
		wait(5);
		client.update();
		if (task_cancel_requested(client)) return false;
		waited += 5;
	}

	task_sound(SND_BEEP);
	timer reaction_clock;
	reaction_clock.restart();
	while (float(reaction_clock.elapsed) / 1000.0 <= REACTION_WINDOW_SECONDS) {
		wait(5);
		client.update();
		if (task_cancel_requested(client)) return false;
		if (key_pressed(KEY_SPACE)) {
			task_sound(SND_BEEP_COMPLETE);
			speak(tr("task.completed"));
			return true;
		}
	}

	task_sound(SND_CARD_ERROR);
	speak(tr("task.failed"));
	return false;
}
