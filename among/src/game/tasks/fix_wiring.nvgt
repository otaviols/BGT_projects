// fix_wiring.nvgt
// Reinterpretação acessível da clássica task de fiação do Among Us: em vez de combinar cores por
// visão, o jogador combina tons por audição. 3 fios à esquerda e 3 à direita tocam os mesmos 3 tons
// (eletricalString1/2/3.wav) em ordens embaralhadas diferentes; o jogador precisa descobrir por
// ouvido qual par de cada lado toca o mesmo tom e conectá-los.

#include "task_common.nvgt"

bool run_fix_wiring_task(game_client@ client) {
	array<int> left_order = {0, 1, 2};
	array<int> right_order = {0, 1, 2};
	shuffle_int_list(left_order);
	shuffle_int_list(right_order);

	int left_cursor = 0;
	int right_cursor = 0;
	array<bool> connected = {false, false, false};

	// A tampa do painel abrindo, antes de tudo: mexer em fiação é abrir um painel e olhar dentro, e
	// sem esse som a task começava com o jogador já com a mão nos fios, do nada. É o mesmo par dos
	// painéis de sabotagem (ver run_sabotage_panel) - abre com a tampa, fecha com a tampa.
	if (!wait_for_task_sound(task_sound_path(SND_OPEN_PANEL), client)) return false;
	speak(tr("task.fix_wiring.instructions"));
	task_sound(electrical_string_sound(left_order[left_cursor] + 1));

	while (true) {
		wait(5);
		client.update();
		if (task_tick(client)) return false;

		if (key_pressed(KEY_UP)) {
			left_cursor = (left_cursor + 2) % 3;
			task_sound(electrical_string_sound(left_order[left_cursor] + 1));
		}
		if (key_pressed(KEY_DOWN)) {
			left_cursor = (left_cursor + 1) % 3;
			task_sound(electrical_string_sound(left_order[left_cursor] + 1));
		}
		if (key_pressed(KEY_LEFT)) {
			right_cursor = (right_cursor + 2) % 3;
			task_sound(electrical_string_sound(right_order[right_cursor] + 1));
		}
		if (key_pressed(KEY_RIGHT)) {
			right_cursor = (right_cursor + 1) % 3;
			task_sound(electrical_string_sound(right_order[right_cursor] + 1));
		}

		if (key_pressed(KEY_RETURN)) {
			if (connected[left_cursor]) continue;
			if (left_order[left_cursor] == right_order[right_cursor]) {
				connected[left_cursor] = true;
				// Acertar um fio não dava sinal NENHUM: o jogador ficava sem saber se o par tinha
				// pegado. É etapa dentro da task, então o som é o de "em andamento" - o de concluída
				// é UM só, e quem o toca é o task_manager ao fechar a task (ver CLAUDE.md).
				task_sound(SND_TASK_INPROGRESS);
				bool all_done = true;
				for (uint i = 0; i < connected.length(); i++) {
					if (!connected[i]) { all_done = false; break; }
				}
				if (all_done) {
					speak(tr("task.completed"));
					return true;
				}
			} else {
				task_sound(SND_CARD_ERROR);
			}
		}
	}
	return false; // inalcançável - o laço só termina via return acima
}
