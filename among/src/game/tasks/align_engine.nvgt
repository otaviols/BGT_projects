// align_engine.nvgt
// Task de alinhamento do motor: um bipe toca em loop contínuo, alternando entre o ouvido esquerdo
// e direito conforme a posição atual. Segurar/apertar as setas move a posição, e cada aperto na
// direção do centro traz o som de volta pro meio (ambos os ouvidos iguais) - pressionar Enter com o
// som centralizado tranca o alinhamento.

#include "task_common.nvgt"

bool run_align_engine_task(game_client@ client) {
	const float TRACK_HALF_WIDTH = 50.0; // -50..50, 0 = centro
	// Só o CENTRO EXATO vale (pedido do usuário: "o mais centralizado possível, para não terminar só
	// pondo um pouco para o lado"). Até a 0.53.0 valiam o centro e um passo para cada lado. Com o centro
	// exato, o passo cresceu de 6% para 10% do caminho: um passo de 6% fora do centro mal se distingue
	// dele de ouvido, e a tarefa viraria tentativa e erro em vez de escuta.
	const float STEP = 5.0;

	speak_hint("task.align_engine.instructions");

	// Sempre LONGE do centro, de um lado ou do outro, e num múltiplo do passo - senão o centro exato não
	// seria alcançável. De 3 a 8 passos de distância: começando perto demais, um Enter dado logo ao abrir
	// quase completava a tarefa (recado #230: "dois Enter e ela se faz sozinha").
	float position = STEP * float(random(3, 8)) * (random(0, 1) == 0 ? -1.0 : 1.0);

	// beep.wav é ESTÉREO de verdade (2 canais, conferido no cabeçalho do arquivo), então o modo
	// padrão AUDIO_PAN_MODE_BALANCE (atenua o canal oposto ao valor de pan) é o certo aqui. A ESCALA
	// do pan é a armadilha, e já mordeu duas vezes: valores -1..1 deixavam o som a 1% do centro, e
	// -100..100 lineares deixavam o som colado num ouvido (o pan do NVGT é em decibéis - ver
	// pan_from_linear, recado #272). A posição vai linear, e a conversão é de lá.
	sound engine_beep;
	engine_beep.load("sounds/" + SND_BEEP);
	engine_beep.pan = pan_from_linear(position / TRACK_HALF_WIDTH);
	engine_beep.play_looped();

	while (true) {
		wait(5);
		client.update();
		if (task_tick(client)) {
			engine_beep.stop();
			return false;
		}

		if (key_pressed(KEY_LEFT)) position -= STEP;
		if (key_pressed(KEY_RIGHT)) position += STEP;
		if (position < -TRACK_HALF_WIDTH) position = -TRACK_HALF_WIDTH;
		if (position > TRACK_HALF_WIDTH) position = TRACK_HALF_WIDTH;
		engine_beep.pan = pan_from_linear(position / TRACK_HALF_WIDTH);

		if (key_pressed(KEY_RETURN)) {
			if (absf(position) < STEP / 2.0) { // o centro exato (folga só para o arredondamento do float)
				engine_beep.stop();
				speak(tr("task.completed"));
				return true;
			} else {
				task_sound(SND_CARD_ERROR); // erra e o loop continua tocando pra tentar de novo
			}
		}
	}
	return false; // inalcançável - o laço só termina via return acima
}
