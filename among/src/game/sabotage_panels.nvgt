// sabotage_panels.nvgt
// O que acontece DENTRO de um painel de reparo. Antes, consertar era apertar Enter no painel; agora
// cada sabotagem cobra um conserto próprio, como no jogo original:
//
//   luzes         - os disjuntores da elétrica: cinco chaves, algumas desligadas; religar todas.
//   oxigênio      - um código de cinco dígitos, o MESMO nos dois painéis, dito ao abrir cada um.
//   comunicações  - sintonizar: girar o dial até a voz do rádio ficar sem estática.
//   sismógrafo    - segurar: duas pessoas com a mão nos dois painéis ao mesmo tempo (Base Polar).
//   reator        - o mesmo segurar, na nave de sempre.
//
// O padrão é o das tasks (ver tasks/task_common.nvgt): laço bloqueante no cliente, ESC cancela,
// reunião interrompe, e só o resultado vai ao servidor - que continua sendo quem decide se o painel
// conta (distância, sabotagem certa, quantos painéis faltam). A dificuldade é o que torna a sabotagem
// uma jogada: com o conserto instantâneo, sabotar só fazia barulho.

#include "tasks/task_common.nvgt"
#include "../audio/sound_catalog.nvgt"
#include "../i18n.nvgt"
#include "../core/sabotage_rules.nvgt"
#include "../config/game_constants.nvgt"

// Roda o conserto da sabotagem `sabotage_id`. Devolve true se o jogador terminou; false se desistiu
// ou foi interrompido. `oxygen_code` é o código desta sabotagem, vindo do servidor.
// Alguém (qualquer um) consertou a sabotagem enquanto este painel estava aberto? Então não há mais
// o que consertar aqui - continuar digitando o código seria trabalho para o lixo, e a pessoa só
// descobriria ao terminar. Avisa uma vez e fecha.
bool panel_closed_by_others(game_client@ client, const string&in panel_id = "") {
	if (@client == null) return false;
	// Duas formas de perder a corrida: a sabotagem inteira acabou, ou alguém terminou ESTE painel
	// antes (o oxigênio pede dois, e nada impede duas pessoas de escolherem o mesmo).
	bool acabou = client.sabotage_ended;
	bool este_painel = panel_id != "" && client.panel_fixed_id == panel_id;
	if (!acabou && !este_painel) return false;
	speak(tr("sabotage.already_fixed_by_others"));
	return true;
}

// Qual painel o jogador está consertando agora. Fica aqui, e não numa assinatura, porque os laços
// de cada painel (luzes, oxigênio, comunicações) são independentes e todos precisam da mesma
// resposta: "alguém terminou este painel antes de mim?".
string g_panel_being_fixed = "";

// `panel_id` é o ponto do mapa que está sendo consertado; vazio no treino, que não tem mapa.
// `other_pan` é de que lado está o OUTRO painel, para os de segurar (onde se ouve a mão do colega).
//
// Painel de segurar devolve se estabilizou, mas na partida quem consertou foi o SERVIDOR, que viu as
// duas mãos: lá não há conserto a pedir depois (ver match_frame_keys - o pedido chegaria com a
// sabotagem já acabada e voltaria como "não tem sabotagem"). O treino usa o resultado para dizer
// "concluído", e por isso ele é o verdadeiro.
bool run_sabotage_panel(game_client@ client, const string&in sabotage_id, const string&in oxygen_code,
		const string&in panel_id = "", float other_pan = 0.8) {
	g_panel_being_fixed = panel_id;
	if (task_tick(client) || panel_closed_by_others(client, panel_id)) return false;
	bool ok = false;
	bool segurar = is_hold_sabotage(sabotage_id);
	if (sabotage_id == "lights") ok = run_lights_panel(client);
	else if (sabotage_id == "oxygen") ok = run_oxygen_panel(client, oxygen_code);
	else if (sabotage_id == "comms") ok = run_comms_panel(client);
	else if (segurar) ok = run_hold_panel(client, sabotage_id, panel_id, other_pan);
	// O painel que ABRE com um som tem que FECHAR com um: sem isso a pessoa ouvia a tampa abrindo e
	// a tela terminava em silêncio, sem marcar que acabou. Vale nos dois fins - concluído ou
	// desistido - porque o som é da tampa, não do resultado.
	//
	// O de comunicações fica de fora: ele tem o par próprio (SND_COMMS_PANEL_OPEN/CLOSE) e já toca o
	// dele no lugar certo; tocar os dois seria a mesma tampa fechando duas vezes.
	if (sabotage_id != "comms") task_sound_path(SND_PANEL_CLOSE);
	// O som de "concluído" é o mesmo das tasks, e toca num lugar só - cada painel toca só o que é
	// dele (o estalo, o código aceito, o rádio fechando).
	if (ok) task_sound(SND_TASK_COMPLETE);
	return ok;
}

// --- Luzes: os disjuntores -----------------------------------------------------------------------
// Cinco chaves, as teclas 1 a 5. O painel diz quais estão desligadas; cada tecla inverte a chave
// dela, com o estalo do disjuntor. Algumas já estão ligadas de propósito: religar TUDO às cegas
// (apertar 1 2 3 4 5 em sequência) desligaria justamente as que estavam boas - é preciso ouvir.
bool run_lights_panel(game_client@ client) {
	const uint BREAKERS = 5;
	array<bool> on(BREAKERS);
	uint off_count = 0;
	// Pelo menos duas desligadas, senão o painel abre quase pronto; e pelo menos uma ligada, senão
	// não há o que confundir.
	while (off_count < 2 || off_count == BREAKERS) {
		off_count = 0;
		for (uint i = 0; i < BREAKERS; i++) { on[i] = random(0, 1) == 1; if (!on[i]) off_count++; }
	}
	speak(hints_on() ? tr("sabotage.lights.panel_intro") + " " + breakers_status_text(on) : breakers_status_text(on));

	while (true) {
		wait(5);
		client.update();
		if (task_tick(client) || panel_closed_by_others(client, g_panel_being_fixed)) return false;
		int pressed = -1;
		if (key_pressed(KEY_1)) pressed = 0;
		else if (key_pressed(KEY_2)) pressed = 1;
		else if (key_pressed(KEY_3)) pressed = 2;
		else if (key_pressed(KEY_4)) pressed = 3;
		else if (key_pressed(KEY_5)) pressed = 4;
		if (pressed == -1) {
			if (key_pressed(KEY_SPACE)) speak(breakers_status_text(on)); // repete o estado, sem mexer
			continue;
		}
		on[pressed] = !on[pressed];
		task_sound_path("sounds/" + SND_BREAKER_SWITCH);
		dictionary@ p = dictionary();
		p.set("number", "" + (pressed + 1));
		speak(tr(on[pressed] ? "sabotage.lights.breaker_on" : "sabotage.lights.breaker_off", p));

		bool all_on = true;
		for (uint i = 0; i < BREAKERS; i++) if (!on[i]) all_on = false;
		if (all_on) {
			wait(400);
			return true;
		}
	}
	return false;
}

// "Desligados: 2, 4." - só os desligados: é o que o jogador precisa apertar.
string breakers_status_text(array<bool>@ on) {
	array<string> off;
	for (uint i = 0; i < on.length(); i++) if (!on[i]) off.insert_last("" + (i + 1));
	if (off.length() == 0) return tr("sabotage.lights.all_on");
	dictionary@ p = dictionary();
	p.set("list", join(off, ", "));
	return tr("sabotage.lights.off_list", p);
}

// --- Oxigênio: o código ------------------------------------------------------------------------
// O painel DIZ o código ao abrir e o jogador digita. O código é o mesmo nos dois painéis, decidido
// pelo servidor a cada sabotagem: quem ouviu num painel pode ditar para quem está no outro, e é isso
// que faz os dois lados da nave conversarem no meio da correria. Errar apaga e recomeça.
bool run_oxygen_panel(game_client@ client, const string&in code) {
	if (code.length() == 0) return false; // servidor antigo, sem código: não há o que digitar
	dictionary@ p = dictionary();
	p.set("code", spaced_digits(code));
	speak(tr(hints_on() ? "sabotage.oxygen.panel_intro" : "sabotage.oxygen.repeat", p)); // o código sempre

	string typed = "";
	while (true) {
		wait(5);
		client.update();
		if (task_tick(client) || panel_closed_by_others(client, g_panel_being_fixed)) return false;
		if (key_pressed(KEY_SPACE)) { speak(tr("sabotage.oxygen.repeat", p)); continue; }
		int digit = pressed_digit();
		if (digit == -1) continue;
		task_sound_path("sounds/" + SND_CODE_KEY);
		typed += "" + digit;
		if (!code.starts_with(typed)) {
			task_sound_path("sounds/" + SND_CODE_BAD);
			speak(tr("sabotage.oxygen.wrong"));
			typed = "";
			continue;
		}
		if (typed.length() == code.length()) {
			task_sound_path("sounds/" + SND_CODE_GOOD);
			return true;
		}
	}
	return false;
}

// "4 7 2 9 1": com espaços, o leitor de tela fala dígito a dígito em vez de "quarenta e sete mil".
string spaced_digits(const string&in code) {
	string s = "";
	for (uint i = 0; i < code.length(); i++) s += (i > 0 ? " " : "") + code.substr(i, 1);
	return s;
}

int pressed_digit() {
	if (key_pressed(KEY_0) || key_pressed(KEY_NUMPAD_0)) return 0;
	if (key_pressed(KEY_1) || key_pressed(KEY_NUMPAD_1)) return 1;
	if (key_pressed(KEY_2) || key_pressed(KEY_NUMPAD_2)) return 2;
	if (key_pressed(KEY_3) || key_pressed(KEY_NUMPAD_3)) return 3;
	if (key_pressed(KEY_4) || key_pressed(KEY_NUMPAD_4)) return 4;
	if (key_pressed(KEY_5) || key_pressed(KEY_NUMPAD_5)) return 5;
	if (key_pressed(KEY_6) || key_pressed(KEY_NUMPAD_6)) return 6;
	if (key_pressed(KEY_7) || key_pressed(KEY_NUMPAD_7)) return 7;
	if (key_pressed(KEY_8) || key_pressed(KEY_NUMPAD_8)) return 8;
	if (key_pressed(KEY_9) || key_pressed(KEY_NUMPAD_9)) return 9;
	return -1;
}

// --- Comunicações: sintonizar --------------------------------------------------------------------
// Um dial de 0 a 100 e uma estação escondida em algum ponto. Setas giram; a voz do rádio fica mais
// alta e a estática mais baixa conforme se aproxima. Segurar o dial na estação por um instante
// fecha o conserto. É a única sabotagem que se conserta de OUVIDO - e a única em que ninguém pode
// ditar a resposta de longe.
bool run_comms_panel(game_client@ client) {
	const int STEP = 4;
	const int TOLERANCE = 3;          // dentro disto a voz está limpa
	const float HOLD_SECONDS = 1.2;   // tempo parado na estação para valer
	int station = random(15, 85);
	int dial = random(0, 100);
	while (int(abs(dial - station)) < 25) dial = random(0, 100); // começa longe, senão abre pronto

	task_sound_path("sounds/" + SND_COMMS_PANEL_OPEN);
	speak_hint("sabotage.comms.panel_intro");

	sound@ voice = task_sound_path("sounds/" + SND_COMMS_RADIO_VOICE);
	sound@ noise = task_sound_path("sounds/" + SND_COMMS_STATIC);
	timer hold;
	bool holding = false;
	while (true) {
		wait(5);
		client.update();
		if (task_tick(client) || panel_closed_by_others(client, g_panel_being_fixed)) { stop_radio(voice, noise); return false; }
		if (@voice != null && !voice.playing) voice.play();
		if (@noise != null && !noise.playing) noise.play();

		bool moved = false;
		if (key_pressed(KEY_LEFT) && dial > 0) { dial = dial - STEP < 0 ? 0 : dial - STEP; moved = true; }
		if (key_pressed(KEY_RIGHT) && dial < 100) { dial = dial + STEP > 100 ? 100 : dial + STEP; moved = true; }
		if (moved) task_sound_path("sounds/" + SND_COMMS_DIAL_STEP);

		// Mistura: perto da estação a voz manda; longe, a estática engole tudo. DENTRO da tolerância
		// a estática some de vez (não fica um resto baixinho): sintonizado tem que soar limpo, senão o
		// jogador fica na dúvida se já chegou - foi o que aconteceu no teste de ouvido com -36 dB.
		int dist = int(abs(dial - station));
		float closeness = dist >= 40 ? 0.0 : 1.0 - float(dist) / 40.0; // 0 longe, 1 em cima
		float base = g_settings.volume_db(SOUND_FAMILY_TASKS);
		if (@voice != null) voice.volume = base + (-30.0 + 30.0 * closeness);
		if (@noise != null) noise.volume = dist <= TOLERANCE ? -100.0 : base + (-2.0 - 40.0 * closeness);

		if (dist <= TOLERANCE) {
			if (!holding) { holding = true; hold.restart(); }
			else if (float(hold.elapsed) / 1000.0 >= HOLD_SECONDS) {
				stop_radio(voice, noise);
				task_sound_path("sounds/" + SND_COMMS_PANEL_CLOSE);
				return true;
			}
		} else {
			holding = false;
		}
	}
	return false;
}

// --- A porta da Base Polar: o painel dela ----------------------------------------------------------------
// Não é sabotagem (a porta trancada não é), mas é um painel e mora com eles. Reflexo, a mecânica que o
// jogo não tinha (maquete aprovada em 2026-10-19): um bipe agudo acende à esquerda, no meio ou à
// direita, e a seta daquele lado (esquerda, cima, direita) tem que vir antes de ele sumir. Acertou, o
// interruptor estala; demorou ou errou o lado, o bipe grave, e acende outro. Errar só custa tempo.
// Cinco acertos abrem. Se a porta abrir sozinha (ou por outro) no meio, o painel fecha avisando.
const int DOOR_PANEL_HITS = 5;
const int DOOR_PANEL_WINDOW_MS = 900;
const array<int> DOOR_PANEL_KEYS = {KEY_LEFT, KEY_UP, KEY_RIGHT};
const array<float> DOOR_PANEL_PANS = {-0.8, 0.0, 0.8};

// Os lados que vão acender, no lugar do sorteio (vazio = sortear). Só a sonda preenche. E os erros da
// última vez, para ela conferir.
array<int> g_door_panel_sides_next;
int g_door_panel_last_misses = 0;
// O lado aceso AGORA (-1 = nenhum): é como a sonda aperta a seta enquanto o bipe está no ar.
int g_door_panel_lit = -1;

bool run_door_panel(game_client@ client) {
	speak_hint("game.door_panel.intro");
	int abertas = client.doors_opened_count;
	array<int> lados = g_door_panel_sides_next;
	g_door_panel_sides_next.resize(0);
	g_door_panel_last_misses = 0;
	if (!door_panel_pause(client, 700, abertas)) return false;
	int acertos = 0;
	uint n = 0;
	while (acertos < DOOR_PANEL_HITS) {
		int lado = n < lados.length() ? lados[n] : random(0, 2);
		n++;
		float pan = pan_from_linear(DOOR_PANEL_PANS[lado]);
		task_sound(SND_DOOR_TARGET, pan);
		g_door_panel_lit = lado;
		int resposta = -1;
		timer janela;
		while (janela.elapsed < DOOR_PANEL_WINDOW_MS && resposta < 0) {
			wait(5);
			client.update();
			if (task_tick(client) || door_opened_meanwhile(client, abertas)) { g_door_panel_lit = -1; return false; }
			// Cada tecla lida UMA vez (ver CLAUDE.md); vale a primeira do quadro.
			for (uint k = 0; k < DOOR_PANEL_KEYS.length(); k++)
				if (key_pressed(DOOR_PANEL_KEYS[k]) && resposta < 0) resposta = int(k);
		}
		g_door_panel_lit = -1;
		if (resposta == lado) {
			acertos++;
			task_sound_path(SND_DOOR_SWITCH, pan);
		} else {
			g_door_panel_last_misses++;
			task_sound(SND_DOOR_TARGET_MISS, pan);
		}
		if (acertos < DOOR_PANEL_HITS && !door_panel_pause(client, random(300, 550), abertas)) return false;
	}
	return true;
}

// O respiro entre um bipe e o seguinte. As setas apertadas nele são JOGADAS FORA: senão uma seta
// atrasada valeria como resposta ao bipe seguinte, antes de ele ser ouvido.
bool door_panel_pause(game_client@ client, int ms, int abertas) {
	timer t;
	while (t.elapsed < ms) {
		wait(5);
		client.update();
		if (task_tick(client) || door_opened_meanwhile(client, abertas)) return false;
		for (uint k = 0; k < DOOR_PANEL_KEYS.length(); k++) key_pressed(DOOR_PANEL_KEYS[k]);
	}
	return true;
}

bool door_opened_meanwhile(game_client@ client, int abertas) {
	if (client.doors_opened_count == abertas) return false;
	speak(tr("game.door_panel.opened_meanwhile"));
	return true;
}

// --- Sismógrafo: segurar junto --------------------------------------------------------------------
// Segurar Enter põe a mão no leitor (o estalo, e o zumbido enquanto se segura); soltar a tira. A mão do
// colega, no OUTRO painel, soa do lado dele e mais baixa: é o que diz que ele chegou - e se ela some com
// a sua ainda posta, toca a falha (soltou cedo). Estabiliza quando o servidor vê as duas mãos juntas por
// SABOTAGE_HOLD_TOGETHER_SECONDS e manda o fim da sabotagem. Sem conexão (treino, Conhecer o mapa), um
// colega de mentira põe a mão alguns segundos depois de você e o painel conta o tempo sozinho.
const float HOLD_OTHER_HAND_DB = -8.0;

bool run_hold_panel(game_client@ client, const string&in sabotage_id, const string&in panel_id, float other_pan) {
	speak_hint("sabotage." + sabotage_id + ".panel_intro");
	bool treino = !client.connected;
	bool segurando = false, outra_antes = false;
	sound@ mao = null;
	sound@ outra = null;
	uint64 colega_em = 0;      // treino: quando o colega de mentira põe a mão
	uint64 juntos_desde = 0;   // treino: desde quando as duas estão postas
	while (true) {
		wait(5);
		client.update();
		bool sai = task_tick(client);
		// Estabilizou (o servidor mandou o fim): não é "alguém consertou antes", é o SEU conserto.
		if (!treino && client.sabotage_ended) { stop_hands(mao, outra); return true; }
		if (sai) {
			if (segurando && !treino) client.send_sabotage_hold(panel_id, false);
			stop_hands(mao, outra);
			return false;
		}
		bool desce = key_down(KEY_RETURN);
		if (desce && !segurando) {
			segurando = true;
			if (!treino) client.send_sabotage_hold(panel_id, true);
			task_sound(SND_SEISMIC_HAND_START);
			@mao = task_sound(SND_SEISMIC_HAND);
			if (treino) colega_em = ticks() + uint64(random(1500, 3000));
		} else if (!desce && segurando) {
			segurando = false;
			if (!treino) client.send_sabotage_hold(panel_id, false);
			if (@mao != null) mao.stop();
			@mao = null;
		}
		if (segurando && @mao != null && !mao.playing) mao.play();

		bool outra_agora = false;
		if (treino) outra_agora = segurando && ticks() >= colega_em;
		else {
			for (uint i = 0; i < client.sabotage_held_panels.length(); i++)
				if (client.sabotage_held_panels[i] != panel_id) outra_agora = true;
		}
		if (outra_agora && !outra_antes) @outra = task_sound(SND_SEISMIC_HAND, pan_from_linear(other_pan), 100.0);
		if (outra_agora && @outra != null) { outra.volume = g_settings.volume_db(SOUND_FAMILY_TASKS) + HOLD_OTHER_HAND_DB; if (!outra.playing) outra.play(); }
		if (!outra_agora && outra_antes) {
			if (@outra != null) outra.stop();
			@outra = null;
			if (segurando) task_sound(SND_SEISMIC_FAIL);
		}
		outra_antes = outra_agora;

		if (treino) {
			if (segurando && outra_agora) {
				if (juntos_desde == 0) juntos_desde = ticks();
				else if (ticks() - juntos_desde >= uint64(SABOTAGE_HOLD_TOGETHER_SECONDS * 1000)) { stop_hands(mao, outra); return true; }
			} else juntos_desde = 0;
		}
	}
	return false;
}

void stop_hands(sound@ mao, sound@ outra) {
	if (@mao != null) mao.stop();
	if (@outra != null) outra.stop();
}

void stop_radio(sound@ voice, sound@ noise) {
	if (@voice != null) voice.stop();
	if (@noise != null) noise.stop();
}
