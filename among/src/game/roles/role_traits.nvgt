// role_traits.nvgt
// O que cada papel PODE fazer e o que ele PERCEBE.
//
// Este arquivo existe para acabar com a pergunta "é impostor?" espalhada pelo código. Ela aparecia
// em mais de sessenta lugares, e cada um a usava para decidir uma coisa diferente: pode ventilar,
// pode matar, sofre a sabotagem de comunicações, aparece no radar dos outros, faz tarefas. Enquanto
// a resposta for um booleano, cada papel novo obriga a revisitar todos esses pontos - e esquecer um
// deles não quebra o build, só produz um papel que faz metade do que devia, em silêncio.
//
// Aqui o papel DECLARA o que é, e o resto do código pergunta pela CAPACIDADE ("posso ventilar?"),
// nunca pela identidade. Acrescentar um papel passa a ser acrescentar uma entrada nesta lista.
//
// Um papel novo entra em três passos:
//   1. uma função `role_traits@ role_<nome>()` abaixo, declarando o que ele pode;
//   2. o id dele em role_for() e, se for sorteável pela sala, em CONFIGURABLE_ROLE_IDS;
//   3. as chaves de texto "role.<id>", "role.assigned_<id>" e "lobby.role_count.<id>" nos
//      arquivos de idioma.
// Nada mais no cliente precisa saber que ele existe: o sorteio (servidor), o formulário da sala e
// a leitura das regras percorrem CONFIGURABLE_ROLE_IDS.
//
// Os dois papéis-base (tripulante e impostor) não entram na lista: eles são o que sobra depois que
// os papéis especiais são sorteados dentro de cada time. O que a sala configura é "quantos
// engenheiros entre os tripulantes", nunca "quantos tripulantes".

#include "../../config/game_constants.nvgt"

const string ROLE_CREWMATE = "crewmate";
const string ROLE_IMPOSTOR = "impostor";
const string ROLE_ENGINEER = "engineer";
const string ROLE_SHERIFF = "sheriff";
const string ROLE_NOISEMAKER = "noisemaker";
const string ROLE_GUARDIAN_ANGEL = "guardian_angel";
const string ROLE_DETECTIVE = "detective";
const string ROLE_SHAPESHIFTER = "shapeshifter";
const string ROLE_PHANTOM = "phantom";
const string ROLE_SNIPER = "sniper";
const string ROLE_JESTER = "jester";
const string ROLE_WOLF = "wolf";

// Ids das habilidades ativas, despachadas no servidor por este nome (ver run_ability).
const string ABILITY_REMOTE_FIX = "remote_fix";
const string ABILITY_SHIELD = "shield";
const string ABILITY_EXAMINE = "examine";
const string ABILITY_SHAPESHIFT = "shapeshift";
const string ABILITY_VANISH = "vanish";
const string ABILITY_GUESS = "guess";
const string ABILITY_EAT = "eat";
// O alarme do alarmista NÃO passa por on_use_ability: ele É o botão de emergência, e o cliente manda o
// mesmo C_CALL_MEETING (ver role_noisemaker). O id existe para a tecla H saber o que fazer.
const string ABILITY_ALARM = "alarm";

// Times. O papel sorteia-se DENTRO do time: primeiro a sala decide quantos impostores há, depois os
// papéis especiais de impostor saem entre eles e os de tripulação entre os outros.
const string TEAM_CREW = "crew";
const string TEAM_IMPOSTOR = "impostor";
// NEUTRO: nem tripulação nem impostor - um terceiro lado, com vitória própria (ver solo_win). Para a
// contagem de maioria ele conta como tripulante, como no original: sem isso, um neutro vivo daria aos
// impostores a vitória por maioria antes da hora. É sorteado entre os não impostores.
const string TEAM_NEUTRAL = "neutral";

// Condições de vitória PRÓPRIA dos neutros (role_traits.solo_win). Quando uma se cumpre, a partida
// acaba e só aquele jogador vence.
const string SOLO_WIN_EJECTED = "ejected"; // ser expulso na votação (o Bobo)
// Estar vivo quando a nave se reduzir a ele e no máximo mais um (o Lobo Mau). Ver o tick do game_state.
const string SOLO_WIN_LAST_STANDING = "last_standing";

// Papéis que a sala pode ligar, na ordem em que aparecem no formulário e na leitura das regras.
const array<string> CONFIGURABLE_ROLE_IDS = {ROLE_ENGINEER, ROLE_SHERIFF, ROLE_NOISEMAKER,
	ROLE_GUARDIAN_ANGEL, ROLE_DETECTIVE, ROLE_SHAPESHIFTER, ROLE_PHANTOM, ROLE_SNIPER, ROLE_JESTER, ROLE_WOLF};

// Os papéis que o sniper pode CHUTAR: os especiais que a sala ligou, e nunca "tripulante".
//
// Deixar tripulante entrar quebraria o papel num palpite: a maioria da mesa é tripulante comum,
// então chutar isso em qualquer um acertaria quase sempre e o sniper viraria um botão de matar de
// graça na reunião. Com a lista assim, o poder dele ESCALA com quantos papéis especiais a sala
// configurou - numa sala sem papéis especiais ele não tem o que chutar, e é justo que não tenha.
//
// Impostor também fica de fora: ele já conhece os companheiros desde o começo (knows_teammates), e
// apontar um deles seria gastar o palpite à toa.
bool role_is_guessable(const string&in role_id) { return CONFIGURABLE_ROLE_IDS.find(role_id) != -1; }

// Um papel especial ligado numa sala exige que TODO cliente dela saiba o que ele é. A partir desta
// versão de protocolo o cliente lê `your_role`; antes dela, lê só o booleano e jogaria um engenheiro
// como tripulante comum sem saber que não é.
const int ROLES_MIN_PROTOCOL = 2;
// Protocolo em que o ATIRADOR passou a existir. Ele precisa de mais que os outros porque um cliente
// que não o conhece cai no `role_for` desconhecido (tripulante) e jogaria como tripulante comum
// sendo impostor - e porque a morte na mesa chega num pacote novo (S_MEETING_KILL) que ele ignoraria,
// deixando quem morreu ainda na lista de votação.
const int SNIPER_MIN_PROTOCOL = 3;
// Protocolo em que os NEUTROS passaram a existir: um cliente anterior não conhece o terceiro time nem
// a vitória neutra no fim da partida, e jogaria o Bobo como tripulante comum sem saber o que é.
const int NEUTRAL_MIN_PROTOCOL = 7;
// O Lobo Mau trouxe pacotes que só ele usa (engolir, a barriga, a volta de quem foi engolido). Um
// cliente anterior engolido ficaria andando pela nave como fantasma sem saber onde está.
const int WOLF_MIN_PROTOCOL = 8;

// Um número do papel que a SALA pode ajustar (recarga, duração, janela de gravação).
//
// O papel declara quais tem, com o padrão e os limites; a configuração da sala guarda só o que foi
// mexido, o formulário monta os campos percorrendo esta lista, e o servidor lê o valor por aqui em
// vez de ler a constante. Um papel novo com um número novo custa uma linha na declaração dele e uma
// chave de texto - nada no protocolo, nada na tela, nada na validação.
const string TUNABLE_COOLDOWN = "cooldown";           // recarga da habilidade
const string TUNABLE_DURATION = "duration";           // quanto o efeito dura
const string TUNABLE_KILL_COOLDOWN = "kill_cooldown"; // recarga do tiro (xerife), separada da do impostor
const string TUNABLE_TRAIL = "trail";                 // por quanto tempo o rastro do assassino é gravado
const string TUNABLE_GUESSES = "guesses";             // quantos palpites por reunião (sniper)

class role_tunable {
	string key;
	float default_value;
	float min_value;
	float max_value;

	role_tunable() {}
	role_tunable(const string&in key, float default_value, float min_value, float max_value) {
		this.key = key;
		this.default_value = default_value;
		this.min_value = min_value;
		this.max_value = max_value;
	}

	// Chave de texto do campo na tela, derivada do par papel/número - sem segunda lista para manter
	// em sincronia (o mesmo truque do name_key do papel).
	string label_key(const string&in role_id) const { return "lobby.role_tunable." + role_id + "." + key; }
}

class role_traits {
	string id;
	string team = TEAM_CREW;
	// Os números que a sala pode ajustar neste papel. Vazio = não há o que ajustar (o alarmista, por
	// exemplo, é instantâneo).
	array<role_tunable> tunables;

	float tunable_default(const string&in key) const {
		for (uint i = 0; i < tunables.length(); i++) {
			if (tunables[i].key == key) return tunables[i].default_value;
		}
		return 0.0;
	}

	// --- O que pode fazer ---
	bool can_kill = false;
	bool can_vent = false;
	bool can_sabotage = false;
	bool can_close_doors = false;
	bool can_report_bodies = true;
	bool can_call_meeting = true;
	// Se as tarefas deste papel contam para a vitória da tripulação. É o que separa "faz tarefa" de
	// "finge fazer tarefa": o impostor pode ficar parado num painel para se passar por ocupado, mas
	// isso não avança nada.
	bool tasks_count_for_crew = true;

	// --- O que percebe ---
	// Imunidade à PRÓPRIA sabotagem. O impostor não é cegado pelas comunicações que ele mesmo
	// derrubou; as luzes ele sofre igual, e é isso que impede apagar a nave de ser escolha sem custo.
	bool immune_to_comms = false;
	bool immune_to_lights = false;

	// --- Habilidade ativa ---
	// Uma por papel, usada pela tecla de habilidade e despachada no servidor por este id (ver
	// on_use_ability). "" = o papel não tem. O valor aqui é o PADRÃO: a sala pode mudá-lo pelos
	// `tunables` abaixo, e quem lê a recarga na partida lê de config.role_value, nunca daqui.
	string ability_id = "";
	float ability_cooldown_seconds = 0.0;
	// EM QUE ESTADO a habilidade funciona. Os dois separados, e não um booleano "vale morto",
	// porque há os três casos: só vivo (o normal), vivo e morto, e SÓ morto - o anjo da guarda,
	// que é um tripulante comum até morrer.
	bool ability_usable_alive = true;
	bool ability_usable_dead = false;
	// A reunião é uma PAUSA: ninguém anda, ninguém mata, ninguém usa habilidade - e o servidor
	// garante isso recusando qualquer habilidade fora de `state == "in_progress"`. O sniper é a
	// ÚNICA exceção, e ela é declarada aqui em vez de ser um furo no `if` do servidor: assim quem
	// ler a regra encontra a exceção junto dela, e não descobre por acidente seis meses depois.
	bool ability_usable_in_meeting = false;
	// Se a recarga volta ao COMEÇO quando a votação acaba. DESLIGADO para todos desde a 0.37.0.
	//
	// Era ligado por padrão, e a razão era boa: o relógio da habilidade corria durante a reunião, e
	// sem o reset a discussão recarregava de graça - o metamorfo saía da votação pronto para virar
	// alguém no meio de todo mundo. Mas o remédio punia: quem entrava na reunião com a habilidade
	// quase pronta saía com a recarga inteira de novo, e reunião é justamente o que a tripulação
	// chama. O usuário achou injusto, e é. Hoje a recarga da habilidade fica PAUSADA durante a
	// reunião (player.tick_cooldowns, e o cliente com movement_frozen): sai com o que tinha ao
	// entrar, sem ganhar nem perder. O kill continua sendo rearmado - aquele existe para ninguém
	// sair da mesa com a faca pronta ao lado de todo mundo, e isso segue valendo.
	//
	// O campo fica para um papel futuro cuja habilidade PRECISE recomeçar a cada reunião.
	bool ability_cooldown_resets_on_meeting = false;
	// Se a habilidade começa a partida RECARREGANDO, como o kill, em vez de pronta. Para as
	// habilidades que tiram gente do jogo: o lobo que engolisse no primeiro segundo, com todo mundo
	// ainda junto no ponto de partida, não daria jogo a ninguém.
	bool ability_starts_on_cooldown = false;

	// Versão de protocolo que um cliente precisa ter para JOGAR numa sala com este papel ligado. O
	// padrão serve a todos os papéis da primeira leva; quem precisar de mais declara aqui, e a sala
	// pergunta (ver lobby_config.required_protocol). Sem isto, acrescentar um papel novo obrigaria a
	// recusar clientes de salas que nem o ligaram.
	int min_protocol = ROLES_MIN_PROTOCOL;

	// Ao morrer, a nave inteira ouve que ele morreu e ONDE. É a informação que este jogo não dá de
	// graça em lugar nenhum: normalmente o corpo precisa ser encontrado, e quem está longe não sabe
	// de nada. Ver role_noisemaker.
	bool announces_own_death = false;

	// --- Time ---
	bool wins_with_crew = true;
	// Ameaça à tripulação SEM ser impostor. É o que o xerife pode derrubar sem errar o tiro, e o que
	// impede a tripulação de vencer por eliminação enquanto estiver vivo - tirar os impostores não
	// basta se ainda há um lobo comendo gente.
	bool hostile_to_crew = false;
	// Vitória PRÓPRIA (neutros): "" = nenhuma, o papel vence com o time dele; senão, uma das
	// SOLO_WIN_* - e quando ela se cumpre a partida acaba com só este jogador vencendo.
	string solo_win = "";
	// Se descobre quem são os companheiros de papel no começo da partida.
	bool knows_teammates = false;

	// Chaves de texto derivadas do id, para não haver uma segunda lista para manter em sincronia.
	string name_key() const { return "role." + id; }
	string assignment_key() const { return "role.assigned_" + id; }
}

role_traits@ role_crewmate() {
	role_traits t;
	t.id = ROLE_CREWMATE;
	return t; // os padrões da classe JÁ são o tripulante: ele é a linha de base
}

role_traits@ role_impostor() {
	role_traits t;
	t.id = ROLE_IMPOSTOR;
	t.team = TEAM_IMPOSTOR;
	t.can_kill = true;
	t.can_vent = true;
	t.can_sabotage = true;
	t.can_close_doors = true;
	t.tasks_count_for_crew = false;
	t.immune_to_comms = true;
	t.wins_with_crew = false;
	t.knows_teammates = true;
	return t;
}

// Engenheiro: tripulante que usa os dutos e conserta a sabotagem em andamento de qualquer lugar.
//
// Os dutos dele são o preço em dedução: "a tampa abriu na navegação, então ele saiu em armas ou no
// reator" deixa de provar impostor. A troca é deliberada - o som da tampa continua o mesmo para os
// dois, então o que a tripulação perde em certeza ganha em ter uma explicação alternativa que o
// impostor pode usar como álibi... e que o engenheiro paga sendo confundido com ele.
//
// O conserto remoto tem recarga longa (ver ENGINEER_FIX_COOLDOWN_SECONDS): ele existe para salvar a
// nave de uma sabotagem crítica quando ninguém chega a tempo, não para anular a sabotagem como
// mecânica. E ele é público do jeito mais sonoro possível - a sabotagem acaba sem ninguém ter
// chegado ao painel, e quem estava a caminho ouve isso.
role_traits@ role_engineer() {
	role_traits t;
	t.id = ROLE_ENGINEER;
	t.can_vent = true;
	t.ability_id = ABILITY_REMOTE_FIX;
	t.ability_cooldown_seconds = ENGINEER_FIX_COOLDOWN_SECONDS;
	// O piso de 30 s não é capricho: com recarga menor que a da sabotagem (30 s), ele conserta tudo
	// que aparecer e sabotar deixa de ser jogada.
	t.tunables.insert_last(role_tunable(TUNABLE_COOLDOWN, ENGINEER_FIX_COOLDOWN_SECONDS, 30.0, 600.0));
	// A sabotagem sobrevive à reunião; a recarga dele não pode ser zerada junto, ou chamar reunião
	// vira a forma barata de garantir que ninguém conserta nada por mais dois minutos.
	t.ability_cooldown_resets_on_meeting = false;
	return t;
}

// Xerife: tripulante armado que erra por conta e risco.
//
// Ele mata com a MESMA tecla e o mesmo alcance do impostor, e o tiro soa igual para os vizinhos -
// é isso que torna cada assassinato ouvido ambíguo, em vez de prova. Mirar em quem não é impostor
// mata o PRÓPRIO xerife (ver try_kill): a tripulação perde duas pessoas de uma vez, e quem ele
// mirou nem fica sabendo que foi mirado.
//
// Não tem habilidade ativa: a "habilidade" dele é a tecla de matar, que ele já tem por can_kill.
// E não sabe quem são os companheiros - se soubesse, saberia também quem NÃO é impostor.
role_traits@ role_sheriff() {
	role_traits t;
	t.id = ROLE_SHERIFF;
	t.can_kill = true;
	// Recarga do tiro DELE, separada da do impostor. O padrão é 0, que significa "a mesma da sala":
	// é o campo vazio do formulário, e evita ter de repetir o número em toda sala só para o xerife
	// acompanhar o impostor. Quem quiser um xerife mais lento (ou mais rápido) põe um valor.
	t.tunables.insert_last(role_tunable(TUNABLE_KILL_COOLDOWN, 0.0, 0.0, 300.0));
	return t;
}

// Alarmista: tripulante comum em tudo, menos na morte - quando ele cai, a nave inteira ouve que
// ele morreu e em que sala.
//
// É o papel mais barato de descrever e o que mais mexe com o jogo, porque ataca a regra que
// sustenta tudo: normalmente um corpo só existe para quem tropeça nele, e o impostor escolhe onde
// matar contando com isso. Matar o alarmista num canto escondido deixa de ser seguro - e como
// ninguém sabe quem ele é, TODA vítima poderia ser ele.
//
// O aviso não diz quem matou nem para onde ele foi: diz onde o corpo está. Quem quiser mais que
// isso tem que ir até lá.
//
// Vivo, a tecla H é o ALARME: o botão de emergência apertado de qualquer lugar da nave. É só isso -
// mesma contagem de reuniões da sala (a dele, a de qualquer um), mesma recarga, mesmos bloqueios
// (sabotagem crítica, luzes) -, porque o servidor trata os dois pelo mesmo caminho: o cliente manda o
// mesmo C_CALL_MEETING do botão. E o anúncio é o do botão, de propósito: uma reunião a mais, ou um
// aviso "foi o alarme", entregaria o papel ao impostor. O que o denuncia é só a dedução de alguém
// que perceba que ele não estava na cafeteria.
role_traits@ role_noisemaker() {
	role_traits t;
	t.id = ROLE_NOISEMAKER;
	t.announces_own_death = true;
	t.ability_id = ABILITY_ALARM;
	return t;
}

// Anjo da guarda: tripulante comum enquanto vivo, e DEPOIS de morrer pode blindar alguém.
//
// Existe por causa de um problema velho do jogo: quem morre cedo fica só com as tarefas. O anjo dá
// a quem morreu uma jogada que ainda importa, sem devolver a ele poder de dedução - ele continua
// sem votar, sem falar com vivos, e não descobre nada sobre quem é quem.
//
// O escudo é INVISÍVEL para todo mundo, inclusive para quem foi protegido e para quem tentou
// matar: a tecla do impostor simplesmente não faz nada (ver try_kill). Avisar qualquer um dos dois
// transformaria o anjo num detector de impostor - "protegi fulano e ele foi atacado" é exatamente
// a informação que um fantasma não pode ter.
role_traits@ role_guardian_angel() {
	role_traits t;
	t.id = ROLE_GUARDIAN_ANGEL;
	t.ability_id = ABILITY_SHIELD;
	t.ability_cooldown_seconds = GUARDIAN_SHIELD_COOLDOWN_SECONDS;
	t.tunables.insert_last(role_tunable(TUNABLE_DURATION, GUARDIAN_SHIELD_DURATION_SECONDS, 5.0, 300.0));
	t.tunables.insert_last(role_tunable(TUNABLE_COOLDOWN, GUARDIAN_SHIELD_COOLDOWN_SECONDS, 10.0, 600.0));
	t.ability_usable_alive = false; // vivo ele é um tripulante como outro qualquer
	t.ability_usable_dead = true;
	// A reunião já APAGA o escudo que ele tinha lançado; zerar a recarga junto seria cobrar duas
	// vezes pela mesma reunião, de um papel que não ataca ninguém. Ele sai da votação podendo
	// proteger de novo - que é exatamente o que a proteção perdida pede.
	t.ability_cooldown_resets_on_meeting = false;
	return t;
}

// Detetive: examina um corpo e descobre HÁ QUANTO TEMPO a pessoa morreu e por quais salas o
// assassino passou nos segundos seguintes.
//
// Examinar é separado de reportar de propósito: ele decide se convoca a reunião na hora ou se
// guarda o que viu. E o exame não aponta ninguém - o rastro é uma lista de salas, e quem estava
// nelas por acaso entra na conta junto com o culpado. É informação de DEDUÇÃO, que vale uma
// discussão, e não de identificação, que encerraria a partida.
//
// Uma versão descartada: ouvir os últimos segundos do que a vítima falou. Quem morre sozinho com o
// assassino quase nunca está falando, então na maioria das mortes o retorno seria silêncio; e se
// estivesse falando, seria com o próprio impostor, o que dá prova quase absoluta.
//
// Sem recarga: o limite é um exame POR CORPO (ver try_examine_body), e corpo é escasso por
// natureza. Uma recarga por cima só puniria quem achou dois corpos seguidos.
role_traits@ role_detective() {
	role_traits t;
	t.id = ROLE_DETECTIVE;
	t.ability_id = ABILITY_EXAMINE;
	// A janela de gravação do rastro. O piso de 5 s existe porque abaixo disso o rastro sai vazio em
	// quase toda morte neste mapa (da borda de uma sala à outra são ~10 s de caminhada), e o papel
	// nasceria morto - ver KILLER_TRAIL_SECONDS.
	t.tunables.insert_last(role_tunable(TUNABLE_TRAIL, KILLER_TRAIL_SECONDS, 5.0, 120.0));
	return t;
}

// Shapeshifter: impostor que assume o NOME de outro jogador vivo por um tempo.
//
// Num jogo sem imagem, "parecer com alguém" é aparecer com o nome dele - e o nome só chega a outro
// jogador por um caminho: o servidor (radar, câmera, quem está na sala). Por isso o disfarce mora
// no servidor e o cliente do shapeshifter nem precisa saber como funciona.
//
// Duas coisas o mantêm honesto. A transformação FAZ SOM, posicionado, como a tampa de um duto:
// quem estiver perto ouve e sabe que algo aconteceu ali. E o microfone dele fecha enquanto durar -
// a voz chega identificada pelo peer, e uma frase o entregaria na hora. A fantasia custa ficar
// mudo, que num jogo de dedução falada é um preço alto de verdade.
role_traits@ role_shapeshifter() {
	role_traits t;
	t.id = ROLE_SHAPESHIFTER;
	t.team = TEAM_IMPOSTOR;
	t.can_kill = true;
	t.can_vent = true;
	t.can_sabotage = true;
	t.can_close_doors = true;
	t.tasks_count_for_crew = false;
	t.immune_to_comms = true;
	t.wins_with_crew = false;
	t.knows_teammates = true;
	t.ability_id = ABILITY_SHAPESHIFT;
	t.ability_cooldown_seconds = SHAPESHIFT_COOLDOWN_SECONDS;
	t.tunables.insert_last(role_tunable(TUNABLE_DURATION, SHAPESHIFT_DURATION_SECONDS, 5.0, 300.0));
	t.tunables.insert_last(role_tunable(TUNABLE_COOLDOWN, SHAPESHIFT_COOLDOWN_SECONDS, 10.0, 600.0));
	return t;
}

// Fantasma: impostor que some por completo - do radar, dos passos e da voz - por alguns segundos.
//
// É o inverso exato da moeda do jogo. Todos os outros papéis mexem no que o som SIGNIFICA; este
// tira o som. Num jogo em que a pista principal é o passo alheio, alguém que atravessa a nave sem
// pisar é a coisa mais assustadora que existe - e por isso ele paga caro: sai da invisibilidade no
// instante em que mata, e o ato de sumir e de voltar fazem barulho, no ponto onde ele está.
//
// A invisibilidade reaproveita a semântica do duto ("presente mas imperceptível") e fica pendurada
// nos MESMOS três pontos - players_in_room, on_move e on_voice_frame. Não há condição nova
// espalhada pelo código, e é isso que impede um caminho esquecido de continuar denunciando ele.
role_traits@ role_phantom() {
	role_traits t;
	t.id = ROLE_PHANTOM;
	t.team = TEAM_IMPOSTOR;
	t.can_kill = true;
	t.can_vent = true;
	t.can_sabotage = true;
	t.can_close_doors = true;
	t.tasks_count_for_crew = false;
	t.immune_to_comms = true;
	t.wins_with_crew = false;
	t.knows_teammates = true;
	t.ability_id = ABILITY_VANISH;
	t.ability_cooldown_seconds = PHANTOM_COOLDOWN_SECONDS;
	t.tunables.insert_last(role_tunable(TUNABLE_DURATION, PHANTOM_INVISIBLE_SECONDS, 5.0, 300.0));
	t.tunables.insert_last(role_tunable(TUNABLE_COOLDOWN, PHANTOM_COOLDOWN_SECONDS, 10.0, 600.0));
	return t;
}

// Sniper: impostor que mata na MESA, se souber dizer qual é o papel do alvo.
//
// É o único papel que age durante a reunião, e a exceção é deliberada (ver ability_usable_in_meeting).
// A reunião é a fase em que a tripulação está mais segura - ninguém anda, ninguém mata -, e o sniper
// existe justamente para que ela deixe de ser descanso garantido.
//
// O que o segura é o PREÇO do erro: errar o palpite mata ele na hora, na frente de todo mundo. E a
// lista do que se pode chutar são só os papéis especiais que a sala ligou (ver role_is_guessable),
// nunca "tripulante" - senão bastaria apontar qualquer um e acertar.
//
// Ele NÃO é anunciado ao acertar: a mesa fica sabendo quem morreu e qual papel foi apontado, nunca
// quem apontou. O custo dele é o risco, e não a exposição - e o que a tripulação ganha em troca é
// informação de verdade: acertou, o papel da vítima está revelado; errou, sabe-se que o alvo NÃO é
// aquele papel e que o morto era impostor. Se na prática isso soar forte demais, o botão a mexer é
// revelar quem apontou, e não tirar o palpite.
role_traits@ role_sniper() {
	role_traits t;
	t.id = ROLE_SNIPER;
	t.team = TEAM_IMPOSTOR;
	t.can_kill = true;
	t.can_vent = true;
	t.can_sabotage = true;
	t.can_close_doors = true;
	t.tasks_count_for_crew = false;
	t.immune_to_comms = true;
	t.wins_with_crew = false;
	t.knows_teammates = true;
	t.ability_id = ABILITY_GUESS;
	t.ability_usable_in_meeting = true;
	t.min_protocol = SNIPER_MIN_PROTOCOL;
	// Um por REUNIÃO, e não por partida: o palpite se renova a cada mesa, e quem segura o papel é o
	// risco de morrer, não a escassez. O teto de 3 existe só para a sala não transformar a reunião
	// numa chacina.
	t.tunables.insert_last(role_tunable(TUNABLE_GUESSES, SNIPER_GUESSES_PER_MEETING, 1.0, 3.0));
	// Não tem recarga em segundos: o que limita é a contagem de palpites, que a reunião renova. Sem
	// isto, `ability_cooldown_resets_on_meeting` mexeria num relógio que este papel não usa.
	t.ability_cooldown_resets_on_meeting = false;
	return t;
}

// Bobo da Corte: neutro que vence se for EXPULSO na votação.
//
// É o primeiro neutro, e o mais simples de verificar - mas mexe com a coisa mais importante do jogo, a
// reunião: toda expulsão passa a ter uma dúvida a mais ("é o impostor, ou é o Bobo querendo sair?").
// Num jogo que é todo conversa, isso muda a mesa inteira. O Bobo precisa parecer culpado sem
// parecer que está tentando - quem exagera é lido na hora.
//
// Não faz tarefa que conte (senão a tripulação dependeria dele para vencer por tarefas), não mata e
// não sabota. Vota, reporta e chama reunião como qualquer um - são as ferramentas dele. Vê no radar
// de objetos as tarefas da sala, como o impostor, para fingir que faz uma.
role_traits@ role_jester() {
	role_traits t;
	t.id = ROLE_JESTER;
	t.team = TEAM_NEUTRAL;
	t.tasks_count_for_crew = false;
	t.wins_with_crew = false;
	t.solo_win = SOLO_WIN_EJECTED;
	t.min_protocol = NEUTRAL_MIN_PROTOCOL;
	return t;
}

// Lobo Mau: neutro que ENGOLE os outros, e vence se sobrar com a nave reduzida a ele e mais um.
//
// Engolir não é matar, e é isso que o torna um papel e não um segundo impostor. Não fica corpo: quem
// foi engolido some, e a nave só descobre na reunião, pela lista - quem falta nela não foi anunciado
// por ninguém (decisão do jogo: a mesa não ouve "fulano foi engolido", só percebe a ausência). E o
// engolido não morreu: está na barriga, fala com o lobo e com os outros engolidos, e mais ninguém o
// ouve - nem os fantasmas. Quando o lobo morre ou é expulso, TODOS voltam, vivos, onde ele caiu.
//
// Isso muda a conta da tripulação de um jeito que nenhum outro papel muda: matar o lobo DEVOLVE
// gente. E muda a do lobo: cada engolido é alguém que ele ouve implorar, e que volta contra ele se
// ele cair.
//
// O som, para quem está perto, é o do assassinato - de propósito: quem ouve vai procurar um corpo e
// não acha nenhum, e essa é a pista que o lobo deixa. Quem está colado vê, como vê um assassinato.
//
// Não faz tarefa que conte (vê os pontos no radar, para fingir), não usa duto e não sabota. O xerife
// pode derrubá-lo sem errar o tiro (hostile_to_crew), e enquanto ele estiver vivo a tripulação não
// vence por eliminação.
role_traits@ role_wolf() {
	role_traits t;
	t.id = ROLE_WOLF;
	t.team = TEAM_NEUTRAL;
	t.tasks_count_for_crew = false;
	t.wins_with_crew = false;
	t.hostile_to_crew = true;
	t.solo_win = SOLO_WIN_LAST_STANDING;
	t.ability_id = ABILITY_EAT;
	t.ability_cooldown_seconds = WOLF_EAT_COOLDOWN_SECONDS;
	t.ability_starts_on_cooldown = true;
	t.tunables.insert_last(role_tunable(TUNABLE_COOLDOWN, WOLF_EAT_COOLDOWN_SECONDS, 15.0, 300.0));
	t.min_protocol = WOLF_MIN_PROTOCOL;
	return t;
}

role_traits@ role_for(const string&in role_id) {
	if (role_id == ROLE_SNIPER) return role_sniper();
	if (role_id == ROLE_JESTER) return role_jester();
	if (role_id == ROLE_WOLF) return role_wolf();
	if (role_id == ROLE_IMPOSTOR) return role_impostor();
	if (role_id == ROLE_SHAPESHIFTER) return role_shapeshifter();
	if (role_id == ROLE_PHANTOM) return role_phantom();
	if (role_id == ROLE_NOISEMAKER) return role_noisemaker();
	if (role_id == ROLE_DETECTIVE) return role_detective();
	if (role_id == ROLE_GUARDIAN_ANGEL) return role_guardian_angel();
	if (role_id == ROLE_ENGINEER) return role_engineer();
	if (role_id == ROLE_SHERIFF) return role_sheriff();
	return role_crewmate(); // desconhecido cai em tripulante: o papel mais inofensivo dos dois
}

bool role_id_is_known(const string&in role_id) {
	return role_id == ROLE_CREWMATE || role_id == ROLE_IMPOSTOR || CONFIGURABLE_ROLE_IDS.find(role_id) != -1;
}

// O papel-base de um time: o que sobra para quem não foi sorteado num papel especial.
string base_role_of_team(const string&in team) {
	return team == TEAM_IMPOSTOR ? ROLE_IMPOSTOR : ROLE_CREWMATE;
}

// Fisher-Yates sobre a ORDEM dos jogadores da sala (índices), usado pelo servidor para decidir quem
// é impostor. Mora aqui, junto do sorteio dos papéis, e sobre índices em vez de jogadores, para a
// sonda de justiça (probe_draw_fairness) embaralhar com a MESMA função - uma cópia na sonda passaria
// com o servidor torto. `random(0, i)` inclui o i, e isso é o que faz dele um embaralhamento justo:
// sem incluir, viraria o de Sattolo, que nunca deixa ninguém no lugar (a sonda confere).
void shuffle_player_order(array<int>@ ordem) {
	for (int i = int(ordem.length()) - 1; i > 0; i--) {
		int j = random(0, i);
		int tmp = ordem[i];
		ordem[i] = ordem[j];
		ordem[j] = tmp;
	}
}

// O sorteio dos papéis especiais, numa função para o servidor e a sonda chamarem a MESMA coisa.
//
// Recebe quantos jogadores há, quantos deles são impostores (os `impostor_count` PRIMEIROS da lista
// já embaralhada), quem é bot, e a configuração da sala. Devolve o papel de cada posição ("" = o
// papel-base do time dela).
//
// Três regras que parecem detalhe e não são:
//   1. cada VAGA rola a própria chance - "2 xerifes a 50%" pode dar zero, um ou dois;
//   2. vaga sorteada para fora NÃO gasta jogador, senão ela tiraria alguém do sorteio dos outros
//      papéis sem nada ter aparecido;
//   3. bot nunca recebe papel especial (a IA não sabe usá-lo), então numa sala cheia de bots pode
//      não sobrar gente para todos os papéis ligados - e o que não couber não sai, calado. Do lado
//      de quem joga isso é indistinguível de uma chance que não saiu, e é isso que o torna seguro.
//   4. as vagas que passaram na chance são EMBARALHADAS antes de encontrar gente. Antes elas eram
//      distribuídas na ordem de CONFIGURABLE_ROLE_IDS, e quando havia mais papéis ligados do que
//      vagas no time, o primeiro da lista ganhava sempre: com um impostor e metamorfo, fantasma e
//      atirador ligados, saiu metamorfo em 60 mil de 60 mil partidas simuladas, e os outros dois
//      nunca (tools/probes/probe_draw_fairness.nvgt). Na tripulação era igual - engenheiro e xerife
//      tomavam a vez do resto. Embaralhar as vagas, e não os jogadores, é o que faltava: os
//      jogadores já vinham embaralhados, e por isso nenhuma PESSOA era favorecida, só o papel.
array<string> draw_special_roles(uint player_count, uint impostor_count, const array<bool>&in is_bot,
		const dictionary&in role_counts, const dictionary&in role_chances) {
	array<string> vagas_sorteadas;
	for (uint r = 0; r < CONFIGURABLE_ROLE_IDS.length(); r++) {
		string rid = CONFIGURABLE_ROLE_IDS[r];
		int vagas = 0;
		if (!role_counts.get(rid, vagas) || vagas <= 0) continue;
		int chance = 100;
		if (role_chances.exists(rid)) role_chances.get(rid, chance);
		for (int n = vagas; n > 0; n--) {
			if (chance < 100 && random(1, 100) > chance) continue;
			vagas_sorteadas.insert_last(rid);
		}
	}
	for (int i = int(vagas_sorteadas.length()) - 1; i > 0; i--) {
		int j = random(0, i);
		string tmp = vagas_sorteadas[i];
		vagas_sorteadas[i] = vagas_sorteadas[j];
		vagas_sorteadas[j] = tmp;
	}

	array<string> role_of(player_count, "");
	uint next_impostor = 0, next_crew = impostor_count;
	for (uint v = 0; v < vagas_sorteadas.length(); v++) {
		string rid = vagas_sorteadas[v];
		if (role_for(rid).team == TEAM_IMPOSTOR) {
			while (next_impostor < impostor_count && is_bot[next_impostor]) next_impostor++;
			if (next_impostor >= impostor_count) continue; // time cheio: esta vaga não sai, as outras seguem
			role_of[next_impostor++] = rid;
		} else {
			while (next_crew < player_count && is_bot[next_crew]) next_crew++;
			if (next_crew >= player_count) continue;
			role_of[next_crew++] = rid;
		}
	}
	return role_of;
}

// O que ESTE jogador pode agora - o papel dele combinado com estar vivo ou não.
//
// Papel e estado são coisas separadas de propósito: um fantasma continua sendo tripulante ou
// impostor (isso decide quem vence), mas para de poder agir sobre o mundo. Misturar os dois num
// booleano só foi o que produziu os casos errados que apareceram na prática - o fantasma sendo
// cegado por uma sabotagem que não o ameaça, por exemplo.
class player_abilities {
	role_traits@ role;
	bool alive = true;
	// Na barriga do lobo. Conta como não-vivo para tudo que a morte tira (votar, reportar, matar), mas
	// NÃO ganha o que a morte dá ao fantasma: não sabota, não usa habilidade de morto, não faz tarefa.
	// Está preso, não livre pela nave.
	bool swallowed = false;

	player_abilities(role_traits@ role, bool alive = true, bool swallowed = false) {
		@this.role = @role;
		this.alive = alive;
		this.swallowed = swallowed;
	}

	// --- Ações: todas exigem estar vivo ---
	bool can_kill() const { return alive && role.can_kill; }
	// A regra da SALA entra como parâmetro, e não como campo, para toda pergunta ter que dizê-la: um
	// ponto que esquecesse os dutos desligados não compila, em vez de oferecer um duto que o servidor
	// recusa calado.
	bool can_vent(bool room_allows_vents) const { return room_allows_vents && alive && role.can_vent; }
	// A ÚNICA capacidade que sobrevive à morte, como no jogo original: o impostor morto continua
	// sabotando. É o que ele ainda tem a oferecer ao time - matar, ventilar e fechar portas acabam
	// com ele, e sem isto morrer cedo como impostor era virar espectador puro.
	bool can_sabotage() const { return role.can_sabotage && !swallowed; }
	bool can_close_doors() const { return alive && role.can_close_doors; }
	bool can_report_bodies() const { return alive && role.can_report_bodies; }
	bool can_call_meeting() const { return alive && role.can_call_meeting; }
	// Votar é o único direito que a morte tira sem exceção, e por isso não olha o papel.
	bool can_vote() const { return alive; }
	// Tem uma habilidade ativa E pode usá-la neste estado. A recarga é conferida no servidor.
	bool has_ability() const {
		if (role.ability_id == "" || swallowed) return false;
		return alive ? role.ability_usable_alive : role.ability_usable_dead;
	}

	// --- Tarefas ---
	// NÃO exige estar vivo: fantasma continua fazendo tarefas, e elas continuam contando para a
	// vitória da tripulação. É o que dá o que fazer a quem morreu cedo. Na barriga, não.
	bool does_tasks() const { return role.tasks_count_for_crew && !swallowed; }

	// --- Percepção ---
	// Fantasma nunca é atrapalhado: sabotagem existe para pressionar quem ainda pode perder alguma
	// coisa, e ele já perdeu. Cegá-lo não cria tensão - só torna tedioso o que ainda ajuda o time.
	bool blinded_by_comms(const string&in active_sabotage) const {
		if (active_sabotage != "comms") return false;
		return alive && !role.immune_to_comms;
	}

	bool blinded_by_lights(const string&in active_sabotage) const {
		if (active_sabotage != "lights") return false;
		return alive && !role.immune_to_lights;
	}
}
