// game_loop.nvgt
// Laço principal de uma partida em andamento (após receber S_GAME_START). Cuida de: movimento
// absoluto (W/A/S/D = N/S/O/L), interação contextual com o objeto mais próximo (Enter), tasks,
// radar (Tab/Shift+Tab), reporte de corpo (R), ações de impostor (K = matar, V = ventilar,
// G = sabotagem), leitura da lista de tasks (T) e reação a todos os eventos de servidor.

#include "menu.nvgt"
#include "../audio/menu_music.nvgt"
#include "../core/hints.nvgt"
#include "form.nvgt"
#include "speech.nvgt"
#include "../network/client.nvgt"
#include "../audio/audio_manager.nvgt"
#include "../ui/radar.nvgt"
#include "../ui/meeting_ui.nvgt"
#include "../core/client_state.nvgt"
#include "../core/sabotage_rules.nvgt"
#include "../ui/camera_screen.nvgt"
#include "../ui/match_aware_menu.nvgt"
#include "../ui/clipboard.nvgt"
#include "../ui/visual_map.nvgt"
#include "../core/chat_log.nvgt"
#include "../audio/voice_chat.nvgt"
#include "../core/player.nvgt"
#include "../core/frame_timer.nvgt"
#include "../core/touch_input.nvgt"
#include "exit_alignment.nvgt"
#include "../game/roles/crewmate.nvgt"
#include "../game/roles/impostor.nvgt"
#include "../game/task_manager.nvgt"
#include "../game/sabotage_panels.nvgt"
#include "../game/map.nvgt"
#include "../i18n.nvgt"
#include "../config/game_constants.nvgt"
// A match_session trata cada mensagem do servidor num arquivo por assunto (src/game/match/).
#include "match/match_net_presence.nvgt"
#include "match/match_net_death.nvgt"
#include "match/match_net_meeting.nvgt"
#include "match/match_net_tasks.nvgt"
#include "match/match_net_ship.nvgt"
#include "match/match_net_abilities.nvgt"
#include "match/match_net_end.nvgt"
#include "match/match_frame_update.nvgt"
#include "match/match_frame_keys.nvgt"
#include "match/match_addict.nvgt"

// As teclas do jogo não são mais constantes: vêm do mapa remapeável do jogador, em
// config/keybindings.nvgt. Aqui se pergunta pela AÇÃO (action_pressed(ACTION_KILL)), nunca pela
// tecla - é o que permite trocar o teclado inteiro em Configurações sem tocar em nada disto.
// FOOTSTEP_INTERVAL_SECONDS e WALL_BUMP_INTERVAL_SECONDS moram em config/game_constants.nvgt: o modo
// de conhecer o mapa anda com o mesmo ritmo de passo da partida, e não deve incluir este arquivo.

// Os ajudantes, os menus e as tarefas locais da partida moram em src/game/match/.
#include "match/match_helpers.nvgt"
#include "match/match_menus.nvgt"
#include "match/match_task_helpers.nvgt"

// Executa uma partida inteira a partir do pacote S_GAME_START. Bloqueia até o fim da partida
// (S_GAME_OVER) ou até o jogador escolher sair (ESC + confirmação).
// Devolve o S_LOBBY_STATE da sala REABERTA quando a partida acabou e o grupo continua junto, ou
// null quando não há para onde voltar (conexão perdida, ou o servidor fechou a sala).
// A partida, do ponto de vista deste jogador: tudo que o laço precisa lembrar de um quadro para o outro.
// Era uma função só (run_game) com dezenas de variáveis locais; virou classe para poder ser dividida
// por assunto e exercitada por sonda sem teclado nem janela. O porquê de cada campo está onde ele é
// inicializado, no construtor - que é o antigo começo da função, na mesma ordem.
class match_session : match_net_presence_part, match_net_death_part, match_net_meeting_part, match_net_tasks_part, match_net_ship_part, match_net_abilities_part, match_net_end_part, match_frame_update_part, match_frame_keys_part, match_addict_part {
	game_client@ client;
	net_packet@ start_pkt;
	game_map@ map;
	audio_manager@ audio;
	client_roster@ roster;
	radar_ui@ radar;
	crewmate_controller@ crew;
	impostor_controller@ imp;
	uint64 my_peer_id;
	role_traits@ my_role;
	bool is_impostor;
	float my_ability_cooldown_remaining;
	float ability_cooldown_config;
	uint my_guess_count;
	uint guesses_left_this_meeting;
	array<string> configured_role_ids;
	json_object@ cfg_roles;
	float my_disguise_remaining;
	float my_invisible_remaining;
	// O alerta do veterano, só para a tecla responder "faltam N segundos" sem gastar a recarga.
	float my_alert_remaining;
	// A surdez da bomba do ofuscador: quanto falta para ela começar (logo depois do estouro) e para acabar.
	float deaf_delay;
	float deaf_remaining;
	// O viciado (ver match_addict): quanto falta para a próxima alucinação, os passos agendados de uma, e
	// os corpos falsos no chão (o id do marcador, onde está e quanto ainda dura).
	float addict_next;
	array<float> addict_step_at, addict_step_x, addict_step_y;
	array<uint64> addict_body_peers;
	array<float> addict_body_x, addict_body_y, addict_body_left;
	uint64 addict_body_serial;
	bool target_was_in_range;
	roster_entry@ target_in_range_entry;
	bool alive;
	bool swallowed;
	uint64 wolf_peer;
	uint64 pending_eat_peer;
	float my_x;
	float my_y;
	bool voice_room_allows;
	bool voice_comms_affects_meeting;
	float move_speed;
	float room_move_speed; // a velocidade da SALA, sem modificador: a de quem morre (ver lose_modifiers)
	bool death_removes_modifiers; // regra da sala; servidor anterior não manda, e nele a morte já tirava
	float footstep_interval;
	// A distância de um passo na velocidade da SALA: os passos dos outros soam a cada passo andado, e não
	// a cada tanto tempo - é isso que faz o Flash soar apressado e o Gigante arrastado.
	float step_length;
	bool room_allows_vents;
	string game_mode;
	float head_start;
	int head_start_said;
	float kill_cooldown_config;
	float my_kill_cooldown_remaining;
	float my_sabotage_cooldown_remaining;
	float my_doors_cooldown_remaining;
	// Quem eu (incendiário) já encharquei, dito pelo servidor (S_ABILITY_RESULT e, na volta, S_GAME_START).
	array<uint64> my_doused; // dita pelo servidor em cada S_DOORS_STATE (ver build_doors_packet)
	string active_sabotage_id;
	array<string> fixed_sabotage_panels;
	// As tarefas visíveis que OUTROS fazem agora: quem, em qual ponto, e o nome. As três listas andam
	// juntas. Servem para recusar um ponto ocupado (o scanner, cada arma, é de um de cada vez) e para o
	// modo gráfico mostrar a tarefa como o som a toca (ver draw_visual_map).
	array<uint64> visible_peers;
	array<map_object@> visible_spots;
	array<string> visible_names;
	string oxygen_code;
	int team_task_percent;
	bool is_vented;
	string current_vent_id;
	array<uint64> known_body_peers;
	array<vector> known_body_positions;
	bool near_body_last_frame;
	chat_log@ messages_log;
	chat_log@ events_log;
	meeting_ui@ mui;
	array<player_task> my_tasks;
	array<string> my_task_object_ids;
	array<string> all_task_spot_ids;
	json_array@ tasks_json;
	string role_desc;
	string role_text;
	array<uint64> impostor_partner_peers;
	// As partes do anúncio do papel que Ctrl + habilidade repete (ver current_role_text): os parceiros
	// pelo nome, os modificadores (veloz, gigante, apaixonado) e o alvo do carrasco. Guardadas aqui
	// porque a abertura as fala uma vez só, e o papel pode mudar no meio (amnésico, carrasco sem alvo).
	array<string> impostor_partner_names;
	string speed_modifier_id;  // "" | MOD_FLASH | MOD_GIANT
	string trait_modifier_id;  // "" | MOD_BAIT | MOD_DISEASED | MOD_TORCH
	string lover_name_spoken;  // "" = sem par
	// A abertura em duas etapas (ver opening_tick): o papel na hora, os modificadores depois. Os
	// modificadores esperam o som de início acabar e, para quem tem um modificador com som próprio, esse
	// som: a batida de coração do apaixonado, a latinha do bêbado (ver opening_modifier_sound).
	string opening_modifiers_text;
	int opening_stage;       // 0 = nada pendente, 1 = esperando o som de início, 2 = esperando o som do modificador
	int opening_sound_slot;
	string opening_modifier_sound; // "" = o modificador não tem som: os modificadores são ditos logo
	// O cartão do papel na tela para quem enxerga (draw_role_card): fica até este ticks(), ou até a pessoa
	// sair do lugar onde nasceu - quem já está andando quer ver o mapa.
	uint64 role_card_until;
	float role_card_x, role_card_y;
	string executioner_target_name;
	// O X9 que terminou as tarefas: quem são os impostores, como o servidor disse ("" = ainda não sabe).
	// Guardado do aviso para o Ctrl + habilidade repetir - o aviso fala uma vez só.
	string snitch_impostor_names;
	map_zone@ start_zone;
	string last_zone_id;
	string last_interactable_id;
	uint64 last_nearby_player_id;
	net_packet@ back_to_lobby;
	frame_timer frame_clock;
	timer@ footstep_clock;
	timer@ wall_bump_clock;
	timer@ ping_clock;
	bool ping_pending;
	bool game_over;
	bool movement_frozen;
	camera_view cameras;
	exit_alignment exits;
	string watched_room_id;
	// Saiu da partida sem sala para voltar (abandonou, ou a conexão caiu): run_game devolve null.
	bool abandoned = false;
	// Esta partida começou por uma VOLTA depois de cair (o S_GAME_START veio com `rejoin`).
	bool rejoining = false;

	match_session(game_client@ client, net_packet@ start_pkt) {
		@this.client = client;
		@this.start_pkt = start_pkt;
		// Uma pausa longa da rede daqui até o laço começar é anotada como carga da partida (ver o
		// diagnóstico em client.update) - é a suspeita do celular que cai quando a partida começa.
		g_net_stall_context = "carregando a partida";
		@map = build_map(start_pkt.get_string("map_name", MAP_THE_HUB));
		apply_mined_vents(map, start_pkt.get_array("mined_vents")); // quem volta depois de cair
		@audio = audio_manager();
		@roster = client_roster();
		@radar = radar_ui(client, audio);
		@crew = crewmate_controller(client);
		@imp = impostor_controller(client);

		// Redundante com o que o login já guardou, mas barato: se por algum motivo esse valor estiver
		// zerado aqui, TODA comparação de peer_id da partida (voto, chat, kill, nome de quem está perto)
		// aponta pra pessoa errada.
		my_peer_id = start_pkt.get_uint64("your_peer_id", client.my_peer_id);
		if (my_peer_id != 0) client.my_peer_id = my_peer_id;

		// O papel diz o que este jogador PODE; o resto do laço pergunta por capacidade ("posso
		// ventilar?"), não por identidade ("sou impostor?"). É o que permite acrescentar um papel novo
		// sem revisitar cada condição do jogo - ver game/roles/role_traits.nvgt.
		trait_modifier_id = start_pkt.get_string("trait_modifier", "");
		@my_role = role_with_modifier(start_pkt.get_string("your_role"), trait_modifier_id);
		// "Time impostor", derivado do papel: é o que a reunião e as regras de sabotagem ainda perguntam.
		is_impostor = my_role.team == TEAM_IMPOSTOR;
		// Recarga da habilidade do papel, acompanhada localmente como a do kill: o servidor é quem
		// decide, isto é só para responder na hora sem viagem de rede.
		// O lobo começa recarregando (ability_starts_on_cooldown); servidor antigo não manda, e aí é zero.
		my_ability_cooldown_remaining = start_pkt.get_float("ability_initial_cooldown", 0.0);
		ability_cooldown_config = start_pkt.get_float("ability_cooldown_seconds");
		// Sniper: quantos palpites por reunião a sala deu a ele, e quantos restam nesta mesa.
		my_guess_count = uint(start_pkt.get_int("ability_guesses"));
		guesses_left_this_meeting = 0;
		// Os papéis que a sala LIGOU - a lista do que o sniper pode chutar. Sai do mesmo `role_counts`
		// que o pacote já trazia, e na ordem de CONFIGURABLE_ROLE_IDS, que é a ordem que o jogador
		// aprendeu nas regras da sala.
		@cfg_roles = start_pkt.get_object("role_counts");
		if (@cfg_roles != null) {
			for (uint i = 0; i < CONFIGURABLE_ROLE_IDS.length(); i++) {
				string rid = CONFIGURABLE_ROLE_IDS[i];
				if (cfg_roles.exists(rid) && int(cfg_roles[rid]) > 0) configured_role_ids.insert_last(rid);
			}
		}
		// Quanto falta da fantasia do shapeshifter. Só para ele responder à tecla sem ir à rede; quem
		// desfaz de verdade é o servidor, que avisa por S_SHIFT_ENDED.
		my_disguise_remaining = 0.0;
		// Idem para a invisibilidade do fantasma: o servidor é quem manda, isto é só para a tecla
		// responder na hora e para o microfone não abrir à toa.
		my_invisible_remaining = 0.0;
		my_alert_remaining = 0.0;
		deaf_delay = 0.0;
		deaf_remaining = 0.0;
		// A primeira alucinação não vem logo de cara: o começo da partida já tem barulho que chegue.
		addict_next = ADDICT_MIN_SECONDS;
		addict_body_serial = 0;
		// Bip de alvo ao alcance: guarda se havia alguém no quadro anterior, para o bip tocar na
		// TRANSIÇÃO e não a cada quadro.
		target_was_in_range = false;
		@target_in_range_entry = null;
		// Declarado aqui, junto do papel, e não mais adiante: a partir da montagem dos marcadores já se
		// pergunta se o jogador está vivo (sabotagem não atinge fantasma - ver core/sabotage_rules.nvgt).
		// Quem VOLTA depois de cair (`rejoin`, ver server_rejoin.nvgt) pode ter morrido enquanto estava fora.
		rejoining = start_pkt.get_bool("rejoin", false);
		alive = start_pkt.get_bool("alive", true);
		g_match_connection_lost = false;
		// Na barriga do Lobo Mau: `alive` é false (sai da votação e do radar de todos), mas não é fantasma -
		// não anda, não faz tarefa, não usa radar. Vai aonde o lobo for: o ouvinte acompanha a posição dele
		// (ver o fim do quadro), e é isso que faz a barriga soar como um lugar.
		swallowed = false;
		wolf_peer = 0;
		// Quem o LOBO pediu para engolir: sai do elenco dele quando o servidor confirma, senão o bip de alvo
		// e a tecla continuariam apontando para quem já está na barriga.
		pending_eat_peer = 0;
		my_x = start_pkt.get_float("your_x");
		my_y = start_pkt.get_float("your_y");
		roster.load_from_start_packet(start_pkt);
		// Quem está numa tela bloqueante precisa do elenco para dizer QUEM matou (ver event_speech).
		@g_match_roster = roster;
		// As vozes passam a tocar no ponto de cada pessoa (o elenco guarda a posição de todos, inclusive
		// a minha - ver roster.update_position no movimento). Servidor antigo não manda voice_chat.
		// A regra da sala vale para a partida inteira; o que muda no meio é a sabotagem de comunicações,
		// que derruba o rádio enquanto durar (ver voice_down_for).
		voice_room_allows = start_pkt.get_bool("voice_chat", false);
		// Servidor antigo não manda: nele a reunião nunca era atingida, que era o comportamento de lá.
		voice_comms_affects_meeting = start_pkt.get_bool("comms_affects_meeting", false);
		g_voice.begin_match(roster, client.my_peer_id, voice_room_allows);
		// Regras da sala que o cliente aplica sozinho (ver server.on_start_game). Servidor antigo não
		// manda: nele a velocidade era a fixa de antes e os dutos estavam sempre liberados.
		move_speed = start_pkt.get_float("move_speed", 2.2);
		footstep_interval = footstep_interval_for(move_speed);
		float velocidade_da_sala = start_pkt.get_float("room_move_speed", move_speed);
		room_move_speed = velocidade_da_sala;
		death_removes_modifiers = start_pkt.get_bool("death_removes_modifiers", true);
		step_length = velocidade_da_sala * footstep_interval_for(velocidade_da_sala);
		room_allows_vents = start_pkt.get_bool("vents_enabled", true);
		g_room_visible_tasks = start_pkt.get_bool("visible_tasks", true);
		// Modo de jogo (pega-pega, todos lobos). No pega-pega, quanto o pegador fica parado no começo: a
		// contagem é feita aqui, e dita a todos - como o relógio da reunião.
		game_mode = start_pkt.get_string("game_mode", GAME_MODE_CLASSIC);
		head_start = start_pkt.get_float("head_start", 0.0);
		head_start_said = int(head_start) + 1; // o último número dito da contagem

		// Cooldown de kill acompanhado localmente (só é preciso de verdade pro impostor) - o servidor
		// continua sendo quem decide de fato se o kill vale (ver network/server.on_kill), isso aqui é só
		// pra dar feedback na hora sem precisar de um round-trip toda vez que aperta a tecla.
		kill_cooldown_config = start_pkt.get_float("kill_cooldown_seconds");
		// Quem volta à partida traz a recarga de AGORA; no começo ela é a cheia.
		my_kill_cooldown_remaining = start_pkt.get_float("kill_cooldown_remaining", kill_cooldown_config);

		// Cooldown de sabotagem acompanhado do mesmo jeito. A partida já começa com ele contando (ver
		// SABOTAGE_INITIAL_COOLDOWN_SECONDS) - quem manda o valor é o servidor, que é quem de fato
		// recusa a sabotagem cedo demais.
		my_sabotage_cooldown_remaining = start_pkt.get_float("sabotage_cooldown_seconds");
		my_doors_cooldown_remaining = 0.0; // a partida começa com as portas livres (ver on_start_game)
		my_doused.resize(0);
		read_doused(start_pkt);
		active_sabotage_id = "";
		// Painéis desta sabotagem que já foram resolvidos por alguém (o oxigênio pede dois), e se o
		// scanner da enfermaria está ocupado. Os dois existem para o jogador não gastar uma travessia da
		// nave - ou dez segundos parado - por algo que já está resolvido ou não vai valer.
		visible_peers.resize(0);
		visible_spots.resize(0);
		visible_names.resize(0);
		oxygen_code = ""; // código desta sabotagem de oxigênio, dito ao abrir o painel // "" = nenhuma sabotagem em andamento
		team_task_percent = 0; // andamento das tasks da equipe inteira, atualizado por S_TASK_PROGRESS
		is_vented = false;
		current_vent_id = "";

		// Corpos conhecidos (pra anunciar "corpo aqui" ao chegar perto) - somem da lista quando alguém
		// reporta (ver S_BODY_REPORTED abaixo). Arrays paralelos: known_body_peers[i] é a vítima do
		// corpo em known_body_positions[i].
		near_body_last_frame = false;

		@messages_log = chat_log();
		@events_log = chat_log();
		// As teclas de leitura e o registro do que chega com um menu aberto passam a valer para ESTES
		// históricos, aqui e dentro de qualquer menu da partida (ver chat_review).
		begin_chat_review(messages_log, events_log);

		@mui = meeting_ui(client, audio, roster, events_log, is_impostor);
		mui.alive = alive; // quem volta morto não vota (o servidor recusaria de qualquer jeito)

		// Todos os pontos de tarefa do mapa: o radar de objetos do impostor (ver a tecla do radar).
		for (uint i = 0; i < map.objects.length(); i++) {
			if (map.objects[i].obj_type == OBJ_TASK_SPOT) all_task_spot_ids.insert_last(map.objects[i].id);
		}
		@tasks_json = start_pkt.get_array("tasks");
		load_tasks_from_json(tasks_json, my_tasks, my_task_object_ids);
		reset_wifi_wait();

		opening_sound_slot = audio.play_start_game();
		audio.start_ship_ambience(map.ship_ambience);
		audio.start_room_ambience(map);
		refresh_landmark_beacons(audio, map, my_task_object_ids, active_sabotage_id, my_role, alive);
		// Papel + (pro impostor) quem mais é impostor, numa fala só: speak() interrompe a fala anterior
		// por padrão, então dois speak() seguidos aqui comeriam o anúncio do papel.
		// A lista de parceiros só existe no pacote de quem é impostor (ver network/server.on_start_game) -
		// sem ela, dois impostores passavam a partida inteira sem saber que estavam no mesmo time.
		// A ORDEM do anúncio: cor (no modo cor), depois quantos impostores há / quem são os parceiros, e
		// só então a descrição do papel. Era a descrição primeiro, e o recado #124 pediu o contrário - com
		// razão: a descrição é longa, e o que se precisa guardar da abertura é contra quem se está jogando.
		// No último sobrevivente a descrição do impostor (time, sabotagem, fingir tarefa) não vale: quem
		// explica a partida é o texto do modo, mais abaixo.
		role_desc = game_mode == GAME_MODE_LAST_STANDING ? "" : role_intro_text(my_role);
		role_text = "";
		// Modo cor: a cor é a identidade do jogador nesta partida - é por ela que os outros vão chamá-lo.
		// Vem ANTES do papel, porque é o que ele precisa guardar primeiro.
		if (start_pkt.get_bool("color_mode", false)) {
			dictionary@ cp = dictionary();
			cp.set("color", color_mark(start_pkt.get_int("your_color")));
			role_text = tr("color_mode.you_are", cp) + " " + role_text;
		}
		// Peers dos parceiros de impostor: usados pra nunca mirar um deles ao matar (ver KEY_KILL).
		if (my_role.knows_teammates && game_mode != GAME_MODE_LAST_STANDING) {
			array<string> partner_names;
			json_array@ partners_json = start_pkt.get_array("impostor_partners");
			if (@partners_json != null) {
				for (uint i = 0; i < partners_json.length(); i++) {
					json_object@ partner = partners_json.get_object(i);
					if (@partner == null) continue;
					string partner_name = string(partner["name"]);
					if (partner_name != "") { partner_names.insert_last(partner_name); impostor_partner_names.insert_last(partner_name); }
					impostor_partner_peers.insert_last(uint64(partner["peer_id"]));
				}
			}
			if (partner_names.length() == 0) {
				role_text += " " + tr("role.impostor_alone");
			} else {
				string joined_partners = partner_names[0];
				for (uint i = 1; i < partner_names.length(); i++) joined_partners += ", " + partner_names[i];
				dictionary@ partner_params = dictionary();
				partner_params.set("names", joined_partners);
				role_text += " " + tr("role.impostor_partners", partner_params);
			}
		} else if (game_mode == GAME_MODE_TAG && start_pkt.get_string("tagger_name", "") != "") {
			// Pega-pega: quem foge sabe de quem foge. No lugar da contagem de impostores, que aqui não
			// diz nada (é sempre um, e ele não se esconde).
			dictionary@ tp = dictionary();
			tp.set("name", spoken_name(start_pkt.get_string("tagger_name", "")));
			role_text += " " + tr("tag.tagger_is", tp);
		} else if (game_mode != GAME_MODE_LAST_STANDING) {
			// Quantos impostores estão a bordo. O tripulante não sabe QUEM são, mas saber se procura um
			// ou três muda toda a leitura de uma reunião - sem isso a discussão começa no chute.
			int impostor_count = start_pkt.get_int("impostor_count", 1);
			dictionary@ count_params = dictionary();
			count_params.set("count", "" + impostor_count);
			role_text += " " + tr(impostor_count == 1 ? "role.impostor_count_one" : "role.impostor_count_many", count_params);
		}
		// Os papéis em jogo NÃO são anunciados aqui, e isso é decisão.
		//
		// Eles já estão nas regras da sala (tecla C na sala de espera), que qualquer um lê antes de
		// começar: repetir na abertura era uma parede de texto por cima do anúncio do papel, que é a
		// única coisa que o jogador precisa ouvir naquele instante.
		//
		// O `role_counts`/`role_chances` continua chegando no pacote porque o cliente não tem outro
		// acesso à configuração da sala depois que a partida começa - quem um dia quiser uma tecla que
		// responda "o que está em jogo aqui?" já tem o dado à mão (ver roles_in_play_text).
		role_text += " " + role_desc;
		// O Carrasco ouve o alvo junto com o papel - é a única coisa que ele precisa saber para jogar.
		// Os modificadores ficam FORA deste texto: numa fala só com o papel, a abertura ficava longa
		// demais, e no histórico (PageUp) eles se perdiam no fim de um parágrafo. Vão numa segunda etapa
		// (opening_tick), com entrada própria no histórico. Aqui só a explicação de cada um, uma vez.
		string mod_velocidade = start_pkt.get_string("speed_modifier", "");
		string amor = start_pkt.get_string("lover_name", "");
		opening_modifiers_text = "";
		// Com as dicas desligadas, os modificadores vêm no nome curto, como o Ctrl + habilidade os repete.
		if (mod_velocidade != "") opening_modifiers_text += " " + (hints_on() ? tr("modifier.assigned_" + mod_velocidade) : tr("role." + mod_velocidade) + ".");
		if (trait_modifier_id != "") opening_modifiers_text += " " + (hints_on() ? tr("modifier.assigned_" + trait_modifier_id) : tr("role." + trait_modifier_id) + ".");
		if (amor != "") {
			dictionary@ lp = dictionary();
			lp.set("name", spoken_name(amor));
			opening_modifiers_text += " " + tr(hints_on() ? "modifier.assigned_lovers" : "modifier.lover_short", lp);
		}
		while (opening_modifiers_text.substr(0, 1) == " ") opening_modifiers_text = opening_modifiers_text.substr(1);
		// O que o Ctrl + habilidade repete: só os NOMES (ver current_role_text).
		lover_name_spoken = amor != "" ? spoken_name(amor) : "";
		speed_modifier_id = mod_velocidade;
		opening_modifier_sound = opening_modifier_sound_for(amor != "", trait_modifier_id);
		string alvo_carrasco = start_pkt.get_string("execution_target_name", "");
		executioner_target_name = alvo_carrasco;
		if (alvo_carrasco != "") {
			dictionary@ ap = dictionary();
			ap.set("name", alvo_carrasco);
			role_text += " " + tr("role.executioner_target", ap);
		}
		// O modo vem por último: ele muda a regra de tudo o que veio antes ("aqui não há reunião").
		if (game_mode == GAME_MODE_TAG) role_text = with_hint(role_text, "mode.tag_intro");
		else if (game_mode == GAME_MODE_WOLVES) role_text = with_hint(role_text, "mode.wolves_intro");
		else if (game_mode == GAME_MODE_LAST_STANDING) role_text = with_hint(role_text, "mode.last_standing_intro");
		while (role_text.substr(0, 1) == " ") role_text = role_text.substr(1); // as partes entram com espaço na frente
		// De volta depois de cair: primeiro ONDE se está (de volta, e se ainda vivo), depois o papel - quem
		// caiu pode ter passado um minuto fora, e a partida pode ter mudado inteira nesse tempo.
		if (rejoining) role_text = tr(alive ? "game.rejoined" : "game.rejoined_dead") + " " + role_text;
		speak(role_text);
		events_log.add("", role_text); // dá pra reler com PageUp + vírgula/ponto
		// Segunda etapa: sem som de modificador, os modificadores entram na fila da fala logo atrás do papel.
		// Com som, esperam o som de início e o dele (opening_tick) - a batida é o sinal do casal, a latinha
		// o do bêbado.
		opening_stage = opening_modifier_sound != "" ? 1 : 0;
		if (opening_modifier_sound == "" && opening_modifiers_text != "") say_opening_modifiers();
		role_card_until = ticks() + VISUAL_ROLE_CARD_MS;
		role_card_x = my_x;
		role_card_y = my_y;
		audio.update_listener(my_x, my_y);

		// Anúncio automático de sala/objeto - guarda o que foi anunciado por último pra só falar de novo
		// quando muda (entrar/sair de uma sala, entrar/sair do alcance de um objeto interativo).
		@start_zone = map.zone_at(my_x, my_y);
		last_zone_id = @start_zone != null ? start_zone.id : "";
		last_interactable_id = "";
		last_nearby_player_id = 0;

		// Retrato da sala reaberta no fim da partida (ver o tratamento de S_GAME_OVER).
		@back_to_lobby = null;

		@footstep_clock = timer();
		@wall_bump_clock = timer();
		@ping_clock = timer();
		ping_pending = false;
		game_over = false;
		movement_frozen = false; // true durante reunião/votação - todo mundo parado na cafeteria
		// Posto de câmeras (ver ui/camera_screen.nvgt). `watched_room_id` é a sala que a partida INTEIRA
		// sabe estar sob observação - é o que faz o zumbido tocar para quem está lá dentro, mesmo que
		// quem observa seja outra pessoa.
		cameras.build_room_list(map);
		// o aviso de alinhado com uma saída da sala (campo: exits)
		watched_room_id = "";

	}

	// Um quadro da partida. Devolve false quando o laço deve parar (a partida acabou, ou o jogador saiu).
	bool frame() {
		wait(5);
		client.update();
		// Gestos: enquanto este laço roda, a tela de toque está no modo PARTIDA (manche e gestos de
		// jogo). Um menu aberto daqui para de chamar isto, e a tela volta sozinha ao modo MENU.
		g_net_stall_context = "partida"; // depois do primeiro update: a carga já foi medida
		touch_match_frame();
		if (touch_take_action_menu_request()) run_touch_action_menu(client);

		net_packet@ pkt = client.poll_message();
		while (@pkt != null) {
			string t = pkt.type;
			// Se este pacote já entrou no histórico com um menu aberto, chat_log.add não o registra
			// de novo (ver net_packet.logged).
			@g_logging_packet = pkt;
			// Um pacote que exploda no meio do tratamento não pode levar a partida junto: o erro é
			// registrado com o TIPO do pacote (a informação que mais importa pra achar o culpado
			// depois) e o jogo segue no pacote seguinte. Ver core/crash_log.nvgt.
			try {
				handle_packet(pkt);
			}
			catch {
				log_crash("pacote " + t);
			}
			// A partida acabou: PARA de drenar aqui. O que ainda está na fila já é da próxima - o
			// retrato da sala reaberta (tirado logo acima) e, se o anfitrião não esperou, o
			// S_GAME_START da rodada seguinte. Continuar o laço jogava esse início fora, porque
			// nenhuma condição daqui o trata, e quem não apertava Enter na tela de resultado ficava
			// de fora da partida nova ouvindo ela acontecer.
			if (game_over) break;
			@pkt = client.poll_message();
		}
		@g_logging_packet = null;
		if (game_over) return false;
		// Conexão caiu (o servidor reiniciou, a internet foi embora): sem isto o laço continuava
		// rodando para sempre - o jogador andava por uma nave onde ninguém mais ouvia ninguém, sem
		// nenhum aviso. Quem chama (run_session) vê connected == false e volta ao menu inicial.
		if (!client.connected) {
			// Quem chama tenta VOLTAR à partida (reconnect_to_match): o servidor guarda o lugar por um
			// minuto. O aviso de queda é dele, junto da tentativa.
			end_chat_review();
			audio.stop_all(); // o alarme de sabotagem inclusive: ele seguia tocando durante a tentativa de volta
			@g_match_roster = null;
			abandoned = true;
			g_match_connection_lost = true;
			return false;
		}

		float delta = frame_clock.tick(); // sem perder frações - ver core/frame_timer.nvgt
		follow_wolf();
		// Depois de qualquer menu/tela bloqueante (task, lista de tasks, sabotagem, chat, votação -
		// que usa as MESMAS setas do movimento), o relógio não é pausado durante a espera, então
		// o primeiro frame ao voltar tem um delta gigante. Sem esse teto, se uma seta de movimento
		// ficasse "presa" bem na hora de fechar o menu, o jogador podia ser arremessado pra fora de
		// qualquer sala (fora do alcance de is_walkable) e ficar preso lá, sem nunca mais tocar som
		// de passo (só esbarrão, ou nada).
		if (delta > 0.1) delta = 0.1;
		tick_timers(delta);
		audio.tick_visible_tasks(); // os disparos da arma de quem limpa asteroides por perto
		opening_tick();
		addict_tick(delta);

		target_in_range_beep();

		move(delta);

		radar_and_talk_keys();

		belly_keys();
		action_keys();

		vent_keys();

		camera_keys();

		// Alinhado com uma saída da sala: um aviso no lado dela, uma vez (ver game/exit_alignment.nvgt).
		// Só quando se está andando de verdade - na reunião, na câmera e no duto ninguém procura porta.
		if (!movement_frozen && !cameras.active && !is_vented && !swallowed) exits.update(map, audio, my_x, my_y);

		draw_visual_map();

		meeting_and_menu_keys();

		if (key_pressed(KEY_ESCAPE)) {
			if (yes_no(tr("menu.quit_confirm"), null, tr("menu.yes"), tr("menu.no"))) {
				client.send_leave_lobby();
				audio.stop_all(); // saiu no meio: nada da partida segue tocando no menu
				@g_match_roster = null;
				end_chat_review();
				abandoned = true; // abandonou a partida: não há sala para voltar
				return false;
			}
		}
		return !game_over;
	}

	// Cada mensagem do servidor tem o seu método (on_<mensagem>), nos arquivos de src/game/match/.
	void handle_packet(net_packet@ pkt) {
		string t = pkt.type;
		if (t == S_PLAYER_MOVED) on_player_moved(pkt);
		else if (t == S_PLAYER_LEFT) on_player_left(pkt);
		else if (t == S_TASK_RESULT) on_task_result(pkt);
		else if (t == S_PLAYER_KILLED) on_player_killed(pkt);
		else if (t == S_CHAT_MESSAGE) on_chat_message(pkt);
		else if (t == S_BODY_REPORTED) on_body_reported(pkt);
		else if (t == S_MEETING_STARTED) on_meeting_started(pkt);
		else if (t == S_MEETING_KILL) on_meeting_kill(pkt);
		else if (t == S_VOTING_STARTED) on_voting_started(pkt);
		else if (t == S_VOTE_CAST) on_vote_cast(pkt);
		else if (t == S_VOTE_RESULT) on_vote_result(pkt);
		else if (t == S_SABOTAGE_STARTED) on_sabotage_started(pkt);
		else if (t == S_CAMERA_STATE) on_camera_state(pkt);
		else if (t == S_VANISH_ENDED) on_vanish_ended(pkt);
		else if (t == S_PLAYER_RENAMED) on_player_renamed(pkt);
		else if (t == S_SHIFT_SOUND) on_shift_sound(pkt);
		else if (t == S_SHIFT_ENDED) on_shift_ended(pkt);
		else if (t == S_DEATH_ALARM) on_death_alarm(pkt);
		else if (t == S_SERVER_NOTICE) on_server_notice(pkt);
		else if (t == S_KILL_WITNESSED) on_kill_witnessed(pkt);
		else if (t == S_NEARBY_PLAYERS) on_nearby_players(pkt);
		else if (t == S_SWALLOWED) on_swallowed(pkt);
		else if (t == S_SWALLOW_SOUND) on_swallow_sound(pkt);
		else if (t == S_BODY_REMOVED) on_body_removed(pkt);
		else if (t == S_BODY_PLACED) on_body_placed(pkt);
		else if (t == S_BODY_SOUND) on_body_sound(pkt);
		else if (t == S_ROLE_CHANGED) on_role_changed(pkt);
		else if (t == S_IMPOSTOR_PARTNERS) on_impostor_partners(pkt);
		else if (t == S_PLAYER_REVIVED) on_player_revived(pkt);
		else if (t == S_HEARTBREAK) on_heartbreak(pkt);
		else if (t == S_BELLY_RELEASED) on_belly_released(pkt);
		else if (t == S_ABILITY_RESULT) on_ability_result(pkt);
		else if (t == S_POISON_DONE) on_poison_done(pkt);
		else if (t == S_TRANSPORTED) on_transported(pkt);
		else if (t == S_VENT_CREATED) on_vent_created(pkt);
		else if (t == S_SOUND_BOMB) audio.play_sound_bomb(pkt.get_float("x"), pkt.get_float("y"));
		else if (t == S_DEAFENED) on_deafened(pkt);
		else if (t == S_CAMERA_PLAYERS) on_camera_players(pkt);
		else if (t == S_CAMERA_WATCHING) on_camera_watching(pkt);
		else if (t == S_SABOTAGE_PROGRESS) on_sabotage_progress(pkt);
		else if (t == S_SABOTAGE_COUNTDOWN) on_sabotage_countdown(pkt);
		else if (t == S_SABOTAGE_FIXED) on_sabotage_fixed(pkt);
		else if (t == S_VENT_STATE) on_vent_state(pkt);
		else if (t == S_VENT_SOUND) on_vent_sound(pkt);
		else if (t == S_DOORS_STATE) on_doors_state(pkt);
		else if (t == S_COUGH) on_cough(pkt);
		else if (t == S_DECONTAMINATED) on_decontaminated(pkt);
		else if (t == S_TASK_VISIBLE) on_task_visible(pkt);
		else if (t == S_TASK_PROGRESS) on_task_progress(pkt);
		else if (t == S_RADAR_RESULT) on_radar_result(pkt);
		else if (t == S_GAME_OVER) on_game_over(pkt);
		else if (t == S_ERROR) on_error(pkt);
		else if (t == S_PONG && ping_pending) on_pong(pkt);
	}

	// O fim da partida: devolve o retrato da sala reaberta, ou null se o jogador saiu sem sala.
	net_packet@ finish() {
		if (abandoned) return null;
		audio.stop_ship_ambience();
		audio.stop_room_ambience();
		audio.stop_landmark_beacons();
		@g_match_roster = null; // o elenco morre com a partida
		end_chat_review();
		return back_to_lobby;
	}
}

// A última partida terminou porque a CONEXÃO caiu (e não por ESC nem pelo fim): é o sinal para a sessão
// tentar voltar a ela (reconnect_to_match, em ui/onboarding_screens.nvgt).
bool g_match_connection_lost = false;

net_packet@ run_game(game_client@ client, net_packet@ start_pkt) {
	menu_music_stop(); // na partida o som é o jogo
	g_settings.set_deafened(false); // nunca começa surdo
	match_session partida(client, start_pkt);
	while (partida.frame()) {}
	g_settings.set_deafened(false); // a partida acabou no meio da surdez: o som volta
	g_visual_map.clear_if_needed(); // fim da partida, por qualquer saída: a janela não fica com a nave parada
	return partida.finish();
}
