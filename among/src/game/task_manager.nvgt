// task_manager.nvgt
// Ponto único para rodar a minigame certa a partir do task_type de um map_object (ver game/map.nvgt).
// Devolve o resultado (sucesso/cancelado) para quem chamou reportar ao servidor.

#include "tasks/fix_wiring.nvgt"
#include "tasks/download_data.nvgt"
#include "tasks/empty_garbage.nvgt"
#include "tasks/align_engine.nvgt"
#include "tasks/swipe_card.nvgt"
#include "tasks/unlock_manifolds.nvgt"
#include "tasks/fuel_engines.nvgt"
#include "tasks/clear_asteroids.nvgt"
#include "tasks/roll_dice.nvgt"
#include "tasks/water_plants.nvgt"
#include "tasks/clean_o2_filter.nvgt"
#include "tasks/calibrate_distributor.nvgt"
#include "tasks/review_records.nvgt"
#include "tasks/submit_scan.nvgt"
#include "tasks/fix_weather_node.nvgt"
#include "tasks/insert_keys.nvgt"
#include "tasks/align_telescope.nvgt"
#include "tasks/record_temperature.nvgt"
#include "tasks/reboot_wifi.nvgt"
#include "tasks/replace_water_jug.nvgt"
#include "tasks/store_artifacts.nvgt"
#include "../audio/sound_catalog.nvgt"

// Roda a minigame correspondente a task_type e retorna true em caso de sucesso, false se falhou
// ou foi cancelada (ESC). task_type desconhecido também retorna false. Recebe o client pra cada
// minigame poder chamar client.update() no próprio laço - sem isso a conexão ficava sem ser servida
// durante minigames mais longos, e a task às vezes não completava (o pacote de sucesso se perdia
// numa conexão que o servidor já tinha considerado inativa).
// `phase` é a fase atual de uma tarefa de várias fases (ver task_chain em game/map.nvgt); zero
// para as de uma fase só, que é o caso da maioria.
// Os tipos que têm minijogo, um por `else if` de run_task_minigame, logo abaixo: tarefa nova entra NOS
// DOIS. A lista existe para a sonda dos mapas (probe_maps) conferir que todo ponto de tarefa de todo mapa
// abre alguma coisa - um tipo sem minijogo compila, aparece no mapa, e o Enter nele não faz nada.
const array<string> TASK_MINIGAME_TYPES = {"fix_wiring", "download_data", "empty_garbage", "align_engine",
	"swipe_card", "unlock_manifolds", "fuel_engines", "clear_asteroids", "roll_dice", "water_plants",
	"clean_o2_filter", "calibrate_distributor", "review_records", "submit_scan", "fix_weather_node", "insert_keys", "align_telescope", "record_temperature", "reboot_wifi", "replace_water_jug", "store_artifacts"};
bool task_minigame_exists(const string&in task_type) { return TASK_MINIGAME_TYPES.find(task_type) >= 0; }

// `start_object`: o ponto onde a tarefa COMEÇOU (o primeiro da corrente). Só o nó do clima usa: a etapa
// do laboratório precisa saber qual nó se consertou.
bool run_task_minigame(game_client@ client, const string&in task_type, uint phase = 0, const string&in start_object = "") {
	// Reunião chamada no exato instante em que a task abriu: nem começa (ver task_cancel_requested).
	if (task_cancel_requested(client)) return false;
	ui_sound("sounds/" + SND_TASK_INPROGRESS); // abriu: a task está "em andamento"
	bool result = false;
	if (task_type == "fix_wiring") result = run_fix_wiring_task(client);
	else if (task_type == "download_data") result = run_download_data_task(client);
	else if (task_type == "empty_garbage") result = run_empty_garbage_task(client);
	else if (task_type == "align_engine") result = run_align_engine_task(client);
	else if (task_type == "swipe_card") result = run_swipe_card_task(client);
	else if (task_type == "unlock_manifolds") result = run_unlock_manifolds_task(client);
	else if (task_type == "fuel_engines") result = run_fuel_engines_task(client, phase);
	else if (task_type == "clear_asteroids") result = run_clear_asteroids_task(client);
	else if (task_type == "roll_dice") result = run_roll_dice_task(client);
	else if (task_type == "water_plants") result = run_water_plants_task(client);
	else if (task_type == "clean_o2_filter") result = run_clean_o2_filter_task(client);
	else if (task_type == "calibrate_distributor") result = run_calibrate_distributor_task(client);
	else if (task_type == "review_records") result = run_review_records_task(client);
	else if (task_type == "submit_scan") result = run_submit_scan_task(client);
	else if (task_type == "fix_weather_node") result = run_fix_weather_node_task(client, phase, start_object);
	else if (task_type == "insert_keys") result = run_insert_keys_task(client);
	else if (task_type == "align_telescope") result = run_align_telescope_task(client);
	else if (task_type == "record_temperature") result = run_record_temperature_task(client);
	else if (task_type == "reboot_wifi") result = run_reboot_wifi_task(client, phase);
	else if (task_type == "replace_water_jug") result = run_replace_water_jug_task(client, phase);
	else if (task_type == "store_artifacts") result = run_store_artifacts_task(client, phase);
	// Fechou: terminada tem um som, fechada pela metade (ESC, reunião, erro) tem outro - o mesmo de
	// abrir, porque "em andamento" é exatamente o estado em que ela fica.
	ui_sound("sounds/" + (result ? SND_TASK_COMPLETE : SND_TASK_INPROGRESS));
	return result;
}
