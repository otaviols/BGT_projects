// colors.nvgt
// Cores de personagem disponíveis. Cada cor tem sons de morte/kill próprios quando existirem
// em sounds/colors/<cor>/, com fallback para os sons genéricos do protótipo antigo.

#include "../i18n.nvgt" // COLOR_MARK_PREFIX, que é o i18n quem resolve

// Quantas cores existem é o teto de jogadores numa partida: a atribuição dá uma cor por pessoa e,
// esgotadas as cores, passaria a repetir (ver o sorteio em network/server.nvgt). Por isso esta lista
// tem 15 nomes e MAX_PLAYERS é 15 - mexer num sem mexer no outro volta a repetir cor.
enum player_color {
	COLOR_RED = 0,
	COLOR_BLUE,
	COLOR_GREEN,
	COLOR_PINK,
	COLOR_ORANGE,
	COLOR_YELLOW,
	COLOR_BLACK,
	COLOR_WHITE,
	COLOR_PURPLE,
	COLOR_BROWN,
	COLOR_CYAN,
	// As quatro últimas trocaram na 0.38.0: saíram lima, bordô, cinza e bege - cores "sem graça" ou
	// subjetivas demais para quem só as ouve - e entraram coral, turquesa, prata e dourado. O
	// critério, num jogo de ouvido, é o NOME soar diferente dos outros nos três idiomas; coral é a
	// mesma palavra em português, inglês e espanhol, o que ajuda numa sala com idiomas misturados.
	// Os números ficaram os mesmos: a cor viaja pela rede como número.
	COLOR_CORAL,
	COLOR_TURQUOISE,
	COLOR_SILVER,
	COLOR_GOLD,
	COLOR_COUNT
}

// MODO COR: no lugar do nome de um jogador viaja esta MARCA, e cada cliente a troca pela cor no
// idioma DELE (ver resolve_color_marks em i18n.nvgt). A marca carrega a CHAVE da cor, e não o número,
// para o i18n poder traduzi-la sem conhecer esta tabela. Não pode ser texto pronto: numa sala com
// gente em português e em espanhol, "Rojo" e "Vermelho" são a mesma pessoa.
string color_mark(int color_id) { return COLOR_MARK_PREFIX + color_key(color_id); }

// Chave usada tanto para i18n (color.<key>) quanto para o nome da subpasta em sounds/colors/.
string color_key(int color_id) {
	switch (color_id) {
		case COLOR_RED: return "red";
		case COLOR_BLUE: return "blue";
		case COLOR_GREEN: return "green";
		case COLOR_PINK: return "pink";
		case COLOR_ORANGE: return "orange";
		case COLOR_YELLOW: return "yellow";
		case COLOR_BLACK: return "black";
		case COLOR_WHITE: return "white";
		case COLOR_PURPLE: return "purple";
		case COLOR_BROWN: return "brown";
		case COLOR_CYAN: return "cyan";
		case COLOR_CORAL: return "coral";
		case COLOR_TURQUOISE: return "turquoise";
		case COLOR_SILVER: return "silver";
		case COLOR_GOLD: return "gold";
	}
	return "unknown";
}

const uint KILLED_SOUND_VARIANT_COUNT = 4; // death1.ogg .. death4.ogg

// Caminho do som de morte para a cor, com fallback para os sons genéricos existentes.
string color_death_sound_path(int color_id) {
	string specific = "sounds/colors/" + color_key(color_id) + "/death.ogg";
	if (file_exists(specific)) return specific;
	// Fallback: alterna entre as 4 variantes genéricas de morte já existentes.
	uint variant = uint(color_id) % KILLED_SOUND_VARIANT_COUNT + 1;
	return "sounds/events/death" + variant + ".ogg";
}

// Caminho do som de kill (ouvido por quem está por perto do assassinato) para a cor, com fallback
// pro som genérico. Ainda não existe uma risada própria por cor - quando existir, colocar em
// sounds/colors/<cor>/kill.wav que o fallback deixa de ser usado automaticamente.
string color_kill_sound_path(int color_id) {
	string specific = "sounds/colors/" + color_key(color_id) + "/kill.ogg";
	if (file_exists(specific)) return specific;
	return "sounds/events/kill.ogg";
}

array<int>@ all_color_ids() {
	array<int> ids;
	for (int i = 0; i < COLOR_COUNT; i++) ids.insert_last(i);
	return ids;
}
