// lobby_config.nvgt
// Configuração de uma partida (lobby). Host escolhe/ajusta antes do início.

#include "game_constants.nvgt"
#include "../network/packet.nvgt"
#include "../game/roles/role_traits.nvgt"

// Impostores recomendados por quantidade de jogadores.
//
// Três impostores em dez jogadores é demais NESTE jogo, e o motivo é o áudio: sem visão, a
// tripulação demora muito mais para cruzar informação do que num Among Us de tela, enquanto o
// impostor não perde nada - ele mata pelo som igual. Com três, a partida acabava antes de a
// tripulação conseguir organizar uma suspeita. Dois mantêm a dupla de impostores (que é o que torna
// o jogo interessante para eles) sem afundar o outro lado.
//
// A faixa de três só começa em quinze jogadores, e hoje é inalcançável: MAX_PLAYERS é 10. Fica aqui
// pronta para quando o limite subir, em vez de virar uma surpresa naquele dia.
int default_impostor_count(uint player_count) {
	if (player_count <= 6) return 1;
	if (player_count <= 14) return 2;
	return 3;
}

// Ajustes que o anfitrião faz POR CIMA de um preset ao criar a sala.
//
// Existe como classe própria, e não como um lobby_config já preenchido, por causa do "não mexi
// nisto": um lobby_config tem sempre um valor em cada campo, então não haveria como distinguir
// "quero 10 jogadores" de "deixa como o preset manda". Aqui -1 (e "" para a sabotagem) é justamente
// essa ausência, e é o servidor que resolve o valor final.
class lobby_overrides {
	int max_players = -1;
	int impostor_count = -1;
	int task_count_per_crewmate = -1;
	int long_task_count = -1;
	float kill_cooldown_seconds = -1.0;
	float discussion_time_seconds = -1.0;
	float voting_time_seconds = -1.0;
	int emergency_meetings_per_player = -1;
	string sabotages = ""; // "" = preset, "on" = ligadas, "off" = desligadas
	string reveal_ejected = ""; // "" = preset, "on" = diz se o expulso era impostor, "off" = não diz
	string show_votes = ""; // "" = preset, "on" = diz em quem cada um votou, na hora; "off" = só diz que votou
	string voice_chat = ""; // "" = preset, "on" = chat de voz por proximidade, "off" = só texto
	string comms_in_meeting = ""; // "" = preset, "on" = comunicações sabotadas calam a reunião
	float emergency_cooldown_seconds = -1.0;
	// Papéis especiais: id -> quantos. Só entra aqui o que o anfitrião preencheu; o que ficou em
	// branco não é tocado, como todo o resto. -1 nunca aparece: um papel ausente do dicionário É o
	// "não mexi".
	dictionary role_counts;
	// Chance de cada vaga sair, em por cento (ausente = não mexi; 100 = sempre).
	dictionary role_chances;
	// Números dos papéis, por "<papel>.<número>" (ausente = usa o padrão do papel).
	dictionary role_values;

	// Aplica o que foi preenchido sobre uma configuração vinda do preset. O que ficou de fora não é
	// tocado. A validação continua sendo feita depois, por lobby_config.validate(): estes valores
	// vêm da máquina do jogador e não podem ser confiados só porque passaram por uma tela.
	void apply_to(lobby_config@ cfg) const {
		if (@cfg == null) return;
		array<string>@ ids = role_counts.get_keys();
		for (uint i = 0; i < ids.length(); i++) {
			int n = 0;
			if (role_counts.get(ids[i], n)) cfg.set_role_count(ids[i], n);
		}
		array<string>@ chance_ids = role_chances.get_keys();
		for (uint i = 0; i < chance_ids.length(); i++) {
			int c = 0;
			if (role_chances.get(chance_ids[i], c)) cfg.set_role_chance(chance_ids[i], c);
		}
		array<string>@ value_keys = role_values.get_keys();
		for (uint i = 0; i < value_keys.length(); i++) {
			float v = 0.0;
			if (role_values.get(value_keys[i], v)) cfg.role_values.set(value_keys[i], v);
		}
		if (max_players > 0) cfg.max_players = uint(max_players);
		if (impostor_count > 0) cfg.impostor_count = impostor_count;
		if (task_count_per_crewmate > 0) cfg.task_count_per_crewmate = uint(task_count_per_crewmate);
		if (long_task_count >= 0) cfg.long_task_count = uint(long_task_count);
		if (kill_cooldown_seconds > 0.0) cfg.kill_cooldown_seconds = kill_cooldown_seconds;
		if (discussion_time_seconds > 0.0) cfg.discussion_time_seconds = discussion_time_seconds;
		if (voting_time_seconds > 0.0) cfg.voting_time_seconds = voting_time_seconds;
		if (emergency_meetings_per_player > 0) cfg.emergency_meetings_per_player = uint(emergency_meetings_per_player);
		if (sabotages == "on") cfg.sabotages_enabled = true;
		else if (sabotages == "off") cfg.sabotages_enabled = false;
		if (reveal_ejected == "on") cfg.reveal_ejected_role = true;
		else if (reveal_ejected == "off") cfg.reveal_ejected_role = false;
		if (show_votes == "on") cfg.show_votes = true;
		else if (show_votes == "off") cfg.show_votes = false;
		if (voice_chat == "on") cfg.voice_chat = true;
		else if (voice_chat == "off") cfg.voice_chat = false;
		if (comms_in_meeting == "on") cfg.comms_affects_meeting = true;
		else if (comms_in_meeting == "off") cfg.comms_affects_meeting = false;
		if (emergency_cooldown_seconds >= 0.0) cfg.emergency_cooldown_seconds = emergency_cooldown_seconds;
	}

	void write_to_packet(net_packet@ pkt) const {
		if (@pkt == null) return;
		pkt.set_int("max_players", max_players);
		pkt.set_int("impostor_count", impostor_count);
		pkt.set_int("task_count_per_crewmate", task_count_per_crewmate);
		pkt.set_int("long_task_count", long_task_count);
		pkt.set_float("kill_cooldown_override", kill_cooldown_seconds);
		pkt.set_float("discussion_time_seconds", discussion_time_seconds);
		pkt.set_float("voting_time_seconds", voting_time_seconds);
		pkt.set_int("emergency_meetings_per_player", emergency_meetings_per_player);
		pkt.set_string("sabotages", sabotages);
		pkt.set_string("reveal_ejected", reveal_ejected);
		pkt.set_string("show_votes", show_votes);
		pkt.set_string("voice_chat", voice_chat);
		pkt.set_string("comms_in_meeting", comms_in_meeting);
		pkt.set_float("emergency_cooldown_seconds", emergency_cooldown_seconds);
		// Um objeto {id: quantos}, e não um campo por papel: assim um papel novo não muda o protocolo.
		json_object@ roles = json_object();
		array<string>@ ids = role_counts.get_keys();
		for (uint i = 0; i < ids.length(); i++) {
			int n = 0;
			if (role_counts.get(ids[i], n)) roles.set(ids[i], n);
		}
		pkt.set_object("role_counts", roles);
		json_object@ chances = json_object();
		array<string>@ chance_ids = role_chances.get_keys();
		for (uint i = 0; i < chance_ids.length(); i++) {
			int c = 0;
			if (role_chances.get(chance_ids[i], c)) chances.set(chance_ids[i], c);
		}
		pkt.set_object("role_chances", chances);
		json_object@ valores = json_object();
		array<string>@ value_keys = role_values.get_keys();
		for (uint i = 0; i < value_keys.length(); i++) {
			float v = 0.0;
			if (role_values.get(value_keys[i], v)) valores.set(value_keys[i], v);
		}
		pkt.set_object("role_values", valores);
	}

	void read_from_packet(net_packet@ pkt) {
		if (@pkt == null) return;
		role_counts.delete_all();
		json_object@ roles = pkt.get_object("role_counts");
		if (@roles != null) {
			array<string>@ ids = roles.get_keys();
			for (uint i = 0; i < ids.length(); i++) {
				// Só ids conhecidos: o resto vem da máquina do jogador e não tem o que fazer aqui.
				if (CONFIGURABLE_ROLE_IDS.find(ids[i]) != -1) role_counts.set(ids[i], int(roles[ids[i]]));
			}
		}
		role_chances.delete_all();
		json_object@ chances = pkt.get_object("role_chances");
		if (@chances != null) {
			array<string>@ ids = chances.get_keys();
			for (uint i = 0; i < ids.length(); i++) {
				if (CONFIGURABLE_ROLE_IDS.find(ids[i]) != -1) role_chances.set(ids[i], int(chances[ids[i]]));
			}
		}
		// Os valores não são filtrados aqui: a chave é composta ("papel.numero"), e quem confere se o
		// par existe é o validate() do lobby_config, com os limites que o próprio papel declarou.
		role_values.delete_all();
		json_object@ valores = pkt.get_object("role_values");
		if (@valores != null) {
			array<string>@ keys = valores.get_keys();
			for (uint i = 0; i < keys.length(); i++) role_values.set(keys[i], float(valores[keys[i]]));
		}
		max_players = pkt.get_int("max_players", -1);
		impostor_count = pkt.get_int("impostor_count", -1);
		task_count_per_crewmate = pkt.get_int("task_count_per_crewmate", -1);
		long_task_count = pkt.get_int("long_task_count", -1);
		kill_cooldown_seconds = pkt.get_float("kill_cooldown_override", -1.0);
		discussion_time_seconds = pkt.get_float("discussion_time_seconds", -1.0);
		voting_time_seconds = pkt.get_float("voting_time_seconds", -1.0);
		emergency_meetings_per_player = pkt.get_int("emergency_meetings_per_player", -1);
		sabotages = pkt.get_string("sabotages", "");
		reveal_ejected = pkt.get_string("reveal_ejected", "");
		show_votes = pkt.get_string("show_votes", "");
		voice_chat = pkt.get_string("voice_chat", "");
		comms_in_meeting = pkt.get_string("comms_in_meeting", "");
		emergency_cooldown_seconds = pkt.get_float("emergency_cooldown_seconds", -1.0);
	}
}

class lobby_config {
	string lobby_name = "";
	uint max_players = 10;
	int impostor_count = 1; // -1 = calcular automaticamente a partir dos jogadores conectados
	uint task_count_per_crewmate = DEFAULT_TASK_COUNT_PER_CREWMATE;
	// Quantas das pessoais são longas; o resto é curto (ver LONG_TASK_TYPES). Mexer nisto muda a
	// duração da partida mais do que qualquer outro número: tarefa longa é tempo andando pela nave.
	uint long_task_count = DEFAULT_LONG_TASK_COUNT;
	float kill_cooldown_seconds = KILL_COOLDOWN_SECONDS;
	float discussion_time_seconds = DISCUSSION_TIME_SECONDS;
	float voting_time_seconds = VOTING_TIME_SECONDS;
	uint emergency_meetings_per_player = DEFAULT_EMERGENCY_MEETINGS_PER_PLAYER;
	bool sabotages_enabled = true;
	// Dizer, ao expulsar alguém, se era impostor. Ligado é o jogo clássico; desligado é o modo em
	// que a tripulação nunca tem certeza de nada - cada expulsão vira dúvida em vez de resposta.
	bool reveal_ejected_role = true;
	// Dizer em quem cada um votou, NA HORA do voto. Ligado, a reunião é aberta: "fulano votou em
	// beltrano" muda a discussão enquanto ela acontece. Desligado, só se sabe que votou - e o
	// resultado sai sem a lista de quem votou em quem.
	bool show_votes = true;
	// Chat de voz por proximidade. Regra da SALA, e não só preferência de cada um, porque muda o
	// jogo para todos: com voz, a reunião vira conversa e o corredor vira lugar de cochicho. Quem
	// prefere jogar só por texto cria a sala assim, e ninguém entra esperando outra coisa.
	bool voice_chat = true;
	// Comunicações sabotadas calam o chat de voz TAMBÉM na reunião. LIGADO por padrão: sabotar as
	// comunicações antes de um corpo aparecer passa a ser uma jogada de impostor de verdade, com a
	// discussão acontecendo só por texto. Quem preferir que a reunião seja sempre intocável desliga
	// na sala - mas o padrão é a sabotagem valer para tudo, que é o que faz dela uma ameaça.
	bool comms_affects_meeting = true;
	// Recarga do botão de emergência. Em partida grande, quinze segundos permitem reuniões em
	// sequência que não deixam ninguém jogar; em partida pequena, atrapalham.
	float emergency_cooldown_seconds = EMERGENCY_MEETING_COOLDOWN_SECONDS;
	string map_name = "the_hub";
	string language = DEFAULT_LANGUAGE;
	// Papéis especiais em jogo: id -> quantos. Ausente = zero. TUDO desligado por padrão, em todo
	// preset: quem não mexer joga o jogo de sempre, e é isso que torna a chegada dos papéis segura.
	dictionary role_counts;
	// Chance de CADA vaga do papel sair, em por cento. Ausente = 100. É o que separa "há um xerife"
	// de "pode haver um xerife": com chance abaixo de 100, a tripulação não pode assumir que ele
	// existe, e é justamente essa dúvida que faz o papel valer a pena. As chances são públicas (vão
	// nas regras da sala); o RESULTADO do sorteio é que não é.
	dictionary role_chances;

	int role_count(const string&in role_id) const {
		int n = 0;
		if (!role_counts.exists(role_id)) return 0;
		role_counts.get(role_id, n);
		return n;
	}

	void set_role_count(const string&in role_id, int n) {
		if (n <= 0) role_counts.delete(role_id);
		else role_counts.set(role_id, n);
	}

	int role_chance(const string&in role_id) const {
		int c = 100;
		if (!role_chances.exists(role_id)) return 100;
		role_chances.get(role_id, c);
		return c;
	}

	void set_role_chance(const string&in role_id, int percent) {
		// 100 não é guardado: ausência JÁ significa "sempre", e um campo a menos no pacote é um
		// campo a menos para divergir.
		if (percent >= 100) role_chances.delete(role_id);
		else role_chances.set(role_id, percent);
	}

	// Números ajustáveis de cada papel (recarga, duração, janela do rastro), guardados por
	// "<papel>.<número>". Só o que foi MEXIDO entra aqui: o resto vem do padrão declarado pelo papel
	// (ver role_tunable), e assim mudar um padrão no código vale para todas as salas antigas.
	dictionary role_values;

	float role_value(const string&in role_id, const string&in key) const {
		string k = role_id + "." + key;
		if (role_values.exists(k)) {
			float v = 0.0;
			if (role_values.get(k, v)) return v;
		}
		return role_for(role_id).tunable_default(key);
	}

	void set_role_value(const string&in role_id, const string&in key, float v) {
		role_values.set(role_id + "." + key, v);
	}

	// Se algum papel especial está ligado. É o que decide se a sala exige cliente novo.
	bool uses_roles() const {
		return role_counts.get_size() > 0;
	}

	// Corrige valores fora dos limites aceitáveis. Retorna true se algo foi ajustado.
	bool validate() {
		bool changed = false;
		if (max_players < MIN_PLAYERS) { max_players = MIN_PLAYERS; changed = true; }
		if (max_players > MAX_PLAYERS) { max_players = MAX_PLAYERS; changed = true; }
		int max_impostors = int(max_players / 2) - 1;
		if (max_impostors < 1) max_impostors = 1;
		if (impostor_count > max_impostors) { impostor_count = max_impostors; changed = true; }
		if (impostor_count < 1 && impostor_count != -1) { impostor_count = 1; changed = true; }
		if (task_count_per_crewmate < 1) { task_count_per_crewmate = 1; changed = true; }
		// Mais longas do que tarefas no total não quer dizer nada, e o sorteio acabaria devolvendo
		// menos tarefas do que o anfitrião pediu sem explicar por quê.
		if (long_task_count > task_count_per_crewmate) { long_task_count = task_count_per_crewmate; changed = true; }
		if (kill_cooldown_seconds < 5.0) { kill_cooldown_seconds = 5.0; changed = true; }
		if (discussion_time_seconds < 5.0) { discussion_time_seconds = 5.0; changed = true; }
		if (voting_time_seconds < 5.0) { voting_time_seconds = 5.0; changed = true; }
		if (emergency_cooldown_seconds < 0.0) { emergency_cooldown_seconds = 0.0; changed = true; }
		if (emergency_cooldown_seconds > 300.0) { emergency_cooldown_seconds = 300.0; changed = true; }
		// Papéis: só ids conhecidos, e um teto absoluto pela lotação da sala. Nada além disso.
		//
		// NÃO se recorta por time nem pela quantidade de gente presente, e isso é decisão. O que a
		// sala guarda é a INTENÇÃO do anfitrião; quem lida com a realidade é o sorteio, que já sabe
		// quantos vieram e deixa de fora o que não couber (ver draw_special_roles). Recortar aqui
		// reescrevia em silêncio o que ele digitou - e pior, de um jeito que não voltava: baixar a
		// lotação para quatro apagava os papéis, e subir de volta não os trazia.
		//
		// Com chance abaixo de 100 isso ficava ainda mais errado: "3 xerifes a 30%" é um pedido
		// legítimo numa sala pequena, porque quase nunca saem três.
		array<string>@ ids = role_counts.get_keys();
		for (uint i = 0; i < ids.length(); i++) {
			if (CONFIGURABLE_ROLE_IDS.find(ids[i]) == -1) { role_counts.delete(ids[i]); changed = true; continue; }
			int n = role_count(ids[i]);
			if (n < 0) { n = 0; changed = true; }
			// Mais vagas de um papel do que gente cabe na sala não é intenção, é engano de digitação.
			if (n > int(max_players)) { n = int(max_players); changed = true; }
			set_role_count(ids[i], n);
		}
		// Números dos papéis: dentro dos limites que o PAPEL declarou, e só de pares conhecidos. Os
		// limites moram no papel porque só ele sabe o que é absurdo no caso dele - recarga do
		// engenheiro menor que a da sabotagem, janela do detetive curta demais para o mapa.
		array<string>@ value_keys = role_values.get_keys();
		for (uint i = 0; i < value_keys.length(); i++) {
			int ponto = value_keys[i].find_first_of(".");
			if (ponto <= 0) { role_values.delete(value_keys[i]); changed = true; continue; }
			string rid = value_keys[i].substr(0, ponto);
			string tk = value_keys[i].substr(ponto + 1);
			role_traits@ rt = role_for(rid);
			bool conhecido = false;
			float lo = 0.0, hi = 0.0;
			for (uint t = 0; t < rt.tunables.length(); t++) {
				if (rt.tunables[t].key != tk) continue;
				conhecido = true;
				lo = rt.tunables[t].min_value;
				hi = rt.tunables[t].max_value;
				break;
			}
			if (!conhecido) { role_values.delete(value_keys[i]); changed = true; continue; }
			float v = 0.0;
			role_values.get(value_keys[i], v);
			// Zero passa quando o papel admite zero como "usa o padrão da sala" (o tiro do xerife).
			if (v < lo && !(v == 0.0 && lo == 0.0)) { v = lo; changed = true; }
			if (v > hi) { v = hi; changed = true; }
			role_values.set(value_keys[i], v);
		}

		// Chances: dentro de 0 a 100, e só de papéis que estão realmente em jogo - uma chance
		// pendurada num papel com zero vagas seria lida nas regras como se o papel existisse.
		array<string>@ chance_ids = role_chances.get_keys();
		for (uint i = 0; i < chance_ids.length(); i++) {
			if (role_count(chance_ids[i]) <= 0) { role_chances.delete(chance_ids[i]); changed = true; continue; }
			int c = role_chance(chance_ids[i]);
			if (c < 0) { c = 0; changed = true; }
			if (c > 100) { c = 100; changed = true; }
			set_role_chance(chance_ids[i], c);
		}
		return changed;
	}

	int resolved_impostor_count(uint connected_players) {
		return impostor_count == -1 ? default_impostor_count(connected_players) : impostor_count;
	}

	// Empacota a configuração para mandar ao cliente.
	//
	// Vai TUDO, e não só o que a tela de hoje mostra: quem entra numa sala criada por outra pessoa
	// não tem outro jeito de saber em que partida está se metendo, e descobrir que o kill é de 12
	// segundos só depois do primeiro corpo é tarde demais.
	//
	// A contagem de impostores vai já RESOLVIDA (o -1 do modo automático vira o número real): o
	// cliente não tem como resolver isso sozinho, porque a regra depende de quanta gente está
	// conectada e é do servidor.
	json_object@ to_json(uint connected_players) const {
		json_object@ o = json_object();
		o.set("max_players", int(max_players));
		o.set("impostor_count", resolved_impostor_count(connected_players));
		o.set("impostors_automatic", impostor_count == -1);
		o.set("task_count_per_crewmate", int(task_count_per_crewmate));
		o.set("long_task_count", int(long_task_count));
		o.set("kill_cooldown_seconds", kill_cooldown_seconds);
		o.set("discussion_time_seconds", discussion_time_seconds);
		o.set("voting_time_seconds", voting_time_seconds);
		o.set("emergency_meetings_per_player", int(emergency_meetings_per_player));
		o.set("sabotages_enabled", sabotages_enabled);
		o.set("reveal_ejected_role", reveal_ejected_role);
		o.set("show_votes", show_votes);
		o.set("voice_chat", voice_chat);
		o.set("comms_affects_meeting", comms_affects_meeting);
		o.set("emergency_cooldown_seconds", emergency_cooldown_seconds);
		// Sempre presente, mesmo vazio: é como o cliente distingue "sala sem papéis" de "servidor
		// antigo que nem sabe o que é papel".
		json_object@ roles = json_object();
		json_object@ chances = json_object();
		array<string>@ ids = role_counts.get_keys();
		for (uint i = 0; i < ids.length(); i++) {
			roles.set(ids[i], role_count(ids[i]));
			if (role_chance(ids[i]) < 100) chances.set(ids[i], role_chance(ids[i]));
		}
		o.set("role_counts", roles);
		o.set("role_chances", chances);
		// Os números vão RESOLVIDOS (com o padrão do papel já aplicado), e só dos papéis em jogo: é
		// assim que a leitura das regras diz "engenheiro, recarga de 120 segundos" sem o cliente
		// precisar conhecer os padrões, e é o que o servidor manda ao cliente na partida.
		json_object@ valores = json_object();
		for (uint i = 0; i < ids.length(); i++) {
			role_traits@ rt = role_for(ids[i]);
			for (uint t = 0; t < rt.tunables.length(); t++) {
				valores.set(ids[i] + "." + rt.tunables[t].key, role_value(ids[i], rt.tunables[t].key));
			}
		}
		o.set("role_values", valores);
		return o;
	}
}
