// game_settings.nvgt
// Preferências do JOGADOR (não da partida): volume por família de som, mapa de teclas e voz.
// Ficam na pasta de dados do usuário, então sobrevivem a atualizações do jogo e não dependem de a
// pasta de instalação ser gravável.
//
// Volume é guardado em PORCENTAGEM (0 a 100) porque é isso que faz sentido pra quem ajusta; quem
// toca o som converte pra decibéis na hora, que é o que a engine entende (ver volume_db()).

#include "settings.nvgt"
#include "speech.nvgt"
#include "keybindings.nvgt"

// Famílias de som. Cada som do jogo pertence a exatamente uma - ver audio/audio_manager.nvgt, que é
// o único lugar que decide isso.
const int SOUND_FAMILY_MASTER = 0;    // multiplica todas as outras
const int SOUND_FAMILY_AMBIENCE = 1;  // nave, salas, corredores
const int SOUND_FAMILY_STEPS = 2;     // passos (seus e dos outros), esbarrões
const int SOUND_FAMILY_BEACONS = 3;   // marcadores de objeto, radar, corpo no chão
const int SOUND_FAMILY_TASKS = 4;     // minigames de task e interação com objetos
const int SOUND_FAMILY_EVENTS = 5;    // mortes, alarmes, reunião, vitória e derrota
const int SOUND_FAMILY_UI = 6;        // menus, diálogos, chat
// Música: hoje é só a do menu, antes de entrar numa partida. Família própria porque música é o que
// mais divide opinião - quem quer ouvir os passos abaixa a música e mais nada - e porque, com mais
// músicas no futuro, elas já nascem no lugar certo em vez de emprestadas da interface.
const int SOUND_FAMILY_MUSIC = 7;
// Vozes dos outros jogadores (chat de voz). Família própria porque é o som que mais varia de
// pessoa para pessoa - microfone alto, microfone baixo - e o ajuste tem que ser de quem ouve.
const int SOUND_FAMILY_VOICES = 8;
// O alarme que fica TOCANDO enquanto uma sabotagem está ativa. Família própria porque ele é o único
// som do jogo que não para: dura a sabotagem inteira por cima de tudo, e quem o achava demais só
// podia abaixar a família inteira de eventos - levando junto a morte, o corpo encontrado e a
// vitória, que tocam uma vez e são justamente os que ninguém quer perder.
//
// Ids novos entram no FIM: o que fica salvo em disco é "volume_<id>", então acrescentar aqui não
// mexe no que o jogador já ajustou.
const int SOUND_FAMILY_ALARM = 9;
const int SOUND_FAMILY_COUNT = 10;

const array<string> SOUND_FAMILY_IDS = {"master", "ambience", "steps", "beacons", "tasks", "events", "ui", "music", "voices", "alarm"};
const array<string> SOUND_FAMILY_NAME_KEYS = {"volume.master", "volume.ambience", "volume.steps",
	"volume.beacons", "volume.tasks", "volume.events", "volume.ui", "volume.music", "volume.voices",
	"volume.alarm"};

// Como o microfone abre no chat de voz.
const string VOICE_MODE_KEY = "key";   // segurando a tecla de falar
const string VOICE_MODE_AUTO = "auto"; // sozinho, quando a voz passa da sensibilidade

// O som quando a janela do jogo perde o foco (ver game_settings.background_audio).
const string BACKGROUND_AUDIO_NORMAL = "normal";
const string BACKGROUND_AUDIO_QUIET = "quiet";
const string BACKGROUND_AUDIO_MUTE = "mute";

// Quem lê a conversa (ver game_settings.chat_voice). TEM que vir antes de `game_settings g_settings`:
// global se inicializa na ordem do arquivo, e o construtor que lesse uma constante declarada depois a
// encontraria vazia - null pointer na abertura, o jogo fechava sem abrir (a 0.45.0).
const string CHAT_VOICE_SAME = "same"; // como o resto do jogo
const string CHAT_VOICE_SR = "sr";     // sempre o leitor de tela
const string CHAT_VOICE_TTS = "tts";   // sempre a voz do jogo

class game_settings {
	private settings store;
	array<int> volumes; // porcentagem por família, 0 a 100
	// Último usuário que entrou NESTA máquina. Só o nome: a senha não é guardada de propósito - ela
	// ficaria em texto puro num arquivo do computador, e "não redigitar o nome" já é o incômodo que
	// se queria resolver.
	string last_username = "";
	// "Lembrar de mim": o TOKEN de sessão que o servidor emitiu, nunca a senha. Só serve para entrar
	// neste jogo como este usuário, e o servidor pode invalidá-lo. Vazio = pedir a senha.
	string session_token = "";
	// A cor preferida (-1 = nenhuma), mandada ao entrar em cada sala. Fica no computador, como as
	// teclas: é gosto pessoal, e não precisa de conta nem de banco.
	int preferred_color = -1;
	// Idioma escolhido pelo jogador, no formato do nome do arquivo em lang/ (ex.: "pt_BR").
	// O padrão é pt_BR porque é o idioma em que o jogo foi escrito e o único garantidamente completo;
	// quem preferir outro troca uma vez e a escolha fica.
	string language = DEFAULT_LANGUAGE;

	// Chat de voz. O jogador decide se participa, como o microfone abre, e com que sensibilidade
	// (só no modo automático: 0 = só grito, 100 = qualquer sopro). Os dispositivos são guardados pelo
	// NOME, e não pelo índice: a ordem da lista muda quando se liga um fone, e o índice apontaria
	// para outro aparelho. "" = o padrão do sistema.
	// Radar contínuo (tecla Q durante a partida). Ligado, o alvo escolhido com Tab fica bipando até
	// sair de alcance; desligado, o Tab bipa uma vez e cala. É gosto, e divide opinião: uns querem
	// acompanhar a pessoa sem apertar nada, outros acham o bipe constante um ruído por cima do que
	// vieram escutar. Fica guardado porque é escolha que se faz uma vez, não a cada partida.
	bool radar_continuous = false;

	// Bip quando alguém entra no alcance da sua ação (matar, atirar, proteger). Só quem PODE agir
	// ouve. É o equivalente sonoro do botão de matar acendendo no original, e pode ser preferência
	// pessoal porque não cria informação nova: a posição de todos já chega ao cliente.
	bool target_range_beep = true;

	// Quanto o tom cai para o que está ao SUL (em %), aplicado a todo som posicionado - passos
	// alheios inclusive. O padrão do jogo são 6%, cerca de um semitom; quem tem dificuldade em
	// distinguir norte de sul pode reforçar, e quem acha que isso descaracteriza os sons pode
	// desligar. É o único ajuste de áudio que muda a INFORMAÇÃO e não o volume - por isso fica aqui
	// e não na tela de volumes.
	int spatial_pitch_percent = int(SPATIAL_SOUTH_PITCH_DECREASE);

	// Configurações de sala salvas pelo jogador, como um objeto JSON serializado
	// (ver config/lobby_presets.nvgt). Fica aqui, junto das teclas e dos volumes, porque é
	// preferência de quem joga - não depende de conta, de servidor nem de migração de banco.
	string lobby_presets = "";

	bool voice_chat_enabled = true;
	string voice_mode = VOICE_MODE_KEY;
	int voice_sensitivity = 50;
	// Ganho aplicado ao que SAI deste microfone, em porcentagem (100 = como o aparelho entrega).
	// Microfone fraco é problema de quem fala, e abaixar todo mundo do outro lado não resolve - por
	// isso existe dos dois lados: aqui e no volume por pessoa de quem ouve.
	int voice_mic_volume = 100;
	string voice_input_device = "";
	string audio_output_device = "";
	// O nome da última sala criada, que volta preenchido na próxima (recado #218): quem tem "a nave
	// do fulano" digitava o mesmo nome toda vez. Vazio = nunca criou, e o campo traz o padrão.
	string last_lobby_name = "";
	// Jogadores silenciados no chat de voz, pelo NOME de usuário: sobrevive à partida e à sessão,
	// porque quem incomoda hoje vai incomodar amanhã, e ninguém quer silenciar de novo a cada sala.
	array<string> muted_players;

	// Volume individual de cada voz, em porcentagem (100 = como veio). Guardado por NOME, junto com
	// os silenciados e pelo mesmo motivo: microfone alto ou baixo é uma característica da pessoa, e
	// reajustar a cada partida seria um trabalho sem fim. Arrays paralelos em vez de dicionário
	// porque isto é lido a cada quadro de voz e precisa ir direto para o disco como texto.
	array<string> voice_volume_names;
	array<int> voice_volume_values;

	int voice_volume_of(const string&in username) const {
		int at = voice_volume_names.find(username);
		return at == -1 ? 100 : voice_volume_values[at];
	}

	void set_voice_volume(const string&in username, int percent) {
		if (username == "") return;
		if (percent < 0) percent = 0;
		if (percent > VOICE_VOLUME_MAX_PERCENT) percent = VOICE_VOLUME_MAX_PERCENT;
		int at = voice_volume_names.find(username);
		// 100 é o padrão: não vale gravar, e apagar mantém o arquivo do tamanho do que foi mexido.
		if (percent == 100) {
			if (at != -1) { voice_volume_names.remove_at(at); voice_volume_values.remove_at(at); }
			return;
		}
		if (at == -1) { voice_volume_names.insert_last(username); voice_volume_values.insert_last(percent); }
		else voice_volume_values[at] = percent;
	}

	// Ajuste desta voz, em decibéis, para somar ao volume da família de vozes.
	float voice_volume_db(const string&in username) const {
		int percent = voice_volume_of(username);
		if (percent == 100) return 0.0;
		if (percent <= 0) return -100.0;
		return 20.0 * log10(float(percent) / 100.0);
	}

	bool is_muted(const string&in username) const { return username != "" && muted_players.find(username) != -1; }
	// Devolve o estado novo.
	bool toggle_muted(const string&in username) {
		int at = muted_players.find(username);
		if (at != -1) { muted_players.remove_at(at); return false; }
		muted_players.insert_last(username);
		return true;
	}

	game_settings() {
		volumes.resize(SOUND_FAMILY_COUNT);
		for (uint i = 0; i < volumes.length(); i++) volumes[i] = 100;
	}

	// Porcentagem -> decibéis. 100% = 0 dB (som original), 0% = silêncio na prática.
	// A conversão é logarítmica porque a percepção de volume é: 50% tem que SOAR metade, e não ser
	// metade da amplitude (que soaria quase igual).
	float percent_to_db(int percent) const {
		if (percent <= 0) return -100.0;
		if (percent >= 100) return 0.0;
		return 20.0 * log10(float(percent) / 100.0);
	}

	// Volume de uma família, em dB, pra passar na chamada de play. NÃO inclui o volume geral: esse é
	// aplicado pela própria engine (ver apply_master), e assim ele vale também pros sons que não
	// passam pelo nosso audio_manager - os cliques dos menus do NVGT, por exemplo.
	float volume_db(int family) const {
		if (family < 0 || family >= SOUND_FAMILY_COUNT) return 0.0;
		return percent_to_db(volumes[family]);
	}

	// O volume geral é o volume mestre da engine: pega TODO som que o jogo tocar, venha de onde vier.
	void apply_master() {
		sound_master_volume = percent_to_db(volumes[SOUND_FAMILY_MASTER]) + background_offset_db();
	}

	// SOM COM O JOGO EM SEGUNDO PLANO (recado #127): quem morreu e terminou as tarefas quer usar outra
	// janela enquanto a partida acaba, e a voz dos outros atrapalha. "normal" (padrão - ninguém perde
	// aviso sem ter escolhido), "quiet" (bem mais baixo) ou "mute".
	//
	// Só o SOM: a fala do jogo passa pelo leitor de tela, e silenciá-la exigiria mandar texto vazio
	// com interrupção - o que cortaria o leitor lendo a OUTRA janela, justamente o que a pessoa foi fazer.
	string background_audio = BACKGROUND_AUDIO_NORMAL;
	// O aviso de alinhado com uma saída da sala (ver game/exit_alignment.nvgt). Ligado por padrão: é
	// pedido antigo, e quem não quiser desliga na tela de audição.
	bool exit_alignment_beep = true;
	// Ouvir os PRÓPRIOS passos depois de morto. Desligado por padrão, que era o comportamento de sempre:
	// o fantasma anda em silêncio. Há quem prefira ouvir para se orientar enquanto faz as tarefas de
	// fantasma - e isto não cria informação nenhuma para os outros: só toca no cliente de quem morreu, e
	// os vivos continuam sem receber a posição dele (ver on_move no servidor).
	bool ghost_own_footsteps = false;
	// O mapa desenhado na janela, para quem enxerga (ui/visual_map.nvgt). Desligado: para quem joga por
	// som ele não muda nada, e desenhar a cada quadro é trabalho à toa.
	bool visual_map = false;
	// Já se perguntou, na primeira abertura, se a pessoa quer o modo gráfico (run_graphics_mode_first_run).
	// Quem já tem conta lembrada conta como perguntado: a pergunta é para computador NOVO, e quem já
	// joga por som não precisa ouvi-la depois de uma atualização.
	bool visual_map_asked = false;
	// Quem lê a CONVERSA (chat da partida, da sala de espera e do saguão): "igual ao jogo", o leitor de
	// tela ou a voz do jogo. Pedido do recado #89 e decisão do usuário: duas categorias só - o que as
	// pessoas escrevem e o que o jogo narra -, para quem quer separar as duas coisas pelo timbre. O
	// resto do jogo segue a escolha que já existia (leitor de tela ou voz do jogo).
	string chat_voice = CHAT_VOICE_SAME;
	private bool _window_was_active = true;

	float background_offset_db() const {
		if (_window_was_active || background_audio == BACKGROUND_AUDIO_NORMAL) return 0.0;
		return background_audio == BACKGROUND_AUDIO_MUTE ? -100.0 : -20.0;
	}

	// Chamada a cada update() do cliente (ver g_client_frame_hook): só mexe no volume quando o foco
	// MUDA, e não a cada quadro - o volume geral também é mexido pela tela de configurações.
	void apply_background_audio() {
		bool ativa = is_window_active();
		if (ativa == _window_was_active) return;
		_window_was_active = ativa;
		apply_master();
	}

	// Abre o arquivo de configuração uma única vez. Tanto load() quanto save() passam por aqui: sem
	// isso, um save() antes do primeiro load() não gravava nada e falhava calado.
	private bool ensure_open() {
		if (store.active) return true;
		return store.setup("BGT", "AmongUsAudiogame", false);
	}

	void load() {
		if (!ensure_open()) return;
		for (uint i = 0; i < SOUND_FAMILY_IDS.length(); i++) {
			volumes[i] = int(store.read_number("volume_" + SOUND_FAMILY_IDS[i], 100));
			if (volumes[i] < 0) volumes[i] = 0;
			if (volumes[i] > 100) volumes[i] = 100;
		}
		for (uint i = 0; i < g_keys.bindings.length(); i++) {
			key_binding@ b = g_keys.bindings[i];
			b.key = int(store.read_number("key_" + b.id, b.default_key));
		}
		// Voz: o próprio speech.nvgt sabe serializar e restaurar a configuração dele (voz escolhida,
		// velocidade, volume e se deve usar o leitor de tela quando existir).
		last_username = store.read_string("last_username", "");
		session_token = store.read_string("session_token", "");
		preferred_color = int(store.read_number("preferred_color", -1));
		background_audio = store.read_string("background_audio", BACKGROUND_AUDIO_NORMAL);
		exit_alignment_beep = store.read_number("exit_alignment_beep", 1) != 0;
		ghost_own_footsteps = store.read_number("ghost_own_footsteps", 0) != 0;
		visual_map = store.read_number("visual_map", 0) != 0;
		visual_map_asked = store.read_number("visual_map_asked", 0) != 0 || visual_map || last_username != "";
		chat_voice = store.read_string("chat_voice", CHAT_VOICE_SAME);
		if (chat_voice != CHAT_VOICE_SR && chat_voice != CHAT_VOICE_TTS) chat_voice = CHAT_VOICE_SAME;
		if (background_audio != BACKGROUND_AUDIO_QUIET && background_audio != BACKGROUND_AUDIO_MUTE) background_audio = BACKGROUND_AUDIO_NORMAL;
		language = store.read_string("language", DEFAULT_LANGUAGE);
		if (language == "") language = DEFAULT_LANGUAGE;
		string voice_config = store.read_string("tts", "");
		if (voice_config != "") tts_load_config(voice_config, tts);
		radar_continuous = store.read_number("radar_continuous", 0) != 0;
		lobby_presets = store.read_string("lobby_presets", "");
		target_range_beep = store.read_number("target_range_beep", 1) != 0;
		spatial_pitch_percent = int(store.read_number("spatial_pitch_percent", SPATIAL_SOUTH_PITCH_DECREASE));
		if (spatial_pitch_percent < 0) spatial_pitch_percent = 0;
		if (spatial_pitch_percent > SPATIAL_PITCH_MAX_PERCENT) spatial_pitch_percent = SPATIAL_PITCH_MAX_PERCENT;
		voice_chat_enabled = store.read_number("voice_chat_enabled", 1) != 0;
		voice_mode = store.read_string("voice_mode", VOICE_MODE_KEY);
		if (voice_mode != VOICE_MODE_AUTO) voice_mode = VOICE_MODE_KEY;
		voice_sensitivity = int(store.read_number("voice_sensitivity", 50));
		if (voice_sensitivity < 0) voice_sensitivity = 0;
		if (voice_sensitivity > 100) voice_sensitivity = 100;
		voice_mic_volume = int(store.read_number("voice_mic_volume", 100));
		if (voice_mic_volume < 0) voice_mic_volume = 0;
		if (voice_mic_volume > VOICE_VOLUME_MAX_PERCENT) voice_mic_volume = VOICE_VOLUME_MAX_PERCENT;
		voice_input_device = store.read_string("voice_input_device", "");
		audio_output_device = store.read_string("audio_output_device", "");
		last_lobby_name = store.read_string("last_lobby_name", "");
		muted_players.resize(0);
		string muted = store.read_string("muted_players", "");
		if (muted != "") muted_players = muted.split("|");
		voice_volume_names.resize(0);
		voice_volume_values.resize(0);
		// Formato: nome=porcentagem, separados por barra vertical (nenhum nome de usuário tem as duas).
		string volumes = store.read_string("voice_volumes", "");
		if (volumes != "") {
			array<string>@ parts = volumes.split("|");
			for (uint i = 0; i < parts.length(); i++) {
				int sep = parts[i].find_last("=");
				if (sep <= 0) continue;
				voice_volume_names.insert_last(parts[i].substr(0, sep));
				voice_volume_values.insert_last(parse_int(parts[i].substr(sep + 1)));
			}
		}

		apply_master();
		apply_output_device();
	}

	// Índice do dispositivo escolhido na lista atual do sistema (-1 = não está mais ligado, ou é o
	// padrão). O índice é o da própria lista: a documentação do NVGT fala de um item 0 "sem som", mas
	// nesta build as listas começam no primeiro aparelho de verdade (conferido com uma sonda:
	// sound_output_device = 1 era o segundo da lista, e microphone(1) o segundo microfone).
	int output_device_index() const {
		if (audio_output_device == "") return -1;
		const array<string>@ devices = get_sound_output_devices();
		for (uint i = 0; i < devices.length(); i++) if (devices[i] == audio_output_device) return int(i);
		return -1;
	}
	int input_device_index() const {
		if (voice_input_device == "") return -1;
		const array<string>@ devices = get_sound_input_devices();
		for (uint i = 0; i < devices.length(); i++) if (devices[i] == voice_input_device) return int(i);
		return -1;
	}

	// O que o sistema escolheu sozinho ao abrir o jogo: é para onde "padrão do sistema" volta.
	int default_output_index = -1;

	// Dispositivo escolhido que não está mais ligado cai no padrão em silêncio - o jogo tem que
	// abrir com som mesmo que o fone de ontem tenha ficado em casa.
	void apply_output_device() {
		if (default_output_index < 0) default_output_index = sound_output_device;
		int index = output_device_index();
		if (index < 0) index = default_output_index;
		if (index >= 0 && sound_output_device != index) sound_output_device = index;
	}

	void save() {
		if (!ensure_open()) return;
		for (uint i = 0; i < SOUND_FAMILY_IDS.length(); i++) {
			store.write_number("volume_" + SOUND_FAMILY_IDS[i], volumes[i]);
		}
		for (uint i = 0; i < g_keys.bindings.length(); i++) {
			key_binding@ b = g_keys.bindings[i];
			store.write_number("key_" + b.id, b.key);
		}
		store.write_string("last_username", last_username);
		store.write_string("session_token", session_token);
		store.write_number("preferred_color", preferred_color);
		store.write_string("background_audio", background_audio);
		store.write_number("exit_alignment_beep", exit_alignment_beep ? 1 : 0);
		store.write_number("ghost_own_footsteps", ghost_own_footsteps ? 1 : 0);
		store.write_number("visual_map", visual_map ? 1 : 0);
		store.write_number("visual_map_asked", visual_map_asked ? 1 : 0);
		store.write_string("chat_voice", chat_voice);
		store.write_string("language", language);
		store.write_string("tts", tts_dump_config(tts, true));
		store.write_number("radar_continuous", radar_continuous ? 1 : 0);
		store.write_string("lobby_presets", lobby_presets);
		store.write_number("target_range_beep", target_range_beep ? 1 : 0);
		store.write_number("spatial_pitch_percent", spatial_pitch_percent);
		store.write_number("voice_chat_enabled", voice_chat_enabled ? 1 : 0);
		store.write_string("voice_mode", voice_mode);
		store.write_number("voice_sensitivity", voice_sensitivity);
		store.write_number("voice_mic_volume", voice_mic_volume);
		store.write_string("voice_input_device", voice_input_device);
		store.write_string("audio_output_device", audio_output_device);
		store.write_string("last_lobby_name", last_lobby_name);
		store.write_string("muted_players", join(muted_players, "|"));
		array<string> volumes;
		for (uint i = 0; i < voice_volume_names.length(); i++) volumes.insert_last(voice_volume_names[i] + "=" + voice_volume_values[i]);
		store.write_string("voice_volumes", join(volumes, "|"));
	}
}

game_settings g_settings;

// O que o jogo pendura no g_client_frame_hook (ver network/client.nvgt), ligado em AmongUs.nvgt.
void background_audio_hook() { g_settings.apply_background_audio(); }

// Fala uma mensagem de CONVERSA pelo caminho que o jogador escolheu para ela (ver chat_voice). Troca o
// interruptor do speech.nvgt (`use_sr`) só durante esta fala e o devolve: o resto do jogo continua
// como estava. Sem interromper, por padrão - é como o chat sempre foi dito.
void speak_chat(const string&in text, bool interrupt = false) {
	if (g_settings.chat_voice == CHAT_VOICE_SAME) { speak(text, interrupt); return; }
	bool antes = use_sr;
	use_sr = g_settings.chat_voice == CHAT_VOICE_SR;
	speak(text, interrupt);
	use_sr = antes;
}

// Som de interface (abrir/fechar diálogo, avisos de menu). Fica aqui e não no audio_manager porque
// quem toca isso são as telas, que não têm um audio_manager por perto.
void ui_sound(const string&in path) {
	sound_play(path, vector(FLOAT_MAX, FLOAT_MAX, FLOAT_MAX), g_settings.volume_db(SOUND_FAMILY_UI), 0.0);
}
