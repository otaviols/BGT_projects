// user_db.nvgt
// Persistência de usuários (login/senha) e estatísticas via SQLite3.
// Senhas nunca são armazenadas em texto puro: salt aleatório (random_bytes) + SHA-256 com
// múltiplas iterações (stretch manual, já que o NVGT não expõe bcrypt/argon2/PBKDF2 nativamente).

#pragma plugin nvgt_sqlite
#include "sqlite3constants.nvgt"
#include "models.nvgt"

const uint PASSWORD_HASH_ITERATIONS = 20000;
const uint MIN_USERNAME_LENGTH = 3;
const uint MAX_USERNAME_LENGTH = 20;
const uint MIN_PASSWORD_LENGTH = 6;

// Nomes de coluna permitidos para update_stat(); nunca interpolar stat_name livre na query.
array<string>@ allowed_stat_columns() {
	array<string> cols = {"games_played", "games_won", "crewmate_wins", "impostor_wins", "tasks_completed", "kills"};
	return cols;
}

class user_database {
	private sqlite3@ db;

	bool open(const string&in path = "among_users.db") {
		@db = sqlite3();
		if (db.open(path) != SQLITE_OK) return false;
		return create_tables();
	}

	private bool create_tables() {
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS users (" +
			"id INTEGER PRIMARY KEY AUTOINCREMENT, " +
			"username TEXT UNIQUE NOT NULL, " +
			"password_hash TEXT NOT NULL, " +
			"salt TEXT NOT NULL, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP)"
		) != SQLITE_OK) return false;

		if (db.execute(
			"CREATE TABLE IF NOT EXISTS user_stats (" +
			"user_id INTEGER PRIMARY KEY, " +
			"games_played INTEGER DEFAULT 0, " +
			"games_won INTEGER DEFAULT 0, " +
			"crewmate_wins INTEGER DEFAULT 0, " +
			"impostor_wins INTEGER DEFAULT 0, " +
			"tasks_completed INTEGER DEFAULT 0, " +
			"kills INTEGER DEFAULT 0, " +
			"FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE)"
		) != SQLITE_OK) return false;

		// Recados dos jogadores. Fica no MESMO banco das contas de propósito: ele já mora no volume
		// persistente, então o feedback sobrevive a deploy pelo mesmo motivo que as contas sobrevivem,
		// sem nenhuma peça de infraestrutura nova para manter.
		//
		// O usuário fica como TEXTO, e não como chave estrangeira para users(id): se um dia a conta
		// for apagada, o recado continua legível em vez de virar um número órfão - e um recado sobre
		// um bug vale independentemente de quem ainda joga.
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS feedback (" +
			"id INTEGER PRIMARY KEY AUTOINCREMENT, " +
			"username TEXT, " +
			"text TEXT NOT NULL, " +
			"version TEXT, " +
			"language TEXT, " +
			"in_match INTEGER DEFAULT 0, " +
			"role TEXT, " +
			"room TEXT, " +
			"crash_log TEXT, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP)"
		) != SQLITE_OK) return false;

		db.execute("CREATE INDEX IF NOT EXISTS idx_username ON users(username)");
		return true;
	}

	// Guarda um recado de jogador. Nada aqui é validado além do tamanho (quem chama já cortou): um
	// recado meio estranho gravado é melhor do que um recado recusado, porque o recusado some para
	// sempre e ninguém fica sabendo que existiu.
	bool save_feedback(const string&in username, const string&in text, const string&in version,
		const string&in language, bool in_match, const string&in role, const string&in room,
		const string&in crash_log) {
		if (@db == null) return false;
		sqlite3statement@ st = db.prepare(
			"INSERT INTO feedback (username, text, version, language, in_match, role, room, crash_log) " +
			"VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
		if (@st == null) return false;
		st.bind_text(1, username, false);
		st.bind_text(2, text, false);
		st.bind_text(3, version, false);
		st.bind_text(4, language, false);
		st.bind_int(5, in_match ? 1 : 0);
		st.bind_text(6, role, false);
		st.bind_text(7, room, false);
		st.bind_text(8, crash_log, false);
		return st.step() == SQLITE_DONE;
	}

	// Cria um novo usuário. Retorna mensagem de erro vazia em caso de sucesso.
	bool create_user(const string&in username, const string&in password, string&out error_message) {
		error_message = "";
		if (username.length() < MIN_USERNAME_LENGTH || username.length() > MAX_USERNAME_LENGTH) {
			error_message = "invalid_username_length";
			return false;
		}
		if (password.length() < MIN_PASSWORD_LENGTH) {
			error_message = "invalid_password_length";
			return false;
		}
		if (user_exists(username)) {
			error_message = "username_taken";
			return false;
		}

		string salt = string_base64_encode(random_bytes(16));
		string hash = hash_password(password, salt);

		sqlite3statement@ stmt = db.prepare("INSERT INTO users (username, password_hash, salt) VALUES (?, ?, ?)");
		if (@stmt == null) {
			error_message = "db_error";
			return false;
		}
		stmt.bind_text(1, username, false);
		stmt.bind_text(2, hash, false);
		stmt.bind_text(3, salt, false);
		bool ok = stmt.step() == SQLITE_DONE;

		if (!ok) {
			error_message = "db_error";
			return false;
		}

		int user_id = get_user_id(username);
		if (user_id > 0) create_stats_row(user_id);
		return true;
	}

	bool user_exists(const string&in username) {
		sqlite3statement@ stmt = db.prepare("SELECT COUNT(*) FROM users WHERE username = ?");
		if (@stmt == null) return false;
		stmt.bind_text(1, username, false);
		bool exists = false;
		if (stmt.step() == SQLITE_ROW) exists = stmt.column_int(0) > 0;
		return exists;
	}

	bool verify_login(const string&in username, const string&in password) {
		sqlite3statement@ stmt = db.prepare("SELECT password_hash, salt FROM users WHERE username = ?");
		if (@stmt == null) return false;
		stmt.bind_text(1, username, false);

		bool valid = false;
		if (stmt.step() == SQLITE_ROW) {
			string stored_hash = stmt.column_text(0);
			string salt = stmt.column_text(1);
			valid = stored_hash == hash_password(password, salt);
		}
		return valid;
	}

	int get_user_id(const string&in username) {
		sqlite3statement@ stmt = db.prepare("SELECT id FROM users WHERE username = ?");
		if (@stmt == null) return -1;
		stmt.bind_text(1, username, false);
		int user_id = -1;
		if (stmt.step() == SQLITE_ROW) user_id = stmt.column_int(0);
		return user_id;
	}

	private bool create_stats_row(int user_id) {
		sqlite3statement@ stmt = db.prepare("INSERT INTO user_stats (user_id) VALUES (?)");
		if (@stmt == null) return false;
		stmt.bind_int(1, user_id);
		bool ok = stmt.step() == SQLITE_DONE;
		return ok;
	}

	user_stats@ get_stats(const string&in username) {
		user_stats@ result = user_stats();
		int user_id = get_user_id(username);
		if (user_id < 0) return result;

		sqlite3statement@ stmt = db.prepare(
			"SELECT games_played, games_won, crewmate_wins, impostor_wins, tasks_completed, kills " +
			"FROM user_stats WHERE user_id = ?"
		);
		if (@stmt == null) return result;
		stmt.bind_int(1, user_id);
		if (stmt.step() == SQLITE_ROW) {
			result.games_played = stmt.column_int(0);
			result.games_won = stmt.column_int(1);
			result.crewmate_wins = stmt.column_int(2);
			result.impostor_wins = stmt.column_int(3);
			result.tasks_completed = stmt.column_int(4);
			result.kills = stmt.column_int(5);
		}
		return result;
	}

	// stat_column precisa estar em allowed_stat_columns() - nunca aceitar esse nome vindo direto
	// da rede sem validar contra essa lista, para evitar injeção via nome de coluna.
	bool increment_stat(const string&in username, const string&in stat_column, int amount = 1) {
		array<string>@ allowed = allowed_stat_columns();
		bool is_allowed = false;
		for (uint i = 0; i < allowed.length(); i++) {
			if (allowed[i] == stat_column) { is_allowed = true; break; }
		}
		if (!is_allowed) return false;

		int user_id = get_user_id(username);
		if (user_id < 0) return false;

		sqlite3statement@ stmt = db.prepare("UPDATE user_stats SET " + stat_column + " = " + stat_column + " + ? WHERE user_id = ?");
		if (@stmt == null) return false;
		stmt.bind_int(1, amount);
		stmt.bind_int(2, user_id);
		bool ok = stmt.step() == SQLITE_DONE;
		return ok;
	}

	void close() {
		if (@db != null) db.close();
	}

	// Salt (base64) + SHA-256 iterado (stretch manual, mitiga ataques de força bruta/rainbow table
	// já que o NVGT não tem bcrypt/argon2/PBKDF2 nativos).
	private string hash_password(const string&in password, const string&in salt) {
		string material = salt + password;
		for (uint i = 0; i < PASSWORD_HASH_ITERATIONS; i++) {
			material = string_hash_sha256(material);
		}
		return material;
	}
}

user_database@ g_user_db = null;
