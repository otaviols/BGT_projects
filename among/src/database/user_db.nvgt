// user_db.nvgt
// Persistência de usuários (login/senha) e estatísticas via SQLite3.
// Senhas nunca são armazenadas em texto puro: salt aleatório (random_bytes) + SHA-256 com
// múltiplas iterações (stretch manual, já que o NVGT não expõe bcrypt/argon2/PBKDF2 nativamente).

#pragma plugin nvgt_sqlite
#include "sqlite3constants.nvgt"
#include "models.nvgt"

const uint PASSWORD_HASH_ITERATIONS = 20000;
const uint MIN_USERNAME_LENGTH = 3;
const uint MAX_USERNAME_LENGTH = 20;
const uint MIN_PASSWORD_LENGTH = 6;

// Nomes de coluna permitidos para update_stat(); nunca interpolar stat_name livre na query.
array<string>@ allowed_stat_columns() {
	array<string> cols = {"games_played", "games_won", "crewmate_wins", "impostor_wins", "tasks_completed", "kills"};
	return cols;
}

class user_database {
	private sqlite3@ db;

	bool open(const string&in path = "among_users.db") {
		@db = sqlite3();
		if (db.open(path) != SQLITE_OK) return false;
		return create_tables();
	}

	private bool create_tables() {
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS users (" +
			"id INTEGER PRIMARY KEY AUTOINCREMENT, " +
			"username TEXT UNIQUE NOT NULL, " +
			"password_hash TEXT NOT NULL, " +
			"salt TEXT NOT NULL, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP)"
		) != SQLITE_OK) return false;

		if (db.execute(
			"CREATE TABLE IF NOT EXISTS user_stats (" +
			"user_id INTEGER PRIMARY KEY, " +
			"games_played INTEGER DEFAULT 0, " +
			"games_won INTEGER DEFAULT 0, " +
			"crewmate_wins INTEGER DEFAULT 0, " +
			"impostor_wins INTEGER DEFAULT 0, " +
			"tasks_completed INTEGER DEFAULT 0, " +
			"kills INTEGER DEFAULT 0, " +
			"FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE)"
		) != SQLITE_OK) return false;

		// Recados dos jogadores. Fica no MESMO banco das contas de propósito: ele já mora no volume
		// persistente, então o feedback sobrevive a deploy pelo mesmo motivo que as contas sobrevivem,
		// sem nenhuma peça de infraestrutura nova para manter.
		//
		// O usuário fica como TEXTO, e não como chave estrangeira para users(id): se um dia a conta
		// for apagada, o recado continua legível em vez de virar um número órfão - e um recado sobre
		// um bug vale independentemente de quem ainda joga.
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS feedback (" +
			"id INTEGER PRIMARY KEY AUTOINCREMENT, " +
			"username TEXT, " +
			"text TEXT NOT NULL, " +
			"version TEXT, " +
			"language TEXT, " +
			"in_match INTEGER DEFAULT 0, " +
			"role TEXT, " +
			"room TEXT, " +
			"crash_log TEXT, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP)"
		) != SQLITE_OK) return false;

		// `resolved_at` marca o recado já tratado (implementado, respondido, ou os dois). Ele some da
		// leitura padrão e continua no banco - arquivar, não apagar: o contexto de um recado (versão,
		// papel, sala, crash.log) vale justamente quando o problema volta meses depois.
		//
		// ADD COLUMN separado do CREATE TABLE porque o banco em produção já existe: o CREATE só roda
		// na primeira vez, e quem já tem a tabela nunca veria a coluna nova. O erro é ignorado de
		// propósito - rodar de novo num banco que já tem a coluna devolve erro, e isso é o esperado.
		db.execute("ALTER TABLE feedback ADD COLUMN resolved_at DATETIME");

		// Respostas de quem faz o jogo aos recados. Fecham o ciclo com quem está testando: sem isto o
		// jogador manda um recado e nunca fica sabendo se alguém leu, e quem oferece ajuda (uma
		// tradução, por exemplo) não tem como ser respondido sem sair do jogo.
		//
		// read_at marca quando o jogador OUVIU a resposta; enquanto for nulo, ela é anunciada de
		// novo a cada entrada. É por resposta, e não por recado, porque um recado pode receber mais
		// de uma.
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS feedback_replies (" +
			"id INTEGER PRIMARY KEY AUTOINCREMENT, " +
			"feedback_id INTEGER NOT NULL, " +
			"text TEXT NOT NULL, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP, " +
			"read_at DATETIME)"
		) != SQLITE_OK) return false;

		// Traduções enviadas pelo jogo. Chave (username, code): cada pessoa tem no máximo UMA versão
		// de cada idioma guardada aqui - reenviar substitui. É o que impede a tabela de crescer com
		// dez versões do mesmo arquivo, e a ferramenta que recolhe (tools/read_translations) apaga o
		// que já trouxe. O banco é caixa de entrada, não arquivo.
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS translations (" +
			"username TEXT NOT NULL, " +
			"code TEXT NOT NULL, " +
			"content TEXT NOT NULL, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP, " +
			"PRIMARY KEY (username, code))"
		) != SQLITE_OK) return false;

		// "Lembrar de mim": o cliente guarda um TOKEN de sessão, nunca a senha. Aqui fica só o hash
		// do token - quem ler o banco não consegue entrar com ele - e a data de uso, para o token
		// morrer sozinho depois de SESSION_TOKEN_DAYS sem abrir o jogo.
		if (db.execute(
			"CREATE TABLE IF NOT EXISTS sessions (" +
			"token_hash TEXT PRIMARY KEY, " +
			"username TEXT NOT NULL, " +
			"created_at DATETIME DEFAULT CURRENT_TIMESTAMP, " +
			"last_used DATETIME DEFAULT CURRENT_TIMESTAMP)"
		) != SQLITE_OK) return false;

		db.execute("CREATE INDEX IF NOT EXISTS idx_username ON users(username)");
		return true;
	}

	// Hash do token SEMPRE como hexadecimal ASCII. Duas armadilhas da build Linux do NVGT, as duas
	// invisíveis no teste local (que roda no Windows): string_hash_sha256 devolve BINÁRIO no Linux
	// mesmo pedindo texto, e string_to_hex também não produz hex ali - então o hash ia binário para
	// a coluna TEXT e o bind_text o cortava no primeiro byte nulo (os token_hash saíam com 6 bytes),
	// e o login por token nunca casava. Hexar os 32 bytes à mão não depende de nenhum dos dois.
	private string token_hash(const string&in token) {
		string raw = string_hash_sha256(token, true);
		const string DIGITS = "0123456789abcdef";
		string hex;
		for (uint i = 0; i < raw.length(); i++) {
			uint b = character_to_ascii(raw.substr(i, 1)) & 0xFF;
			hex += DIGITS.substr(b >> 4, 1) + DIGITS.substr(b & 0x0F, 1);
		}
		return hex;
	}

	// Cria um token de sessão para o usuário e devolve o token (só esta vez: guardado só o hash).
	string create_session(const string&in username) {
		if (@db == null) return "";
		string token = string_base64_encode(random_bytes(32));
		sqlite3statement@ st = db.prepare("INSERT INTO sessions (token_hash, username) VALUES (?, ?)");
		if (@st == null) return "";
		// hash em variável NOMEADA, não inline: bind_text(..., false) não copia (SQLITE_STATIC), então
		// guarda um ponteiro para a string. Um temporário `token_hash(token)` morre antes do step() e
		// o SQLite grava memória liberada - no Windows sobrevivia por acaso, no Linux virava lixo, e o
		// login por token nunca casava na produção. O resto do arquivo passa &in nomeado, que sobrevive.
		string hash = token_hash(token);
		st.bind_text(1, hash, false);
		st.bind_text(2, username, false);
		return st.step() == SQLITE_DONE ? token : "";
	}

	// Usuário dono do token, ou "" se ele não existe ou venceu. Renova a data de uso.
	string session_user(const string&in token) {
		if (@db == null || token == "") return "";
		db.execute("DELETE FROM sessions WHERE last_used < datetime('now', '-" + SESSION_TOKEN_DAYS + " days')");
		string hash = token_hash(token);
		sqlite3statement@ st = db.prepare("SELECT username FROM sessions WHERE token_hash = ?");
		if (@st == null) return "";
		st.bind_text(1, hash, false);
		if (st.step() != SQLITE_ROW) return "";
		string username = st.column_text(0);
		sqlite3statement@ touch = db.prepare("UPDATE sessions SET last_used = CURRENT_TIMESTAMP WHERE token_hash = ?");
		if (@touch != null) { touch.bind_text(1, hash, false); touch.step(); }
		return username;
	}

	void delete_session(const string&in token) {
		if (@db == null || token == "") return;
		sqlite3statement@ st = db.prepare("DELETE FROM sessions WHERE token_hash = ?");
		if (@st == null) return;
		string hash = token_hash(token); // nomeado, não temporário - ver create_session
		st.bind_text(1, hash, false);
		st.step();
	}

	bool save_translation(const string&in username, const string&in code, const string&in content) {
		if (@db == null) return false;
		sqlite3statement@ st = db.prepare(
			"INSERT OR REPLACE INTO translations (username, code, content, created_at) VALUES (?, ?, ?, CURRENT_TIMESTAMP)");
		if (@st == null) return false;
		st.bind_text(1, username, false);
		st.bind_text(2, code, false);
		st.bind_text(3, content, false);
		return st.step() == SQLITE_DONE;
	}

	json_array@ list_translations() {
		json_array@ list = json_array();
		if (@db == null) return list;
		sqlite3statement@ st = db.prepare("SELECT username, code, content, created_at FROM translations ORDER BY created_at");
		if (@st == null) return list;
		while (st.step() == SQLITE_ROW) {
			json_object@ o = json_object();
			o.set("username", st.column_text(0));
			o.set("code", st.column_text(1));
			o.set("content", st.column_text(2));
			o.set("created_at", st.column_text(3));
			list.add(o);
		}
		return list;
	}

	bool delete_translation(const string&in username, const string&in code) {
		if (@db == null) return false;
		sqlite3statement@ st = db.prepare("DELETE FROM translations WHERE username = ? AND code = ?");
		if (@st == null) return false;
		st.bind_text(1, username, false);
		st.bind_text(2, code, false);
		return st.step() == SQLITE_DONE;
	}

	// Grava uma resposta a um recado. Devolve o usuário dono do recado (para avisá-lo na hora se
	// estiver conectado), ou "" se o recado não existe - responder a um id inventado não pode gravar
	// uma resposta órfã que ninguém nunca vai ouvir.
	// Marca recados como tratados (implementados, respondidos, ou os dois). Com `until_id`, marca
	// TODOS até aquele id - é como se limpa uma caixa que acumulou meses de recados sem clicar um
	// por um. Devolve quantos foram marcados.
	//
	// Arquiva, não apaga: o contexto de um recado (versão, papel, sala, crash.log) é justamente o
	// que falta quando o mesmo problema volta meses depois.
	int resolve_feedback(int id, bool until = false) {
		if (@db == null) return 0;
		// Conta ANTES de mexer: o plugin de SQLite do NVGT não expõe o total de linhas alteradas, e
		// devolver um número é o que deixa a ferramenta dizer "3 recados arquivados" em vez de um
		// "pronto" que não prova nada.
		string onde = (until ? "id <= ?" : "id = ?") + " AND resolved_at IS NULL";
		int quantos = count_feedback(onde, id);
		if (quantos == 0) return 0;
		sqlite3statement@ st = db.prepare("UPDATE feedback SET resolved_at = CURRENT_TIMESTAMP WHERE " + onde);
		if (@st == null) return 0;
		st.bind_int(1, id);
		st.step();
		return quantos;
	}

	// Quantos recados casam com a condição. `onde` NUNCA vem de fora: são as duas formas fixas acima.
	private int count_feedback(const string&in onde, int id) {
		sqlite3statement@ st = db.prepare("SELECT COUNT(*) FROM feedback WHERE " + onde);
		if (@st == null) return 0;
		st.bind_int(1, id);
		return st.step() == SQLITE_ROW ? st.column_int(0) : 0;
	}

	// Desmarca, para quando um recado voltar a ser assunto.
	int unresolve_feedback(int id) {
		if (@db == null) return 0;
		int quantos = count_feedback("id = ? AND resolved_at IS NOT NULL", id);
		if (quantos == 0) return 0;
		sqlite3statement@ st = db.prepare("UPDATE feedback SET resolved_at = NULL WHERE id = ?");
		if (@st == null) return 0;
		st.bind_int(1, id);
		st.step();
		return quantos;
	}
	string save_feedback_reply(int feedback_id, const string&in text) {
		if (@db == null) return "";
		sqlite3statement@ dono = db.prepare("SELECT username FROM feedback WHERE id = ?");
		if (@dono == null) return "";
		dono.bind_int(1, feedback_id);
		if (dono.step() != SQLITE_ROW) return "";
		string username = dono.column_text(0);
		if (username == "") return "";

		sqlite3statement@ st = db.prepare("INSERT INTO feedback_replies (feedback_id, text) VALUES (?, ?)");
		if (@st == null) return "";
		st.bind_int(1, feedback_id);
		st.bind_text(2, text, false);
		if (st.step() != SQLITE_DONE) return "";
		return username;
	}

	// Respostas que este usuário ainda não ouviu, com o recado original ao lado: "responderam ao
	// seu recado" só faz sentido se ele lembrar qual recado era.
	json_array@ unread_feedback_replies(const string&in username) {
		json_array@ list = json_array();
		if (@db == null) return list;
		sqlite3statement@ st = db.prepare(
			"SELECT r.id, r.feedback_id, f.text, r.text, r.created_at " +
			"FROM feedback_replies r JOIN feedback f ON f.id = r.feedback_id " +
			"WHERE f.username = ? AND r.read_at IS NULL ORDER BY r.id");
		if (@st == null) return list;
		st.bind_text(1, username, false);
		while (st.step() == SQLITE_ROW) {
			json_object@ o = json_object();
			o.set("reply_id", st.column_int(0));
			o.set("feedback_id", st.column_int(1));
			o.set("feedback_text", st.column_text(2));
			o.set("reply_text", st.column_text(3));
			o.set("created_at", st.column_text(4));
			list.add(o);
		}
		return list;
	}

	// Marca como ouvida - só se a resposta for a um recado DESTE usuário. O id vem do cliente, e um
	// cliente que marcasse as respostas dos outros como lidas faria o outro nunca ouvi-las.
	bool mark_feedback_reply_read(int reply_id, const string&in username) {
		if (@db == null) return false;
		sqlite3statement@ st = db.prepare(
			"UPDATE feedback_replies SET read_at = CURRENT_TIMESTAMP WHERE id = ? AND read_at IS NULL " +
			"AND feedback_id IN (SELECT id FROM feedback WHERE username = ?)");
		if (@st == null) return false;
		st.bind_int(1, reply_id);
		st.bind_text(2, username, false);
		return st.step() == SQLITE_DONE;
	}

	// Guarda um recado de jogador. Nada aqui é validado além do tamanho (quem chama já cortou): um
	// recado meio estranho gravado é melhor do que um recado recusado, porque o recusado some para
	// sempre e ninguém fica sabendo que existiu.
	bool save_feedback(const string&in username, const string&in text, const string&in version,
		const string&in language, bool in_match, const string&in role, const string&in room,
		const string&in crash_log) {
		if (@db == null) return false;
		sqlite3statement@ st = db.prepare(
			"INSERT INTO feedback (username, text, version, language, in_match, role, room, crash_log) " +
			"VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
		if (@st == null) return false;
		st.bind_text(1, username, false);
		st.bind_text(2, text, false);
		st.bind_text(3, version, false);
		st.bind_text(4, language, false);
		st.bind_int(5, in_match ? 1 : 0);
		st.bind_text(6, role, false);
		st.bind_text(7, room, false);
		st.bind_text(8, crash_log, false);
		return st.step() == SQLITE_DONE;
	}

	// Cria um novo usuário. Retorna mensagem de erro vazia em caso de sucesso.
	bool create_user(const string&in username, const string&in password, string&out error_message) {
		error_message = "";
		if (username.length() < MIN_USERNAME_LENGTH || username.length() > MAX_USERNAME_LENGTH) {
			error_message = "invalid_username_length";
			return false;
		}
		if (password.length() < MIN_PASSWORD_LENGTH) {
			error_message = "invalid_password_length";
			return false;
		}
		if (user_exists(username)) {
			error_message = "username_taken";
			return false;
		}

		string salt = string_base64_encode(random_bytes(16));
		string hash = hash_password(password, salt);

		sqlite3statement@ stmt = db.prepare("INSERT INTO users (username, password_hash, salt) VALUES (?, ?, ?)");
		if (@stmt == null) {
			error_message = "db_error";
			return false;
		}
		stmt.bind_text(1, username, false);
		stmt.bind_text(2, hash, false);
		stmt.bind_text(3, salt, false);
		bool ok = stmt.step() == SQLITE_DONE;

		if (!ok) {
			error_message = "db_error";
			return false;
		}

		int user_id = get_user_id(username);
		if (user_id > 0) create_stats_row(user_id);
		return true;
	}

	bool user_exists(const string&in username) {
		sqlite3statement@ stmt = db.prepare("SELECT COUNT(*) FROM users WHERE username = ?");
		if (@stmt == null) return false;
		stmt.bind_text(1, username, false);
		bool exists = false;
		if (stmt.step() == SQLITE_ROW) exists = stmt.column_int(0) > 0;
		return exists;
	}

	bool verify_login(const string&in username, const string&in password) {
		sqlite3statement@ stmt = db.prepare("SELECT password_hash, salt FROM users WHERE username = ?");
		if (@stmt == null) return false;
		stmt.bind_text(1, username, false);

		bool valid = false;
		if (stmt.step() == SQLITE_ROW) {
			string stored_hash = stmt.column_text(0);
			string salt = stmt.column_text(1);
			valid = stored_hash == hash_password(password, salt);
		}
		return valid;
	}

	int get_user_id(const string&in username) {
		sqlite3statement@ stmt = db.prepare("SELECT id FROM users WHERE username = ?");
		if (@stmt == null) return -1;
		stmt.bind_text(1, username, false);
		int user_id = -1;
		if (stmt.step() == SQLITE_ROW) user_id = stmt.column_int(0);
		return user_id;
	}

	private bool create_stats_row(int user_id) {
		sqlite3statement@ stmt = db.prepare("INSERT INTO user_stats (user_id) VALUES (?)");
		if (@stmt == null) return false;
		stmt.bind_int(1, user_id);
		bool ok = stmt.step() == SQLITE_DONE;
		return ok;
	}

	user_stats@ get_stats(const string&in username) {
		user_stats@ result = user_stats();
		int user_id = get_user_id(username);
		if (user_id < 0) return result;

		sqlite3statement@ stmt = db.prepare(
			"SELECT games_played, games_won, crewmate_wins, impostor_wins, tasks_completed, kills " +
			"FROM user_stats WHERE user_id = ?"
		);
		if (@stmt == null) return result;
		stmt.bind_int(1, user_id);
		if (stmt.step() == SQLITE_ROW) {
			result.games_played = stmt.column_int(0);
			result.games_won = stmt.column_int(1);
			result.crewmate_wins = stmt.column_int(2);
			result.impostor_wins = stmt.column_int(3);
			result.tasks_completed = stmt.column_int(4);
			result.kills = stmt.column_int(5);
		}
		return result;
	}

	// stat_column precisa estar em allowed_stat_columns() - nunca aceitar esse nome vindo direto
	// da rede sem validar contra essa lista, para evitar injeção via nome de coluna.
	bool increment_stat(const string&in username, const string&in stat_column, int amount = 1) {
		array<string>@ allowed = allowed_stat_columns();
		bool is_allowed = false;
		for (uint i = 0; i < allowed.length(); i++) {
			if (allowed[i] == stat_column) { is_allowed = true; break; }
		}
		if (!is_allowed) return false;

		int user_id = get_user_id(username);
		if (user_id < 0) return false;

		sqlite3statement@ stmt = db.prepare("UPDATE user_stats SET " + stat_column + " = " + stat_column + " + ? WHERE user_id = ?");
		if (@stmt == null) return false;
		stmt.bind_int(1, amount);
		stmt.bind_int(2, user_id);
		bool ok = stmt.step() == SQLITE_DONE;
		return ok;
	}

	void close() {
		if (@db != null) db.close();
	}

	// Salt (base64) + SHA-256 iterado (stretch manual, mitiga ataques de força bruta/rainbow table
	// já que o NVGT não tem bcrypt/argon2/PBKDF2 nativos).
	private string hash_password(const string&in password, const string&in salt) {
		string material = salt + password;
		for (uint i = 0; i < PASSWORD_HASH_ITERATIONS; i++) {
			material = string_hash_sha256(material);
		}
		return material;
	}
}

user_database@ g_user_db = null;
