// models.nvgt
// Estruturas de dados simples de persistência (não confundir com core/player.nvgt, que é o
// estado de jogo em tempo real).

class user_stats {
	int games_played = 0;
	int games_won = 0;
	int crewmate_wins = 0;
	int impostor_wins = 0;
	int tasks_completed = 0;
	int kills = 0;
}

class login_result {
	bool ok = false;
	string message = "";
	string username = "";
}
