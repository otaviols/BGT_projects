#pragma console
#include "core/game_state.nvgt"
#include "config/presets.nvgt"

// Distância a pé aproximada entre duas salas, andando pelo grafo de zonas (centro a centro).
float walking_distance(game_map@ m, const string&in from_room, const string&in to_room) {
	array<string>@ path = m.zone_path(from_room, to_room);
	map_zone@ current = m.find_zone(from_room);
	float total = 0.0;
	for (uint i = 0; i < path.length(); i++) {
		map_zone@ next = m.find_zone(path[i]);
		if (@current == null || @next == null) continue;
		total += distance_2d(current.center_x, current.center_y, next.center_x, next.center_y);
		@current = next;
	}
	return total;
}

void main() {
	game_map@ m = build_the_hub_map();

	println("=== VENTS: a rede liga salas que nao tem corredor direto? ===");
	array<map_object@>@ vents = m.objects_by_type(OBJ_VENT);
	for (uint i = 0; i < vents.length(); i++) {
		map_object@ v = vents[i];
		array<string>@ links = m.vent_connections(v);
		string line = v.id + " (" + v.room_id + ") liga com: ";
		for (uint j = 0; j < links.length(); j++) {
			map_object@ other = m.find_object(links[j]);
			if (@other == null) { line += "?? " + links[j] + " "; continue; }
			array<string>@ neighbors = m.zone_neighbors(v.room_id);
			bool adjacent = false;
			for (uint k = 0; k < neighbors.length(); k++) {
				array<string>@ ends = neighbors[k].split("_");
				if (ends.length() == 3 && (ends[1] == other.room_id || ends[2] == other.room_id)) adjacent = true;
			}
			float on_foot = walking_distance(m, v.room_id, other.room_id);
			line += other.room_id + " (" + int(on_foot) + " a pe" + (adjacent ? ", VIZINHA!" : "") + ") ";
		}
		println("  " + line);
	}

	println("");
	println("=== O vent esbarra em algum objeto da sala? (precisa > 1.4) ===");
	for (uint i = 0; i < vents.length(); i++) {
		map_object@ v = vents[i];
		float closest = 999.0;
		string closest_id = "";
		for (uint j = 0; j < m.objects.length(); j++) {
			map_object@ o = m.objects[j];
			if (o.id == v.id || o.obj_type == OBJ_DECORATION || o.room_id != v.room_id) continue;
			float d = distance_2d(v.x, v.y, o.x, o.y);
			if (d < closest) { closest = d; closest_id = o.id; }
		}
		println("  " + v.id + ": objeto mais proximo a " + closest + " (" + closest_id + ")");
	}

	println("");
	println("=== As bocas estao dentro da sala delas? ===");
	for (uint i = 0; i < vents.length(); i++) {
		map_object@ v = vents[i];
		println("  " + v.id + " esta em " + m.room_id_at(v.x, v.y) + " (esperado " + v.room_id + ")");
	}
}
