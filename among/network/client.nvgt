// client.nvgt
// Conexão do lado do jogador: liga ao servidor, envia comandos (C_*) e entrega os pacotes
// recebidos (S_*) em uma fila para a camada de UI/áudio processar no loop principal do jogo.
// Não interpreta o conteúdo dos pacotes - só transporta net_packet@.

#include "protocol.nvgt"
#include "packet.nvgt"
#include "../config/game_constants.nvgt"

class game_client {
	network@ net;
	uint64 my_peer_id = 0;
	bool connected = false;
	array<net_packet@> incoming;

	bool connect_to(const string&in host, uint16 port) {
		@net = network();
		if (!net.setup_client(MAX_PACKET_CHANNELS, 1)) return false;
		my_peer_id = net.connect(host, port);
		return my_peer_id != 0;
	}

	// Deve ser chamado a cada quadro/loop do jogo. Processa eventos de rede pendentes e enfileira
	// os pacotes recebidos para poll_message() consumir.
	void update() {
		while (true) {
			const network_event@ ev = net.request(0);
			// net.request() nunca retorna null - quando não há nada pendente ele retorna um
			// evento de tipo event_none. É isso (não @ev == null) que sinaliza "acabaram os
			// eventos deste quadro" e permite sair do laço.
			if (@ev == null || ev.type == event_none) break;

			if (ev.type == event_connect) {
				connected = true;
			} else if (ev.type == event_disconnect || ev.type == event_disconnect_timeout) {
				connected = false;
			} else if (ev.type == event_receive) {
				net_packet@ pkt = packet_from_wire(ev.message);
				if (@pkt != null) incoming.insert_last(pkt);
			}
		}
	}

	// Retira a próxima mensagem recebida da fila, ou null se não houver nenhuma.
	net_packet@ poll_message() {
		if (incoming.length() == 0) return null;
		net_packet@ pkt = incoming[0];
		incoming.remove_at(0);
		return pkt;
	}

	void disconnect() {
		if (@net != null) net.disconnect_peer(my_peer_id);
		connected = false;
	}

	// --- Envio de comandos (Cliente -> Servidor) ---

	void send_login(const string&in username, const string&in password) {
		net_packet@ p = net_packet(C_LOGIN);
		p.set_string("username", username);
		p.set_string("password", password);
		send(p);
	}

	void send_register(const string&in username, const string&in password) {
		net_packet@ p = net_packet(C_REGISTER);
		p.set_string("username", username);
		p.set_string("password", password);
		send(p);
	}

	void send_list_lobbies() {
		send(net_packet(C_LIST_LOBBIES));
	}

	void send_create_lobby(const string&in lobby_name, const string&in preset) {
		net_packet@ p = net_packet(C_CREATE_LOBBY);
		p.set_string("lobby_name", lobby_name);
		p.set_string("preset", preset);
		send(p);
	}

	void send_join_lobby(const string&in lobby_id) {
		net_packet@ p = net_packet(C_JOIN_LOBBY);
		p.set_string("lobby_id", lobby_id);
		send(p);
	}

	void send_leave_lobby() {
		send(net_packet(C_LEAVE_LOBBY));
	}

	void send_set_ready(bool ready) {
		net_packet@ p = net_packet(C_SET_READY);
		p.set_bool("ready", ready);
		send(p);
	}

	void send_start_game() {
		send(net_packet(C_START_GAME));
	}

	void send_move(float x, float y) {
		net_packet@ p = net_packet(C_MOVE);
		p.set_float("x", x);
		p.set_float("y", y);
		send(p, false); // canal não confiável: posição é enviada com frequência, perda ocasional é aceitável
	}

	void send_interact(const string&in object_id) {
		net_packet@ p = net_packet(C_INTERACT);
		p.set_string("object_id", object_id);
		send(p);
	}

	void send_start_task(const string&in task_id) {
		net_packet@ p = net_packet(C_START_TASK);
		p.set_string("task_id", task_id);
		send(p);
	}

	void send_task_input(const string&in task_id, bool success) {
		net_packet@ p = net_packet(C_TASK_INPUT);
		p.set_string("task_id", task_id);
		p.set_bool("success", success);
		send(p);
	}

	void send_kill(uint64 target_peer) {
		net_packet@ p = net_packet(C_KILL);
		p.set_uint64("target_peer", target_peer);
		send(p);
	}

	void send_report_body(const string&in body_id) {
		net_packet@ p = net_packet(C_REPORT_BODY);
		p.set_string("body_id", body_id);
		send(p);
	}

	void send_call_meeting() {
		send(net_packet(C_CALL_MEETING));
	}

	void send_cast_vote(int64 target_peer) {
		net_packet@ p = net_packet(C_CAST_VOTE);
		p.set_int64("target_peer", target_peer);
		send(p);
	}

	void send_use_vent(const string&in vent_id) {
		net_packet@ p = net_packet(C_USE_VENT);
		p.set_string("vent_id", vent_id);
		send(p);
	}

	void send_radar_scan(int direction) {
		net_packet@ p = net_packet(C_RADAR_SCAN);
		p.set_int("direction", direction);
		send(p, false);
	}

	void send_trigger_sabotage(const string&in sabotage_id) {
		net_packet@ p = net_packet(C_TRIGGER_SABOTAGE);
		p.set_string("sabotage_id", sabotage_id);
		send(p);
	}

	private void send(net_packet@ pkt, bool reliable = true) {
		if (@net == null) return;
		if (reliable) net.send_reliable(my_peer_id, pkt.to_wire(), CHANNEL_RELIABLE);
		else net.send_unreliable(my_peer_id, pkt.to_wire(), CHANNEL_UNRELIABLE);
	}
}
