// net_packet.nvgt
// Envelope de mensagem trocada pela rede. Encapsula um json_object com um campo "type"
// obrigatório e demais campos livres. Serializa para string (formato usado por network.send).

class net_packet {
	json_object@ obj;

	net_packet(const string&in msg_type) {
		@obj = json_object();
		obj.set("type", msg_type);
	}

	// Construtor interno vazio, usado por packet_from_wire() para popular obj a partir do parser.
	net_packet() {
		@obj = json_object();
	}

	string get_type() const property {
		if (!obj.exists("type")) return "";
		return string(obj["type"]);
	}

	void set_string(const string&in key, const string&in value) { obj.set(key, value); }
	void set_int(const string&in key, int value) { obj.set(key, value); }
	void set_int64(const string&in key, int64 value) { obj.set(key, value); }
	void set_uint64(const string&in key, uint64 value) { obj.set(key, value); }
	void set_float(const string&in key, float value) { obj.set(key, value); }
	void set_bool(const string&in key, bool value) { obj.set(key, value); }
	void set_array(const string&in key, json_array@ value) { obj.set(key, value); }
	void set_object(const string&in key, json_object@ value) { obj.set(key, value); }

	string get_string(const string&in key, const string&in default_value = "") const {
		if (!obj.exists(key)) return default_value;
		return string(obj[key]);
	}

	int get_int(const string&in key, int default_value = 0) const {
		if (!obj.exists(key)) return default_value;
		return int(obj[key]);
	}

	uint64 get_uint64(const string&in key, uint64 default_value = 0) const {
		if (!obj.exists(key)) return default_value;
		return uint64(obj[key]);
	}

	int64 get_int64(const string&in key, int64 default_value = 0) const {
		if (!obj.exists(key)) return default_value;
		return int64(obj[key]);
	}

	float get_float(const string&in key, float default_value = 0.0) const {
		if (!obj.exists(key)) return default_value;
		return float(obj[key]);
	}

	bool get_bool(const string&in key, bool default_value = false) const {
		if (!obj.exists(key)) return default_value;
		return bool(obj[key]);
	}

	json_array@ get_array(const string&in key) const {
		if (!obj.exists(key)) return null;
		return obj.get_array(key);
	}

	json_object@ get_object(const string&in key) const {
		if (!obj.exists(key)) return null;
		return obj.get_object(key);
	}

	string to_wire() const {
		return obj.stringify();
	}
}

// Constrói um net_packet a partir dos bytes recebidos pela rede (network_event.message).
// Retorna null se a mensagem não for um JSON válido com campo "type".
net_packet@ packet_from_wire(const string&in wire) {
	var@ parsed = parse_json(wire);
	if (@parsed == null) return null;

	json_object@ o = cast<json_object@>(parsed);
	if (@o == null) return null;
	if (!o.exists("type")) return null;

	net_packet@ p = net_packet();
	@p.obj = o;
	return p;
}
