// Network Protocol
// Definição do protocolo de comunicação cliente-servidor

// Tipos de mensagens
enum MessageType {
	// Autenticação
	MSG_LOGIN_REQUEST = 1,
	MSG_LOGIN_RESPONSE = 2,
	MSG_SESSION_VALIDATE = 3,
	MSG_REGISTER_REQUEST = 4,
	MSG_REGISTER_RESPONSE = 5,
	
	// Lobby
	MSG_LOBBY_LIST_REQUEST = 10,
	MSG_LOBBY_LIST_RESPONSE = 11,
	MSG_LOBBY_CREATE = 12,
	MSG_LOBBY_JOIN = 13,
	MSG_LOBBY_LEAVE = 14,
	MSG_LOBBY_UPDATE = 15,
	MSG_LOBBY_CONFIG_UPDATE = 16,
	MSG_GAME_START = 17,
	
	// Gameplay
	MSG_PLAYER_MOVE = 30,
	MSG_PLAYER_POSITION_UPDATE = 31,
	MSG_PLAYER_ACTION = 32,
	MSG_PLAYER_STATE_UPDATE = 33,
	
	// Tasks
	MSG_TASK_START = 40,
	MSG_TASK_PROGRESS = 41,
	MSG_TASK_COMPLETE = 42,
	MSG_TASK_LIST_UPDATE = 43,
	
	// Impostor
	MSG_KILL = 50,
	MSG_KILL_COOLDOWN_UPDATE = 51,
	MSG_VENT_ENTER = 52,
	MSG_VENT_EXIT = 53,
	MSG_SABOTAGE = 54,
	
	// Reuniões
	MSG_EMERGENCY_MEETING = 60,
	MSG_BODY_REPORT = 61,
	MSG_MEETING_START = 62,
	MSG_VOTE = 63,
	MSG_VOTE_RESULTS = 64,
	MSG_MEETING_END = 65,
	
	// Estado do jogo
	MSG_GAME_STATE_UPDATE = 70,
	MSG_GAME_END = 71,
	MSG_ROLE_ASSIGNMENT = 72,
	
	// Chat/Comunicação
	MSG_CHAT = 80,
	MSG_PROXIMITY_CHECK = 81,
	MSG_PROXIMITY_RESPONSE = 82,
	
	// Sistema
	MSG_HEARTBEAT = 90,
	MSG_DISCONNECT = 91,
	MSG_ERROR = 99
}

// Códigos de erro
enum ErrorCode {
	ERROR_NONE = 0,
	ERROR_AUTHENTICATION_FAILED = 1,
	ERROR_INVALID_SESSION = 2,
	ERROR_LOBBY_FULL = 3,
	ERROR_LOBBY_NOT_FOUND = 4,
	ERROR_GAME_IN_PROGRESS = 5,
	ERROR_INVALID_ACTION = 6,
	ERROR_PERMISSION_DENIED = 7,
	ERROR_PLAYER_NOT_FOUND = 8,
	ERROR_INVALID_DATA = 9
}
