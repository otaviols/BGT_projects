// Game Constants
// Constantes globais do jogo Among Us Audiogame

// Network
const string SERVER_VERSION = "1.0.0";
const int DEFAULT_PORT = 25565;
const int MAX_PLAYERS_PER_LOBBY = 10;
const int MIN_PLAYERS_TO_START = 4;
const int MAX_LOBBIES = 50;

// Game States
enum GameState {
	STATE_LOBBY,
	STATE_STARTING,
	STATE_PLAYING,
	STATE_DISCUSSION,
	STATE_VOTING,
	STATE_GAME_OVER
}

// Player States
enum PlayerState {
	PLAYER_ALIVE,
	PLAYER_DEAD,
	PLAYER_DISCONNECTED
}

// Roles
enum Role {
	ROLE_NONE,
	ROLE_CREWMATE,
	ROLE_IMPOSTOR
}

// Task Types
enum TaskType {
	TASK_SHORT,
	TASK_COMMON,
	TASK_LONG
}

// Task States
enum TaskState {
	TASK_ASSIGNED,
	TASK_IN_PROGRESS,
	TASK_COMPLETED
}

// Meeting Types
enum MeetingType {
	MEETING_EMERGENCY,
	MEETING_BODY_REPORT
}

// Map Constants
const int ROOM_COUNT = 8;
const float MAX_INTERACTION_DISTANCE = 2.0;
const float PROXIMITY_VOICE_DISTANCE = 10.0;
const float KILL_CHECK_DISTANCE = 2.5;

// Audio Constants
const float MAX_AUDIO_DISTANCE = 50.0;
const float MIN_AUDIO_DISTANCE = 1.0;
const float FOOTSTEP_VOLUME = 0.7;
const float UI_SOUND_VOLUME = 0.8;

// Timing
const int TICK_RATE = 20; // 20 ticks per second
const int NETWORK_UPDATE_INTERVAL = 50; // milliseconds

// Movement
const float DEFAULT_MOVEMENT_SPEED = 5.0;
const float DEAD_MOVEMENT_SPEED = 7.5;

// Config Limits
const int MIN_IMPOSTORS = 1;
const int MAX_IMPOSTORS = 3;
const int MIN_KILL_COOLDOWN = 10;
const int MAX_KILL_COOLDOWN = 60;
const float MIN_KILL_DISTANCE = 1.0;
const float MAX_KILL_DISTANCE = 5.0;
const float MIN_PLAYER_SPEED = 0.5;
const float MAX_PLAYER_SPEED = 2.0;
const int MIN_DISCUSSION_TIME = 15;
const int MAX_DISCUSSION_TIME = 120;
const int MIN_VOTING_TIME = 30;
const int MAX_VOTING_TIME = 300;
const int MIN_TASKS_PER_PLAYER = 3;
const int MAX_TASKS_PER_PLAYER = 10;
const int MIN_EMERGENCY_MEETINGS = 0;
const int MAX_EMERGENCY_MEETINGS = 5;
