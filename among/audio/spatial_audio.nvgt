// spatial_audio.nvgt
// Fina camada sobre o sound_pool nativo do NVGT para posicionamento 2D simples (mundo absoluto,
// sem rotação de personagem - ver decisão de design). Um único listener (o jogador local) é
// atualizado a cada quadro; sons individuais são posicionados/movidos por slot.

#include "sound_pool.nvgt"
#include "../config/game_constants.nvgt"

class spatial_audio {
	sound_pool@ pool;
	float listener_x = 0.0;
	float listener_y = 0.0;

	// 192 slots, não 64: uma partida cheia tem ambiente de 8 salas + 9 corredores + beacons de todo
	// marco do mapa + alarme + corpos, e ainda um passo AVULSO por jogador a cada 0.35s, cada um
	// ocupando um slot até terminar. Com o pool lotado, play_2d devolve -1 e o som simplesmente não
	// toca - num jogo de áudio isso é o jogador ficando cego, e era silencioso pra quem programa.
	spatial_audio(int max_sounds = 192) {
		@pool = sound_pool(max_sounds);
		// O pool baixa o pitch do que está "atrás" do ouvinte (o eixo negativo dele). Como aqui não
		// existe direção de personagem - anda-se em coordenadas absolutas, W sempre é norte - a gente
		// trata NORTE como "à frente" invertendo o sinal de y ao falar com o pool (ver world_to_pool_y).
		// Assim "atrás" vira "ao sul", que é uma informação constante e aprendível.
		// O padrão do pool é 0.25%, ou seja, inaudível na prática - por isso isto nunca soou.
		pool.behind_pitch_decrease = SPATIAL_SOUTH_PITCH_DECREASE;
	}

	// O mundo cresce em y pro SUL (W = norte = y menor, ver game_loop). O pool entende +y como "à
	// frente", então o sinal é invertido em toda conversa com ele - e SÓ ali dentro: pro resto do
	// jogo as coordenadas continuam sendo as do mundo.
	private float world_to_pool_y(float world_y) const {
		return -world_y;
	}

	// Chamar uma vez por quadro com a posição atual do jogador local.
	void update_listener(float x, float y) {
		listener_x = x;
		listener_y = y;
		pool.update_listener_2d(x, world_to_pool_y(y));
	}

	// Som posicionado que toca uma vez e se limpa sozinho (passos, efeitos de interação, mortes, etc.).
	// volume_db vem da família de som a que ele pertence (ver audio_manager) - 0 = volume original.
	int play_once(const string&in path, float x, float y, float volume_db = 0.0) {
		return pool.play_extended_2d(path, listener_x, world_to_pool_y(listener_y), x, world_to_pool_y(y),
			0, 0, 0, 0, false, 0, 0.0, volume_db, 100.0, false);
	}

	// Som posicionado contínuo (alarme de sabotagem, corpo no chão). `persistent` mantém o slot vivo
	// mesmo fora do alcance de audição, retomando quando o jogador se aproximar.
	int play_looping(const string&in path, float x, float y, bool persistent = true, float volume_db = 0.0) {
		return pool.play_extended_2d(path, listener_x, world_to_pool_y(listener_y), x, world_to_pool_y(y),
			0, 0, 0, 0, true, 0, 0.0, volume_db, 100.0, persistent);
	}

	// Som posicionado contínuo que toca em volume constante em qualquer ponto dentro de uma área
	// retangular (half_width/half_height a partir de x,y) - só passa a atenuar por distância depois
	// que o jogador sai dessa área. Usado pro ambiente de cada sala (ver map_zone em map.nvgt): sem
	// isso o som só ficava audível perto do centro da sala, como um play_looping normal.
	int play_room_ambience(const string&in path, float x, float y, int half_width, int half_height, float volume_db = 0.0) {
		// As faixas são simétricas (half_height pros dois lados), então a inversão de y não muda a área.
		return pool.play_extended_2d(path, listener_x, world_to_pool_y(listener_y), x, world_to_pool_y(y),
			half_width, half_width, half_height, half_height, true, 0, 0.0, volume_db, 100.0, true);
	}

	// Som sem posição (UI/menu, notificações do sistema) - sempre audível, sem espacialização.
	int play_ui(const string&in path, bool looping = false, float volume_db = 0.0) {
		if (volume_db == 0.0) return pool.play_stationary(path, looping);
		return pool.play_stationary_extended(path, looping, 0, 0.0, volume_db, 100.0, true);
	}

	// Reposiciona um som já em reprodução (ex.: outro jogador andando, corpo carregado - não usado
	// hoje, mas útil para futuros objetos móveis).
	void move_sound(int slot, float x, float y) {
		if (slot < 0 or slot >= int(pool.items.length())) return;
		pool.items[slot].x = x;
		pool.items[slot].y = world_to_pool_y(y);
		pool.update_listener_2d(listener_x, world_to_pool_y(listener_y));
	}

	void stop_sound(int slot) {
		if (slot < 0) return;
		pool.destroy_sound(slot);
	}

	bool is_playing(int slot) const {
		return pool.sound_is_playing(slot);
	}

	// Reduz o alcance de audição geral (ex.: sabotagem de luzes). 0 = sem limite.
	void set_max_distance(int distance) {
		pool.max_distance = distance;
	}
}
