// spatial_audio.nvgt
// Fina camada sobre o sound_pool nativo do NVGT para posicionamento 2D simples (mundo absoluto,
// sem rotação de personagem - ver decisão de design). Um único listener (o jogador local) é
// atualizado a cada quadro; sons individuais são posicionados/movidos por slot.

#include "sound_pool.nvgt"

class spatial_audio {
	sound_pool@ pool;
	float listener_x = 0.0;
	float listener_y = 0.0;

	spatial_audio(int max_sounds = 64) {
		@pool = sound_pool(max_sounds);
	}

	// Chamar uma vez por quadro com a posição atual do jogador local.
	void update_listener(float x, float y) {
		listener_x = x;
		listener_y = y;
		pool.update_listener_2d(x, y);
	}

	// Som posicionado que toca uma vez e se limpa sozinho (passos, efeitos de interação, mortes, etc.).
	int play_once(const string&in path, float x, float y) {
		return pool.play_2d(path, listener_x, listener_y, x, y, false, false);
	}

	// Som posicionado contínuo (alarme de sabotagem, corpo no chão). `persistent` mantém o slot vivo
	// mesmo fora do alcance de audição, retomando quando o jogador se aproximar.
	int play_looping(const string&in path, float x, float y, bool persistent = true) {
		return pool.play_2d(path, listener_x, listener_y, x, y, true, persistent);
	}

	// Som posicionado contínuo que toca em volume constante em qualquer ponto dentro de uma área
	// retangular (half_width/half_height a partir de x,y) - só passa a atenuar por distância depois
	// que o jogador sai dessa área. Usado pro ambiente de cada sala (ver map_zone em map.nvgt): sem
	// isso o som só ficava audível perto do centro da sala, como um play_looping normal.
	int play_room_ambience(const string&in path, float x, float y, int half_width, int half_height) {
		return pool.play_extended_2d(path, listener_x, listener_y, x, y, half_width, half_width,
			half_height, half_height, true, 0, 0.0, 0.0, 100.0, true);
	}

	// Som sem posição (UI/menu, notificações do sistema) - sempre audível, sem espacialização.
	int play_ui(const string&in path, bool looping = false) {
		return pool.play_stationary(path, looping);
	}

	// Reposiciona um som já em reprodução (ex.: outro jogador andando, corpo carregado - não usado
	// hoje, mas útil para futuros objetos móveis).
	void move_sound(int slot, float x, float y) {
		if (slot < 0 or slot >= int(pool.items.length())) return;
		pool.items[slot].x = x;
		pool.items[slot].y = y;
		pool.update_listener_2d(listener_x, listener_y);
	}

	void stop_sound(int slot) {
		if (slot < 0) return;
		pool.destroy_sound(slot);
	}

	bool is_playing(int slot) const {
		return pool.sound_is_playing(slot);
	}

	// Reduz o alcance de audição geral (ex.: sabotagem de luzes). 0 = sem limite.
	void set_max_distance(int distance) {
		pool.max_distance = distance;
	}
}
