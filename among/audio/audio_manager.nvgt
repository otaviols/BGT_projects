// audio_manager.nvgt
// Sons específicos do jogo (passos, objetos do mapa, mortes, UI, sabotagem) construídos sobre
// spatial_audio.nvgt. Ponto único que o resto do jogo chama para tocar qualquer efeito sonoro.

#include "spatial_audio.nvgt"
#include "../config/game_constants.nvgt"
#include "../config/colors.nvgt"
#include "../game/map.nvgt"

class audio_manager {
	spatial_audio@ spatial;
	int ambient_body_slot = -1;
	int ambient_sabotage_slot = -1;
	uint footstep_variant_seed = 0;

	audio_manager() {
		@spatial = spatial_audio();
	}

	void update_listener(float x, float y) {
		spatial.update_listener(x, y);
	}

	// --- Passos ---
	// Alterna entre as variantes numeradas do prefixo de piso (ex.: Tile1.wav, Tile2.wav).
	void play_footstep(const string&in floor_prefix, int variant_count, float x, float y) {
		if (variant_count <= 0) return;
		footstep_variant_seed = (footstep_variant_seed + 1) % uint(variant_count);
		string path = "sounds/" + floor_prefix + (footstep_variant_seed + 1) + ".wav";
		spatial.play_once(path, x, y);
	}

	// --- Objetos do mapa ---
	void play_object_interact(map_object@ obj) {
		if (@obj == null || obj.sound_path == "") return;
		spatial.play_once(obj.sound_path, obj.x, obj.y);
	}

	int play_object_ambient(map_object@ obj) {
		if (@obj == null || obj.sound_path == "") return -1;
		return spatial.play_looping(obj.sound_path, obj.x, obj.y);
	}

	// --- Cores / mortes ---
	void play_death(int color_id, float x, float y) {
		spatial.play_once(color_death_sound_path(color_id), x, y);
	}

	void play_kill_laugh(int color_id, float x, float y) {
		spatial.play_once(color_kill_sound_path(color_id), x, y);
	}

	// --- Corpo no chão ---
	void start_body_beacon(float x, float y) {
		stop_body_beacon();
		ambient_body_slot = spatial.play_looping("sounds/bodyReport.wav", x, y, false);
	}

	void stop_body_beacon() {
		if (ambient_body_slot != -1) {
			spatial.stop_sound(ambient_body_slot);
			ambient_body_slot = -1;
		}
	}

	// --- Sabotagem ---
	void start_sabotage_alarm(float x, float y) {
		stop_sabotage_alarm();
		ambient_sabotage_slot = spatial.play_looping("sounds/emergence1.wav", x, y, false);
	}

	void stop_sabotage_alarm() {
		if (ambient_sabotage_slot != -1) {
			spatial.stop_sound(ambient_sabotage_slot);
			ambient_sabotage_slot = -1;
		}
	}

	// Sabotagem de luzes reduz o alcance de audição ambiente (decisão de design).
	void apply_lights_out(bool active, int normal_max_distance) {
		if (active) spatial.set_max_distance(int(normal_max_distance * LIGHTS_OUT_AUDIO_RANGE_MULTIPLIER));
		else spatial.set_max_distance(normal_max_distance);
	}

	// --- UI / menus (sem posição) ---
	void play_ui_sound(const string&in name) {
		spatial.play_ui("sounds/" + name);
	}

	void play_menu_click() { play_ui_sound("menuclick.wav"); }
	void play_menu_confirm() { play_ui_sound("menuconfirm.wav"); }
	void play_player_enter() { play_ui_sound("PlayerEnter.wav"); }
	void play_player_leave() { play_ui_sound("PlayerLeave.wav"); }
	void play_start_game() { play_ui_sound("startGame.wav"); }
	void play_win() { play_ui_sound("Win.wav"); }
	void play_defeat() { play_ui_sound("defeat.wav"); }
	void play_meeting_result() { play_ui_sound("meetingResult.wav"); }
	void play_vote_confirm() { play_ui_sound("voteConfirm.wav"); }

	// --- Radar ---
	void play_radar_beep(float x, float y) {
		spatial.play_once("sounds/beep.wav", x, y);
	}
}
