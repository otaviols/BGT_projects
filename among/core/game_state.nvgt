// game_state.nvgt
// Estado autoritativo de uma partida em andamento: jogadores, mapa, corpos, sabotagens,
// reuniões/votação e condição de vitória. Não conhece a camada de rede diretamente - produz
// net_packet@ para o servidor transmitir aos clientes da lobby.

#include "../config/game_constants.nvgt"
#include "../config/lobby_config.nvgt"
#include "../game/map.nvgt"
#include "player.nvgt"
#include "../network/protocol.nvgt"
#include "../network/packet.nvgt"

class body_info {
	string id;
	uint64 victim_peer_id;
	float x, y;
	string room_id;
}

class vote_entry {
	uint64 voter_peer_id;
	int64 target_peer_id; // -1 = pular voto
}

class game_state {
	string lobby_id;
	string lobby_name;
	uint64 host_peer_id;
	lobby_config@ config;
	game_map@ map;
	array<game_player@> players;
	array<body_info> bodies;
	array<vote_entry> votes;

	string state = "waiting"; // waiting | in_progress | meeting | voting | ended
	float meeting_timer = 0.0;
	float voting_timer = 0.0;
	uint64 meeting_caller = 0;
	string meeting_reason = ""; // "body" | "button"

	string active_sabotage = ""; // "" | "lights" | "oxygen"
	float sabotage_timer = 0.0;
	float sabotage_cooldown_remaining = 0.0;
	array<string> sabotage_fixed_panels;

	string winner = ""; // "" | "crewmates" | "impostors"
	string win_reason = "";
	float elapsed_time = 0.0;

	game_player@ find_player(uint64 peer_id) const {
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].peer_id == peer_id) return players[i];
		}
		return null;
	}

	array<game_player@>@ alive_players() const {
		array<game_player@> result;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive) result.insert_last(players[i]);
		}
		return result;
	}

	uint alive_crewmate_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && !players[i].is_impostor) count++;
		}
		return count;
	}

	uint alive_impostor_count() const {
		uint count = 0;
		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive && players[i].is_impostor) count++;
		}
		return count;
	}

	// Jogadores no mesmo cômodo/corredor que peer_id, vivos, não escondidos em vent - usado pelo radar.
	array<game_player@>@ players_in_same_room(uint64 peer_id) const {
		array<game_player@> result;
		game_player@ me = find_player(peer_id);
		if (@me == null) return result;
		string my_room = map.room_id_at(me.x, me.y);
		for (uint i = 0; i < players.length(); i++) {
			game_player@ p = players[i];
			if (p.peer_id == peer_id || !p.alive || p.vented) continue;
			if (map.room_id_at(p.x, p.y) == my_room) result.insert_last(p);
		}
		return result;
	}

	// Move validado usando o relógio interno da partida (elapsed_time) para calcular o delta desde
	// o último movimento aceito deste jogador - evita depender de relógio de rede não confiável.
	// Jogador morto (morto ou expulso) PODE se mover - vira fantasma, como no Among Us original -
	// quem trata a visibilidade/silêncio disso é on_move() (só retransmite pra outros mortos).
	bool try_move_player(uint64 peer_id, float x, float y) {
		game_player@ p = find_player(peer_id);
		if (@p == null) return false;
		if (state != "in_progress") return false; // movimento travado durante reunião/votação
		if (!map.is_walkable(x, y)) return false; // fora de qualquer sala/corredor - anti-cheat
		float delta = elapsed_time - p.last_move_time;
		if (delta <= 0.0) delta = 1.0 / NETWORK_TICKS_PER_SECOND;
		bool ok = p.try_move(x, y, delta);
		// SÓ avança o relógio de referência quando o movimento é ACEITO. Antes avançava sempre,
		// mesmo numa rejeição - aí a janela de tempo pro próximo pacote ficava minúscula (só o
		// intervalo entre pacotes, não desde a última posição CONFIRMADA), enquanto o cliente
		// continuava andando localmente e se afastando cada vez mais da posição travada no servidor.
		// Resultado: depois de UM pacote rejeitado (ex.: um soluço de rede), o jogador ficava preso
		// pro resto da partida sem NUNCA mais conseguir um movimento aceito - exatamente o que
		// "curava" ao entrar numa reunião, porque lá a posição de todo mundo é resincronizada à
		// força (ver start_meeting).
		if (ok) p.last_move_time = elapsed_time;
		return ok;
	}

	// --- Kill ---
	bool try_kill(uint64 killer_peer, uint64 target_peer, net_packet@&out out_event) {
		game_player@ killer = find_player(killer_peer);
		game_player@ target = find_player(target_peer);
		if (@killer == null || @target == null) return false;
		if (!killer.can_kill()) return false;
		if (!target.alive || target.peer_id == killer.peer_id) return false;
		if (distance_2d(killer.x, killer.y, target.x, target.y) > PLAYER_KILL_RANGE) return false;

		target.alive = false;
		killer.kill_cooldown_remaining = config.kill_cooldown_seconds;

		body_info body;
		body.id = "body_" + target.peer_id;
		body.victim_peer_id = target.peer_id;
		body.x = target.x;
		body.y = target.y;
		body.room_id = map.room_id_at(target.x, target.y);
		bodies.insert_last(body);

		@out_event = net_packet(S_PLAYER_KILLED);
		out_event.set_uint64("peer_id", target.peer_id);
		out_event.set_int("killer_color", killer.color);
		out_event.set_float("x", target.x);
		out_event.set_float("y", target.y);
		return true;
	}

	body_info@ find_body_near(float x, float y, float max_range) {
		for (uint i = 0; i < bodies.length(); i++) {
			if (distance_2d(x, y, bodies[i].x, bodies[i].y) <= max_range) return bodies[i];
		}
		return null;
	}

	// --- Reunião / votação ---
	// Vai direto pra votação (sem uma fase de "discussão" separada travando o menu) - todo mundo
	// vivo é teleportado pra cafeteria, o movimento trava (ver try_move_player), e o chat abre geral
	// pra todos (ver server.on_chat_message) durante o tempo combinado de discussão+votação.
	bool start_meeting(uint64 caller_peer, const string&in reason, net_packet@&out out_event) {
		if (state != "in_progress") return false;
		game_player@ caller = find_player(caller_peer);
		if (@caller == null || !caller.alive) return false;
		if (reason == "button" && caller.meetings_called >= config.emergency_meetings_per_player) return false;

		if (reason == "button") caller.meetings_called++;

		for (uint i = 0; i < players.length(); i++) {
			if (players[i].alive) {
				players[i].x = MEETING_GATHER_X;
				players[i].y = MEETING_GATHER_Y;
			}
		}

		state = "voting";
		voting_timer = config.discussion_time_seconds + config.voting_time_seconds;
		meeting_caller = caller_peer;
		meeting_reason = reason;
		votes.resize(0);

		@out_event = net_packet(S_MEETING_STARTED);
		out_event.set_uint64("caller_peer", caller_peer);
		out_event.set_string("reason", reason);
		out_event.set_float("gather_x", MEETING_GATHER_X);
		out_event.set_float("gather_y", MEETING_GATHER_Y);
		return true;
	}

	bool cast_vote(uint64 voter_peer, int64 target_peer) {
		if (state != "voting") return false;
		game_player@ voter = find_player(voter_peer);
		if (@voter == null || !voter.alive) return false;
		for (uint i = 0; i < votes.length(); i++) {
			if (votes[i].voter_peer_id == voter_peer) return false; // já votou
		}
		vote_entry v;
		v.voter_peer_id = voter_peer;
		v.target_peer_id = target_peer;
		votes.insert_last(v);
		return true;
	}

	bool all_alive_voted() const {
		uint alive_count = alive_crewmate_count() + alive_impostor_count();
		return votes.length() >= alive_count;
	}

	net_packet@ tally_votes() {
		dictionary counts;
		array<int64> targets;
		json_array@ breakdown = json_array(); // quem votou em quem, pra anunciar no cliente antes do resultado
		for (uint i = 0; i < votes.length(); i++) {
			int64 t = votes[i].target_peer_id;
			int64 c = 0;
			string key = "" + t;
			counts.get(key, c);
			c++;
			counts.set(key, c);
			if (targets.find(t) == -1) targets.insert_last(t);

			game_player@ voter = find_player(votes[i].voter_peer_id);
			json_object@ entry = json_object();
			entry.set("voter_name", @voter != null ? voter.username : "");
			if (t == -1) {
				entry.set("skipped", true);
				entry.set("target_name", "");
			} else {
				game_player@ target = find_player(uint64(t));
				entry.set("skipped", false);
				entry.set("target_name", @target != null ? target.username : "");
			}
			breakdown.add(entry);
		}

		int64 best_target = -1;
		int64 best_count = 0;
		bool tie = false;
		for (uint i = 0; i < targets.length(); i++) {
			int64 t = targets[i];
			if (t == -1) continue; // votos de "pular" não elegem ninguém
			int64 c = 0;
			counts.get("" + t, c);
			if (c > best_count) { best_count = c; best_target = t; tie = false; }
			else if (c == best_count && c > 0) tie = true;
		}

		net_packet@ result = net_packet(S_VOTE_RESULT);
		result.set_array("vote_breakdown", breakdown);
		if (best_target != -1 && !tie && best_count > 0) {
			game_player@ ejected = find_player(uint64(best_target));
			if (@ejected != null) {
				ejected.alive = false;
				result.set_uint64("ejected_peer", ejected.peer_id);
				result.set_string("ejected_name", ejected.username);
				result.set_bool("was_impostor", ejected.is_impostor);
				result.set_bool("tie", false);
			}
		} else {
			result.set_uint64("ejected_peer", 0);
			result.set_string("ejected_name", "");
			result.set_bool("was_impostor", false);
			result.set_bool("tie", tie);
		}

		state = "in_progress";
		votes.resize(0);
		return result;
	}

	// --- Sabotagem ---
	bool trigger_sabotage(uint64 impostor_peer, const string&in sabotage_id, net_packet@&out out_event) {
		game_player@ impostor = find_player(impostor_peer);
		if (@impostor == null || !impostor.is_impostor || !impostor.alive) return false;
		if (active_sabotage != "") return false;
		if (sabotage_cooldown_remaining > 0.0) return false;

		active_sabotage = sabotage_id;
		sabotage_fixed_panels.resize(0);
		sabotage_timer = sabotage_id == "oxygen" ? SABOTAGE_OXYGEN_TIMER_SECONDS : SABOTAGE_LIGHTS_DURATION_SECONDS;

		@out_event = net_packet(S_SABOTAGE_STARTED);
		out_event.set_string("sabotage_id", sabotage_id);
		out_event.set_float("timer", sabotage_timer);
		return true;
	}

	int required_panels_for(const string&in sabotage_id) const {
		return sabotage_id == "oxygen" ? 2 : 1;
	}

	bool try_fix_sabotage_panel(uint64 peer_id, const string&in object_id, net_packet@&out out_event) {
		if (active_sabotage == "") return false;
		game_player@ p = find_player(peer_id);
		if (@p == null || !p.alive) return false;

		map_object@ obj = map.find_object(object_id);
		if (@obj == null || obj.obj_type != OBJ_SABOTAGE_PANEL) return false;
		if (obj.task_type != active_sabotage) return false;
		if (distance_2d(p.x, p.y, obj.x, obj.y) > PLAYER_INTERACT_RANGE) return false;

		if (sabotage_fixed_panels.find(object_id) == -1) sabotage_fixed_panels.insert_last(object_id);
		if (int(sabotage_fixed_panels.length()) < required_panels_for(active_sabotage)) return false;

		@out_event = net_packet(S_SABOTAGE_FIXED);
		out_event.set_string("sabotage_id", active_sabotage);
		active_sabotage = "";
		sabotage_fixed_panels.resize(0);
		sabotage_cooldown_remaining = SABOTAGE_COOLDOWN_SECONDS;
		return true;
	}

	// --- Tick: avança timers, retorna eventos que o servidor precisa transmitir. ---
	array<net_packet@>@ tick(float delta_seconds) {
		array<net_packet@> events;
		elapsed_time += delta_seconds;

		for (uint i = 0; i < players.length(); i++) players[i].tick_cooldowns(delta_seconds);

		if (sabotage_cooldown_remaining > 0.0) {
			sabotage_cooldown_remaining -= delta_seconds;
			if (sabotage_cooldown_remaining < 0.0) sabotage_cooldown_remaining = 0.0;
		}

		if (active_sabotage != "") {
			sabotage_timer -= delta_seconds;
			if (sabotage_timer <= 0.0) {
				if (active_sabotage == "oxygen") {
					winner = "impostors";
					win_reason = "oxygen_depleted";
				}
				active_sabotage = "";
				sabotage_fixed_panels.resize(0);
			}
		}

		// "meeting" não existe mais como fase separada - start_meeting() já deixa o estado em
		// "voting" direto (ver lá). Só falta contar o tempo até acabar ou até todo mundo votar.
		if (state == "voting") {
			voting_timer -= delta_seconds;
			if (voting_timer <= 0.0 || all_alive_voted()) {
				events.insert_last(tally_votes());
			}
		}

		if (winner == "") {
			if (alive_impostor_count() == 0) { winner = "crewmates"; win_reason = "impostors_ejected"; }
			else if (alive_impostor_count() >= alive_crewmate_count()) { winner = "impostors"; win_reason = "majority"; }
			else {
				bool all_done = true;
				for (uint i = 0; i < players.length(); i++) {
					if (players[i].is_impostor) continue;
					if (!players[i].all_tasks_completed()) { all_done = false; break; }
				}
				if (all_done && players.length() > 0) { winner = "crewmates"; win_reason = "tasks_completed"; }
			}
		}

		if (winner != "" && state != "ended") {
			state = "ended";
			uint crewmates_total = 0;
			uint impostors_total = 0;
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].is_impostor) impostors_total++;
				else crewmates_total++;
			}
			net_packet@ go = net_packet(S_GAME_OVER);
			go.set_string("winner", winner);
			go.set_string("reason", win_reason);
			go.set_int("crewmates_alive", int(alive_crewmate_count()));
			go.set_int("crewmates_total", int(crewmates_total));
			go.set_int("impostors_alive", int(alive_impostor_count()));
			go.set_int("impostors_total", int(impostors_total));
			events.insert_last(go);
		}

		return events;
	}
}
