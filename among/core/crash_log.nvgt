// crash_log.nvgt
// Caixa-preta do cliente. Quando uma exceção escapa (índice fora do array, handle nulo, JSON
// estranho vindo da rede...), o script inteiro morre e a janela do jogo simplesmente some - o
// jogador só sabe dizer "fechou sozinho", e não sobra nada pra investigar.
//
// Aqui a exceção é capturada, gravada em crash.log com tudo que a engine sabe sobre ela (mensagem,
// função e linha) mais o contexto em que aconteceu, e o jogador é avisado por fala em vez de ficar
// no vácuo. O log ACUMULA (append), pra não perder o primeiro crash quando acontece o segundo.
//
// O log também serve como diagnóstico por ausência: se o cliente morrer e NÃO existir crash.log
// novo, então não foi exceção de script - é falha nativa (áudio, rede, engine) e a investigação
// tem que ir pra outro lado.

#include "../lang/i18n.nvgt"

const string CRASH_LOG_FILE = "crash.log";

// Chamar de dentro de um catch. context descreve o que o jogo estava fazendo ("partida",
// "pacote s_player_moved", "sala de espera"...) - é a informação que a engine não tem como saber.
void log_crash(const string&in context) {
	datetime now;
	string report = "=== " + now.format("%Y-%m-%d %H:%M:%S") + " ===\r\n";
	report += "contexto: " + context + "\r\n";
	report += "erro: " + get_exception_info() + "\r\n";
	report += "funcao: " + get_exception_function() + "\r\n";
	report += "linha: " + get_exception_line() + "\r\n\r\n";
	file_put_contents(CRASH_LOG_FILE, report, true); // true = acrescenta ao que já existe
}
