// main.nvgt
// Ponto de entrada do cliente. Fluxo: conectar ao servidor -> login/cadastro -> navegador de
// lobby (criar/entrar) -> sala de espera -> partida -> volta ao navegador de lobby ao terminar.

// Nada é copiado pro pacote compilado (nvgt -c) sem ser avisado aqui. Sem lang/, por exemplo, tr()
// não acha chave nenhuma e o jogo compilado "fala" os nomes das chaves em vez do texto traduzido.
//
// Os sons vão num pacote único (sounds.dat) em vez da pasta sounds/ inteira - ver load_sound_pack()
// abaixo. O pacote precisa EXISTIR na hora de compilar: gere com `nvgt tools/build_pack.nvgt` toda
// vez que um som mudar, senão a compilação para com "File not found: sounds.dat" (o que é melhor do
// que compilar calado com sons velhos).
#pragma asset "sounds.dat"
// lang/ guarda só os DADOS de tradução; o código do i18n mora em src/. Foi por isso que os dois
// foram separados: assim a pasta inteira pode ser empacotada sem mandar fonte junto pro produto
// final, e o caminho "lang/" continua o mesmo rodando do fonte ou do jogo compilado - que é o que a
// troca de idioma usa pra listar o que existe (find_files em src/i18n.nvgt).
// As aspas são obrigatórias, senão o pré-processador quebra o nome no ponto.
#pragma asset "lang"
// Os manuais entram como DOCUMENTO, não como asset: documento é o que o NVGT trata como arquivo pro
// JOGADOR abrir (em alguns sistemas ele fica fora da pasta interna do aplicativo, justamente pra
// ser fácil de achar), enquanto asset é arquivo que o jogo carrega sozinho.
// Os dois idiomas vão juntos porque o jogo tem os dois (ver a configuração de idioma): distribuir
// só o manual em português deixaria quem joga em inglês sem manual nenhum.
// O valor vai entre aspas de propósito: sem elas o pré-processador quebra o nome no ponto e
// procura por "LEIAME . md", que não existe.
// Origem em docs/ (organização do repositório), entregue na RAIZ da pasta do jogo (onde o jogador
// acha). A forma "origem;destino" é o que permite as duas coisas ao mesmo tempo.
#pragma document "docs/README_ptBR.md;LEIAME.md"
#pragma document "docs/README_enUS.md;README.md"

#include "src/network/client.nvgt"
#include "src/core/crash_log.nvgt"
#include "src/core/updater.nvgt"
#include "src/ui/onboarding_screens.nvgt"
#include "src/ui/lobby_screens.nvgt"
#include "src/game/game_loop.nvgt"
#include "src/i18n.nvgt"
#include "src/config/game_constants.nvgt"

const string SOUND_PACK_PATH = "sounds.dat";

// O pacote precisa continuar vivo enquanto o jogo roda: os sons são lidos de dentro dele sob
// demanda, não carregados todos de uma vez no começo.
pack_file@ g_sound_pack;

// Liga o pacote de sons, se ele existir. Com ele aberto, sound_default_pack faz TODO carregamento de
// som (sound_pool via spatial_audio, sound_play dos menus, minigames de task) ler de dentro do
// sounds.dat sem que nenhuma dessas chamadas precise saber disso.
// Sem o pacote, o jogo lê os arquivos soltos de sounds/ - é assim que se roda direto do fonte
// durante o desenvolvimento, trocando um som e ouvindo o resultado na hora, sem regerar nada.
void load_sound_pack() {
	pack_file@ pack = pack_file();
	if (pack.open(SOUND_PACK_PATH)) {
		@g_sound_pack = pack;
		@sound_default_pack = pack;
		return;
	}
	// Sem pacote E sem a pasta, o jogo rodaria completamente mudo sem dizer por quê - o pior tipo de
	// falha num jogo que é só som.
	if (!directory_exists("sounds")) alert(tr("app.title"), tr("error.sounds_missing"));
}

void main() {
	// Preferências do jogador (volumes, teclas, voz, idioma) antes de qualquer som tocar, tecla ser
	// lida ou texto ser dito. O idioma vem daqui, então carregar as preferências tem que vir ANTES
	// de carregar o idioma - o contrário faria o jogo abrir sempre em português e só respeitar a
	// escolha do jogador na segunda tela.
	g_settings.load();
	// Se o idioma salvo não carregar (arquivo removido de um build pra outro, por exemplo), cai no
	// padrão em vez de deixar o jogo inteiro falando por chaves cruas.
	if (!g_i18n.load_language(g_settings.language)) g_i18n.load_language(DEFAULT_LANGUAGE);
	load_sound_pack();
	// A versão vai no TÍTULO DA JANELA, e só nele: é a pergunta que todo suporte faz primeiro, e o
	// jogador consegue responder sem procurar em lugar nenhum - o leitor de tela fala o título ao
	// entrar na janela. Os outros usos de app.title continuam sem versão de propósito: dois deles
	// são títulos de diálogo, e um é o nome padrão de sala (ver ui/lobby_screens.nvgt), onde um
	// número de versão não faria sentido nenhum.
	dictionary@ title_params = dictionary();
	title_params.set("title", tr("app.title"));
	title_params.set("version", GAME_VERSION);
	show_window(tr("app.window_title", title_params));

	// Depois da janela existir, pra que o aviso de versão nova tenha onde aparecer, e antes do menu,
	// que é onde o jogador fica. Sem internet ou com o site fora do ar isto não diz nada e não
	// atrasa nada perceptível - ver src/core/updater.nvgt.
	//
	// Se a atualização começou, o jogo TEM que sair agora: o script que vai trocar os arquivos está
	// esperando este processo morrer pra conseguir escrever por cima do executável. Continuar aqui
	// deixaria os dois travados, um esperando o outro.
	if (run_update_check()) return;

	// Se a verificação acima NÃO iniciou uma atualização, então nenhuma está em curso e é seguro
	// varrer o que uma anterior possa ter deixado para trás na pasta do jogo.
	clean_update_leftovers();

	// Menu inicial (conectar / aprender os sons / sair) - cancelar conexão ou login volta pra cá em
	// vez de fechar o jogo direto.
	//
	// Tudo daqui pra dentro roda num try: qualquer exceção que escapasse mataria o script e a janela
	// sumiria da tela sem dizer nada (era assim que o jogo "fechava sozinho"). Com o catch, o erro vai
	// pro crash.log, o jogador é avisado e volta pro menu - o que estava em andamento se perde, mas o
	// jogo continua de pé e sobra evidência do que aconteceu.
	//
	// O MENU também está dentro do try, e não só a partida. Antes só run_session() era protegido, e
	// por isso um erro nas configurações, no menu de aprender os sons ou no envio de recado derrubava
	// o jogo do mesmo jeito de antes, sem log nenhum. Quem está testando a beta passa boa parte do
	// tempo justamente nessas telas, então era ali que o buraco doía mais.
	while (true) {
		try {
			if (!run_main_menu()) break;
			run_session();
		}
		catch {
			report_crash("sessao");
		}
	}
}

// Registra o que quebrou e avisa o jogador.
//
// A mensagem depende de o log ter sido gravado ou não: mandar alguém procurar um crash.log que não
// existe faz a pessoa perder tempo e voltar dizendo que não achou nada. Quando não deu para gravar,
// o jogo pede o que ainda é possível conseguir - o relato pelo próprio jogo.
void report_crash(const string&in context) {
	bool registrado = log_crash(context);
	speak(tr(registrado ? "error.unexpected" : "error.unexpected_no_log"));
	wait(2500); // tempo do leitor de tela terminar a frase antes de voltar pro menu
}

// Uma sessão completa: conectar, logar, e ficar entrando em partidas até o jogador sair.
void run_session() {
	game_client client;
	if (!connect_to_server(client)) return;

	login_result login = run_login_screen(client);
	if (!login.ok) { client.disconnect(); return; }

	while (true) {
		// Começo limpo a cada volta: o que sobrou na fila é de uma partida ou sala que ficou pra trás.
		// Sem isto, sair de uma partida e entrar noutra fazia a tela nova processar eventos da antiga.
		client.clear_incoming();

		lobby_browser_result browse = run_lobby_browser_screen(client);
		if (browse.go_back || !browse.joined) break;

		net_packet@ start_pkt = run_waiting_room_screen(client, browse.is_host);
		if (@start_pkt == null) continue; // jogador saiu da sala de espera, volta pro navegador

		run_game(client, start_pkt);
		// ao fim da partida (S_GAME_OVER), o servidor volta a lobby pro estado "waiting";
		// o jogador retorna ao navegador de lobbies.
	}

	client.disconnect();
}
