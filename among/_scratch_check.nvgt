#include "config/game_constants.nvgt"
#include "config/colors.nvgt"
#include "config/lobby_config.nvgt"
#include "config/presets.nvgt"
#include "lang/i18n.nvgt"
#include "network/protocol.nvgt"
#include "network/packet.nvgt"
#include "database/models.nvgt"
#include "database/user_db.nvgt"
#include "game/map.nvgt"
#include "core/player.nvgt"
#include "core/game_state.nvgt"
#include "network/client.nvgt"
#include "audio/audio_manager.nvgt"
#include "ui/radar.nvgt"

void main() {
	g_i18n.load_language("pt_BR");
	net_packet@ p = net_packet(C_MOVE);
	p.set_float("x", 1.5);
	p.set_float("y", 2.5);
	string wire = p.to_wire();
	net_packet@ p2 = packet_from_wire(wire);
	if (@p2 != null) {
		// touch fields to force compilation of getters
		float x = p2.get_float("x");
		float y = p2.get_float("y");
	}
	lobby_config@ cfg = get_preset("classic");
	cfg.validate();

	@g_user_db = user_database();
	g_user_db.open("scratch_test.db");
	string err;
	g_user_db.create_user("tester", "senha123", err);
	bool login_ok = g_user_db.verify_login("tester", "senha123");
	g_user_db.close();

	game_map@ map = build_the_hub_map();
	game_player@ gp = game_player(1, "tester");
	gp.try_move(1.0, 1.0, 1.0);
	string room = map.room_id_at(gp.x, gp.y);

	game_state@ gs = game_state();
	@gs.config = get_preset("classic");
	@gs.map = map;
	gs.players.insert_last(gp);
	array<net_packet@>@ evs = gs.tick(0.1);

	game_client@ gc = game_client();
	gc.send_move(1.0, 2.0); // não conectado, mas testa que compila e não trava (net@ é null)

	audio_manager@ am = audio_manager();
	am.update_listener(0.0, 0.0);
	am.play_footstep("Tile", 2, 0.0, 0.0);
	am.play_death(COLOR_RED, 1.0, 1.0);

	radar_ui@ radar = radar_ui(gc, am);
	radar.scan_next();

	println("OK: " + tr("app.title") + " color=" + tr("color.red") + " x=" + wire + " login_ok=" + login_ok + " room=" + room + " events=" + evs.length());
}
