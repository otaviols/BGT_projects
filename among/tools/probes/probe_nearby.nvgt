// Sonda da lista de quem é perceptível perto de cada jogador (S_NEARBY_PLAYERS).
//   AMONGUS_SERVER_HOST=127.0.0.1 nvgt tools/probes/probe_nearby.nvgt
//
// O elenco do cliente guarda o último ponto de todo mundo, e quem entrava num duto continuava "parado"
// ali: anunciado a quem passasse e mirado pela tecla de matar. Agora o servidor diz a cada um quem é
// perceptível à volta dele. A sonda confere, com um impostor entrando num duto ao lado de alguém:
//   1. o CONTROLE: antes, quem está colado tem o impostor na lista (senão "sumiu" passaria à toa);
//   2. ao entrar no duto, ele sai da lista de quem está colado;
//   3. quem está LONGE não recebe pacote nenhum nessa hora - a lista não pode virar um aviso à nave
//      inteira de que alguém entrou num duto;
//   4. ao sair do duto, ele volta à lista.
// (O engolido pelo lobo sai da lista pela mesma regra - conferido em probe_wolf.)
#include "../../src/network/client.nvgt"
#include "../../src/config/game_constants.nvgt"
#include "../../src/config/server_address.nvgt"
#include "../../src/config/lobby_config.nvgt"
#include "../../src/game/map.nvgt"
#include "../../src/i18n.nvgt"

net_packet@ wf(game_client@ c, const string&in t, int ms) {
	timer x;
	while (x.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == t) return p; @p = c.poll_message(); } wait(5); }
	return null;
}
array<array<net_packet@>@> caixa;
void esvazia_caixa() { for (uint i = 0; i < caixa.length(); i++) caixa[i].resize(0); }
void drena(array<game_client@>@ todos) {
	for (uint i = 0; i < todos.length(); i++) {
		todos[i].update();
		net_packet@ p = todos[i].poll_message();
		while (@p != null) { caixa[i].insert_last(p); @p = todos[i].poll_message(); }
	}
}
void bombeia(array<game_client@>@ todos, int ms) {
	timer t;
	while (t.elapsed < ms) { drena(todos); wait(10); }
}
net_packet@ espera(array<game_client@>@ todos, uint i, const string&in tipo, int ms) {
	timer t;
	while (t.elapsed < ms) {
		drena(todos);
		for (uint k = 0; k < caixa[i].length(); k++) if (caixa[i][k].type == tipo) return caixa[i][k];
		wait(5);
	}
	return null;
}
// A lista mais recente que chegou a este cliente desde a última limpeza (null = nenhuma).
net_packet@ ultima_lista(uint i) {
	net_packet@ achada = null;
	for (uint k = 0; k < caixa[i].length(); k++) if (caixa[i][k].type == S_NEARBY_PLAYERS) @achada = caixa[i][k];
	return achada;
}
bool lista_tem(net_packet@ lista, uint64 peer) {
	if (@lista == null) return false;
	json_array@ peers = lista.get_array("peers");
	if (@peers == null) return false;
	for (uint i = 0; i < peers.length(); i++) if (uint64(peers[i]) == peer) return true;
	return false;
}

const float PASSO_MS = 100.0;
const float PASSO_DIST = PLAYER_MOVE_SPEED * (PASSO_MS / 1000.0) * 0.8;
void anda_ate(array<game_client@>@ todos, game_client@ c, float de_x, float de_y, float ate_x, float ate_y) {
	float dist = distance_2d(de_x, de_y, ate_x, ate_y);
	int passos = int(dist / PASSO_DIST) + 1;
	for (int i = 1; i <= passos; i++) {
		float t = float(i) / float(passos);
		c.send_move(de_x + (ate_x - de_x) * t, de_y + (ate_y - de_y) * t);
		bombeia(todos, int(PASSO_MS));
	}
}

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}

void main() {
	game_map@ mapa = build_the_hub_map();
	server_address addr = resolve_server_address();
	string sfx = "" + random(1000, 9999);
	array<game_client@> todos;
	for (int i = 0; i < 4; i++) {
		game_client c;
		if (!c.connect_to(addr.host, addr.port)) { println("connect falhou"); return; }
		timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
		string nome = "nb" + i + "x" + sfx;
		c.send_register(nome, "probe123"); wf(c, S_REGISTER_RESULT, 3000);
		c.send_login(nome, "probe123");
		net_packet@ lr = wf(c, S_LOGIN_RESULT, 5000);
		if (@lr == null || !lr.get_bool("ok")) { println("login falhou"); return; }
		c.my_peer_id = lr.get_uint64("peer_id");
		todos.insert_last(c);
		caixa.insert_last(array<net_packet@>());
	}
	lobby_overrides ov;
	ov.impostor_count = 1;
	todos[0].send_create_lobby("perto", "classic", ov);
	net_packet@ st = wf(todos[0], S_LOBBY_STATE, 5000);
	if (@st == null) { println("sem sala"); return; }
	for (uint i = 1; i < todos.length(); i++) { todos[i].send_join_lobby(st.get_string("lobby_id")); wf(todos[i], S_JOIN_RESULT, 5000); }
	bombeia(todos, 300);
	esvazia_caixa();
	todos[0].send_start_game();

	int imp = -1;
	array<float> xs(4), ys(4);
	for (uint i = 0; i < 4; i++) {
		net_packet@ s = espera(todos, i, S_GAME_START, 8000);
		if (@s == null) { println("sem S_GAME_START"); return; }
		xs[i] = s.get_float("your_x"); ys[i] = s.get_float("your_y");
		if (role_for(s.get_string("your_role")).team == TEAM_IMPOSTOR) imp = int(i);
	}
	if (imp < 0) { println("nenhum impostor"); return; }
	int perto = (imp + 1) % 4, longe = (imp + 2) % 4;

	map_object@ duto = mapa.find_object("vent_navigation");
	if (@duto == null) { println("o duto vent_navigation nao existe mais no mapa"); return; }
	// O de longe vai ao duto de armas, do outro lado da cafeteria: PERCEPTION_SET_RANGE é o alcance do som
	// (40), e a cafeteria, onde todos nascem, fica dentro dele.
	map_object@ oposto = mapa.find_object("vent_weapons");
	if (@oposto == null) { println("o duto vent_weapons nao existe mais no mapa"); return; }
	anda_ate(todos, todos[imp], xs[imp], ys[imp], duto.x, duto.y);
	anda_ate(todos, todos[perto], xs[perto], ys[perto], duto.x + 0.5, duto.y);
	anda_ate(todos, todos[longe], xs[longe], ys[longe], oposto.x + 0.5, oposto.y);
	xs[longe] = oposto.x + 0.5; ys[longe] = oposto.y;
	bombeia(todos, 800);
	confere("controle: quem esta colado ve o impostor na lista", lista_tem(ultima_lista(perto), todos[imp].my_peer_id));
	confere("controle: o de longe esta longe mesmo (" + distance_2d(xs[longe], ys[longe], duto.x, duto.y) + ")",
		distance_2d(xs[longe], ys[longe], duto.x, duto.y) > PERCEPTION_SET_RANGE + 1.0);

	esvazia_caixa();
	todos[imp].send_use_vent(duto.id);
	net_packet@ entrou = espera(todos, imp, S_VENT_STATE, 3000);
	confere("o impostor entrou no duto", @entrou != null && entrou.get_bool("vented"));
	bombeia(todos, 800);
	net_packet@ depois = ultima_lista(perto);
	confere("quem esta colado recebeu uma lista nova", @depois != null);
	confere("e o impostor nao esta mais nela", @depois != null && !lista_tem(depois, todos[imp].my_peer_id));
	confere("o de longe nao recebeu pacote de lista nenhum", @ultima_lista(longe) == null);

	esvazia_caixa();
	todos[imp].send_vent_travel("");
	espera(todos, imp, S_VENT_STATE, 3000);
	bombeia(todos, 800);
	confere("ao sair do duto ele volta a lista", lista_tem(ultima_lista(perto), todos[imp].my_peer_id));

	for (uint i = 0; i < todos.length(); i++) todos[i].disconnect();
	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
