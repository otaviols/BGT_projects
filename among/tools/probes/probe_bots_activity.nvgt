// Sonda do que os bots FAZEM numa partida: andam? fazem tarefa? A mesma partida com e sem o modo cor,
// para separar "o modo cor quebrou os bots" de "os bots sempre foram assim".
//   AMONGUS_SERVER_HOST=127.0.0.1 nvgt tools/probes/probe_bots_activity.nvgt
//
// Um humano parado (tripulante ou impostor, tanto faz) e três bots. Durante a janela, conta os
// passos de cada bot que chegam ao humano e o progresso das tarefas da equipe.
#include "../../src/network/client.nvgt"
#include "../../src/config/game_constants.nvgt"
#include "../../src/config/server_address.nvgt"
#include "../../src/config/lobby_config.nvgt"

net_packet@ wf(game_client@ c, const string&in t, int ms) {
	timer x;
	while (x.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == t) return p; @p = c.poll_message(); } wait(5); }
	return null;
}

void rodar(bool modo_cor, int janela_ms) {
	server_address addr = resolve_server_address();
	game_client c;
	if (!c.connect_to(addr.host, addr.port)) { println("connect falhou"); return; }
	timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
	string nome = "bt" + random(10000, 99999);
	c.send_register(nome, "probe123"); wf(c, S_REGISTER_RESULT, 3000);
	c.send_login(nome, "probe123");
	net_packet@ lr = wf(c, S_LOGIN_RESULT, 5000);
	if (@lr == null || !lr.get_bool("ok")) { println("login falhou"); return; }
	c.my_peer_id = lr.get_uint64("peer_id");
	lobby_overrides ov;
	ov.impostor_count = 1;
	ov.color_mode = modo_cor ? "on" : "off";
	ov.sabotages = "off"; // sabotagem mudaria o que se mede
	c.send_create_lobby("bots", "classic", ov);
	if (@wf(c, S_LOBBY_STATE, 5000) == null) { println("sem sala"); return; }
	for (int b = 0; b < 3; b++) { c.send_add_bot(); timer w; while (w.elapsed < 200) { c.update(); c.clear_incoming(); wait(5); } }
	c.send_start_game();
	net_packet@ s = wf(c, S_GAME_START, 8000);
	if (@s == null) { println("nao comecou"); return; }

	dictionary passos;
	int progresso = -1;
	timer janela;
	while (janela.elapsed < janela_ms) {
		c.update();
		net_packet@ p = c.poll_message();
		while (@p != null) {
			if (p.type == S_PLAYER_MOVED) {
				string k = "" + p.get_uint64("peer_id");
				int n = 0;
				if (passos.exists(k)) passos.get(k, n);
				passos.set(k, n + 1);
			} else if (p.type == S_TASK_PROGRESS) {
				progresso = p.get_int("percent", p.get_int("progress", progresso));
			}
			@p = c.poll_message();
		}
		wait(5);
	}
	array<string>@ ids = passos.get_keys();
	string resumo = "";
	for (uint i = 0; i < ids.length(); i++) { int n = 0; passos.get(ids[i], n); resumo += " bot" + i + "=" + n; }
	println((modo_cor ? "MODO COR   " : "modo normal") + ": bots que andaram=" + ids.length() + " (passos:" + resumo + "), progresso da equipe=" + progresso + "%");
	c.disconnect();
}

void main() {
	rodar(false, 25000);
	rodar(true, 25000);
}
