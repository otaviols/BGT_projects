// Sonda da tela de criar sala, sem rede: Enter confirma e devolve a sala; o botão "Papéis especiais" abre
// a tela de PAPÉIS (e não a de modificadores).
//   nvgt tools/probes/probe_lobby_form.nvgt
//
// Existe por causa da 0.50.0 e da 0.50.1. Na primeira, o formulário passou dos 50 controles do
// audio_form, o botão de confirmar não era criado e o Enter não fazia nada. Na segunda, o botão de
// papéis abria a tela de modificadores (is_pressed lido duas vezes). Nenhuma sonda passava por esta
// tela. As teclas são apertadas de DENTRO do laço da tela, pelo gancho que client.update() chama a cada
// quadro: simular antes de abrir a tela não funciona. Cuidado: a janela da sonda recebe também o que
// você digitar enquanto ela roda.
#include "../../src/game/game_loop.nvgt"
#include "../../src/ui/lobby_screens.nvgt"
#include "../../src/core/crash_log.nvgt"

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}
array<string> falado;
string grava(const string&in t) { falado.insert_last(t); return ""; }
bool falou(const string&in trecho) {
	for (uint i = 0; i < falado.length(); i++) if (falado[i].find(trecho) >= 0) return true;
	return false;
}

// Um roteiro de teclas, uma a cada 15 quadros, apertada e solta dentro do laço da tela.
int quadro = 0;
array<int> roteiro;
uint passo = 0;
void dirige() {
	quadro++;
	if (quadro > 6000) exit(1); // a tela não devolveu em ~30 s: travou, e é isso que a sonda acusa
	if (passo >= roteiro.length()) return;
	if (quadro < 40) return; // a tela termina de se apresentar antes da primeira tecla
	if (quadro % 15 == 0) simulate_key_down(roteiro[passo]);
	if (quadro % 15 == 3) { simulate_key_up(roteiro[passo]); passo++; }
}
void roda(array<int>@ teclas) {
	roteiro = teclas;
	passo = 0;
	quadro = 0;
	falado.resize(0);
}

game_client@ cliente_offline() {
	game_client@ c = game_client();
	@c.net = network();
	c.net.setup_client(MAX_PACKET_CHANNELS, 1);
	return c;
}

void main() {
	show_window("sonda: criar sala");
	if (!directory_exists("lang")) chdir("..");
	if (!directory_exists("lang")) chdir("..");
	g_i18n.load_language(DEFAULT_LANGUAGE);
	@tts_default_text_processing_callback = grava;
	sound_master_volume = -100;
	game_client@ c = cliente_offline();
	@g_client_frame_hook = dirige;
	@g_screen_menu_frame_hook = dirige; // o botão de papéis abre um MENU de times antes da tela

	println("== zero e uma resposta ==");
	// Relato de 2026-10-23: 0 neutros saía como "cada neutro pelas próprias vagas" - o 0 era lido como vazio.
	confere("0 vale 0", text_to_count_or_default("0") == 0 && text_to_count_or_default(" 0 ") == 0);
	confere("vazio e lixo continuam 'nao mexi'", text_to_count_or_default("") == -1 && text_to_count_or_default("zero") == -1
		&& text_to_count_or_default("-2") == -1);
	confere("numero e numero", text_to_count_or_default("3") == 3);
	confere("em segundos, 0 e 2,5 tambem", text_to_amount_or_default("0") == 0.0 && text_to_amount_or_default("2,5") == 2.5
		&& text_to_amount_or_default("2.5") == 2.5 && text_to_amount_or_default("1.2.3") < 0.0);
	lobby_overrides zero;
	zero.neutral_count = text_to_count_or_default("0") < 0 ? NEUTRALS_BY_ROLE : text_to_count_or_default("0");
	lobby_config sala = get_preset("classic");
	zero.apply_to(sala);
	sala.validate();
	confere("e a sala fica com nenhum neutro (" + sala.neutral_count + ")", sala.neutral_count == 0);

	println("== confirmar ==");
	array<int> so_enter = {KEY_RETURN};
	roda(so_enter);
	lobby_form_result r = run_lobby_settings_form(c, null, true);
	confere("Enter no primeiro campo confirma a criacao", r.ok && r.preset_id == "classic");

	println("== nome lembrado (recado #218) ==");
	// Só o campo: quem grava o nome é a tela de criar, que a sonda não chama - nada vai para o disco.
	string nome_antes = g_settings.last_lobby_name;
	g_settings.last_lobby_name = "";
	roda(so_enter);
	r = run_lobby_settings_form(c, null, true);
	confere("sem nome lembrado, o campo traz o padrao (" + r.lobby_name + ")", r.lobby_name == tr("app.title"));
	g_settings.last_lobby_name = "Nave de Sirius";
	roda(so_enter);
	r = run_lobby_settings_form(c, null, true);
	confere("com nome lembrado, o campo traz ele (" + r.lobby_name + ")", r.lobby_name == "Nave de Sirius");
	g_settings.last_lobby_name = nome_antes;

	println("== botao de papeis ==");
	// nome, código, modo, predefinição, kill, jogadores, [mapa], impostores, neutros -> o botão de papéis.
	// O campo do mapa só existe com mais de um mapa (a 1.0 publicou a Base Polar): conta-se quando houver.
	int tabs_papeis = usable_map_ids().length() > 1 ? 9 : 8;
	array<int> ate_papeis;
	for (int i = 0; i < tabs_papeis; i++) ate_papeis.insert_last(KEY_TAB);
	// Enter no botão abre o menu dos TIMES; Enter no primeiro (tripulação) abre a tela dela; três Esc voltam.
	ate_papeis.insert_last(KEY_RETURN); ate_papeis.insert_last(KEY_RETURN);
	ate_papeis.insert_last(KEY_ESCAPE); ate_papeis.insert_last(KEY_ESCAPE); ate_papeis.insert_last(KEY_ESCAPE);
	roda(ate_papeis);
	run_lobby_settings_form(c, null, true);
	confere("o botao de papeis abre o menu dos times", falou(tr("lobby.roles_title")));
	confere("e o primeiro time abre a tela dos papeis da tripulacao", falou(tr("lobby.roles_team_title.crew") + " Dialog"));
	confere("e nao a de modificadores", !falou(tr("lobby.modifiers_title") + " Dialog"));
	// O teto de 50 controles do audio_form: cada tela de time e a de modificadores têm que caber com folga
	// (dois campos por papel, mais confirmar e cancelar, mais a regra da morte nos modificadores). Passando,
	// o confirmar não é criado e nada avisa - foi por isso que a tela foi dividida por time (1.1).
	array<string> times = {TEAM_CREW, TEAM_IMPOSTOR, TEAM_NEUTRAL};
	int maior = 0;
	for (uint t = 0; t < times.length(); t++) {
		int n = int(configurable_roles_of_team(times[t]).length()) * 2 + 2;
		if (n > maior) maior = n;
	}
	int mods = int(CONFIGURABLE_MODIFIER_IDS.length()) * 2 + 3;
	confere("cada tela de papeis cabe no audio_form (a maior: " + maior + " de 50; modificadores: " + mods + ")", maior <= 44 && mods <= 44);

	println("== tela de modificadores ==");
	// O controle seguinte é o botão de modificadores; a tela abre com a regra deles na morte (2026-10-17).
	array<int> ate_mods;
	for (int i = 0; i < tabs_papeis + 1; i++) ate_mods.insert_last(KEY_TAB);
	ate_mods.insert_last(KEY_RETURN); ate_mods.insert_last(KEY_ESCAPE); ate_mods.insert_last(KEY_ESCAPE);
	roda(ate_mods);
	run_lobby_settings_form(c, null, true);
	confere("o botao de modificadores abre a tela deles", falou(tr("lobby.modifiers_title") + " Dialog"));
	confere("e ela comeca pela regra dos modificadores na morte", falou(tr("lobby.death_modifiers_field")));

	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
