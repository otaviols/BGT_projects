// Sonda do menu "Aprender os sons do jogo": a lista não pode ficar para trás do catálogo.
//   nvgt tools/probes/probe_learn_sounds.nvgt
//
// A parte comum é escrita à mão e envelheceu calada: na 0.50.7 faltavam 28 sons e dois pisos (relato do
// usuário: "ele não está sendo atualizado"). Confere:
//   1. todo som do catálogo (all_sound_paths) está no menu, ou em LEARN_SOUNDS_LEFT_OUT com motivo,
//      ou é som de DENTRO de minijogo (sounds/tasks/ que nenhum item do menu usa - eles se aprendem
//      fazendo a tarefa, no treino);
//   2. todo arquivo que o menu toca existe no disco - um caminho errado fica mudo sem erro (foi a
//      armadilha do "sounds/" a mais).
// Cada item novo do catálogo que não for minijogo precisa entrar no menu ou na lista de fora.
#include "../../src/i18n.nvgt" // primeiro: as globais do game_settings leem o idioma (ver CLAUDE.md, ordem das globais)
#include "../../src/ui/onboarding_screens.nvgt"

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}

string valores(name_value_collection@ sfx) {
	string r;
	for (uint i = 0; i < sfx.size(); i++) r += sfx.value_at(i) + ";";
	return r;
}

void main() {
	if (!directory_exists("sounds")) chdir("..");
	if (!directory_exists("sounds")) chdir("..");
	g_i18n.load_language(DEFAULT_LANGUAGE);

	// O menu é por mapa: o catálogo tem que caber na UNIÃO dos menus de todos os mapas.
	array<string> mapas = MAP_IDS;
	for (uint i = 0; i < MAP_IDS_IN_TEST.length(); i++) mapas.insert_last(MAP_IDS_IN_TEST[i]);
	array<string> no_menu;
	array<string> rotulos_crus;
	for (uint m = 0; m < mapas.length(); m++) {
		name_value_collection@ sfx = learn_sounds_collection(build_map(mapas[m]));
		for (uint i = 0; i < sfx.size(); i++) {
			// Rótulo que sai cru (a chave no lugar do texto, ou o nome do piso): chave faltando.
			string nome = sfx.name_at(i);
			if (nome.find("learn.") >= 0 || nome.find("task.") >= 0 || nome.find("room.") >= 0 || nome.find("Tile") >= 0)
				rotulos_crus.insert_last(mapas[m] + ": " + nome);
			string[]@ partes = sfx.value_at(i).split(",");
			for (uint k = 0; k < partes.length(); k++) if (no_menu.find(partes[k]) < 0) no_menu.insert_last(partes[k]);
		}
		println("  " + mapas[m] + ": " + sfx.size() + " itens");
	}
	for (uint i = 0; i < rotulos_crus.length(); i++) println("     rotulo cru: " + rotulos_crus[i]);
	confere("nenhum rotulo sai cru", rotulos_crus.length() == 0);

	// Cada mapa mostra o que é dele: a nave não toca a neve, a Base Polar não toca a cafeteria.
	string nave = valores(learn_sounds_collection(build_map(MAP_THE_HUB)));
	string polar = valores(learn_sounds_collection(build_map(MAP_POLAR_BASE)));
	confere("a nave nao tem a neve nem a camara", nave.find("SnowTile") < 0 && nave.find("decontamination") < 0);
	confere("a Base Polar nao tem a cafeteria nem o zumbido da nave", polar.find(SND_AMBIENT_CAFETERIA) < 0 && polar.find(SND_SHIP_AMBIENCE) < 0);
	confere("e tem a neve, a camara e o sismografo", polar.find("SnowTile") >= 0 && polar.find(SND_DECONTAMINATION_SPRAY) >= 0 && polar.find(SND_PANEL_BEACON_SEISMIC) >= 0);

	array<string> sem_arquivo;
	for (uint i = 0; i < no_menu.length(); i++) if (!file_exists(no_menu[i])) sem_arquivo.insert_last(no_menu[i]);
	for (uint i = 0; i < sem_arquivo.length(); i++) println("     o menu toca, mas nao existe: " + sem_arquivo[i]);
	confere("todo som do menu existe no disco (" + no_menu.length() + " arquivos)", sem_arquivo.length() == 0);

	array<string>@ catalogo = all_sound_paths();
	array<string> faltam;
	for (uint i = 0; i < catalogo.length(); i++) {
		string s = catalogo[i];
		if (no_menu.find(s) >= 0 || LEARN_SOUNDS_LEFT_OUT.find(s) >= 0) continue;
		if (s.starts_with("sounds/tasks/")) continue; // de dentro de minijogo: aprende-se no treino
		faltam.insert_last(s);
	}
	for (uint i = 0; i < faltam.length(); i++) println("     falta no menu: " + faltam[i]);
	confere("todo som do catalogo esta no menu ou fora de proposito (" + catalogo.length() + " no catalogo)", faltam.length() == 0);

	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
