// Sonda dos comandos de administração das salas (2026-10-22): listar, e fechar só sem ninguém jogando.
//   AMONGUS_SERVER_HOST=127.0.0.1 AMONGUS_ADMIN_TOKEN=teste-local nvgt tools/probes/probe_admin_lobbies.nvgt
//
// Confere: a lista traz a sala com quem joga e os bots; fechar uma sala com gente jogando é recusado,
// dizendo quem está nela (o cliente só sabe sair de sala fechada estando na sala de espera); fechar um
// id que não existe diz isso; o token errado não lista nada.
#include "../../src/network/client.nvgt"
#include "../../src/config/game_constants.nvgt"
#include "../../src/config/server_address.nvgt"
#include "../../src/config/lobby_config.nvgt"

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}
net_packet@ wf(game_client@ c, const string&in t, int ms) {
	timer x;
	while (x.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == t) return p; @p = c.poll_message(); } wait(5); }
	return null;
}
game_client@ conecta(server_address addr) {
	game_client@ c = game_client();
	if (!c.connect_to(addr.host, addr.port)) return null;
	timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
	return c;
}

void main() {
	server_address addr = resolve_server_address();
	string token = read_environment_variable("AMONGUS_ADMIN_TOKEN", "");
	if (token == "") { println("sem AMONGUS_ADMIN_TOKEN"); return; }
	string sfx = "" + random(1000, 9999);
	game_client@ dono = conecta(addr);
	string nome = "adm" + sfx;
	dono.send_register(nome, "probe123"); wf(dono, S_REGISTER_RESULT, 3000);
	dono.send_login(nome, "probe123");
	net_packet@ lr = wf(dono, S_LOGIN_RESULT, 5000);
	if (@lr == null || !lr.get_bool("ok")) { println("login falhou"); return; }
	lobby_overrides ov;
	dono.send_create_lobby("salaadm" + sfx, "classic", ov);
	net_packet@ st = wf(dono, S_LOBBY_STATE, 5000);
	string id = st.get_string("lobby_id");
	dono.send_add_bot(); dono.send_add_bot();
	timer e; while (e.elapsed < 600) { dono.update(); wait(10); }

	game_client@ adm = conecta(addr);
	adm.send_admin_list_lobbies(token);
	net_packet@ lista = wf(adm, S_ADMIN_LOBBIES, 5000);
	json_object@ a_sala = null;
	json_array@ l = @lista != null ? lista.get_array("lobbies") : null;
	for (uint i = 0; @l != null && i < l.length(); i++) if (string(l.get_object(i)["id"]) == id) @a_sala = l.get_object(i);
	confere("a lista traz a sala, com quem joga e os bots", @a_sala != null && int(a_sala["playing"]) == 1 && int(a_sala["bots"]) == 2
		&& string(a_sala["people"]) == nome);

	adm.send_admin_close_lobby(token, id);
	net_packet@ r = wf(adm, S_ADMIN_RESULT, 5000);
	confere("com gente jogando, fechar e recusado, dizendo quem esta nela", @r != null && !r.get_bool("ok") && r.get_string("message").find(nome) >= 0);
	adm.send_admin_close_lobby(token, "nao-existe");
	@r = wf(adm, S_ADMIN_RESULT, 5000);
	confere("um id que nao existe e dito", @r != null && !r.get_bool("ok") && r.get_string("message").find("nao-existe") >= 0);
	adm.send_admin_list_lobbies("token-errado");
	confere("token errado: nada", @wf(adm, S_ADMIN_LOBBIES, 2000) == null);

	dono.disconnect(); adm.disconnect();
	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
