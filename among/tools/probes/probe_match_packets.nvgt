// Sonda do laço da partida do CLIENTE, mensagem por mensagem e sem servidor: monta uma match_session
// com um início de mentira e entrega a ela o que o servidor mandaria, conferindo o estado depois de
// cada uma.
//   nvgt tools/probes/probe_match_packets.nvgt
//
// É o que a divisão do laço em classe tornou possível: antes, o tratamento de cada mensagem morava no
// meio de uma função de 1350 linhas e só rodava com teclado e janela. Mensagem nova ou papel novo que
// mude o estado da partida: ponha o caso aqui. Muda (sem fala nem som).
#include "../../src/core/crash_log.nvgt"
#include "../../src/game/game_loop.nvgt"

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}
array<string> falado;
bool gravando = false;
string calado(const string&in text) { if (gravando) falado.insert_last(text); return ""; }

json_object@ jogador(uint64 peer, const string&in nome, float x, float y) {
	json_object@ o = json_object();
	o.set("peer_id", peer); o.set("name", nome); o.set("color", int(peer)); o.set("x", x); o.set("y", y);
	return o;
}

match_session@ nova_partida(const string&in papel, const string&in par = "", const string&in velocidade = "",
		const string&in mapa = "", float x = 0.0, float y = 0.0, bool visiveis = true, json_array@ tarefas = null,
		const string&in traco = "") {
	game_client@ c = game_client();
	@c.net = network();
	c.net.setup_client(MAX_PACKET_CHANNELS, 1);
	c.my_peer_id = 1;
	net_packet@ inicio = net_packet(S_GAME_START);
	inicio.set_uint64("your_peer_id", 1);
	inicio.set_string("your_role", papel);
	inicio.set_float("your_x", x);
	inicio.set_float("your_y", y);
	if (mapa != "") inicio.set_string("map_name", mapa);
	if (!visiveis) inicio.set_bool("visible_tasks", false);
	if (@tarefas != null) inicio.set_array("tasks", tarefas);
	inicio.set_float("kill_cooldown_seconds", 25.0);
	inicio.set_float("sabotage_cooldown_seconds", 10.0);
	json_array@ ps = json_array();
	ps.add(jogador(1, "eu", 0.0, 0.0));
	ps.add(jogador(2, "ana", 1.0, 0.0));
	ps.add(jogador(3, "bia", 2.0, 0.0));
	inicio.set_array("players", ps);
	if (par != "") inicio.set_string("lover_name", par);
	if (velocidade != "") inicio.set_string("speed_modifier", velocidade);
	if (traco != "") inicio.set_string("trait_modifier", traco);
	return match_session(c, inicio);
}

void main() {
	show_window("sonda: mensagens da partida");
	if (!directory_exists("lang")) chdir("..");
	if (!directory_exists("lang")) chdir("..");
	g_i18n.load_language(DEFAULT_LANGUAGE);
	@tts_default_text_processing_callback = calado;
	sound_master_volume = -100;
	string crash_antes = file_get_contents(crash_log_path());

	println("== tripulante ==");
	match_session@ p = nova_partida(ROLE_CREWMATE);
	confere("comeca vivo, andando, sem sabotagem", p.alive && !p.movement_frozen && p.active_sabotage_id == "");
	confere("o cartao do papel (tela para quem enxerga) fica marcado para os primeiros segundos", p.role_card_until > ticks());

	// Shift + habilidade / Shift + kill: só perguntam (recado #234). O texto diz "pronta" sem recarga e o
	// tempo com ela - e as duas respostas têm que ser diferentes, senão a pergunta não informa nada.
	p.my_ability_cooldown_remaining = 0.0;
	string hab_pronta = p.ability_cooldown_text();
	p.my_ability_cooldown_remaining = 12.4;
	string hab_recarga = p.ability_cooldown_text();
	confere("Shift + habilidade: pronta sem recarga, e o tempo com ela", hab_pronta == tr("role.ability_ready") && hab_recarga.find("12") >= 0 && hab_pronta != hab_recarga);
	p.my_kill_cooldown_remaining = 0.0;
	string kill_pronto = p.kill_cooldown_text();
	p.my_kill_cooldown_remaining = 7.6;
	confere("Shift + kill: pronto sem recarga, e o tempo com ela", kill_pronto == tr("game.kill_ready") && p.kill_cooldown_text().find("8") >= 0);
	p.my_ability_cooldown_remaining = 0.0;
	p.my_kill_cooldown_remaining = 0.0;

	// O scanner em uso: o modo gráfico desenha a varredura enquanto ela dura, e para quando ela acaba.
	map_object@ scanner = null;
	for (uint i = 0; i < p.map.objects.length() && @scanner == null; i++) if (p.map.objects[i].task_type == "submit_scan") @scanner = p.map.objects[i];
	net_packet@ vis = net_packet(S_TASK_VISIBLE);
	vis.set_uint64("peer_id", 2); vis.set_string("name", "ana"); vis.set_string("object_id", @scanner != null ? scanner.id : ""); vis.set_bool("active", true);
	p.handle_packet(vis);
	confere("scanner em uso: a tela sabe onde e quem", p.visible_spots.length() == 1 && p.visible_names[0] == "ana" && p.visible_spot_busy(scanner.id));
	// A arma dos asteroides, ao mesmo tempo, por outra pessoa (protocolo 14): as duas convivem.
	map_object@ arma = null;
	for (uint i = 0; i < p.map.objects.length() && @arma == null; i++) if (p.map.objects[i].task_type == "clear_asteroids") @arma = p.map.objects[i];
	net_packet@ vis2 = net_packet(S_TASK_VISIBLE);
	vis2.set_uint64("peer_id", 3); vis2.set_string("name", "bia"); vis2.set_string("object_id", arma.id); vis2.set_bool("active", true);
	p.handle_packet(vis2);
	confere("a arma e o scanner ao mesmo tempo", p.visible_spots.length() == 2 && p.visible_spot_busy(arma.id) && p.visible_spot_busy(scanner.id));
	net_packet@ fim_vis = net_packet(S_TASK_VISIBLE);
	fim_vis.set_uint64("peer_id", 2); fim_vis.set_bool("active", false);
	p.handle_packet(fim_vis);
	confere("o fim de um nao derruba o outro", p.visible_spots.length() == 1 && !p.visible_spot_busy(scanner.id) && p.visible_spot_busy(arma.id));
	net_packet@ fim_vis2 = net_packet(S_TASK_VISIBLE);
	fim_vis2.set_uint64("peer_id", 3); fim_vis2.set_string("object_id", arma.id); fim_vis2.set_bool("active", false);
	p.handle_packet(fim_vis2);
	confere("e quando acaba, some", p.visible_spots.length() == 0);

	// Quem morre continua ouvindo o marcador do PRÓPRIO corpo: a lista de corpos era refeita antes de o
	// corpo entrar nela, e o marcador sumia até outra coisa refazê-la.
	match_session@ morre = nova_partida(ROLE_CREWMATE);
	net_packet@ eu_morri = net_packet(S_PLAYER_KILLED);
	eu_morri.set_uint64("peer_id", 1); eu_morri.set_uint64("killer_peer", 2); eu_morri.set_float("x", 0.0); eu_morri.set_float("y", 0.0);
	morre.handle_packet(eu_morri);
	confere("morri: o meu corpo toca o marcador", !morre.alive && morre.audio.body_beacon_peers.find(1) >= 0);

	net_packet@ m = net_packet(S_PLAYER_MOVED);
	m.set_uint64("peer_id", 2); m.set_float("x", 4.0); m.set_float("y", 1.5);
	p.handle_packet(m);
	roster_entry@ ana = p.roster.find(2);
	confere("movimento de outro jogador atualiza o elenco", @ana != null && ana.x == 4.0 && ana.y == 1.5);

	// Passos por distância: um pacote perdido faz o seguinte trazer dois passos. Antes isso tocava um e
	// zerava, e ficava um vácuo na caminhada; agora o que sobra vai para o próximo.
	roster_entry@ bia = p.roster.find(3);
	bia.step_distance = 0.0;
	net_packet@ dois = net_packet(S_PLAYER_MOVED);
	dois.set_uint64("peer_id", 3); dois.set_float("x", bia.x + p.step_length * 2.0); dois.set_float("y", bia.y);
	p.handle_packet(dois);
	confere("dois passos num pacote so: um toca e o outro fica guardado", abs(bia.step_distance - p.step_length) < 0.001);
	net_packet@ pouco = net_packet(S_PLAYER_MOVED);
	pouco.set_uint64("peer_id", 3); pouco.set_float("x", bia.x + p.step_length * 0.1); pouco.set_float("y", bia.y);
	p.handle_packet(pouco);
	confere("e o guardado sai no pacote seguinte", bia.step_distance < p.step_length * 0.5);

	net_packet@ k = net_packet(S_PLAYER_KILLED);
	k.set_uint64("peer_id", 3); k.set_uint64("killer_peer", 2); k.set_float("x", 2.0); k.set_float("y", 0.0);
	p.handle_packet(k);
	confere("morte de outro: continuo vivo, o corpo passa a ser conhecido", p.alive && p.known_body_peers.length() == 1);

	// Lixeiro e carregador: o corpo some, e o largado reaparece no lugar novo.
	net_packet@ sumiu = net_packet(S_BODY_REMOVED);
	sumiu.set_uint64("peer_id", 3);
	p.handle_packet(sumiu);
	confere("corpo removido sai da lista de corpos", p.known_body_peers.length() == 0);
	net_packet@ largado = net_packet(S_BODY_PLACED);
	largado.set_uint64("peer_id", 3); largado.set_float("x", 9.0); largado.set_float("y", 4.0);
	p.handle_packet(largado);
	confere("corpo largado volta, no lugar novo", p.known_body_peers.length() == 1 && p.known_body_positions[0].x == 9.0);
	net_packet@ som = net_packet(S_BODY_SOUND);
	som.set_string("kind", "drag"); som.set_float("x", 9.0); som.set_float("y", 4.0);
	p.handle_packet(som);

	net_packet@ s = net_packet(S_SABOTAGE_STARTED);
	s.set_string("sabotage_id", "lights");
	p.handle_packet(s);
	confere("sabotagem comeca", p.active_sabotage_id == "lights");

	net_packet@ r = net_packet(S_MEETING_STARTED);
	r.set_float("gather_x", 7.0); r.set_float("gather_y", 3.0);
	p.handle_packet(r);
	confere("reuniao: parado, levado a mesa, corpos somem (inclusive o largado)",
		p.movement_frozen && p.my_x == 7.0 && p.my_y == 3.0 && p.known_body_peers.length() == 0);

	net_packet@ v = net_packet(S_VOTE_RESULT);
	v.set_uint64("ejected_peer", 0);
	v.set_string("swapped_a", "ana"); v.set_string("swapped_b", "bia"); // a troca do trocador, anunciada
	p.handle_packet(v);
	confere("fim da votacao: anda de novo, a sabotagem continua", !p.movement_frozen && p.active_sabotage_id == "lights");

	net_packet@ f = net_packet(S_SABOTAGE_FIXED);
	f.set_string("sabotage_id", "lights");
	p.handle_packet(f);
	confere("sabotagem consertada", p.active_sabotage_id == "");

	net_packet@ eu = net_packet(S_PLAYER_KILLED);
	eu.set_uint64("peer_id", 1); eu.set_uint64("killer_peer", 2); eu.set_float("x", 0.0); eu.set_float("y", 0.0);
	p.handle_packet(eu);
	confere("a propria morte: vira fantasma", !p.alive && !p.mui.alive);

	println("== voz guardada pela conta ==");
	// No modo cor o nome da partida é a cor, sorteada de novo a cada partida: volume e silêncio
	// guardados por ele caíam em outra pessoa na partida seguinte (relato do usuário). A conta vem da
	// sala de espera e atravessa o começo da partida.
	g_voice.remember_account(2, "conta_da_ana");
	match_session@ cor = nova_partida(ROLE_CREWMATE);
	confere("na partida, a voz mostra o nome de agora", g_voice.name_of(2) == "ana");
	confere("e guarda as preferencias pela conta", g_voice.settings_key_of(2) == "conta_da_ana");
	confere("sem conta conhecida, cai no nome de agora", g_voice.settings_key_of(3) == "bia");
	g_voice.leave();

	println("== impostor ==");
	match_session@ imp = nova_partida(ROLE_IMPOSTOR);
	imp.my_kill_cooldown_remaining = 0.0;
	net_packet@ meu = net_packet(S_PLAYER_KILLED);
	meu.set_uint64("peer_id", 2); meu.set_uint64("killer_peer", 1); meu.set_float("x", 1.0); meu.set_float("y", 0.0);
	imp.handle_packet(meu);
	confere("o proprio kill rearma a recarga", imp.my_kill_cooldown_remaining == 25.0);
	imp.my_kill_cooldown_remaining = 3.0;
	net_packet@ fim = net_packet(S_VOTE_RESULT);
	fim.set_uint64("ejected_peer", 0);
	imp.handle_packet(fim);
	confere("fim da votacao rearma a recarga de kill", imp.my_kill_cooldown_remaining == 25.0);
	// Matar o DOENTE: a recarga vem do servidor, e não é a da sala.
	imp.my_kill_cooldown_remaining = 0.0;
	net_packet@ doente = net_packet(S_PLAYER_KILLED);
	doente.set_uint64("peer_id", 3); doente.set_uint64("killer_peer", 1); doente.set_float("x", 2.0); doente.set_float("y", 0.0);
	doente.set_float("killer_cooldown", 50.0);
	imp.handle_packet(doente);
	confere("matar o doente: a recarga e a que o servidor mandou (" + imp.my_kill_cooldown_remaining + ")", imp.my_kill_cooldown_remaining == 50.0);

	println("== envenenador, veterano e transportador (cliente) ==");
	match_session@ en = nova_partida(ROLE_POISONER);
	en.my_kill_cooldown_remaining = 0.0;
	net_packet@ pd = net_packet(S_POISON_DONE);
	pd.set_uint64("killer_peer", 1); pd.set_string("name", "ana"); pd.set_float("killer_cooldown", 25.0);
	en.handle_packet(pd);
	confere("o veneno saiu: a recarga do kill comeca", en.my_kill_cooldown_remaining == 25.0);
	match_session@ ve = nova_partida(ROLE_VETERAN);
	net_packet@ ar = net_packet(S_ABILITY_RESULT);
	ar.set_string("ability", ABILITY_ALERT); ar.set_bool("ok", true); ar.set_float("cooldown_seconds", 30.0); ar.set_float("duration_seconds", 10.0);
	ve.handle_packet(ar);
	confere("o alerta ligado: a tecla sabe quanto falta", ve.my_alert_remaining == 10.0 && ve.my_ability_cooldown_remaining == 30.0);
	match_session@ tr2 = nova_partida(ROLE_CREWMATE);
	net_packet@ foi = net_packet(S_TRANSPORTED);
	foi.set_float("x", 7.5); foi.set_float("y", -3.0);
	tr2.handle_packet(foi);
	confere("transportado: a posicao e a que o servidor mandou", tr2.my_x == 7.5 && tr2.my_y == -3.0);

	println("== viciado e bebado (cliente) ==");
	match_session@ vi = nova_partida(ROLE_CREWMATE, "", "", "", 0.0, 0.0, true, null, MOD_ADDICT);
	uint historico = vi.events_log.lines.length();
	// Força trinta alucinações seguidas: cada uma sorteia morte, passos ou corpo.
	for (int k = 0; k < 30; k++) { vi.addict_next = 0.0; vi.addict_tick(0.01); }
	confere("o viciado alucina (corpos falsos: " + vi.addict_body_peers.length() + ", passos: " + vi.addict_step_at.length() + ")",
		vi.addict_body_peers.length() > 0 && vi.addict_step_at.length() > 0);
	confere("e nada disso entra no historico", vi.events_log.lines.length() == historico);
	confere("a proxima alucinacao fica para depois", vi.addict_next >= ADDICT_MIN_SECONDS);
	vi.my_x = vi.addict_body_x[0]; vi.my_y = vi.addict_body_y[0];
	uint antes = vi.addict_body_peers.length();
	vi.addict_forget_bodies_near();
	confere("indo reportar, o corpo falso some", vi.addict_body_peers.length() < antes);
	match_session@ sem_vicio = nova_partida(ROLE_CREWMATE);
	for (int k = 0; k < 30; k++) { sem_vicio.addict_next = 0.0; sem_vicio.addict_tick(0.01); }
	confere("controle: quem nao e viciado nao alucina", sem_vicio.addict_body_peers.length() == 0 && sem_vicio.addict_step_at.length() == 0);
	match_session@ be = nova_partida(ROLE_CREWMATE, "", "", "", 0.0, 0.0, true, null, MOD_DRUNK);
	confere("o bebado sabe que e bebado", be.trait_modifier_id == MOD_DRUNK && be.current_role_text().find(tr("role.drunk")) >= 0);

	println("== surdez da bomba (cliente) ==");
	g_settings.set_deafened(false);
	match_session@ sd = nova_partida(ROLE_CREWMATE);
	float geral_antes = sound_master_volume;
	net_packet@ surdo = net_packet(S_DEAFENED);
	surdo.set_float("seconds", 2.0);
	sd.handle_packet(surdo);
	confere("logo depois do estouro ainda se ouve (a explosao toca inteira o comeco)", !g_settings.deafened);
	sd.tick_timers(GRENADIER_DEAF_DELAY_SECONDS + 0.05);
	confere("um instante depois, surdo: o mundo cala (mixer em " + g_world_mixer.volume + " dB)", g_settings.deafened && g_world_mixer.volume <= -90.0);
	confere("o volume geral nao e mexido (o zumbido passa por ele)", sound_master_volume == geral_antes);
	confere("e o zumbido toca, fora do mixer do mundo", sd.audio.deaf_ringing.playing);
	sd.tick_timers(1.0);
	confere("ainda surdo no meio", g_settings.deafened);
	sd.tick_timers(1.2);
	confere("e volta a ouvir sozinho: mundo de volta, zumbido parado", !g_settings.deafened && g_world_mixer.volume == 0.0 && !sd.audio.deaf_ringing.playing);
	sd.handle_packet(surdo);
	sd.tick_timers(GRENADIER_DEAF_DELAY_SECONDS + 0.05);
	sd.movement_frozen = true; // a reunião começou
	sd.tick_timers(0.05);
	confere("a reuniao desfaz a surdez (a mesa precisa ouvir)", !g_settings.deafened);
	g_settings.set_deafened(false);

	println("== lanterninha ==");
	match_session@ lt = nova_partida(ROLE_CREWMATE, "", "", "", 0.0, 0.0, true, null, MOD_TORCH);
	match_session@ sem_lt = nova_partida(ROLE_CREWMATE);
	confere("o lanterninha e imune ao apagao, e o comum nao", !lights_out_for("lights", lt.my_role, true) && lights_out_for("lights", sem_lt.my_role, true));
	confere("a abertura e o Ctrl+habilidade falam do lanterninha", lt.trait_modifier_id == MOD_TORCH && lt.current_role_text().find(tr("role.torch")) >= 0);
	net_packet@ troca = net_packet(S_ROLE_CHANGED);
	troca.set_string("role_id", ROLE_JESTER);
	troca.set_string("reason", "executioner_target_lost");
	lt.handle_packet(troca);
	confere("trocar de papel nao tira o lanterninha", !lights_out_for("lights", lt.my_role, true));

	println("== barriga do lobo ==");
	match_session@ b = nova_partida(ROLE_CREWMATE, "ana", "flash");
	b.move_speed = b.room_move_speed * 1.5; // como o servidor manda para o Flash
	net_packet@ engole = net_packet(S_SWALLOWED);
	engole.set_uint64("wolf_peer", 2);
	b.handle_packet(engole);
	confere("engolido: fora da partida, dentro do lobo", b.swallowed && b.wolf_peer == 2 && !b.alive);
	net_packet@ solta = net_packet(S_BELLY_RELEASED);
	solta.set_float("x", 5.0); solta.set_float("y", 2.0);
	json_array@ voltaram = json_array();
	voltaram.add(1);
	solta.set_array("peers", voltaram);
	b.handle_packet(solta);
	confere("solto: de volta, vivo, onde o lobo estava", !b.swallowed && b.wolf_peer == 0 && b.alive);
	// Engolido não é morto: os modificadores ficam (relato do usuário, 2026-10-18 - saía sem eles).
	confere("e com os modificadores: Flash e o par continuam", b.speed_modifier_id == "flash" && b.lover_name_spoken != ""
		&& b.move_speed > b.room_move_speed);

	println("== revivido pelo medico ==");
	match_session@ rv = nova_partida(ROLE_CREWMATE);
	net_packet@ morri = net_packet(S_PLAYER_KILLED);
	morri.set_uint64("peer_id", 1); morri.set_uint64("killer_peer", 2); morri.set_float("x", 3.0); morri.set_float("y", 1.0);
	rv.handle_packet(morri);
	net_packet@ volta = net_packet(S_PLAYER_REVIVED);
	volta.set_uint64("peer_id", 1); volta.set_float("x", 3.0); volta.set_float("y", 1.0);
	rv.handle_packet(volta);
	confere("revivido: vivo de novo, onde caiu, sem o proprio corpo na lista", rv.alive && rv.mui.alive && rv.my_x == 3.0 && rv.known_body_peers.length() == 0);
	match_session@ outro = nova_partida(ROLE_CREWMATE);
	net_packet@ morreu2 = net_packet(S_PLAYER_KILLED);
	morreu2.set_uint64("peer_id", 2); morreu2.set_uint64("killer_peer", 3); morreu2.set_float("x", 1.0); morreu2.set_float("y", 0.0);
	outro.handle_packet(morreu2);
	net_packet@ volta2 = net_packet(S_PLAYER_REVIVED);
	volta2.set_uint64("peer_id", 2); volta2.set_float("x", 1.0); volta2.set_float("y", 0.0);
	outro.handle_packet(volta2);
	confere("outro revivido volta ao elenco, e o corpo dele sai", outro.roster.find(2).alive && outro.known_body_peers.length() == 0);

	println("== morte de amor ==");
	match_session@ ap = nova_partida(ROLE_CREWMATE);
	net_packet@ amor = net_packet(S_HEARTBREAK);
	amor.set_float("x", 2.0); amor.set_float("y", 0.0);
	ap.handle_packet(amor);
	confere("o par morreu: vira fantasma, e o proprio corpo fica onde caiu", !ap.alive && !ap.mui.alive && ap.known_body_peers.length() == 1);

	println("== amnesico que vira impostor ==");
	match_session@ am = nova_partida(ROLE_AMNESIAC);
	net_packet@ muda = net_packet(S_ROLE_CHANGED);
	muda.set_string("role_id", ROLE_IMPOSTOR);
	muda.set_string("reason", "remembered");
	muda.set_float("kill_cooldown_seconds", 25.0);
	json_array@ parceiros = json_array();
	json_object@ par = json_object(); par.set("peer_id", 3); par.set("name", "bia"); parceiros.add(par);
	muda.set_array("impostor_partners", parceiros);
	am.handle_packet(muda);
	confere("passa a jogar como impostor, com recarga de kill e o companheiro conhecido",
		am.my_role.id == ROLE_IMPOSTOR && am.is_impostor && am.mui.is_impostor && am.my_kill_cooldown_remaining == 25.0
		&& am.impostor_partner_peers.length() == 1 && am.impostor_partner_peers[0] == 3);

	// Ctrl + habilidade: o papel de AGORA, já com o companheiro novo (pedido do usuário).
	string papel_agora = am.current_role_text();
	confere("Ctrl + habilidade diz o papel atual, com o companheiro", papel_agora.find("bia") >= 0 && papel_agora == papel_agora.trim_whitespace());

	println("== abertura em duas etapas ==");
	// O papel sozinho na abertura; os modificadores numa entrada PRÓPRIA do histórico, e, para o
	// apaixonado, só depois do som de início E da batida de coração (pedido do usuário).
	match_session@ ab = nova_partida(ROLE_CREWMATE, "ana", MOD_FLASH);
	confere("a abertura diz o papel sem os modificadores", ab.events_log.lines.length() == 1
		&& ab.events_log.lines[0].text.find(tr("role.flash")) < 0);
	confere("e os modificadores ainda esperam (som de inicio, batida)", ab.opening_stage == 1);
	timer espera;
	while (ab.opening_stage != 0 && espera.elapsed < 15000) { ab.opening_tick(); wait(10); }
	println("     (som de inicio + batida: " + espera.elapsed + " ms)");
	confere("depois das duas, os modificadores chegam numa entrada propria",
		ab.events_log.lines.length() == 2 && ab.events_log.lines[1].text.find("ana") >= 0);
	match_session@ sem_par = nova_partida(ROLE_CREWMATE, "", MOD_GIANT);
	confere("sem par, os modificadores vem logo, sem batida", sem_par.opening_stage == 0 && sem_par.events_log.lines.length() == 2);
	string ctrl_h = ab.current_role_text();
	confere("Ctrl + habilidade: so os nomes (" + ctrl_h + ")", ctrl_h.find(tr("role.crewmate")) == 0
		&& ctrl_h.find(tr("role.flash")) >= 0 && ctrl_h.find("ana") >= 0 && ctrl_h.find(tr(ab.my_role.assignment_key())) < 0);

	println("== quem falta votar ==");
	match_session@ vt = nova_partida(ROLE_CREWMATE);
	net_packet@ reuniao = net_packet(S_MEETING_STARTED);
	reuniao.set_float("gather_x", 7.0); reuniao.set_float("gather_y", 3.0);
	vt.handle_packet(reuniao);
	net_packet@ votacao = net_packet(S_VOTING_STARTED);
	votacao.set_float("voting_time", 30.0);
	vt.handle_packet(votacao);
	net_packet@ votou = net_packet(S_VOTE_CAST);
	votou.set_uint64("voter_peer", 2); votou.set_string("voter_name", "ana");
	vt.handle_packet(votou);
	string faltam = vt.mui.missing_voters_text();
	confere("a tecla de tempo diz quem falta: eu e a bia, nao a ana (" + faltam + ")",
		faltam.find("bia") >= 0 && faltam.find("ana") < 0 && faltam.find(tr("game.vote_missing_you")) >= 0);
	net_packet@ eu_votei = net_packet(S_VOTE_CAST);
	eu_votei.set_uint64("voter_peer", 1); eu_votei.set_string("voter_name", "eu");
	vt.handle_packet(eu_votei);
	net_packet@ bia_votou = net_packet(S_VOTE_CAST);
	bia_votou.set_uint64("voter_peer", 3); bia_votou.set_string("voter_name", "bia");
	vt.handle_packet(bia_votou);
	confere("e quando todos votaram, diz isso", vt.mui.missing_voters_text() == tr("game.vote_missing_none"));

	println("== voltar a partida depois de cair ==");
	// O S_GAME_START de volta (server_rejoin.nvgt): o estado de AGORA, e não o do começo.
	game_client@ cv = game_client();
	@cv.net = network();
	cv.net.setup_client(MAX_PACKET_CHANNELS, 1);
	cv.my_peer_id = 1;
	net_packet@ inicio_volta = net_packet(S_GAME_START);
	inicio_volta.set_uint64("your_peer_id", 1);
	inicio_volta.set_string("your_role", ROLE_IMPOSTOR);
	inicio_volta.set_float("your_x", 5.0);
	inicio_volta.set_float("your_y", 4.0);
	inicio_volta.set_float("kill_cooldown_seconds", 25.0);
	inicio_volta.set_float("sabotage_cooldown_seconds", 10.0);
	inicio_volta.set_bool("rejoin", true);
	inicio_volta.set_bool("alive", false);
	inicio_volta.set_float("kill_cooldown_remaining", 4.0);
	json_array@ elenco = json_array();
	json_object@ eu_morto = jogador(1, "eu", 5.0, 4.0); eu_morto.set("alive", false); elenco.add(eu_morto);
	json_object@ ana_viva = jogador(2, "ana", 1.0, 0.0); ana_viva.set("alive", true); elenco.add(ana_viva);
	json_object@ bia_morta = jogador(3, "bia", 2.0, 0.0); bia_morta.set("alive", false); elenco.add(bia_morta);
	inicio_volta.set_array("players", elenco);
	match_session pv(cv, inicio_volta);
	confere("volta marcada como volta", pv.rejoining);
	confere("quem morreu fora volta morto (e sem votar)", !pv.alive && !pv.mui.alive);
	confere("o elenco sabe quem ja morreu (bia) e quem nao (ana)", !pv.roster.find(3).alive && pv.roster.find(2).alive);
	confere("a recarga do kill e a de agora, nao a cheia", pv.my_kill_cooldown_remaining == 4.0);
	confere("e a posicao e a de agora", pv.my_x == 5.0 && pv.my_y == 4.0);
	// O resto da partida chega pelos pacotes de sempre, logo atrás.
	net_packet@ corpo_volta = net_packet(S_BODY_PLACED);
	corpo_volta.set_uint64("peer_id", 3); corpo_volta.set_float("x", 2.0); corpo_volta.set_float("y", 0.0);
	pv.handle_packet(corpo_volta);
	confere("o corpo que ja estava la", pv.known_body_peers.find(3) >= 0);
	net_packet@ sab_volta = net_packet(S_SABOTAGE_STARTED);
	sab_volta.set_string("sabotage_id", "lights"); sab_volta.set_float("timer", 0.0);
	pv.handle_packet(sab_volta);
	confere("e a sabotagem em andamento", pv.active_sabotage_id == "lights");
	// O controle: um começo comum, sem os campos de volta.
	match_session@ comum = nova_partida(ROLE_IMPOSTOR);
	confere("controle: o comeco comum nasce vivo, com a recarga cheia, e nao e volta",
		comum.alive && comum.my_kill_cooldown_remaining == 25.0 && !comum.rejoining);

	println("== cair da partida cala o que ela deixou tocando ==");
	// Relato do usuário (2026-10-14): quem caía seguia ouvindo o alarme de sabotagem. O cliente desta sonda
	// nunca conecta, então o primeiro quadro já vê a conexão caída - é o caminho da queda de verdade.
	match_session@ caiu = nova_partida(ROLE_CREWMATE);
	net_packet@ sab_caiu = net_packet(S_SABOTAGE_STARTED);
	sab_caiu.set_string("sabotage_id", "oxygen"); sab_caiu.set_float("timer", 40.0);
	caiu.handle_packet(sab_caiu);
	int slot_alarme = caiu.audio.ambient_sabotage_slot;
	confere("controle: com a sabotagem, o alarme esta tocando", slot_alarme != -1 && caiu.audio.spatial.is_playing(slot_alarme));
	bool seguiu = caiu.frame();
	confere("o quadro percebe a queda e para a partida", !seguiu && caiu.abandoned && g_match_connection_lost);
	confere("e o alarme parou", caiu.audio.ambient_sabotage_slot == -1 && !caiu.audio.spatial.is_playing(slot_alarme));
	confere("e a ambiencia da nave tambem", caiu.audio.ambient_ship_slot == -1);
	g_match_connection_lost = false;

	println("== votos com o menu de votacao aberto ==");
	// O menu segura o laço da partida; o voto tem que ser DITO pela via das telas bloqueantes (e marcado,
	// para o laço não repetir), e quem votou tem que entrar na mesa já (pedido do usuário, 2026-10-16).
	match_session@ mesa = nova_partida(ROLE_CREWMATE);
	net_packet@ voto = net_packet(S_VOTE_CAST);
	voto.set_uint64("voter_peer", 2); voto.set_string("voter_name", "ana");
	voto.set_bool("target_revealed", true); voto.set_string("target_name", "bia");
	mesa.client.incoming.insert_last(voto);
	@g_vote_pump_client = mesa.client;
	@g_vote_pump_ui = mesa.mui;
	g_vote_pump_seen = 0;
	pump_client_during_vote_menu(null, "");
	dictionary@ vp = dictionary(); vp.set("voter", "ana"); vp.set("target", "bia");
	confere("o voto e dito com o menu aberto", voto.announced && vote_cast_text(voto) == tr("game.vote_cast", vp));
	confere("e quem votou ja esta na mesa", mesa.mui.voted_peers.find(2) >= 0);
	// No histórico JÁ, com o menu aberto: ponto e vírgula funcionam ali dentro (pedido do usuário).
	uint linhas_antes = mesa.events_log.lines.length();
	confere("o voto entra no historico na chegada, nao ao fechar o menu", linhas_antes > 0
		&& mesa.events_log.move_last().find("ana") >= 0);
	// O menu fecha e o laço trata o pacote: nada repetido no histórico.
	mesa.client.incoming.resize(0);
	@g_logging_packet = voto; // como o frame() faz antes de cada pacote (é o que evita a linha repetida)
	mesa.handle_packet(voto);
	@g_logging_packet = null;
	confere("ao fechar o menu o voto nao entra de novo", mesa.events_log.lines.length() == linhas_antes);
	@g_vote_pump_client = null; @g_vote_pump_ui = null;

	println("== nas cameras nao se anda ==");
	// Relato do usuário: no posto de câmeras dava para andar. A tecla de andar segurada, com e sem câmera.
	match_session@ cam = nova_partida(ROLE_CREWMATE);
	int tecla_norte = g_keys.key(ACTION_MOVE_NORTH);
	cam.cameras.active = true;
	float y_antes = cam.my_y;
	simulate_key_down(tecla_norte);
	cam.move(0.2);
	simulate_key_up(tecla_norte);
	confere("com a camera ligada, segurar a tecla de andar nao move", cam.my_y == y_antes);
	cam.cameras.active = false;
	simulate_key_down(tecla_norte);
	cam.move(0.2);
	simulate_key_up(tecla_norte);
	confere("controle: sem a camera, a mesma tecla anda", cam.my_y < y_antes);

	println("== a morte tira os modificadores (cliente) ==");
	// O servidor passa a aceitar só a velocidade da sala de quem morre: o cliente tem que acompanhar.
	match_session@ flash = nova_partida(ROLE_CREWMATE, "ana", "flash");
	flash.move_speed = flash.room_move_speed * 1.5; // como o servidor manda para o Flash
	net_packet@ morte_flash = net_packet(S_PLAYER_KILLED);
	morte_flash.set_uint64("peer_id", 1); morte_flash.set_uint64("killer_peer", 2); morte_flash.set_float("x", 0.0); morte_flash.set_float("y", 0.0);
	flash.handle_packet(morte_flash);
	confere("morto: volta a velocidade da sala (" + flash.move_speed + ")", flash.move_speed == flash.room_move_speed);
	confere("e o Ctrl+habilidade nao diz mais Flash nem o par", flash.speed_modifier_id == "" && flash.lover_name_spoken == ""
		&& flash.current_role_text().find("ana") < 0);

	// Regra antiga da sala: os modificadores ficam, e o cliente não pode tirar a velocidade sozinho.
	match_session@ antigo = nova_partida(ROLE_CREWMATE, "ana", "flash");
	antigo.death_removes_modifiers = false;
	antigo.move_speed = antigo.room_move_speed * 1.5;
	net_packet@ morte_antiga = net_packet(S_PLAYER_KILLED);
	morte_antiga.set_uint64("peer_id", 1); morte_antiga.set_uint64("killer_peer", 2); morte_antiga.set_float("x", 0.0); morte_antiga.set_float("y", 0.0);
	antigo.handle_packet(morte_antiga);
	confere("regra antiga: morto, continua Flash e com o par", antigo.move_speed > antigo.room_move_speed
		&& antigo.speed_modifier_id == "flash" && antigo.lover_name_spoken != "");

	println("== recarga das portas ==");
	// O F diz a recarga como a sabotagem: o cliente a recebe em cada S_DOORS_STATE (pedido do usuário).
	match_session@ portas = nova_partida(ROLE_IMPOSTOR);
	confere("comeca sem recarga de portas", portas.my_doors_cooldown_remaining == 0.0);
	net_packet@ fechou = net_packet(S_DOORS_STATE);
	json_array@ zonas = json_array(); zonas.add("cafeteria");
	fechou.set_bool("closed", true); fechou.set_array("zones", zonas); fechou.set_float("doors_cooldown", 25.0);
	portas.handle_packet(fechou);
	confere("portas trancadas: a recarga vem do servidor (" + portas.my_doors_cooldown_remaining + ")", portas.my_doors_cooldown_remaining == 25.0);
	portas.tick_timers(0.1);
	confere("e desconta com o tempo", portas.my_doors_cooldown_remaining < 25.0 && portas.my_doors_cooldown_remaining > 24.0);

	println("== a camara de descontaminacao (Base Polar) ==");
	// Dentro da câmara quando ela tranca: o jogo diz POR QUE está preso (e não "portas trancadas", que
	// faria pensar no impostor), e ela abre pelo pacote de sempre.
	match_session@ camara = nova_partida(ROLE_CREWMATE, "", "", MAP_POLAR_BASE, 44.0, -4.5);
	net_packet@ tranca = net_packet(S_DOORS_STATE);
	json_array@ zc = json_array(); zc.add("decontamination");
	tranca.set_bool("closed", true); tranca.set_array("zones", zc); tranca.set_bool("decontamination", true);
	falado.resize(0);
	gravando = true;
	camara.handle_packet(tranca);
	gravando = false;
	confere("tranca a camara no cliente", camara.map.is_door_closed("decontamination"));
	confere("quem esta dentro ouve a descontaminacao, e nao 'portas trancadas'",
		falado.find(tr("game.decontamination")) >= 0 && falado.find(tr("game.doors_closed")) < 0);
	net_packet@ abre = net_packet(S_DOORS_STATE);
	abre.set_bool("closed", false); abre.set_array("zones", zc);
	camara.handle_packet(abre);
	confere("e abre pelo pacote de sempre", !camara.map.is_door_closed("decontamination"));

	println("== tarefas visiveis da sala ==");
	// O exame diz "quem estiver por perto ouve" só se a sala deixa (o S_GAME_START traz a regra).
	nova_partida(ROLE_CREWMATE);
	confere("por padrao, as tarefas visiveis estao ligadas", g_room_visible_tasks);
	nova_partida(ROLE_CREWMATE, "", "", "", 0.0, 0.0, false);
	confere("desligadas na sala: o exame sabe", !g_room_visible_tasks);
	g_room_visible_tasks = true;

	println("== contaminacao ==");
	// Quem sarou ouve que sarou; e todos ouvem quantos da tripulação faltam.
	match_session@ contam_sessao = nova_partida(ROLE_CREWMATE, "", "", MAP_POLAR_BASE, 44.0, -4.5);
	net_packet@ contam_cura = net_packet(S_DECONTAMINATED);
	contam_cura.set_uint64("peer_id", 1);
	contam_cura.set_int("left", 2);
	falado.resize(0);
	gravando = true;
	contam_sessao.handle_packet(contam_cura);
	net_packet@ contam_outro = net_packet(S_DECONTAMINATED);
	contam_outro.set_uint64("peer_id", 2);
	contam_outro.set_int("left", 1);
	contam_sessao.handle_packet(contam_outro);
	gravando = false;
	dictionary@ faltam_dois = dictionary(); faltam_dois.set("count", "2");
	dictionary@ faltam_um = dictionary(); faltam_um.set("count", "1");
	confere("quem sarou ouve que sarou, e quantos faltam", falado.length() >= 1 && falado[0].find(tr("contamination.you_cured")) >= 0 && falado[0].find(tr("contamination.left", faltam_dois)) >= 0);
	confere("os outros ouvem so quantos faltam", falado.length() >= 2 && falado[1] == tr("contamination.left", faltam_um));
	net_packet@ contam_tosse = net_packet(S_COUGH);
	contam_tosse.set_uint64("peer_id", 2); contam_tosse.set_float("x", 40.0); contam_tosse.set_float("y", -4.0);
	contam_sessao.handle_packet(contam_tosse);
	confere("a tosse chega sem excecao", true);

	println("== dois nos do clima, um painel ==");
	// Duas correntes do nó do clima acabam no MESMO painel do laboratório. Concluir uma não pode marcar as
	// duas (teste com amigos, 2026-10-20: a segunda ficava impossível de fazer).
	json_array@ duas = json_array();
	for (int n = 0; n < 2; n++) {
		json_object@ t = json_object();
		t.set("object_id", "task_weather_switch");
		t.set("task_type", "fix_weather_node");
		t.set("phase", 1);
		t.set("phase_count", 2);
		t.set("completed", false);
		json_array@ corrente = json_array();
		corrente.add(n == 0 ? "task_weather_dropship" : "task_weather_west");
		corrente.add("task_weather_switch");
		t.set("chain", corrente);
		duas.add(t);
	}
	match_session@ clima = nova_partida(ROLE_CREWMATE, "", "", MAP_POLAR_BASE, 48.0, -26.0, true, duas);
	mark_task_completed_locally(clima.map, clima.audio, clima.my_tasks, clima.my_task_object_ids, "task_weather_switch",
		clima.active_sabotage_id, clima.my_role, clima.alive);
	int pendentes = 0;
	for (uint i = 0; i < clima.my_tasks.length(); i++) if (!clima.my_tasks[i].completed) pendentes++;
	confere("concluir uma no painel deixa a outra pendente (" + pendentes + ")", pendentes == 1);
	mark_task_completed_locally(clima.map, clima.audio, clima.my_tasks, clima.my_task_object_ids, "task_weather_switch",
		clima.active_sabotage_id, clima.my_role, clima.alive);
	pendentes = 0;
	for (uint i = 0; i < clima.my_tasks.length(); i++) if (!clima.my_tasks[i].completed) pendentes++;
	confere("e a segunda conclui a outra", pendentes == 0);

	println("== incendiario: quem falta ==");
	match_session@ fogo = nova_partida(ROLE_ARSONIST);
	dictionary@ todos_p = dictionary(); todos_p.set("names", "ana, bia");
	confere("antes de encharcar: faltam todos os vivos", fogo.current_role_text().find(tr("role.douse_left", todos_p)) >= 0);
	net_packet@ encharcou = net_packet(S_ABILITY_RESULT);
	json_array@ ja = json_array(); ja.add(uint64(2));
	encharcou.set_string("ability", ABILITY_DOUSE); encharcou.set_bool("ok", true); encharcou.set_array("doused", ja);
	fogo.handle_packet(encharcou);
	dictionary@ so_bia = dictionary(); so_bia.set("names", "bia");
	confere("encharcou ana: falta so bia (" + fogo.current_role_text() + ")", fogo.current_role_text().find(tr("role.douse_left", so_bia)) >= 0);
	net_packet@ morreu = net_packet(S_PLAYER_KILLED);
	morreu.set_uint64("peer_id", 3); morreu.set_float("x", 2.0); morreu.set_float("y", 0.0);
	fogo.handle_packet(morreu);
	confere("bia morreu: nao falta ninguem", fogo.current_role_text().find(tr("role.douse_none_left")) >= 0);

	println("== dicas desligadas ==");
	// A abertura fica com o que é INFORMAÇÃO (o nome do papel, quantos impostores, o par) e perde a
	// explicação; ligadas, a explicação volta. Sem mexer no arquivo de preferências: só o campo.
	bool dicas_antes = g_settings.game_hints;
	g_settings.game_hints = false;
	match_session@ curta = nova_partida(ROLE_SHERIFF, "ana", "flash");
	dictionary@ rp = dictionary();
	rp.set("role", tr(role_for(ROLE_SHERIFF).name_key()));
	confere("sem dicas: o papel vem pelo nome (" + curta.role_text + ")", curta.role_text.find(tr("role.your_role", rp)) >= 0);
	confere("e sem a explicacao do xerife", curta.role_text.find(tr("role.assigned_sheriff")) < 0);
	confere("o par vem curto, mas vem", curta.opening_modifiers_text.find("ana") >= 0 && curta.opening_modifiers_text.find(tr("modifier.assigned_lovers").substr(0, 12)) < 0);
	g_settings.game_hints = true;
	match_session@ longa = nova_partida(ROLE_SHERIFF);
	confere("com dicas: a explicacao do papel volta", longa.role_text.find(tr("role.assigned_sheriff")) >= 0);
	g_settings.game_hints = dicas_antes;

	confere("nenhuma excecao (crash.log intocado)", file_get_contents(crash_log_path()) == crash_antes);
	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
