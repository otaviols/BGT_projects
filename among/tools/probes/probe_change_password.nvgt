// Sonda de "Trocar a senha" (recado #239).
//   AMONGUS_SERVER_HOST=127.0.0.1 nvgt tools/probes/probe_change_password.nvgt
//
// Confere, contra o servidor: senha atual errada NÃO troca; senha nova curta NÃO troca (o servidor
// confere de novo - o cliente também, mas o valor vem da máquina do jogador); certa troca. Depois: a
// senha velha não entra e a nova entra; o token lembrado ANTES da troca não entra mais (trocar é o que
// se faz para expulsar alguém - e é por ele que se confere o "outro computador": a mesma conta não fica
// aberta em dois lugares ao mesmo tempo, então quem prova que o outro foi expulso é o token dele parar de
// entrar); e quem lembrava a conta recebeu um token novo, que entra. O CONTROLE de cada "não entra" é o
// "entra" logo ao lado.
#include "../../src/network/client.nvgt"
#include "../../src/config/game_constants.nvgt"
#include "../../src/config/server_address.nvgt"

net_packet@ wf(game_client@ c, const string&in t, int ms) {
	timer x;
	while (x.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == t) return p; @p = c.poll_message(); } wait(5); }
	return null;
}

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}

game_client@ conecta(server_address@ addr) {
	game_client c;
	if (!c.connect_to(addr.host, addr.port)) return null;
	timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
	return c;
}
string msg(net_packet@ p) { return @p != null ? p.get_string("message") : "sem resposta"; }

void main() {
	server_address addr = resolve_server_address();
	string nome = "senha" + random(10000, 99999);
	game_client@ c = conecta(addr);
	if (@c == null) { println("connect falhou"); return; }
	c.send_register(nome, "senha123");
	confere("cadastro", @wf(c, S_REGISTER_RESULT, 3000) != null);
	c.send_login(nome, "senha123", true);
	net_packet@ lr = wf(c, S_LOGIN_RESULT, 5000);
	string token_velho = @lr != null ? lr.get_string("session_token") : "";
	confere("login com lembrar de mim devolve token", token_velho != "");

	// A mesma conta aberta em outro lugar (o "alguém mais sabe a senha").
	game_client@ outro = conecta(addr);
	outro.send_login_token(token_velho);
	net_packet@ lo = wf(outro, S_LOGIN_RESULT, 5000);
	confere("controle: a outra conexao entrou pelo token", @lo != null && lo.get_bool("ok"));
	// A entrada do outro derruba ESTA (uma conta, uma sessão): entra de novo, com senha.
	c.disconnect();
	@c = conecta(addr);
	c.send_login(nome, "senha123", true);
	lr = wf(c, S_LOGIN_RESULT, 5000);
	confere("controle: de volta, com senha", @lr != null && lr.get_bool("ok"));
	// E o outro abre de novo, para ser derrubado pela troca.
	outro.disconnect();
	@outro = conecta(addr);
	outro.send_login(nome, "senha123");
	wf(outro, S_LOGIN_RESULT, 5000);
	c.disconnect();
	@c = conecta(addr);
	c.send_login(nome, "senha123", true);
	lr = wf(c, S_LOGIN_RESULT, 5000);
	string token_atual = @lr != null ? lr.get_string("session_token") : "";

	c.send_change_password("errada", "novasenha1", true);
	net_packet@ r1 = wf(c, S_CHANGE_PASSWORD_RESULT, 5000);
	confere("senha atual errada NAO troca (" + msg(r1) + ")", @r1 != null && !r1.get_bool("ok") && msg(r1) == "account.password_wrong_current");

	c.send_change_password("senha123", "abc", true);
	net_packet@ r2 = wf(c, S_CHANGE_PASSWORD_RESULT, 5000);
	confere("senha nova curta NAO troca (" + msg(r2) + ")", @r2 != null && !r2.get_bool("ok") && msg(r2) == "account.password_too_short");

	// O outro, logado de novo pela senha, tem que cair com a troca.
	outro.disconnect();
	@outro = conecta(addr);
	outro.send_login_token(token_atual);
	net_packet@ lo2 = wf(outro, S_LOGIN_RESULT, 5000);
	c.disconnect();
	@c = conecta(addr);
	c.send_login(nome, "senha123", true);
	lr = wf(c, S_LOGIN_RESULT, 5000);
	// Agora `outro` caiu pela entrada de `c` (uma conta, uma sessão). Para testar a queda PELA TROCA, a
	// conta tem que estar aberta em dois lugares ao mesmo tempo - o que o servidor não deixa. Então a
	// queda pela troca é conferida pelo token: o do outro computador para de entrar.
	string token_do_outro = token_atual;

	c.send_change_password("senha123", "novasenha1", true);
	net_packet@ r3 = wf(c, S_CHANGE_PASSWORD_RESULT, 5000);
	confere("senha certa troca (" + msg(r3) + ")", @r3 != null && r3.get_bool("ok"));
	string token_novo = @r3 != null ? r3.get_string("session_token") : "";
	confere("quem lembrava a conta recebe um token novo", token_novo != "" && token_novo != token_velho);
	c.disconnect();

	@c = conecta(addr);
	c.send_login(nome, "senha123");
	net_packet@ l1 = wf(c, S_LOGIN_RESULT, 5000);
	confere("a senha velha nao entra mais", @l1 != null && !l1.get_bool("ok"));
	c.send_login(nome, "novasenha1");
	net_packet@ l2 = wf(c, S_LOGIN_RESULT, 5000);
	confere("a senha nova entra", @l2 != null && l2.get_bool("ok"));
	c.disconnect();

	@c = conecta(addr);
	c.send_login_token(token_do_outro);
	net_packet@ l3 = wf(c, S_LOGIN_RESULT, 5000);
	confere("o token lembrado em outro computador nao entra mais", @l3 != null && !l3.get_bool("ok"));
	c.send_login_token(token_novo);
	net_packet@ l4 = wf(c, S_LOGIN_RESULT, 5000);
	confere("o token novo entra", @l4 != null && l4.get_bool("ok"));
	c.disconnect();
	outro.disconnect();

	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
