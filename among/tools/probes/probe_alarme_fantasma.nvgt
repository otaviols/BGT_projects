// Sonda do recado #96: o fantasma continuava ouvindo o alarme depois de uma reunião.
//
// O alarme era ligado em três lugares (o início da sabotagem, a volta da reunião e nada o desligava
// na morte), e cada caminho esquecia um deles. Agora ele tem um dono só - apply_sabotage_effects -,
// que é reavaliado no começo da sabotagem, no conserto, na morte e na volta da reunião.
//
// A sonda chama a função de verdade e olha o slot do alarme: -1 é calado.
//   nvgt tools/probes/probe_alarme_fantasma.nvgt
#include "../../src/core/crash_log.nvgt"
#include "../../src/game/game_loop.nvgt"

void caso(const string&in o_que, bool tocando, bool esperado) {
	println((tocando == esperado ? "ok   " : "FALHA ") + o_que + ": alarme " + (tocando ? "TOCANDO" : "calado")
		+ " (esperado " + (esperado ? "tocando" : "calado") + ")");
}

void main() {
	show_window("sonda do alarme");
	if (!directory_exists("lang")) chdir("..");
	if (!directory_exists("lang")) chdir("..");
	g_i18n.load_language(DEFAULT_LANGUAGE);

	audio_manager@ audio = audio_manager();
	game_map@ map = build_the_hub_map();
	client_roster@ roster = client_roster();
	chat_log@ eventos = chat_log();
	game_client c;
	meeting_ui@ mui = meeting_ui(c, audio, roster, eventos, false);
	array<string> minhas_tasks;
	array<uint64> corpos;
	array<vector> pontos;
	role_traits@ tripulante = role_crewmate();

	// vivo, com sabotagem de pé: o alarme toca
	apply_sabotage_effects(audio, mui, map, minhas_tasks, "lights", tripulante, true, corpos, pontos);
	caso("vivo, sabotagem de pe", audio.ambient_sabotage_slot != -1, true);

	// ele morre no meio da sabotagem (o caminho que ninguem desligava)
	apply_sabotage_effects(audio, mui, map, minhas_tasks, "lights", tripulante, false, corpos, pontos);
	caso("morreu durante a sabotagem", audio.ambient_sabotage_slot != -1, false);

	// a reuniao acaba e a sabotagem continua: para o fantasma tem que continuar calado (recado #96)
	apply_sabotage_effects(audio, mui, map, minhas_tasks, "lights", tripulante, false, corpos, pontos);
	caso("fantasma, depois da reuniao", audio.ambient_sabotage_slot != -1, false);

	// e para quem esta vivo, a reuniao devolve o alarme
	apply_sabotage_effects(audio, mui, map, minhas_tasks, "lights", tripulante, true, corpos, pontos);
	caso("vivo, depois da reuniao", audio.ambient_sabotage_slot != -1, true);

	// consertada: calado para todo mundo
	apply_sabotage_effects(audio, mui, map, minhas_tasks, "", tripulante, true, corpos, pontos);
	caso("sabotagem consertada", audio.ambient_sabotage_slot != -1, false);
}
