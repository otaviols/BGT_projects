// Sonda: a partida acaba com alguém nas câmeras - o posto tem que fechar JUNTO.
//   AMONGUS_SERVER_HOST=127.0.0.1 nvgt tools/probes/probe_camera_game_over.nvgt
//
// Três jogadores: o impostor mata um tripulante e a partida acaba por MAIORIA, sem reunião - a
// reunião já fechava as câmeras e esconderia o defeito. O terceiro está nas câmeras quando isso
// acontece. Ele tem que receber S_CAMERA_STATE (active=false) ANTES do S_GAME_OVER, e os outros o
// S_CAMERA_WATCHING vazio: antes o posto só era liberado ao reabrir a sala, sem aviso, e quem estava
// nas câmeras continuava nelas na tela de resultado.
//
// Contra um servidor anterior à correção, esta sonda FALHA - é assim que se sabe que ela mede o
// defeito, e não passa por outro motivo.
#include "../../src/network/client.nvgt"
#include "../../src/config/game_constants.nvgt"
#include "../../src/config/server_address.nvgt"
#include "../../src/config/lobby_config.nvgt"

net_packet@ wf(game_client@ c, const string&in t, int ms) {
	timer x;
	while (x.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == t) return p; @p = c.poll_message(); } wait(5); }
	return null;
}
void bombeia(array<game_client@>@ todos, int ms) {
	timer t;
	while (t.elapsed < ms) { for (uint i = 0; i < todos.length(); i++) todos[i].update(); wait(10); }
}
const float PASSO_MS = 100.0;
const float PASSO_DIST = PLAYER_MOVE_SPEED * (PASSO_MS / 1000.0) * 0.8;
void anda_ate(array<game_client@>@ todos, game_client@ c, float de_x, float de_y, float ate_x, float ate_y) {
	float dist = distance_2d(de_x, de_y, ate_x, ate_y);
	int passos = int(dist / PASSO_DIST) + 1;
	for (int i = 1; i <= passos; i++) {
		float t = float(i) / float(passos);
		c.send_move(de_x + (ate_x - de_x) * t, de_y + (ate_y - de_y) * t);
		bombeia(todos, int(PASSO_MS));
	}
}

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}

void main() {
	server_address addr = resolve_server_address();
	string sfx = "" + random(1000, 9999);
	array<game_client@> todos;
	for (int i = 0; i < 3; i++) {
		game_client c;
		if (!c.connect_to(addr.host, addr.port)) { println("connect falhou"); return; }
		timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
		string nome = "cg" + i + sfx;
		c.send_register(nome, "probe123"); wf(c, S_REGISTER_RESULT, 3000);
		c.send_login(nome, "probe123");
		net_packet@ lr = wf(c, S_LOGIN_RESULT, 5000);
		if (@lr == null || !lr.get_bool("ok")) { println("login falhou"); return; }
		c.my_peer_id = lr.get_uint64("peer_id");
		todos.insert_last(c);
	}
	lobby_overrides ov;
	ov.impostor_count = 1;
	ov.kill_cooldown_seconds = 5.0;
	todos[0].send_create_lobby("cameras", "classic", ov);
	net_packet@ st = wf(todos[0], S_LOBBY_STATE, 5000);
	if (@st == null) { println("sem sala"); return; }
	for (uint i = 1; i < todos.length(); i++) { todos[i].send_join_lobby(st.get_string("lobby_id")); wf(todos[i], S_JOIN_RESULT, 5000); }
	bombeia(todos, 300);
	todos[0].send_start_game();

	int impostor = -1;
	array<float> xs(3), ys(3);
	for (uint i = 0; i < todos.length(); i++) {
		net_packet@ s = wf(todos[i], S_GAME_START, 8000);
		if (@s == null) { println("sem S_GAME_START"); return; }
		xs[i] = s.get_float("your_x"); ys[i] = s.get_float("your_y");
		if (role_for(s.get_string("your_role")).team == TEAM_IMPOSTOR) impostor = int(i);
	}
	int vitima = (impostor + 1) % 3, vigia = (impostor + 2) % 3;
	println("impostor " + impostor + ", vitima " + vitima + ", nas cameras " + vigia);

	// O posto não confere distância no servidor (a tela só abre perto dele no cliente).
	todos[vigia].send_camera_enter();
	net_packet@ entrou = wf(todos[vigia], S_CAMERA_STATE, 5000);
	confere("o vigia entrou nas cameras", @entrou != null && entrou.get_bool("active"));

	anda_ate(todos, todos[vitima], xs[vitima], ys[vitima], 0.0, 0.0);
	anda_ate(todos, todos[impostor], xs[impostor], ys[impostor], 0.0, 0.0);
	bombeia(todos, 6000); // recarga de 5 s do kill
	for (uint i = 0; i < todos.length(); i++) todos[i].clear_incoming();
	todos[impostor].send_kill(todos[vitima].my_peer_id);

	// A ORDEM importa: o aviso de saída tem que vir antes do fim, senão o cliente trata o fim ainda
	// "nas câmeras".
	bool saiu_antes_do_fim = false, acabou = false;
	timer espera;
	while (espera.elapsed < 8000 && !acabou) {
		todos[vigia].update();
		net_packet@ p = todos[vigia].poll_message();
		while (@p != null) {
			if (p.type == S_CAMERA_STATE && !p.get_bool("active") && !acabou) saiu_antes_do_fim = true;
			if (p.type == S_GAME_OVER) acabou = true;
			@p = todos[vigia].poll_message();
		}
		wait(5);
	}
	confere("a partida acabou por maioria", acabou);
	confere("o vigia foi tirado das cameras ANTES do fim da partida", saiu_antes_do_fim);

	// E quem não estava nas câmeras para de ouvir "alguém observa esta sala".
	bool apagou = false;
	timer e2;
	todos[impostor].update();
	while (e2.elapsed < 3000 && !apagou) {
		todos[impostor].update();
		net_packet@ p = todos[impostor].poll_message();
		while (@p != null) {
			if (p.type == S_CAMERA_WATCHING && p.get_string("room_id") == "") apagou = true;
			@p = todos[impostor].poll_message();
		}
		wait(5);
	}
	confere("os outros souberam que ninguem mais observa", apagou);

	for (uint i = 0; i < todos.length(); i++) todos[i].disconnect();
	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
