// Sonda do mapa na tela (ui/visual_map.nvgt): a tela mostra só o que o SOM deixa perceber.
//   nvgt tools/probes/probe_visual_map.nvgt            (regra + desenho por alguns segundos)
// Confere a regra caso a caso, cada um com o controle que o separa do vizinho, e depois desenha uma
// cena para ser vista (ou capturada) - o renderizador da janela tem que nascer válido.
#include "../../src/ui/visual_map.nvgt"

int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}

roster_entry@ alguem(client_roster@ r, uint64 id, float x, float y, uint64 ouvido_ha_ms) {
	r.add(id, "j" + id, int(id) % 15, x, y);
	roster_entry@ e = r.find(id);
	e.heard_at = ouvido_ha_ms == 0 ? 0 : ticks() - ouvido_ha_ms;
	return e;
}

void main() {
	show_window("sonda: mapa na tela");
	if (!directory_exists("lang")) chdir("..");
	if (!directory_exists("lang")) chdir("..");
	g_i18n.load_language("pt_BR"); // sem idioma, os nomes das salas saem como chave crua
	wait(200); // ticks() precisa ter andado para os "ouvido há N ms" fazerem sentido
	client_roster r;
	r.perceptible_known = true;
	println("== quem aparece ==");
	confere("passo acabou de tocar, a 20 unidades: aparece", visual_player_visible(alguem(r, 1, 20, 0, 100), 0, 0, false, r));
	confere("o mesmo passo com as luzes apagadas (alcance 16): nao aparece", !visual_player_visible(r.find(1), 0, 0, true, r));
	confere("controle: com luz apagada, a 10 unidades, aparece", visual_player_visible(alguem(r, 2, 10, 0, 100), 0, 0, true, r));
	// Parado: aparece se o servidor diz que ele continua perceptível (não está em duto nem invisível).
	roster_entry@ parado = alguem(r, 3, 30, 0, 2000);
	confere("parado ha 2 s, a 30, fora da lista do servidor (duto, invisivel): nao aparece", !visual_player_visible(parado, 0, 0, false, r));
	r.perceptible.insert_last(3);
	confere("parado ha 2 s, a 30, na lista (fazendo tarefa): aparece", visual_player_visible(parado, 0, 0, false, r));
	confere("o mesmo parado com as luzes apagadas (alcance 16): nao aparece", !visual_player_visible(parado, 0, 0, true, r));
	roster_entry@ alem = alguem(r, 4, 45, 0, 0);
	r.perceptible.insert_last(4);
	confere("na lista mas alem do alcance do som (45): nao aparece", !visual_player_visible(alem, 0, 0, false, r));
	// Servidor antigo (sem a lista): parado só aparece colado, como antes.
	r.perceptible_known = false;
	confere("servidor antigo: parado a 30 nao aparece", !visual_player_visible(parado, 0, 0, false, r));
	confere("servidor antigo: colado (1 unidade) aparece", visual_player_visible(alguem(r, 5, 1.0, 0, 0), 0, 0, false, r));
	r.perceptible_known = true;
	roster_entry@ morto = alguem(r, 6, 3, 0, 100);
	morto.alive = false;
	confere("morto (fantasma) nunca aparece para o vivo", !visual_player_visible(morto, 0, 0, false, r));

	println("== marcadores (a MESMA regra do som) ==");
	game_map@ map = build_the_hub_map();
	map_object@ duto = map.find_object("vent_navigation");
	map_object@ botao = null;
	map_object@ painel_luz = null;
	map_object@ tarefa = null;
	for (uint i = 0; i < map.objects.length(); i++) {
		map_object@ o = map.objects[i];
		if (o.obj_type == OBJ_EMERGENCY_BUTTON && @botao == null) @botao = o;
		if (o.obj_type == OBJ_SABOTAGE_PANEL && o.task_type == "lights" && @painel_luz == null) @painel_luz = o;
		if (o.obj_type == OBJ_TASK_SPOT && @tarefa == null) @tarefa = o;
	}
	array<string> minhas = {tarefa.id};
	confere("duto: marcador para todos, sem sabotagem", landmark_beacon_on(duto, null, ""));
	confere("botao de emergencia: toca com luz", landmark_beacon_on(botao, null, ""));
	confere("e cala com as luzes apagadas", !landmark_beacon_on(botao, null, "lights"));
	confere("painel das luzes: so durante a sabotagem dele", landmark_beacon_on(painel_luz, null, "lights") && !landmark_beacon_on(painel_luz, null, "comms") && !landmark_beacon_on(painel_luz, null, ""));
	confere("tarefa: so a SUA", landmark_beacon_on(tarefa, minhas, "") && !landmark_beacon_on(tarefa, null, ""));

	println("== desenho ==");
	array<roster_entry@> outros = {r.find(1), r.find(2), r.find(5)};
	array<vector> corpos = {vector(3.0, 2.0, 0.0)};
	array<string> tarefas;
	for (uint i = 0; i < map.objects.length() && tarefas.length() < 6; i++) if (map.objects[i].obj_type == OBJ_TASK_SPOT) tarefas.insert_last(map.objects[i].id);
	visual_map v;
	timer t;
	while (t.elapsed < 4000) {
		v.draw(map, 0.0, 0.0, COLOR_CYAN, true, false, outros, corpos, tarefas);
		wait(16);
	}
	confere("o renderizador da janela nasceu valido e desenhou", v.ready() && v.drew_last);
	// Perto do duto da navegação, com a sabotagem das luzes em curso: duto, painel piscando, legenda.
	println("cena: duto"); t.restart();
	while (t.elapsed < 3000) { v.draw(map, duto.x - 4, duto.y, COLOR_CYAN, true, false, null, null, tarefas, "lights"); wait(16); }

	// As outras três telas, 3 s cada, para serem vistas ou capturadas (a sonda imprime quando começa
	// cada uma). As legendas entram como entrariam pelo gancho de fala.
	v.add_caption("Cafeteria.");
	v.add_caption("Você está apaixonado por Ana.");
	screen_menu m;
	m.intro_text = "Configurações";
	array<string> itens = {"Volumes", "Como eu ouço o jogo", "Teclas", "Voz", "Chat de voz", "Saída de som", "Idioma", "Mapa na tela, para quem enxerga: ligado", "Voltar"};
	for (uint i = 0; i < itens.length(); i++) m.add_item(itens[i], "i" + i);
	m.focused_item = 2;
	// A escala: com a janela maior (como numa tela cheia, sem tomar a tela de quem está no computador),
	// tudo cresce junto e o texto continua nítido.
	game_window@ jan = window;
	if (@jan != null) jan.set_size(1200, 960);
	println("cena: menu"); t.restart();
	while (t.elapsed < 3000) { v.draw_menu(m); wait(16); }
	array<visual_meeting_seat@> lugares;
	array<string> nomes = {"Você", "Ana", "Bia", "Caio", "Davi", "Eva"};
	for (uint i = 0; i < nomes.length(); i++) {
		visual_meeting_seat s;
		s.name = nomes[i]; s.color = int(i) * 2; s.alive = i != 3; s.voted = i == 1 || i == 4; s.me = i == 0;
		lugares.insert_last(s);
	}
	println("cena: reuniao"); t.restart();
	while (t.elapsed < 3000) { v.draw_meeting(lugares, true, 23.4); wait(16); }
	v.add_caption("Recado enviado. Obrigado!");
	println("cena: legendas"); t.restart();
	while (t.elapsed < 3000) { v.draw_captions_screen(); wait(16); }
	confere("menu, reuniao e legendas desenharam", v.drew_last && v.captions.length() == 3);

	v.clear_if_needed();
	confere("e limpa a janela ao desligar", !v.drew_last);

	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
