// Sonda da senha definida pela administração (recado #251: quem esquece a senha não tem como recuperá-la
// - o jogo não guarda e-mail).
//   AMONGUS_SERVER_HOST=127.0.0.1 AMONGUS_ADMIN_TOKEN=<o do servidor local> nvgt tools/probes/probe_admin_password.nvgt
//
// Confere: token errado é recusado; conta que não existe é recusada; senha curta é recusada (a mesma
// regra do cadastro); o nome com maiúsculas DIFERENTES acha a conta (quem pede ajuda escreve o nome de
// cabeça); depois da troca a senha velha não entra e a nova entra (o CONTROLE de um é o outro); e quem
// estava dentro da conta foi derrubado.
#include "../../src/network/client.nvgt"
#include "../../src/config/game_constants.nvgt"
#include "../../src/config/server_address.nvgt"

net_packet@ wf(game_client@ c, const string&in t, int ms) {
	timer x;
	while (x.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == t) return p; @p = c.poll_message(); } wait(5); }
	return null;
}
int falhas = 0;
void confere(const string&in o_que, bool ok) {
	println((ok ? "  ok     " : "  FALHA  ") + o_que);
	if (!ok) falhas++;
}
game_client@ conecta(server_address@ addr) {
	game_client c;
	if (!c.connect_to(addr.host, addr.port)) return null;
	timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
	return c;
}
string msg(net_packet@ p) { return @p != null ? p.get_string("message") : "sem resposta"; }

void main() {
	string token = read_environment_variable("AMONGUS_ADMIN_TOKEN", "");
	if (token == "") { println("defina AMONGUS_ADMIN_TOKEN (o mesmo com que o servidor subiu)"); exit(2); }
	server_address addr = resolve_server_address();
	string nome = "Esquece" + random(10000, 99999);

	game_client@ dono = conecta(addr);
	dono.send_register(nome, "velha123");
	confere("cadastro", @wf(dono, S_REGISTER_RESULT, 3000) != null);
	dono.send_login(nome, "velha123");
	net_packet@ l0 = wf(dono, S_LOGIN_RESULT, 5000);
	confere("controle: a senha velha entra antes da troca", @l0 != null && l0.get_bool("ok"));

	game_client@ adm = conecta(addr);
	adm.send_admin_set_password("errado", nome, "novasenha1");
	net_packet@ r0 = wf(adm, S_ADMIN_RESULT, 5000);
	confere("token errado e recusado (" + msg(r0) + ")", @r0 != null && !r0.get_bool("ok") && msg(r0) == "bad_token");
	adm.send_admin_set_password(token, "ninguem_tem_esse_nome_" + random(1000, 9999), "novasenha1");
	net_packet@ r1 = wf(adm, S_ADMIN_RESULT, 5000);
	confere("conta que nao existe e recusada (" + msg(r1) + ")", @r1 != null && !r1.get_bool("ok") && msg(r1) == "account_not_found");
	adm.send_admin_set_password(token, nome, "abc");
	net_packet@ r2 = wf(adm, S_ADMIN_RESULT, 5000);
	confere("senha curta e recusada (" + msg(r2) + ")", @r2 != null && !r2.get_bool("ok") && msg(r2) == "account.password_too_short");
	adm.send_admin_set_password(token, nome.lower(), "novasenha1");
	net_packet@ r3 = wf(adm, S_ADMIN_RESULT, 5000);
	confere("o nome em minusculas acha a conta e troca (" + msg(r3) + ")", @r3 != null && r3.get_bool("ok") && msg(r3) == nome);
	adm.disconnect();

	// Quem estava dentro da conta recebe o aviso de sessão substituída e cai.
	net_packet@ caiu = wf(dono, S_ERROR, 3000);
	confere("quem estava dentro da conta foi derrubado", @caiu != null && caiu.get_string(MSG_KEY_FIELD) == "login.session_replaced");
	dono.disconnect();

	game_client@ c = conecta(addr);
	c.send_login(nome, "velha123");
	net_packet@ l1 = wf(c, S_LOGIN_RESULT, 5000);
	confere("a senha velha nao entra mais", @l1 != null && !l1.get_bool("ok"));
	c.send_login(nome, "novasenha1");
	net_packet@ l2 = wf(c, S_LOGIN_RESULT, 5000);
	confere("a senha nova entra", @l2 != null && l2.get_bool("ok"));
	c.disconnect();

	println("");
	println(falhas == 0 ? "RESULTADO: ok" : "RESULTADO: FALHA (" + falhas + ")");
}
