// Sonda do "lembrar de mim": login com senha pedindo token; login só com o token numa conexão
// nova; logout; o token deixa de valer. Contra o servidor em AMONGUS_SERVER_HOST.
#include "../src/network/client.nvgt"
#include "../src/config/game_constants.nvgt"
#include "../src/config/server_address.nvgt"

net_packet@ wait_for(game_client@ c, const string&in type, int ms) {
	timer t;
	while (t.elapsed < ms) { c.update(); net_packet@ p = c.poll_message(); while (@p != null) { if (p.type == type) return p; @p = c.poll_message(); } wait(5); }
	return null;
}
game_client@ conectar(server_address addr) {
	game_client@ c = game_client();
	if (!c.connect_to(addr.host, addr.port)) return null;
	timer t; while (!c.connected && t.elapsed < 5000) { c.update(); wait(5); }
	return c.connected ? c : null;
}

void main() {
	server_address addr = resolve_server_address();
	string name = "sess" + random(1000, 9999);
	game_client@ a = conectar(addr);
	a.send_register(name, "probe123"); wait_for(a, S_REGISTER_RESULT, 3000);
	a.send_login(name, "probe123", true);
	net_packet@ r = wait_for(a, S_LOGIN_RESULT, 5000);
	string token = @r != null ? r.get_string("session_token") : "";
	println("login com senha: ok=" + (@r != null && r.get_bool("ok")) + " token=" + (token.length() > 0 ? token.length() + " chars" : "NENHUM"));
	println("  token bruto: [" + token + "]");
	// o mesmo hash que o servidor usa, para ver se o token sobrevive ao ir e voltar
	println("  sha256(token) hex: " + string_hash_sha256(token));
	a.disconnect();

	game_client@ b = conectar(addr);
	b.send_login_token(token);
	@r = wait_for(b, S_LOGIN_RESULT, 5000);
	println("login com token: ok=" + (@r != null && r.get_bool("ok")) + " usuario=" + (@r != null ? r.get_string("username") : "?") + " (esperado " + name + ")");
	b.send_logout(token);
	wait(300); b.update();
	b.disconnect();

	game_client@ c = conectar(addr);
	c.send_login_token(token);
	@r = wait_for(c, S_LOGIN_RESULT, 5000);
	println("token depois do logout: ok=" + (@r != null && r.get_bool("ok")) + " (esperado false)");
	c.send_login_token("lixo");
	@r = wait_for(c, S_LOGIN_RESULT, 5000);
	println("token inventado: ok=" + (@r != null && r.get_bool("ok")) + " (esperado false)");
	c.disconnect();
}
