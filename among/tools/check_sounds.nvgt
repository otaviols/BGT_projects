// tools/check_sounds.nvgt
// Ferramenta de desenvolvimento: compara o catálogo central de sons (audio/sound_catalog.nvgt) com
// o que existe de fato em sounds/, e avisa dos dois lados - o que o código espera e não existe, e o
// que existe na pasta mas não é referenciado em lugar nenhum (pode ser lixo ou algo ainda não
// conectado). Rode com `nvgt tools/check_sounds.nvgt` sempre que adicionar/renomear um som.

#include "../src/audio/sound_catalog.nvgt"

void main() {
	// Os caminhos do catálogo (ex.: "sounds/steps/x.wav") assumem a raiz do projeto (among/), que é
	// de onde o jogo roda de verdade. Este script, porém, vive em tools/.
	//
	// Antes isto era um chdir("..") fixo, e quebrava conforme a forma de invocar: o NVGT põe o
	// diretório de trabalho na pasta DO SCRIPT, então subir um nível dá certo vindo de tools/ e vai
	// parar fora do projeto em outras situações - e o resultado era o checker dizer que TODO som
	// sumiu, que é exatamente o alarme falso que faz uma ferramenta de verificação deixar de ser
	// levada a sério. Agora ele procura a raiz em vez de supor onde está.
	if (!directory_exists("sounds")) chdir("..");
	if (!directory_exists("sounds")) {
		println("Não achei a pasta sounds/. Rode este script de dentro do projeto (a pasta among).");
		return;
	}

	array<string>@ expected = all_sound_paths();
	array<string>@ optional = optional_sound_paths();
	// Recursivo: com os sons em subpastas, find_files sozinho devolve zero e o conferidor
	// passa a acusar que TODO som sumiu - alarme falso que faz a ferramenta perder a serventia.
	array<string>@ found_files = all_sound_files_on_disk("sounds");

	dictionary found;
	for (uint i = 0; i < found_files.length(); i++) found.set(found_files[i], true);

	dictionary claimed; // marca quais arquivos da pasta já foram "explicados" pelo catálogo

	println("=== Sons que o codigo espera (audio/sound_catalog.nvgt) ===");
	uint missing_count = 0;
	for (uint i = 0; i < expected.length(); i++) {
		string path = expected[i];
		// Compara o CAMINHO inteiro, não só o nome do arquivo. Antes bastava existir um arquivo com
		// aquele nome em qualquer lugar; agora que os sons vivem em subpastas por categoria, um som
		// guardado na pasta errada passaria despercebido - e o jogo ficaria mudo naquele ponto.
		if (found.exists(path)) {
			claimed.set(path, true);
		} else {
			missing_count++;
			println("FALTA: " + path);
		}
	}
	if (missing_count == 0) println("(nenhum - todos os sons esperados existem)");

	println("");
	println("=== Sons opcionais (por cor, com fallback se nao existirem) ===");
	uint optional_present = 0;
	for (uint i = 0; i < optional.length(); i++) {
		string path = optional[i];
		if (file_exists(path)) {
			optional_present++;
			println("presente: " + path);
		}
	}
	if (optional_present == 0) println("(nenhum criado ainda - usando os fallbacks genericos)");

	println("");
	println("=== Arquivos em sounds/ sem uso conhecido no codigo ===");
	uint unused_count = 0;
	for (uint i = 0; i < found_files.length(); i++) {
		string name = found_files[i];
		if (!claimed.exists(name)) {
			unused_count++;
			println(name);
		}
	}
	if (unused_count == 0) println("(nenhum - todo arquivo em sounds/ e usado em algum lugar)");
}
