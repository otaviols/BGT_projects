#include"ScreenReader.bgt"

string pi="D:/git/HearthstoneAccess/Decompiled/Assembly-CSharp";
	ScreenReader sr;

void main()
{
directory_create("limpo");
sr.Start();
file f;
string[] arqs=find_files(pi+"/*.cs");
string[] dirs=find_directories(pi);
extrai(pi,arqs);

//alert(string_split(dirs[0],"D:/git/HearthstoneAccess/Decompiled/Assembly-CSharp",false)[0],"");
alert(""+dirs.length,"");
}

void extrai(string path,string[] arqs)
{
file f;

for(uint i=0; i<arqs.length; i++)
{
f.open(path+"/"+arqs[i], "r");
string text= f.read_until("using",true);
f.seek(text.length());

text=f.read();
text=string_trim_left(text,1);

f.open("limpo/"+arqs[i], "w");
f.write(text);
f.close();

}
}
